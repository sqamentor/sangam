<?xml version="1.0" encoding="UTF-8"?>
<!--
  GAP set (SANGAM.md XI.3, CF-13 / R34): input/output mapping on an activity. FLOWABLE 8.0.0 VARIANT.
  BPMN 2.0.2 has no executable I/O-mapping syntax that either engine honours (ioSpecification /
  dataInputAssociation are parsed for structure only), so each engine's own extension is used:
    V-05 gap_io_mappedTask  external worker task + flowable:externalWorkerIn/OutParameter
  Flowable has no general "I/O mapping on ANY activity"; in/out parameters exist only on call
  activities (flowable:in / flowable:out) and on external worker tasks (used here).
  Mapping under test (identical intent on both engines):
    in : feeBase  <- ${amount}           (visible to the worker that acquires the job)
    out: ioResult <- workerResult        (variable sent by the worker on complete)
  Pass: the worker sees feeBase == amount; after complete, process variable ioResult == workerResult
  and the instance waits in gap_io_probe.
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             id="gap-io-mapping-definitions"
             targetNamespace="http://sangam.org/spike/corpus">

  <process id="gap-io-mapping" name="GAP I/O mapping on an activity" isExecutable="true">
    <startEvent id="gap_io_start"/>
    <sequenceFlow id="gap_io_f1" sourceRef="gap_io_start" targetRef="gap_io_mappedTask"/>

    <!-- V-05 (Flowable): in-parameters are computed when the worker acquires the job and REPLACE the
         variable set sent to the worker (no execution variable is created); out-parameters REPLACE the
         default "copy all completion variables" behaviour (only ioResult is written). -->
    <serviceTask id="gap_io_mappedTask" name="I/O mapped work" flowable:type="external-worker" flowable:topic="io-mapping">
      <extensionElements>
        <flowable:externalWorkerInParameter sourceExpression="${amount}" target="feeBase"/>
        <flowable:externalWorkerOutParameter source="workerResult" target="ioResult"/>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="gap_io_f2" sourceRef="gap_io_mappedTask" targetRef="gap_io_probe"/>

    <userTask id="gap_io_probe" name="Reached after I/O mapping"/>
    <sequenceFlow id="gap_io_f3" sourceRef="gap_io_probe" targetRef="gap_io_end"/>
    <endEvent id="gap_io_end"/>
  </process>
</definitions>
