<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.sangam.spike</groupId>
    <artifactId>spike-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>experiments-gov-c</artifactId>
  <name>Experiments E16-c / E17-c (GP-41..GP-55, added domains)</name>

  <!--
    E16-c (pattern tests GP-41..GP-55) and E17-c (domain end-to-end models) on both engines.
    Same layout as module "experiments": one surefire execution per engine, each in its own JVM with the other
    engine's artifacts removed from the test class path; -Dgov.engine selects the native hooks
    (hooks.operaton / hooks.flowable). -Dgov.db=h2 for development runs (results stay in target/),
    -Dgov.db=postgres (default) for the measured run (writes ../results/E16-c.json, E17-c.json).
  -->

  <properties>
    <version.h2>2.3.232</version.h2>
    <skip.flowable>false</skip.flowable>
    <skip.operaton>false</skip.operaton>
    <gov.db>postgres</gov.db>
    <gov.resultsDir>${project.basedir}/../results</gov.resultsDir>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.sangam.spike</groupId>
      <artifactId>product-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>${version.h2}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${version.slf4j}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <trimStackTrace>false</trimStackTrace>
          <redirectTestOutputToFile>true</redirectTestOutputToFile>
          <includes>
            <include>**/E*Test.java</include>
          </includes>
        </configuration>
        <executions>
          <execution>
            <id>default-test</id>
            <configuration>
              <skip>true</skip>
            </configuration>
          </execution>
          <execution>
            <id>flowable</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <skip>${skip.flowable}</skip>
              <reportsDirectory>${project.build.directory}/surefire-reports/flowable</reportsDirectory>
              <systemPropertyVariables>
                <api.version>1.44</api.version>
                <gov.engine>flowable</gov.engine>
                <gov.db>${gov.db}</gov.db>
                <gov.resultsDir>${gov.resultsDir}</gov.resultsDir>
                <gov.fragmentDir>${project.build.directory}/gov-results</gov.fragmentDir>
              </systemPropertyVariables>
              <classpathDependencyExcludes>
                <exclude>org.sangam.spike:adapter-operaton</exclude>
                <exclude>org.operaton.bpm:*</exclude>
                <exclude>org.operaton.bpm.model:*</exclude>
                <exclude>org.operaton.bpm.juel:*</exclude>
                <exclude>org.operaton.bpm.dmn:*</exclude>
                <exclude>org.operaton.commons:*</exclude>
                <exclude>org.camunda.feel:*</exclude>
                <exclude>org.scala-lang:*</exclude>
                <exclude>com.lihaoyi:*</exclude>
                <exclude>com.fasterxml.jackson.module:*</exclude>
                <exclude>com.fasterxml.jackson.core:jackson-databind</exclude>
                <exclude>com.fasterxml.jackson.core:jackson-core</exclude>
                <exclude>com.thoughtworks.paranamer:*</exclude>
                <exclude>jakarta.el:*</exclude>
              </classpathDependencyExcludes>
            </configuration>
          </execution>
          <execution>
            <id>operaton</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <skip>${skip.operaton}</skip>
              <reportsDirectory>${project.build.directory}/surefire-reports/operaton</reportsDirectory>
              <systemPropertyVariables>
                <api.version>1.44</api.version>
                <gov.engine>operaton</gov.engine>
                <gov.db>${gov.db}</gov.db>
                <gov.resultsDir>${gov.resultsDir}</gov.resultsDir>
                <gov.fragmentDir>${project.build.directory}/gov-results</gov.fragmentDir>
              </systemPropertyVariables>
              <classpathDependencyExcludes>
                <exclude>org.sangam.spike:adapter-flowable</exclude>
                <exclude>org.flowable:*</exclude>
                <exclude>tools.jackson.core:*</exclude>
                <exclude>org.eclipse.angus:*</exclude>
                <exclude>jakarta.mail:*</exclude>
                <exclude>jakarta.activation:*</exclude>
                <exclude>commons-io:*</exclude>
                <exclude>commons-codec:*</exclude>
                <exclude>org.apache.commons:commons-lang3</exclude>
                <exclude>org.slf4j:jcl-over-slf4j</exclude>
              </classpathDependencyExcludes>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Default: both adapters, both executions (same jackson alignment as module "experiments", see its README). -->
    <profile>
      <id>both</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <dependencyManagement>
        <dependencies>
          <dependency>
            <groupId>com.fasterxml.jackson</groupId>
            <artifactId>jackson-bom</artifactId>
            <version>${version.jackson}</version>
            <type>pom</type>
            <scope>import</scope>
          </dependency>
        </dependencies>
      </dependencyManagement>
      <dependencies>
        <dependency>
          <groupId>org.sangam.spike</groupId>
          <artifactId>adapter-flowable</artifactId>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.sangam.spike</groupId>
          <artifactId>adapter-operaton</artifactId>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
