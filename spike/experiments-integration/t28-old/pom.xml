<?xml version="1.0" encoding="UTF-8"?>
<!--
  T28 upgrade test, OLD-version phase (SANGAM.md Part III T28, R32). Standalone project, NOT a module of the spike
  reactor: the old engine (Operaton 2.1.6 or Flowable 7.2.0) must not share a class path with the 2.2.0 / 8.0.0 adapters.

  Run (the run queue, step Q7, does this against a postgres:17-alpine container it starts):
      ..\..\mvnw.cmd -q -f experiments-integration\t28-old\pom.xml verify -Dt28.engine=operaton ^
          -Dt28.jdbcUrl=jdbc:postgresql://localhost:55432/t28 -Dt28.user=t28 -Dt28.password=t28 -Dt28.stateFile=<file>
  then the NEW phase: experiments-integration T28UpgradeTest with -Dt28.stateFile=<same file>.

  -Dt28.engine=operaton|flowable is REQUIRED (it selects the profile). Versions: -Dt28.operaton.version (2.1.6),
  -Dt28.flowable.version (7.2.0). Needs corpus + product-api 0.1.0-SNAPSHOT installed in ~/.m2.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.sangam.spike</groupId>
  <artifactId>t28-old-phase</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>T28 old-version phase (standalone)</name>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <t28.operaton.version>2.1.6</t28.operaton.version>
    <t28.flowable.version>7.2.0</t28.flowable.version>
    <version.junit>5.11.4</version.junit>
    <version.postgresql>42.7.12</version.postgresql>
    <version.slf4j>2.0.17</version.slf4j>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${version.junit}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- the WF-1 models (engine variants); brings product-api, no engine -->
    <dependency>
      <groupId>org.sangam.spike</groupId>
      <artifactId>corpus</artifactId>
      <version>0.1.0-SNAPSHOT</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>${version.postgresql}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${version.slf4j}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${version.slf4j}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.3</version>
        <configuration>
          <!-- JDK loopback on this Windows host; quoted because the path contains spaces -->
          <argLine>"-Djdk.net.unixdomain.tmpdir=${project.build.directory}"</argLine>
          <trimStackTrace>false</trimStackTrace>
          <systemPropertyVariables>
            <t28.operaton.version>${t28.operaton.version}</t28.operaton.version>
            <t28.flowable.version>${t28.flowable.version}</t28.flowable.version>
            <org.slf4j.simpleLogger.defaultLogLevel>warn</org.slf4j.simpleLogger.defaultLogLevel>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>operaton</id>
      <activation>
        <property>
          <name>t28.engine</name>
          <value>operaton</value>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.operaton.bpm</groupId>
          <artifactId>operaton-engine</artifactId>
          <version>${t28.operaton.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <testExcludes>
                <testExclude>**/flowable/**</testExclude>
              </testExcludes>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>flowable</id>
      <activation>
        <property>
          <name>t28.engine</name>
          <value>flowable</value>
        </property>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.flowable</groupId>
          <artifactId>flowable-engine</artifactId>
          <version>${t28.flowable.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.flowable</groupId>
          <artifactId>flowable-dmn-engine-configurator</artifactId>
          <version>${t28.flowable.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.flowable</groupId>
          <artifactId>flowable-cmmn-engine-configurator</artifactId>
          <version>${t28.flowable.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <testExcludes>
                <testExclude>**/operaton/**</testExclude>
              </testExcludes>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
