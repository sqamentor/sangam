<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.sangam.spike</groupId>
    <artifactId>spike-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>adapter-flowable</artifactId>
  <name>EngineAdapter on Flowable</name>

  <properties>
    <!-- H2 (EPL-1.0 / MPL-2.0) is test scope only; not managed by the parent. -->
    <version.h2>2.3.232</version.h2>
    <!-- Test-only JDBC drivers (same versions as simulators / adapter-operaton) -->
    <version.ojdbc>23.8.0.25.04</version.ojdbc>
    <version.mssql-jdbc>12.10.1.jre11</version.mssql-jdbc>
    <version.mysql-connector-j>8.4.0</version.mysql-connector-j>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.sangam.spike</groupId>
      <artifactId>product-api</artifactId>
    </dependency>

    <!-- Flowable 8.0.0 embedded engines (Apache-2.0), no Spring. -->
    <dependency>
      <groupId>org.flowable</groupId>
      <artifactId>flowable-engine</artifactId>
      <version>${version.flowable}</version>
      <exclusions>
        <!-- Not used: spring-beans is only needed for flowable.cfg.xml parsing. No Spring on the class path. -->
        <exclusion>
          <groupId>org.springframework</groupId>
          <artifactId>spring-beans</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.flowable</groupId>
      <artifactId>flowable-dmn-engine-configurator</artifactId>
      <version>${version.flowable}</version>
    </dependency>
    <dependency>
      <groupId>org.flowable</groupId>
      <artifactId>flowable-cmmn-engine-configurator</artifactId>
      <version>${version.flowable}</version>
    </dependency>

    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
    </dependency>

    <!-- Test scope -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Database harness (Testcontainers, one database at a time): org.sangam.spike.sim.db.Databases -->
    <dependency>
      <groupId>org.sangam.spike</groupId>
      <artifactId>simulators</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
      <exclusions>
        <!-- not used by Databases; keeps Jackson 2 databind away from Flowable's Jackson 3 / annotations 2.20 -->
        <exclusion>
          <groupId>com.fasterxml.jackson.core</groupId>
          <artifactId>jackson-databind</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Oracle JDBC (Oracle Free Use Terms) and SQL Server JDBC (MIT): TEST SCOPE ONLY, never bundled (LIC-2) -->
    <dependency>
      <groupId>com.oracle.database.jdbc</groupId>
      <artifactId>ojdbc11</artifactId>
      <version>${version.ojdbc}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.microsoft.sqlserver</groupId>
      <artifactId>mssql-jdbc</artifactId>
      <version>${version.mssql-jdbc}</version>
      <scope>test</scope>
    </dependency>
    <!-- MySQL Connector/J (GPL-2.0 with the FOSS exception): TEST SCOPE ONLY (MySQL Tier 1, ADR-D-15) -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>${version.mysql-connector-j}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>${version.h2}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <!-- api.version=1.44 for Docker 29 / Testcontainers 1.21.3 comes from the parent's surefire config. -->
      </plugin>
    </plugins>
  </build>
</project>
