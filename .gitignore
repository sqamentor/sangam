# Third-party source checkouts used for study only (Operaton, Flowable): not part of this repository
/reference/

# Build output
target/
**/target/
# per-workstream build folders (-Dsangam.target=target-<ws>)
target-*/
**/target-*/
# SG-21: never hide source packages named like build folders (org.sangam.programme.target was silently left out of
# git, so a clean checkout did not compile). Build output never lives under src/; CI fails on any ignored source.
!**/src/**/target/
!**/src/**/target-*/
# local Python virtual environments
.venv/
**/.venv/

# Local tooling and session state
.claude/
.idea/
*.iml
.vscode/

# Large or machine-specific run logs
spike/results/run-queue/
spike/results/*.console.log
spike/results/run-queue.log

# Python and Node build caches
__pycache__/
*.pyc
node_modules/
sangam/sangam-ui/dist/
# .NET build output (contains absolute local paths)
**/bin/
**/obj/

# Large official source documents (re-downloadable; hashes recorded in the extraction README)
spike/results/sources/**/*.pdf

# OS files
Thumbs.db
.DS_Store
