<!-- Data-subject grievance redressal. Sangam compliance pack (jurisdiction-neutral): timelines arrive as process variables computed from the jurisdiction pack. Generated with its diagram layout by sangam-packs/tools/packgen (compliance.py): change the generator, then regenerate. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_sangam_dsr_grievance" targetNamespace="http://sangam.org/packs/compliance" exporter="sangam-compliance" exporterVersion="0.1.0">
  <process id="sangam-dsr-grievance" name="Data-subject grievance redressal" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0" operaton:isStartableInTasklist="false">
    <documentation>Grievance (IN: DPDP s.13, r.14(3) at most 90 days; SPDI r.5(9) one month for body corporates). Warning at three quarters of the period, escalation at the due date; the response names the authority complaint route.</documentation>
    <startEvent id="start" name="Grievance lodged"/>
    <serviceTask id="s_start" name="Mark in progress" operaton:class="org.sangam.compliance.bpmn.ComplianceStepDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="step"><operaton:string>rights.start</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="u_examine" name="Examine and resolve grievance" operaton:candidateGroups="${grievanceOfficerSeat}" operaton:formKey="sangam:compliance/grievance-examine"/>
    <boundaryEvent id="t_warn" name="Three quarters of the period" attachedToRef="u_examine" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${warnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <userTask id="u_warn" name="Senior review of a delayed grievance" operaton:candidateGroups="${dpoSeat}" operaton:formKey="sangam:compliance/grievance-delayed"/>
    <endEvent id="end_warn" name="Reviewed"/>
    <boundaryEvent id="t_due" name="Due date" attachedToRef="u_examine" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${dueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <serviceTask id="s_resolve" name="Send resolution" operaton:class="org.sangam.compliance.bpmn.ComplianceStepDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="step"><operaton:string>rights.resolveGrievance</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="end" name="Resolved"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="s_start"/>
    <sequenceFlow id="f2" sourceRef="s_start" targetRef="u_examine"/>
    <sequenceFlow id="f3" sourceRef="u_examine" targetRef="s_resolve"/>
    <sequenceFlow id="f4" sourceRef="s_resolve" targetRef="end"/>
    <sequenceFlow id="f_w1" sourceRef="t_warn" targetRef="u_warn"/>
    <sequenceFlow id="f_w2" sourceRef="u_warn" targetRef="end_warn"/>
    <serviceTask id="esc" name="Escalate overdue request" operaton:class="org.sangam.compliance.bpmn.ComplianceStepDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="step"><operaton:string>rights.escalate</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="end_esc" name="Escalated"/>
    <sequenceFlow id="f_esc1" sourceRef="t_due" targetRef="esc"/>
    <sequenceFlow id="f_esc2" sourceRef="esc" targetRef="end_esc"/>
  </process>
  <bpmndi:BPMNDiagram id="dsr_grievance_diagram">
    <bpmndi:BPMNPlane id="dsr_grievance_plane" bpmnElement="sangam-dsr-grievance">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="52" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_start_di" bpmnElement="s_start"><dc:Bounds x="185" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="u_examine_di" bpmnElement="u_examine"><dc:Bounds x="350" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="u_warn_di" bpmnElement="u_warn"><dc:Bounds x="515" y="155" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_warn_di" bpmnElement="end_warn"><dc:Bounds x="712" y="177" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_resolve_di" bpmnElement="s_resolve"><dc:Bounds x="515" y="280" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end"><dc:Bounds x="712" y="302" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="esc_di" bpmnElement="esc"><dc:Bounds x="515" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_esc_di" bpmnElement="end_esc"><dc:Bounds x="712" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_warn_di" bpmnElement="t_warn"><dc:Bounds x="358" y="92" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_due_di" bpmnElement="t_due"><dc:Bounds x="388" y="92" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="88" y="70"/><di:waypoint x="185" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="285" y="70"/><di:waypoint x="350" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="450" y="70"/><di:waypoint x="482" y="70"/><di:waypoint x="482" y="320"/><di:waypoint x="515" y="320"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="615" y="320"/><di:waypoint x="712" y="320"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_w1_di" bpmnElement="f_w1"><di:waypoint x="376" y="128"/><di:waypoint x="376" y="195"/><di:waypoint x="515" y="195"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_w2_di" bpmnElement="f_w2"><di:waypoint x="615" y="195"/><di:waypoint x="712" y="195"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_esc1_di" bpmnElement="f_esc1"><di:waypoint x="406" y="128"/><di:waypoint x="406" y="70"/><di:waypoint x="515" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_esc2_di" bpmnElement="f_esc2"><di:waypoint x="615" y="70"/><di:waypoint x="712" y="70"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
