<!-- Accounting of disclosures. Sangam compliance pack (jurisdiction-neutral): timelines arrive as process variables computed from the jurisdiction pack. Generated with its diagram layout by sangam-packs/tools/packgen (compliance.py): change the generator, then regenerate. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_sangam_dsr_accounting" targetNamespace="http://sangam.org/packs/compliance" exporter="sangam-compliance" exporterVersion="0.2.0">
  <process id="sangam-dsr-accounting" name="Accounting of disclosures" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <documentation>Accounting right (US-HIPAA 45 CFR 164.528: 60 days, one 30-day extension, six-year look-back, TPO excluded). Optional extension before the due date.</documentation>
    <startEvent id="start" name="Request received"/>
    <serviceTask id="s_start" name="Mark in progress" operaton:class="org.sangam.compliance.bpmn.ComplianceStepDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="step"><operaton:string>rights.start</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="u_review" name="Review accounting (extend if needed)" operaton:candidateGroups="${privacyOfficerSeat}" operaton:formKey="sangam:compliance/accounting-review"/>
    <boundaryEvent id="t_due" name="Due date" attachedToRef="u_review" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${dueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <exclusiveGateway id="g_ext" name="Extension?" default="f_go"/>
    <serviceTask id="s_extend" name="Extend once with written notice" operaton:class="org.sangam.compliance.bpmn.ComplianceStepDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="step"><operaton:string>rights.extend</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="u_review2" name="Complete accounting" operaton:candidateGroups="${privacyOfficerSeat}" operaton:formKey="sangam:compliance/accounting-review"/>
    <serviceTask id="s_acc" name="Build and send accounting" operaton:class="org.sangam.compliance.bpmn.ComplianceStepDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="step"><operaton:string>rights.accounting</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="end" name="Provided"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="s_start"/>
    <sequenceFlow id="f2" sourceRef="s_start" targetRef="u_review"/>
    <sequenceFlow id="f3" sourceRef="u_review" targetRef="g_ext"/>
    <sequenceFlow id="f_x" sourceRef="g_ext" targetRef="s_extend"><conditionExpression xsi:type="tFormalExpression">${extensionNeeded == true}</conditionExpression></sequenceFlow>
    <sequenceFlow id="f_x2" sourceRef="s_extend" targetRef="u_review2"/>
    <sequenceFlow id="f_x3" sourceRef="u_review2" targetRef="s_acc"/>
    <sequenceFlow id="f_go" sourceRef="g_ext" targetRef="s_acc"/>
    <sequenceFlow id="f4" sourceRef="s_acc" targetRef="end"/>
    <serviceTask id="esc" name="Escalate overdue request" operaton:class="org.sangam.compliance.bpmn.ComplianceStepDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="step"><operaton:string>rights.escalate</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="end_esc" name="Escalated"/>
    <sequenceFlow id="f_esc1" sourceRef="t_due" targetRef="esc"/>
    <sequenceFlow id="f_esc2" sourceRef="esc" targetRef="end_esc"/>
  </process>
  <bpmndi:BPMNDiagram id="dsr_accounting_diagram">
    <bpmndi:BPMNPlane id="dsr_accounting_plane" bpmnElement="sangam-dsr-accounting">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="52" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_start_di" bpmnElement="s_start"><dc:Bounds x="185" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="u_review_di" bpmnElement="u_review"><dc:Bounds x="350" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_ext_di" bpmnElement="g_ext"><dc:Bounds x="540" y="170" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_extend_di" bpmnElement="s_extend"><dc:Bounds x="680" y="155" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="u_review2_di" bpmnElement="u_review2"><dc:Bounds x="845" y="155" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_acc_di" bpmnElement="s_acc"><dc:Bounds x="1010" y="155" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end"><dc:Bounds x="1207" y="177" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="esc_di" bpmnElement="esc"><dc:Bounds x="515" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_esc_di" bpmnElement="end_esc"><dc:Bounds x="712" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_due_di" bpmnElement="t_due"><dc:Bounds x="358" y="92" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1"><di:waypoint x="88" y="70"/><di:waypoint x="185" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2"><di:waypoint x="285" y="70"/><di:waypoint x="350" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3"><di:waypoint x="450" y="70"/><di:waypoint x="495" y="70"/><di:waypoint x="495" y="195"/><di:waypoint x="540" y="195"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_x_di" bpmnElement="f_x"><di:waypoint x="590" y="195"/><di:waypoint x="680" y="195"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_x2_di" bpmnElement="f_x2"><di:waypoint x="780" y="195"/><di:waypoint x="845" y="195"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_x3_di" bpmnElement="f_x3"><di:waypoint x="945" y="195"/><di:waypoint x="1010" y="195"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_go_di" bpmnElement="f_go"><di:waypoint x="590" y="195"/><di:waypoint x="1010" y="195"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4"><di:waypoint x="1110" y="195"/><di:waypoint x="1207" y="195"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_esc1_di" bpmnElement="f_esc1"><di:waypoint x="376" y="128"/><di:waypoint x="376" y="70"/><di:waypoint x="515" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f_esc2_di" bpmnElement="f_esc2"><di:waypoint x="615" y="70"/><di:waypoint x="712" y="70"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
