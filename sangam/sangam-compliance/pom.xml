<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.sangam</groupId>
    <artifactId>sangam-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>sangam-compliance</artifactId>
  <name>Indian data-protection and cyber-security compliance (DPDP, CERT-In, IT Act)</name>

  <dependencies>
    <!-- Engine-neutral product layer: AuditChain, Transactions, Dialect, Jdbc, SecurityPorts. -->
    <dependency>
      <groupId>org.sangam</groupId>
      <artifactId>sangam-core</artifactId>
    </dependency>
    <!-- Erasure with tombstones (VI.5) and legal holds are reused, never duplicated: the adapters in
         org.sangam.compliance.adapters wrap ErasureService and LegalHoldStore. Optional, so the compliance ports can be
         served by another implementation. No cycle: sangam-integration does not depend on this module. -->
    <dependency>
      <groupId>org.sangam</groupId>
      <artifactId>sangam-integration</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- BPMN pack delegate (ComplianceStepDelegate). Apache-2.0. Provided by sangam-engine at runtime. -->
    <dependency>
      <groupId>org.operaton.bpm</groupId>
      <artifactId>operaton-engine</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- Apache-2.0 -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
