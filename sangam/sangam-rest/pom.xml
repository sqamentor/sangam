<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.sqamentor</groupId>
    <artifactId>sangam-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>sangam-rest</artifactId>
  <name>Sangam REST API (OpenAPI 3.1)</name>
  <description>Spring MVC controllers for /api/v1 (ARCHITECTURE.md section 4), service ports and default adapters.</description>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- The OpenAPI contract is served by sangam-server at /api/v1/openapi.yaml (classpath root). -->
      <resource>
        <directory>api</directory>
        <includes>
          <include>sangam-api.yaml</include>
          <!-- SL-38: deprecation registry, read by DeprecationHeadersFilter and gen_openapi.py -->
          <include>sangam-api-deprecations.yaml</include>
        </includes>
      </resource>
    </resources>
  </build>

  <dependencies>
    <!-- Decisions 277 and 285: the service ports, default adapters, support classes and extension SPI (plain Java,
         package names unchanged) moved to sangam-rest-core; every consumer of sangam-rest still sees them -->
    <dependency>
      <groupId>io.github.sqamentor</groupId>
      <artifactId>sangam-rest-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Generic modules exposed through optional REST configurations (final integration wave) -->
    <dependency>
      <groupId>io.github.sqamentor</groupId>
      <artifactId>sangam-config</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.github.sqamentor</groupId>
      <artifactId>sangam-ledger</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.github.sqamentor</groupId>
      <artifactId>sangam-billing</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.github.sqamentor</groupId>
      <artifactId>sangam-registry</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.github.sqamentor</groupId>
      <artifactId>sangam-resources</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.github.sqamentor</groupId>
      <artifactId>sangam-case</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.github.sqamentor</groupId>
      <artifactId>sangam-programme</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.github.sqamentor</groupId>
      <artifactId>sangam-geo</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.github.sqamentor</groupId>
      <artifactId>sangam-field</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.github.sqamentor</groupId>
      <artifactId>sangam-connectors-health</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.github.sqamentor</groupId>
      <artifactId>sangam-core</artifactId>
    </dependency>
    <!-- ADR-D-26: standalone DMN engines use Sangam's FEEL policies (SangamFeel); supplied at runtime by sangam-server -->
    <dependency>
      <groupId>io.github.sqamentor</groupId>
      <artifactId>sangam-engine</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- Web layer -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- SL-81: Spring MVC's JSON mapper in the Boot 4 server is Jackson 3; ProblemHandler names the field of a request
         value that does not bind. Version from the Spring Boot BOM; supplied at runtime by sangam-server -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- DocumentStore: java.time in persisted JSON documents (Apache-2.0) -->
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
    </dependency>
    <!-- CommandCatalog reads the R41 command list from api/sangam-api.yaml (Apache-2.0) -->
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <!-- /api/v1/compliance (org.sangam.rest.compliance); optional: the endpoints exist only when the server has it -->
    <dependency>
      <groupId>io.github.sqamentor</groupId>
      <artifactId>sangam-ai</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.github.sqamentor</groupId>
      <artifactId>sangam-ops</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <!-- Decision 155 (M-102): BackupController exists only when the server has sangam-backup -->
    <dependency>
      <groupId>io.github.sqamentor</groupId>
      <artifactId>sangam-backup</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.github.sqamentor</groupId>
      <artifactId>sangam-compliance</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- Default adapters: the Operaton Java API (RuntimeService, TaskService, ...) -->
    <dependency>
      <groupId>org.operaton.bpm</groupId>
      <artifactId>operaton-engine</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- the port test doubles (FakeWorkPort for WorkControllerLongPollTest) live with the ports in sangam-rest-core -->
    <dependency>
      <groupId>io.github.sqamentor</groupId>
      <artifactId>sangam-rest-core</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <!-- M-092: SchemaStatusReaderH2Test (version managed in the root pom) -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- org.springframework.mock.env.MockEnvironment for ScriptBackupWiringTest (decision 220); version from the Spring Boot
         dependencies import in the root pom (Spring Framework 7.0.10) -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.sqamentor</groupId>
      <artifactId>sangam-channels</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>io.github.sqamentor</groupId>
      <artifactId>sangam-modeller</artifactId>
      <version>${project.version}</version>
      <optional>true</optional>
    </dependency>
  </dependencies>
</project>
