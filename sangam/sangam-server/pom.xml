  <build>
    <plugins>
      <!-- M-014: the server's classes as a library for sangam-spring-boot-starter (classifier "plain"). The runnable
           fat jar below stays the main artifact with its file name unchanged (sangam-server-<v>.jar); every jar
           consumer (Dockerfiles, CI, licence check) already skips *-plain.jar. The server's own application*.yaml
           are left out of the library jar: on a host's class path they would be read as the host's configuration
           (classpath:/application.yaml); a host gets Sangam's defaults from the starter instead. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>plain-library-jar</id>
            <phase>package</phase>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classifier>plain</classifier>
              <excludes>
                <exclude>application.yaml</exclude>
                <exclude>application-*.yaml</exclude>
              </excludes>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${version.spring-boot}</version>
        <configuration>
          <mainClass>org.sangam.server.SangamServerApplication</mainClass>
          <!-- SL-53: spring-boot:run forks the server JVM in UTC; the server refuses any other default time zone -->
          <jvmArguments>-Duser.timezone=UTC</jvmArguments>
          <!-- PropertiesLauncher: loader.path=/opt/sangam/lib-ext adds customer/side-loaded drivers (deploy README 10) -->
          <layout>ZIP</layout>
          <excludes>
            <!-- LIC-4/LIC-5: the LGPL MariaDB driver is never inside the fat jar; the image adds it via loader.path.
                 It stays on the runtime class path for spring-boot:run and tests. -->
            <exclude>
              <groupId>org.mariadb.jdbc</groupId>
              <artifactId>mariadb-java-client</artifactId>
            </exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Testcontainers DB matrix (deploy README 10): -Dsangam.db=<postgres|oracle|sqlserver|mysql> or SANGAM_IT_DB;
         -DskipITs skips every integration test. -->
    <profile>
      <id>sangam-db-it</id>
      <activation>
        <property>
          <name>sangam.db</name>
        </property>
      </activation>
      <properties>
        <sangam.db>${env.SANGAM_IT_DB}</sangam.db>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <!-- the repackaged Boot jar hides classes under BOOT-INF; test against the compiled classes -->
              <classesDirectory>${project.build.outputDirectory}</classesDirectory>
              <systemPropertyVariables>
                <sangam.db>${sangam.db}</sangam.db>
                <api.version>1.44</api.version>
              </systemPropertyVariables>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- Decision 123 (RM-23, CR-17): Oracle JDBC (ojdbc11) for the Oracle acceptance lane only. CI-only, never active
         by default, test scope (LIC-2: never bundled; the root enforcer bans com.oracle.database.* in shipped scopes).
         db-matrix.yml activates it on the Oracle lane: -Psangam-db-it,sangam-it-only,oracle-it -Dsangam.db=oracle. -->
    <profile>
      <id>oracle-it</id>
      <dependencies>
        <dependency>
          <groupId>com.oracle.database.jdbc</groupId>
          <artifactId>ojdbc11</artifactId>
          <version>23.8.0.25.04</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <!-- Decision 217: the optional eSign and DSC signing module (sangam-esign, the only holder of Bouncy Castle) is never
         a dependency of this module, in any profile: Bouncy Castle is banned from the server (enforcer, SL-106), so the
         fat jar never contains it. The add-on is shipped beside the fat jar (deploy/docker/server/esign-addon.sh: image
         build arg WITH_ESIGN=true, or the release asset sangam-esign-<v>.tgz in /opt/sangam/lib-ext, deploy README). -->
    <!-- Decisions 183 and 187: HAPI FHIR profile validation as an opt-in runtime add-on. sangam-connectors-health declares
         HAPI as OPTIONAL, so the default server carries none of it (FhirProfileValidations answers CAPABILITY_MISSING);
         -Psangam-health-validation adds the same closure, versions and exclusions as that module's pom (keep the two
         in step), and the health module itself is still switched on at run time with
         sangam.modules.connectors-health.enabled=true. -->
    <profile>
      <id>sangam-health-validation</id>
      <properties>
        <version.hapi-fhir>8.12.1</version.hapi-fhir>
      </properties>
      <dependencyManagement>
        <dependencies>
          <dependency>
            <groupId>org.javassist</groupId>
            <artifactId>javassist</artifactId>
            <version>3.33.0-GA</version>
          </dependency>
          <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <version>3.0.0</version>
          </dependency>
          <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>3.1.8</version>
          </dependency>
        </dependencies>
      </dependencyManagement>
      <dependencies>
        <dependency>
          <groupId>ca.uhn.hapi.fhir</groupId>
          <artifactId>hapi-fhir-validation</artifactId>
          <version>${version.hapi-fhir}</version>
          <scope>runtime</scope>
          <exclusions>
            <exclusion>
              <groupId>jakarta-regexp</groupId>
              <artifactId>jakarta-regexp</artifactId>
            </exclusion>
            <exclusion>
              <groupId>org.xerial</groupId>
              <artifactId>sqlite-jdbc</artifactId>
            </exclusion>
            <exclusion>
              <groupId>org.ogce</groupId>
              <artifactId>xpp3</artifactId>
            </exclusion>
          </exclusions>
        </dependency>
        <!-- Decisions 226, 254 and 263: the XmlPull parser of the FHIR validator is io.github.x-stream:mxparser 1.2.2
             (parser only, no org.xmlpull.v1 class inside, found through META-INF/services by XmlPullParserFactory;
             Indiana University Extreme! Lab Software License 1.2, attribution in NOTICE); xmlpull 1.1.3.1 below is the
             only org.xmlpull.v1 API jar. Replaces xpp3_min 1.1.4c, as in sangam-connectors-health. -->
        <dependency>
          <groupId>io.github.x-stream</groupId>
          <artifactId>mxparser</artifactId>
          <version>1.2.2</version>
          <scope>runtime</scope>
        </dependency>
        <dependency>
          <groupId>xmlpull</groupId>
          <artifactId>xmlpull</artifactId>
          <version>1.1.3.1</version>
          <scope>runtime</scope>
        </dependency>
        <dependency>
          <groupId>ca.uhn.hapi.fhir</groupId>
          <artifactId>hapi-fhir-structures-r4</artifactId>
          <version>${version.hapi-fhir}</version>
          <scope>runtime</scope>
        </dependency>
        <dependency>
          <groupId>ca.uhn.hapi.fhir</groupId>
          <artifactId>hapi-fhir-validation-resources-r4</artifactId>
          <version>${version.hapi-fhir}</version>
          <scope>runtime</scope>
        </dependency>
        <dependency>
          <groupId>ca.uhn.hapi.fhir</groupId>
          <artifactId>hapi-fhir-caching-caffeine</artifactId>
          <version>${version.hapi-fhir}</version>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
