<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.sangam</groupId>
    <artifactId>sangam-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>sangam-server</artifactId>
  <name>Sangam server (Spring Boot assembly)</name>
  <description>Spring Boot application: Sangam API (/api/v1), Operaton REST (/engine-rest) behind Sangam auth, profiles per database.</description>

  <dependencies>
    <!-- Broker inbound (off by default): compile/runtime API for KafkaInboxConsumer, JmsInboxListener -->
    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
      <version>3.9.1</version>
    </dependency>
    <dependency>
      <groupId>jakarta.jms</groupId>
      <artifactId>jakarta.jms-api</artifactId>
      <version>3.1.0</version>
    </dependency>
    <!-- Generic modules wired in config/*Wiring (final integration wave) -->
    <dependency>
      <groupId>org.sangam</groupId>
      <artifactId>sangam-onboarding</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.sangam</groupId>
      <artifactId>sangam-config</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.sangam</groupId>
      <artifactId>sangam-ledger</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.sangam</groupId>
      <artifactId>sangam-billing</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.sangam</groupId>
      <artifactId>sangam-registry</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.sangam</groupId>
      <artifactId>sangam-resources</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.sangam</groupId>
      <artifactId>sangam-case</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.sangam</groupId>
      <artifactId>sangam-programme</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.sangam</groupId>
      <artifactId>sangam-geo</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.sangam</groupId>
      <artifactId>sangam-field</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.sangam</groupId>
      <artifactId>sangam-connectors-health</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Sangam modules (ARCHITECTURE.md section 3) -->
    <dependency>
      <groupId>org.sangam</groupId>
      <artifactId>sangam-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.sangam</groupId>
      <artifactId>sangam-rest</artifactId>
    </dependency>
    <dependency>
      <groupId>org.sangam</groupId>
      <artifactId>sangam-persistence</artifactId>
    </dependency>
    <dependency>
      <groupId>org.sangam</groupId>
      <artifactId>sangam-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>org.sangam</groupId>
      <artifactId>sangam-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.sangam</groupId>
      <artifactId>sangam-integration</artifactId>
    </dependency>
    <dependency>
      <groupId>org.sangam</groupId>
      <artifactId>sangam-flowable-ports</artifactId>
    </dependency>
    <dependency>
      <groupId>org.sangam</groupId>
      <artifactId>sangam-packs</artifactId>
    </dependency>
    <dependency>
      <groupId>org.sangam</groupId>
      <artifactId>sangam-ai</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.sangam</groupId>
      <artifactId>sangam-ops</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.sangam</groupId>
      <artifactId>sangam-compliance</artifactId>
    </dependency>
    <!-- SCALE: cell registration, roll-up and cross-cell publishers (IR-2, IR-3); active only with sangam.cell.id -->
    <dependency>
      <groupId>org.sangam</groupId>
      <artifactId>sangam-cell</artifactId>
    </dependency>

    <!-- Spring Boot 4 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-opentelemetry</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <!-- Operaton 2.2.0 engine + REST at /engine-rest (version from operaton-bom, imported by the parent) -->
    <dependency>
      <groupId>org.operaton.bpm.springboot</groupId>
      <artifactId>operaton-bpm-spring-boot-starter-rest</artifactId>
    </dependency>

    <!-- Schema: Liquibase pinned at 4.33.0 (D-7 / LIC-7) -->
    <dependency>
      <groupId>org.liquibase</groupId>
      <artifactId>liquibase-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
    </dependency>

    <!-- JDBC drivers. Oracle (and Db2, MySQL Connector/J) are never bundled (LIC-4): customer-supplied on the class path. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.microsoft.sqlserver</groupId>
      <artifactId>mssql-jdbc</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.mariadb.jdbc</groupId>
      <artifactId>mariadb-java-client</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.sangam</groupId>
      <artifactId>sangam-channels</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.sangam</groupId>
      <artifactId>sangam-modeller</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${version.spring-boot}</version>
        <configuration>
          <mainClass>org.sangam.server.SangamServerApplication</mainClass>
          <!-- PropertiesLauncher: loader.path=/opt/sangam/lib-ext adds customer/side-loaded drivers (deploy README 10) -->
          <layout>ZIP</layout>
          <excludes>
            <!-- LIC-4/LIC-5: the LGPL MariaDB driver is never inside the fat jar; the image adds it via loader.path.
                 It stays on the runtime class path for spring-boot:run and tests. -->
            <exclude>
              <groupId>org.mariadb.jdbc</groupId>
              <artifactId>mariadb-java-client</artifactId>
            </exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Testcontainers DB matrix (deploy README 10): -Dsangam.db=<postgres|oracle|sqlserver|mysql> or SANGAM_IT_DB;
         -DskipITs skips every integration test. -->
    <profile>
      <id>sangam-db-it</id>
      <activation>
        <property>
          <name>sangam.db</name>
        </property>
      </activation>
      <properties>
        <sangam.db>${env.SANGAM_IT_DB}</sangam.db>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <sangam.db>${sangam.db}</sangam.db>
                <api.version>1.44</api.version>
              </systemPropertyVariables>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
