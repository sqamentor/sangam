<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!--
  Sangam bill of materials for consumers (SG-26). Import it FIRST in your dependencyManagement, before any other BOM
  (Spring Boot 4's BOM manages Liquibase 5.x, which is FSL-licensed and not allowed by Sangam's LIC-7 / D-7):

    <dependency><groupId>org.sangam</groupId><artifactId>sangam-bom</artifactId><version>...</version>
                <type>pom</type><scope>import</scope></dependency>

  No parent on purpose: nothing from Sangam's build (or Spring Boot) leaks into a consumer. Sangam also refuses to
  run a Liquibase other than 4.x at start-up (org.sangam.core.licence.LiquibaseLicenceGuard).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.sangam</groupId>
  <artifactId>sangam-bom</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Sangam BOM</name>
  <description>Versions of every Sangam library and the licence-pinned third-party libraries.</description>
  <licenses><license><name>Apache-2.0</name><url>https://www.apache.org/licenses/LICENSE-2.0</url></license></licenses>

  <dependencyManagement>
    <dependencies>
      <dependency><groupId>org.sangam</groupId><artifactId>sangam-core</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>org.sangam</groupId><artifactId>sangam-persistence</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>org.sangam</groupId><artifactId>sangam-engine</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>org.sangam</groupId><artifactId>sangam-security</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>org.sangam</groupId><artifactId>sangam-integration</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>org.sangam</groupId><artifactId>sangam-connectors-health</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>org.sangam</groupId><artifactId>sangam-flowable-ports</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>org.sangam</groupId><artifactId>sangam-rest</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>org.sangam</groupId><artifactId>sangam-packs</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>org.sangam</groupId><artifactId>sangam-compliance</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>org.sangam</groupId><artifactId>sangam-config</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>org.sangam</groupId><artifactId>sangam-ledger</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>org.sangam</groupId><artifactId>sangam-registry</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>org.sangam</groupId><artifactId>sangam-billing</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>org.sangam</groupId><artifactId>sangam-case</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>org.sangam</groupId><artifactId>sangam-programme</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>org.sangam</groupId><artifactId>sangam-resources</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>org.sangam</groupId><artifactId>sangam-geo</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>org.sangam</groupId><artifactId>sangam-field</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>org.sangam</groupId><artifactId>sangam-sdk-java</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>org.sangam</groupId><artifactId>sangam-cell</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>org.sangam</groupId><artifactId>sangam-ai</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>org.sangam</groupId><artifactId>sangam-channels</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>org.sangam</groupId><artifactId>sangam-ops</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>org.sangam</groupId><artifactId>sangam-modeller</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>org.sangam</groupId><artifactId>sangam-onboarding</artifactId><version>${project.version}</version></dependency>
      <!-- LIC-7 / D-7: Liquibase 4.x only (5.x is FSL) -->
      <dependency><groupId>org.liquibase</groupId><artifactId>liquibase-core</artifactId><version>4.33.0</version></dependency>
      <!-- SG-28: Operaton's StrongUuidGenerator needs it at run time (operaton-engine declares it provided) -->
      <dependency><groupId>com.fasterxml.uuid</groupId><artifactId>java-uuid-generator</artifactId><version>5.2.0</version></dependency>
      <!-- SG-27 / OneIFMS SD-301 owner exception: Operaton DMN FEEL engine closure, exactly these versions (the ones
           operaton-engine-dmn 2.2.0 resolves; licences verified in deploy/licence/SG-27-SD-301-exception.md). Without
           these a bare consumer gets jackson-module-scala 2.22.1 and a non-converging scala-library. -->
      <dependency><groupId>org.camunda.feel</groupId><artifactId>feel-engine</artifactId><version>1.22.1</version></dependency>
      <dependency><groupId>org.scala-lang</groupId><artifactId>scala-library</artifactId><version>2.13.18</version></dependency>
      <dependency><groupId>com.lihaoyi</groupId><artifactId>fastparse_2.13</artifactId><version>3.1.1</version></dependency>
      <dependency><groupId>com.lihaoyi</groupId><artifactId>sourcecode_2.13</artifactId><version>0.4.0</version></dependency>
      <dependency><groupId>com.lihaoyi</groupId><artifactId>geny_2.13</artifactId><version>1.1.0</version></dependency>
      <dependency><groupId>com.fasterxml.jackson.module</groupId><artifactId>jackson-module-scala_2.13</artifactId><version>2.22.3</version></dependency>
    </dependencies>
  </dependencyManagement>
</project>
