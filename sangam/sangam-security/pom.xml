<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.sqamentor</groupId>
    <artifactId>sangam-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>sangam-security</artifactId>
  <name>Authorization (deny-wins), OIDC, seats, delegation, maker-checker</name>

  <dependencies>
    <dependency>
      <groupId>io.github.sqamentor</groupId>
      <artifactId>sangam-core</artifactId>
    </dependency>
    <!-- ADR-D-26: standalone DMN engines use Sangam's FEEL policies (SangamFeel); supplied at runtime by sangam-server -->
    <dependency>
      <groupId>io.github.sqamentor</groupId>
      <artifactId>sangam-engine</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- Operaton is supplied at runtime by sangam-engine / sangam-server (ADR-D-16); compile against it only. -->
    <dependency>
      <groupId>org.operaton.bpm</groupId>
      <artifactId>operaton-engine</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.operaton.bpm.dmn</groupId>
      <artifactId>operaton-engine-dmn</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- M-141a (decisions 72-75): no Spring and no servlet dependency here. The Spring Security resource server, the
         token filters and the client JWT verifier live in the Spring host (sangam-server, package
         org.sangam.security.spring); this jar stays plain Java. -->

    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- GovSsoSimulatorConformanceTest verifies the simulator's signed tokens. Nimbus JOSE+JWT (Apache-2.0) is test
         scope only since M-141a; main code never uses it. The version is the one spring-security-oauth2-jose 7.1.2
         brings to sangam-server, managed in the root pom. -->
    <dependency>
      <groupId>com.nimbusds</groupId>
      <artifactId>nimbus-jose-jwt</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- M-086 property test (set-based field masks equal the per-row result). Version and test scope are managed in the
         root pom (M-095 approved batch 1); never shipped. -->
    <dependency>
      <groupId>net.jqwik</groupId>
      <artifactId>jqwik</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- M-077 T89: the government SSO adapter is tested against its simulator (sim/parichay). Test scope only; no
         cycle: sangam-integration depends on core, engine, packs and flowable-ports, never on sangam-security. -->
    <dependency>
      <groupId>io.github.sqamentor</groupId>
      <artifactId>sangam-integration</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
