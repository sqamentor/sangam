{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Sangam chart values",
  "type": "object",
  "required": ["database", "liquibase", "oidc", "server"],
  "properties": {
    "database": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["postgres", "oracle", "sqlserver", "mysql"] },
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "name": { "type": "string", "minLength": 1 },
        "jdbcUrl": { "type": "string" },
        "params": { "type": "string" },
        "existingSecret": { "type": "string" },
        "usernameKey": { "type": "string", "minLength": 1 },
        "passwordKey": { "type": "string", "minLength": 1 },
        "pool": {
          "type": "object",
          "properties": {
            "connectionTimeoutMs": { "type": "integer", "minimum": 1 },
            "leafPools": {
              "$comment": "SL-168: SANGAM_QUOTA_POOL_SIZE, SANGAM_SECURITY_DENIAL_AUDIT_POOL_SIZE, SANGAM_COMPLIANCE_DENIAL_AUDIT_POOL_SIZE, SANGAM_CONFIG_STORE_POOL_SIZE; each on top of maximumPoolSize per pod.",
              "type": "object",
              "properties": {
                "quota": { "type": "integer", "minimum": 1 },
                "securityDenialAudit": { "type": "integer", "minimum": 1 },
                "complianceDenialAudit": { "type": "integer", "minimum": 1 },
                "configStore": { "type": "integer", "minimum": 1 }
              }
            }
          }
        },
        "networkTimeout": { "type": "string", "pattern": "^$|^[0-9]+(ns|us|ms|s|m|h|d)?$|^P[0-9A-Za-z.]+$" },
        "unavailableRetryAfter": { "type": "string", "pattern": "^$|^[0-9]+(ns|us|ms|s|m|h|d)?$|^P[0-9A-Za-z.]+$" }
      }
    },
    "liquibase": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["job", "startup", "none"] }
      }
    },
    "oidc": {
      "type": "object",
      "properties": {
        "issuerUri": { "type": "string" },
        "jwkSetUri": { "type": "string" },
        "platformIssuerUri": { "type": "string" },
        "platformJwkSetUri": { "type": "string" },
        "audience": { "type": "string" }
      }
    },
    "otel": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" }, "endpoint": { "type": "string" }, "engineTracing": { "type": "boolean" } }
    },
    "server": {
      "type": "object",
      "properties": {
        "production": { "type": "boolean", "$comment": "Decisions 143 and 198: SANGAM_SECURITY_PRODUCTION, always rendered explicitly; keep true on every cluster install." },
        "aiKbVectorIndex": { "type": "string", "enum": ["portable", "pgvector", "oracle"], "$comment": "Decision 247 (170, 207): SANGAM_AI_KB_VECTOR_INDEX, the names VectorIndex.named accepts; oracle needs Oracle AI Database 23ai or later and applies the oracle-vector changelog." },
        "dscOcspMaxAge": { "type": "string", "pattern": "^([1-9][0-9]*(ms|s|m|h|d)|P[1-9][0-9]*D|PT[1-9][0-9]*[HMS])$", "$comment": "Decision 259: SANGAM_DSC_OCSP_MAX_AGE, a positive duration with one unit: Spring form (24h, 90m) or ISO-8601 (PT24H, P1D)." },
        "integrationReconciliationMaxRedispatches": { "type": "integer", "minimum": 1, "maximum": 2147483647, "$comment": "Decision 290: SANGAM_INTEGRATION_RECONCILIATION_MAX_REDISPATCHES, automatic re-dispatches of a pack operation with no process instance before reconciliation hands it to a person; a positive integer (the server refuses any other value)." },
        "dlt": {
          "$comment": "Decisions 304 and 305: SANGAM_DLT_DELIVERY_REPORT_TOLERANCE, SANGAM_DLT_DELIVERY_STATUS_ENABLED, SANGAM_DLT_DELIVERY_STATUS_INTERVAL, SANGAM_DLT_REGISTRATION_REFRESH_INTERVAL. Durations are positive with one unit: Spring form (5m, 90s) or ISO-8601 (PT5M); the server refuses zero and negative durations at start.",
          "type": "object",
          "properties": {
            "deliveryReportTolerance": { "type": "string", "pattern": "^([1-9][0-9]*(s|m|h|d)|P[1-9][0-9]*D|PT[1-9][0-9]*[HMS])$" },
            "deliveryStatus": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "interval": { "type": "string", "pattern": "^([1-9][0-9]*(s|m|h|d)|P[1-9][0-9]*D|PT[1-9][0-9]*[HMS])$" }
              }
            },
            "registrationRefreshInterval": { "type": "string", "pattern": "^([1-9][0-9]*(s|m|h|d)|P[1-9][0-9]*D|PT[1-9][0-9]*[HMS])$" }
          }
        },
        "systemAuditScope": { "type": "string", "pattern": "^system:[a-z0-9][a-z0-9._-]{0,47}$", "$comment": "Decision 144: SANGAM_ENGINE_SYSTEM_AUDIT_SCOPE, the same grammar as SystemAuditScope (sangam-core); the server refuses to start on any other value." },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "preStopSleepSeconds": { "type": "integer", "minimum": 0 },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 30 },
        "jobExecutor": {
          "type": "object",
          "properties": {
            "exclusiveOverProcessHierarchies": { "type": "boolean" },
            "virtualThreads": { "type": "boolean" }
          }
        }
      }
    },
    "malware": {
      "$comment": "M-082: SANGAM_MALWARE_*; clamd needs a host or this release's ClamAV service, icap needs a uri; the ClamAV image tag is pinned (owner decision 71).",
      "type": "object",
      "additionalProperties": false,
      "required": ["scanner", "failClosed", "timeout", "maxBytes", "clamd", "icap", "clamav"],
      "properties": {
        "scanner": { "type": "string", "enum": ["none", "clamd", "icap"] },
        "failClosed": { "type": "boolean" },
        "timeout": { "type": "string", "pattern": "^[0-9]+(ns|us|ms|s|m|h|d)?$|^P[0-9A-Za-z.]+$" },
        "maxBytes": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "clamd": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "icap": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "uri": { "type": "string", "pattern": "^$|^icaps?://" } }
        },
        "clamav": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "image": {
              "type": "object",
              "required": ["repository", "tag"],
              "properties": {
                "repository": { "type": "string", "minLength": 1 },
                "tag": { "type": "string", "minLength": 1, "not": { "enum": ["latest", "stable", "unstable"] } },
                "digest": { "type": "string" }
              }
            },
            "replicaCount": { "type": "integer", "minimum": 1 },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "egress": { "type": "array" },
            "extraEnv": { "type": "array" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "scanner": { "const": "icap" } } },
          "then": { "properties": { "icap": { "required": ["uri"], "properties": { "uri": { "minLength": 1 } } } } }
        }
      ]
    },
    "secrets": {
      "$comment": "M-075: SANGAM_SECRETS_*, rendered only when providers is set; every *Ref is a secret:// reference, never a value.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "providers": { "type": "string", "pattern": "^$|^(file|vault|aws|azure|gcp|env)(,(file|vault|aws|azure|gcp|env))*$" },
        "cacheTtl": { "type": "string", "pattern": "^$|^[0-9]+(ns|us|ms|s|m|h|d)?$|^P[0-9A-Za-z.]+$" },
        "file": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "root": { "type": "string", "pattern": "^$|^/" }, "existingSecret": { "type": "string" } }
        },
        "vault": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string" },
            "mount": { "type": "string" },
            "pathPrefix": { "type": "string" },
            "namespace": { "type": "string" },
            "tokenRef": { "$ref": "#/definitions/secretRef" },
            "allowPrivate": { "type": "boolean" }
          }
        },
        "aws": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "region": { "type": "string" },
            "endpoint": { "type": "string" },
            "namePrefix": { "type": "string" },
            "accessKeyRef": { "$ref": "#/definitions/secretRef" },
            "secretKeyRef": { "$ref": "#/definitions/secretRef" },
            "sessionTokenRef": { "$ref": "#/definitions/secretRef" }
          }
        },
        "azure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "vaultUrl": { "type": "string" },
            "tenantId": { "type": "string" },
            "clientId": { "type": "string" },
            "clientSecretRef": { "$ref": "#/definitions/secretRef" },
            "authority": { "type": "string" }
          }
        },
        "gcp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "project": { "type": "string" },
            "serviceAccountKeyRef": { "$ref": "#/definitions/secretRef" },
            "namePrefix": { "type": "string" },
            "endpoint": { "type": "string" }
          }
        }
      }
    },
    "scriptWorker": {
      "$comment": "M-061: optional script worker; credentials only from existingSecret (token or clientSecret); privileges per owner decision 78.",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "url": { "type": "string" },
        "existingSecret": { "type": "string" },
        "oidcTokenUrl": { "type": "string" },
        "clientId": { "type": "string" },
        "languages": { "type": "string", "pattern": "^$|^(javascript|python)(,(javascript|python))*$" },
        "maxConcurrency": { "type": "string", "pattern": "^$|^[1-9][0-9]*$" },
        "cpuSeconds": { "type": "string", "pattern": "^$|^[1-9][0-9]*$" },
        "wallTime": { "type": "string", "pattern": "^$|^P[0-9A-Za-z.]+$" },
        "memoryBytes": { "type": "string", "pattern": "^$|^[1-9][0-9]*$" },
        "maxProcesses": { "type": "string", "pattern": "^$|^[1-9][0-9]*$" },
        "extraEnv": { "type": "array" }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": { "required": ["existingSecret"], "properties": { "existingSecret": { "minLength": 1 } } }
    },
    "ui": {
      "type": "object",
      "properties": {
        "traceUrlTemplate": { "type": "string", "pattern": "^$|^https?://[^\\s]*\\{traceId\\}" },
        "dscAgentOrigin": {
          "$comment": "Decision 165: SANGAM_DSC_AGENT_ORIGIN of the UI image (17-sangam-dsc.envsh): empty or http://127.0.0.1:<port> or http://localhost:<port>, port 1-65535 without leading zeros; IPv4 loopback only, never [::1] (coordinator ruling; CSP3 host grammar cannot name it either).",
          "type": "string",
          "pattern": "^$|^http://(127\\.0\\.0\\.1|localhost):([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
        },
        "idleMinutes": {
          "$comment": "Decisions 349 and 359: SANGAM_UI_IDLE_MINUTES of the UI image (18-sangam-session.envsh): whole minutes 1-480; the idle sign-out cannot be switched off.",
          "type": "integer",
          "minimum": 1,
          "maximum": 480
        },
        "teams": {
          "$comment": "Decision 213: SANGAM_TEAMS_ENABLED and SANGAM_TEAMS_FRAME_ANCESTORS of the UI image; frameAncestors empty = the image's built-in Microsoft list, else space-separated https://host[:port] or https://*.host origins (the image refuses anything else).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "frameAncestors": { "type": "string", "pattern": "^$|^https://(\\*\\.)?[A-Za-z0-9.-]+(:[0-9]{1,5})?( https://(\\*\\.)?[A-Za-z0-9.-]+(:[0-9]{1,5})?)*$" }
          }
        }
      }
    },
    "pdfValidator": { "$ref": "#/definitions/sidecar" },
    "ocr": { "$ref": "#/definitions/sidecar" },
    "sidecarTrustStore": {
      "$comment": "M-081 / M-103: Secret with keys truststore.p12 and password; required when a sidecar is enabled with transport tls (root allOf).",
      "type": "object",
      "properties": { "existingSecret": { "type": "string" } }
    },
    "ingress": {
      "$comment": "SG-39 / Q-09: with private.enabled=true the public className is refused, a class is required, the user annotations cannot select a public load balancer, and every cloud preset carries its internal-load-balancer annotation.",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "$ref": "#/definitions/annotations" },
        "host": { "type": "string", "minLength": 1 },
        "tls": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" }, "secretName": { "type": "string" } }
        },
        "private": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "className", "preset", "presets"],
          "properties": {
            "enabled": { "type": "boolean" },
            "className": { "type": "string", "not": { "$ref": "#/definitions/publicIngressClass" } },
            "preset": { "type": "string", "enum": ["", "aws", "azure", "gcp"] },
            "presets": {
              "type": "object",
              "additionalProperties": false,
              "required": ["aws", "azure", "gcp"],
              "properties": {
                "aws": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["className", "annotations"],
                  "properties": {
                    "className": { "type": "string", "minLength": 1 },
                    "annotations": {
                      "allOf": [
                        { "$ref": "#/definitions/annotations" },
                        {
                          "required": ["alb.ingress.kubernetes.io/scheme"],
                          "properties": { "alb.ingress.kubernetes.io/scheme": { "const": "internal" } }
                        }
                      ]
                    }
                  }
                },
                "azure": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["className", "annotations"],
                  "properties": {
                    "className": { "type": "string", "minLength": 1 },
                    "annotations": {
                      "allOf": [
                        { "$ref": "#/definitions/annotations" },
                        {
                          "required": ["appgw.ingress.kubernetes.io/use-private-ip"],
                          "properties": { "appgw.ingress.kubernetes.io/use-private-ip": { "const": "true" } }
                        }
                      ]
                    }
                  }
                },
                "gcp": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["className", "annotations"],
                  "properties": {
                    "className": { "const": "" },
                    "annotations": {
                      "allOf": [
                        { "$ref": "#/definitions/annotations" },
                        {
                          "required": ["kubernetes.io/ingress.class"],
                          "properties": { "kubernetes.io/ingress.class": { "const": "gce-internal" } }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "if": { "properties": { "enabled": { "const": true }, "preset": { "const": "" } } },
              "then": { "properties": { "className": { "minLength": 1 } } }
            },
            {
              "if": { "properties": { "preset": { "const": "gcp" } } },
              "then": { "properties": { "className": { "const": "" } } }
            }
          ]
        }
      },
      "if": {
        "required": ["private"],
        "properties": { "private": { "required": ["enabled"], "properties": { "enabled": { "const": true } } } }
      },
      "then": {
        "required": ["enabled", "className"],
        "properties": {
          "enabled": { "const": true },
          "className": { "const": "" },
          "annotations": {
            "properties": {
              "alb.ingress.kubernetes.io/scheme": { "const": "internal" },
              "appgw.ingress.kubernetes.io/use-private-ip": { "const": "true" },
              "kubernetes.io/ingress.class": { "not": { "$ref": "#/definitions/publicIngressClass" } }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string" },
            "labels": { "$ref": "#/definitions/annotations" }
          }
        },
        "prometheusRule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "labels", "thresholds", "certManager"],
          "properties": {
            "enabled": { "type": "boolean" },
            "labels": { "$ref": "#/definitions/annotations" },
            "thresholds": {
              "type": "object",
              "additionalProperties": false,
              "required": ["outboxOldestAgeSeconds", "outboxCapacityRatio", "outboxParked", "relayLastCycleAgeSeconds", "rootLockWaitSeconds", "incidentsOpen", "reconciliationOpen", "certExpiryDays"],
              "properties": {
                "outboxOldestAgeSeconds": { "type": "integer", "minimum": 1 },
                "outboxCapacityRatio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
                "outboxParked": { "type": "integer", "minimum": 0 },
                "relayLastCycleAgeSeconds": { "type": "integer", "minimum": 1 },
                "rootLockWaitSeconds": { "type": "number", "exclusiveMinimum": 0 },
                "incidentsOpen": { "type": "integer", "minimum": 0 },
                "reconciliationOpen": { "type": "integer", "minimum": 0 },
                "certExpiryDays": { "type": "integer", "minimum": 1 }
              }
            },
            "certManager": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "selector"],
              "properties": { "enabled": { "type": "boolean" }, "selector": { "type": "string", "pattern": "^[^'{}]*$" } }
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "ingressFrom": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cidrs"],
          "properties": {
            "cidrs": { "type": "array", "items": { "$ref": "#/definitions/cidr" } }
          }
        }
      }
    },
    "backup": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "console": {
          "$comment": "Decision 155 (W4-I): Role <fullname>-backup-console, server env and token, and server egress to the API server, only with backup.enabled and console.enabled; apiServer.cidrs is required then when networkPolicy.enabled (template check).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "apiServer": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cidrs": { "type": "array", "items": { "$ref": "#/definitions/cidr" } },
                "ports": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1, "maximum": 65535 } }
              }
            }
          }
        },
        "retentionDays": { "type": "integer", "minimum": 1 },
        "oracle": { "type": "object", "properties": { "image": { "type": "string" } } },
        "sqlserver": {
          "type": "object",
          "properties": {
            "image": { "type": "string" },
            "destinationType": { "type": "string", "enum": ["DISK", "URL"] }
          }
        },
        "mysql": { "type": "object", "properties": { "image": { "type": "string" } } }
      },
      "$comment": "Decision 129 (RM-34): the vendor backup images have no default. The root allOf requires the image of the configured database type when backup is enabled; templates/backup-cronjobs.yaml enforces the same with required."
    }
  },
  "allOf": [
    {
      "$comment": "M-081 / M-103 (decision 153): an enabled sidecar on transport tls needs the server trust store Secret.",
      "if": {
        "anyOf": [
          { "properties": { "pdfValidator": { "properties": { "enabled": { "const": true }, "transport": { "const": "tls" } }, "required": ["enabled", "transport"] } }, "required": ["pdfValidator"] },
          { "properties": { "ocr": { "properties": { "enabled": { "const": true }, "transport": { "const": "tls" } }, "required": ["enabled", "transport"] } }, "required": ["ocr"] }
        ]
      },
      "then": {
        "properties": { "sidecarTrustStore": { "properties": { "existingSecret": { "type": "string", "minLength": 1 } }, "required": ["existingSecret"] } },
        "required": ["sidecarTrustStore"]
      }
    },
    {
      "$comment": "Decision 129 (RM-34): backup of a SQL Server database needs backup.sqlserver.image (no default).",
      "if": {
        "properties": {
          "backup": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
          "database": { "properties": { "type": { "const": "sqlserver" } }, "required": ["type"] }
        },
        "required": ["backup", "database"]
      },
      "then": {
        "properties": { "backup": { "properties": { "sqlserver": { "properties": { "image": { "type": "string", "minLength": 1 } }, "required": ["image"] } }, "required": ["sqlserver"] } }
      }
    },
    {
      "$comment": "Decision 129 (RM-34): backup of a MySQL database needs backup.mysql.image (no default).",
      "if": {
        "properties": {
          "backup": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
          "database": { "properties": { "type": { "const": "mysql" } }, "required": ["type"] }
        },
        "required": ["backup", "database"]
      },
      "then": {
        "properties": { "backup": { "properties": { "mysql": { "properties": { "image": { "type": "string", "minLength": 1 } }, "required": ["image"] } }, "required": ["mysql"] } }
      }
    },
    {
      "$comment": "Backup of an Oracle database needs backup.oracle.image (RMAN is not redistributable, LIC-2).",
      "if": {
        "properties": {
          "backup": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
          "database": { "properties": { "type": { "const": "oracle" } }, "required": ["type"] }
        },
        "required": ["backup", "database"]
      },
      "then": {
        "properties": { "backup": { "properties": { "oracle": { "properties": { "image": { "type": "string", "minLength": 1 } }, "required": ["image"] } }, "required": ["oracle"] } }
      }
    }
  ],
  "definitions": {
    "cidr": {
      "$comment": "An IPv4 or IPv6 CIDR (address/prefix), as a NetworkPolicy ipBlock.cidr takes it.",
      "type": "string",
      "pattern": "^([0-9]{1,3}([.][0-9]{1,3}){3}/([0-9]|[12][0-9]|3[0-2])|[0-9A-Fa-f:]*:[0-9A-Fa-f:.]*/([0-9]|[1-9][0-9]|1[01][0-9]|12[0-8]))$"
    },
    "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "secretRef": {
      "$comment": "M-075: a secret:// reference resolved by the file and env providers, never a secret value.",
      "type": "string",
      "pattern": "^$|^secret://"
    },
    "publicIngressClass": {
      "$comment": "Classes that only ever provision a public load balancer: GKE 'gce' (external Application Load Balancer).",
      "enum": ["gce"]
    },
    "sidecar": {
      "$comment": "M-081 / M-103 (owner decisions 114, 153, 167): pdfValidator and ocr. Credentials only from existingSecret (token; keystore.p12 and keystore-password with transport tls) and clientExistingSecret (token for the server); never values.",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "transport": { "type": "string", "enum": ["tls", "mesh"] },
        "existingSecret": { "type": "string" },
        "clientExistingSecret": { "type": "string" },
        "url": { "type": "string", "pattern": "^$|^https?://[^\\s/?#@]+(/[^\\s?#]*)?$" },
        "timeoutMs": { "type": ["string", "integer"], "pattern": "^$|^[1-9][0-9]*$", "minimum": 1 },
        "threads": { "type": ["string", "integer"], "pattern": "^$|^[1-9][0-9]*$", "minimum": 1, "maximum": 1024 },
        "maxBytes": { "type": ["string", "integer"], "pattern": "^$|^[1-9][0-9]*$", "minimum": 1 },
        "maxPixels": { "type": ["string", "integer"], "pattern": "^$|^[1-9][0-9]*$", "minimum": 1 },
        "processingTimeoutMs": { "type": ["string", "integer"], "pattern": "^$|^[1-9][0-9]*$", "minimum": 1 },
        "languages": { "type": "string", "pattern": "^$|^[a-z_]+(,[a-z_]+)*$" },
        "extraEnv": { "type": "array" },
        "tmpSizeLimit": { "type": "string" }
      },
      "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
      "then": { "required": ["existingSecret"], "properties": { "existingSecret": { "minLength": 1 } } }
    }
  }
}
