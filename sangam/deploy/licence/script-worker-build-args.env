# SPDX-License-Identifier: Apache-2.0
# Pinned build arguments of deploy/docker/script-worker.Dockerfile (decisions 128 and 157, RM-32). release.yml passes
# each one as --build-arg and records this file next to the image SBOM, together with /licenses/OS-PACKAGES.txt (the
# exact Ubuntu package versions the snapshot resolved, decision 118). An empty value BLOCKS the release (never a
# guess): fill them from the upstream repositories and the Ubuntu snapshot archive, as a reviewed change with a
# download line.
#   NSJAIL_COMMIT    40-hex commit of github.com/google/nsjail that the image builds
#   KAFEL_COMMIT     40-hex commit of github.com/google/kafel (nsjail's seccomp language)
#   UBUNTU_SNAPSHOT  snapshot.ubuntu.com id YYYYMMDDTHHMMSSZ; every apt call of the build resolves against it, so a
#                    rebuild gets the same python3, libprotobuf and libnl (LGPL-2.1, source offer) versions
NSJAIL_COMMIT=
KAFEL_COMMIT=
UBUNTU_SNAPSHOT=
