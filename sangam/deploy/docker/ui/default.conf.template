# Rendered at container start by the nginx image (envsubst, variables filtered by NGINX_ENVSUBST_FILTER=^SANGAM_).
# nginx-unprivileged: listens on 8080, pid and temp paths in /tmp (works with a read-only root file system when
# /tmp, /var/cache/nginx and /etc/nginx/conf.d are writable emptyDirs).

server_tokens off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen       8080;
    listen       [::]:8080;
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    client_max_body_size 50m;   # attachments go through the API (X.2.5 attachment rules)
    gzip on;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;

    include /etc/nginx/conf.d/security-headers.inc;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Runtime configuration for the single-page app (no secrets: public OIDC client, PKCE).
    location = /config.json {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/conf.d/security-headers.inc;
        return 200 '{"apiBase":"${SANGAM_PUBLIC_API_BASE}","oidc":{"issuer":"${SANGAM_OIDC_ISSUER}","clientId":"${SANGAM_OIDC_CLIENT_ID}"},"defaultLocale":"${SANGAM_DEFAULT_LOCALE}","locales":"${SANGAM_LOCALES}","environment":"${SANGAM_ENV_LABEL}"}';
    }

    # Sangam API, worker API and the (unchanged, Sangam-authenticated) Operaton REST API.
    location ~ ^/(api|engine-rest)/ {
        proxy_pass              ${SANGAM_API_UPSTREAM};
        proxy_http_version      1.1;
        proxy_set_header        Host              $host;
        proxy_set_header        X-Real-IP         $remote_addr;
        proxy_set_header        X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header        X-Forwarded-Proto $scheme;
        proxy_set_header        Upgrade           $http_upgrade;
        proxy_set_header        Connection        $connection_upgrade;
        # long-poll fetch-and-lock (asyncResponseTimeoutMs) and SSE
        proxy_read_timeout      120s;
        proxy_buffering         off;
    }

    # Hashed build assets: cache for a year.
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/conf.d/security-headers.inc;
    }

    # SPA fallback.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/conf.d/security-headers.inc;
    }
}
