# SPDX-License-Identifier: Apache-2.0
# Rendered at container start by the nginx image (envsubst, variables filtered by NGINX_ENVSUBST_FILTER=^SANGAM_).
# nginx-unprivileged: listens on 8080, pid and temp paths in /tmp (works with a read-only root file system when
# /tmp, /var/cache/nginx and /etc/nginx/conf.d are writable emptyDirs).

server_tokens off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen       8080;
    listen       [::]:8080;
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    client_max_body_size 50m;   # attachments go through the API (X.2.5 attachment rules)
    gzip on;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;

    include /etc/nginx/conf.d/security-headers.inc;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Runtime configuration for the single-page app (no secrets: public OIDC client, PKCE).
    location = /config.json {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/conf.d/security-headers.inc;
        return 200 '{"apiBase":"${SANGAM_PUBLIC_API_BASE}","oidc":{"issuer":"${SANGAM_OIDC_ISSUER}","clientId":"${SANGAM_OIDC_CLIENT_ID}"},"defaultLocale":"${SANGAM_DEFAULT_LOCALE}","locales":"${SANGAM_LOCALES}","environment":"${SANGAM_ENV_LABEL}","traceUrlTemplate":"${SANGAM_TRACE_URL_TEMPLATE}","teams":{"enabled":${SANGAM_TEAMS_ENABLED_JSON}},"dsc":{"agentUrl":"${SANGAM_DSC_AGENT_ORIGIN_CHECKED}"},"session":{"idleMinutes":${SANGAM_UI_IDLE_MINUTES_CHECKED}}}';
    }
    # teams.enabled (decision 162): true or false from SANGAM_TEAMS_ENABLED, validated by 16-sangam-teams.envsh.
    # dsc.agentUrl (decision 165): the DSC loopback agent origin from SANGAM_DSC_AGENT_ORIGIN, validated by
    # 17-sangam-dsc.envsh; empty = DSC not set up. The same value is in connect-src.
    # session.idleMinutes (decision 349): the UI idle period from SANGAM_UI_IDLE_MINUTES, validated by
    # 18-sangam-session.envsh (1-480 minutes, default 15; a bad value stops the container).

    # Teams tab page (decisions 162, 213): its own headers only when SANGAM_TEAMS_ENABLED=true (teams-headers.inc,
    # framed by the SANGAM_TEAMS_FRAME_ANCESTORS hosts); otherwise the same headers as every other page, so it cannot
    # be framed anywhere. The include name comes from 16-sangam-teams.envsh; without it nginx does not start.
    location = /teams.html {
        try_files $uri =404;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/conf.d/${SANGAM_TEAMS_HEADERS_INC};
    }
    # traceUrlTemplate (M-044, owner decision 57): a link to the operator's trace viewer with the placeholder
    # {traceId}, e.g. https://tracing.example/trace/{traceId}; empty = no trace links. The UI links only http(s).

    # Sangam API, worker API and the (unchanged, Sangam-authenticated) Operaton REST API.
    location ~ ^/(api|engine-rest)/ {
        proxy_pass              ${SANGAM_API_UPSTREAM};
        proxy_http_version      1.1;
        # $http_host, not $host: the browser's Host with its port. $host drops the port, so the server saw
        # http://<host> (port 80) while a write from the UI carried Origin http://<host>:<port>; with CORS origins
        # configured, Spring took the UI's own requests for cross-origin ones and refused them (403 "Invalid CORS
        # request", ui.yml e2e run 44135232064). The UI and the API are one origin, so the server must see it.
        proxy_set_header        Host              $http_host;
        proxy_set_header        X-Real-IP         $remote_addr;
        proxy_set_header        X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header        X-Forwarded-Proto $scheme;
        proxy_set_header        Upgrade           $http_upgrade;
        proxy_set_header        Connection        $connection_upgrade;
        # long-poll fetch-and-lock (asyncResponseTimeoutMs) and SSE
        proxy_read_timeout      120s;
        proxy_buffering         off;
    }

    # Hashed build assets: cache for a year.
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/conf.d/security-headers.inc;
    }

    # The approved Noto fonts and their OFL texts (owner decisions 120, 121; scripts/deploy-fonts.mjs). The stock
    # nginx mime.types has no ttf entry, so they went out as application/octet-stream. A types block replaces the
    # inherited map for its location, so it names every file type served here; a missing file is a 404, never the
    # single-page index.html.
    location ^~ /fonts/ {
        types {
            font/ttf    ttf;
            text/plain  txt;
        }
        default_type application/octet-stream;
        try_files $uri =404;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/conf.d/security-headers.inc;
    }

    # SPA fallback.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/conf.d/security-headers.inc;
    }
}
