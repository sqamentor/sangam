# Rendered by envsubst into /etc/nginx/conf.d/security-headers.inc (not *.conf, so not auto-included).
# Included in every location that sets its own add_header (nginx does not inherit add_header then).
add_header X-Content-Type-Options    "nosniff" always;
add_header X-Frame-Options           "DENY" always;
add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
add_header Permissions-Policy        "camera=(), microphone=(), geolocation=(), payment=()" always;
add_header Cross-Origin-Opener-Policy "same-origin" always;
# 'unsafe-inline' for styles only: bpmn-js / dmn-js inject inline styles. connect-src must reach the OIDC issuer.
# connect-src also names the DSC loopback agent when SANGAM_DSC_AGENT_ORIGIN is set (decision 165, 17-sangam-dsc.envsh).
add_header Content-Security-Policy   "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ${SANGAM_OIDC_ISSUER} ${SANGAM_CSP_CONNECT_EXTRA} ${SANGAM_DSC_AGENT_ORIGIN_CHECKED}; frame-src 'self' ${SANGAM_OIDC_ISSUER}; frame-ancestors 'none'; base-uri 'self'; form-action 'self' ${SANGAM_OIDC_ISSUER}; object-src 'none'" always;
# Decision 349 (matrix W-02): Trusted Types in report-only mode first. A second, report-only policy, so the enforced
# policy above is unchanged: the browser reports each DOM XSS sink fed a plain string (bpmn-js and dmn-js write
# innerHTML) and blocks nothing. No report endpoint exists yet, so reports go to the browser console and to
# securitypolicyviolation events only (e2e/security-headers.e2e.ts collects them).
add_header Content-Security-Policy-Report-Only "require-trusted-types-for 'script'" always;
