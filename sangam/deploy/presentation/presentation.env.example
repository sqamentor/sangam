# SPDX-License-Identifier: Apache-2.0
# R8-present: environment for Sangam under <public host>/sangam/. Copy to presentation.local.env (git-ignored) and
# fill in. No secret belongs in this example; every value marked <...> comes from the operator.

# ---------------------------------------------------------------- front container (deploy/presentation/Dockerfile)
SANGAM_API_UPSTREAM=http://sangam-server:8080
SANGAM_PUBLIC_API_BASE=/sangam/api/v1
SANGAM_OIDC_ISSUER=https://<keycloak host>/realms/oneifms
SANGAM_OIDC_CLIENT_ID=sangam-ui
SANGAM_DEFAULT_LOCALE=en
SANGAM_LOCALES=en
SANGAM_ENV_LABEL=
SANGAM_UI_IDLE_MINUTES=30

# ---------------------------------------------------------------- server container (deploy/docker/server.Dockerfile)
SPRING_PROFILES_ACTIVE=oracle,oidc
SANGAM_DB_URL=jdbc:oracle:thin:@//<oracle host>:1521/<service>
SANGAM_DB_USER=<schema user>
SANGAM_DB_PASSWORD=<from the secret store>
# first start on an empty schema: migrate-only once, then validate
SANGAM_LIQUIBASE_MODE=validate
SANGAM_OIDC_ISSUER=https://<keycloak host>/realms/oneifms
SANGAM_SECURITY_OIDC_AUDIENCE=sangam-server
SANGAM_SECURITY_OIDC_TENANT_CLAIM=tenant
SANGAM_SECURITY_OIDC_ROLES_CLAIM=roles
SANGAM_SECURITY_OIDC_SEATS_CLAIM=seats
# a realm separate from the tenant issuer (refused at start otherwise, SL-70); empty = no platform administrator
SANGAM_SECURITY_PLATFORM_ISSUER=https://<keycloak host>/realms/sangam-platform
# persons are created at first sign-in (person id = preferred_username)
SANGAM_SECURITY_JITPROVISIONINGTENANTS=GOI.FIN
SANGAM_CORS_ORIGINS=
SANGAM_PORT=8080
SANGAM_MANAGEMENT_PORT=8081

# ---------------------------------------------------------------- one-time seed (deploy/presentation/seed_presentation.py)
SANGAM_PRESENTATION_TENANT=GOI.FIN
KEYCLOAK_URL=https://<keycloak host>
KEYCLOAK_REALM=oneifms
KEYCLOAK_PLATFORM_REALM=sangam-platform
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_USER=<admin user>
KEYCLOAK_ADMIN_PASSWORD=<from the secret store>
SANGAM_API_BASE=https://<public host>/sangam/api/v1
SANGAM_ADMIN_TOKEN=<tenant administrator bearer token>
SANGAM_PRESENTATION_PASSWORD_DDO_MAKER=
SANGAM_PRESENTATION_PASSWORD_HOO_OFFICE=
SANGAM_PRESENTATION_PASSWORD_PAO_ACCOUNTS=
SANGAM_PRESENTATION_PASSWORD_BILL_DISTRIBUTOR=
SANGAM_PRESENTATION_PASSWORD_DEALING_HAND=
SANGAM_PRESENTATION_PASSWORD_AAO_ACCOUNTS=
SANGAM_PRESENTATION_PASSWORD_SECOND_SIGNATORY=
SANGAM_PRESENTATION_PASSWORD_GPF_SUBSCRIBER=
SANGAM_PRESENTATION_PASSWORD_ORG_ADMIN=
SANGAM_PRESENTATION_PASSWORD_SECTION_SUPERVISOR=
SANGAM_PRESENTATION_PASSWORD_PLATFORM_ADMIN=
