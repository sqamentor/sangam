# SPDX-License-Identifier: Apache-2.0
# R8-present: the Sangam UI and API under one path prefix (default /sangam/), for a host that forwards
# <public host>/sangam/* to this container with the path unchanged (IFMS answer "How demo.ifms.dev is served").
# Rendered at start by the nginx image (envsubst, NGINX_ENVSUBST_FILTER=^SANGAM_). Same headers, /config.json fields
# and proxy settings as deploy/docker/ui/default.conf.template, moved under the prefix. The UI is built with
# SANGAM_UI_BASE=/sangam/ so its hashed assets are /sangam/assets/...

server_tokens off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen       8080;
    listen       [::]:8080;
    server_name  _;
    root         /usr/share/nginx/html;
    # EV-M-0969: every redirect names a path only (Location /sangam/), never this container's own scheme, host and
    # port. With nginx's defaults (absolute_redirect and port_in_redirect both enabled) GET demo.ifms.dev/sangam answered
    # http://demo.ifms.dev:8080/sangam/, the port the host's proxy forwards to. This covers the return 301 below and
    # nginx's own directory redirects (try_files $uri/). UiNginxConfTest; ui.yml e2e checks it on the running front.
    absolute_redirect off;
    client_max_body_size 50m;
    gzip on;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;

    include /etc/nginx/conf.d/security-headers.inc;

    # The container's own probe (not public).
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
    location = /sangam { return 301 /sangam/; }

    # Public health: the server's readiness group (Spring Boot probes on the app port, add-additional-paths).
    location = /sangam/health {
        access_log off;
        proxy_pass ${SANGAM_API_UPSTREAM}/readyz;
    }

    location = /sangam/config.json {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/conf.d/security-headers.inc;
        return 200 '{"apiBase":"${SANGAM_PUBLIC_API_BASE}","oidc":{"issuer":"${SANGAM_OIDC_ISSUER}","clientId":"${SANGAM_OIDC_CLIENT_ID}"},"defaultLocale":"${SANGAM_DEFAULT_LOCALE}","locales":"${SANGAM_LOCALES}","environment":"${SANGAM_ENV_LABEL}","traceUrlTemplate":"","teams":{"enabled":false},"dsc":{"agentUrl":""},"session":{"idleMinutes":${SANGAM_UI_IDLE_MINUTES_CHECKED}},"fonts":{"manifest":"${SANGAM_FONTS_MANIFEST}"}}';
    }

    # API and the Sangam-authenticated Operaton REST: /sangam/api/... -> <upstream>/api/... (prefix removed).
    location ~ ^/sangam/(api|engine-rest)/ {
        rewrite ^/sangam/(.*)$ /$1 break;
        proxy_pass              ${SANGAM_API_UPSTREAM};
        proxy_http_version      1.1;
        # $http_host, not $host: the browser's Host with its port. $host drops the port, so the server saw
        # http://<host> (port 80) while a write from the UI carried Origin http://<host>:<port>; with CORS origins
        # configured, Spring took the UI's own requests for cross-origin ones and refused them (403 "Invalid CORS
        # request", ui.yml e2e run 44135232064). The UI and the API are one origin, so the server must see it.
        proxy_set_header        Host              $http_host;
        proxy_set_header        X-Real-IP         $remote_addr;
        proxy_set_header        X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header        X-Forwarded-Proto $scheme;
        proxy_set_header        X-Forwarded-Prefix /sangam;
        proxy_set_header        Upgrade           $http_upgrade;
        proxy_set_header        Connection        $connection_upgrade;
        proxy_read_timeout      120s;
        proxy_buffering         off;
    }

    location /sangam/assets/ {
        alias /usr/share/nginx/html/assets/;
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/conf.d/security-headers.inc;
    }

    # The approved Noto fonts and their OFL texts (owner decisions 120, 121), as in docker/ui/default.conf.template:
    # the stock mime.types has no ttf entry, and a types block replaces the inherited map for its location.
    location ^~ /sangam/fonts/ {
        alias /usr/share/nginx/html/fonts/;
        types {
            font/ttf    ttf;
            text/plain  txt;
        }
        default_type application/octet-stream;
        try_files $uri =404;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/conf.d/security-headers.inc;
    }

    # Every other file of the build (icons), then the single-page fallback.
    location /sangam/ {
        alias /usr/share/nginx/html/;
        try_files $uri $uri/ /sangam/index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/conf.d/security-headers.inc;
    }
    location = /sangam/index.html {
        alias /usr/share/nginx/html/index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/conf.d/security-headers.inc;
    }
}
