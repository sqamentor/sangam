# SPDX-License-Identifier: Apache-2.0
# Copy to .env (git-ignored). Every default in docker-compose.yml is a DEVELOPMENT-ONLY value.
SANGAM_REGISTRY=sangam
SANGAM_VERSION=dev
SANGAM_HTTP_PORT=8080
SANGAM_MGMT_PORT=8081
SANGAM_UI_PORT=3000
SANGAM_LIQUIBASE_MODE=startup
SANGAM_TENANT_DEFAULT=dept-finance
SANGAM_SIMULATORS_ENABLED=false
SANGAM_ENV_LABEL=dev
# Decisions 143 and 198: the production switch, always explicit. true (the default of docker-compose.yml) turns every
# production guard on: endpoints must be https and not loopback, dev tokens are refused, a dev profile is ignored with a
# warning. The localhost Keycloak URLs below are refused under true, so for local development on this machine set
# false: without a dev profile the server then runs NON_PRODUCTION (guards off, dev defaults such as dev tokens still
# refused). Dev defaults need false plus the dev profile (docker-compose.cells.yml). Never false on a real deployment.
SANGAM_SECURITY_PRODUCTION=true

# Decision 144: audit scope of shared and system-owned engine work (sangam.engine.system-audit-scope). Required:
# system:<name>, name matching [a-z0-9][a-z0-9._-]{0,47}; anything else, or empty, and the server refuses to start.
# It can never be a customer tenant (tenant ids have no ':').
SANGAM_ENGINE_SYSTEM_AUDIT_SCOPE=system:platform

# Decision 247: knowledge-base ranking index. portable (default, every database), pgvector (PostgreSQL with the
# pgvector column) or oracle (Oracle AI Database 23ai or later only: at start the server refuses an older Oracle, then
# applies the separate changelog db/changelog/sangam-oracle-vector.xml, context oracle-vector). Anything else stops the
# start. Operators who run Liquibase themselves: deploy/README.md section 2.
SANGAM_AI_KB_VECTOR_INDEX=portable

# Decision 259: eSign/DSC add-on only. An OCSP answer whose thisUpdate is older than this is INDETERMINATE (the signing
# step refuses), even with a matching nonce; the clock-skew allowance stays. Positive duration: 24h, 90m, PT24H, P1D.
SANGAM_DSC_OCSP_MAX_AGE=24h

# Decision 290: automatic re-dispatches of a pack operation that has no process instance (a REST-backed record create)
# before reconciliation hands it to a person. A positive integer; 0, a negative number, blank or text refuses the start.
SANGAM_INTEGRATION_RECONCILIATION_MAX_REDISPATCHES=3

# Decisions 304, 305: India DLT SMS (deploy/README.md section 1.8). Tolerance of a delivery report's signature
# timestamp; the status-lookup fallback and the time between its passes; how often a node loads the registrations
# other nodes changed. Positive durations (5m, 90s, PT5M); zero or a negative duration refuses the start.
SANGAM_DLT_DELIVERY_REPORT_TOLERANCE=5m
SANGAM_DLT_DELIVERY_STATUS_ENABLED=true
SANGAM_DLT_DELIVERY_STATUS_INTERVAL=5m
SANGAM_DLT_REGISTRATION_REFRESH_INTERVAL=1m

# Decision 213: Microsoft Teams personal tab (/teams.html). false keeps it unframeable like every page. Frame
# ancestors: space-separated https origins (https://host[:port] or https://*.host); empty = the UI image's built-in
# Microsoft list. Register https://<ui host>/teams.html as a redirect URI of the sangam-ui client when enabled.
SANGAM_TEAMS_ENABLED=false
SANGAM_TEAMS_FRAME_ANCESTORS=
# Decision 165: origin of the DSC signing agent on the signer's own computer, served to the UI as dsc.agentUrl and
# allowed in its connect-src. Empty = DSC not set up. Only http://127.0.0.1:<port> or http://localhost:<port>, lower
# case, no path or trailing slash; [::1] is refused (the agent is IPv4 loopback only).
SANGAM_DSC_AGENT_ORIGIN=
# Decisions 349 and 359: the UI idle period in whole minutes, 1-480 (default 15). After it the UI warns, then ends the
# session; every page has it (the Teams tab too) except the queue hall display. The image refuses any other value.
SANGAM_UI_IDLE_MINUTES=15
# Decision 369 (e): the compliance principal key (HMAC of data-principal tokens and one-time-code identifier hashes).
# Generate the value with: openssl rand -base64 32. Decision 371 (5): required with SANGAM_SECURITY_PRODUCTION=true
# (the server refuses to start without it); with false, unset, consents and one-time codes are refused with
# PRINCIPAL_KEY_NOT_CONFIGURED. One key per environment; never reuse a production key.
SANGAM_COMPLIANCE_PRINCIPAL_KEY_REF=
SANGAM_SECRET_COMPLIANCE_PRINCIPAL_KEY=
# Owner decision 385 (3): one key per environment. The name of this environment ([a-z0-9][a-z0-9._-]{0,47}) and the
# path in the container of the list of the other environments' key fingerprints ("<environment> <sha256 hex>
# [<setting>]" per line; put the file in ./config/server and name /opt/sangam/config/<file>). Required with
# SANGAM_SECURITY_PRODUCTION=true. SANGAM_KEYS_FINGERPRINT_EXPORT: where the server writes this environment's own list.
SANGAM_KEYS_ENVIRONMENT=
SANGAM_KEYS_FOREIGN_FINGERPRINTS=
SANGAM_KEYS_FINGERPRINT_EXPORT=

# identity
KEYCLOAK_PORT=8180
KEYCLOAK_HOSTNAME=http://localhost:8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Decision 113: keycloak-broker-otp one-shot. With -f docker-compose.keycloak-secret.yml the admin password comes from
# this host file (a compose secret) instead of KEYCLOAK_ADMIN_PASSWORD.
# KEYCLOAK_ADMIN_PASSWORD_SECRET=/secure/path/keycloak-admin-password
KEYCLOAK_BROKER_ALIASES=gov-sso-saml
KEYCLOAK_AMR_CLIENTS=sangam-ui
SANGAM_OIDC_ISSUER_PUBLIC=http://localhost:8180/realms/sangam
SANGAM_OIDC_ISSUER_INTERNAL=http://keycloak:8180/realms/sangam

# databases (only the active profile's values matter)
PG_PASSWORD=change-me
ORACLE_SYSTEM_PASSWORD=Change_me_1
ORACLE_PASSWORD=Change_me_1
MSSQL_SA_PASSWORD=Change_me_1!
MSSQL_PASSWORD=Change_me_1!
# Decision 122: the sqlserver profile starts only after YOU accept the Microsoft SQL Server container EULA. Read it,
# then set this to Y yourself. Left unset, the compose file passes ACCEPT_EULA=N and SQL Server refuses to start.
# SANGAM_ACCEPT_MSSQL_EULA=Y
# Decision 180: the oracle profile starts only after YOU accept the Oracle Database Free container image terms. Read
# them, then set this to Y yourself. Left unset, the one-shot oracle-terms exits 1 and nothing Oracle starts.
# SANGAM_ACCEPT_ORACLE_FREE_TERMS=Y
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# telemetry: collector-base.yaml (drop everything, R56) or collector-observability.yaml (with --profile observability)
OTEL_COLLECTOR_CONFIG=collector-base.yaml
OTEL_SDK_DISABLED=false
GRAFANA_ADMIN_PASSWORD=change-me
# engine spans (SL-168, M-062): off by default
SANGAM_TRACING_ENGINE_ENABLED=false

# leaf pools (SL-168, X1-05), each on top of the main pool per server node (deploy/README.md section 1.6)
SANGAM_QUOTA_POOL_SIZE=4
SANGAM_SECURITY_DENIAL_AUDIT_POOL_SIZE=2
SANGAM_COMPLIANCE_DENIAL_AUDIT_POOL_SIZE=2
SANGAM_CONFIG_STORE_POOL_SIZE=4

# upload malware scanning (M-082): none, or clamd with --profile malware (ClamAV service), or icap
SANGAM_MALWARE_SCANNER=none
SANGAM_MALWARE_FAIL_CLOSED=true
SANGAM_MALWARE_CLAMD_HOST=clamav
SANGAM_MALWARE_CLAMD_PORT=3310

# UI trace links (M-044): template with {traceId}; empty = no links (Jaeger example: http://localhost:16686/trace/{traceId})
SANGAM_TRACE_URL_TEMPLATE=

# script worker (M-061, --profile script-worker): the pinned build args of deploy/licence/script-worker-build-args.env
# (decisions 128 and 157: nsjail and kafel commits, Ubuntu snapshot id YYYYMMDDTHHMMSSZ), worker token (dev only), languages
NSJAIL_COMMIT=
KAFEL_COMMIT=
UBUNTU_SNAPSHOT=
SANGAM_SCRIPT_WORKER_TOKEN=
SANGAM_SCRIPT_LANGUAGES=javascript,python

# PDF validator and OCR sidecars (M-081, M-103; --profile pdf / --profile ocr with -f docker-compose.sidecars.yml).
# Demo tokens, key stores and the server trust store are made at start by sidecar-secrets-init into named volumes
# (never in this file). The OCR image needs UBUNTU_SNAPSHOT above (deploy/licence/ocr-build-args.env). With only one of
# the two profiles, set the other URL empty here (empty = that feature off, fail closed).
# SANGAM_PDF_VALIDATOR_URL=
# SANGAM_OCR_URL=
SANGAM_PDF_VALIDATOR_MAX_BYTES=67108864
SANGAM_OCR_LANGUAGES=eng,hin
SANGAM_SIDECAR_CERT_DAYS=397

# Backup console, script mode (decision 220; only with -f docker-compose.backup-console.yml). Off by default. Targets go in
# config/server/application.yaml (deploy/README.md section 1.3); the stock server image has no database client tools.
# ENV_PASSTHROUGH: comma-separated extra variable names the scripts receive (empty = none). SCRIPTS_DIR is mounted read-only.
SANGAM_BACKUP_CONSOLE_SCRIPT_ENABLED=false
SANGAM_BACKUP_CONSOLE_SCRIPT_ENV_PASSTHROUGH=
# SANGAM_BACKUP_SCRIPTS_DIR=./backup-scripts

# Compliance jurisdiction: required, the server assumes none (India example)
SANGAM_COMPLIANCE_JURISDICTIONS=IN
SANGAM_COMPLIANCE_LOG_ARCHIVE_COUNTRY=IN
