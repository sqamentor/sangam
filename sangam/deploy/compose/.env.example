# SPDX-License-Identifier: Apache-2.0
# Copy to .env (git-ignored). Every default in docker-compose.yml is a DEVELOPMENT-ONLY value.
SANGAM_REGISTRY=sangam
SANGAM_VERSION=dev
SANGAM_HTTP_PORT=8080
SANGAM_MGMT_PORT=8081
SANGAM_UI_PORT=3000
SANGAM_LIQUIBASE_MODE=startup
SANGAM_TENANT_DEFAULT=dept-finance
SANGAM_SIMULATORS_ENABLED=false
SANGAM_ENV_LABEL=dev

# identity
KEYCLOAK_PORT=8180
KEYCLOAK_HOSTNAME=http://localhost:8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Decision 113: keycloak-broker-otp one-shot. With -f docker-compose.keycloak-secret.yml the admin password comes from
# this host file (a compose secret) instead of KEYCLOAK_ADMIN_PASSWORD.
# KEYCLOAK_ADMIN_PASSWORD_SECRET=/secure/path/keycloak-admin-password
KEYCLOAK_BROKER_ALIASES=gov-sso-saml
KEYCLOAK_AMR_CLIENTS=sangam-ui
SANGAM_OIDC_ISSUER_PUBLIC=http://localhost:8180/realms/sangam
SANGAM_OIDC_ISSUER_INTERNAL=http://keycloak:8180/realms/sangam

# databases (only the active profile's values matter)
PG_PASSWORD=change-me
ORACLE_SYSTEM_PASSWORD=Change_me_1
ORACLE_PASSWORD=Change_me_1
MSSQL_SA_PASSWORD=Change_me_1!
MSSQL_PASSWORD=Change_me_1!
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# telemetry: collector-base.yaml (drop everything, R56) or collector-observability.yaml (with --profile observability)
OTEL_COLLECTOR_CONFIG=collector-base.yaml
OTEL_SDK_DISABLED=false
GRAFANA_ADMIN_PASSWORD=change-me
# engine spans (SL-168, M-062): off by default
SANGAM_TRACING_ENGINE_ENABLED=false

# leaf pools (SL-168, X1-05), each on top of the main pool per server node (deploy/README.md section 1.6)
SANGAM_QUOTA_POOL_SIZE=4
SANGAM_SECURITY_DENIAL_AUDIT_POOL_SIZE=2
SANGAM_COMPLIANCE_DENIAL_AUDIT_POOL_SIZE=2

# upload malware scanning (M-082): none, or clamd with --profile malware (ClamAV service), or icap
SANGAM_MALWARE_SCANNER=none
SANGAM_MALWARE_FAIL_CLOSED=true
SANGAM_MALWARE_CLAMD_HOST=clamav
SANGAM_MALWARE_CLAMD_PORT=3310

# UI trace links (M-044): template with {traceId}; empty = no links (Jaeger example: http://localhost:16686/trace/{traceId})
SANGAM_TRACE_URL_TEMPLATE=

# script worker (M-061, --profile script-worker): approved nsjail 3.4 commit, worker token (dev only), languages
NSJAIL_COMMIT=
SANGAM_SCRIPT_WORKER_TOKEN=
SANGAM_SCRIPT_LANGUAGES=javascript,python

# Compliance jurisdiction: required, the server assumes none (India example)
SANGAM_COMPLIANCE_JURISDICTIONS=IN
SANGAM_COMPLIANCE_LOG_ARCHIVE_COUNTRY=IN
