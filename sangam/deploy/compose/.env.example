# SPDX-License-Identifier: Apache-2.0
# Copy to .env (git-ignored). Every default in docker-compose.yml is a DEVELOPMENT-ONLY value.
SANGAM_REGISTRY=sangam
SANGAM_VERSION=dev
SANGAM_HTTP_PORT=8080
SANGAM_MGMT_PORT=8081
SANGAM_UI_PORT=3000
SANGAM_LIQUIBASE_MODE=startup
SANGAM_TENANT_DEFAULT=dept-finance
SANGAM_SIMULATORS_ENABLED=false
SANGAM_ENV_LABEL=dev

# identity
KEYCLOAK_PORT=8180
KEYCLOAK_HOSTNAME=http://localhost:8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
SANGAM_OIDC_ISSUER_PUBLIC=http://localhost:8180/realms/sangam
SANGAM_OIDC_ISSUER_INTERNAL=http://keycloak:8180/realms/sangam

# databases (only the active profile's values matter)
PG_PASSWORD=change-me
ORACLE_SYSTEM_PASSWORD=Change_me_1
ORACLE_PASSWORD=Change_me_1
MSSQL_SA_PASSWORD=Change_me_1!
MSSQL_PASSWORD=Change_me_1!
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# telemetry: collector-base.yaml (drop everything, R56) or collector-observability.yaml (with --profile observability)
OTEL_COLLECTOR_CONFIG=collector-base.yaml
OTEL_SDK_DISABLED=false
GRAFANA_ADMIN_PASSWORD=change-me
