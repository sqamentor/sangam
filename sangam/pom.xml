        <version>${version.cucumber}</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>io.cucumber</groupId>
        <artifactId>cucumber-junit-platform-engine</artifactId>
        <version>${version.cucumber}</version>
        <scope>test</scope>
      </dependency>
      <!-- Cucumber 8.0.4 asks for these two as version ranges (messages [32.0.0,35.0.0), query [15.0.0,17.0.0)). A range
           is resolved from repository metadata, so the result depends on the day of the build and an offline build
           fails. Pinned to the versions of the approved batch-1 download, inside both ranges. -->
      <dependency>
        <groupId>io.cucumber</groupId>
        <artifactId>messages</artifactId>
        <version>34.2.1</version>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>io.cucumber</groupId>
        <artifactId>query</artifactId>
        <version>16.1.1</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <directory>${project.basedir}/${sangam.target}</directory>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
          <configuration>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.1</version>
          <configuration>
            <!-- quoted: the project path contains spaces. SL-53: every test JVM runs in UTC, as the engine requires
                 (EngineTimeZone refuses any other default zone); a timer test sets sangam.engine.timer-zone instead -->
            <argLine>@{argLine} "-Djdk.net.unixdomain.tmpdir=${project.build.directory}" -Duser.timezone=UTC</argLine>
            <systemPropertyVariables>
              <!-- Testcontainers with Docker 29 -->
              <api.version>1.44</api.version>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>3.6.1</version>
          <configuration>
            <!-- same as surefire: the JDK's Windows selector pipe (AF_UNIX) fails in some user temp folders; UTC (SL-53);
                 @{argLine} carries the JaCoCo agent of -Psangam-coverage into the integration tests too (X1-10) -->
            <argLine>@{argLine} "-Djdk.net.unixdomain.tmpdir=${project.build.directory}" -Duser.timezone=UTC</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.1</version>
        </plugin>
        <!-- M-094 / M-095 build-time tools: pinned here, bound only in the report-only profiles below -->
        <plugin>
          <groupId>com.github.spotbugs</groupId>
          <artifactId>spotbugs-maven-plugin</artifactId>
          <version>${version.spotbugs-maven-plugin}</version>
          <dependencies>
            <dependency>
              <groupId>com.github.spotbugs</groupId>
              <artifactId>spotbugs</artifactId>
              <version>${version.spotbugs}</version>
            </dependency>
          </dependencies>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${version.jacoco}</version>
        </plugin>
        <plugin>
          <groupId>org.pitest</groupId>
          <artifactId>pitest-maven</artifactId>
          <version>${version.pitest}</version>
          <dependencies>
            <dependency>
              <groupId>org.pitest</groupId>
              <artifactId>pitest-junit5-plugin</artifactId>
              <version>${version.pitest-junit5}</version>
            </dependency>
          </dependencies>
        </plugin>
        <plugin>
          <groupId>org.sonarsource.scanner.maven</groupId>
          <artifactId>sonar-maven-plugin</artifactId>
          <version>${version.sonar-maven-plugin}</version>
        </plugin>
        <!-- CR-10/CR-12: tools the workflows invoke from the command line (see the version properties) -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>${version.maven-dependency-plugin}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-help-plugin</artifactId>
          <version>${version.maven-help-plugin}</version>
        </plugin>
        <!-- RM-45: the site lifecycle plugin, pinned to the version the Maven 3.9.9 super POM binds (maven-core
             components.xml), so no run picks one by itself -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-site-plugin</artifactId>
          <version>${version.maven-site-plugin}</version>
        </plugin>
        <plugin>
          <groupId>org.cyclonedx</groupId>
          <artifactId>cyclonedx-maven-plugin</artifactId>
          <version>${version.cyclonedx-maven-plugin}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>versions-maven-plugin</artifactId>
          <version>${version.versions-maven-plugin}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- SL-106: reactor-wide bans, checked at validate in every module (deploy/licence/licence-policy.json is the
           source; check_licences.py checks the SBOM by licence as well). Pattern = groupId:artifactId:version:type:scope;
           a version in [] is exact (a bare version would match any version). Driver bans cover the shipped scopes
           only: the CI-only driver profiles (LIC-2/LIC-3) and Testcontainers use test scope. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <!-- UP-L4: stays 3.6.1. 3.7.0 also checks OPTIONAL dependencies in bannedDependencies, which breaks the
             decision 217/232 add-on design below (jnats optional in sangam-flowable-ports fails the build); moving
             needs a reworded rule that keeps the same control, an integrator/owner item. -->
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>sangam-banned-dependencies</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <!-- LIC-1 / D-8: GraalJS (GFTC), polyglot and Truffle are stripped from every build -->
                    <exclude>org.graalvm.js:*</exclude>
                    <exclude>org.graalvm.polyglot:*</exclude>
                    <exclude>org.graalvm.truffle:*</exclude>
                    <!-- LIC-10 / D-8: other script engines stay out of the default build -->
                    <exclude>org.mozilla:rhino</exclude>
                    <exclude>org.openjdk.nashorn:*</exclude>
                    <exclude>org.python:jython*</exclude>
                    <exclude>org.jruby:*</exclude>
                    <!-- LIC-7 / D-7: Liquibase stays below 5 (4.33.0) until the legal review -->
                    <exclude>org.liquibase:liquibase-core:[5,)</exclude>
                    <!-- ADR-D-5: REST/OpenAPI first; gRPC only after a measured need and a decision -->
                    <exclude>io.grpc:*</exclude>
                    <!-- LIC-2 / LIC-3 / LIC-4: customer-supplied or never-shipped drivers (shipped scopes) -->
                    <exclude>com.oracle.database.*:*:*:*:compile</exclude>
                    <exclude>com.oracle.database.*:*:*:*:runtime</exclude>
                    <exclude>com.ibm.db2*:*:*:*:compile</exclude>
                    <exclude>com.ibm.db2*:*:*:*:runtime</exclude>
                    <exclude>com.mysql:mysql-connector-j:*:*:compile</exclude>
                    <exclude>com.mysql:mysql-connector-j:*:*:runtime</exclude>
                    <exclude>mysql:mysql-connector-java:*:*:compile</exclude>
                    <exclude>mysql:mysql-connector-java:*:*:runtime</exclude>
                    <!-- SG-27: consumer namespace ban on org.camunda* (shipped scopes), one exact exception below -->
                    <exclude>org.camunda*:*:*:*:compile</exclude>
                    <exclude>org.camunda*:*:*:*:runtime</exclude>
                    <!-- Decisions 217, 232, 235, 243 (licence-policy.json forbidden_components with allowed_in):
                         Bouncy Castle (jdk18on of the esign add-on, bcprov-lts8on of jnats) and the NATS client
                         ship only in their opt-in add-ons, never in the server or another distribution (shipped
                         scopes). The rule does not look at OPTIONAL dependencies, which Maven never passes on:
                         that is how sangam-flowable-ports and sangam-integration compile against jnats and
                         sangam-connectors-health against bcprov-jdk18on. Only sangam-esign, the esign add-on
                         itself, lifts the ban in its own pom (BannedDependencyExemptionsTest). -->
                    <exclude>org.bouncycastle:*:*:*:compile</exclude>
                    <exclude>org.bouncycastle:*:*:*:runtime</exclude>
                    <exclude>io.nats:jnats:*:*:compile</exclude>
                    <exclude>io.nats:jnats:*:*:runtime</exclude>
                    <!-- Owner decision 2026-11-12: LGPL build-time tools (licence-policy.json build_time_tools) never
                         enter a shipped scope. They run as Maven plugins, which bannedDependencies does not see. -->
                    <exclude>com.github.spotbugs:spotbugs:*:*:compile</exclude>
                    <exclude>com.github.spotbugs:spotbugs:*:*:runtime</exclude>
                    <exclude>com.h3xstream.findsecbugs:findsecbugs-plugin:*:*:compile</exclude>
                    <exclude>com.h3xstream.findsecbugs:findsecbugs-plugin:*:*:runtime</exclude>
                    <exclude>org.sonarsource.scanner.maven:*:*:*:compile</exclude>
                    <exclude>org.sonarsource.scanner.maven:*:*:*:runtime</exclude>
                    <!-- the LGPL artefacts those tools pull in (same decision, extended 2026-11-12) -->
                    <exclude>com.github.spotbugs:spotbugs-annotations:*:*:compile</exclude>
                    <exclude>com.github.spotbugs:spotbugs-annotations:*:*:runtime</exclude>
                    <exclude>org.sonarsource.scanner.lib:*:*:*:compile</exclude>
                    <exclude>org.sonarsource.scanner.lib:*:*:*:runtime</exclude>
                  </excludes>
                  <includes>
                    <!-- SG-27 owner exception (licence-policy.json pinned_exceptions): exactly this version -->
                    <include>org.camunda.feel:feel-engine:[${version.feel-engine}]</include>
                  </includes>
                  <message>SL-106: banned dependency (deploy/licence/licence-policy.json, SANGAM.md LIC-1..LIC-11, ADR-D-5)</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- W4-F M-143 (decision 186): opt-in Quarkus host, staged REQUEST W4F-STAGED/M-143/root-pom-profile-REQUEST.xml;
         the default modules stay unchanged (DefaultReactorHasNoOptionalHostTest) -->
    <profile>
      <id>sangam-quarkus</id>
      <!-- M-143 optional Quarkus host (owner decision 186, decision 137): build with -Psangam-quarkus. Deployment
           approval: NOT APPROVED. -->
      <modules>
        <module>sangam-quarkus-extension</module>
      </modules>
    </profile>
    <!-- Q22 (owner 2026-11-12): -Psangam-it-only runs the integration tests (failsafe) without the surefire unit tests.
         The DB-matrix legs use it because the unit tests already ran once in the build job (ci-build.yml). Test
         sources still compile; -DskipTests and -Dmaven.test.skip keep their usual meaning in every other build. -->
    <profile>
      <id>sangam-it-only</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <skipTests>true</skipTests>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- M-094 static analysis, REPORT-ONLY (owner 2026-11-12: report first, blocking after the test-phase triage).
         -Psangam-static-analysis compiles with Error Prone + NullAway (every finding a warning:
         -XepAllErrorsAsWarnings, NullAway at WARN). javac is forked so the jdk.compiler exports Error Prone needs are
         passed with -J (no .mvn/jvm.config). SpotBugs is the separate profile sangam-spotbugs below. Making any of
         them blocking is a separate owner decision. -->
    <profile>
      <id>sangam-static-analysis</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <fork>true</fork>
              <compilerArgs combine.children="append">
                <arg>-XDcompilePolicy=simple</arg>
                <arg>--should-stop=ifError=FLOW</arg>
                <arg>-Xplugin:ErrorProne -XepAllErrorsAsWarnings -XepDisableWarningsInGeneratedCode -XepExcludedPaths:.*/generated-sources/.* -Xep:NullAway:WARN -XepOpt:NullAway:AnnotatedPackages=org.sangam</arg>
                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
                <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
              </compilerArgs>
              <annotationProcessorPaths>
                <path>
                  <groupId>com.google.errorprone</groupId>
                  <artifactId>error_prone_core</artifactId>
                  <version>${version.errorprone}</version>
                </path>
                <path>
                  <groupId>com.uber.nullaway</groupId>
                  <artifactId>nullaway</artifactId>
                  <version>${version.nullaway}</version>
                </path>
              </annotationProcessorPaths>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- M-094 SpotBugs + FindSecBugs, REPORT-ONLY (failOnError=false, XML + SARIF in target*/), run with
         -Psangam-spotbugs -DskipTests verify; CI runs it in security.yml (static-analysis). Its LGPL transitive
         com.github.spotbugs:spotbugs-annotations:4.10.5 is in the owner's build-time exception (extended 2026-11-12)
         and banned from every shipped scope by the enforcer rule above. -->
    <profile>
      <id>sangam-spotbugs</id>
      <build>
        <plugins>
          <plugin>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>sangam-spotbugs-report</id>
                <phase>verify</phase>
                <goals><goal>spotbugs</goal></goals>
              </execution>
            </executions>
            <configuration>
              <effort>Max</effort>
              <threshold>Low</threshold>
              <failOnError>false</failOnError>
              <xmlOutput>true</xmlOutput>
              <sarifOutput>true</sarifOutput>
              <plugins>
                <plugin>
                  <groupId>com.h3xstream.findsecbugs</groupId>
                  <artifactId>findsecbugs-plugin</artifactId>
                  <version>${version.findsecbugs}</version>
                </plugin>
              </plugins>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- M-095 coverage, REPORT-ONLY: -Psangam-coverage attaches the JaCoCo agent to the surefire and failsafe runs (@{argLine}) and
         writes target*/site/jacoco at verify. The SANGAM.md target (85% line coverage on core) is a check with
         haltOnFailure=false: it reports, never fails. -->
    <profile>
      <id>sangam-coverage</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>sangam-jacoco-agent</id>
                <goals><goal>prepare-agent</goal></goals>
              </execution>
              <execution>
                <id>sangam-jacoco-report</id>
                <phase>verify</phase>
                <goals><goal>report</goal></goals>
              </execution>
              <execution>
                <id>sangam-jacoco-target</id>
                <phase>verify</phase>
                <goals><goal>check</goal></goals>
                <configuration>
                  <haltOnFailure>false</haltOnFailure>
                  <rules>
                    <rule>
                      <element>BUNDLE</element>
                      <limits>
                        <limit>
                          <counter>LINE</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>0.85</minimum>
                        </limit>
                      </limits>
                    </rule>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- M-095 mutation testing, REPORT-ONLY and never bound to a phase: run it explicitly, e.g.
         mvn -Psangam-mutation -pl sangam-core test-compile org.pitest:pitest-maven:mutationCoverage
         The SANGAM.md target is 70%; mutationThreshold/coverageThreshold 0 keep it non-blocking. The test JVMs run in
         UTC as the engine requires (SL-53). -->
    <profile>
      <id>sangam-mutation</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <configuration>
              <targetClasses><param>org.sangam.*</param></targetClasses>
              <targetTests><param>org.sangam.*</param></targetTests>
              <excludedTestClasses>
                <param>*IT</param>
              </excludedTestClasses>
              <mutationThreshold>0</mutationThreshold>
              <coverageThreshold>0</coverageThreshold>
              <timestampedReports>false</timestampedReports>
              <outputFormats>
                <format>XML</format>
                <format>HTML</format>
              </outputFormats>
              <jvmArgs>
                <value>-Duser.timezone=UTC</value>
              </jvmArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- M-019 / decision 181: what Central needs next to every jar (sources and javadoc). publish-packages.yml
         maven-bundle runs "deploy -Psangam-central" into the file staging repository; central_bundle.py checks it.
         Build-only plugins, resolved only when this profile is active (not in the default build or its gates). -->
    <profile>
      <id>sangam-central</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.4.0</version>
            <executions>
              <execution>
                <id>sangam-central-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.12.0</version>
            <configuration>
              <doclint>none</doclint>
              <quiet>true</quiet>
            </configuration>
            <executions>
              <execution>
                <id>sangam-central-javadoc</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- M-019 signing in Maven, for the owner's package-release environment only (decision 112). The key comes from the
         gpg keyring of that runner (imported from the secret MAVEN_GPG_PRIVATE_KEY) and the passphrase from the
         environment variable MAVEN_GPG_PASSPHRASE; both are referenced by name only, never written here or in
         settings.xml (bestPractices refuses a passphrase from properties or settings). publish-packages.yml signs the
         staged files with the same key and passphrase after staging (maven-publish job); this profile is the in-Maven
         equivalent for the same environment. -->
    <profile>
      <id>sangam-sign</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <configuration>
              <bestPractices>true</bestPractices>
              <passphraseEnvName>MAVEN_GPG_PASSPHRASE</passphraseEnvName>
              <gpgArguments>
                <arg>--pinentry-mode</arg>
                <arg>loopback</arg>
              </gpgArguments>
            </configuration>
            <executions>
              <execution>
                <id>sangam-sign</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
