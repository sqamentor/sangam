  <groupId>io.github.sqamentor</groupId>
  <artifactId>sangam-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Sangam</name>
  <!-- Decision 210: Maven Central groupId io.github.sqamentor (Java packages stay org.sangam.*). The metadata below is
       inherited by every module (Central requires description, url, licenses, developers and scm; name is per module). -->
  <description>Sangam: a workflow and case platform on the Operaton process engine, with product layers, connectors and SDKs.</description>
  <url>https://github.com/sqamentor/sangam</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>sqamentor</id>
      <name>The Sangam authors</name>
      <url>https://github.com/sqamentor</url>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/sqamentor/sangam</url>
    <connection>scm:git:https://github.com/sqamentor/sangam.git</connection>
    <developerConnection>scm:git:https://github.com/sqamentor/sangam.git</developerConnection>
    <tag>HEAD</tag>
  </scm>

  <!-- M-019, decisions 105, 112 and 181: "mvn deploy" only ever writes a local file staging repository. The Central bundle
       is made from it by deploy/licence/central_bundle.py and uploaded by publish-packages.yml (maven-publish job, owner
       environment package-release, USER_MANAGED); no remote repository and no credential is configured here. -->
  <distributionManagement>
    <repository>
      <id>sangam-staging</id>
      <name>Local staging repository for the Central bundle</name>
      <url>file://${sangam.staging.dir}</url>
    </repository>
    <snapshotRepository>
      <id>sangam-staging</id>
      <name>Local staging repository for the Central bundle</name>
      <url>file://${sangam.staging.dir}</url>
    </snapshotRepository>
  </distributionManagement>

  <!-- Module ownership: ARCHITECTURE.md section 3. Each module is owned by one workstream. -->
  <modules>
    <module>sangam-bom</module>
    <module>sangam-core</module>
    <module>sangam-persistence</module>
    <!-- W4-E integrator ruling (1) option A: FEEL and DMN 1.6 support, ahead of sangam-engine and sangam-packs -->
    <module>sangam-feel</module>
    <module>sangam-engine</module>
    <!-- M-141/M-144: plain-Java assembly layer and host SPI (never a host; HostFrameworkBoundaryTest) -->
    <module>sangam-assembly</module>
    <module>sangam-security</module>
    <module>sangam-integration</module>
    <!-- decision 217: optional eSign and DSC signing module, the only holder of Bouncy Castle; never a compile dependency of
         sangam-server or a default module (opt-in runtime add-on beside the server fat jar: deploy/docker/server/esign-addon.sh); live eSign off (decision 215) -->
    <module>sangam-esign</module>
    <!-- decisions 114/119: veraPDF validator, a separate container; the only module allowed Rhino (PdfValidatorReactorScopeTest) -->
    <module>sangam-pdf-validator</module>
    <!-- decisions 167/153 (M-103): OCR sidecar (Tesseract in its own image) on the decision-114 pattern; optional -->
    <module>sangam-ocr-sidecar</module>
    <!-- US-HEALTH workstream: FHIR R4 / SMART, X12 005010, Da Vinci PAS, CDS Hooks -->
    <module>sangam-connectors-health</module>
    <module>sangam-flowable-ports</module>
    <!-- Decision 155: shared Kubernetes REST client (JDK HTTP client, Jackson) for the operator and the backup console -->
    <module>sangam-kube</module>
    <!-- Decision 155 / M-102: backup console (targets, trigger now, run history) -->
    <module>sangam-backup</module>
    <!-- Decisions 277 and 285: the Spring-free ports and default adapters of sangam-rest (package names unchanged) -->
    <module>sangam-rest-core</module>
    <module>sangam-security-bridge</module>
    <module>sangam-rest</module>
    <!-- M-144/M-150: host conformance and cross-host equivalence kit, run by every host's tests -->
    <module>sangam-host-conformance</module>
    <module>sangam-packs</module>
    <module>sangam-compliance</module>
    <module>sangam-config</module>
    <module>sangam-ledger</module>
    <module>sangam-registry</module>
    <module>sangam-billing</module>
    <!-- GENERIC-CASE-PROGRAMME workstream: N04/N16 case file, meetings, references; N15 programmes and returns -->
    <module>sangam-case</module>
    <module>sangam-programme</module>
    <module>sangam-resources</module>
    <!-- GENERIC-FIELD-GEO workstream: N13 geometry/jurisdiction/geofence; N05 field capture + N17 dispatch -->
    <module>sangam-geo</module>
    <module>sangam-field</module>
    <module>sangam-server</module>
    <module>sdks/java</module>
    <!-- M-027: Spring Boot worker adapter (an SDK host, decision 74) -->
    <module>sdks/java-spring-boot</module>
    <!-- SCALE workstream (SCALE-ARCHITECTURE.md) -->
    <module>sangam-cell</module>
    <module>sangam-control-plane</module>
    <module>sangam-gateway</module>
    <module>sangam-rollup</module>
    <!-- PREMIUM-GAP workstream: spike/results/PREMIUM-GAP-RECHECK.md NG-01..41 -->
    <module>sangam-ai</module>
    <module>sangam-channels</module>
    <module>sangam-ops</module>
    <module>sangam-modeller</module>
    <module>tools/sangam-cli</module>
    <module>tools/sangam-script-worker</module>
    <!-- M-090: Kubernetes operator (plain JDK HTTP client against the Kubernetes REST API) -->
    <module>deploy/operator</module>
    <module>sangam-onboarding</module>
    <!-- M-014: embedded mode (auto-configuration over sangam-server's plain library jar) -->
    <module>sangam-spring-boot-starter</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- M-019: where "mvn deploy" writes (distributionManagement); publish-packages.yml passes its own directory -->
    <sangam.staging.dir>${maven.multiModuleProjectDirectory}/target/central-staging</sangam.staging.dir>
    <version.operaton>2.2.1</version.operaton>
    <!-- 2.22.3: Operaton FEEL needs >= 2.22.1; 2.22.3 fixes the OSV findings (spike E12-E15) -->
    <version.jackson>2.22.3</version.jackson>
    <!-- D-7 / LIC-7: 5.x only after legal review -->
    <version.liquibase>4.33.0</version.liquibase>
    <!-- SG-28: runtime dependency of Operaton's StrongUuidGenerator; operaton-engine 2.2.0 builds against 5.2.0 -->
    <version.java-uuid-generator>5.2.0</version.java-uuid-generator>
    <!-- SG-27 consumer licence-policy exception (owner decision): Operaton DMN FEEL engine, exactly the versions operaton-engine-dmn
         2.2.0 and 2.2.1 resolve (verified licences in deploy/licence/SG-27-SD-301-exception.md). Any change is re-verified;
         sangam-bom pins the same (BomPinsTest). scala-library 2.13.18 = the highest of 2.13.8/2.13.14/2.13.18 asked
         for by fastparse/sourcecode/geny/feel-engine, so the tree converges on what Maven already picked. -->
    <version.feel-engine>1.22.1</version.feel-engine>
    <version.scala-library>2.13.18</version.scala-library>
    <version.fastparse>3.1.1</version.fastparse>
    <version.sourcecode>0.4.0</version.sourcecode>
    <version.geny>1.1.0</version.geny>
    <!-- must match Spring Boot 4.1.2's managed junit-jupiter.version (Spring Framework 7 needs JUnit 6) -->
    <version.junit>6.0.3</version.junit>
    <version.testcontainers>1.21.4</version.testcontainers>
    <version.postgresql>42.7.14</version.postgresql>
    <version.mariadb>3.5.11</version.mariadb>
    <version.mssql>12.10.2.jre11</version.mssql>
    <version.hikari>6.3.0</version.hikari>
    <!-- RM-31: the slf4j family ships as one version; Spring Boot 4.1.2 brings jul-to-slf4j 2.0.20, so the API is 2.0.20
         too (test_version_families.py) -->
    <version.slf4j>2.0.20</version.slf4j>
    <version.h2>2.3.232</version.h2>
    <!-- broker clients (R38 inbound, ports channels): one version for every module, also for hosts (M-014); the
         Spring Boot BOM would otherwise resolve a different kafka-clients for a module that gets it transitively -->
    <version.kafka>3.9.2</version.kafka>
    <version.jakarta-jms>3.1.0</version.jakarta-jms>
    <!-- M-068: JSON-Schema validation of contract-bound requests. Apache-2.0; pulls jackson-dataformat-yaml (jackson-bom), itu 1.10.2, snakeyaml 2.5, all Apache-2.0 (decision 56, DOWNLOADS-WAVE3) -->
    <version.json-schema-validator>1.5.1</version.json-schema-validator>
    <!-- M-132: EXIF of PNG and HEIF/HEIC evidence. metadata-extractor Apache-2.0, xmpcore BSD-3-Clause (decisions 56, 60) -->
    <version.metadata-extractor>2.22.0</version.metadata-extractor>
    <version.xmpcore>6.1.11</version.xmpcore>
    <!-- M-081: PDF/A-2b + PDF/UA-1 renderer, Apache-2.0 (decision 56) -->
    <version.pdfbox>3.0.8</version.pdfbox>
    <!-- M-081: PDF/A-2b + PDF/UA-1 validator, MPL-2.0 elected (decisions 94, 102); jakarta line for Jakarta EE 11 -->
    <version.verapdf>1.30.4</version.verapdf>
    <!-- M-080 PAdES/CMS signing and RFC 3161 time-stamps (W4-H): Bouncy Castle licence (MIT-style), allowed by
         licence-policy.json; one version for bcprov, bcpkix and bcutil. -->
    <version.bouncycastle>1.87</version.bouncycastle>
    <!-- M-100 package Git sync (W4-H, optional in sangam-integration): Eclipse JGit, EDL-1.0 (S-22); decision 183 also
         names this version for the HAPI closure. -->
    <version.jgit>7.8.1.202611041320-r</version.jgit>
    <!-- Nimbus JOSE+JWT (Apache-2.0): the version spring-security-oauth2-jose 7.1.2 brings to sangam-server (not managed by
         the Boot BOM); managed here so the server and the sangam-security test scope always use one version. -->
    <version.nimbus-jose-jwt>10.10</version.nimbus-jose-jwt>
    <!-- The one Spring line for every module: the Boot version operaton-bpm-spring-boot-starter 2.2.0 is built
         against (operaton-root 2.2.0: Spring Boot 4.1.2, Spring Framework 7.0.10, Spring Security 7.1.2). -->
    <version.spring-boot>4.1.2</version.spring-boot>
    <!-- Build output folder per module. Concurrent builds of one checkout must each pass their own -Dsangam.target=...:
         a shared target/ is rewritten under a running javac ("package does not exist"). -->
    <sangam.target>target</sangam.target>
    <!-- M-094 / M-095 build-time tools (owner download approval batch 1, 2026-11-12). Never shipped: the enforcer rule
         below and deploy/licence/licence-policy.json (forbidden_components, build_time_tools) keep them out of every
         shipped scope. Every gate they drive is report-only (no build failure) until the test-phase triage. -->
    <version.errorprone>2.52.0</version.errorprone>
    <version.nullaway>0.14.4</version.nullaway>
    <!-- LGPL build-only tools, allowed by the owner decision of 2026-11-12 (licence-policy.json build_time_tools) -->
    <version.spotbugs-maven-plugin>4.10.5.0</version.spotbugs-maven-plugin>
    <version.spotbugs>4.10.5</version.spotbugs>
    <version.findsecbugs>1.14.0</version.findsecbugs>
    <version.sonar-maven-plugin>5.8.0.7211</version.sonar-maven-plugin>
    <version.jacoco>0.8.16</version.jacoco>
    <version.pitest>1.30.2</version.pitest>
    <version.pitest-junit5>1.2.3</version.pitest-junit5>
    <!-- CR-10/CR-12 (RM-20..RM-22): build tools the workflows call by prefix (dependency:copy, dependency:tree,
         help:evaluate) or by coordinate (makeBom) are pinned here, so no CI run picks a version by itself. All
         Apache-2.0, build-only, never shipped. maven-dependency-plugin 3.11.0 (UP-L4; was 3.7.0, the Maven 3.9.9 super POM
         version); maven-help-plugin 3.5.2 = the version in the local repository (unpinned, an offline run cannot
         resolve one); cyclonedx-maven-plugin 2.9.3 (UP-L4; 2.9.1 = decision 134, downloaded under decision 178 with its 23-jar
         build-time closure (DOWNLOADS-WAVE4.md, 2026-11-12T18:42:21Z; the per-POM licence review of that closure is
         not done); versions-maven-plugin 2.25.2 (UP-L4; 2.25.1 = decision 185 (latest stable, Apache-2.0, recorded in
         DOWNLOADS-WAVE4.md); maven-site-plugin 3.22.0 (UP-L4; RM-45 pins a literal version, was the super POM 3.12.1). -->
    <version.maven-dependency-plugin>3.11.0</version.maven-dependency-plugin>
    <version.maven-help-plugin>3.5.2</version.maven-help-plugin>
    <version.maven-site-plugin>3.22.0</version.maven-site-plugin>
    <version.cyclonedx-maven-plugin>2.9.3</version.cyclonedx-maven-plugin>
    <version.versions-maven-plugin>2.25.2</version.versions-maven-plugin>
    <version.jqwik>1.10.2</version.jqwik>
    <version.jazzer>0.30.0</version.jazzer>
    <version.cucumber>8.0.4</version.cucumber>
    <!-- M-095: empty unless -Psangam-coverage sets it (JaCoCo prepare-agent). Surefire reads it as @{argLine}, so the
         agent and the UTC/tmpdir flags below are both kept. -->
    <argLine></argLine>
