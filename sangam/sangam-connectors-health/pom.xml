<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.sqamentor</groupId>
    <artifactId>sangam-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>sangam-connectors-health</artifactId>
  <name>Generic health connectors: FHIR R4, SMART Backend Services, X12 005010, Da Vinci PAS, CDS Hooks</name>

  <properties>
    <!-- Decision 183: HAPI FHIR profile validation, evaluated in DOWNLOADS-WAVE4.md (D-2, 8.12.1) -->
    <version.hapi-fhir>8.12.1</version.hapi-fhir>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Decision 183: versions the HAPI closure must use. javassist 3.33.0-GA is the decision 117 Apache-2.0 election
           (HAPI brings 3.29.0-GA through ognl); jakarta.annotation-api 3.0.0 is the elected version (HAPI brings 2.1.1).
           Jackson 2.22.3 (jackson-bom) and JGit 7.8.0 come from the root pom's dependencyManagement. -->
      <dependency>
        <groupId>org.javassist</groupId>
        <artifactId>javassist</artifactId>
        <version>3.33.0-GA</version>
      </dependency>
      <dependency>
        <groupId>jakarta.annotation</groupId>
        <artifactId>jakarta.annotation-api</artifactId>
        <version>3.0.0</version>
      </dependency>
      <!-- the HAPI closure as evaluated (D-2); the root import of the Spring Boot dependencies would otherwise move it to
           a version that was neither evaluated nor fetched -->
      <dependency>
        <groupId>com.github.ben-manes.caffeine</groupId>
        <artifactId>caffeine</artifactId>
        <version>3.1.8</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.github.sqamentor</groupId>
      <artifactId>sangam-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- HttpTransport, EgressPolicy, SecretResolver, Json, SimHttpServer, InboxService types. No cycle. -->
    <dependency>
      <groupId>io.github.sqamentor</groupId>
      <artifactId>sangam-integration</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Apache-2.0 -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <!-- Decisions 183, 187 and 209: HAPI FHIR profile validation, Apache-2.0 (closure licences in DOWNLOADS-WAVE4.md;
         the XmlPull parser is mxparser plus xmlpull, decisions 226 and 263, see below). OPTIONAL: never transitive to a module that depends on this one, so the server class
         path carries no HAPI unless a deployment adds it; without it FhirProfileValidations reports CAPABILITY_MISSING.
         Exclusions: jakarta-regexp 1.4 (no licence; no class in the closure references org.apache.regexp) and
         sqlite-jdbc (native libraries; used only by optional package-index, AI text and importer paths). -->
    <dependency>
      <groupId>ca.uhn.hapi.fhir</groupId>
      <artifactId>hapi-fhir-validation</artifactId>
      <version>${version.hapi-fhir}</version>
      <optional>true</optional>
      <exclusions>
        <exclusion>
          <groupId>jakarta-regexp</groupId>
          <artifactId>jakarta-regexp</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.xerial</groupId>
          <artifactId>sqlite-jdbc</artifactId>
        </exclusion>
        <!-- decision 226: org.ogce:xpp3 1.1.6 (via org.hl7.fhir.validation) bundles javax/xml/namespace/QName of unstated
             origin, plus Jaxen and SAXPath; replaced by the two artifacts below -->
        <exclusion>
          <groupId>org.ogce</groupId>
          <artifactId>xpp3</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- Decisions 226, 254 and 263: the XmlPull parser the FHIR validator needs. xmlpull 1.1.3.1 is the only
         org.xmlpull.v1 API jar (public domain). The parser is io.github.x-stream:mxparser 1.2.2 (MXParser, a fork of
         xpp3_min 1.1.7 with the parser only, no org.xmlpull.v1 class inside; Indiana University Extreme! Lab Software
         License 1.2, BSD style with an acknowledgement, attribution in NOTICE), found through META-INF/services by
         XmlPullParserFactory, the only way the HAPI and org.hl7.fhir parsers reach it. Replaces xpp3_min 1.1.4c, which
         bundled two org.xmlpull.v1 classes that differ in bytes from xmlpull's. Records in DOWNLOADS-WAVE4.md
         (04:00:40Z cache read, 263 re-resolve). Optional like the rest of HAPI. -->
    <dependency>
      <groupId>io.github.x-stream</groupId>
      <artifactId>mxparser</artifactId>
      <version>1.2.2</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>xmlpull</groupId>
      <artifactId>xmlpull</artifactId>
      <version>1.1.3.1</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>ca.uhn.hapi.fhir</groupId>
      <artifactId>hapi-fhir-structures-r4</artifactId>
      <version>${version.hapi-fhir}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>ca.uhn.hapi.fhir</groupId>
      <artifactId>hapi-fhir-validation-resources-r4</artifactId>
      <version>${version.hapi-fhir}</version>
      <optional>true</optional>
    </dependency>
    <!-- needed at run time: without a cache provider HAPI fails with HAPI-2200 (D-2 smoke) -->
    <dependency>
      <groupId>ca.uhn.hapi.fhir</groupId>
      <artifactId>hapi-fhir-caching-caffeine</artifactId>
      <version>${version.hapi-fhir}</version>
      <optional>true</optional>
    </dependency>
    <!-- Decision 243: ABDM Fidelius (org.sangam.connectors.health.fidelius) on Bouncy Castle, the same bcprov-jdk18on
         as eSign (version from the root pom, 1.84). OPTIONAL and in this module only: never on the default server; a
         deployment that uses Fidelius takes the jar from the eSign add-on and never runs the NATS add-on (decision
         235, licence-policy.json). -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
