{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "0.1.0",
  "id": "${TEAMS_APP_ID}",
  "developer": {
    "name": "${DEVELOPER_NAME}",
    "websiteUrl": "${WEBSITE_URL}",
    "privacyUrl": "${PRIVACY_URL}",
    "termsOfUseUrl": "${TERMS_URL}"
  },
  "name": {
    "short": "Sangam",
    "full": "Sangam workflow"
  },
  "description": {
    "short": "Your Sangam tasks inside Microsoft Teams.",
    "full": "Open, claim and complete your Sangam workflow tasks from a personal tab in Microsoft Teams. You sign in with your organisation's Sangam sign-in; Microsoft accounts are not used."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#1F5F8B",
  "staticTabs": [
    {
      "entityId": "sangam-my-work",
      "name": "My work",
      "contentUrl": "https://${UI_HOST}${UI_BASE}teams.html",
      "websiteUrl": "https://${UI_HOST}${UI_BASE}tasks",
      "scopes": ["personal"]
    }
  ],
  "permissions": ["identity"],
  "validDomains": ["${UI_HOST}", "${IDP_HOST}"]
}
