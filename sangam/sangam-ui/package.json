{
  "name": "@sangam/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Sangam web UI: tasklist, operations console, admin, modeller, analytics, audit and citizen portal (React 18 + TypeScript + Vite).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:embed": "tsc -p tsconfig.json --noEmit && vite build --config vite.embed.config.ts",
    "teams:package": "node scripts/teams-package.mjs",
    "e2e": "playwright test --config playwright.config.ts",
    "lint": "tsc -p tsconfig.json --noEmit && node scripts/check-i18n.mjs && node scripts/check-no-cdn.mjs",
    "test": "vitest --run",
    "preview": "vite preview",
    "i18n:check": "node scripts/check-i18n.mjs",
    "licences": "node scripts/list-licences.mjs",
    "compat": "node scripts/gen-compat.mjs"
  },
  "dependencies": {
    "@bpmn-io/form-js-editor": "2.2.0",
    "@bpmn-io/form-js-viewer": "2.2.0",
    "@microsoft/teams-js": "2.59.0",
    "bpmn-js": "18.33.0",
    "diagram-js": "15.30.0",
    "dmn-js": "18.0.3",
    "i18next": "27.1.5",
    "oidc-client-ts": "3.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.2",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.1",
    "fake-indexeddb": "6.2.8",
    "jsdom": "31.0.1",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "overrides": {
    "rolldown": "1.2.19",
    "@rolldown/pluginutils": "1.1.1"
  }
}
