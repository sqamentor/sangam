{
  "name": "@sangam/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Sangam web UI: tasklist, operations console, admin, modeller, analytics, audit and citizen portal (React 18 + TypeScript + Vite).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:embed": "tsc -p tsconfig.json --noEmit && vite build --config vite.embed.config.ts",
    "teams:package": "node scripts/teams-package.mjs",
    "e2e": "playwright test --config playwright.config.ts",
    "lint": "tsc -p tsconfig.json --noEmit && node scripts/check-i18n.mjs && node scripts/check-no-cdn.mjs",
    "test": "vitest --run",
    "preview": "vite preview",
    "i18n:check": "node scripts/check-i18n.mjs",
    "licences": "node scripts/list-licences.mjs",
    "compat": "node scripts/gen-compat.mjs"
  },
  "dependencies": {
    "@bpmn-io/form-js-editor": "1.12.0",
    "@bpmn-io/form-js-viewer": "1.12.0",
    "@microsoft/teams-js": "2.59.0",
    "bpmn-js": "17.11.1",
    "diagram-js": "14.11.3",
    "dmn-js": "16.8.2",
    "i18next": "23.16.8",
    "oidc-client-ts": "3.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "15.1.4",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "fake-indexeddb": "6.2.8",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "overrides": {
    "rolldown": "1.2.15",
    "@rolldown/pluginutils": "1.0.1"
  }
}
