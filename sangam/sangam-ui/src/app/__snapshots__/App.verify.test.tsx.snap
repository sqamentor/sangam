exports[`the public form, for a caller who is not signed in > status loading: the form as built, without the page frame > public verify page 1`] = `"<main id="main" class="signin" tabindex="-1"><div class="signin-card"><div class="lang-switch" role="group" aria-label="Language"><button type="button" lang="en" aria-pressed="true">English</button><button type="button" lang="hi" aria-pressed="false">हिन्दी</button></div><h1 id="page-title" tabindex="-1">Verify a document</h1><p>Check a document issued through this system. Enter the issuer and the verification code.</p><form><fieldset class="field"><legend>What do you want to verify?</legend><label class="choice"><input type="radio" checked="" name="vk"> Licence, permit or certificate</label><label class="choice"><input type="radio" name="vk"> Certified extract</label></fieldset><div class="field"><label for="ID">Issuer<span class="req" aria-hidden="true"> *</span><span class="sr-only"> (required)</span></label><input id="ID" aria-invalid="false" required="" value=""></div><div class="field"><label for="ID">Verification code<span class="req" aria-hidden="true"> *</span><span class="sr-only"> (required)</span></label><input id="ID" aria-invalid="false" required="" autocomplete="off" value=""></div><button type="submit" class="primary" disabled="">Verify</button></form><p class="muted small">Only the issuer and code you enter are sent for this check.</p></div></main>"`;

