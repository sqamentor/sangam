<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- M-048 seed model: start, one user task, end. No extension attributes, so it deploys on every supported engine. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             id="Definitions_e2e" targetNamespace="urn:sangam:e2e">
  <process id="sangamE2eSimple" name="E2E simple review" isExecutable="true">
    <startEvent id="Start" name="Received" />
    <sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Review" />
    <userTask id="Review" name="Review the request" />
    <sequenceFlow id="Flow_2" sourceRef="Review" targetRef="End" />
    <endEvent id="End" name="Done" />
  </process>
  <bpmndi:BPMNDiagram id="Diagram_e2e">
    <bpmndi:BPMNPlane id="Plane_e2e" bpmnElement="sangamE2eSimple">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="152" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Review_di" bpmnElement="Review">
        <dc:Bounds x="240" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End">
        <dc:Bounds x="392" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="340" y="120" />
        <di:waypoint x="392" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
