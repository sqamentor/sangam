<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- Marketplace order. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_sec_ecom_order" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.2">
  <message id="msg_sangam_order_cancel" name="sangam.order.cancel"/>
  <message id="msg_sangam_order_delivered" name="sangam.order.delivered"/>
  <message id="msg_sangam_order_rto" name="sangam.order.rto"/>
  <error id="err_PAYMENT_FAILED" name="PAYMENT_FAILED" errorCode="PAYMENT_FAILED"/>
  <process id="sangam-sec-ecom-order" name="Marketplace order" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.2">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.ecom.order-to-cash</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.2</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>orderId,customerId,sellerId,amount,paymentMode,payeeAccount,currency,purpose</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="eo_start" name="Order placed" operaton:initiator="initiator" operaton:formKey="sangam:sec-ecom-order-to-cash/order"></startEvent>
    <serviceTask id="eo_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>sellerId=SELLER-1;paymentMode=PREPAID;category=GENERAL;sellerSla=2D;deliverySla=7D;returnWindow=P7D;sellerGroup=SELLER-DESK;executionConnector=pg.refund;executionStep=refund;verifyApproval=false;reconcileRequired=false;executionPayloadFields=orderId,amount;applicantRef=@customerId</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="eo_fraud_clear" name="Clear the previous check result" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>riskHold=null</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="eo_fraud" name="Fraud screen" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>fraud.score</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>score</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>orderId,customerId,amount</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>risk</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="eo_holdGw" name="Risky?" default="sec_ecom_order_f9"></exclusiveGateway>
    <userTask id="eo_review" name="Review risky order" operaton:candidateGroups="RISK-DESK" operaton:formKey="sangam:sec-ecom-order-to-cash/review"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>riskDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="eo_revGw" name="" default="sec_ecom_order_f10"></exclusiveGateway>
    <endEvent id="eo_endRiskRejected" name="Cancelled by risk review"></endEvent>
    <exclusiveGateway id="eo_payGw" name="Prepaid?" default="sec_ecom_order_f22"></exclusiveGateway>
    <serviceTask id="eo_auth" name="Authorise payment" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>pg.authorise</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>authorise</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>orderId,amount</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>pay</operaton:string></operaton:field><operaton:field name="step"><operaton:string>authorise</operaton:string></operaton:field><operaton:field name="errorOnFailure"><operaton:string>PAYMENT_FAILED</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="eo_endPayFailed" name="Payment failed"></endEvent>
    <serviceTask id="eo_seller_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>eo_seller</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${sellerSla}</operaton:expression></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="eo_seller" name="Seller confirms and packs" operaton:candidateGroups="${sellerGroup}" operaton:formKey="sangam:sec-ecom-order-to-cash/seller" operaton:dueDate="${eo_sellerDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>sellerDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="eo_seller_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>eo_seller</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>sellerGroup</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="eo_seller_warnEnd" name="Warned"></endEvent>
    <serviceTask id="eo_seller_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>eo_seller</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>DEEMED_REFUSAL</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>sellerGroup</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>sellerDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>accept</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field><operaton:field name="maxEscalations"><operaton:string>0</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="eo_seller_breachGw" name="Deemed?" default="sec_ecom_order_f18"></exclusiveGateway>
    <exclusiveGateway id="eo_seller_done" name=""></exclusiveGateway>
    <exclusiveGateway id="eo_sellerGw" name="" default="sec_ecom_order_f28"></exclusiveGateway>
    <callActivity id="eo_refund" name="Refund to the source (core execution)" calledElement="sangam-core-execution" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.2"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <callActivity id="eo_refund_sanction" name="Approve release of money (core sanction, owner decision A1)" calledElement="sangam-core-sanction" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.2"><extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.MoneyFieldsDelegate"><operaton:field name="captureVar"><operaton:string>payRef</operaton:string></operaton:field><operaton:field name="purpose"><operaton:string>Refund of the order to its source</operaton:string></operaton:field></operaton:executionListener><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:in sourceExpression="${true}" target="moneyOutRelease"/><operaton:in sourceExpression="${'ESCALATE'}" target="sanctionOnBreach"/><operaton:out variables="all"/></extensionElements></callActivity>
    <exclusiveGateway id="eo_refund_sgw" name="Sanctioned?" default="eo_refund_sgw_no"></exclusiveGateway>
    <endEvent id="eo_refund_notReleased" name="Not released"></endEvent>
    <sequenceFlow id="eo_refund_sanction_f" sourceRef="eo_refund_sanction" targetRef="eo_refund_sgw"/>
    <sequenceFlow id="eo_refund_sgw_yes" name="sanctioned" sourceRef="eo_refund_sgw" targetRef="eo_refund"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="eo_refund_sgw_no" name="not sanctioned" sourceRef="eo_refund_sgw" targetRef="eo_refund_notReleased"/>

    <exclusiveGateway id="eo_refundGw" name="Refund needed?" default="sec_ecom_order_f26"></exclusiveGateway>
    <endEvent id="eo_endCancelled" name="Cancelled"></endEvent>
    <serviceTask id="eo_ship" name="Create shipment" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>logistics.ship</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>ship</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>orderId,pincode</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>ship</operaton:string></operaton:field><operaton:field name="step"><operaton:string>ship</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="eo_delClock" name="Regulatory clock: delivery" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>delivery</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${deliverySla}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <eventBasedGateway id="eo_wait" name="Delivered, RTO or late"></eventBasedGateway>
    <intermediateCatchEvent id="eo_delivered" name="Delivered"><messageEventDefinition messageRef="msg_sangam_order_delivered"/></intermediateCatchEvent>
    <intermediateCatchEvent id="eo_rto" name="Returned to origin (failed delivery)"><messageEventDefinition messageRef="msg_sangam_order_rto"/></intermediateCatchEvent>
    <intermediateCatchEvent id="eo_late" name="Delivery promise missed"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${deliveryDueAt}</timeDate></timerEventDefinition></intermediateCatchEvent>
    <userTask id="eo_investigate" name="Investigate delayed shipment" operaton:candidateGroups="LOGISTICS-DESK" operaton:formKey="sangam:sec-ecom-order-to-cash/delay"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="eo_delClock2" name="Regulatory clock: delivery" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>delivery</operaton:string></operaton:field><operaton:field name="spec"><operaton:string>3D</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="eo_cod" name="COD remittance" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>logistics.codRemit</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>remit</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>orderId,amount</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>cod</operaton:string></operaton:field><operaton:field name="step"><operaton:string>cod</operaton:string></operaton:field></extensionElements></serviceTask>

    <exclusiveGateway id="eo_codOptGw" name="COD?" default="sec_ecom_order_f39"></exclusiveGateway>
    <exclusiveGateway id="eo_codOptMerge" name=""></exclusiveGateway>
    <intermediateCatchEvent id="eo_returnWindow" name="Return window over"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">${returnWindow}</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <businessRuleTask id="eo_commission" name="Commission (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-ecom-commission</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <serviceTask id="eo_settleCfg" name="Settlement" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>executionConnector=nodal.settle;executionStep=seller-settlement;executionPayloadFields=sellerId,amount,commissionPct</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="eo_settle" name="Settle with the seller (core execution)" calledElement="sangam-core-execution" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.2"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <callActivity id="eo_settle_sanction" name="Approve release of money (core sanction, owner decision A1)" calledElement="sangam-core-sanction" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.2"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:in sourceExpression="${true}" target="moneyOutRelease"/><operaton:in sourceExpression="${'ESCALATE'}" target="sanctionOnBreach"/><operaton:out variables="all"/></extensionElements></callActivity>
    <exclusiveGateway id="eo_settle_sgw" name="Sanctioned?" default="eo_settle_sgw_no"></exclusiveGateway>
    <endEvent id="eo_settle_notReleased" name="Not released"></endEvent>
    <sequenceFlow id="eo_settle_sanction_f" sourceRef="eo_settle_sanction" targetRef="eo_settle_sgw"/>
    <sequenceFlow id="eo_settle_sgw_yes" name="sanctioned" sourceRef="eo_settle_sgw" targetRef="eo_settle"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="eo_settle_sgw_no" name="not sanctioned" sourceRef="eo_settle_sgw" targetRef="eo_settle_notReleased"/>

    <endEvent id="eo_end" name="Settled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="eo_payFail" name="Payment failed" attachedToRef="eo_auth" cancelActivity="true"><errorEventDefinition errorRef="err_PAYMENT_FAILED"/></boundaryEvent>
    <boundaryEvent id="eo_seller_warn" name="SLA warning (75%)" attachedToRef="eo_seller" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${eo_sellerWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="eo_seller_breach" name="SLA breached" attachedToRef="eo_seller" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${eo_sellerDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="sec_ecom_order_f1" sourceRef="eo_fraud_clear" targetRef="eo_fraud"/>
    <sequenceFlow id="sec_ecom_order_f2" sourceRef="eo_start" targetRef="eo_defaults"/>
    <sequenceFlow id="sec_ecom_order_f3" sourceRef="eo_defaults" targetRef="eo_fraud_clear"/>
    <sequenceFlow id="sec_ecom_order_f4" sourceRef="eo_fraud" targetRef="eo_holdGw"/>
    <sequenceFlow id="sec_ecom_order_f5" name="screen not confirmed: hold" sourceRef="eo_holdGw" targetRef="eo_review"><conditionExpression xsi:type="tFormalExpression">${riskStatus != 'COMPLETED' || riskHold == null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ecom_order_f6" name="hold" sourceRef="eo_holdGw" targetRef="eo_review"><conditionExpression xsi:type="tFormalExpression">${riskStatus == 'COMPLETED' &amp;&amp; riskHold != null &amp;&amp; (riskHold)}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ecom_order_f7" sourceRef="eo_review" targetRef="eo_revGw"/>
    <sequenceFlow id="sec_ecom_order_f8" name="reject" sourceRef="eo_revGw" targetRef="eo_endRiskRejected"><conditionExpression xsi:type="tFormalExpression">${riskDecision == 'reject'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ecom_order_f9" name="clear" sourceRef="eo_holdGw" targetRef="eo_payGw"/>
    <sequenceFlow id="sec_ecom_order_f10" name="approve" sourceRef="eo_revGw" targetRef="eo_payGw"/>
    <sequenceFlow id="sec_ecom_order_f11" name="prepaid" sourceRef="eo_payGw" targetRef="eo_auth"><conditionExpression xsi:type="tFormalExpression">${paymentMode == 'PREPAID'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ecom_order_f12" sourceRef="eo_payFail" targetRef="eo_endPayFailed"/>
    <sequenceFlow id="sec_ecom_order_f13" sourceRef="eo_seller_warn" targetRef="eo_seller_warnNotify"/>
    <sequenceFlow id="sec_ecom_order_f14" sourceRef="eo_seller_warnNotify" targetRef="eo_seller_warnEnd"/>
    <sequenceFlow id="sec_ecom_order_f15" sourceRef="eo_seller_breach" targetRef="eo_seller_breachAct"/>
    <sequenceFlow id="sec_ecom_order_f16" sourceRef="eo_seller_breachAct" targetRef="eo_seller_breachGw"/>
    <sequenceFlow id="sec_ecom_order_f17" name="deemed" sourceRef="eo_seller_breachGw" targetRef="eo_seller_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ecom_order_f18" name="escalated" sourceRef="eo_seller_breachGw" targetRef="eo_seller_slaPlan"/>
    <sequenceFlow id="sec_ecom_order_f19" sourceRef="eo_seller_slaPlan" targetRef="eo_seller"/>
    <sequenceFlow id="sec_ecom_order_f20" sourceRef="eo_seller" targetRef="eo_seller_done"/>
    <sequenceFlow id="sec_ecom_order_f21" sourceRef="eo_auth" targetRef="eo_seller_slaPlan"/>
    <sequenceFlow id="sec_ecom_order_f22" name="COD" sourceRef="eo_payGw" targetRef="eo_seller_slaPlan"/>
    <sequenceFlow id="sec_ecom_order_f23" sourceRef="eo_seller_done" targetRef="eo_sellerGw"/>
    <sequenceFlow id="sec_ecom_order_f24" name="rejected / not confirmed" sourceRef="eo_sellerGw" targetRef="eo_refundGw"><conditionExpression xsi:type="tFormalExpression">${sellerDecision != 'accept'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ecom_order_f25" name="prepaid" sourceRef="eo_refundGw" targetRef="eo_refund_sanction"><conditionExpression xsi:type="tFormalExpression">${paymentMode == 'PREPAID'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ecom_order_f26" name="COD" sourceRef="eo_refundGw" targetRef="eo_endCancelled"/>
    <sequenceFlow id="sec_ecom_order_f27" sourceRef="eo_refund" targetRef="eo_endCancelled"/>
    <sequenceFlow id="sec_ecom_order_f28" name="accepted" sourceRef="eo_sellerGw" targetRef="eo_ship"/>
    <sequenceFlow id="sec_ecom_order_f29" sourceRef="eo_ship" targetRef="eo_delClock"/>
    <sequenceFlow id="sec_ecom_order_f30" sourceRef="eo_delClock" targetRef="eo_wait"/>
    <sequenceFlow id="sec_ecom_order_f31" sourceRef="eo_wait" targetRef="eo_delivered"/>
    <sequenceFlow id="sec_ecom_order_f32" sourceRef="eo_wait" targetRef="eo_rto"/>
    <sequenceFlow id="sec_ecom_order_f33" sourceRef="eo_wait" targetRef="eo_late"/>
    <sequenceFlow id="sec_ecom_order_f34" sourceRef="eo_late" targetRef="eo_investigate"/>
    <sequenceFlow id="sec_ecom_order_f35" sourceRef="eo_investigate" targetRef="eo_delClock2"/>
    <sequenceFlow id="sec_ecom_order_f36" sourceRef="eo_delClock2" targetRef="eo_wait"/>
    <sequenceFlow id="sec_ecom_order_f37" sourceRef="eo_rto" targetRef="eo_refundGw"/>
    <sequenceFlow id="sec_ecom_order_f38" name="yes" sourceRef="eo_codOptGw" targetRef="eo_cod"><conditionExpression xsi:type="tFormalExpression">${paymentMode == 'COD'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ecom_order_f39" name="no" sourceRef="eo_codOptGw" targetRef="eo_codOptMerge"/>
    <sequenceFlow id="sec_ecom_order_f40" sourceRef="eo_cod" targetRef="eo_codOptMerge"/>
    <sequenceFlow id="sec_ecom_order_f41" sourceRef="eo_delivered" targetRef="eo_codOptGw"/>
    <sequenceFlow id="sec_ecom_order_f42" sourceRef="eo_codOptMerge" targetRef="eo_returnWindow"/>
    <sequenceFlow id="sec_ecom_order_f43" sourceRef="eo_returnWindow" targetRef="eo_commission"/>
    <sequenceFlow id="sec_ecom_order_f44" sourceRef="eo_commission" targetRef="eo_settleCfg"/>
    <sequenceFlow id="sec_ecom_order_f45" sourceRef="eo_settleCfg" targetRef="eo_settle_sanction"/>
    <sequenceFlow id="sec_ecom_order_f46" sourceRef="eo_settle" targetRef="eo_end"/>
    <subProcess id="eo_cancel" name="Cancelled by the consumer before shipment" triggeredByEvent="true">
      <startEvent id="eo_cxStart" name="Cancellation request" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_order_cancel"/></startEvent>
      <serviceTask id="eo_cxCfg" name="Refund settings" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>executionConnector=pg.refund;executionStep=cancel-refund</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="eo_cxRefund" name="Refund in full (core execution)" calledElement="sangam-core-execution" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.2"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <callActivity id="eo_cxRefund_sanction" name="Approve release of money (core sanction, owner decision A1)" calledElement="sangam-core-sanction" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.2"><extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.MoneyFieldsDelegate"><operaton:field name="captureVar"><operaton:string>payRef</operaton:string></operaton:field><operaton:field name="purpose"><operaton:string>Refund in full on cancellation, to the source</operaton:string></operaton:field></operaton:executionListener><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:in sourceExpression="${true}" target="moneyOutRelease"/><operaton:in sourceExpression="${'ESCALATE'}" target="sanctionOnBreach"/><operaton:out variables="all"/></extensionElements></callActivity>
    <exclusiveGateway id="eo_cxRefund_sgw" name="Sanctioned?" default="eo_cxRefund_sgw_no"></exclusiveGateway>
    <endEvent id="eo_cxRefund_notReleased" name="Not released"></endEvent>
    <sequenceFlow id="eo_cxRefund_sanction_f" sourceRef="eo_cxRefund_sanction" targetRef="eo_cxRefund_sgw"/>
    <sequenceFlow id="eo_cxRefund_sgw_yes" name="sanctioned" sourceRef="eo_cxRefund_sgw" targetRef="eo_cxRefund"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="eo_cxRefund_sgw_no" name="not sanctioned" sourceRef="eo_cxRefund_sgw" targetRef="eo_cxRefund_notReleased"/>

      <endEvent id="eo_cxEnd" name="Cancelled by the consumer"></endEvent>
      <sequenceFlow id="sec_ecom_order_f47" sourceRef="eo_cxStart" targetRef="eo_cxCfg"/>
