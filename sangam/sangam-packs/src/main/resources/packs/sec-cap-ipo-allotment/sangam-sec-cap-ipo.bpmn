<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- IPO post-issue. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_sec_cap_ipo" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <process id="sangam-sec-cap-ipo" name="IPO post-issue" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.cap.ipo-allotment</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>issueName,issueCloseDate</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="ip_start" name="Issue closed (T)" operaton:initiator="initiator" operaton:formKey="sangam:sec-cap-ipo-allotment/close"></startEvent>
    <serviceTask id="ip_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>issueName=@customerId;rtaSeat=RTA;mbSeat=LEAD-MANAGER;lateUnblock=false</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ip_recon" name="Reconcile bids, UPI mandates and ASBA blocks" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>rta.reconcile</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>reconcile</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>issueName</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>recon</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ip_basis_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>ip_basis</operaton:string></operaton:field><operaton:field name="spec"><operaton:string>1WD</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="ip_basis" name="Basis of allotment with the designated exchange (T+1)" operaton:candidateGroups="${mbSeat}" operaton:formKey="sangam:sec-cap-ipo-allotment/basis" operaton:dueDate="${ip_basisDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="ip_basis_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>ip_basis</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>mbSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="ip_basis_warnEnd" name="Warned"></endEvent>
    <serviceTask id="ip_basis_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>ip_basis</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>mbSeat</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="ip_basis_breachGw" name="Deemed?" default="sec_cap_ipo_f8"></exclusiveGateway>
    <exclusiveGateway id="ip_basis_done" name=""></exclusiveGateway>
    <serviceTask id="ip_basisSend" name="Basis approved by the exchange" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>exchange.basis</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>issueName</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>basis</operaton:string></operaton:field><operaton:field name="step"><operaton:string>basis</operaton:string></operaton:field></extensionElements></serviceTask>
    <parallelGateway id="ip_fork" name="T+2 in parallel"></parallelGateway>
    <parallelGateway id="ip_join" name=""></parallelGateway>
    <serviceTask id="ip_credit" name="Credit shares to demat accounts" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>depository.credit</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>credit</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>issueName</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>credit</operaton:string></operaton:field><operaton:field name="step"><operaton:string>credit</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ip_unblock" name="Unblock funds of non-allottees" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>sponsorbank.unblock</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>unblock</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>issueName</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>unblock</operaton:string></operaton:field><operaton:field name="step"><operaton:string>unblock</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="ip_ubGw" name="Unblock failed?" default="sec_cap_ipo_f20"></exclusiveGateway>
    <userTask id="ip_comp" name="Investor compensation for late unblocking" operaton:candidateGroups="${mbSeat}" operaton:formKey="sangam:sec-cap-ipo-allotment/compensation"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="ip_list" name="Listing and trading approval (T+3)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>exchange.listing</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>list</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>issueName</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>listing</operaton:string></operaton:field><operaton:field name="step"><operaton:string>listing</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="ip_end" name="Listed"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="ip_basis_warn" name="SLA warning (75%)" attachedToRef="ip_basis" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${ip_basisWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="ip_basis_breach" name="SLA breached" attachedToRef="ip_basis" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${ip_basisDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="sec_cap_ipo_f1" sourceRef="ip_start" targetRef="ip_defaults"/>
    <sequenceFlow id="sec_cap_ipo_f2" sourceRef="ip_defaults" targetRef="ip_recon"/>
    <sequenceFlow id="sec_cap_ipo_f3" sourceRef="ip_basis_warn" targetRef="ip_basis_warnNotify"/>
    <sequenceFlow id="sec_cap_ipo_f4" sourceRef="ip_basis_warnNotify" targetRef="ip_basis_warnEnd"/>
    <sequenceFlow id="sec_cap_ipo_f5" sourceRef="ip_basis_breach" targetRef="ip_basis_breachAct"/>
    <sequenceFlow id="sec_cap_ipo_f6" sourceRef="ip_basis_breachAct" targetRef="ip_basis_breachGw"/>
    <sequenceFlow id="sec_cap_ipo_f7" name="deemed" sourceRef="ip_basis_breachGw" targetRef="ip_basis_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_cap_ipo_f8" name="escalated" sourceRef="ip_basis_breachGw" targetRef="ip_basis_slaPlan"/>
    <sequenceFlow id="sec_cap_ipo_f9" sourceRef="ip_basis_slaPlan" targetRef="ip_basis"/>
    <sequenceFlow id="sec_cap_ipo_f10" sourceRef="ip_basis" targetRef="ip_basis_done"/>
    <sequenceFlow id="sec_cap_ipo_f11" sourceRef="ip_recon" targetRef="ip_basis_slaPlan"/>
    <sequenceFlow id="sec_cap_ipo_f12" sourceRef="ip_basis_done" targetRef="ip_basisSend"/>
    <sequenceFlow id="sec_cap_ipo_f13" sourceRef="ip_basisSend" targetRef="ip_fork"/>
    <sequenceFlow id="sec_cap_ipo_f14" sourceRef="ip_fork" targetRef="ip_credit"/>
    <sequenceFlow id="sec_cap_ipo_f15" sourceRef="ip_credit" targetRef="ip_join"/>
    <sequenceFlow id="sec_cap_ipo_f16" sourceRef="ip_fork" targetRef="ip_unblock"/>
    <sequenceFlow id="sec_cap_ipo_f17" sourceRef="ip_unblock" targetRef="ip_join"/>
    <sequenceFlow id="sec_cap_ipo_f18" sourceRef="ip_join" targetRef="ip_ubGw"/>
    <sequenceFlow id="sec_cap_ipo_f19" name="yes" sourceRef="ip_ubGw" targetRef="ip_comp"><conditionExpression xsi:type="tFormalExpression">${unblockStatus == 'FAILED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_cap_ipo_f20" name="no" sourceRef="ip_ubGw" targetRef="ip_list"/>
    <sequenceFlow id="sec_cap_ipo_f21" sourceRef="ip_comp" targetRef="ip_list"/>
    <sequenceFlow id="sec_cap_ipo_f22" sourceRef="ip_list" targetRef="ip_end"/>
  </process>
