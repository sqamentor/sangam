{
  "id": "gov.tender",
  "version": "1.0.3",
  "name": {
    "en": "Tender / e-procurement",
    "hi": "निविदा / ई-प्रापण"
  },
  "domain": "Procurement",
  "description": "NIT approval and publication (CPPP / GePNIC), corrigendum extending the bid date on the running case, bid opening not before the opening time, two-envelope opening by committee, technical evaluation by quorum, financial opening, L1 by rule, negotiation and retender loops, award sanction, EMD refund by compensation (D-TENDER). The case records the procurement mode of its value and department class (procurementMode, ruleRef) and stores only that mode; no step branches on it (decision 225).",
  "mainProcesses": [
    "sangam-tender"
  ],
  "resources": [
