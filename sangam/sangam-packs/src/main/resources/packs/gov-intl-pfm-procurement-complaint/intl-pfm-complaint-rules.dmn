<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_intl_pfm_complaint_rules" name="Complaint periods and suspension (SYNTHETIC; per country)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <!-- SYNTHETIC: country law or policy. Deploy the confirmed table as a tenant override. -->
  <decision id="intl-pfm-complaint-rules" name="Complaint periods and suspension (SYNTHETIC; per country)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.2">
    <decisionTable id="intl-pfm-complaint-rules_t" hitPolicy="FIRST">
      <input id="intl-pfm-complaint-rules_i0" label="Tender"><inputExpression id="intl-pfm-complaint-rules_ie0" typeRef="string"><text>tenderId</text></inputExpression></input>
      <output id="intl-pfm-complaint-rules_o0" label="Decide within" name="complaintDecisionSpec" typeRef="string"/>
      <output id="intl-pfm-complaint-rules_o1" label="Entity answers within" name="entityResponseSpec" typeRef="string"/>
      <output id="intl-pfm-complaint-rules_o2" label="Suspend the award while pending" name="suspendAward" typeRef="boolean"/>
      <rule id="intl-pfm-complaint-rules_r0"><description>SYNTHETIC</description>
        <inputEntry id="intl-pfm-complaint-rules_r0_i0"><text>-</text></inputEntry>
        <outputEntry id="intl-pfm-complaint-rules_r0_o0"><text>"20D"</text></outputEntry>
        <outputEntry id="intl-pfm-complaint-rules_r0_o1"><text>"7D"</text></outputEntry>
        <outputEntry id="intl-pfm-complaint-rules_r0_o2"><text>true</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
