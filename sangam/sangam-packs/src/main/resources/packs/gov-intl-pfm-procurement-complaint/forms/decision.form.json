{
  "key": "gov-intl-pfm-procurement-complaint/decision",
  "version": "1.0.1",
  "pack": "gov.intl.pfm-procurement-complaint",
  "title": {
    "en": "Decide the complaint with reasons",
    "hi": "शिकायत पर निर्णय"
  },
  "caseSummary": {
    "source": "materialFields",
    "label": {
      "en": "Case details",
      "hi": "प्रकरण का विवरण"
    }
  },
  "fields": [
    {
      "id": "complaintGrounds",
      "type": "text",
      "required": false,
      "label": {
        "en": "Grounds of the complaint",
        "hi": "शिकायत के आधार"
      }
    },
    {
      "id": "entityResponse",
      "type": "text",
      "required": false,
      "label": {
        "en": "Response of the procuring entity",
        "hi": "प्रापण इकाई का उत्तर"
      }
    },
    {
      "id": "decisionReasons",
      "type": "text",
      "required": true,
      "label": {
        "en": "Decision and reasons",
        "hi": "निर्णय एवं कारण"
      }
    },
    {
      "id": "remedy",
      "type": "text",
      "required": false,
      "label": {
        "en": "Remedy ordered",
        "hi": "आदेशित उपचार"
      }
    }
  ],
  "decision": {
    "variable": "complaintDecision",
    "required": true,
    "options": [
      {
        "value": "uphold",
        "label": {
          "en": "Uphold rejection",
          "hi": "अस्वीकृति बरकरार"
        }
      },
      {
        "value": "dismiss",
        "label": {
          "en": "Dismiss appeal",
          "hi": "अपील खारिज करें"
        }
      }
    ]
  }
}
