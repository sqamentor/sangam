<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_ifms_gia_release" name="Grant release rules" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <!-- Thresholds from the GOI profile grants.seventyFivePercentRule; States override by tenant DMN. -->
  <decision id="ifms-gia-release" name="Grant release rules" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="ifms-gia-release_t" hitPolicy="FIRST">
      <input id="ifms-gia-release_i0" label="Recurring"><inputExpression id="ifms-gia-release_ie0" typeRef="boolean"><text>recurringGrant</text></inputExpression></input>
      <input id="ifms-gia-release_i1" label="Release % of sanction"><inputExpression id="ifms-gia-release_ie1" typeRef="double"><text>releasePercent</text></inputExpression></input>
      <input id="ifms-gia-release_i2" label="UC status"><inputExpression id="ifms-gia-release_ie2" typeRef="string"><text>ucStatus</text></inputExpression></input>
      <input id="ifms-gia-release_i3" label="Unspent balance"><inputExpression id="ifms-gia-release_ie3" typeRef="double"><text>unspentBalance</text></inputExpression></input>
      <input id="ifms-gia-release_i4" label="Amount"><inputExpression id="ifms-gia-release_ie4" typeRef="double"><text>amount</text></inputExpression></input>
      <output id="ifms-gia-release_o0" label="Allowed" name="releaseAllowed" typeRef="boolean"/>
      <output id="ifms-gia-release_o1" label="Rule" name="ruleRef" typeRef="string"/>
      <rule id="ifms-gia-release_r0">
        <inputEntry id="ifms-gia-release_r0_i0"><text>true</text></inputEntry>
        <inputEntry id="ifms-gia-release_r0_i1"><text>&gt; 75</text></inputEntry>
        <inputEntry id="ifms-gia-release_r0_i2"><text>not("AUDITED")</text></inputEntry>
        <inputEntry id="ifms-gia-release_r0_i3"><text>-</text></inputEntry>
        <inputEntry id="ifms-gia-release_r0_i4"><text>-</text></inputEntry>
        <outputEntry id="ifms-gia-release_r0_o0"><text>false</text></outputEntry>
        <outputEntry id="ifms-gia-release_r0_o1"><text>"GFR 2017 r.238(2): above 75% needs UC and audited statement"</text></outputEntry>
      </rule>
      <rule id="ifms-gia-release_r1">
        <inputEntry id="ifms-gia-release_r1_i0"><text>true</text></inputEntry>
        <inputEntry id="ifms-gia-release_r1_i1"><text>-</text></inputEntry>
        <inputEntry id="ifms-gia-release_r1_i2"><text>not("PROVISIONAL","SUBMITTED","AUDITED")</text></inputEntry>
        <inputEntry id="ifms-gia-release_r1_i3"><text>-</text></inputEntry>
        <inputEntry id="ifms-gia-release_r1_i4"><text>-</text></inputEntry>
        <outputEntry id="ifms-gia-release_r1_o0"><text>false</text></outputEntry>
        <outputEntry id="ifms-gia-release_r1_o1"><text>"GFR 2017 r.238(2): provisional UC first"</text></outputEntry>
      </rule>
      <rule id="ifms-gia-release_r2"><description>warn</description>
        <inputEntry id="ifms-gia-release_r2_i0"><text>-</text></inputEntry>
        <inputEntry id="ifms-gia-release_r2_i1"><text>-</text></inputEntry>
        <inputEntry id="ifms-gia-release_r2_i2"><text>-</text></inputEntry>
        <inputEntry id="ifms-gia-release_r2_i3"><text>&gt; 0</text></inputEntry>
        <inputEntry id="ifms-gia-release_r2_i4"><text>-</text></inputEntry>
        <outputEntry id="ifms-gia-release_r2_o0"><text>true</text></outputEntry>
        <outputEntry id="ifms-gia-release_r2_o1"><text>"GFR 2017 r.230(7): unspent balance considered (net release)"</text></outputEntry>
      </rule>
      <rule id="ifms-gia-release_r3">
        <inputEntry id="ifms-gia-release_r3_i0"><text>-</text></inputEntry>
        <inputEntry id="ifms-gia-release_r3_i1"><text>-</text></inputEntry>
        <inputEntry id="ifms-gia-release_r3_i2"><text>-</text></inputEntry>
        <inputEntry id="ifms-gia-release_r3_i3"><text>-</text></inputEntry>
        <inputEntry id="ifms-gia-release_r3_i4"><text>-</text></inputEntry>
        <outputEntry id="ifms-gia-release_r3_o0"><text>true</text></outputEntry>
        <outputEntry id="ifms-gia-release_r3_o1"><text>"GFR 2017 r.230"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
