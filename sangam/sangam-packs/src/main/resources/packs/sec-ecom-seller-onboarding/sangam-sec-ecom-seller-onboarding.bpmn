<!-- Seller onboarding. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_sec_ecom_seller_onboardi" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.1">
  <process id="sangam-sec-ecom-seller-onboarding" name="Seller onboarding" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.1">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.ecom.seller-onboarding</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.1</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>sellerName,gstin,pan,category</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="es_start" name="Seller applies" operaton:initiator="initiator" operaton:formKey="sangam:sec-ecom-seller-onboarding/apply"></startEvent>
    <serviceTask id="es_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>sellerName=@supplierName;gstin=X;category=GENERAL;reviewSeat=SELLER-ONBOARDING</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="es_gst_clear" name="Clear the previous check result" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>gstActive=null</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="es_gst" name="Verify GSTIN" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>gst.verify</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>verify</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>gstin</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>gst</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="es_pan_clear" name="Clear the previous check result" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>panValid=null</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="es_pan" name="Verify PAN" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>pan.verify</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>verify</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>pan,sellerName</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>pan</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="es_bank_clear" name="Clear the previous check result" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>beneNameMatch=null</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="es_bank" name="Penny-drop bank account" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>bene.validate</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>lookup</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>bankAccount,ifsc,sellerName</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>bene</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="es_kycGw" name="KYC passed?" sangam:routingPolicy="priority" default="sec_ecom_seller_onboardi_f25"></exclusiveGateway>
    <userTask id="es_correct" name="Correct registration details" operaton:candidateGroups="${initiatorSeat}" operaton:formKey="sangam:sec-ecom-seller-onboarding/correct"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>es_correctDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="es_correct_gw" name="Resubmit?" default="sec_ecom_seller_onboardi_f14"></exclusiveGateway>
    <serviceTask id="es_correct_version" name="New case version" operaton:class="org.sangam.packs.core.CaseRecordDelegate"><extensionElements><operaton:field name="op"><operaton:string>RESUBMIT</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="es_correct_wd_kind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="es_correct_wd_call" name="Withdraw (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.1"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="es_correct_wd_end" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="es_rjGst_code" name="Reason: GST_NOT_CONFIRMED" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=GST_NOT_CONFIRMED</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="es_rjGst_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.1"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="es_rjGst_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="es_rjPan_code" name="Reason: PAN_NOT_CONFIRMED" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=PAN_NOT_CONFIRMED</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="es_rjPan_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.1"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="es_rjPan_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="es_rjBank_code" name="Reason: BENEFICIARY_NAME_NOT_CONFIRMED" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=BENEFICIARY_NAME_NOT_CONFIRMED</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="es_rjBank_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.1"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="es_rjBank_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <businessRuleTask id="es_docs" name="Category licences required (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-ecom-seller-docs</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <serviceTask id="es_review_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>es_review</operaton:string></operaton:field><operaton:field name="spec"><operaton:string>3WD</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="es_review" name="Review licences and agreement" operaton:candidateGroups="${reviewSeat}" operaton:formKey="sangam:sec-ecom-seller-onboarding/review" operaton:dueDate="${es_reviewDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>sellerDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="es_review_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>es_review</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>reviewSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="es_review_warnEnd" name="Warned"></endEvent>
    <serviceTask id="es_review_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>es_review</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>reviewSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>sellerDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="es_review_breachGw" name="Deemed?" default="sec_ecom_seller_onboardi_f31"></exclusiveGateway>
    <exclusiveGateway id="es_review_done" name=""></exclusiveGateway>
    <exclusiveGateway id="es_revGw" name="" default="sec_ecom_seller_onboardi_f40"></exclusiveGateway>
    <serviceTask id="es_group" name="Seller portal group" operaton:expression="${execution.setVariable('sellerGroup', 'external:'.concat(gstin))}"></serviceTask>
    <userTask id="es_portal" name="Upload requested documents" operaton:candidateGroups="${sellerGroup}" operaton:formKey="sangam:sec-ecom-seller-onboarding/portal"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <endEvent id="es_endRejected" name="Rejected (reasons given)"></endEvent>
    <userTask id="es_approve" name="Approve seller (checker)" operaton:candidateGroups="SELLER-APPROVER" operaton:formKey="sangam:sec-ecom-seller-onboarding/approve"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>approveDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="es_apGw" name="" default="sec_ecom_seller_onboardi_f43"></exclusiveGateway>
    <serviceTask id="es_create" name="Create seller account" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>marketplace.createSeller</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>create</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>sellerName,gstin</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>seller</operaton:string></operaton:field><operaton:field name="step"><operaton:string>create</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="es_publish" name="Publish seller profile and grievance officer" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>catalogue.publishSeller</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>publish</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>sellerName,grievanceOfficerName</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>profile</operaton:string></operaton:field><operaton:field name="step"><operaton:string>publish</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="es_end" name="Seller live"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="es_review_warn" name="SLA warning (75%)" attachedToRef="es_review" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${es_reviewWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="es_review_breach" name="SLA breached" attachedToRef="es_review" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${es_reviewDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="sec_ecom_seller_onboardi_f1" sourceRef="es_gst_clear" targetRef="es_gst"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f2" sourceRef="es_pan_clear" targetRef="es_pan"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f3" sourceRef="es_bank_clear" targetRef="es_bank"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f4" sourceRef="es_start" targetRef="es_defaults"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f5" sourceRef="es_defaults" targetRef="es_gst_clear"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f6" sourceRef="es_gst" targetRef="es_pan_clear"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f7" sourceRef="es_pan" targetRef="es_bank_clear"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f8" sourceRef="es_bank" targetRef="es_kycGw"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f9" sourceRef="es_correct" targetRef="es_correct_gw"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f10" name="resubmit" sourceRef="es_correct_gw" targetRef="es_correct_version"><conditionExpression xsi:type="tFormalExpression">${es_correctDecision == 'resubmit'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ecom_seller_onboardi_f11" sourceRef="es_correct_version" targetRef="es_gst_clear"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f12" sourceRef="es_correct_wd_kind" targetRef="es_correct_wd_call"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f13" sourceRef="es_correct_wd_call" targetRef="es_correct_wd_end"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f14" name="withdraw" sourceRef="es_correct_gw" targetRef="es_correct_wd_kind"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f15" sourceRef="es_rjGst_reject" targetRef="es_rjGst_endRejected"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f16" sourceRef="es_rjGst_code" targetRef="es_rjGst_reject"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f17" name="GSTIN not confirmed" sangam:priority="1" sourceRef="es_kycGw" targetRef="es_rjGst_code"><conditionExpression xsi:type="tFormalExpression">${gstStatus != 'COMPLETED' || gstActive == null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ecom_seller_onboardi_f18" sourceRef="es_rjPan_reject" targetRef="es_rjPan_endRejected"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f19" sourceRef="es_rjPan_code" targetRef="es_rjPan_reject"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f20" name="PAN not confirmed" sangam:priority="2" sourceRef="es_kycGw" targetRef="es_rjPan_code"><conditionExpression xsi:type="tFormalExpression">${panStatus != 'COMPLETED' || panValid == null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ecom_seller_onboardi_f21" sourceRef="es_rjBank_reject" targetRef="es_rjBank_endRejected"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f22" sourceRef="es_rjBank_code" targetRef="es_rjBank_reject"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f23" name="bank account not confirmed" sangam:priority="3" sourceRef="es_kycGw" targetRef="es_rjBank_code"><conditionExpression xsi:type="tFormalExpression">${beneStatus != 'COMPLETED' || beneNameMatch == null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ecom_seller_onboardi_f24" name="no" sangam:priority="4" sourceRef="es_kycGw" targetRef="es_correct"><conditionExpression xsi:type="tFormalExpression">${!gstActive || !panValid || !beneNameMatch}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ecom_seller_onboardi_f25" name="yes" sourceRef="es_kycGw" targetRef="es_docs"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f26" sourceRef="es_review_warn" targetRef="es_review_warnNotify"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f27" sourceRef="es_review_warnNotify" targetRef="es_review_warnEnd"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f28" sourceRef="es_review_breach" targetRef="es_review_breachAct"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f29" sourceRef="es_review_breachAct" targetRef="es_review_breachGw"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f30" name="deemed" sourceRef="es_review_breachGw" targetRef="es_review_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ecom_seller_onboardi_f31" name="escalated" sourceRef="es_review_breachGw" targetRef="es_review_slaPlan"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f32" sourceRef="es_review_slaPlan" targetRef="es_review"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f33" sourceRef="es_review" targetRef="es_review_done"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f34" sourceRef="es_docs" targetRef="es_review_slaPlan"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f35" sourceRef="es_review_done" targetRef="es_revGw"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f36" name="clarify" sourceRef="es_revGw" targetRef="es_group"><conditionExpression xsi:type="tFormalExpression">${sellerDecision == 'clarify'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ecom_seller_onboardi_f37" sourceRef="es_group" targetRef="es_portal"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f38" sourceRef="es_portal" targetRef="es_review_slaPlan"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f39" name="reject" sourceRef="es_revGw" targetRef="es_endRejected"><conditionExpression xsi:type="tFormalExpression">${sellerDecision == 'reject'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ecom_seller_onboardi_f40" name="accept" sourceRef="es_revGw" targetRef="es_approve"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f41" sourceRef="es_approve" targetRef="es_apGw"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f42" name="return" sourceRef="es_apGw" targetRef="es_review_slaPlan"><conditionExpression xsi:type="tFormalExpression">${approveDecision == 'return'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ecom_seller_onboardi_f43" name="approve" sourceRef="es_apGw" targetRef="es_create"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f44" sourceRef="es_create" targetRef="es_publish"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f45" sourceRef="es_publish" targetRef="es_end"/>
  </process>
  <bpmndi:BPMNDiagram id="sec_ecom_seller_onboardi_diagram">
    <bpmndi:BPMNPlane id="sec_ecom_seller_onboardi_plane" bpmnElement="sangam-sec-ecom-seller-onboarding">
      <bpmndi:BPMNShape id="es_start_di" bpmnElement="es_start"><dc:Bounds x="52" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="es_defaults_di" bpmnElement="es_defaults"><dc:Bounds x="185" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="es_gst_clear_di" bpmnElement="es_gst_clear"><dc:Bounds x="350" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="es_gst_di" bpmnElement="es_gst"><dc:Bounds x="515" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="es_pan_clear_di" bpmnElement="es_pan_clear"><dc:Bounds x="680" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="es_pan_di" bpmnElement="es_pan"><dc:Bounds x="845" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="es_bank_clear_di" bpmnElement="es_bank_clear"><dc:Bounds x="1010" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="es_bank_di" bpmnElement="es_bank"><dc:Bounds x="1175" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="es_kycGw_di" bpmnElement="es_kycGw"><dc:Bounds x="1365" y="45" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="es_correct_di" bpmnElement="es_correct"><dc:Bounds x="1505" y="155" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="es_correct_gw_di" bpmnElement="es_correct_gw"><dc:Bounds x="1695" y="170" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="es_correct_version_di" bpmnElement="es_correct_version"><dc:Bounds x="1835" y="280" width="100" height="80"/></bpmndi:BPMNShape>
