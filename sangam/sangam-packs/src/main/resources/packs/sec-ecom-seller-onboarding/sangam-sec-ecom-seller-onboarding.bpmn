<!-- Seller onboarding. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_sec_ecom_seller_onboardi" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <process id="sangam-sec-ecom-seller-onboarding" name="Seller onboarding" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.ecom.seller-onboarding</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>sellerName,gstin,pan,category</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="es_start" name="Seller applies" operaton:initiator="initiator" operaton:formKey="sangam:sec-ecom-seller-onboarding/apply"></startEvent>
    <serviceTask id="es_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>sellerName=@supplierName;gstin=X;category=GENERAL;gstActive=true;beneNameMatch=true;reviewSeat=SELLER-ONBOARDING</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="es_gst" name="Verify GSTIN" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>gst.verify</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>verify</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>gstin</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>gst</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="es_pan" name="Verify PAN" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>pan.verify</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>verify</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>pan,sellerName</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>pan</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="es_bank" name="Penny-drop bank account" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>bene.validate</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>lookup</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>bankAccount,ifsc,sellerName</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>bene</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="es_kycGw" name="KYC passed?" default="sec_ecom_seller_onboardi_f13"></exclusiveGateway>
    <userTask id="es_correct" name="Correct registration details" operaton:candidateGroups="${initiatorSeat}" operaton:formKey="sangam:sec-ecom-seller-onboarding/correct"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>es_correctDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="es_correct_gw" name="Resubmit?" default="sec_ecom_seller_onboardi_f11"></exclusiveGateway>
    <serviceTask id="es_correct_version" name="New case version" operaton:class="org.sangam.packs.core.CaseRecordDelegate"><extensionElements><operaton:field name="op"><operaton:string>RESUBMIT</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="es_correct_wd_kind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="es_correct_wd_call" name="Withdraw (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="es_correct_wd_end" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <businessRuleTask id="es_docs" name="Category licences required (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-ecom-seller-docs</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <serviceTask id="es_review_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>es_review</operaton:string></operaton:field><operaton:field name="spec"><operaton:string>3WD</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="es_review" name="Review licences and agreement" operaton:candidateGroups="${reviewSeat}" operaton:formKey="sangam:sec-ecom-seller-onboarding/review" operaton:dueDate="${es_reviewDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>sellerDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="es_review_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>es_review</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>reviewSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="es_review_warnEnd" name="Warned"></endEvent>
    <serviceTask id="es_review_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>es_review</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>reviewSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>sellerDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="es_review_breachGw" name="Deemed?" default="sec_ecom_seller_onboardi_f19"></exclusiveGateway>
    <exclusiveGateway id="es_review_done" name=""></exclusiveGateway>
    <exclusiveGateway id="es_revGw" name="" default="sec_ecom_seller_onboardi_f28"></exclusiveGateway>
    <serviceTask id="es_group" name="Seller portal group" operaton:expression="${execution.setVariable('sellerGroup', 'external:'.concat(gstin))}"></serviceTask>
    <userTask id="es_portal" name="Upload requested documents" operaton:candidateGroups="${sellerGroup}" operaton:formKey="sangam:sec-ecom-seller-onboarding/portal"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <endEvent id="es_endRejected" name="Rejected (reasons given)"></endEvent>
    <userTask id="es_approve" name="Approve seller (checker)" operaton:candidateGroups="SELLER-APPROVER" operaton:formKey="sangam:sec-ecom-seller-onboarding/approve"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>approveDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="es_apGw" name="" default="sec_ecom_seller_onboardi_f31"></exclusiveGateway>
    <serviceTask id="es_create" name="Create seller account" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>marketplace.createSeller</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>create</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>sellerName,gstin</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>seller</operaton:string></operaton:field><operaton:field name="step"><operaton:string>create</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="es_publish" name="Publish seller profile and grievance officer" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>catalogue.publishSeller</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>publish</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>sellerName,grievanceOfficerName</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>profile</operaton:string></operaton:field><operaton:field name="step"><operaton:string>publish</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="es_end" name="Seller live"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="es_review_warn" name="SLA warning (75%)" attachedToRef="es_review" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${es_reviewWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="es_review_breach" name="SLA breached" attachedToRef="es_review" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${es_reviewDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="sec_ecom_seller_onboardi_f1" sourceRef="es_start" targetRef="es_defaults"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f2" sourceRef="es_defaults" targetRef="es_gst"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f3" sourceRef="es_gst" targetRef="es_pan"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f4" sourceRef="es_pan" targetRef="es_bank"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f5" sourceRef="es_bank" targetRef="es_kycGw"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f6" sourceRef="es_correct" targetRef="es_correct_gw"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f7" name="resubmit" sourceRef="es_correct_gw" targetRef="es_correct_version"><conditionExpression xsi:type="tFormalExpression">${es_correctDecision == 'resubmit'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ecom_seller_onboardi_f8" sourceRef="es_correct_version" targetRef="es_gst"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f9" sourceRef="es_correct_wd_kind" targetRef="es_correct_wd_call"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f10" sourceRef="es_correct_wd_call" targetRef="es_correct_wd_end"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f11" name="withdraw" sourceRef="es_correct_gw" targetRef="es_correct_wd_kind"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f12" name="no" sourceRef="es_kycGw" targetRef="es_correct"><conditionExpression xsi:type="tFormalExpression">${!gstActive || !beneNameMatch}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ecom_seller_onboardi_f13" name="yes" sourceRef="es_kycGw" targetRef="es_docs"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f14" sourceRef="es_review_warn" targetRef="es_review_warnNotify"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f15" sourceRef="es_review_warnNotify" targetRef="es_review_warnEnd"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f16" sourceRef="es_review_breach" targetRef="es_review_breachAct"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f17" sourceRef="es_review_breachAct" targetRef="es_review_breachGw"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f18" name="deemed" sourceRef="es_review_breachGw" targetRef="es_review_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ecom_seller_onboardi_f19" name="escalated" sourceRef="es_review_breachGw" targetRef="es_review_slaPlan"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f20" sourceRef="es_review_slaPlan" targetRef="es_review"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f21" sourceRef="es_review" targetRef="es_review_done"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f22" sourceRef="es_docs" targetRef="es_review_slaPlan"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f23" sourceRef="es_review_done" targetRef="es_revGw"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f24" name="clarify" sourceRef="es_revGw" targetRef="es_group"><conditionExpression xsi:type="tFormalExpression">${sellerDecision == 'clarify'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ecom_seller_onboardi_f25" sourceRef="es_group" targetRef="es_portal"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f26" sourceRef="es_portal" targetRef="es_review_slaPlan"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f27" name="reject" sourceRef="es_revGw" targetRef="es_endRejected"><conditionExpression xsi:type="tFormalExpression">${sellerDecision == 'reject'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ecom_seller_onboardi_f28" name="accept" sourceRef="es_revGw" targetRef="es_approve"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f29" sourceRef="es_approve" targetRef="es_apGw"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f30" name="return" sourceRef="es_apGw" targetRef="es_review_slaPlan"><conditionExpression xsi:type="tFormalExpression">${approveDecision == 'return'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ecom_seller_onboardi_f31" name="approve" sourceRef="es_apGw" targetRef="es_create"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f32" sourceRef="es_create" targetRef="es_publish"/>
    <sequenceFlow id="sec_ecom_seller_onboardi_f33" sourceRef="es_publish" targetRef="es_end"/>
  </process>
  <bpmndi:BPMNDiagram id="sec_ecom_seller_onboardi_diagram">
