<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_p3_entitlement" name="P3 entitlement amount and instalments" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="p3-entitlement" name="P3 entitlement amount and instalments" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="p3-entitlement_t" hitPolicy="FIRST">
      <input id="p3-entitlement_i0" label="Scheme"><inputExpression id="p3-entitlement_ie0" typeRef="string"><text>schemeId</text></inputExpression></input>
      <input id="p3-entitlement_i1" label="Social category"><inputExpression id="p3-entitlement_ie1" typeRef="string"><text>socialCategory</text></inputExpression></input>
      <output id="p3-entitlement_o0" label="Entitlement (INR)" name="entitlement" typeRef="double"/>
      <output id="p3-entitlement_o1" label="Instalments" name="instalments" typeRef="integer"/>
      <rule id="p3-entitlement_r0"><description>three instalments of 2,000</description>
        <inputEntry id="p3-entitlement_r0_i0"><text>"PM-KISAN-LIKE"</text></inputEntry>
        <inputEntry id="p3-entitlement_r0_i1"><text>-</text></inputEntry>
        <outputEntry id="p3-entitlement_r0_o0"><text>6000</text></outputEntry>
        <outputEntry id="p3-entitlement_r0_o1"><text>3</text></outputEntry>
      </rule>
      <rule id="p3-entitlement_r1">
        <inputEntry id="p3-entitlement_r1_i0"><text>"HOUSING-GRANT"</text></inputEntry>
        <inputEntry id="p3-entitlement_r1_i1"><text>"SC"</text></inputEntry>
        <outputEntry id="p3-entitlement_r1_o0"><text>150000</text></outputEntry>
        <outputEntry id="p3-entitlement_r1_o1"><text>3</text></outputEntry>
      </rule>
      <rule id="p3-entitlement_r2">
        <inputEntry id="p3-entitlement_r2_i0"><text>"HOUSING-GRANT"</text></inputEntry>
        <inputEntry id="p3-entitlement_r2_i1"><text>"ST"</text></inputEntry>
        <outputEntry id="p3-entitlement_r2_o0"><text>150000</text></outputEntry>
        <outputEntry id="p3-entitlement_r2_o1"><text>3</text></outputEntry>
      </rule>
      <rule id="p3-entitlement_r3">
        <inputEntry id="p3-entitlement_r3_i0"><text>"HOUSING-GRANT"</text></inputEntry>
        <inputEntry id="p3-entitlement_r3_i1"><text>-</text></inputEntry>
        <outputEntry id="p3-entitlement_r3_o0"><text>120000</text></outputEntry>
        <outputEntry id="p3-entitlement_r3_o1"><text>3</text></outputEntry>
      </rule>
      <rule id="p3-entitlement_r4"><description>monthly</description>
        <inputEntry id="p3-entitlement_r4_i0"><text>"OLD-AGE-PENSION"</text></inputEntry>
        <inputEntry id="p3-entitlement_r4_i1"><text>-</text></inputEntry>
        <outputEntry id="p3-entitlement_r4_o0"><text>12000</text></outputEntry>
        <outputEntry id="p3-entitlement_r4_o1"><text>12</text></outputEntry>
      </rule>
      <rule id="p3-entitlement_r5"><description>default one-time grant</description>
        <inputEntry id="p3-entitlement_r5_i0"><text>-</text></inputEntry>
        <inputEntry id="p3-entitlement_r5_i1"><text>-</text></inputEntry>
        <outputEntry id="p3-entitlement_r5_o0"><text>25000</text></outputEntry>
        <outputEntry id="p3-entitlement_r5_o1"><text>1</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
