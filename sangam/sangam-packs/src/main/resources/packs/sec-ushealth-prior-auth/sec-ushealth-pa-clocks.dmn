<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_sec_ushealth_pa_clocks" name="Prior authorization decision timeframes (CMS-0057-F; tenant overridable)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <!-- US-HLT-055/056/057, US-HLT-103. Override per tenant or state law. -->
  <decision id="sec-ushealth-pa-clocks" name="Prior authorization decision timeframes (CMS-0057-F; tenant overridable)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="sec-ushealth-pa-clocks_t" hitPolicy="FIRST">
      <input id="sec-ushealth-pa-clocks_i0" label="Payer program"><inputExpression id="sec-ushealth-pa-clocks_ie0" typeRef="string"><text>payerProgram</text></inputExpression></input>
      <input id="sec-ushealth-pa-clocks_i1" label="Priority"><inputExpression id="sec-ushealth-pa-clocks_ie1" typeRef="string"><text>priority</text></inputExpression></input>
      <output id="sec-ushealth-pa-clocks_o0" label="Decision due within" name="paDecisionSpec" typeRef="string"/>
      <output id="sec-ushealth-pa-clocks_o1" label="Appeal decision due within" name="paAppealSpec" typeRef="string"/>
      <rule id="sec-ushealth-pa-clocks_r0"><description>45 CFR 147.136 urgent; 0057-F clocks do not apply</description>
        <inputEntry id="sec-ushealth-pa-clocks_r0_i0"><text>"QHP_FFE"</text></inputEntry>
        <inputEntry id="sec-ushealth-pa-clocks_r0_i1"><text>"EXPEDITED"</text></inputEntry>
        <outputEntry id="sec-ushealth-pa-clocks_r0_o0"><text>"72H"</text></outputEntry>
        <outputEntry id="sec-ushealth-pa-clocks_r0_o1"><text>"72H"</text></outputEntry>
      </rule>
      <rule id="sec-ushealth-pa-clocks_r1"><description>29 CFR 2560.503-1 pre-service (verify plan)</description>
        <inputEntry id="sec-ushealth-pa-clocks_r1_i0"><text>"QHP_FFE"</text></inputEntry>
        <inputEntry id="sec-ushealth-pa-clocks_r1_i1"><text>-</text></inputEntry>
        <outputEntry id="sec-ushealth-pa-clocks_r1_o0"><text>"15D"</text></outputEntry>
        <outputEntry id="sec-ushealth-pa-clocks_r1_o1"><text>"30D"</text></outputEntry>
      </rule>
      <rule id="sec-ushealth-pa-clocks_r2"><description>ACA urgent</description>
        <inputEntry id="sec-ushealth-pa-clocks_r2_i0"><text>"COMMERCIAL"</text></inputEntry>
        <inputEntry id="sec-ushealth-pa-clocks_r2_i1"><text>"EXPEDITED"</text></inputEntry>
        <outputEntry id="sec-ushealth-pa-clocks_r2_o0"><text>"72H"</text></outputEntry>
        <outputEntry id="sec-ushealth-pa-clocks_r2_o1"><text>"72H"</text></outputEntry>
      </rule>
      <rule id="sec-ushealth-pa-clocks_r3"><description>ACA pre-service</description>
        <inputEntry id="sec-ushealth-pa-clocks_r3_i0"><text>"COMMERCIAL"</text></inputEntry>
        <inputEntry id="sec-ushealth-pa-clocks_r3_i1"><text>-</text></inputEntry>
        <outputEntry id="sec-ushealth-pa-clocks_r3_o0"><text>"15D"</text></outputEntry>
        <outputEntry id="sec-ushealth-pa-clocks_r3_o1"><text>"30D"</text></outputEntry>
      </rule>
      <rule id="sec-ushealth-pa-clocks_r4"><description>MA / Medicaid / CHIP expedited (42 CFR 422.572, 438.210)</description>
        <inputEntry id="sec-ushealth-pa-clocks_r4_i0"><text>-</text></inputEntry>
        <inputEntry id="sec-ushealth-pa-clocks_r4_i1"><text>"EXPEDITED"</text></inputEntry>
        <outputEntry id="sec-ushealth-pa-clocks_r4_o0"><text>"72H"</text></outputEntry>
        <outputEntry id="sec-ushealth-pa-clocks_r4_o1"><text>"72H"</text></outputEntry>
      </rule>
      <rule id="sec-ushealth-pa-clocks_r5"><description>MA / Medicaid / CHIP standard 7 calendar days from 2026 (422.568)</description>
        <inputEntry id="sec-ushealth-pa-clocks_r5_i0"><text>-</text></inputEntry>
        <inputEntry id="sec-ushealth-pa-clocks_r5_i1"><text>-</text></inputEntry>
        <outputEntry id="sec-ushealth-pa-clocks_r5_o0"><text>"7D"</text></outputEntry>
        <outputEntry id="sec-ushealth-pa-clocks_r5_o1"><text>"30D"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
