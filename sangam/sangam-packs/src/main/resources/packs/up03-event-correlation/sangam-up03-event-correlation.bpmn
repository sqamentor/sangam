      <bpmndi:BPMNEdge id="up03_event_correlation_f5_di" bpmnElement="up03_event_correlation_f5"><di:waypoint x="755" y="70"/><di:waypoint x="816" y="70"/><di:waypoint x="816" y="195"/><di:waypoint x="877" y="195"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="up03_event_correlation_f6_di" bpmnElement="up03_event_correlation_f6"><di:waypoint x="913" y="195"/><di:waypoint x="1010" y="195"/></bpmndi:BPMNEdge>
