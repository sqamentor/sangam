      <bpmndi:BPMNShape id="u3_endQuiet_di" bpmnElement="u3_endQuiet"><dc:Bounds x="1372" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="up03_event_correlation_f1_di" bpmnElement="up03_event_correlation_f1"><di:waypoint x="88" y="70"/><di:waypoint x="185" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="up03_event_correlation_f2_di" bpmnElement="up03_event_correlation_f2"><di:waypoint x="285" y="70"/><di:waypoint x="350" y="70"/></bpmndi:BPMNEdge>
