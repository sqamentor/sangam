      <bpmndi:BPMNShape id="u3_wait_di" bpmnElement="u3_wait"><dc:Bounds x="705" y="45" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="u3_next_di" bpmnElement="u3_next"><dc:Bounds x="877" y="177" width="36" height="36"/></bpmndi:BPMNShape>
