<!-- UP-03 Event correlation window. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_up03_event_correlation" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_event_first" name="sangam.event.first"/>
  <message id="msg_sangam_event_next" name="sangam.event.next"/>
  <process id="sangam-up03-event-correlation" name="UP-03 Event correlation window" isExecutable="true" operaton:historyTimeToLive="90" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>universal.up03-event-correlation</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>eventType</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="u3_start" name="First event"><messageEventDefinition messageRef="msg_sangam_event_first"/></startEvent>
    <serviceTask id="u3_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>windowSize=PT15M;threshold=3;lateEventPolicy=DROP</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="u3_window" name="Open window" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>window</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${windowSize}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <serviceTask id="u3_add" name="Add event (dedupe, bounded)" operaton:class="org.sangam.packs.universal.EventWindowDelegate"><extensionElements><operaton:field name="op"><operaton:string>ADD</operaton:string></operaton:field></extensionElements></serviceTask>
    <eventBasedGateway id="u3_wait" name="Next event or window end"></eventBasedGateway>
    <intermediateCatchEvent id="u3_next" name="Next event (same key)"><messageEventDefinition messageRef="msg_sangam_event_next"/></intermediateCatchEvent>
    <serviceTask id="u3_add2" name="Add event" operaton:class="org.sangam.packs.universal.EventWindowDelegate"><extensionElements><operaton:field name="op"><operaton:string>ADD</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="u3_eval" name="Evaluate threshold" operaton:class="org.sangam.packs.universal.EventWindowDelegate"><extensionElements><operaton:field name="op"><operaton:string>EVALUATE</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="u3_gw" name="Threshold?" default="up03_event_correlation_f10"></exclusiveGateway>
    <userTask id="u3_review" name="Review correlated signal" operaton:candidateGroups="ANALYST" operaton:formKey="sangam:up03-event-correlation/review"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>signalDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <endEvent id="u3_endReviewed" name="Reviewed"></endEvent>
    <intermediateCatchEvent id="u3_close" name="Window ends"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${windowDueAt}</timeDate></timerEventDefinition></intermediateCatchEvent>
    <serviceTask id="u3_eval2" name="Final evaluation" operaton:class="org.sangam.packs.universal.EventWindowDelegate"><extensionElements><operaton:field name="op"><operaton:string>EVALUATE</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="u3_gw2" name="Threshold?" default="up03_event_correlation_f16"></exclusiveGateway>
    <endEvent id="u3_endQuiet" name="Window closed below threshold"></endEvent>
    <sequenceFlow id="up03_event_correlation_f1" sourceRef="u3_start" targetRef="u3_defaults"/>
    <sequenceFlow id="up03_event_correlation_f2" sourceRef="u3_defaults" targetRef="u3_window"/>
    <sequenceFlow id="up03_event_correlation_f3" sourceRef="u3_window" targetRef="u3_add"/>
    <sequenceFlow id="up03_event_correlation_f4" sourceRef="u3_add" targetRef="u3_wait"/>
    <sequenceFlow id="up03_event_correlation_f5" sourceRef="u3_wait" targetRef="u3_next"/>
    <sequenceFlow id="up03_event_correlation_f6" sourceRef="u3_next" targetRef="u3_add2"/>
    <sequenceFlow id="up03_event_correlation_f7" sourceRef="u3_add2" targetRef="u3_eval"/>
    <sequenceFlow id="up03_event_correlation_f8" sourceRef="u3_eval" targetRef="u3_gw"/>
    <sequenceFlow id="up03_event_correlation_f9" name="not yet" sourceRef="u3_gw" targetRef="u3_wait"><conditionExpression xsi:type="tFormalExpression">${!thresholdReached}</conditionExpression></sequenceFlow>
    <sequenceFlow id="up03_event_correlation_f10" name="reached" sourceRef="u3_gw" targetRef="u3_review"/>
    <sequenceFlow id="up03_event_correlation_f11" sourceRef="u3_review" targetRef="u3_endReviewed"/>
    <sequenceFlow id="up03_event_correlation_f12" sourceRef="u3_wait" targetRef="u3_close"/>
    <sequenceFlow id="up03_event_correlation_f13" sourceRef="u3_close" targetRef="u3_eval2"/>
    <sequenceFlow id="up03_event_correlation_f14" sourceRef="u3_eval2" targetRef="u3_gw2"/>
    <sequenceFlow id="up03_event_correlation_f15" name="reached" sourceRef="u3_gw2" targetRef="u3_review"><conditionExpression xsi:type="tFormalExpression">${thresholdReached}</conditionExpression></sequenceFlow>
    <sequenceFlow id="up03_event_correlation_f16" name="no" sourceRef="u3_gw2" targetRef="u3_endQuiet"/>
  </process>
  <bpmndi:BPMNDiagram id="up03_event_correlation_diagram">
    <bpmndi:BPMNPlane id="up03_event_correlation_plane" bpmnElement="sangam-up03-event-correlation">
