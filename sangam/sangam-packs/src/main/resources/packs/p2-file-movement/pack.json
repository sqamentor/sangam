  "acceptance": [
    {
      "id": "AC-04",
      "title": "Up three levels, back two, resubmitted, approved; acted-for shown",
      "refs": [
        "T15",
        "T17"
      ],
      "given": "chain SO-B2 > US-B > DS-B, DS on leave with JS-1 on additional charge",
      "when": "DS-B returns to level 1; file goes up again; JS-1 approves as DS-B",
      "then": "CASE_RETURNED, CASE_RESUBMITTED, ACTED_FOR with the additional-charge order; dispatch; closed",
      "startVariables": {
        "fileNo": "B-2/14/2026-Estt",
        "subject": "Sanction of honorarium",
        "subjectHead": "ESTABLISHMENT",
        "noting": "Proposal for approval.",
        "draftLetter": "Draft order.",
        "actingSeat": "DA-B2",
        "initiator": "p2.da",
        "officeId": "SEC-B2"
      },
      "expectState": "CLOSED"
    },
    {
      "id": "J-P2-E04",
      "title": "Additional-charge holder who noted lower down cannot decide",
      "refs": [
        "T17"
      ],
      "given": "p2.us noted as US-B and holds DS-B on additional charge",
      "when": "p2.us tries to approve as DS-B",
      "then": "422 SOD_VIOLATION; SOD_VIOLATION_BLOCKED",
      "startVariables": {
        "fileNo": "B-2/14/2026-Estt",
        "subject": "Sanction of honorarium",
        "subjectHead": "ESTABLISHMENT",
        "noting": "Proposal for approval.",
