<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- Bill of one consumer. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_sec_util_bill" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_util_billDispute" name="sangam.util.billDispute"/>
  <message id="msg_sangam_util_paid" name="sangam.util.paid"/>
  <process id="sangam-sec-util-bill" name="Bill of one consumer" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.util.meter-to-cash</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>key</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="bl_start" name="Consumer in the cycle"></startEvent>
    <serviceTask id="bl_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>units=100;readStatus=NORMAL;tariffCategory=DOMESTIC;applicantRef=@key;billingSeat=BILLING-CLERK;dueSpec=15D</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="bl_read" name="Meter read" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>mdm.read</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>read</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>key</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>read</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="bl_readGw" name="Read valid?" default="sec_util_bill_f5"></exclusiveGateway>
    <userTask id="bl_exception" name="Resolve read exception (provisional bill if meter defective)" operaton:candidateGroups="${billingSeat}" operaton:formKey="sangam:sec-util-meter-to-cash/exception"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <businessRuleTask id="bl_tariff" name="Tariff (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-util-tariff</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <serviceTask id="bl_compute" name="Bill amount" operaton:expression="${execution.setVariable('billAmount', fixedCharge + units * energyRate)}"></serviceTask>
    <serviceTask id="bl_bill" name="Generate and deliver bill" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>billing.generate</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>bill</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>key,units,billAmount</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>bill</operaton:string></operaton:field><operaton:field name="step"><operaton:string>bill</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="bl_due" name="Regulatory clock: payment" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>payment</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${dueSpec}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <eventBasedGateway id="bl_wait" name="Paid, disputed or due date"></eventBasedGateway>
    <intermediateCatchEvent id="bl_paid" name="Payment received"><messageEventDefinition messageRef="msg_sangam_util_paid"/></intermediateCatchEvent>
    <intermediateCatchEvent id="bl_dispute" name="Bill disputed"><messageEventDefinition messageRef="msg_sangam_util_billDispute"/></intermediateCatchEvent>
    <intermediateCatchEvent id="bl_overdue" name="Due date passed"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${paymentDueAt}</timeDate></timerEventDefinition></intermediateCatchEvent>
    <endEvent id="bl_end" name="Paid"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <userTask id="bl_revise" name="Examine dispute and revise bill" operaton:candidateGroups="${billingSeat}" operaton:formKey="sangam:sec-util-meter-to-cash/dispute"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>disputeDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="bl_revGw" name="" default="sec_util_bill_f19"></exclusiveGateway>
    <serviceTask id="bl_reviseBill" name="Issue revised bill" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>billing.revise</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>revise</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>key,units</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>rev</operaton:string></operaton:field><operaton:field name="step"><operaton:string>revise</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="bl_disconnect" name="Hand over to disconnection (notice case)" operaton:class="org.sangam.packs.core.LinkedInstanceDelegate"><extensionElements><operaton:field name="processKey"><operaton:string>sangam-sec-util-disconnection</operaton:string></operaton:field><operaton:field name="linkType"><operaton:string>non-payment</operaton:string></operaton:field><operaton:field name="inherit"><operaton:string>key,billAmount,applicantRef</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="bl_endOverdue" name="Overdue: disconnection case opened"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>OVERDUE</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <sequenceFlow id="sec_util_bill_f1" sourceRef="bl_start" targetRef="bl_defaults"/>
    <sequenceFlow id="sec_util_bill_f2" sourceRef="bl_defaults" targetRef="bl_read"/>
    <sequenceFlow id="sec_util_bill_f3" sourceRef="bl_read" targetRef="bl_readGw"/>
    <sequenceFlow id="sec_util_bill_f4" name="zero / abnormal / defective" sourceRef="bl_readGw" targetRef="bl_exception"><conditionExpression xsi:type="tFormalExpression">${readStatus != 'NORMAL'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_util_bill_f5" name="normal" sourceRef="bl_readGw" targetRef="bl_tariff"/>
    <sequenceFlow id="sec_util_bill_f6" sourceRef="bl_exception" targetRef="bl_tariff"/>
    <sequenceFlow id="sec_util_bill_f7" sourceRef="bl_tariff" targetRef="bl_compute"/>
    <sequenceFlow id="sec_util_bill_f8" sourceRef="bl_compute" targetRef="bl_bill"/>
    <sequenceFlow id="sec_util_bill_f9" sourceRef="bl_bill" targetRef="bl_due"/>
    <sequenceFlow id="sec_util_bill_f10" sourceRef="bl_due" targetRef="bl_wait"/>
    <sequenceFlow id="sec_util_bill_f11" sourceRef="bl_wait" targetRef="bl_paid"/>
    <sequenceFlow id="sec_util_bill_f12" sourceRef="bl_wait" targetRef="bl_dispute"/>
    <sequenceFlow id="sec_util_bill_f13" sourceRef="bl_wait" targetRef="bl_overdue"/>
    <sequenceFlow id="sec_util_bill_f14" sourceRef="bl_paid" targetRef="bl_end"/>
    <sequenceFlow id="sec_util_bill_f15" sourceRef="bl_dispute" targetRef="bl_revise"/>
    <sequenceFlow id="sec_util_bill_f16" sourceRef="bl_revise" targetRef="bl_revGw"/>
    <sequenceFlow id="sec_util_bill_f17" name="upheld" sourceRef="bl_revGw" targetRef="bl_reviseBill"><conditionExpression xsi:type="tFormalExpression">${disputeDecision == 'customer'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_util_bill_f18" sourceRef="bl_reviseBill" targetRef="bl_due"/>
    <sequenceFlow id="sec_util_bill_f19" name="bill correct" sourceRef="bl_revGw" targetRef="bl_wait"/>
    <sequenceFlow id="sec_util_bill_f20" sourceRef="bl_overdue" targetRef="bl_disconnect"/>
    <sequenceFlow id="sec_util_bill_f21" sourceRef="bl_disconnect" targetRef="bl_endOverdue"/>
  </process>
