    <sequenceFlow id="sec_util_billing_cycle_f3" sourceRef="bc_fanOut" targetRef="bc_fanGw"/>
    <sequenceFlow id="sec_util_billing_cycle_f4" name="next chunk" sourceRef="bc_fanGw" targetRef="bc_fanOut"><conditionExpression xsi:type="tFormalExpression">${!fanOutDone}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_util_billing_cycle_f5" name="all started" sourceRef="bc_fanGw" targetRef="bc_poll"/>
    <sequenceFlow id="sec_util_billing_cycle_f6" sourceRef="bc_poll" targetRef="bc_aggregate"/>
    <sequenceFlow id="sec_util_billing_cycle_f7" sourceRef="bc_aggregate" targetRef="bc_doneGw"/>
    <sequenceFlow id="sec_util_billing_cycle_f8" name="not yet" sourceRef="bc_doneGw" targetRef="bc_poll"><conditionExpression xsi:type="tFormalExpression">${!batchComplete}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_util_billing_cycle_f9" sourceRef="bc_load" targetRef="bc_open"/>
    <sequenceFlow id="sec_util_billing_cycle_f10" name="complete" sourceRef="bc_doneGw" targetRef="bc_end"/>
  </process>
