    <sequenceFlow id="sec_health_transfusion_f8" name="yes" sourceRef="tf_reactGw" targetRef="tf_hvpi"><conditionExpression xsi:type="tFormalExpression">${reaction}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_health_transfusion_f9" name="no" sourceRef="tf_reactGw" targetRef="tf_end"/>
