<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_ifms_scheme_powers" name="Delegated powers by role" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <!-- Delegated powers for SCHEME (SL-31). UNVERIFIED: the corpus verifies the appraisal forum by outlay (IFC-080) but not the approval thresholds (Secretary / Minister / FM / Cabinet are not modelled, IFMS-CENTRAL gap 7); confirm from DFPR App. III and deploy it as a tenant DMN override -->
  <decision id="ifms-scheme-powers" name="Delegated powers by role" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="ifms-scheme-powers_t" hitPolicy="FIRST">
      <input id="ifms-scheme-powers_i0" label="Seat role"><inputExpression id="ifms-scheme-powers_ie0" typeRef="string"><text>seatRole</text></inputExpression></input>
      <input id="ifms-scheme-powers_i1" label="Case type"><inputExpression id="ifms-scheme-powers_ie1" typeRef="string"><text>caseType</text></inputExpression></input>
      <output id="ifms-scheme-powers_o0" label="Power limit (INR)" name="powerLimit" typeRef="number"/>
      <output id="ifms-scheme-powers_o1" label="Allowed" name="allowed" typeRef="boolean"/>
      <rule id="ifms-scheme-powers_r0"><description>Secretary approves schemes up to 100 cr (ladder ifms-scheme-appraisal)</description>
        <inputEntry id="ifms-scheme-powers_r0_i0"><text>"CAA"</text></inputEntry>
        <inputEntry id="ifms-scheme-powers_r0_i1"><text>"SCHEME"</text></inputEntry>
        <outputEntry id="ifms-scheme-powers_r0_o0"><text>1000000000</text></outputEntry>
        <outputEntry id="ifms-scheme-powers_r0_o1"><text>true</text></outputEntry>
      </rule>
      <rule id="ifms-scheme-powers_r1"><description>no delegated power</description>
        <inputEntry id="ifms-scheme-powers_r1_i0"><text>-</text></inputEntry>
        <inputEntry id="ifms-scheme-powers_r1_i1"><text>-</text></inputEntry>
        <outputEntry id="ifms-scheme-powers_r1_o0"><text>0</text></outputEntry>
        <outputEntry id="ifms-scheme-powers_r1_o1"><text>false</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
