  <process id="sangam-ifms-scheme-appraisal" name="Scheme appraisal" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.ifms.scheme-appraisal</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>schemeName,totalOutlay</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="sa_start" name="Proposal (DPR / memo)" operaton:initiator="initiator" operaton:formKey="sangam:ifms-scheme-appraisal/proposal"></startEvent>
    <serviceTask id="sa_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>totalOutlay=0;amount=0;faSeat=FA-1;committeeSeats=FA-1,SECY-1;quorumRule=MAJORITY;committeeWindow=P10D;caseType=SCHEME;routingDecisionKey=ifms-scheme-approval;powersDecisionKey=ifms-scheme-powers;scrutinySeat=FA-1;outputTemplate=scheme-approval;appealAllowed=false;appraisalForum=FA</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="sa_ladder" name="Appraisal forum and approval authority (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>ifms-scheme-appraisal</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <serviceTask id="sa_amount" name="Amount" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>amount=@totalOutlay</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="sa_comments_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>sa_comments</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>20WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="sa_comments" name="Comments of DoE / NITI / ministries" operaton:candidateGroups="${faSeat}" operaton:formKey="sangam:ifms-scheme-appraisal/comments" operaton:dueDate="${sa_commentsDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>commentsDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="sa_comments_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>sa_comments</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>faSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="sa_comments_warnEnd" name="Warned"></endEvent>
    <serviceTask id="sa_comments_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>sa_comments</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>faSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>commentsDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="sa_comments_breachGw" name="Deemed?" default="ifms_scheme_appraisal_f9"></exclusiveGateway>
    <exclusiveGateway id="sa_comments_done" name=""></exclusiveGateway>
    <exclusiveGateway id="sa_forumGw" name="Committee (SFC / EFC)?" default="ifms_scheme_appraisal_f15"></exclusiveGateway>
    <callActivity id="sa_committee" name="Appraisal committee (core)" calledElement="sangam-core-committee"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <callActivity id="sa_sanction" name="Approval by the authority (core)" calledElement="sangam-core-sanction"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <callActivity id="sa_rj_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="sa_rj_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <callActivity id="sa_close" name="Approval order (core closure)" calledElement="sangam-core-closure"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <exclusiveGateway id="sa_sanGw" name="sanctionOutcome?" default="ifms_scheme_appraisal_f19"></exclusiveGateway>
    <endEvent id="sa_end" name="Closed"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="sa_comments_warn" name="SLA warning (75%)" attachedToRef="sa_comments" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${sa_commentsWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="sa_comments_breach" name="SLA breached" attachedToRef="sa_comments" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${sa_commentsDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="ifms_scheme_appraisal_f1" sourceRef="sa_start" targetRef="sa_defaults"/>
    <sequenceFlow id="ifms_scheme_appraisal_f2" sourceRef="sa_defaults" targetRef="sa_ladder"/>
    <sequenceFlow id="ifms_scheme_appraisal_f3" sourceRef="sa_ladder" targetRef="sa_amount"/>
    <sequenceFlow id="ifms_scheme_appraisal_f4" sourceRef="sa_comments_warn" targetRef="sa_comments_warnNotify"/>
    <sequenceFlow id="ifms_scheme_appraisal_f5" sourceRef="sa_comments_warnNotify" targetRef="sa_comments_warnEnd"/>
    <sequenceFlow id="ifms_scheme_appraisal_f6" sourceRef="sa_comments_breach" targetRef="sa_comments_breachAct"/>
    <sequenceFlow id="ifms_scheme_appraisal_f7" sourceRef="sa_comments_breachAct" targetRef="sa_comments_breachGw"/>
    <sequenceFlow id="ifms_scheme_appraisal_f8" name="deemed" sourceRef="sa_comments_breachGw" targetRef="sa_comments_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_scheme_appraisal_f9" name="escalated" sourceRef="sa_comments_breachGw" targetRef="sa_comments_slaPlan"/>
    <sequenceFlow id="ifms_scheme_appraisal_f10" sourceRef="sa_comments_slaPlan" targetRef="sa_comments"/>
    <sequenceFlow id="ifms_scheme_appraisal_f11" sourceRef="sa_comments" targetRef="sa_comments_done"/>
    <sequenceFlow id="ifms_scheme_appraisal_f12" sourceRef="sa_amount" targetRef="sa_comments_slaPlan"/>
    <sequenceFlow id="ifms_scheme_appraisal_f13" sourceRef="sa_comments_done" targetRef="sa_forumGw"/>
    <sequenceFlow id="ifms_scheme_appraisal_f14" name="committee" sourceRef="sa_forumGw" targetRef="sa_committee"><conditionExpression xsi:type="tFormalExpression">${appraisalForum != 'FA'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_scheme_appraisal_f15" name="FA appraisal" sourceRef="sa_forumGw" targetRef="sa_sanction"/>
    <sequenceFlow id="ifms_scheme_appraisal_f16" sourceRef="sa_committee" targetRef="sa_sanction"/>
    <sequenceFlow id="ifms_scheme_appraisal_f17" sourceRef="sa_rj_reject" targetRef="sa_rj_endRejected"/>
    <sequenceFlow id="ifms_scheme_appraisal_f18" name="SANCTIONED" sourceRef="sa_sanGw" targetRef="sa_close"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_scheme_appraisal_f19" name="otherwise" sourceRef="sa_sanGw" targetRef="sa_rj_reject"/>
    <sequenceFlow id="ifms_scheme_appraisal_f20" sourceRef="sa_sanction" targetRef="sa_sanGw"/>
    <sequenceFlow id="ifms_scheme_appraisal_f21" sourceRef="sa_close" targetRef="sa_end"/>
    <subProcess id="sa_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="sa_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="sa_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="sa_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="sa_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="ifms_scheme_appraisal_f22" sourceRef="sa_withdrawStart" targetRef="sa_withdrawKind"/>
      <sequenceFlow id="ifms_scheme_appraisal_f23" sourceRef="sa_withdrawKind" targetRef="sa_withdrawCall"/>
      <sequenceFlow id="ifms_scheme_appraisal_f24" sourceRef="sa_withdrawCall" targetRef="sa_withdrawEnd"/>
    </subProcess>
    <subProcess id="sa_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="sa_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="sa_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="sa_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="sa_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="ifms_scheme_appraisal_f25" sourceRef="sa_cancelStart" targetRef="sa_cancelKind"/>
      <sequenceFlow id="ifms_scheme_appraisal_f26" sourceRef="sa_cancelKind" targetRef="sa_cancelCall"/>
      <sequenceFlow id="ifms_scheme_appraisal_f27" sourceRef="sa_cancelCall" targetRef="sa_cancelEnd"/>
    </subProcess>
  </process>
