<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_ifms_surrender_powers" name="Delegated powers by role" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <!-- Delegated powers for SURRENDER (SL-31). UNVERIFIED: GFR 62(1)-(2) (corpus IFC-069) requires the surrender but does not name the CAA as the approving authority; confirm from the delegation order and deploy it as a tenant DMN override -->
  <decision id="ifms-surrender-powers" name="Delegated powers by role" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="ifms-surrender-powers_t" hitPolicy="FIRST">
      <input id="ifms-surrender-powers_i0" label="Seat role"><inputExpression id="ifms-surrender-powers_ie0" typeRef="string"><text>seatRole</text></inputExpression></input>
      <input id="ifms-surrender-powers_i1" label="Case type"><inputExpression id="ifms-surrender-powers_ie1" typeRef="string"><text>caseType</text></inputExpression></input>
      <output id="ifms-surrender-powers_o0" label="Power limit (INR)" name="powerLimit" typeRef="number"/>
      <output id="ifms-surrender-powers_o1" label="Allowed" name="allowed" typeRef="boolean"/>
      <output id="ifms-surrender-powers_o2" label="No monetary limit" name="noMonetaryLimit" typeRef="boolean"/>
      <rule id="ifms-surrender-powers_r0"><description>surrender of savings to the Finance Ministry, GFR 2017 r.62(1)-(2) (pack default)</description>
        <inputEntry id="ifms-surrender-powers_r0_i0"><text>"CAA"</text></inputEntry>
        <inputEntry id="ifms-surrender-powers_r0_i1"><text>"SURRENDER"</text></inputEntry>
        <outputEntry id="ifms-surrender-powers_r0_o0"><text>null</text></outputEntry>
        <outputEntry id="ifms-surrender-powers_r0_o1"><text>true</text></outputEntry>
        <outputEntry id="ifms-surrender-powers_r0_o2"><text>true</text></outputEntry>
      </rule>
      <rule id="ifms-surrender-powers_r1"><description>no delegated power</description>
        <inputEntry id="ifms-surrender-powers_r1_i0"><text>-</text></inputEntry>
        <inputEntry id="ifms-surrender-powers_r1_i1"><text>-</text></inputEntry>
        <outputEntry id="ifms-surrender-powers_r1_o0"><text>0</text></outputEntry>
        <outputEntry id="ifms-surrender-powers_r1_o1"><text>false</text></outputEntry>
        <outputEntry id="ifms-surrender-powers_r1_o2"><text>false</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
