    <sequenceFlow id="intl_pfm_execution_f1" sourceRef="pe_available_clear" targetRef="pe_available"/>
    <sequenceFlow id="intl_pfm_execution_f2" sourceRef="pe_start" targetRef="pe_defaults"/>
    <sequenceFlow id="intl_pfm_execution_f3" sourceRef="pe_defaults" targetRef="pe_available_clear"/>
    <sequenceFlow id="intl_pfm_execution_f4" sourceRef="pe_available" targetRef="pe_fundsGw"/>
    <sequenceFlow id="intl_pfm_execution_f5" sourceRef="pe_rjFunds_reject" targetRef="pe_rjFunds_endRejected"/>
    <sequenceFlow id="intl_pfm_execution_f6" sourceRef="pe_rjFunds_code" targetRef="pe_rjFunds_reject"/>
    <sequenceFlow id="intl_pfm_execution_f7" name="authority not confirmed" sourceRef="pe_fundsGw" targetRef="pe_rjFunds_code"><conditionExpression xsi:type="tFormalExpression">${fundsStatus != 'COMPLETED' || fundsAvailable == null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_execution_f8" name="short of authority" sourceRef="pe_fundsGw" targetRef="pe_breach"><conditionExpression xsi:type="tFormalExpression">${fundsStatus == 'COMPLETED' &amp;&amp; fundsAvailable != null &amp;&amp; (fundsAvailable &lt; amount)}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_execution_f9" sourceRef="pe_breach" targetRef="pe_endBreach"/>
    <sequenceFlow id="intl_pfm_execution_f10" name="available" sourceRef="pe_fundsGw" targetRef="pe_scrutiny"/>
    <sequenceFlow id="intl_pfm_execution_f11" sourceRef="pe_rj_reject" targetRef="pe_rj_endRejected"/>
    <sequenceFlow id="intl_pfm_execution_f12" name="ACCEPTED" sourceRef="pe_scGw" targetRef="pe_commitPrepareGw"><conditionExpression xsi:type="tFormalExpression">${scrutinyOutcome == 'ACCEPTED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_execution_f13" name="LAPSED" sourceRef="pe_scGw" targetRef="pe_scGw_lapsedReason"><conditionExpression xsi:type="tFormalExpression">${scrutinyOutcome == 'LAPSED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_execution_f14" sourceRef="pe_scGw_lapsedReason" targetRef="pe_rj_reject"/>
    <sequenceFlow id="intl_pfm_execution_f15" name="otherwise" sourceRef="pe_scGw" targetRef="pe_rj_reject"/>
    <sequenceFlow id="intl_pfm_execution_f16" sourceRef="pe_scrutiny" targetRef="pe_scGw"/>
    <sequenceFlow id="intl_pfm_execution_f17" name="SANCTIONED" sourceRef="pe_snGw" targetRef="pe_encumber"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_execution_f18" name="otherwise" sourceRef="pe_snGw" targetRef="pe_rj_reject"/>
    <sequenceFlow id="intl_pfm_execution_f19" sourceRef="pe_commit" targetRef="pe_snGw"/>
    <sequenceFlow id="intl_pfm_execution_f20" sourceRef="pe_encumber" targetRef="pe_verify"/>
    <sequenceFlow id="intl_pfm_execution_f21" sourceRef="pe_verify" targetRef="pe_verifyGw"/>
    <sequenceFlow id="intl_pfm_execution_f22" name="not received" sourceRef="pe_verifyGw" targetRef="pe_rj_reject"><conditionExpression xsi:type="tFormalExpression">${verifyDecision == 'reject'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_execution_f23" sourceRef="pe_payee_clear" targetRef="pe_payee"/>
    <sequenceFlow id="intl_pfm_execution_f24" name="verified" sourceRef="pe_verifyGw" targetRef="pe_payee_clear"/>
    <sequenceFlow id="intl_pfm_execution_f25" sourceRef="pe_payee" targetRef="pe_payeeGw"/>
    <sequenceFlow id="intl_pfm_execution_f26" sourceRef="pe_rjPayee_reject" targetRef="pe_rjPayee_endRejected"/>
    <sequenceFlow id="intl_pfm_execution_f27" sourceRef="pe_rjPayee_code" targetRef="pe_rjPayee_reject"/>
    <sequenceFlow id="intl_pfm_execution_f28" name="payee check not confirmed" sourceRef="pe_payeeGw" targetRef="pe_rjPayee_code"><conditionExpression xsi:type="tFormalExpression">${payeeStatus != 'COMPLETED' || payeeClear == null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_execution_f29" name="payee excluded" sourceRef="pe_payeeGw" targetRef="pe_payeeExcluded"><conditionExpression xsi:type="tFormalExpression">${payeeStatus == 'COMPLETED' &amp;&amp; payeeClear != null &amp;&amp; (!payeeClear)}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_execution_f30" sourceRef="pe_payeeExcluded" targetRef="pe_rj_reject"/>
    <sequenceFlow id="intl_pfm_execution_f31" name="clear" sourceRef="pe_payeeGw" targetRef="pe_certify"/>
    <sequenceFlow id="intl_pfm_execution_f32" sourceRef="pe_certify" targetRef="pe_certGw"/>
    <sequenceFlow id="intl_pfm_execution_f33" name="not certified" sourceRef="pe_certGw" targetRef="pe_rj_reject"><conditionExpression xsi:type="tFormalExpression">${certifyDecision == 'reject'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_execution_f34" name="certified" sourceRef="pe_certGw" targetRef="pe_pay"/>
    <sequenceFlow id="intl_pfm_execution_f35" name="DONE" sourceRef="pe_exGw" targetRef="pe_close"><conditionExpression xsi:type="tFormalExpression">${executionOutcome == 'DONE'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_execution_f36" name="otherwise" sourceRef="pe_exGw" targetRef="pe_failed"/>
    <sequenceFlow id="intl_pfm_execution_f37" sourceRef="pe_pay" targetRef="pe_exGw"/>
    <sequenceFlow id="intl_pfm_execution_f38" sourceRef="pe_failed" targetRef="pe_endFailed"/>
    <sequenceFlow id="intl_pfm_execution_f39" sourceRef="pe_close" targetRef="pe_end"/>
    <sequenceFlow id="intl_pfm_execution_f46" name="DSC signature needed" sourceRef="pe_commitPrepareGw" targetRef="pe_commitPrepare"><conditionExpression xsi:type="tFormalExpression">${execution.getVariable('signatureRequired') == true}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_execution_f47" name="no DSC signature" sourceRef="pe_commitPrepareGw" targetRef="pe_commit"/>
    <sequenceFlow id="intl_pfm_execution_f48" sourceRef="pe_commitPrepare" targetRef="pe_commit"/>
    <subProcess id="pe_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="pe_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="pe_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="pe_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.1"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="pe_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="intl_pfm_execution_f40" sourceRef="pe_withdrawStart" targetRef="pe_withdrawKind"/>
      <sequenceFlow id="intl_pfm_execution_f41" sourceRef="pe_withdrawKind" targetRef="pe_withdrawCall"/>
      <sequenceFlow id="intl_pfm_execution_f42" sourceRef="pe_withdrawCall" targetRef="pe_withdrawEnd"/>
    </subProcess>
    <subProcess id="pe_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="pe_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="pe_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="pe_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.1"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="pe_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="intl_pfm_execution_f43" sourceRef="pe_cancelStart" targetRef="pe_cancelKind"/>
      <sequenceFlow id="intl_pfm_execution_f44" sourceRef="pe_cancelKind" targetRef="pe_cancelCall"/>
      <sequenceFlow id="intl_pfm_execution_f45" sourceRef="pe_cancelCall" targetRef="pe_cancelEnd"/>
    </subProcess>
  </process>
  <bpmndi:BPMNDiagram id="intl_pfm_execution_diagram">
    <bpmndi:BPMNPlane id="intl_pfm_execution_plane" bpmnElement="sangam-intl-pfm-execution">
