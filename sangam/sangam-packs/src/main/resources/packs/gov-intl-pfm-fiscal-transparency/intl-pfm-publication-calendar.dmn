<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_intl_pfm_publication_calendar" name="Publication deadlines (SYNTHETIC; per country)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <!-- SYNTHETIC: country law or policy. Deploy the confirmed table as a tenant override. -->
  <decision id="intl-pfm-publication-calendar" name="Publication deadlines (SYNTHETIC; per country)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.1">
    <decisionTable id="intl-pfm-publication-calendar_t" hitPolicy="FIRST">
      <input id="intl-pfm-publication-calendar_i0" label="Publication"><inputExpression id="intl-pfm-publication-calendar_ie0" typeRef="string"><text>publicationSet</text></inputExpression></input>
      <output id="intl-pfm-publication-calendar_o0" label="Publish within" name="publicationSpec" typeRef="string"/>
      <rule id="intl-pfm-publication-calendar_r0"><description>SYNTHETIC</description>
        <inputEntry id="intl-pfm-publication-calendar_r0_i0"><text>-</text></inputEntry>
        <outputEntry id="intl-pfm-publication-calendar_r0_o0"><text>"30D"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
