  <process id="sangam-intl-pfm-suspense-ageing" name="Suspense item clearance" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.2">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.intl.pfm-suspense-ageing</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.2</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>suspenseAccount,suspenseItemRef,amount</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="su_start" name="Item posted to suspense" operaton:initiator="initiator" operaton:formKey="sangam:gov-intl-pfm-suspense-ageing/item"></startEvent>
    <serviceTask id="su_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>suspenseAccount=SUSPENSE;suspenseItemRef=@customerId;amount=0;ledgerId=ACCOUNTS;clearingSeat=SUSPENSE-CLERK;accountingSeat=ACCOUNTING-OFFICER-TREASURY</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="su_cfg" name="Suspense clearance period (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>intl-pfm-suspense-ageing</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <serviceTask id="su_clear_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>su_clear</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${suspenseClearSpec}</operaton:expression></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="su_clear" name="Clear the suspense item to the correct head" operaton:candidateGroups="${clearingSeat}" operaton:formKey="sangam:gov-intl-pfm-suspense-ageing/clear" operaton:dueDate="${su_clearDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>clearDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="su_clear_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>su_clear</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>clearingSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="su_clear_warnEnd" name="Warned"></endEvent>
    <serviceTask id="su_clear_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>su_clear</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>clearingSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>clearDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="su_clear_breachGw" name="Deemed?" default="intl_pfm_suspense_ageing_f6"></exclusiveGateway>
    <exclusiveGateway id="su_clear_done" name=""></exclusiveGateway>
    <exclusiveGateway id="su_clearGw" name="" default="intl_pfm_suspense_ageing_f17"></exclusiveGateway>
    <userTask id="su_writeOff" name="Approve the write-off proposal (not the proposer)" operaton:candidateGroups="${accountingSeat}" operaton:formKey="sangam:gov-intl-pfm-suspense-ageing/write-off"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"><operaton:field name="steps"><operaton:string>su_clear</operaton:string></operaton:field></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>writeOffDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="su_writeOffGw" name="" default="intl_pfm_suspense_ageing_f18"></exclusiveGateway>
    <serviceTask id="su_post_clear" name="Clear the previous check result" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>reclassEntryRef=null</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="su_post" name="Reclassify from suspense (ledger)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>ledger.reclassify</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>reclassify</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>ledgerId,suspenseAccount,suspenseItemRef,targetHead,amount,clearDecision</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>reclass</operaton:string></operaton:field><operaton:field name="step"><operaton:string>reclassify</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="su_postGw" name="Posted?" default="intl_pfm_suspense_ageing_f22"></exclusiveGateway>
    <userTask id="su_postHold" name="Reclassification not confirmed: check the ledger" operaton:candidateGroups="${accountingSeat}" operaton:formKey="sangam:gov-intl-pfm-suspense-ageing/postHold"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <endEvent id="su_end" name="Suspense item cleared"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CLEARED</operaton:string></operaton:field><operaton:field name="dataVars"><operaton:string>['reclassEntryRef']</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="su_clear_warn" name="SLA warning (75%)" attachedToRef="su_clear" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${su_clearWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="su_clear_breach" name="SLA breached" attachedToRef="su_clear" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${su_clearDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="intl_pfm_suspense_ageing_f1" sourceRef="su_clear_warn" targetRef="su_clear_warnNotify"/>
    <sequenceFlow id="intl_pfm_suspense_ageing_f2" sourceRef="su_clear_warnNotify" targetRef="su_clear_warnEnd"/>
