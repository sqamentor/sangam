    <sequenceFlow id="intl_pfm_suspense_ageing_f5" name="deemed" sourceRef="su_clear_breachGw" targetRef="su_clear_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_suspense_ageing_f6" name="escalated" sourceRef="su_clear_breachGw" targetRef="su_clear_slaPlan"/>
