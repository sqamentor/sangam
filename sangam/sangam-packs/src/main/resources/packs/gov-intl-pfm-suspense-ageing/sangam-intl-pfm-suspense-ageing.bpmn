    <sequenceFlow id="intl_pfm_suspense_ageing_f12" sourceRef="su_clear_done" targetRef="su_clearGw"/>
    <sequenceFlow id="intl_pfm_suspense_ageing_f13" name="write-off proposed" sourceRef="su_clearGw" targetRef="su_writeOff"><conditionExpression xsi:type="tFormalExpression">${clearDecision == 'proposeWriteOff'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_suspense_ageing_f14" sourceRef="su_writeOff" targetRef="su_writeOffGw"/>
    <sequenceFlow id="intl_pfm_suspense_ageing_f15" name="clear it instead" sourceRef="su_writeOffGw" targetRef="su_clear_slaPlan"><conditionExpression xsi:type="tFormalExpression">${writeOffDecision == 'reject'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_suspense_ageing_f16" sourceRef="su_post_clear" targetRef="su_post"/>
    <sequenceFlow id="intl_pfm_suspense_ageing_f17" name="cleared" sourceRef="su_clearGw" targetRef="su_post_clear"/>
    <sequenceFlow id="intl_pfm_suspense_ageing_f18" name="write-off approved" sourceRef="su_writeOffGw" targetRef="su_post_clear"/>
    <sequenceFlow id="intl_pfm_suspense_ageing_f19" sourceRef="su_post" targetRef="su_postGw"/>
    <sequenceFlow id="intl_pfm_suspense_ageing_f20" sourceRef="su_postHold" targetRef="su_post_clear"/>
    <sequenceFlow id="intl_pfm_suspense_ageing_f21" name="not confirmed" sourceRef="su_postGw" targetRef="su_postHold"><conditionExpression xsi:type="tFormalExpression">${reclassStatus != 'COMPLETED' || reclassEntryRef == null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_suspense_ageing_f22" name="posted" sourceRef="su_postGw" targetRef="su_end"/>
