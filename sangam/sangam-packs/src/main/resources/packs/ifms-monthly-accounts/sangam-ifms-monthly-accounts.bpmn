<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_ifms_monthly_accounts" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_ifms_compileNow" name="sangam.ifms.compileNow"/>
  <process id="sangam-ifms-monthly-accounts" name="Monthly accounts" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.ifms.monthly-accounts</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>accountsMonth</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="ma_timer" name="Monthly on the 1st"><timerEventDefinition><timeCycle xsi:type="tFormalExpression">0 0 6 1 * ?</timeCycle></timerEventDefinition></startEvent>
    <startEvent id="ma_manual" name="Run now (message)"><messageEventDefinition messageRef="msg_sangam_ifms_compileNow"/></startEvent>
    <exclusiveGateway id="ma_join" name=""></exclusiveGateway>
    <serviceTask id="ma_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>accountsMonth=previous;paoSeat=PAO-1;prAoSeat=PRAO-1;dueSpec=8D;executionConnector=accounts.render;executionStep=render;reconcileRequired=false</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ma_compile_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>ma_compile</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="ma_compile" name="Compile and check the monthly account" operaton:candidateGroups="${paoSeat}" operaton:formKey="sangam:ifms-monthly-accounts/compile" operaton:dueDate="${ma_compileDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>compileDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="ma_compile_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>ma_compile</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>paoSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="ma_compile_warnEnd" name="Warned"></endEvent>
    <serviceTask id="ma_compile_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>ma_compile</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>paoSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>compileDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="ma_compile_breachGw" name="Deemed?" default="ifms_monthly_accounts_f8"></exclusiveGateway>
    <exclusiveGateway id="ma_compile_done" name=""></exclusiveGateway>
    <serviceTask id="ma_consolidate_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>ma_consolidate</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>2WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="ma_consolidate" name="Consolidate and approve" operaton:candidateGroups="${prAoSeat}" operaton:formKey="sangam:ifms-monthly-accounts/consolidate" operaton:dueDate="${ma_consolidateDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>consDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="ma_consolidate_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>ma_consolidate</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>prAoSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="ma_consolidate_warnEnd" name="Warned"></endEvent>
    <serviceTask id="ma_consolidate_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>ma_consolidate</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>prAoSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>consDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="ma_consolidate_breachGw" name="Deemed?" default="ifms_monthly_accounts_f16"></exclusiveGateway>
    <exclusiveGateway id="ma_consolidate_done" name=""></exclusiveGateway>
    <callActivity id="ma_render" name="Render to CGA / AG (core execution)" calledElement="sangam-core-execution"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <exclusiveGateway id="ma_consGw" name="" default="ifms_monthly_accounts_f24"></exclusiveGateway>
    <endEvent id="ma_end" name="Rendered"></endEvent>
    <boundaryEvent id="ma_compile_warn" name="SLA warning (75%)" attachedToRef="ma_compile" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${ma_compileWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="ma_compile_breach" name="SLA breached" attachedToRef="ma_compile" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${ma_compileDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="ma_consolidate_warn" name="SLA warning (75%)" attachedToRef="ma_consolidate" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${ma_consolidateWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="ma_consolidate_breach" name="SLA breached" attachedToRef="ma_consolidate" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${ma_consolidateDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="ifms_monthly_accounts_f1" sourceRef="ma_timer" targetRef="ma_join"/>
    <sequenceFlow id="ifms_monthly_accounts_f2" sourceRef="ma_manual" targetRef="ma_join"/>
    <sequenceFlow id="ifms_monthly_accounts_f3" sourceRef="ma_compile_warn" targetRef="ma_compile_warnNotify"/>
    <sequenceFlow id="ifms_monthly_accounts_f4" sourceRef="ma_compile_warnNotify" targetRef="ma_compile_warnEnd"/>
    <sequenceFlow id="ifms_monthly_accounts_f5" sourceRef="ma_compile_breach" targetRef="ma_compile_breachAct"/>
    <sequenceFlow id="ifms_monthly_accounts_f6" sourceRef="ma_compile_breachAct" targetRef="ma_compile_breachGw"/>
    <sequenceFlow id="ifms_monthly_accounts_f7" name="deemed" sourceRef="ma_compile_breachGw" targetRef="ma_compile_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_monthly_accounts_f8" name="escalated" sourceRef="ma_compile_breachGw" targetRef="ma_compile_slaPlan"/>
    <sequenceFlow id="ifms_monthly_accounts_f9" sourceRef="ma_compile_slaPlan" targetRef="ma_compile"/>
    <sequenceFlow id="ifms_monthly_accounts_f10" sourceRef="ma_compile" targetRef="ma_compile_done"/>
    <sequenceFlow id="ifms_monthly_accounts_f11" sourceRef="ma_consolidate_warn" targetRef="ma_consolidate_warnNotify"/>
    <sequenceFlow id="ifms_monthly_accounts_f12" sourceRef="ma_consolidate_warnNotify" targetRef="ma_consolidate_warnEnd"/>
    <sequenceFlow id="ifms_monthly_accounts_f13" sourceRef="ma_consolidate_breach" targetRef="ma_consolidate_breachAct"/>
    <sequenceFlow id="ifms_monthly_accounts_f14" sourceRef="ma_consolidate_breachAct" targetRef="ma_consolidate_breachGw"/>
    <sequenceFlow id="ifms_monthly_accounts_f15" name="deemed" sourceRef="ma_consolidate_breachGw" targetRef="ma_consolidate_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_monthly_accounts_f16" name="escalated" sourceRef="ma_consolidate_breachGw" targetRef="ma_consolidate_slaPlan"/>
    <sequenceFlow id="ifms_monthly_accounts_f17" sourceRef="ma_consolidate_slaPlan" targetRef="ma_consolidate"/>
    <sequenceFlow id="ifms_monthly_accounts_f18" sourceRef="ma_consolidate" targetRef="ma_consolidate_done"/>
    <sequenceFlow id="ifms_monthly_accounts_f19" sourceRef="ma_join" targetRef="ma_defaults"/>
    <sequenceFlow id="ifms_monthly_accounts_f20" sourceRef="ma_defaults" targetRef="ma_compile_slaPlan"/>
    <sequenceFlow id="ifms_monthly_accounts_f21" sourceRef="ma_compile_done" targetRef="ma_consolidate_slaPlan"/>
    <sequenceFlow id="ifms_monthly_accounts_f22" sourceRef="ma_consolidate_done" targetRef="ma_consGw"/>
    <sequenceFlow id="ifms_monthly_accounts_f23" name="returned" sourceRef="ma_consGw" targetRef="ma_compile_slaPlan"><conditionExpression xsi:type="tFormalExpression">${consDecision == 'returnBill'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_monthly_accounts_f24" name="approved" sourceRef="ma_consGw" targetRef="ma_render"/>
    <sequenceFlow id="ifms_monthly_accounts_f25" sourceRef="ma_render" targetRef="ma_end"/>
  </process>
