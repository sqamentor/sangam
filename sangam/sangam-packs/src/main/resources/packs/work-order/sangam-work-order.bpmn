    <sequenceFlow id="work_order_f15" sourceRef="wo_secWait" targetRef="wo_secLapsed"/>
    <sequenceFlow id="work_order_f16" sourceRef="wo_secLapsed" targetRef="wo_forfeit2"/>
    <sequenceFlow id="work_order_f17" sourceRef="wo_forfeit2" targetRef="wo_noSecurity"/>
    <sequenceFlow id="work_order_f18" sourceRef="wo_noSecurity" targetRef="wo_endNoSecurity"/>
    <sequenceFlow id="work_order_f19" sourceRef="wo_secVerified" targetRef="wo_agreement"/>
    <sequenceFlow id="work_order_f20" sourceRef="wo_agreement" targetRef="wo_sign"/>
    <sequenceFlow id="work_order_f21" sourceRef="wo_sign" targetRef="wo_site"/>
