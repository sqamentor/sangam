<!-- Work order. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_work_order" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_loaAccepted" name="sangam.loaAccepted"/>
  <message id="msg_sangam_securityVerified" name="sangam.securityVerified"/>
  <process id="sangam-work-order" name="Work order" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.work-order</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>contractorId,contractValue,workName</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="wo_start" name="Award received" operaton:initiator="initiator" operaton:formKey="sangam:work-order/award"></startEvent>
    <serviceTask id="wo_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>acceptanceWindow=P15D;securityWindow=P21D;eeSeat=EE-WO;aeSeat=AE-WO</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="wo_loa" name="Letter of acceptance" operaton:class="org.sangam.packs.core.DocumentDelegate"><extensionElements><operaton:field name="template"><operaton:string>letter-of-acceptance</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="wo_tell" name="Send LoA to contractor" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>loa-issued</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>email</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>contractorId</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="wo_window" name="Acceptance window" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>acceptance</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${acceptanceWindow}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <eventBasedGateway id="wo_wait" name="Accepted?"></eventBasedGateway>
    <intermediateCatchEvent id="wo_accepted" name="LoA accepted"><messageEventDefinition messageRef="msg_sangam_loaAccepted"/></intermediateCatchEvent>
    <intermediateCatchEvent id="wo_lapsed" name="Not accepted in time"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${acceptanceDueAt}</timeDate></timerEventDefinition></intermediateCatchEvent>
    <serviceTask id="wo_forfeit" name="Forfeit EMD" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>emd.forfeit</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>forfeit</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>contractorId</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>forfeit</operaton:string></operaton:field><operaton:field name="step"><operaton:string>forfeit</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="wo_notAccepted" name="Not accepted" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>workOrderOutcome=NOT_ACCEPTED</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="wo_endNotAccepted" name="Not accepted"></endEvent>
    <serviceTask id="wo_security" name="Performance security case (linked)" operaton:class="org.sangam.packs.core.LinkedInstanceDelegate"><extensionElements><operaton:field name="processKey"><operaton:string>sangam-security-instrument</operaton:string></operaton:field><operaton:field name="linkType"><operaton:string>performance-security</operaton:string></operaton:field><operaton:field name="inherit"><operaton:string>contractorId,contractValue</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="wo_secWindow" name="Security due" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>security</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${securityWindow}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <eventBasedGateway id="wo_secWait" name="Security verified?"></eventBasedGateway>
    <intermediateCatchEvent id="wo_secVerified" name="Security verified"><messageEventDefinition messageRef="msg_sangam_securityVerified"/></intermediateCatchEvent>
    <intermediateCatchEvent id="wo_secLapsed" name="Security not furnished"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${securityDueAt}</timeDate></timerEventDefinition></intermediateCatchEvent>
    <serviceTask id="wo_forfeit2" name="Forfeit EMD (no security)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>emd.forfeit</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>forfeit</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>contractorId</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>forfeit2</operaton:string></operaton:field><operaton:field name="step"><operaton:string>forfeit-security</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="wo_noSecurity" name="No security" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>workOrderOutcome=NO_SECURITY</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="wo_endNoSecurity" name="Cancelled: no security"></endEvent>
    <userTask id="wo_agreement" name="Sign agreement" operaton:candidateGroups="${eeSeat}" operaton:formKey="sangam:work-order/agreement"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="wo_sign" name="Sign agreement" operaton:class="org.sangam.packs.core.SignatureDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>REQUEST</operaton:string></operaton:field><operaton:field name="purpose"><operaton:string>agreement</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="wo_site" name="Hand over site" operaton:candidateGroups="${aeSeat}" operaton:formKey="sangam:work-order/site-handover"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="wo_order" name="Work order" operaton:class="org.sangam.packs.core.DocumentDelegate"><extensionElements><operaton:field name="template"><operaton:string>work-order</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="wo_issued" name="Issued" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>workOrderOutcome=ISSUED</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="wo_end" name="Work order issued"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <sequenceFlow id="work_order_f1" sourceRef="wo_start" targetRef="wo_defaults"/>
    <sequenceFlow id="work_order_f2" sourceRef="wo_defaults" targetRef="wo_loa"/>
