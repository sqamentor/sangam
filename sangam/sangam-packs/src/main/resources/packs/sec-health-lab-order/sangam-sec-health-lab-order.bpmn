<!-- Lab order. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_sec_health_lab_order" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_lab_amend" name="sangam.lab.amend"/>
  <process id="sangam-sec-health-lab-order" name="Lab order" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.health.lab-order</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>patientName,testCodes,priority</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="lb_start" name="Order placed" operaton:initiator="initiator" operaton:formKey="sangam:sec-health-lab-order/order"></startEvent>
    <serviceTask id="lb_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>patientName=@customerId;testCodes=CBC;criticalValue=false;phleboSeat=PHLEBOTOMY;techSeat=LAB-TECH;pathSeat=PATHOLOGIST</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="lb_tat" name="TAT by priority (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-health-lab-tat</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <userTask id="lb_collect" name="Collect sample and label" operaton:candidateGroups="${phleboSeat}" operaton:formKey="sangam:sec-health-lab-order/collect"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>collectDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="lb_colGw" name="" default="sec_health_lab_order_f6"></exclusiveGateway>
    <serviceTask id="lb_accession" name="Accession in LIS" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>lis.accession</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>accession</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>sampleBarcode,testCodes</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>acc</operaton:string></operaton:field><operaton:field name="step"><operaton:string>accession</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="lb_check" name="Sample acceptance check" operaton:candidateGroups="${techSeat}" operaton:formKey="sangam:sec-health-lab-order/check"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>sampleDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="lb_sampleGw" name="" default="sec_health_lab_order_f18"></exclusiveGateway>
    <serviceTask id="lb_run_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>lb_run</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${tatSpec}</operaton:expression></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="lb_run" name="Run test and technical validation" operaton:candidateGroups="${techSeat}" operaton:formKey="sangam:sec-health-lab-order/run" operaton:dueDate="${lb_runDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="lb_run_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>lb_run</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>techSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="lb_run_warnEnd" name="Warned"></endEvent>
    <serviceTask id="lb_run_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>lb_run</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>techSeat</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="lb_run_breachGw" name="Deemed?" default="sec_health_lab_order_f15"></exclusiveGateway>
    <exclusiveGateway id="lb_run_done" name=""></exclusiveGateway>
    <userTask id="lb_authorise" name="Pathologist authorisation" operaton:candidateGroups="${pathSeat}" operaton:formKey="sangam:sec-health-lab-order/authorise"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>authDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="lb_authGw" name="" default="sec_health_lab_order_f30"></exclusiveGateway>
    <serviceTask id="lb_critical_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>lb_critical</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${criticalSpec}</operaton:expression></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="lb_critical" name="Call critical value to the clinician (read-back)" operaton:candidateGroups="${pathSeat}" operaton:formKey="sangam:sec-health-lab-order/critical" operaton:dueDate="${lb_criticalDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="lb_critical_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>lb_critical</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>pathSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="lb_critical_warnEnd" name="Warned"></endEvent>
    <serviceTask id="lb_critical_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>lb_critical</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>pathSeat</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="lb_critical_breachGw" name="Deemed?" default="sec_health_lab_order_f27"></exclusiveGateway>
    <exclusiveGateway id="lb_critical_done" name=""></exclusiveGateway>
    <exclusiveGateway id="lb_critGw" name="Critical value?" default="sec_health_lab_order_f32"></exclusiveGateway>
    <exclusiveGateway id="lb_critMerge" name=""></exclusiveGateway>
    <serviceTask id="lb_release" name="Release report (FHIR DiagnosticReport)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>lis.report</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>release</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>patientName,testCodes,results</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>report</operaton:string></operaton:field><operaton:field name="step"><operaton:string>release</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="lb_link" name="Link to ABHA" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>abdm.linkCareContext</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>link</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>patientName</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>hip</operaton:string></operaton:field><operaton:field name="step"><operaton:string>link</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="lb_end" name="Reported"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="lb_run_warn" name="SLA warning (75%)" attachedToRef="lb_run" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${lb_runWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="lb_run_breach" name="SLA breached" attachedToRef="lb_run" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${lb_runDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="lb_critical_warn" name="SLA warning (75%)" attachedToRef="lb_critical" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${lb_criticalWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="lb_critical_breach" name="SLA breached" attachedToRef="lb_critical" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${lb_criticalDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="sec_health_lab_order_f1" sourceRef="lb_start" targetRef="lb_defaults"/>
    <sequenceFlow id="sec_health_lab_order_f2" sourceRef="lb_defaults" targetRef="lb_tat"/>
    <sequenceFlow id="sec_health_lab_order_f3" sourceRef="lb_tat" targetRef="lb_collect"/>
    <sequenceFlow id="sec_health_lab_order_f4" sourceRef="lb_collect" targetRef="lb_colGw"/>
    <sequenceFlow id="sec_health_lab_order_f5" name="patient unavailable" sourceRef="lb_colGw" targetRef="lb_collect"><conditionExpression xsi:type="tFormalExpression">${collectDecision == 'reschedule'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_health_lab_order_f6" name="collected" sourceRef="lb_colGw" targetRef="lb_accession"/>
    <sequenceFlow id="sec_health_lab_order_f7" sourceRef="lb_accession" targetRef="lb_check"/>
    <sequenceFlow id="sec_health_lab_order_f8" sourceRef="lb_check" targetRef="lb_sampleGw"/>
    <sequenceFlow id="sec_health_lab_order_f9" name="haemolysed / mislabelled: re-collect" sourceRef="lb_sampleGw" targetRef="lb_collect"><conditionExpression xsi:type="tFormalExpression">${sampleDecision == 'reject'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_health_lab_order_f10" sourceRef="lb_run_warn" targetRef="lb_run_warnNotify"/>
    <sequenceFlow id="sec_health_lab_order_f11" sourceRef="lb_run_warnNotify" targetRef="lb_run_warnEnd"/>
    <sequenceFlow id="sec_health_lab_order_f12" sourceRef="lb_run_breach" targetRef="lb_run_breachAct"/>
    <sequenceFlow id="sec_health_lab_order_f13" sourceRef="lb_run_breachAct" targetRef="lb_run_breachGw"/>
    <sequenceFlow id="sec_health_lab_order_f14" name="deemed" sourceRef="lb_run_breachGw" targetRef="lb_run_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_health_lab_order_f15" name="escalated" sourceRef="lb_run_breachGw" targetRef="lb_run_slaPlan"/>
    <sequenceFlow id="sec_health_lab_order_f16" sourceRef="lb_run_slaPlan" targetRef="lb_run"/>
    <sequenceFlow id="sec_health_lab_order_f17" sourceRef="lb_run" targetRef="lb_run_done"/>
    <sequenceFlow id="sec_health_lab_order_f18" name="accept" sourceRef="lb_sampleGw" targetRef="lb_run_slaPlan"/>
    <sequenceFlow id="sec_health_lab_order_f19" sourceRef="lb_run_done" targetRef="lb_authorise"/>
    <sequenceFlow id="sec_health_lab_order_f20" sourceRef="lb_authorise" targetRef="lb_authGw"/>
    <sequenceFlow id="sec_health_lab_order_f21" name="repeat" sourceRef="lb_authGw" targetRef="lb_run_slaPlan"><conditionExpression xsi:type="tFormalExpression">${authDecision == 'repeat'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_health_lab_order_f22" sourceRef="lb_critical_warn" targetRef="lb_critical_warnNotify"/>
    <sequenceFlow id="sec_health_lab_order_f23" sourceRef="lb_critical_warnNotify" targetRef="lb_critical_warnEnd"/>
    <sequenceFlow id="sec_health_lab_order_f24" sourceRef="lb_critical_breach" targetRef="lb_critical_breachAct"/>
    <sequenceFlow id="sec_health_lab_order_f25" sourceRef="lb_critical_breachAct" targetRef="lb_critical_breachGw"/>
    <sequenceFlow id="sec_health_lab_order_f26" name="deemed" sourceRef="lb_critical_breachGw" targetRef="lb_critical_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_health_lab_order_f27" name="escalated" sourceRef="lb_critical_breachGw" targetRef="lb_critical_slaPlan"/>
    <sequenceFlow id="sec_health_lab_order_f28" sourceRef="lb_critical_slaPlan" targetRef="lb_critical"/>
    <sequenceFlow id="sec_health_lab_order_f29" sourceRef="lb_critical" targetRef="lb_critical_done"/>
    <sequenceFlow id="sec_health_lab_order_f30" name="release" sourceRef="lb_authGw" targetRef="lb_critGw"/>
    <sequenceFlow id="sec_health_lab_order_f31" name="yes" sourceRef="lb_critGw" targetRef="lb_critical_slaPlan"><conditionExpression xsi:type="tFormalExpression">${criticalValue}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_health_lab_order_f32" name="no" sourceRef="lb_critGw" targetRef="lb_critMerge"/>
    <sequenceFlow id="sec_health_lab_order_f33" sourceRef="lb_critical_done" targetRef="lb_critMerge"/>
    <sequenceFlow id="sec_health_lab_order_f34" sourceRef="lb_critMerge" targetRef="lb_release"/>
    <sequenceFlow id="sec_health_lab_order_f35" sourceRef="lb_release" targetRef="lb_link"/>
    <sequenceFlow id="sec_health_lab_order_f36" sourceRef="lb_link" targetRef="lb_end"/>
    <subProcess id="lb_amend" name="Amended report" triggeredByEvent="true">
      <startEvent id="lb_amStart" name="Amendment requested" isInterrupting="false"><messageEventDefinition messageRef="msg_sangam_lab_amend"/></startEvent>
      <userTask id="lb_amendTask" name="Issue amended report with reason" operaton:candidateGroups="${pathSeat}" operaton:formKey="sangam:sec-health-lab-order/amend"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
      <serviceTask id="lb_amNotify" name="Tell the clinician" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>lab-report-amended</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>inapp</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>initiatorSeat</operaton:string></operaton:field></extensionElements></serviceTask>
      <endEvent id="lb_amEnd" name="Amended"></endEvent>
      <sequenceFlow id="sec_health_lab_order_f37" sourceRef="lb_amStart" targetRef="lb_amendTask"/>
      <sequenceFlow id="sec_health_lab_order_f38" sourceRef="lb_amendTask" targetRef="lb_amNotify"/>
      <sequenceFlow id="sec_health_lab_order_f39" sourceRef="lb_amNotify" targetRef="lb_amEnd"/>
    </subProcess>
  </process>
