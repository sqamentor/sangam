      <bpmndi:BPMNShape id="ad_link_di" bpmnElement="ad_link"><dc:Bounds x="2825" y="405" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ad_linkOptGw_di" bpmnElement="ad_linkOptGw"><dc:Bounds x="2685" y="420" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ad_linkOptMerge_di" bpmnElement="ad_linkOptMerge"><dc:Bounds x="3015" y="420" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ad_end_di" bpmnElement="ad_end"><dc:Bounds x="3187" y="427" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ad_lama_di" bpmnElement="ad_lama"><dc:Bounds x="2165" y="280" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ad_endLama_di" bpmnElement="ad_endLama"><dc:Bounds x="2362" y="302" width="36" height="36"/></bpmndi:BPMNShape>
