<!-- Admission to discharge. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_sec_health_admission" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_cancelCase" name="sangam.cancelCase"/>
  <message id="msg_sangam_withdrawCase" name="sangam.withdrawCase"/>
  <process id="sangam-sec-health-admission" name="Admission to discharge" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.health.admission-discharge</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>patientName,abhaNumber,payerType</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="ad_start" name="Patient arrives" operaton:initiator="initiator" operaton:formKey="sangam:sec-health-admission-discharge/register"></startEvent>
    <serviceTask id="ad_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>patientName=@customerId;abhaNumber=null;admissionType=EMERGENCY;payerType=SELF;wardType=GENERAL;consentGiven=false;erSeat=ER-DOCTOR;admitSeat=ADMISSION-DESK;doctorSeat=TREATING-DOCTOR;billingSeat=BILLING;applicantRef=@patientName</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ad_abha" name="Verify ABHA" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>abdm.abhaVerify</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>verify</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>abhaNumber</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>abha</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="ad_abhaOptGw" name="ABHA given?" default="sec_health_admission_f2"></exclusiveGateway>
    <exclusiveGateway id="ad_abhaOptMerge" name=""></exclusiveGateway>
    <exclusiveGateway id="ad_erGw" name="Emergency?" default="sec_health_admission_f8"></exclusiveGateway>
    <userTask id="ad_triage" name="Triage and stabilise" operaton:candidateGroups="${erSeat}" operaton:formKey="sangam:sec-health-admission-discharge/triage" operaton:priority="90"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <userTask id="ad_admit" name="Admit: bed, estimate of charges, consent" operaton:candidateGroups="${admitSeat}" operaton:formKey="sangam:sec-health-admission-discharge/admit"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="ad_consentGw" name="Consent recorded?" default="sec_health_admission_f12"></exclusiveGateway>
    <exclusiveGateway id="ad_payerGw" name="Payer?" default="sec_health_admission_f15"></exclusiveGateway>
    <serviceTask id="ad_preauth" name="Pre-authorisation request to the insurer / TPA (NHCX)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>tpa.preauthRequest</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>preauth</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>patientName,estimatedCost</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>preauth</operaton:string></operaton:field><operaton:field name="step"><operaton:string>preauth</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ad_bis" name="PM-JAY beneficiary identification and pre-authorisation" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>pmjay.bis</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>identify</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>patientName,abhaNumber</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>pmjay</operaton:string></operaton:field><operaton:field name="step"><operaton:string>pmjay</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="ad_care" name="Inpatient care: orders and notes" operaton:candidateGroups="${doctorSeat}" operaton:formKey="sangam:sec-health-admission-discharge/care"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>careOutcome</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="ad_outGw" name="Outcome?" default="sec_health_admission_f33"></exclusiveGateway>
    <parallelGateway id="ad_fork" name="Discharge in parallel"></parallelGateway>
    <parallelGateway id="ad_join" name=""></parallelGateway>
    <userTask id="ad_doctorSeat" name="Discharge summary" operaton:candidateGroups="${doctorSeat}" operaton:formKey="sangam:sec-health-admission-discharge/doctor"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <userTask id="ad_billingSeat" name="Final bill (itemised)" operaton:candidateGroups="${billingSeat}" operaton:formKey="sangam:sec-health-admission-discharge/billing"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="ad_link" name="Link discharge summary to ABHA (care context)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>abdm.linkCareContext</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>link</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>abhaNumber,dischargeSummary</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>hip</operaton:string></operaton:field><operaton:field name="step"><operaton:string>link</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="ad_linkOptGw" name="ABHA linked?" default="sec_health_admission_f25"></exclusiveGateway>
    <exclusiveGateway id="ad_linkOptMerge" name=""></exclusiveGateway>
    <endEvent id="ad_end" name="Discharged"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <userTask id="ad_lama" name="Record LAMA / DAMA with risks explained" operaton:candidateGroups="${doctorSeat}" operaton:formKey="sangam:sec-health-admission-discharge/lama"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <endEvent id="ad_endLama" name="Left against medical advice"></endEvent>
    <userTask id="ad_transfer" name="Transfer with referral note" operaton:candidateGroups="${doctorSeat}" operaton:formKey="sangam:sec-health-admission-discharge/transfer"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <endEvent id="ad_endTransfer" name="Transferred"></endEvent>
    <userTask id="ad_death" name="Death summary and MCCD" operaton:candidateGroups="${doctorSeat}" operaton:formKey="sangam:sec-health-admission-discharge/death"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="ad_crs" name="Report the death for civil registration (21 days)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>crs.report</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>death</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>patientName</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>crs</operaton:string></operaton:field><operaton:field name="step"><operaton:string>crs</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="ad_endDeath" name="Death reported"></endEvent>
    <sequenceFlow id="sec_health_admission_f1" name="yes" sourceRef="ad_abhaOptGw" targetRef="ad_abha"><conditionExpression xsi:type="tFormalExpression">${abhaNumber != null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_health_admission_f2" name="no" sourceRef="ad_abhaOptGw" targetRef="ad_abhaOptMerge"/>
    <sequenceFlow id="sec_health_admission_f3" sourceRef="ad_abha" targetRef="ad_abhaOptMerge"/>
    <sequenceFlow id="sec_health_admission_f4" sourceRef="ad_start" targetRef="ad_defaults"/>
    <sequenceFlow id="sec_health_admission_f5" sourceRef="ad_defaults" targetRef="ad_abhaOptGw"/>
    <sequenceFlow id="sec_health_admission_f6" sourceRef="ad_abhaOptMerge" targetRef="ad_erGw"/>
    <sequenceFlow id="sec_health_admission_f7" name="emergency" sourceRef="ad_erGw" targetRef="ad_triage"><conditionExpression xsi:type="tFormalExpression">${admissionType == 'EMERGENCY'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_health_admission_f8" name="planned" sourceRef="ad_erGw" targetRef="ad_admit"/>
    <sequenceFlow id="sec_health_admission_f9" sourceRef="ad_triage" targetRef="ad_admit"/>
    <sequenceFlow id="sec_health_admission_f10" sourceRef="ad_admit" targetRef="ad_consentGw"/>
    <sequenceFlow id="sec_health_admission_f11" name="no: obtain consent" sourceRef="ad_consentGw" targetRef="ad_admit"><conditionExpression xsi:type="tFormalExpression">${!consentGiven}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_health_admission_f12" name="yes" sourceRef="ad_consentGw" targetRef="ad_payerGw"/>
    <sequenceFlow id="sec_health_admission_f13" name="insurance" sourceRef="ad_payerGw" targetRef="ad_preauth"><conditionExpression xsi:type="tFormalExpression">${payerType == 'INSURANCE'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_health_admission_f14" name="PM-JAY" sourceRef="ad_payerGw" targetRef="ad_bis"><conditionExpression xsi:type="tFormalExpression">${payerType == 'PMJAY'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_health_admission_f15" name="self / corporate" sourceRef="ad_payerGw" targetRef="ad_care"/>
    <sequenceFlow id="sec_health_admission_f16" sourceRef="ad_preauth" targetRef="ad_care"/>
    <sequenceFlow id="sec_health_admission_f17" sourceRef="ad_bis" targetRef="ad_care"/>
    <sequenceFlow id="sec_health_admission_f18" sourceRef="ad_care" targetRef="ad_outGw"/>
    <sequenceFlow id="sec_health_admission_f19" name="discharge" sourceRef="ad_outGw" targetRef="ad_fork"><conditionExpression xsi:type="tFormalExpression">${careOutcome == 'discharge'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_health_admission_f20" sourceRef="ad_fork" targetRef="ad_doctorSeat"/>
    <sequenceFlow id="sec_health_admission_f21" sourceRef="ad_doctorSeat" targetRef="ad_join"/>
    <sequenceFlow id="sec_health_admission_f22" sourceRef="ad_fork" targetRef="ad_billingSeat"/>
    <sequenceFlow id="sec_health_admission_f23" sourceRef="ad_billingSeat" targetRef="ad_join"/>
    <sequenceFlow id="sec_health_admission_f24" name="yes" sourceRef="ad_linkOptGw" targetRef="ad_link"><conditionExpression xsi:type="tFormalExpression">${abhaNumber != null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_health_admission_f25" name="no" sourceRef="ad_linkOptGw" targetRef="ad_linkOptMerge"/>
    <sequenceFlow id="sec_health_admission_f26" sourceRef="ad_link" targetRef="ad_linkOptMerge"/>
    <sequenceFlow id="sec_health_admission_f27" sourceRef="ad_join" targetRef="ad_linkOptGw"/>
    <sequenceFlow id="sec_health_admission_f28" sourceRef="ad_linkOptMerge" targetRef="ad_end"/>
    <sequenceFlow id="sec_health_admission_f29" name="LAMA" sourceRef="ad_outGw" targetRef="ad_lama"><conditionExpression xsi:type="tFormalExpression">${careOutcome == 'lama'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_health_admission_f30" sourceRef="ad_lama" targetRef="ad_endLama"/>
    <sequenceFlow id="sec_health_admission_f31" name="transfer" sourceRef="ad_outGw" targetRef="ad_transfer"><conditionExpression xsi:type="tFormalExpression">${careOutcome == 'transfer'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_health_admission_f32" sourceRef="ad_transfer" targetRef="ad_endTransfer"/>
    <sequenceFlow id="sec_health_admission_f33" name="death" sourceRef="ad_outGw" targetRef="ad_death"/>
    <sequenceFlow id="sec_health_admission_f34" sourceRef="ad_death" targetRef="ad_crs"/>
    <sequenceFlow id="sec_health_admission_f35" sourceRef="ad_crs" targetRef="ad_endDeath"/>
    <subProcess id="ad_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="ad_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="ad_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="ad_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="ad_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="sec_health_admission_f36" sourceRef="ad_withdrawStart" targetRef="ad_withdrawKind"/>
      <sequenceFlow id="sec_health_admission_f37" sourceRef="ad_withdrawKind" targetRef="ad_withdrawCall"/>
      <sequenceFlow id="sec_health_admission_f38" sourceRef="ad_withdrawCall" targetRef="ad_withdrawEnd"/>
    </subProcess>
    <subProcess id="ad_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="ad_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="ad_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="ad_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="ad_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="sec_health_admission_f39" sourceRef="ad_cancelStart" targetRef="ad_cancelKind"/>
      <sequenceFlow id="sec_health_admission_f40" sourceRef="ad_cancelKind" targetRef="ad_cancelCall"/>
      <sequenceFlow id="sec_health_admission_f41" sourceRef="ad_cancelCall" targetRef="ad_cancelEnd"/>
    </subProcess>
  </process>
  <bpmndi:BPMNDiagram id="sec_health_admission_diagram">
    <bpmndi:BPMNPlane id="sec_health_admission_plane" bpmnElement="sangam-sec-health-admission">
      <bpmndi:BPMNShape id="ad_start_di" bpmnElement="ad_start"><dc:Bounds x="52" y="52" width="36" height="36"/></bpmndi:BPMNShape>
