      <bpmndi:BPMNShape id="ad_death_di" bpmnElement="ad_death"><dc:Bounds x="2165" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ad_crs_di" bpmnElement="ad_crs"><dc:Bounds x="2330" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ad_endDeath_di" bpmnElement="ad_endDeath"><dc:Bounds x="2527" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ad_withdraw_di" bpmnElement="ad_withdraw" isExpanded="true"><dc:Bounds x="30" y="660" width="623" height="150"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ad_withdrawStart_di" bpmnElement="ad_withdrawStart"><dc:Bounds x="92" y="722" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ad_withdrawKind_di" bpmnElement="ad_withdrawKind"><dc:Bounds x="225" y="700" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ad_withdrawCall_di" bpmnElement="ad_withdrawCall"><dc:Bounds x="390" y="700" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ad_withdrawEnd_di" bpmnElement="ad_withdrawEnd"><dc:Bounds x="587" y="722" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ad_cancel_di" bpmnElement="ad_cancel" isExpanded="true"><dc:Bounds x="30" y="850" width="623" height="150"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ad_cancelStart_di" bpmnElement="ad_cancelStart"><dc:Bounds x="92" y="912" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ad_cancelKind_di" bpmnElement="ad_cancelKind"><dc:Bounds x="225" y="890" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ad_cancelCall_di" bpmnElement="ad_cancelCall"><dc:Bounds x="390" y="890" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ad_cancelEnd_di" bpmnElement="ad_cancelEnd"><dc:Bounds x="587" y="912" width="36" height="36"/></bpmndi:BPMNShape>
