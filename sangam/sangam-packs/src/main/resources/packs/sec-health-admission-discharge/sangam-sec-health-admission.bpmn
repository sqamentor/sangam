      <bpmndi:BPMNShape id="ad_consentGw_di" bpmnElement="ad_consentGw"><dc:Bounds x="1365" y="45" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ad_payerGw_di" bpmnElement="ad_payerGw"><dc:Bounds x="1530" y="45" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ad_preauth_di" bpmnElement="ad_preauth"><dc:Bounds x="1670" y="155" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ad_bis_di" bpmnElement="ad_bis"><dc:Bounds x="1670" y="30" width="100" height="80"/></bpmndi:BPMNShape>
