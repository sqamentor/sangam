      "label": {
        "en": "Customer name",
        "hi": "ग्राहक का नाम"
      }
    },
    {
      "id": "pan",
      "type": "string",
      "required": true,
      "label": {
        "en": "PAN",
        "hi": "पैन"
      }
    },
    {
      "id": "mobile",
      "type": "string",
      "required": true,
      "label": {
        "en": "Mobile number",
        "hi": "मोबाइल नंबर"
      }
    },
    {
      "id": "accountType",
      "type": "select",
      "required": true,
      "label": {
        "en": "Account type",
        "hi": "खाते का प्रकार"
      }
    },
    {
      "id": "kycMode",
      "type": "select",
      "required": true,
      "label": {
        "en": "KYC mode (Aadhaar OTP, V-CIP, offline XML, DigiLocker, in person)",
        "hi": "केवाईसी विधि (आधार ओटीपी, वी-सीआईपी, ऑफ़लाइन एक्सएमएल, डिजिलॉकर, व्यक्तिगत)"
