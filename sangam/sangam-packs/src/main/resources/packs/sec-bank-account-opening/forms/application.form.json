    {
      "id": "consentGiven",
      "type": "boolean",
      "required": true,
      "label": {
        "en": "Consent recorded",
        "hi": "सहमति दर्ज"
      }
    },
    {
      "id": "applicantRef",
      "type": "string",
      "required": false,
      "label": {
        "en": "Applicant mobile / e-mail reference",
        "hi": "आवेदक मोबाइल / ई-मेल संदर्भ"
      }
    },
    {
      "id": "documents",
      "type": "attachments",
      "required": false,
      "label": {
        "en": "Documents",
        "hi": "दस्तावेज़"
      }
    }
