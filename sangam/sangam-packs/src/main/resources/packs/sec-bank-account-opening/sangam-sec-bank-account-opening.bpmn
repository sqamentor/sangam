      <serviceTask id="ao_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="ao_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.1"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="ao_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="sec_bank_account_opening_f74" sourceRef="ao_cancelStart" targetRef="ao_cancelKind"/>
      <sequenceFlow id="sec_bank_account_opening_f75" sourceRef="ao_cancelKind" targetRef="ao_cancelCall"/>
      <sequenceFlow id="sec_bank_account_opening_f76" sourceRef="ao_cancelCall" targetRef="ao_cancelEnd"/>
    </subProcess>
  </process>
