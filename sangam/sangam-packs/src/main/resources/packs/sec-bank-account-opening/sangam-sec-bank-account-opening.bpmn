    <serviceTask id="ao_correct_wd_kind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="ao_correct_wd_call" name="Withdraw (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.1"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="ao_correct_wd_end" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="ao_rjPan_code" name="Reason: PAN_NOT_CONFIRMED" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=PAN_NOT_CONFIRMED</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="ao_rjPan_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.1"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="ao_rjPan_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <exclusiveGateway id="ao_modeGw" name="KYC mode?" default="sec_bank_account_opening_f34"></exclusiveGateway>
    <serviceTask id="ao_vcip_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>ao_vcip</operaton:string></operaton:field><operaton:field name="spec"><operaton:string>2WD</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="ao_vcip" name="V-CIP: live video identification" operaton:candidateGroups="${vcipSeat}" operaton:formKey="sangam:sec-bank-account-opening/vcip" operaton:dueDate="${ao_vcipDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>vcipDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="ao_vcip_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>ao_vcip</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>vcipSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="ao_vcip_warnEnd" name="Warned"></endEvent>
    <serviceTask id="ao_vcip_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>ao_vcip</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>vcipSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>vcipDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="ao_vcip_breachGw" name="Deemed?" default="sec_bank_account_opening_f30"></exclusiveGateway>
    <exclusiveGateway id="ao_vcip_done" name=""></exclusiveGateway>
    <serviceTask id="ao_ekyc" name="Aadhaar OTP e-KYC" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>uidai.ekyc</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>otp-ekyc</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>customerName,mobile</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>ekyc</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="ao_vcipGw" name="V-CIP result?" default="sec_bank_account_opening_f41"></exclusiveGateway>
    <exclusiveGateway id="ao_kycJoin" name=""></exclusiveGateway>
    <serviceTask id="ao_rjVcip_code" name="Reason: VCIP_FAILED" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=VCIP_FAILED</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="ao_rjVcip_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.1"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="ao_rjVcip_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="ao_screen_clear" name="Clear the previous check result" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>screenHit=null</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ao_screen" name="Screen UNSC / UAPA / PEP lists" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>sanctions.screen</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>screen</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>customerName,pan</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>screen</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="ao_screenGw" name="Screening hit?" default="sec_bank_account_opening_f49"></exclusiveGateway>
    <userTask id="ao_compliance" name="Review screening hit" operaton:candidateGroups="${complianceSeat}" operaton:formKey="sangam:sec-bank-account-opening/screening"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>screenDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="ao_rjScreenCheck_code" name="Reason: SCREENING_NOT_CONFIRMED" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=SCREENING_NOT_CONFIRMED</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="ao_rjScreenCheck_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.1"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="ao_rjScreenCheck_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <businessRuleTask id="ao_risk" name="Customer risk category (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-bank-kyc-risk</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <exclusiveGateway id="ao_compGw" name="" default="sec_bank_account_opening_f54"></exclusiveGateway>
    <serviceTask id="ao_rjScreen_code" name="Reason: SANCTIONS_MATCH" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=SANCTIONS_MATCH</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="ao_rjScreen_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.1"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="ao_rjScreen_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <userTask id="ao_edd" name="Enhanced due diligence" operaton:candidateGroups="${eddSeat}" operaton:formKey="sangam:sec-bank-account-opening/edd"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>eddDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <callActivity id="ao_check" name="Checker approves account opening (core sanction, SoD)" calledElement="sangam-core-sanction" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.1"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <exclusiveGateway id="ao_eddOptGw" name="High risk: EDD?" default="sec_bank_account_opening_f56"></exclusiveGateway>
    <exclusiveGateway id="ao_eddOptMerge" name=""></exclusiveGateway>
    <callActivity id="ao_rj_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.1"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="ao_rj_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <callActivity id="ao_open" name="Open account in CBS (core execution)" calledElement="sangam-core-execution" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.1"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <exclusiveGateway id="ao_sanGw" name="sanctionOutcome?" default="sec_bank_account_opening_f63"></exclusiveGateway>
    <serviceTask id="ao_ckycUpload" name="Upload KYC record to CKYCR" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>ckycr.upload</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>upload</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>customerName,pan,riskCategory</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>ckycUp</operaton:string></operaton:field><operaton:field name="step"><operaton:string>ckyc-upload</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="ao_close" name="Welcome kit and closure (core)" calledElement="sangam-core-closure" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.1"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <serviceTask id="ao_openFailed" name="CBS refused the account" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>cbs-open-failed</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>inapp</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>initiatorSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="ao_exGw" name="executionOutcome?" default="sec_bank_account_opening_f66"></exclusiveGateway>
    <endEvent id="ao_end" name="Account opened"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <exclusiveGateway id="ao_checkPrepareGw" name="Document to sign?" default="sec_bank_account_opening_f78"></exclusiveGateway>
    <userTask id="ao_checkPrepare" name="Prepare the document to sign" operaton:candidateGroups="${initiatorSeat}" operaton:formKey="sangam:sec-bank-account-opening/prepare-sanction-note"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.DocumentSlotReadyListener"><operaton:field name="slots"><operaton:string>sanctionDocumentId:SANCTION_NOTE</operaton:string></operaton:field></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <boundaryEvent id="ao_vcip_warn" name="SLA warning (75%)" attachedToRef="ao_vcip" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${ao_vcipWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="ao_vcip_breach" name="SLA breached" attachedToRef="ao_vcip" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${ao_vcipDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="sec_bank_account_opening_f1" sourceRef="ao_start" targetRef="ao_defaults"/>
    <sequenceFlow id="sec_bank_account_opening_f2" sourceRef="ao_defaults" targetRef="ao_consentGw"/>
    <sequenceFlow id="sec_bank_account_opening_f3" name="no" sourceRef="ao_consentGw" targetRef="ao_endNoConsent"><conditionExpression xsi:type="tFormalExpression">${!consentGiven}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_account_opening_f4" sourceRef="ao_ckycSearch_clear" targetRef="ao_ckycSearch"/>
    <sequenceFlow id="sec_bank_account_opening_f5" name="yes" sourceRef="ao_consentGw" targetRef="ao_ckycSearch_clear"/>
    <sequenceFlow id="sec_bank_account_opening_f6" name="yes" sourceRef="ao_ckycGw" targetRef="ao_ckycDownload"><conditionExpression xsi:type="tFormalExpression">${ckycStatus == 'COMPLETED' &amp;&amp; ckycFound != null &amp;&amp; (ckycFound)}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_account_opening_f7" name="no" sourceRef="ao_ckycGw" targetRef="ao_ckycMerge"/>
    <sequenceFlow id="sec_bank_account_opening_f8" sourceRef="ao_ckycDownload" targetRef="ao_ckycMerge"/>
    <sequenceFlow id="sec_bank_account_opening_f9" name="search not confirmed: no CKYC record relied on" sourceRef="ao_ckycGw" targetRef="ao_ckycMerge"><conditionExpression xsi:type="tFormalExpression">${ckycStatus != 'COMPLETED' || ckycFound == null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_account_opening_f10" sourceRef="ao_ckycSearch" targetRef="ao_ckycGw"/>
    <sequenceFlow id="sec_bank_account_opening_f11" sourceRef="ao_pan_clear" targetRef="ao_pan"/>
    <sequenceFlow id="sec_bank_account_opening_f12" sourceRef="ao_ckycMerge" targetRef="ao_pan_clear"/>
    <sequenceFlow id="sec_bank_account_opening_f13" sourceRef="ao_pan" targetRef="ao_panGw"/>
    <sequenceFlow id="sec_bank_account_opening_f14" sourceRef="ao_correct" targetRef="ao_correct_gw"/>
    <sequenceFlow id="sec_bank_account_opening_f15" name="resubmit" sourceRef="ao_correct_gw" targetRef="ao_correct_version"><conditionExpression xsi:type="tFormalExpression">${ao_correctDecision == 'resubmit'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_account_opening_f16" sourceRef="ao_correct_version" targetRef="ao_pan_clear"/>
    <sequenceFlow id="sec_bank_account_opening_f17" sourceRef="ao_correct_wd_kind" targetRef="ao_correct_wd_call"/>
    <sequenceFlow id="sec_bank_account_opening_f18" sourceRef="ao_correct_wd_call" targetRef="ao_correct_wd_end"/>
    <sequenceFlow id="sec_bank_account_opening_f19" name="withdraw" sourceRef="ao_correct_gw" targetRef="ao_correct_wd_kind"/>
    <sequenceFlow id="sec_bank_account_opening_f20" sourceRef="ao_rjPan_reject" targetRef="ao_rjPan_endRejected"/>
    <sequenceFlow id="sec_bank_account_opening_f21" sourceRef="ao_rjPan_code" targetRef="ao_rjPan_reject"/>
    <sequenceFlow id="sec_bank_account_opening_f22" name="PAN not confirmed" sourceRef="ao_panGw" targetRef="ao_rjPan_code"><conditionExpression xsi:type="tFormalExpression">${panStatus != 'COMPLETED' || panValid == null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_account_opening_f23" name="mismatch: correct" sourceRef="ao_panGw" targetRef="ao_correct"><conditionExpression xsi:type="tFormalExpression">${panStatus == 'COMPLETED' &amp;&amp; panValid != null &amp;&amp; (!panValid)}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_account_opening_f24" name="valid" sourceRef="ao_panGw" targetRef="ao_modeGw"/>
    <sequenceFlow id="sec_bank_account_opening_f25" sourceRef="ao_vcip_warn" targetRef="ao_vcip_warnNotify"/>
    <sequenceFlow id="sec_bank_account_opening_f26" sourceRef="ao_vcip_warnNotify" targetRef="ao_vcip_warnEnd"/>
    <sequenceFlow id="sec_bank_account_opening_f27" sourceRef="ao_vcip_breach" targetRef="ao_vcip_breachAct"/>
    <sequenceFlow id="sec_bank_account_opening_f28" sourceRef="ao_vcip_breachAct" targetRef="ao_vcip_breachGw"/>
    <sequenceFlow id="sec_bank_account_opening_f29" name="deemed" sourceRef="ao_vcip_breachGw" targetRef="ao_vcip_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_account_opening_f30" name="escalated" sourceRef="ao_vcip_breachGw" targetRef="ao_vcip_slaPlan"/>
    <sequenceFlow id="sec_bank_account_opening_f31" sourceRef="ao_vcip_slaPlan" targetRef="ao_vcip"/>
    <sequenceFlow id="sec_bank_account_opening_f32" sourceRef="ao_vcip" targetRef="ao_vcip_done"/>
    <sequenceFlow id="sec_bank_account_opening_f33" name="V-CIP" sourceRef="ao_modeGw" targetRef="ao_vcip_slaPlan"><conditionExpression xsi:type="tFormalExpression">${kycMode == 'VCIP'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_account_opening_f34" name="e-KYC / digital" sourceRef="ao_modeGw" targetRef="ao_ekyc"/>
    <sequenceFlow id="sec_bank_account_opening_f35" sourceRef="ao_vcip_done" targetRef="ao_vcipGw"/>
    <sequenceFlow id="sec_bank_account_opening_f36" name="dropped / poor video: reschedule" sourceRef="ao_vcipGw" targetRef="ao_vcip_slaPlan"><conditionExpression xsi:type="tFormalExpression">${vcipDecision == 'reschedule'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_account_opening_f37" name="pass" sourceRef="ao_vcipGw" targetRef="ao_kycJoin"><conditionExpression xsi:type="tFormalExpression">${vcipDecision == 'pass'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_account_opening_f38" sourceRef="ao_ekyc" targetRef="ao_kycJoin"/>
    <sequenceFlow id="sec_bank_account_opening_f39" sourceRef="ao_rjVcip_reject" targetRef="ao_rjVcip_endRejected"/>
    <sequenceFlow id="sec_bank_account_opening_f40" sourceRef="ao_rjVcip_code" targetRef="ao_rjVcip_reject"/>
    <sequenceFlow id="sec_bank_account_opening_f41" name="fail" sourceRef="ao_vcipGw" targetRef="ao_rjVcip_code"/>
    <sequenceFlow id="sec_bank_account_opening_f42" sourceRef="ao_screen_clear" targetRef="ao_screen"/>
    <sequenceFlow id="sec_bank_account_opening_f43" sourceRef="ao_kycJoin" targetRef="ao_screen_clear"/>
    <sequenceFlow id="sec_bank_account_opening_f44" sourceRef="ao_screen" targetRef="ao_screenGw"/>
    <sequenceFlow id="sec_bank_account_opening_f45" sourceRef="ao_rjScreenCheck_reject" targetRef="ao_rjScreenCheck_endRejected"/>
    <sequenceFlow id="sec_bank_account_opening_f46" sourceRef="ao_rjScreenCheck_code" targetRef="ao_rjScreenCheck_reject"/>
    <sequenceFlow id="sec_bank_account_opening_f47" name="screening not confirmed" sourceRef="ao_screenGw" targetRef="ao_rjScreenCheck_code"><conditionExpression xsi:type="tFormalExpression">${screenStatus != 'COMPLETED' || screenHit == null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_account_opening_f48" name="possible match" sourceRef="ao_screenGw" targetRef="ao_compliance"><conditionExpression xsi:type="tFormalExpression">${screenStatus == 'COMPLETED' &amp;&amp; screenHit != null &amp;&amp; (screenHit)}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_account_opening_f49" name="clear" sourceRef="ao_screenGw" targetRef="ao_risk"/>
    <sequenceFlow id="sec_bank_account_opening_f50" sourceRef="ao_compliance" targetRef="ao_compGw"/>
    <sequenceFlow id="sec_bank_account_opening_f51" name="false positive" sourceRef="ao_compGw" targetRef="ao_risk"><conditionExpression xsi:type="tFormalExpression">${screenDecision == 'falsePositive'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_account_opening_f52" sourceRef="ao_rjScreen_reject" targetRef="ao_rjScreen_endRejected"/>
    <sequenceFlow id="sec_bank_account_opening_f53" sourceRef="ao_rjScreen_code" targetRef="ao_rjScreen_reject"/>
    <sequenceFlow id="sec_bank_account_opening_f54" name="true match" sourceRef="ao_compGw" targetRef="ao_rjScreen_code"/>
    <sequenceFlow id="sec_bank_account_opening_f55" name="yes" sourceRef="ao_eddOptGw" targetRef="ao_edd"><conditionExpression xsi:type="tFormalExpression">${eddRequired}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_account_opening_f56" name="no" sourceRef="ao_eddOptGw" targetRef="ao_eddOptMerge"/>
    <sequenceFlow id="sec_bank_account_opening_f57" sourceRef="ao_edd" targetRef="ao_eddOptMerge"/>
    <sequenceFlow id="sec_bank_account_opening_f58" sourceRef="ao_risk" targetRef="ao_eddOptGw"/>
    <sequenceFlow id="sec_bank_account_opening_f59" sourceRef="ao_eddOptMerge" targetRef="ao_checkPrepareGw"/>
    <sequenceFlow id="sec_bank_account_opening_f60" sourceRef="ao_rj_reject" targetRef="ao_rj_endRejected"/>
    <sequenceFlow id="sec_bank_account_opening_f61" name="SANCTIONED" sourceRef="ao_sanGw" targetRef="ao_open"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_account_opening_f62" name="RETURNED" sourceRef="ao_sanGw" targetRef="ao_correct"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'RETURNED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_account_opening_f63" name="otherwise" sourceRef="ao_sanGw" targetRef="ao_rj_reject"/>
    <sequenceFlow id="sec_bank_account_opening_f64" sourceRef="ao_check" targetRef="ao_sanGw"/>
    <sequenceFlow id="sec_bank_account_opening_f65" name="DONE" sourceRef="ao_exGw" targetRef="ao_ckycUpload"><conditionExpression xsi:type="tFormalExpression">${executionOutcome == 'DONE'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_account_opening_f66" name="otherwise" sourceRef="ao_exGw" targetRef="ao_openFailed"/>
    <sequenceFlow id="sec_bank_account_opening_f67" sourceRef="ao_open" targetRef="ao_exGw"/>
    <sequenceFlow id="sec_bank_account_opening_f68" sourceRef="ao_openFailed" targetRef="ao_checkPrepareGw"/>
    <sequenceFlow id="sec_bank_account_opening_f69" sourceRef="ao_ckycUpload" targetRef="ao_close"/>
    <sequenceFlow id="sec_bank_account_opening_f70" sourceRef="ao_close" targetRef="ao_end"/>
    <sequenceFlow id="sec_bank_account_opening_f77" name="DSC signature needed" sourceRef="ao_checkPrepareGw" targetRef="ao_checkPrepare"><conditionExpression xsi:type="tFormalExpression">${execution.getVariable('signatureRequired') == true}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_account_opening_f78" name="no DSC signature" sourceRef="ao_checkPrepareGw" targetRef="ao_check"/>
    <sequenceFlow id="sec_bank_account_opening_f79" sourceRef="ao_checkPrepare" targetRef="ao_check"/>
    <subProcess id="ao_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="ao_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="ao_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="ao_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.1"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="ao_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="sec_bank_account_opening_f71" sourceRef="ao_withdrawStart" targetRef="ao_withdrawKind"/>
