    <sequenceFlow id="intl_pfm_budget_accounti_f4" sourceRef="br_defaults" targetRef="br_outturn_clear"/>
    <sequenceFlow id="intl_pfm_budget_accounti_f5" sourceRef="br_outturn" targetRef="br_accounts_clear"/>
    <sequenceFlow id="intl_pfm_budget_accounti_f6" sourceRef="br_accounts" targetRef="br_bothGw"/>
    <sequenceFlow id="intl_pfm_budget_accounti_f7" sourceRef="br_hold" targetRef="br_outturn_clear"/>
    <sequenceFlow id="intl_pfm_budget_accounti_f8" name="not confirmed" sourceRef="br_bothGw" targetRef="br_hold"><conditionExpression xsi:type="tFormalExpression">${outturnStatus != 'COMPLETED' || outturnAmount == null || accountingStatus != 'COMPLETED' || accountingAmount == null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_budget_accounti_f9" name="confirmed" sourceRef="br_bothGw" targetRef="br_difference"/>
    <sequenceFlow id="intl_pfm_budget_accounti_f10" sourceRef="br_difference" targetRef="br_diffGw"/>
    <sequenceFlow id="intl_pfm_budget_accounti_f11" name="difference to explain" sourceRef="br_diffGw" targetRef="br_explain"><conditionExpression xsi:type="tFormalExpression">${differenceAmount != 0}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_budget_accounti_f12" name="no difference" sourceRef="br_diffGw" targetRef="br_review"/>
    <sequenceFlow id="intl_pfm_budget_accounti_f13" sourceRef="br_explain" targetRef="br_review"/>
    <sequenceFlow id="intl_pfm_budget_accounti_f14" sourceRef="br_review" targetRef="br_reviewGw"/>
    <sequenceFlow id="intl_pfm_budget_accounti_f15" name="returned" sourceRef="br_reviewGw" targetRef="br_explain"><conditionExpression xsi:type="tFormalExpression">${reviewDecision == 'return'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_budget_accounti_f16" name="approved" sourceRef="br_reviewGw" targetRef="br_doc"/>
    <sequenceFlow id="intl_pfm_budget_accounti_f17" sourceRef="br_doc" targetRef="br_end"/>
