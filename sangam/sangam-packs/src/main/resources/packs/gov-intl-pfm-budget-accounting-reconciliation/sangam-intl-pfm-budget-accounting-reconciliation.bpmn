  <process id="sangam-intl-pfm-budget-accounting-reconciliation" name="Budget-to-accounting reconciliation" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.2">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.intl.pfm-budget-accounting-reconciliation</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.2</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>reconPeriod,ledgerId</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="br_start" name="Period to reconcile" operaton:initiator="initiator" operaton:formKey="sangam:gov-intl-pfm-budget-accounting-reconciliation/period"></startEvent>
    <serviceTask id="br_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>ledgerId=BUDGET;accountantSeat=ACCOUNTANT;reviewerSeat=ACCOUNTING-OFFICER-TREASURY</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="br_outturn_clear" name="Clear the previous check result" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>outturnAmount=null</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="br_outturn" name="Budget outturn (ledger)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>ledger.outturn</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>outturn</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>ledgerId,reconPeriod</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>outturn</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="br_accounts_clear" name="Clear the previous check result" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>accountingAmount=null</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="br_accounts" name="Expense (financial statements)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>accounts.statement</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>expense</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>reconPeriod</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>accounting</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="br_bothGw" name="Both confirmed?" default="intl_pfm_budget_accounti_f9"></exclusiveGateway>
    <userTask id="br_hold" name="Amounts not confirmed: check the ledger and the accounts" operaton:candidateGroups="${accountantSeat}" operaton:formKey="sangam:gov-intl-pfm-budget-accounting-reconciliation/hold"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="br_difference" name="Difference (exact)" operaton:class="org.sangam.packs.core.MoneyCalculationDelegate"><extensionElements><operaton:field name="result"><operaton:string>differenceAmount</operaton:string></operaton:field><operaton:field name="formula"><operaton:string>outturnAmount - accountingAmount</operaton:string></operaton:field><operaton:field name="op"><operaton:string>SUM</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="br_diffGw" name="Difference?" default="intl_pfm_budget_accounti_f12"></exclusiveGateway>
    <userTask id="br_explain" name="Explain the difference (basis, timing, entity)" operaton:candidateGroups="${accountantSeat}" operaton:formKey="sangam:gov-intl-pfm-budget-accounting-reconciliation/explain"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <userTask id="br_review" name="Approve the reconciliation (not the preparer)" operaton:candidateGroups="${reviewerSeat}" operaton:formKey="sangam:gov-intl-pfm-budget-accounting-reconciliation/review"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"><operaton:field name="steps"><operaton:string>br_explain</operaton:string></operaton:field></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>reviewDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="br_reviewGw" name="" default="intl_pfm_budget_accounti_f16"></exclusiveGateway>
