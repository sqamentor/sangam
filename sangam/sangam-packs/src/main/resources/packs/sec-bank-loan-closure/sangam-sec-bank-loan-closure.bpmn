<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- Loan closure. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_sec_bank_loan_closure" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <process id="sangam-sec-bank-loan-closure" name="Loan closure" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.bank.loan-closure</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>loanAccountNo,customerId</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="lc_start" name="Loan repaid / settled" operaton:initiator="initiator" operaton:formKey="sangam:sec-bank-loan-closure/request"></startEvent>
    <serviceTask id="lc_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>loanAccountNo=@customerId;closureDuesNil=true;compensationDue=false;docsSeat=DOCS-CUSTODIAN;compensationAmount=0;delayDays=0;applicantRef=@customerId;executionConnector=bank.credit;executionStep=delay-compensation;verifyApproval=false;reconcileRequired=false;executionPayloadFields=customerId,compensationAmount</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="lc_check" name="Closure check" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>lms.closureCheck</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>check</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>loanAccountNo</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>closure</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="lc_gw" name="Dues nil?" default="sec_bank_loan_closure_f5"></exclusiveGateway>
    <endEvent id="lc_endDues" name="Dues outstanding: not closed"></endEvent>
    <serviceTask id="lc_clock" name="Regulatory clock: release" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>release</operaton:string></operaton:field><operaton:field name="spec"><operaton:string>30D</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="lc_release" name="Release original documents and NOC" operaton:candidateGroups="${docsSeat}" operaton:formKey="sangam:sec-bank-loan-closure/release" operaton:dueDate="${releaseDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>releaseDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="lc_lateFlag" name="Delay recorded" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>compensationDue=true</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="lc_lateEnd" name="Delay recorded"></endEvent>
    <exclusiveGateway id="lc_relGw" name="" default="sec_bank_loan_closure_f11"></exclusiveGateway>
    <userTask id="lc_duplicate" name="Obtain certified copies at the bank's cost" operaton:candidateGroups="${docsSeat}" operaton:formKey="sangam:sec-bank-loan-closure/duplicate"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="lc_satisfy" name="Remove charge (CERSAI / ROC)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>cersai.satisfy</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>satisfy</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>loanAccountNo</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>cersai</operaton:string></operaton:field><operaton:field name="step"><operaton:string>satisfy</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="lc_noc" name="Issue NOC" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>docs.noc</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>issue</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>loanAccountNo,customerId</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>noc</operaton:string></operaton:field><operaton:field name="step"><operaton:string>noc</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="lc_compute" name="Compute compensation (Rs 5,000 / day, delay attributable)" operaton:candidateGroups="BRANCH-MGR" operaton:formKey="sangam:sec-bank-loan-closure/compensation"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="lc_compGw" name="Released late?" default="sec_bank_loan_closure_f16"></exclusiveGateway>
    <exclusiveGateway id="lc_compMerge" name=""></exclusiveGateway>
    <callActivity id="lc_pay" name="Credit compensation (core execution)" calledElement="sangam-core-execution"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <exclusiveGateway id="lc_payGw" name="Attributable to the bank?" default="sec_bank_loan_closure_f19"></exclusiveGateway>
    <endEvent id="lc_end" name="Closed"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="lc_late" name="30 days passed" attachedToRef="lc_release" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${releaseDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="sec_bank_loan_closure_f1" sourceRef="lc_start" targetRef="lc_defaults"/>
    <sequenceFlow id="sec_bank_loan_closure_f2" sourceRef="lc_defaults" targetRef="lc_check"/>
    <sequenceFlow id="sec_bank_loan_closure_f3" sourceRef="lc_check" targetRef="lc_gw"/>
    <sequenceFlow id="sec_bank_loan_closure_f4" name="no" sourceRef="lc_gw" targetRef="lc_endDues"><conditionExpression xsi:type="tFormalExpression">${!closureDuesNil}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_loan_closure_f5" name="yes" sourceRef="lc_gw" targetRef="lc_clock"/>
    <sequenceFlow id="sec_bank_loan_closure_f6" sourceRef="lc_clock" targetRef="lc_release"/>
    <sequenceFlow id="sec_bank_loan_closure_f7" sourceRef="lc_late" targetRef="lc_lateFlag"/>
    <sequenceFlow id="sec_bank_loan_closure_f8" sourceRef="lc_lateFlag" targetRef="lc_lateEnd"/>
    <sequenceFlow id="sec_bank_loan_closure_f9" sourceRef="lc_release" targetRef="lc_relGw"/>
    <sequenceFlow id="sec_bank_loan_closure_f10" name="lost / damaged" sourceRef="lc_relGw" targetRef="lc_duplicate"><conditionExpression xsi:type="tFormalExpression">${releaseDecision == 'docsLost'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_loan_closure_f11" name="released" sourceRef="lc_relGw" targetRef="lc_satisfy"/>
    <sequenceFlow id="sec_bank_loan_closure_f12" sourceRef="lc_duplicate" targetRef="lc_satisfy"/>
    <sequenceFlow id="sec_bank_loan_closure_f13" sourceRef="lc_satisfy" targetRef="lc_noc"/>
    <sequenceFlow id="sec_bank_loan_closure_f14" sourceRef="lc_noc" targetRef="lc_compGw"/>
    <sequenceFlow id="sec_bank_loan_closure_f15" name="yes" sourceRef="lc_compGw" targetRef="lc_compute"><conditionExpression xsi:type="tFormalExpression">${compensationDue}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_loan_closure_f16" name="no" sourceRef="lc_compGw" targetRef="lc_compMerge"/>
    <sequenceFlow id="sec_bank_loan_closure_f17" sourceRef="lc_compute" targetRef="lc_payGw"/>
    <sequenceFlow id="sec_bank_loan_closure_f18" name="amount due" sourceRef="lc_payGw" targetRef="lc_pay"><conditionExpression xsi:type="tFormalExpression">${compensationAmount &gt; 0}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_loan_closure_f19" name="not attributable" sourceRef="lc_payGw" targetRef="lc_compMerge"/>
    <sequenceFlow id="sec_bank_loan_closure_f20" sourceRef="lc_pay" targetRef="lc_compMerge"/>
    <sequenceFlow id="sec_bank_loan_closure_f21" sourceRef="lc_compMerge" targetRef="lc_end"/>
  </process>
