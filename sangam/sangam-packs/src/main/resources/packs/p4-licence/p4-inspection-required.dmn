<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_p4_inspection_required" name="P4 inspection required?" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="p4-inspection-required" name="P4 inspection required?" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="p4-inspection-required_t" hitPolicy="FIRST">
      <input id="p4-inspection-required_i0" label="Licence type"><inputExpression id="p4-inspection-required_ie0" typeRef="string"><text>licenceType</text></inputExpression></input>
      <input id="p4-inspection-required_i1" label="Area (sq m)"><inputExpression id="p4-inspection-required_ie1" typeRef="double"><text>premisesArea</text></inputExpression></input>
      <output id="p4-inspection-required_o0" label="Inspection" name="inspectionRequired" typeRef="boolean"/>
      <rule id="p4-inspection-required_r0">
        <inputEntry id="p4-inspection-required_r0_i0"><text>"FOOD"</text></inputEntry>
        <inputEntry id="p4-inspection-required_r0_i1"><text>-</text></inputEntry>
        <outputEntry id="p4-inspection-required_r0_o0"><text>true</text></outputEntry>
      </rule>
      <rule id="p4-inspection-required_r1">
        <inputEntry id="p4-inspection-required_r1_i0"><text>"FACTORY"</text></inputEntry>
        <inputEntry id="p4-inspection-required_r1_i1"><text>-</text></inputEntry>
        <outputEntry id="p4-inspection-required_r1_o0"><text>true</text></outputEntry>
      </rule>
      <rule id="p4-inspection-required_r2">
        <inputEntry id="p4-inspection-required_r2_i0"><text>-</text></inputEntry>
        <inputEntry id="p4-inspection-required_r2_i1"><text>&gt; 200</text></inputEntry>
        <outputEntry id="p4-inspection-required_r2_o0"><text>true</text></outputEntry>
      </rule>
      <rule id="p4-inspection-required_r3">
        <inputEntry id="p4-inspection-required_r3_i0"><text>-</text></inputEntry>
        <inputEntry id="p4-inspection-required_r3_i1"><text>-</text></inputEntry>
        <outputEntry id="p4-inspection-required_r3_o0"><text>false</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
