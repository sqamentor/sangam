    <intermediateCatchEvent id="pcs_due" name="Timeline lapsed"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${caseDueAt}</timeDate></timerEventDefinition></intermediateCatchEvent>
    <userTask id="pcs_escalate" name="Licence overdue: direct action" operaton:candidateGroups="DC-MC" operaton:formKey="sangam:p4-licence/case-overdue"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <endEvent id="pcs_end" name="Escalation handled"></endEvent>
    <sequenceFlow id="p4_case_sla_f1" sourceRef="pcs_start" targetRef="pcs_deadline"/>
