  <process id="sangam-p4-case-sla" name="P4 case variant: statutory clock" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <documentation>Runs as the blocking process task of the CMMN case; exits when the case is approved.</documentation>
    <startEvent id="pcs_start" name="Clock started"></startEvent>
