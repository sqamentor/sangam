<!-- UP-22 Supplier onboarding. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_up22_supplier_onboarding" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <process id="sangam-up22-supplier-onboarding" name="UP-22 Supplier onboarding" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>universal.up22-external-collaboration</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>supplierName,applicantRef</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="u22_start" name="Supplier nominated" operaton:initiator="initiator" operaton:formKey="sangam:up22-external-collaboration/nominate"></startEvent>
    <serviceTask id="u22_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>reviewerSeat=VENDOR-DESK;supplierSla=P15D</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="u22_group" name="External principal group" operaton:expression="${execution.setVariable('externalGroup', 'external:'.concat(applicantRef))}"></serviceTask>
    <serviceTask id="u22_invite" name="Send scoped one-time link" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>portal.inviteExternal</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>invite</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>supplierName,applicantRef,externalGroup</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>invite</operaton:string></operaton:field><operaton:field name="step"><operaton:string>invite</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="u22_submit_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>u22_submit</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${supplierSla}</operaton:expression></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="u22_submit" name="Supplier submits documents" operaton:candidateGroups="${externalGroup}" operaton:formKey="sangam:up22-external-collaboration/supplier" operaton:dueDate="${u22_submitDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="u22_submit_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>u22_submit</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>externalGroup</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="u22_submit_warnEnd" name="Warned"></endEvent>
    <serviceTask id="u22_submit_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>u22_submit</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>externalGroup</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field><operaton:field name="maxEscalations"><operaton:string>0</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="u22_submit_breachGw" name="Deemed?" default="up22_supplier_onboarding_f6"></exclusiveGateway>
    <exclusiveGateway id="u22_submit_done" name=""></exclusiveGateway>
    <userTask id="u22_review" name="Review supplier documents" operaton:candidateGroups="${reviewerSeat}" operaton:formKey="sangam:up22-external-collaboration/review"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>vendorDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="u22_gw" name="" default="up22_supplier_onboarding_f18"></exclusiveGateway>
    <serviceTask id="u22_create" name="Create vendor" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>vendor.create</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>create</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>supplierName</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>vendor</operaton:string></operaton:field><operaton:field name="step"><operaton:string>vendor</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="u22_end" name="Onboarded"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <endEvent id="u22_endRejected" name="Rejected"></endEvent>
    <boundaryEvent id="u22_submit_warn" name="SLA warning (75%)" attachedToRef="u22_submit" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${u22_submitWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="u22_submit_breach" name="SLA breached" attachedToRef="u22_submit" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${u22_submitDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="up22_supplier_onboarding_f1" sourceRef="u22_submit_warn" targetRef="u22_submit_warnNotify"/>
    <sequenceFlow id="up22_supplier_onboarding_f2" sourceRef="u22_submit_warnNotify" targetRef="u22_submit_warnEnd"/>
    <sequenceFlow id="up22_supplier_onboarding_f3" sourceRef="u22_submit_breach" targetRef="u22_submit_breachAct"/>
    <sequenceFlow id="up22_supplier_onboarding_f4" sourceRef="u22_submit_breachAct" targetRef="u22_submit_breachGw"/>
    <sequenceFlow id="up22_supplier_onboarding_f5" name="deemed" sourceRef="u22_submit_breachGw" targetRef="u22_submit_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="up22_supplier_onboarding_f6" name="escalated" sourceRef="u22_submit_breachGw" targetRef="u22_submit_slaPlan"/>
    <sequenceFlow id="up22_supplier_onboarding_f7" sourceRef="u22_submit_slaPlan" targetRef="u22_submit"/>
    <sequenceFlow id="up22_supplier_onboarding_f8" sourceRef="u22_submit" targetRef="u22_submit_done"/>
    <sequenceFlow id="up22_supplier_onboarding_f9" sourceRef="u22_start" targetRef="u22_defaults"/>
    <sequenceFlow id="up22_supplier_onboarding_f10" sourceRef="u22_defaults" targetRef="u22_group"/>
    <sequenceFlow id="up22_supplier_onboarding_f11" sourceRef="u22_group" targetRef="u22_invite"/>
    <sequenceFlow id="up22_supplier_onboarding_f12" sourceRef="u22_invite" targetRef="u22_submit_slaPlan"/>
    <sequenceFlow id="up22_supplier_onboarding_f13" sourceRef="u22_submit_done" targetRef="u22_review"/>
    <sequenceFlow id="up22_supplier_onboarding_f14" sourceRef="u22_review" targetRef="u22_gw"/>
    <sequenceFlow id="up22_supplier_onboarding_f15" name="clarify" sourceRef="u22_gw" targetRef="u22_submit_slaPlan"><conditionExpression xsi:type="tFormalExpression">${vendorDecision == 'clarify'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="up22_supplier_onboarding_f16" name="accept" sourceRef="u22_gw" targetRef="u22_create"><conditionExpression xsi:type="tFormalExpression">${vendorDecision == 'accept'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="up22_supplier_onboarding_f17" sourceRef="u22_create" targetRef="u22_end"/>
    <sequenceFlow id="up22_supplier_onboarding_f18" name="reject" sourceRef="u22_gw" targetRef="u22_endRejected"/>
  </process>
