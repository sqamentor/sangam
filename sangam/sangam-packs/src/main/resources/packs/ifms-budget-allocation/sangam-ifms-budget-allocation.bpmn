<!-- Budget distribution order. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_ifms_budget_allocation" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_cancelCase" name="sangam.cancelCase"/>
  <message id="msg_sangam_withdrawCase" name="sangam.withdrawCase"/>
  <process id="sangam-ifms-budget-allocation" name="Budget distribution order" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.ifms.budget-allocation</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>stage,headOfAccount,holder,amount</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="ba_start" name="Distribution proposed" operaton:initiator="initiator" operaton:formKey="sangam:ifms-budget-allocation/proposal"></startEvent>
    <serviceTask id="ba_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>ledgerId=BUDGET;stage=RELEASE;amount=0;holder=DDO-1;caseType=BUDGET_DISTRIBUTION;routingDecisionKey=ifms-allocation-authority;scrutinySeat=PRAO-1;executionConnector=ledger.distribute;executionStep=distribute;reconcileRequired=false;outputTemplate=budget-distribution-order;appealAllowed=false</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="ba_scrutiny" name="Budget section scrutiny (core)" calledElement="sangam-core-scrutiny"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <callActivity id="ba_sanction" name="Approval (core)" calledElement="sangam-core-sanction"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <callActivity id="ba_post" name="Post the distribution in the ledger (core execution)" calledElement="sangam-core-execution"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <serviceTask id="ba_holds" name="Release held bills" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>ledger.releaseHolds</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>releaseHolds</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>ledgerId,holder,headOfAccount</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>holds</operaton:string></operaton:field><operaton:field name="step"><operaton:string>holds</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="ba_close" name="Order and closure (core)" calledElement="sangam-core-closure"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <callActivity id="ba_rj_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="ba_rj_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <exclusiveGateway id="ba_scrGw" name="scrutinyOutcome?" default="ifms_budget_allocation_f5"></exclusiveGateway>
    <exclusiveGateway id="ba_sanGw" name="sanctionOutcome?" default="ifms_budget_allocation_f9"></exclusiveGateway>
    <exclusiveGateway id="ba_exGw" name="executionOutcome?" default="ifms_budget_allocation_f12"></exclusiveGateway>
    <endEvent id="ba_end" name="Closed"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <sequenceFlow id="ifms_budget_allocation_f1" sourceRef="ba_rj_reject" targetRef="ba_rj_endRejected"/>
    <sequenceFlow id="ifms_budget_allocation_f2" sourceRef="ba_start" targetRef="ba_defaults"/>
    <sequenceFlow id="ifms_budget_allocation_f3" sourceRef="ba_defaults" targetRef="ba_scrutiny"/>
    <sequenceFlow id="ifms_budget_allocation_f4" name="ACCEPTED" sourceRef="ba_scrGw" targetRef="ba_sanction"><conditionExpression xsi:type="tFormalExpression">${scrutinyOutcome == 'ACCEPTED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_budget_allocation_f5" name="otherwise" sourceRef="ba_scrGw" targetRef="ba_rj_reject"/>
    <sequenceFlow id="ifms_budget_allocation_f6" sourceRef="ba_scrutiny" targetRef="ba_scrGw"/>
    <sequenceFlow id="ifms_budget_allocation_f7" name="SANCTIONED" sourceRef="ba_sanGw" targetRef="ba_post"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_budget_allocation_f8" name="RETURNED" sourceRef="ba_sanGw" targetRef="ba_scrutiny"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'RETURNED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_budget_allocation_f9" name="otherwise" sourceRef="ba_sanGw" targetRef="ba_rj_reject"/>
    <sequenceFlow id="ifms_budget_allocation_f10" sourceRef="ba_sanction" targetRef="ba_sanGw"/>
    <sequenceFlow id="ifms_budget_allocation_f11" name="DONE" sourceRef="ba_exGw" targetRef="ba_holds"><conditionExpression xsi:type="tFormalExpression">${executionOutcome == 'DONE'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_budget_allocation_f12" name="otherwise" sourceRef="ba_exGw" targetRef="ba_rj_reject"/>
    <sequenceFlow id="ifms_budget_allocation_f13" sourceRef="ba_post" targetRef="ba_exGw"/>
    <sequenceFlow id="ifms_budget_allocation_f14" sourceRef="ba_holds" targetRef="ba_close"/>
    <sequenceFlow id="ifms_budget_allocation_f15" sourceRef="ba_close" targetRef="ba_end"/>
    <subProcess id="ba_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="ba_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="ba_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="ba_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="ba_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="ifms_budget_allocation_f16" sourceRef="ba_withdrawStart" targetRef="ba_withdrawKind"/>
      <sequenceFlow id="ifms_budget_allocation_f17" sourceRef="ba_withdrawKind" targetRef="ba_withdrawCall"/>
      <sequenceFlow id="ifms_budget_allocation_f18" sourceRef="ba_withdrawCall" targetRef="ba_withdrawEnd"/>
    </subProcess>
    <subProcess id="ba_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="ba_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="ba_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="ba_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="ba_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="ifms_budget_allocation_f19" sourceRef="ba_cancelStart" targetRef="ba_cancelKind"/>
      <sequenceFlow id="ifms_budget_allocation_f20" sourceRef="ba_cancelKind" targetRef="ba_cancelCall"/>
      <sequenceFlow id="ifms_budget_allocation_f21" sourceRef="ba_cancelCall" targetRef="ba_cancelEnd"/>
    </subProcess>
  </process>
