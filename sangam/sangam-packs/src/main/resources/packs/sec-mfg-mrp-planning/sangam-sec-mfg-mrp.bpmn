<!-- MRP run. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_sec_mfg_mrp" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <process id="sangam-sec-mfg-mrp" name="MRP run" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.mfg.mrp-planning</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>period</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="mr_timer" name="Weekly"><timerEventDefinition><timeCycle xsi:type="tFormalExpression">0 0 2 ? * MON</timeCycle></timerEventDefinition></startEvent>
    <serviceTask id="mr_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>plannerSeat=PLANNER</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="mr_run" name="Run MRP" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>erp.mrpRun</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>run</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>mrp</operaton:string></operaton:field><operaton:field name="step"><operaton:string>mrp-run</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="mr_review" name="Review exception messages" operaton:candidateGroups="${plannerSeat}" operaton:formKey="sangam:sec-mfg-mrp-planning/review"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="mr_load" name="Planned orders" operaton:class="org.sangam.packs.core.BatchDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>LOAD</operaton:string></operaton:field><operaton:field name="connector"><operaton:string>erp.plannedOrders</operaton:string></operaton:field><operaton:field name="sampleSize"><operaton:string>3</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="mr_open" name="Open round" operaton:class="org.sangam.packs.core.BatchDelegate"><extensionElements><operaton:field name="op"><operaton:string>OPEN</operaton:string></operaton:field><operaton:field name="itemsVar"><operaton:string>items</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="mr_fanOut" name="Start one instance per item (chunk)" operaton:class="org.sangam.packs.core.BatchDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>FAN_OUT</operaton:string></operaton:field><operaton:field name="itemsVar"><operaton:string>items</operaton:string></operaton:field><operaton:field name="childProcessKey"><operaton:string>sangam-sec-mfg-planned-order</operaton:string></operaton:field><operaton:field name="chunkSize"><operaton:string>100</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="mr_fanGw" name="All started?" default="sec_mfg_mrp_f8"></exclusiveGateway>
    <intermediateCatchEvent id="mr_poll" name="Poll aggregate"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">PT30M</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <serviceTask id="mr_aggregate" name="Aggregate outcomes" operaton:class="org.sangam.packs.core.BatchDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>AGGREGATE</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="mr_doneGw" name="Round complete?" default="sec_mfg_mrp_f13"></exclusiveGateway>
    <endEvent id="mr_end" name="Run closed"></endEvent>
    <sequenceFlow id="sec_mfg_mrp_f1" sourceRef="mr_timer" targetRef="mr_defaults"/>
    <sequenceFlow id="sec_mfg_mrp_f2" sourceRef="mr_defaults" targetRef="mr_run"/>
    <sequenceFlow id="sec_mfg_mrp_f3" sourceRef="mr_run" targetRef="mr_review"/>
    <sequenceFlow id="sec_mfg_mrp_f4" sourceRef="mr_review" targetRef="mr_load"/>
    <sequenceFlow id="sec_mfg_mrp_f5" sourceRef="mr_open" targetRef="mr_fanOut"/>
    <sequenceFlow id="sec_mfg_mrp_f6" sourceRef="mr_fanOut" targetRef="mr_fanGw"/>
    <sequenceFlow id="sec_mfg_mrp_f7" name="next chunk" sourceRef="mr_fanGw" targetRef="mr_fanOut"><conditionExpression xsi:type="tFormalExpression">${!fanOutDone}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_mfg_mrp_f8" name="all started" sourceRef="mr_fanGw" targetRef="mr_poll"/>
    <sequenceFlow id="sec_mfg_mrp_f9" sourceRef="mr_poll" targetRef="mr_aggregate"/>
    <sequenceFlow id="sec_mfg_mrp_f10" sourceRef="mr_aggregate" targetRef="mr_doneGw"/>
    <sequenceFlow id="sec_mfg_mrp_f11" name="not yet" sourceRef="mr_doneGw" targetRef="mr_poll"><conditionExpression xsi:type="tFormalExpression">${!batchComplete}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_mfg_mrp_f12" sourceRef="mr_load" targetRef="mr_open"/>
    <sequenceFlow id="sec_mfg_mrp_f13" name="complete" sourceRef="mr_doneGw" targetRef="mr_end"/>
  </process>
