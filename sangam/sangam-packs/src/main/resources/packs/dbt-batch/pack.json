{
  "id": "gov.dbt.batch",
  "version": "1.0.2",
  "name": {
    "en": "DBT batch with partial failure",
    "hi": "आंशिक विफलता सहित डीबीटी बैच"
  },
  "domain": "Scheme / DBT",
  "description": "A sanctioned beneficiary list is paid as one instance per beneficiary (GP-09), the parent aggregates the outcomes, each failure is routed by reason code to its desk and only the failures are resent in the next round (GP-49).",
  "mainProcesses": [
    "sangam-dbt-batch"
  ],
  "resources": [
    {
      "kind": "BPMN",
      "path": "packs/dbt-batch/sangam-dbt-batch.bpmn"
    },
    {
      "kind": "BPMN",
      "path": "packs/dbt-batch/sangam-dbt-beneficiary-payment.bpmn"
    },
    {
      "kind": "DMN",
      "path": "packs/dbt-batch/dbt-failure-routing.dmn"
    },
    {
      "kind": "FORM",
      "path": "packs/dbt-batch/forms/batch.form.json"
    },
    {
      "kind": "FORM",
      "path": "packs/dbt-batch/forms/review-failures.form.json"
    },
    {
      "kind": "FORM",
      "path": "packs/dbt-batch/forms/prepare-sanction-note.form.json"
    },
    {
      "kind": "FORM",
      "path": "packs/dbt-batch/forms/fix-record.form.json"
    },
    {
      "kind": "SEED",
      "path": "packs/dbt-batch/seed.json"
    },
    {
      "kind": "OTHER",
      "path": "packs/dbt-batch/pack.json"
    }
  ],
  "seed": "packs/dbt-batch/seed.json",
  "connectors": [
    {
      "id": "dbt.beneficiaryList",
      "moneyMovement": "NONE",
      "capabilityClass": "a",
      "govTag": "G-PFMS",
      "purpose": "Sanctioned list for the period"
    },
    {
      "id": "pfms.dbt",
      "moneyMovement": "OUT",
      "capabilityClass": "c",
      "govTag": "G-PFMS",
      "purpose": "DBT record",
      "simulatorBinding": {
        "connector": "pfms-sim",
        "operation": "pay"
      }
    },
    {
      "id": "bank.statement",
      "moneyMovement": "NONE",
      "capabilityClass": "b",
      "govTag": "G-PFMS",
      "purpose": "Credit confirmation"
    }
  ],
  "covers": [
    "GP-08",
    "GP-09",
    "GP-12",
    "GP-49",
    "D-DBT-SCHEME",
    "R58"
  ],
  "acceptance": [
    {
      "id": "GP-49",
      "title": "Partial batch failure resends only the failures",
      "refs": [
        "GP-09",
        "GP-49"
      ],
      "given": "five beneficiaries, two fail with ACCOUNT_CLOSED",
      "when": "the bank desk corrects; the cell resends",
      "then": "round 2 has exactly the two corrected items",
      "startVariables": {
        "schemeId": "PM-KISAN-LIKE",
        "sim_pfms_dbt": "FAILED:ACCOUNT_CLOSED @ :1:ITEM-00002|:1:ITEM-00004"
      },
      "expectState": null,
      "run": {
        "answers": {
          "dp_fix": {
            "vars": {
              "fixDecision": "correct",
              "correctedAccount": "50100099990001",
              "correctedIfsc": "SBIN0001234"
            }
          },
          "db_review": {
            "vars": {
              "roundDecision": "resubmit"
            }
          }
        },
        "steps": [
          {
            "at": "dp_fix",
            "action": "complete",
            "n": 2
          },
          {
            "at": "db_poll",
            "advance": "PT5M"
          },
          {
            "at": "db_poll",
            "advance": "PT5M"
          }
        ],
        "expect": {
          "tasks": [
            "dp_fix",
            "dp_fix",
            "db_review"
          ],
          "audit": [
            "BATCH_ROUND_COMPLETE"
          ],
          "ended": true,
          "batchRounds": {
            "1": [
              "ITEM-00001",
              "ITEM-00002",
              "ITEM-00003",
              "ITEM-00004",
              "ITEM-00005"
            ],
            "2": [
              "ITEM-00002",
              "ITEM-00004"
            ]
          }
        }
      }
    }
  ],
  "dependsOn": [
    "sangam.core"
  ],
  "tenantOverrides": [],
  "calls": [
    "sangam-core-execution",
    "sangam-core-sanction"
  ],
  "documentSlots": [
    {
      "documentType": "SANCTION_NOTE",
      "slot": "sanctionDocumentId"
    }
  ],
  "currency": "INR",
  "powers": {
    "db_retry_bsanction": {
      "monetary": false,
      "limitTable": "sangam-core-powers",
      "ruleCaseType": "GRANT"
    },
    "db_sanction": {
      "monetary": false,
      "limitTable": "sangam-core-powers",
      "ruleCaseType": "GRANT"
    }
  }
}
