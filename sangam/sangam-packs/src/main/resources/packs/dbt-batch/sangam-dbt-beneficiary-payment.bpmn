      <bpmndi:BPMNShape id="dp_fix_di" bpmnElement="dp_fix"><dc:Bounds x="1175" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dp_fixGw_di" bpmnElement="dp_fixGw"><dc:Bounds x="1365" y="45" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dp_endFailed_di" bpmnElement="dp_endFailed"><dc:Bounds x="1537" y="177" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dp_endDropped_di" bpmnElement="dp_endDropped"><dc:Bounds x="1537" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="dbt_beneficiary_payment_f1_di" bpmnElement="dbt_beneficiary_payment_f1"><di:waypoint x="88" y="70"/><di:waypoint x="185" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="dbt_beneficiary_payment_f2_di" bpmnElement="dbt_beneficiary_payment_f2"><di:waypoint x="285" y="70"/><di:waypoint x="375" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="dbt_beneficiary_payment_f3_di" bpmnElement="dbt_beneficiary_payment_f3"><di:waypoint x="425" y="70"/><di:waypoint x="515" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="dbt_beneficiary_payment_f4_di" bpmnElement="dbt_beneficiary_payment_f4"><di:waypoint x="425" y="70"/><di:waypoint x="680" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="dbt_beneficiary_payment_f5_di" bpmnElement="dbt_beneficiary_payment_f5"><di:waypoint x="615" y="70"/><di:waypoint x="680" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="dbt_beneficiary_payment_f6_di" bpmnElement="dbt_beneficiary_payment_f6"><di:waypoint x="920" y="70"/><di:waypoint x="981" y="70"/><di:waypoint x="981" y="195"/><di:waypoint x="1042" y="195"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="dbt_beneficiary_payment_f7_di" bpmnElement="dbt_beneficiary_payment_f7"><di:waypoint x="920" y="70"/><di:waypoint x="1010" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="dbt_beneficiary_payment_f8_di" bpmnElement="dbt_beneficiary_payment_f8"><di:waypoint x="780" y="70"/><di:waypoint x="870" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="dbt_beneficiary_payment_f9_di" bpmnElement="dbt_beneficiary_payment_f9"><di:waypoint x="1110" y="70"/><di:waypoint x="1175" y="70"/></bpmndi:BPMNEdge>
