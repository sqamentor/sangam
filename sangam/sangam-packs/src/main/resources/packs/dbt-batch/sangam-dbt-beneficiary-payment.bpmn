<!-- DBT payment for one beneficiary. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_dbt_beneficiary_payment" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <process id="sangam-dbt-beneficiary-payment" name="DBT payment for one beneficiary" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <documentation>Child of the GP-09 pattern: one record, its own operationId and state; failures are corrected at the desk chosen by the reason code (GP-49) and recorded for the next round.</documentation>
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.dbt.batch</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>key,bankAccount,ifsc,amount</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="dp_start" name="Item started"></startEvent>
    <serviceTask id="dp_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>executionConnector=pfms.dbt;executionOperation=submitDbtRecord;executionStep=dbt;verifyApproval=false;reconcileRequired=true;bankAccount=;ifsc=;amount=0;correctedAccount=null;correctedIfsc=null</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="dp_corrGw" name="Corrected in a previous round?" default="dbt_beneficiary_payment_f4"></exclusiveGateway>
    <serviceTask id="dp_applyFix" name="Use corrected account" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>bankAccount=@correctedAccount;ifsc=@correctedIfsc</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="dp_execute" name="DBT record (core execution)" calledElement="sangam-core-execution"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="dp_endPaid" name="Credited"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <businessRuleTask id="dp_route" name="Route failure by reason (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>dbt-failure-routing</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <exclusiveGateway id="dp_exGw" name="executionOutcome?" default="dbt_beneficiary_payment_f7"></exclusiveGateway>
    <userTask id="dp_fix" name="Correct failed record" operaton:candidateGroups="${failureDesk}" operaton:formKey="sangam:dbt-batch/fix-record"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>fixDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="dp_fixGw" name="" default="dbt_beneficiary_payment_f12"></exclusiveGateway>
    <endEvent id="dp_endFailed" name="Failed, corrected for resend"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>FAILED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>opReasonCode</operaton:string></operaton:field><operaton:field name="dataVars"><operaton:string>correctedAccount,correctedIfsc</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <endEvent id="dp_endDropped" name="Dropped"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>DROPPED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>opReasonCode</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <sequenceFlow id="dbt_beneficiary_payment_f1" sourceRef="dp_start" targetRef="dp_defaults"/>
    <sequenceFlow id="dbt_beneficiary_payment_f2" sourceRef="dp_defaults" targetRef="dp_corrGw"/>
    <sequenceFlow id="dbt_beneficiary_payment_f3" name="corrected" sourceRef="dp_corrGw" targetRef="dp_applyFix"><conditionExpression xsi:type="tFormalExpression">${correctedAccount != null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="dbt_beneficiary_payment_f4" sourceRef="dp_corrGw" targetRef="dp_execute"/>
    <sequenceFlow id="dbt_beneficiary_payment_f5" sourceRef="dp_applyFix" targetRef="dp_execute"/>
    <sequenceFlow id="dbt_beneficiary_payment_f6" name="DONE" sourceRef="dp_exGw" targetRef="dp_endPaid"><conditionExpression xsi:type="tFormalExpression">${executionOutcome == 'DONE'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="dbt_beneficiary_payment_f7" name="otherwise" sourceRef="dp_exGw" targetRef="dp_route"/>
    <sequenceFlow id="dbt_beneficiary_payment_f8" sourceRef="dp_execute" targetRef="dp_exGw"/>
    <sequenceFlow id="dbt_beneficiary_payment_f9" sourceRef="dp_route" targetRef="dp_fix"/>
    <sequenceFlow id="dbt_beneficiary_payment_f10" sourceRef="dp_fix" targetRef="dp_fixGw"/>
    <sequenceFlow id="dbt_beneficiary_payment_f11" name="correct" sourceRef="dp_fixGw" targetRef="dp_endFailed"><conditionExpression xsi:type="tFormalExpression">${fixDecision == 'correct'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="dbt_beneficiary_payment_f12" name="drop" sourceRef="dp_fixGw" targetRef="dp_endDropped"/>
  </process>
  <bpmndi:BPMNDiagram id="dbt_beneficiary_payment_diagram">
    <bpmndi:BPMNPlane id="dbt_beneficiary_payment_plane" bpmnElement="sangam-dbt-beneficiary-payment">
