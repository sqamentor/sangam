<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- Examination cycle. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_sec_edu_exam_cycle" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <process id="sangam-sec-edu-exam-cycle" name="Examination cycle" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.edu.examination</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>examName,programme</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="ex_start" name="Examination notified" operaton:initiator="initiator" operaton:formKey="sangam:sec-edu-examination/notify"></startEvent>
    <serviceTask id="ex_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>examName=@customerId;programme=BA;registrationWindow=P15D;committeeSeats=RESULT-COMM-1,RESULT-COMM-2,RESULT-COMM-3;quorumRule=MAJORITY;coeSeat=CONTROLLER</operaton:string></operaton:field></extensionElements></serviceTask>
    <intermediateCatchEvent id="ex_regClose" name="Registration closes"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">${registrationWindow}</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <serviceTask id="ex_hall" name="Issue hall tickets" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>exam.hallTickets</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>issue</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>examName</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>hall</operaton:string></operaton:field><operaton:field name="step"><operaton:string>hall-tickets</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="ex_conduct" name="Conduct examination" operaton:candidateGroups="${coeSeat}" operaton:formKey="sangam:sec-edu-examination/conduct"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <userTask id="ex_evaluate" name="Evaluation and marks entry" operaton:candidateGroups="EVALUATOR" operaton:formKey="sangam:sec-edu-examination/evaluate"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <callActivity id="ex_moderate" name="Result committee moderation (core committee)" calledElement="sangam-core-committee"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <exclusiveGateway id="ex_modGw" name="" default="sec_edu_exam_cycle_f9"></exclusiveGateway>
    <serviceTask id="ex_publish" name="Publish results" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>exam.publish</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>publish</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>examName</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>pub</operaton:string></operaton:field><operaton:field name="step"><operaton:string>publish</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ex_nad" name="Upload to DigiLocker / NAD and ABC" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>nad.upload</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>upload</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>examName</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>nad</operaton:string></operaton:field><operaton:field name="step"><operaton:string>nad</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="ex_end" name="Results published"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <sequenceFlow id="sec_edu_exam_cycle_f1" sourceRef="ex_start" targetRef="ex_defaults"/>
    <sequenceFlow id="sec_edu_exam_cycle_f2" sourceRef="ex_defaults" targetRef="ex_regClose"/>
    <sequenceFlow id="sec_edu_exam_cycle_f3" sourceRef="ex_regClose" targetRef="ex_hall"/>
    <sequenceFlow id="sec_edu_exam_cycle_f4" sourceRef="ex_hall" targetRef="ex_conduct"/>
    <sequenceFlow id="sec_edu_exam_cycle_f5" sourceRef="ex_conduct" targetRef="ex_evaluate"/>
    <sequenceFlow id="sec_edu_exam_cycle_f6" sourceRef="ex_evaluate" targetRef="ex_moderate"/>
    <sequenceFlow id="sec_edu_exam_cycle_f7" sourceRef="ex_moderate" targetRef="ex_modGw"/>
    <sequenceFlow id="sec_edu_exam_cycle_f8" name="re-evaluate" sourceRef="ex_modGw" targetRef="ex_evaluate"><conditionExpression xsi:type="tFormalExpression">${!committeeApproved}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_edu_exam_cycle_f9" name="approved" sourceRef="ex_modGw" targetRef="ex_publish"/>
    <sequenceFlow id="sec_edu_exam_cycle_f10" sourceRef="ex_publish" targetRef="ex_nad"/>
    <sequenceFlow id="sec_edu_exam_cycle_f11" sourceRef="ex_nad" targetRef="ex_end"/>
  </process>
  <bpmndi:BPMNDiagram id="sec_edu_exam_cycle_diagram">
    <bpmndi:BPMNPlane id="sec_edu_exam_cycle_plane" bpmnElement="sangam-sec-edu-exam-cycle">
      <bpmndi:BPMNShape id="ex_start_di" bpmnElement="ex_start"><dc:Bounds x="52" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ex_defaults_di" bpmnElement="ex_defaults"><dc:Bounds x="185" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ex_regClose_di" bpmnElement="ex_regClose"><dc:Bounds x="382" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ex_hall_di" bpmnElement="ex_hall"><dc:Bounds x="515" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ex_conduct_di" bpmnElement="ex_conduct"><dc:Bounds x="680" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ex_evaluate_di" bpmnElement="ex_evaluate"><dc:Bounds x="845" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ex_moderate_di" bpmnElement="ex_moderate"><dc:Bounds x="1010" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ex_modGw_di" bpmnElement="ex_modGw"><dc:Bounds x="1200" y="45" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ex_publish_di" bpmnElement="ex_publish"><dc:Bounds x="1340" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ex_nad_di" bpmnElement="ex_nad"><dc:Bounds x="1505" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ex_end_di" bpmnElement="ex_end"><dc:Bounds x="1702" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="sec_edu_exam_cycle_f1_di" bpmnElement="sec_edu_exam_cycle_f1"><di:waypoint x="88" y="70"/><di:waypoint x="185" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sec_edu_exam_cycle_f2_di" bpmnElement="sec_edu_exam_cycle_f2"><di:waypoint x="285" y="70"/><di:waypoint x="382" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sec_edu_exam_cycle_f3_di" bpmnElement="sec_edu_exam_cycle_f3"><di:waypoint x="418" y="70"/><di:waypoint x="515" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sec_edu_exam_cycle_f4_di" bpmnElement="sec_edu_exam_cycle_f4"><di:waypoint x="615" y="70"/><di:waypoint x="680" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sec_edu_exam_cycle_f5_di" bpmnElement="sec_edu_exam_cycle_f5"><di:waypoint x="780" y="70"/><di:waypoint x="845" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sec_edu_exam_cycle_f6_di" bpmnElement="sec_edu_exam_cycle_f6"><di:waypoint x="945" y="70"/><di:waypoint x="1010" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sec_edu_exam_cycle_f7_di" bpmnElement="sec_edu_exam_cycle_f7"><di:waypoint x="1110" y="70"/><di:waypoint x="1200" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sec_edu_exam_cycle_f8_di" bpmnElement="sec_edu_exam_cycle_f8"><di:waypoint x="1225" y="95"/><di:waypoint x="1225" y="149"/><di:waypoint x="895" y="149"/><di:waypoint x="895" y="110"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sec_edu_exam_cycle_f9_di" bpmnElement="sec_edu_exam_cycle_f9"><di:waypoint x="1250" y="70"/><di:waypoint x="1340" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sec_edu_exam_cycle_f10_di" bpmnElement="sec_edu_exam_cycle_f10"><di:waypoint x="1440" y="70"/><di:waypoint x="1505" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sec_edu_exam_cycle_f11_di" bpmnElement="sec_edu_exam_cycle_f11"><di:waypoint x="1605" y="70"/><di:waypoint x="1702" y="70"/></bpmndi:BPMNEdge>
