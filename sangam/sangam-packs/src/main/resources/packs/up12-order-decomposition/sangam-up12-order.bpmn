    <sequenceFlow id="up12_order_f4" name="next chunk" sourceRef="u12_fanGw" targetRef="u12_fanOut"><conditionExpression xsi:type="tFormalExpression">${!fanOutDone}</conditionExpression></sequenceFlow>
    <sequenceFlow id="up12_order_f5" name="all started" sourceRef="u12_fanGw" targetRef="u12_poll"/>
