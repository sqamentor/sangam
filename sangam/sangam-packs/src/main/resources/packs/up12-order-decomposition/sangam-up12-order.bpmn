    <sequenceFlow id="up12_order_f10" name="complete" sourceRef="u12_doneGw" targetRef="u12_partialGw"/>
    <sequenceFlow id="up12_order_f11" name="some lines failed" sourceRef="u12_partialGw" targetRef="u12_partial"><conditionExpression xsi:type="tFormalExpression">${batchFailed &gt; 0}</conditionExpression></sequenceFlow>
    <sequenceFlow id="up12_order_f12" name="all lines" sourceRef="u12_partialGw" targetRef="u12_end"/>
