    <endEvent id="u12_end" name="Fulfilled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <sequenceFlow id="up12_order_f1" sourceRef="u12_start" targetRef="u12_lines"/>
