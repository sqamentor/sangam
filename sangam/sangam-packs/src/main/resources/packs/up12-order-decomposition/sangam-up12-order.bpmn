      <exclusiveGateway id="u12_am_notifyGw" name="All notified?" default="up12_order_f17"></exclusiveGateway>
      <endEvent id="u12_amEnd" name="Amendment sent"></endEvent>
      <sequenceFlow id="up12_order_f14" sourceRef="u12_am_notify" targetRef="u12_am_notifyGw"/>
      <sequenceFlow id="up12_order_f15" name="next chunk" sourceRef="u12_am_notifyGw" targetRef="u12_am_notify"><conditionExpression xsi:type="tFormalExpression">${!notifyDone}</conditionExpression></sequenceFlow>
      <sequenceFlow id="up12_order_f16" sourceRef="u12_amStart" targetRef="u12_am_notify"/>
      <sequenceFlow id="up12_order_f17" name="all told" sourceRef="u12_am_notifyGw" targetRef="u12_amEnd"/>
    </subProcess>
