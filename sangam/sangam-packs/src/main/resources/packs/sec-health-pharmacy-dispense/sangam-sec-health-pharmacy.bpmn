    <serviceTask id="ph_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>patientName=@customerId;prescriptionRef=@customerId;drugSchedule=H;prescriberRegNo=NMR-X;prescriberValid=true;pharmacistSeat=PHARMACIST</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="ph_rule" name="Schedule controls (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-health-drug-control</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <serviceTask id="ph_nmr" name="Verify prescriber on NMR" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>nmr.verify</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>verify</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>prescriberRegNo</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>prescriber</operaton:string></operaton:field></extensionElements></serviceTask>
