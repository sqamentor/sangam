    <sequenceFlow id="sec_health_pharmacy_f1" sourceRef="ph_start" targetRef="ph_defaults"/>
    <sequenceFlow id="sec_health_pharmacy_f2" sourceRef="ph_defaults" targetRef="ph_rule"/>
    <sequenceFlow id="sec_health_pharmacy_f3" name="yes" sourceRef="ph_rxOptGw" targetRef="ph_nmr"><conditionExpression xsi:type="tFormalExpression">${prescriptionRequired}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_health_pharmacy_f4" name="no" sourceRef="ph_rxOptGw" targetRef="ph_rxOptMerge"/>
    <sequenceFlow id="sec_health_pharmacy_f5" sourceRef="ph_nmr" targetRef="ph_rxOptMerge"/>
    <sequenceFlow id="sec_health_pharmacy_f6" sourceRef="ph_rule" targetRef="ph_rxOptGw"/>
    <sequenceFlow id="sec_health_pharmacy_f7" sourceRef="ph_rxOptMerge" targetRef="ph_validGw"/>
    <sequenceFlow id="sec_health_pharmacy_f8" sourceRef="ph_rjRx_reject" targetRef="ph_rjRx_endRejected"/>
    <sequenceFlow id="sec_health_pharmacy_f9" sourceRef="ph_rjRx_code" targetRef="ph_rjRx_reject"/>
    <sequenceFlow id="sec_health_pharmacy_f10" name="no" sourceRef="ph_validGw" targetRef="ph_rjRx_code"><conditionExpression xsi:type="tFormalExpression">${prescriptionRequired &amp;&amp; !prescriberValid}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_health_pharmacy_f11" name="yes" sourceRef="ph_validGw" targetRef="ph_review"/>
    <sequenceFlow id="sec_health_pharmacy_f12" sourceRef="ph_review" targetRef="ph_revGw"/>
    <sequenceFlow id="sec_health_pharmacy_f13" name="clarify" sourceRef="ph_revGw" targetRef="ph_ask"><conditionExpression xsi:type="tFormalExpression">${rxDecision == 'clarify'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_health_pharmacy_f14" sourceRef="ph_ask" targetRef="ph_answer"/>
    <sequenceFlow id="sec_health_pharmacy_f15" sourceRef="ph_answer" targetRef="ph_review"/>
    <sequenceFlow id="sec_health_pharmacy_f16" name="refuse" sourceRef="ph_revGw" targetRef="ph_endRefused"><conditionExpression xsi:type="tFormalExpression">${rxDecision == 'refuse'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_health_pharmacy_f17" name="yes" sourceRef="ph_dualGw" targetRef="ph_second"><conditionExpression xsi:type="tFormalExpression">${dualCheck}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_health_pharmacy_f18" name="no" sourceRef="ph_dualGw" targetRef="ph_dualMerge"/>
    <sequenceFlow id="sec_health_pharmacy_f19" sourceRef="ph_second" targetRef="ph_dualMerge"/>
    <sequenceFlow id="sec_health_pharmacy_f20" name="dispense" sourceRef="ph_revGw" targetRef="ph_dualGw"/>
    <sequenceFlow id="sec_health_pharmacy_f21" sourceRef="ph_dualMerge" targetRef="ph_issue"/>
    <sequenceFlow id="sec_health_pharmacy_f22" name="yes" sourceRef="ph_regOptGw" targetRef="ph_register"><conditionExpression xsi:type="tFormalExpression">${registerRequired}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_health_pharmacy_f23" name="no" sourceRef="ph_regOptGw" targetRef="ph_regOptMerge"/>
    <sequenceFlow id="sec_health_pharmacy_f24" sourceRef="ph_register" targetRef="ph_regOptMerge"/>
    <sequenceFlow id="sec_health_pharmacy_f25" sourceRef="ph_issue" targetRef="ph_regOptGw"/>
    <sequenceFlow id="sec_health_pharmacy_f26" sourceRef="ph_regOptMerge" targetRef="ph_end"/>
  </process>
