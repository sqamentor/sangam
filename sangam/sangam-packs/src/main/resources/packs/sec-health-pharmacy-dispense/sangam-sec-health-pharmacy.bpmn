    <serviceTask id="ph_register" name="Register entry (retain 3 years)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>docs.register</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>h1</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>patientName,prescriberRegNo,prescriptionRef,quantity</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>register</operaton:string></operaton:field><operaton:field name="step"><operaton:string>register</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="ph_regOptGw" name="Register required?" default="sec_health_pharmacy_f23"></exclusiveGateway>
    <exclusiveGateway id="ph_regOptMerge" name=""></exclusiveGateway>
