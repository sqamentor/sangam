    <exclusiveGateway id="ph_rxOptMerge" name=""></exclusiveGateway>
    <exclusiveGateway id="ph_validGw" name="Prescriber valid?" default="sec_health_pharmacy_f11"></exclusiveGateway>
    <serviceTask id="ph_rjRx_code" name="Reason: PRESCRIBER_NOT_VERIFIED" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=PRESCRIBER_NOT_VERIFIED</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="ph_rjRx_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="ph_rjRx_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <userTask id="ph_review" name="Pharmacist review" operaton:candidateGroups="${pharmacistSeat}" operaton:formKey="sangam:sec-health-pharmacy-dispense/review"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>rxDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
