    <intermediateCatchEvent id="ph_answer" name="Prescriber answers"><messageEventDefinition messageRef="msg_sangam_rx_clarified"/></intermediateCatchEvent>
    <endEvent id="ph_endRefused" name="Refused (reasons recorded)"></endEvent>
    <userTask id="ph_second" name="Second pharmacist check (X / NDPS)" operaton:candidateGroups="PHARMACIST-2" operaton:formKey="sangam:sec-health-pharmacy-dispense/second"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
