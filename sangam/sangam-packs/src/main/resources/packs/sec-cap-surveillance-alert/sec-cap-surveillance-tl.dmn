<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_sec_cap_surveillance_tl" name="Alert processing timeline (exchange circulars; verify)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="sec-cap-surveillance-tl" name="Alert processing timeline (exchange circulars; verify)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="sec-cap-surveillance-tl_t" hitPolicy="FIRST">
      <input id="sec-cap-surveillance-tl_i0" label="Alert type"><inputExpression id="sec-cap-surveillance-tl_ie0" typeRef="string"><text>alertType</text></inputExpression></input>
      <output id="sec-cap-surveillance-tl_o0" label="Process within" name="alertProcessSpec" typeRef="string"/>
      <rule id="sec-cap-surveillance-tl_r0"><description>alerts processed within 45 days of generation (verify)</description>
        <inputEntry id="sec-cap-surveillance-tl_r0_i0"><text>-</text></inputEntry>
        <outputEntry id="sec-cap-surveillance-tl_r0_o0"><text>"45D"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
