<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- Surveillance alert. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_sec_cap_surveillance" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_clarificationReceived" name="sangam.clarificationReceived"/>
  <process id="sangam-sec-cap-surveillance" name="Surveillance alert" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.cap.surveillance-alert</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>clientCode,alertType</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="sv_start" name="Alert received" operaton:initiator="initiator" operaton:formKey="sangam:sec-cap-surveillance-alert/alert"></startEvent>
    <serviceTask id="sv_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>clientCode=@customerId;alertType=VOLUME_SPIKE;analystSeat=SURV-ANALYST;coSeat=COMPLIANCE-OFFICER;applicantRef=@clientCode</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="sv_clock" name="Regulatory clock: alert" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>alert</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${alertProcessSpec}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="sv_tl" name="Processing timeline (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-cap-surveillance-tl</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <serviceTask id="sv_review_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>sv_review</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${alertProcessSpec}</operaton:expression></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="sv_review" name="Review alert and client trading" operaton:candidateGroups="${analystSeat}" operaton:formKey="sangam:sec-cap-surveillance-alert/review" operaton:dueDate="${sv_reviewDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>svDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="sv_review_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>sv_review</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>analystSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="sv_review_warnEnd" name="Warned"></endEvent>
    <serviceTask id="sv_review_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>sv_review</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>analystSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>svDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="sv_review_breachGw" name="Deemed?" default="sec_cap_surveillance_f9"></exclusiveGateway>
    <exclusiveGateway id="sv_review_done" name=""></exclusiveGateway>
    <exclusiveGateway id="sv_gw" name="" default="sec_cap_surveillance_f21"></exclusiveGateway>
    <serviceTask id="sv_ask" name="Seek client clarification" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>surveillance-clarification</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>email</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>applicantRef</operaton:string></operaton:field></extensionElements></serviceTask>
    <eventBasedGateway id="sv_wait" name="Reply or lapse"></eventBasedGateway>
    <intermediateCatchEvent id="sv_reply" name="Client replies"><messageEventDefinition messageRef="msg_sangam_clarificationReceived"/></intermediateCatchEvent>
    <intermediateCatchEvent id="sv_lapse" name="No reply in 7 days"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">P7D</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <userTask id="sv_co" name="Compliance officer decision" operaton:candidateGroups="${coSeat}" operaton:formKey="sangam:sec-cap-surveillance-alert/decide"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>coDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <endEvent id="sv_endClosed" name="Closed with reasons"></endEvent>
    <exclusiveGateway id="sv_coGw" name="" default="sec_cap_surveillance_f27"></exclusiveGateway>
    <serviceTask id="sv_report" name="Report adverse observation to the exchange" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>exchange.report</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>report</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>clientCode,alertType</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>exRep</operaton:string></operaton:field><operaton:field name="step"><operaton:string>exchange-report</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="sv_str" name="File STR" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>fiu.finnet</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>str</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>clientCode,strGrounds</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>str</operaton:string></operaton:field><operaton:field name="step"><operaton:string>str</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="sv_end" name="Reported"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <endEvent id="sv_endCo" name="Closed by compliance"></endEvent>
    <boundaryEvent id="sv_review_warn" name="SLA warning (75%)" attachedToRef="sv_review" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${sv_reviewWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="sv_review_breach" name="SLA breached" attachedToRef="sv_review" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${sv_reviewDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="sec_cap_surveillance_f1" sourceRef="sv_start" targetRef="sv_defaults"/>
    <sequenceFlow id="sec_cap_surveillance_f2" sourceRef="sv_defaults" targetRef="sv_tl"/>
    <sequenceFlow id="sec_cap_surveillance_f3" sourceRef="sv_tl" targetRef="sv_clock"/>
    <sequenceFlow id="sec_cap_surveillance_f4" sourceRef="sv_review_warn" targetRef="sv_review_warnNotify"/>
    <sequenceFlow id="sec_cap_surveillance_f5" sourceRef="sv_review_warnNotify" targetRef="sv_review_warnEnd"/>
    <sequenceFlow id="sec_cap_surveillance_f6" sourceRef="sv_review_breach" targetRef="sv_review_breachAct"/>
    <sequenceFlow id="sec_cap_surveillance_f7" sourceRef="sv_review_breachAct" targetRef="sv_review_breachGw"/>
    <sequenceFlow id="sec_cap_surveillance_f8" name="deemed" sourceRef="sv_review_breachGw" targetRef="sv_review_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_cap_surveillance_f9" name="escalated" sourceRef="sv_review_breachGw" targetRef="sv_review_slaPlan"/>
    <sequenceFlow id="sec_cap_surveillance_f10" sourceRef="sv_review_slaPlan" targetRef="sv_review"/>
    <sequenceFlow id="sec_cap_surveillance_f11" sourceRef="sv_review" targetRef="sv_review_done"/>
    <sequenceFlow id="sec_cap_surveillance_f12" sourceRef="sv_clock" targetRef="sv_review_slaPlan"/>
    <sequenceFlow id="sec_cap_surveillance_f13" sourceRef="sv_review_done" targetRef="sv_gw"/>
    <sequenceFlow id="sec_cap_surveillance_f14" name="clarify" sourceRef="sv_gw" targetRef="sv_ask"><conditionExpression xsi:type="tFormalExpression">${svDecision == 'clarify'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_cap_surveillance_f15" sourceRef="sv_ask" targetRef="sv_wait"/>
    <sequenceFlow id="sec_cap_surveillance_f16" sourceRef="sv_wait" targetRef="sv_reply"/>
    <sequenceFlow id="sec_cap_surveillance_f17" sourceRef="sv_wait" targetRef="sv_lapse"/>
    <sequenceFlow id="sec_cap_surveillance_f18" sourceRef="sv_reply" targetRef="sv_review_slaPlan"/>
    <sequenceFlow id="sec_cap_surveillance_f19" name="escalate" sourceRef="sv_gw" targetRef="sv_co"><conditionExpression xsi:type="tFormalExpression">${svDecision == 'escalate'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_cap_surveillance_f20" sourceRef="sv_lapse" targetRef="sv_co"/>
    <sequenceFlow id="sec_cap_surveillance_f21" name="close" sourceRef="sv_gw" targetRef="sv_endClosed"/>
    <sequenceFlow id="sec_cap_surveillance_f22" sourceRef="sv_co" targetRef="sv_coGw"/>
    <sequenceFlow id="sec_cap_surveillance_f23" name="report" sourceRef="sv_coGw" targetRef="sv_report"><conditionExpression xsi:type="tFormalExpression">${coDecision == 'report'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_cap_surveillance_f24" name="STR" sourceRef="sv_coGw" targetRef="sv_str"><conditionExpression xsi:type="tFormalExpression">${coDecision == 'fileStr'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_cap_surveillance_f25" sourceRef="sv_str" targetRef="sv_report"/>
    <sequenceFlow id="sec_cap_surveillance_f26" sourceRef="sv_report" targetRef="sv_end"/>
    <sequenceFlow id="sec_cap_surveillance_f27" name="close" sourceRef="sv_coGw" targetRef="sv_endCo"/>
  </process>
  <bpmndi:BPMNDiagram id="sec_cap_surveillance_diagram">
