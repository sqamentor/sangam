  <message id="msg_sangam_cheque_paid" name="sangam.cheque.paid"/>
  <process id="sangam-sec-bank-cheque-return" name="Cheque return" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.bank.cheque-return</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>chequeNo,amount,returnReason</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="cq_start" name="Cheque returned in clearing" operaton:initiator="initiator" operaton:formKey="sangam:sec-bank-cheque-return/return"></startEvent>
    <serviceTask id="cq_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>chequeNo=@customerId;returnReason=FUNDS_INSUFFICIENT;drawerName=X;returnCount=1;payeeSeat=PAYEE-DESK;applicantRef=@customerId</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="cq_memo" name="Return memo with reason" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>cts.returnMemo</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>memo</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>chequeNo,returnReason</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>memo</operaton:string></operaton:field><operaton:field name="step"><operaton:string>memo</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="cq_notify" name="Tell the customer the same day" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>cheque-returned</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>sms,email</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>applicantRef</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="cq_rule" name="Charges and repeated dishonour (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-bank-cheque-rules</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <userTask id="cq_withdraw" name="Withdraw cheque facility (repeated dishonour)" operaton:candidateGroups="BRANCH-MGR" operaton:formKey="sangam:sec-bank-cheque-return/withdraw"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="cq_repGw" name="Repeated dishonour?" default="sec_bank_cheque_return_f6"></exclusiveGateway>
    <exclusiveGateway id="cq_repMerge" name=""></exclusiveGateway>
    <serviceTask id="cq_payee_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>cq_payee</operaton:string></operaton:field><operaton:field name="spec"><operaton:string>30D</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="cq_payee" name="Payee: legal notice or re-present (30 days)" operaton:candidateGroups="${payeeSeat}" operaton:formKey="sangam:sec-bank-cheque-return/payee" operaton:dueDate="${cq_payeeDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>payeeDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="cq_payee_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>cq_payee</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>payeeSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="cq_payee_warnEnd" name="Warned"></endEvent>
    <serviceTask id="cq_payee_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>cq_payee</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>DEEMED_REFUSAL</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>payeeSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>payeeDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>issueNotice</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>drop</operaton:string></operaton:field><operaton:field name="maxEscalations"><operaton:string>0</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="cq_payee_breachGw" name="Deemed?" default="sec_bank_cheque_return_f14"></exclusiveGateway>
    <exclusiveGateway id="cq_payee_done" name=""></exclusiveGateway>
    <exclusiveGateway id="cq_payeeGw" name="" default="sec_bank_cheque_return_f22"></exclusiveGateway>
    <serviceTask id="cq_represent" name="Re-present the cheque" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>cts.present</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>present</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>chequeNo,amount</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>present</operaton:string></operaton:field><operaton:field name="step"><operaton:string>represent</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="cq_endRepresented" name="Re-presented"></endEvent>
    <serviceTask id="cq_notice" name="Legal notice to the drawer" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>docs.notice</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>s138</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>chequeNo,amount,drawerName</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>notice</operaton:string></operaton:field><operaton:field name="step"><operaton:string>s138</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="cq_endDropped" name="No action"></endEvent>
    <eventBasedGateway id="cq_wait" name="Payment or 15 days"></eventBasedGateway>
    <intermediateCatchEvent id="cq_paid" name="Drawer paid"><messageEventDefinition messageRef="msg_sangam_cheque_paid"/></intermediateCatchEvent>
    <intermediateCatchEvent id="cq_15d" name="15 days after notice"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">P15D</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <endEvent id="cq_endPaid" name="Paid after notice"></endEvent>
    <serviceTask id="cq_complaint_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>cq_complaint</operaton:string></operaton:field><operaton:field name="spec"><operaton:string>30D</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="cq_complaint" name="File complaint before the magistrate (one month)" operaton:candidateGroups="${payeeSeat}" operaton:formKey="sangam:sec-bank-cheque-return/complaint" operaton:dueDate="${cq_complaintDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="cq_complaint_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>cq_complaint</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>payeeSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="cq_complaint_warnEnd" name="Warned"></endEvent>
    <serviceTask id="cq_complaint_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>cq_complaint</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>payeeSeat</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="cq_complaint_breachGw" name="Deemed?" default="sec_bank_cheque_return_f32"></exclusiveGateway>
    <exclusiveGateway id="cq_complaint_done" name=""></exclusiveGateway>
    <endEvent id="cq_endComplaint" name="Complaint filed"></endEvent>
    <boundaryEvent id="cq_payee_warn" name="SLA warning (75%)" attachedToRef="cq_payee" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${cq_payeeWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="cq_payee_breach" name="SLA breached" attachedToRef="cq_payee" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${cq_payeeDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="cq_complaint_warn" name="SLA warning (75%)" attachedToRef="cq_complaint" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${cq_complaintWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="cq_complaint_breach" name="SLA breached" attachedToRef="cq_complaint" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${cq_complaintDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="sec_bank_cheque_return_f1" sourceRef="cq_start" targetRef="cq_defaults"/>
    <sequenceFlow id="sec_bank_cheque_return_f2" sourceRef="cq_defaults" targetRef="cq_memo"/>
    <sequenceFlow id="sec_bank_cheque_return_f3" sourceRef="cq_memo" targetRef="cq_notify"/>
    <sequenceFlow id="sec_bank_cheque_return_f4" sourceRef="cq_notify" targetRef="cq_rule"/>
    <sequenceFlow id="sec_bank_cheque_return_f5" name="yes" sourceRef="cq_repGw" targetRef="cq_withdraw"><conditionExpression xsi:type="tFormalExpression">${withdrawChequeBook}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_cheque_return_f6" name="no" sourceRef="cq_repGw" targetRef="cq_repMerge"/>
    <sequenceFlow id="sec_bank_cheque_return_f7" sourceRef="cq_withdraw" targetRef="cq_repMerge"/>
    <sequenceFlow id="sec_bank_cheque_return_f8" sourceRef="cq_rule" targetRef="cq_repGw"/>
    <sequenceFlow id="sec_bank_cheque_return_f9" sourceRef="cq_payee_warn" targetRef="cq_payee_warnNotify"/>
    <sequenceFlow id="sec_bank_cheque_return_f10" sourceRef="cq_payee_warnNotify" targetRef="cq_payee_warnEnd"/>
    <sequenceFlow id="sec_bank_cheque_return_f11" sourceRef="cq_payee_breach" targetRef="cq_payee_breachAct"/>
    <sequenceFlow id="sec_bank_cheque_return_f12" sourceRef="cq_payee_breachAct" targetRef="cq_payee_breachGw"/>
    <sequenceFlow id="sec_bank_cheque_return_f13" name="deemed" sourceRef="cq_payee_breachGw" targetRef="cq_payee_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_cheque_return_f14" name="escalated" sourceRef="cq_payee_breachGw" targetRef="cq_payee_slaPlan"/>
    <sequenceFlow id="sec_bank_cheque_return_f15" sourceRef="cq_payee_slaPlan" targetRef="cq_payee"/>
    <sequenceFlow id="sec_bank_cheque_return_f16" sourceRef="cq_payee" targetRef="cq_payee_done"/>
    <sequenceFlow id="sec_bank_cheque_return_f17" sourceRef="cq_repMerge" targetRef="cq_payee_slaPlan"/>
    <sequenceFlow id="sec_bank_cheque_return_f18" sourceRef="cq_payee_done" targetRef="cq_payeeGw"/>
    <sequenceFlow id="sec_bank_cheque_return_f19" name="re-present" sourceRef="cq_payeeGw" targetRef="cq_represent"><conditionExpression xsi:type="tFormalExpression">${payeeDecision == 'represent'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_cheque_return_f20" sourceRef="cq_represent" targetRef="cq_endRepresented"/>
    <sequenceFlow id="sec_bank_cheque_return_f21" name="notice" sourceRef="cq_payeeGw" targetRef="cq_notice"><conditionExpression xsi:type="tFormalExpression">${payeeDecision == 'issueNotice'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_cheque_return_f22" name="drop" sourceRef="cq_payeeGw" targetRef="cq_endDropped"/>
    <sequenceFlow id="sec_bank_cheque_return_f23" sourceRef="cq_notice" targetRef="cq_wait"/>
    <sequenceFlow id="sec_bank_cheque_return_f24" sourceRef="cq_wait" targetRef="cq_paid"/>
    <sequenceFlow id="sec_bank_cheque_return_f25" sourceRef="cq_wait" targetRef="cq_15d"/>
    <sequenceFlow id="sec_bank_cheque_return_f26" sourceRef="cq_paid" targetRef="cq_endPaid"/>
    <sequenceFlow id="sec_bank_cheque_return_f27" sourceRef="cq_complaint_warn" targetRef="cq_complaint_warnNotify"/>
    <sequenceFlow id="sec_bank_cheque_return_f28" sourceRef="cq_complaint_warnNotify" targetRef="cq_complaint_warnEnd"/>
    <sequenceFlow id="sec_bank_cheque_return_f29" sourceRef="cq_complaint_breach" targetRef="cq_complaint_breachAct"/>
    <sequenceFlow id="sec_bank_cheque_return_f30" sourceRef="cq_complaint_breachAct" targetRef="cq_complaint_breachGw"/>
    <sequenceFlow id="sec_bank_cheque_return_f31" name="deemed" sourceRef="cq_complaint_breachGw" targetRef="cq_complaint_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_cheque_return_f32" name="escalated" sourceRef="cq_complaint_breachGw" targetRef="cq_complaint_slaPlan"/>
    <sequenceFlow id="sec_bank_cheque_return_f33" sourceRef="cq_complaint_slaPlan" targetRef="cq_complaint"/>
    <sequenceFlow id="sec_bank_cheque_return_f34" sourceRef="cq_complaint" targetRef="cq_complaint_done"/>
    <sequenceFlow id="sec_bank_cheque_return_f35" sourceRef="cq_15d" targetRef="cq_complaint_slaPlan"/>
    <sequenceFlow id="sec_bank_cheque_return_f36" sourceRef="cq_complaint_done" targetRef="cq_endComplaint"/>
  </process>
