    <userTask id="am_prepare" name="Prepare STR in FINnet format (7 days)" operaton:candidateGroups="${poSeat}" operaton:formKey="sangam:sec-bank-aml-str/prepare" operaton:dueDate="${am_prepareDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="am_prepare_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>am_prepare</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>poSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="am_prepare_warnEnd" name="Warned"></endEvent>
    <serviceTask id="am_prepare_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>am_prepare</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>poSeat</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="am_prepare_breachGw" name="Deemed?" default="sec_bank_aml_alert_f34"></exclusiveGateway>
    <exclusiveGateway id="am_prepare_done" name=""></exclusiveGateway>
    <serviceTask id="am_file" name="File STR on FINnet" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>fiu.finnet</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>str</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>customerId,strGrounds</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>str</operaton:string></operaton:field><operaton:field name="step"><operaton:string>str</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="am_fileGw" name="Accepted?" default="sec_bank_aml_alert_f41"></exclusiveGateway>
    <serviceTask id="am_risk" name="Raise customer risk and enhanced monitoring (no tipping-off)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>cbs.riskUpdate</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>raise</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>customerId</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>risk</operaton:string></operaton:field><operaton:field name="step"><operaton:string>risk</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="am_endFiled" name="STR filed"></endEvent>
    <boundaryEvent id="am_l1_warn" name="SLA warning (75%)" attachedToRef="am_l1" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${am_l1WarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="am_l1_breach" name="SLA breached" attachedToRef="am_l1" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${am_l1DueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="am_l2_warn" name="SLA warning (75%)" attachedToRef="am_l2" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${am_l2WarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="am_l2_breach" name="SLA breached" attachedToRef="am_l2" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${am_l2DueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="am_prepare_warn" name="SLA warning (75%)" attachedToRef="am_prepare" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${am_prepareWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="am_prepare_breach" name="SLA breached" attachedToRef="am_prepare" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${am_prepareDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="sec_bank_aml_alert_f1" sourceRef="am_start" targetRef="am_defaults"/>
    <sequenceFlow id="sec_bank_aml_alert_f2" sourceRef="am_defaults" targetRef="am_prio"/>
    <sequenceFlow id="sec_bank_aml_alert_f3" sourceRef="am_l1_warn" targetRef="am_l1_warnNotify"/>
    <sequenceFlow id="sec_bank_aml_alert_f4" sourceRef="am_l1_warnNotify" targetRef="am_l1_warnEnd"/>
