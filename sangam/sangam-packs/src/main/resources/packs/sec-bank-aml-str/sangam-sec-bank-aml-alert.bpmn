  <message id="msg_sangam_fiu_request" name="sangam.fiu.request"/>
  <process id="sangam-sec-bank-aml-alert" name="AML alert to STR" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.bank.aml-str</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>customerId,alertType,alertScore</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="am_start" name="Alert raised (TMS or staff referral)" operaton:initiator="initiator" operaton:formKey="sangam:sec-bank-aml-str/alert"></startEvent>
    <serviceTask id="am_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>alertType=STRUCTURING;alertScore=50;l1Seat=AML-L1;l2Seat=AML-L2;poSeat=PRINCIPAL-OFFICER;strSla=7D</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="am_prio" name="Alert priority (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-bank-aml-priority</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <serviceTask id="am_l1_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>am_l1</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${l1Spec}</operaton:expression></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="am_l1" name="L1 alert triage" operaton:candidateGroups="${l1Seat}" operaton:formKey="sangam:sec-bank-aml-str/l1" operaton:dueDate="${am_l1DueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>l1Decision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="am_l1_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>am_l1</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>l1Seat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="am_l1_warnEnd" name="Warned"></endEvent>
