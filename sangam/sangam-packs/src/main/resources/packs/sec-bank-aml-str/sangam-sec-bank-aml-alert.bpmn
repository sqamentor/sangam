    <sequenceFlow id="sec_bank_aml_alert_f12" sourceRef="am_l1_done" targetRef="am_l1Gw"/>
    <sequenceFlow id="sec_bank_aml_alert_f13" name="close" sourceRef="am_l1Gw" targetRef="am_endFalse"><conditionExpression xsi:type="tFormalExpression">${l1Decision == 'close'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_aml_alert_f14" name="escalate" sourceRef="am_l1Gw" targetRef="am_history"/>
    <sequenceFlow id="sec_bank_aml_alert_f15" sourceRef="am_l2_warn" targetRef="am_l2_warnNotify"/>
    <sequenceFlow id="sec_bank_aml_alert_f16" sourceRef="am_l2_warnNotify" targetRef="am_l2_warnEnd"/>
    <sequenceFlow id="sec_bank_aml_alert_f17" sourceRef="am_l2_breach" targetRef="am_l2_breachAct"/>
    <sequenceFlow id="sec_bank_aml_alert_f18" sourceRef="am_l2_breachAct" targetRef="am_l2_breachGw"/>
    <sequenceFlow id="sec_bank_aml_alert_f19" name="deemed" sourceRef="am_l2_breachGw" targetRef="am_l2_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_aml_alert_f20" name="escalated" sourceRef="am_l2_breachGw" targetRef="am_l2_slaPlan"/>
    <sequenceFlow id="sec_bank_aml_alert_f21" sourceRef="am_l2_slaPlan" targetRef="am_l2"/>
    <sequenceFlow id="sec_bank_aml_alert_f22" sourceRef="am_l2" targetRef="am_l2_done"/>
    <sequenceFlow id="sec_bank_aml_alert_f23" sourceRef="am_history" targetRef="am_l2_slaPlan"/>
    <sequenceFlow id="sec_bank_aml_alert_f24" sourceRef="am_l2_done" targetRef="am_l2Gw"/>
    <sequenceFlow id="sec_bank_aml_alert_f25" name="close" sourceRef="am_l2Gw" targetRef="am_endClosedL2"><conditionExpression xsi:type="tFormalExpression">${l2Decision == 'close'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_aml_alert_f26" name="recommend STR" sourceRef="am_l2Gw" targetRef="am_po"/>
    <sequenceFlow id="sec_bank_aml_alert_f27" sourceRef="am_po" targetRef="am_poGw"/>
    <sequenceFlow id="sec_bank_aml_alert_f28" name="no STR" sourceRef="am_poGw" targetRef="am_endNoStr"><conditionExpression xsi:type="tFormalExpression">${poDecision == 'noStr'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_aml_alert_f29" sourceRef="am_prepare_warn" targetRef="am_prepare_warnNotify"/>
    <sequenceFlow id="sec_bank_aml_alert_f30" sourceRef="am_prepare_warnNotify" targetRef="am_prepare_warnEnd"/>
    <sequenceFlow id="sec_bank_aml_alert_f31" sourceRef="am_prepare_breach" targetRef="am_prepare_breachAct"/>
    <sequenceFlow id="sec_bank_aml_alert_f32" sourceRef="am_prepare_breachAct" targetRef="am_prepare_breachGw"/>
    <sequenceFlow id="sec_bank_aml_alert_f33" name="deemed" sourceRef="am_prepare_breachGw" targetRef="am_prepare_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_aml_alert_f34" name="escalated" sourceRef="am_prepare_breachGw" targetRef="am_prepare_slaPlan"/>
    <sequenceFlow id="sec_bank_aml_alert_f35" sourceRef="am_prepare_slaPlan" targetRef="am_prepare"/>
    <sequenceFlow id="sec_bank_aml_alert_f36" sourceRef="am_prepare" targetRef="am_prepare_done"/>
    <sequenceFlow id="sec_bank_aml_alert_f37" name="file STR" sourceRef="am_poGw" targetRef="am_prepare_slaPlan"/>
    <sequenceFlow id="sec_bank_aml_alert_f38" sourceRef="am_prepare_done" targetRef="am_file"/>
    <sequenceFlow id="sec_bank_aml_alert_f39" sourceRef="am_file" targetRef="am_fileGw"/>
    <sequenceFlow id="sec_bank_aml_alert_f40" name="validation error: correct" sourceRef="am_fileGw" targetRef="am_prepare_slaPlan"><conditionExpression xsi:type="tFormalExpression">${strStatus == 'FAILED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_aml_alert_f41" name="acknowledged" sourceRef="am_fileGw" targetRef="am_risk"/>
    <sequenceFlow id="sec_bank_aml_alert_f42" sourceRef="am_risk" targetRef="am_endFiled"/>
    <subProcess id="am_fiuReq" name="Request from FIU-IND" triggeredByEvent="true">
      <startEvent id="am_fiuStart" name="FIU request" isInterrupting="false"><messageEventDefinition messageRef="msg_sangam_fiu_request"/></startEvent>
      <serviceTask id="am_fiuReply_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>am_fiuReply</operaton:string></operaton:field><operaton:field name="spec"><operaton:string>7D</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
      <userTask id="am_fiuReply" name="Reply to FIU-IND" operaton:candidateGroups="${poSeat}" operaton:formKey="sangam:sec-bank-aml-str/fiu" operaton:dueDate="${am_fiuReplyDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
      <serviceTask id="am_fiuReply_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>am_fiuReply</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>poSeat</operaton:string></operaton:field></extensionElements></serviceTask>
      <endEvent id="am_fiuReply_warnEnd" name="Warned"></endEvent>
      <serviceTask id="am_fiuReply_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>am_fiuReply</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>poSeat</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
      <exclusiveGateway id="am_fiuReply_breachGw" name="Deemed?" default="sec_bank_aml_alert_f48"></exclusiveGateway>
      <exclusiveGateway id="am_fiuReply_done" name=""></exclusiveGateway>
      <endEvent id="am_fiuEnd" name="Replied"></endEvent>
      <boundaryEvent id="am_fiuReply_warn" name="SLA warning (75%)" attachedToRef="am_fiuReply" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${am_fiuReplyWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
      <boundaryEvent id="am_fiuReply_breach" name="SLA breached" attachedToRef="am_fiuReply" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${am_fiuReplyDueAt}</timeDate></timerEventDefinition></boundaryEvent>
      <sequenceFlow id="sec_bank_aml_alert_f43" sourceRef="am_fiuReply_warn" targetRef="am_fiuReply_warnNotify"/>
      <sequenceFlow id="sec_bank_aml_alert_f44" sourceRef="am_fiuReply_warnNotify" targetRef="am_fiuReply_warnEnd"/>
      <sequenceFlow id="sec_bank_aml_alert_f45" sourceRef="am_fiuReply_breach" targetRef="am_fiuReply_breachAct"/>
      <sequenceFlow id="sec_bank_aml_alert_f46" sourceRef="am_fiuReply_breachAct" targetRef="am_fiuReply_breachGw"/>
      <sequenceFlow id="sec_bank_aml_alert_f47" name="deemed" sourceRef="am_fiuReply_breachGw" targetRef="am_fiuReply_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
      <sequenceFlow id="sec_bank_aml_alert_f48" name="escalated" sourceRef="am_fiuReply_breachGw" targetRef="am_fiuReply_slaPlan"/>
      <sequenceFlow id="sec_bank_aml_alert_f49" sourceRef="am_fiuReply_slaPlan" targetRef="am_fiuReply"/>
      <sequenceFlow id="sec_bank_aml_alert_f50" sourceRef="am_fiuReply" targetRef="am_fiuReply_done"/>
      <sequenceFlow id="sec_bank_aml_alert_f51" sourceRef="am_fiuStart" targetRef="am_fiuReply_slaPlan"/>
      <sequenceFlow id="sec_bank_aml_alert_f52" sourceRef="am_fiuReply_done" targetRef="am_fiuEnd"/>
    </subProcess>
  </process>
  <bpmndi:BPMNDiagram id="sec_bank_aml_alert_diagram">
    <bpmndi:BPMNPlane id="sec_bank_aml_alert_plane" bpmnElement="sangam-sec-bank-aml-alert">
      <bpmndi:BPMNShape id="am_start_di" bpmnElement="am_start"><dc:Bounds x="52" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="am_defaults_di" bpmnElement="am_defaults"><dc:Bounds x="185" y="30" width="100" height="80"/></bpmndi:BPMNShape>
