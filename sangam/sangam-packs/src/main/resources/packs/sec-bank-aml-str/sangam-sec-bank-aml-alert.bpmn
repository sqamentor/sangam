    <exclusiveGateway id="am_l1Gw" name="" default="sec_bank_aml_alert_f14"></exclusiveGateway>
    <endEvent id="am_endFalse" name="Closed as false positive (reasons recorded)"></endEvent>
    <serviceTask id="am_history" name="Pull transaction history" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>cbs.txnHistory</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>history</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>customerId</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>txn</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="am_l2_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>am_l2</operaton:string></operaton:field><operaton:field name="spec"><operaton:string>10WD</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="am_l2" name="L2 investigation" operaton:candidateGroups="${l2Seat}" operaton:formKey="sangam:sec-bank-aml-str/l2" operaton:dueDate="${am_l2DueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>l2Decision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="am_l2_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>am_l2</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>l2Seat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="am_l2_warnEnd" name="Warned"></endEvent>
