    <exclusiveGateway id="am_l2_breachGw" name="Deemed?" default="sec_bank_aml_alert_f20"></exclusiveGateway>
    <exclusiveGateway id="am_l2_done" name=""></exclusiveGateway>
    <exclusiveGateway id="am_l2Gw" name="" default="sec_bank_aml_alert_f26"></exclusiveGateway>
    <endEvent id="am_endClosedL2" name="Closed after investigation"></endEvent>
    <userTask id="am_po" name="Principal Officer: suspicious? (record reasons)" operaton:candidateGroups="${poSeat}" operaton:formKey="sangam:sec-bank-aml-str/po"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>poDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
