    <sequenceFlow id="sec_bank_aml_alert_f7" name="deemed" sourceRef="am_l1_breachGw" targetRef="am_l1_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_aml_alert_f8" name="escalated" sourceRef="am_l1_breachGw" targetRef="am_l1_slaPlan"/>
