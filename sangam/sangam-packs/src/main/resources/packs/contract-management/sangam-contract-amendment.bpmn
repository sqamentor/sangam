<!-- Contract amendment. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_contract_amendment" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_cancelCase" name="sangam.cancelCase"/>
  <message id="msg_sangam_withdrawCase" name="sangam.withdrawCase"/>
  <process id="sangam-contract-amendment" name="Contract amendment" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.contract-management</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>amendmentType,amendmentAmount,extensionDays,ldAmount,escalationAmount</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="ca_start" name="Amendment proposed" operaton:initiator="initiator" operaton:formKey="sangam:contract-management/proposal"></startEvent>
    <serviceTask id="ca_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>amendmentAmount=0;extensionDays=0;delayDays=0;escalationIndex=0;contractValue=0;ldAmount=0;escalationAmount=0;caseType=VARIATION;routingDecisionKey=contract-amendment-authority;scrutinySeat=EE-CM;appealAllowed=false;outputTemplate=amendment-order</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="ca_ld" name="Liquidated damages (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>contract-ld</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <businessRuleTask id="ca_escalation" name="Price escalation (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>contract-price-escalation</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <serviceTask id="ca_amount" name="Amount for sanction" operaton:expression="${execution.setVariable('amount', amendmentAmount + escalationAmount)}"></serviceTask>
    <callActivity id="ca_scrutiny" name="Scrutiny (core)" calledElement="sangam-core-scrutiny"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <callActivity id="ca_rj_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="ca_rj_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <callActivity id="ca_sanction" name="Sanction by amendment power (core)" calledElement="sangam-core-sanction"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <exclusiveGateway id="ca_scrGw" name="scrutinyOutcome?" default="contract_amendment_f8"></exclusiveGateway>
    <serviceTask id="ca_apply" name="Apply to the running contract" operaton:class="org.sangam.packs.core.CorrelationDelegate"><extensionElements><operaton:field name="messageName"><operaton:string>sangam.amendmentApproved</operaton:string></operaton:field><operaton:field name="optional"><operaton:string>true</operaton:string></operaton:field><operaton:field name="variables"><operaton:string>amendmentType,amendmentAmount,extensionDays,ldAmount,escalationAmount</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="ca_sanGw" name="sanctionOutcome?" default="contract_amendment_f12"></exclusiveGateway>
    <callActivity id="ca_close" name="Amendment order and closure (core)" calledElement="sangam-core-closure"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="ca_end" name="Closed"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <sequenceFlow id="contract_amendment_f1" sourceRef="ca_start" targetRef="ca_defaults"/>
    <sequenceFlow id="contract_amendment_f2" sourceRef="ca_defaults" targetRef="ca_ld"/>
    <sequenceFlow id="contract_amendment_f3" sourceRef="ca_ld" targetRef="ca_escalation"/>
    <sequenceFlow id="contract_amendment_f4" sourceRef="ca_escalation" targetRef="ca_amount"/>
    <sequenceFlow id="contract_amendment_f5" sourceRef="ca_amount" targetRef="ca_scrutiny"/>
    <sequenceFlow id="contract_amendment_f6" sourceRef="ca_rj_reject" targetRef="ca_rj_endRejected"/>
    <sequenceFlow id="contract_amendment_f7" name="ACCEPTED" sourceRef="ca_scrGw" targetRef="ca_sanction"><conditionExpression xsi:type="tFormalExpression">${scrutinyOutcome == 'ACCEPTED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="contract_amendment_f8" name="otherwise" sourceRef="ca_scrGw" targetRef="ca_rj_reject"/>
    <sequenceFlow id="contract_amendment_f9" sourceRef="ca_scrutiny" targetRef="ca_scrGw"/>
    <sequenceFlow id="contract_amendment_f10" name="SANCTIONED" sourceRef="ca_sanGw" targetRef="ca_apply"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="contract_amendment_f11" name="RETURNED" sourceRef="ca_sanGw" targetRef="ca_scrutiny"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'RETURNED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="contract_amendment_f12" name="otherwise" sourceRef="ca_sanGw" targetRef="ca_rj_reject"/>
    <sequenceFlow id="contract_amendment_f13" sourceRef="ca_sanction" targetRef="ca_sanGw"/>
    <sequenceFlow id="contract_amendment_f14" sourceRef="ca_apply" targetRef="ca_close"/>
    <sequenceFlow id="contract_amendment_f15" sourceRef="ca_close" targetRef="ca_end"/>
    <subProcess id="ca_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="ca_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="ca_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="ca_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="ca_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="contract_amendment_f16" sourceRef="ca_withdrawStart" targetRef="ca_withdrawKind"/>
      <sequenceFlow id="contract_amendment_f17" sourceRef="ca_withdrawKind" targetRef="ca_withdrawCall"/>
      <sequenceFlow id="contract_amendment_f18" sourceRef="ca_withdrawCall" targetRef="ca_withdrawEnd"/>
    </subProcess>
    <subProcess id="ca_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="ca_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="ca_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="ca_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="ca_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="contract_amendment_f19" sourceRef="ca_cancelStart" targetRef="ca_cancelKind"/>
      <sequenceFlow id="contract_amendment_f20" sourceRef="ca_cancelKind" targetRef="ca_cancelCall"/>
      <sequenceFlow id="contract_amendment_f21" sourceRef="ca_cancelCall" targetRef="ca_cancelEnd"/>
    </subProcess>
  </process>
