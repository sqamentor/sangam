<!-- Challan discrepancy case. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_challan_discrepancy" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <process id="sangam-challan-discrepancy" name="Challan discrepancy case" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.ifms.challan-reconciliation</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>key,kind</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="cd_start" name="Discrepancy"></startEvent>
    <serviceTask id="cd_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>reconDeskSeat=TREASURY-RECON</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="cd_resolve_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>cd_resolve</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>3WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="cd_resolve" name="Resolve challan discrepancy" operaton:candidateGroups="${reconDeskSeat}" operaton:formKey="sangam:challan-reconciliation/resolve" operaton:dueDate="${cd_resolveDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>discDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="cd_resolve_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>cd_resolve</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>reconDeskSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="cd_resolve_warnEnd" name="Warned"></endEvent>
    <serviceTask id="cd_resolve_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>cd_resolve</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>reconDeskSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>discDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="cd_resolve_breachGw" name="Deemed?" default="challan_discrepancy_f6"></exclusiveGateway>
    <exclusiveGateway id="cd_resolve_done" name=""></exclusiveGateway>
    <serviceTask id="cd_adjust" name="Adjustment entry" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>treasury.adjust</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>adjust</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>key,discDecision,discrepancyCause</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>adjust</operaton:string></operaton:field><operaton:field name="step"><operaton:string>adjust</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="cd_end" name="Resolved"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="cd_resolve_warn" name="SLA warning (75%)" attachedToRef="cd_resolve" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${cd_resolveWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="cd_resolve_breach" name="SLA breached" attachedToRef="cd_resolve" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${cd_resolveDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="challan_discrepancy_f1" sourceRef="cd_resolve_warn" targetRef="cd_resolve_warnNotify"/>
    <sequenceFlow id="challan_discrepancy_f2" sourceRef="cd_resolve_warnNotify" targetRef="cd_resolve_warnEnd"/>
    <sequenceFlow id="challan_discrepancy_f3" sourceRef="cd_resolve_breach" targetRef="cd_resolve_breachAct"/>
    <sequenceFlow id="challan_discrepancy_f4" sourceRef="cd_resolve_breachAct" targetRef="cd_resolve_breachGw"/>
    <sequenceFlow id="challan_discrepancy_f5" name="deemed" sourceRef="cd_resolve_breachGw" targetRef="cd_resolve_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="challan_discrepancy_f6" name="escalated" sourceRef="cd_resolve_breachGw" targetRef="cd_resolve_slaPlan"/>
    <sequenceFlow id="challan_discrepancy_f7" sourceRef="cd_resolve_slaPlan" targetRef="cd_resolve"/>
    <sequenceFlow id="challan_discrepancy_f8" sourceRef="cd_resolve" targetRef="cd_resolve_done"/>
    <sequenceFlow id="challan_discrepancy_f9" sourceRef="cd_start" targetRef="cd_defaults"/>
    <sequenceFlow id="challan_discrepancy_f10" sourceRef="cd_defaults" targetRef="cd_resolve_slaPlan"/>
    <sequenceFlow id="challan_discrepancy_f11" sourceRef="cd_resolve_done" targetRef="cd_adjust"/>
    <sequenceFlow id="challan_discrepancy_f12" sourceRef="cd_adjust" targetRef="cd_end"/>
  </process>
