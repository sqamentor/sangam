      <bpmndi:BPMNEdge id="challan_reconciliation_f5_di" bpmnElement="challan_reconciliation_f5"><di:waypoint x="615" y="70"/><di:waypoint x="705" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="challan_reconciliation_f6_di" bpmnElement="challan_reconciliation_f6"><di:waypoint x="945" y="70"/><di:waypoint x="1010" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="challan_reconciliation_f7_di" bpmnElement="challan_reconciliation_f7"><di:waypoint x="1110" y="70"/><di:waypoint x="1200" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="challan_reconciliation_f8_di" bpmnElement="challan_reconciliation_f8"><di:waypoint x="1225" y="95"/><di:waypoint x="1225" y="149"/><di:waypoint x="1060" y="149"/><di:waypoint x="1060" y="110"/></bpmndi:BPMNEdge>
