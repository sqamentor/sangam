      <bpmndi:BPMNShape id="cr_fanOut_di" bpmnElement="cr_fanOut"><dc:Bounds x="1010" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="cr_fanGw_di" bpmnElement="cr_fanGw"><dc:Bounds x="1200" y="45" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="cr_poll_di" bpmnElement="cr_poll"><dc:Bounds x="1372" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="cr_aggregate_di" bpmnElement="cr_aggregate"><dc:Bounds x="1505" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="cr_doneGw_di" bpmnElement="cr_doneGw"><dc:Bounds x="1695" y="45" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="cr_report_di" bpmnElement="cr_report"><dc:Bounds x="1835" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="cr_end_di" bpmnElement="cr_end"><dc:Bounds x="2032" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="challan_reconciliation_f1_di" bpmnElement="challan_reconciliation_f1"><di:waypoint x="88" y="195"/><di:waypoint x="149" y="195"/><di:waypoint x="149" y="70"/><di:waypoint x="210" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="challan_reconciliation_f2_di" bpmnElement="challan_reconciliation_f2"><di:waypoint x="88" y="70"/><di:waypoint x="210" y="70"/></bpmndi:BPMNEdge>
