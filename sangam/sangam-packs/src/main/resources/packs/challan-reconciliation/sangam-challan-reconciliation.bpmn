<!-- Challan reconciliation run. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_challan_reconciliation" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_challanReconcileNow" name="sangam.challanReconcileNow"/>
  <process id="sangam-challan-reconciliation" name="Challan reconciliation run" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.ifms.challan-reconciliation</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>scrollDate</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="cr_timer" name="Daily 06:00"><timerEventDefinition><timeCycle xsi:type="tFormalExpression">0 0 6 * * ?</timeCycle></timerEventDefinition></startEvent>
    <startEvent id="cr_manual" name="Run now (message)"><messageEventDefinition messageRef="msg_sangam_challanReconcileNow"/></startEvent>
    <exclusiveGateway id="cr_join" name=""></exclusiveGateway>
    <serviceTask id="cr_expected" name="Challans expected" operaton:class="org.sangam.packs.core.BatchDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>LOAD</operaton:string></operaton:field><operaton:field name="connector"><operaton:string>treasury.challansExpected</operaton:string></operaton:field><operaton:field name="itemsVar"><operaton:string>expectedJson</operaton:string></operaton:field><operaton:field name="sampleSize"><operaton:string>4</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="cr_match" name="Match with scroll" operaton:class="org.sangam.packs.gov.ReconciliationMatchDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="mode"><operaton:string>SCROLL</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="cr_discGw" name="Discrepancies?" default="challan_reconciliation_f14"></exclusiveGateway>
    <serviceTask id="cr_open" name="Open round" operaton:class="org.sangam.packs.core.BatchDelegate"><extensionElements><operaton:field name="op"><operaton:string>OPEN</operaton:string></operaton:field><operaton:field name="itemsVar"><operaton:string>items</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="cr_fanOut" name="Start one instance per item (chunk)" operaton:class="org.sangam.packs.core.BatchDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>FAN_OUT</operaton:string></operaton:field><operaton:field name="itemsVar"><operaton:string>items</operaton:string></operaton:field><operaton:field name="childProcessKey"><operaton:string>sangam-challan-discrepancy</operaton:string></operaton:field><operaton:field name="chunkSize"><operaton:string>200</operaton:string></operaton:field><operaton:field name="inherit"><operaton:string>scrollDate</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="cr_fanGw" name="All started?" default="challan_reconciliation_f9"></exclusiveGateway>
    <intermediateCatchEvent id="cr_poll" name="Poll aggregate"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">PT5M</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <serviceTask id="cr_aggregate" name="Aggregate outcomes" operaton:class="org.sangam.packs.core.BatchDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>AGGREGATE</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="cr_doneGw" name="Round complete?" default="challan_reconciliation_f15"></exclusiveGateway>
    <serviceTask id="cr_report" name="Reconciliation statement" operaton:class="org.sangam.packs.core.DocumentDelegate"><extensionElements><operaton:field name="template"><operaton:string>challan-reconciliation-statement</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="cr_end" name="Reconciled"></endEvent>
    <sequenceFlow id="challan_reconciliation_f1" sourceRef="cr_timer" targetRef="cr_join"/>
    <sequenceFlow id="challan_reconciliation_f2" sourceRef="cr_manual" targetRef="cr_join"/>
    <sequenceFlow id="challan_reconciliation_f3" sourceRef="cr_join" targetRef="cr_expected"/>
    <sequenceFlow id="challan_reconciliation_f4" sourceRef="cr_expected" targetRef="cr_match"/>
    <sequenceFlow id="challan_reconciliation_f5" sourceRef="cr_match" targetRef="cr_discGw"/>
    <sequenceFlow id="challan_reconciliation_f6" sourceRef="cr_open" targetRef="cr_fanOut"/>
    <sequenceFlow id="challan_reconciliation_f7" sourceRef="cr_fanOut" targetRef="cr_fanGw"/>
    <sequenceFlow id="challan_reconciliation_f8" name="next chunk" sourceRef="cr_fanGw" targetRef="cr_fanOut"><conditionExpression xsi:type="tFormalExpression">${!fanOutDone}</conditionExpression></sequenceFlow>
    <sequenceFlow id="challan_reconciliation_f9" name="all started" sourceRef="cr_fanGw" targetRef="cr_poll"/>
    <sequenceFlow id="challan_reconciliation_f10" sourceRef="cr_poll" targetRef="cr_aggregate"/>
    <sequenceFlow id="challan_reconciliation_f11" sourceRef="cr_aggregate" targetRef="cr_doneGw"/>
    <sequenceFlow id="challan_reconciliation_f12" name="not yet" sourceRef="cr_doneGw" targetRef="cr_poll"><conditionExpression xsi:type="tFormalExpression">${!batchComplete}</conditionExpression></sequenceFlow>
    <sequenceFlow id="challan_reconciliation_f13" name="yes" sourceRef="cr_discGw" targetRef="cr_open"><conditionExpression xsi:type="tFormalExpression">${discrepancyCount &gt; 0}</conditionExpression></sequenceFlow>
    <sequenceFlow id="challan_reconciliation_f14" name="all matched" sourceRef="cr_discGw" targetRef="cr_report"/>
    <sequenceFlow id="challan_reconciliation_f15" name="resolved" sourceRef="cr_doneGw" targetRef="cr_report"/>
    <sequenceFlow id="challan_reconciliation_f16" sourceRef="cr_report" targetRef="cr_end"/>
  </process>
  <bpmndi:BPMNDiagram id="challan_reconciliation_diagram">
    <bpmndi:BPMNPlane id="challan_reconciliation_plane" bpmnElement="sangam-challan-reconciliation">
