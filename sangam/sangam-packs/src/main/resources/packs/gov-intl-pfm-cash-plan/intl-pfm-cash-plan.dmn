<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_intl_pfm_cash_plan" name="Cash plan horizon and update cycle (SYNTHETIC; per country)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <!-- SYNTHETIC: country law or policy. Deploy the confirmed table as a tenant override. -->
  <decision id="intl-pfm-cash-plan" name="Cash plan horizon and update cycle (SYNTHETIC; per country)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.2">
    <decisionTable id="intl-pfm-cash-plan_t" hitPolicy="FIRST">
      <input id="intl-pfm-cash-plan_i0" label="Plan period"><inputExpression id="intl-pfm-cash-plan_ie0" typeRef="string"><text>planPeriod</text></inputExpression></input>
      <output id="intl-pfm-cash-plan_o0" label="Forecast horizon" name="cashPlanHorizon" typeRef="string"/>
      <output id="intl-pfm-cash-plan_o1" label="Update every (ISO duration)" name="cashPlanReviewSpec" typeRef="string"/>
      <rule id="intl-pfm-cash-plan_r0"><description>SYNTHETIC</description>
        <inputEntry id="intl-pfm-cash-plan_r0_i0"><text>-</text></inputEntry>
        <outputEntry id="intl-pfm-cash-plan_r0_o0"><text>"MONTHLY"</text></outputEntry>
        <outputEntry id="intl-pfm-cash-plan_r0_o1"><text>"P30D"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
