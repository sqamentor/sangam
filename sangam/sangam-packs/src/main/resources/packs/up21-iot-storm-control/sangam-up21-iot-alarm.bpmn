  <message id="msg_sangam_iot_alarm" name="sangam.iot.alarm"/>
  <message id="msg_sangam_iot_clear" name="sangam.iot.clear"/>
  <process id="sangam-up21-iot-alarm" name="UP-21 Device alarm" isExecutable="true" operaton:historyTimeToLive="30" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>universal.up21-iot-storm-control</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>deviceId</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="u21_start" name="Alarm (per device business key)"><messageEventDefinition messageRef="msg_sangam_iot_alarm"/></startEvent>
    <serviceTask id="u21_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>debounce=PT2M;threshold=3;fieldSeat=FIELD-CREW</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="u21_add" name="Record alarm" operaton:class="org.sangam.packs.universal.EventWindowDelegate"><extensionElements><operaton:field name="op"><operaton:string>ADD</operaton:string></operaton:field></extensionElements></serviceTask>
    <eventBasedGateway id="u21_wait" name="Repeat, clear or debounce end"></eventBasedGateway>
    <intermediateCatchEvent id="u21_repeat" name="Repeat alarm"><messageEventDefinition messageRef="msg_sangam_iot_alarm"/></intermediateCatchEvent>
    <intermediateCatchEvent id="u21_clear" name="Clear"><messageEventDefinition messageRef="msg_sangam_iot_clear"/></intermediateCatchEvent>
    <intermediateCatchEvent id="u21_debounce" name="Debounce window"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">${debounce}</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <serviceTask id="u21_add2" name="Record repeat" operaton:class="org.sangam.packs.universal.EventWindowDelegate"><extensionElements><operaton:field name="op"><operaton:string>ADD</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="u21_endCleared" name="Auto-closed on clear"></endEvent>
    <serviceTask id="u21_eval" name="Threshold" operaton:class="org.sangam.packs.universal.EventWindowDelegate"><extensionElements><operaton:field name="op"><operaton:string>EVALUATE</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="u21_gw" name="Dispatch?" default="up21_iot_alarm_f13"></exclusiveGateway>
    <endEvent id="u21_endNoise" name="Below threshold"></endEvent>
    <userTask id="u21_dispatch" name="Field maintenance" operaton:candidateGroups="${fieldSeat}" operaton:formKey="sangam:up21-iot-storm-control/dispatch"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <endEvent id="u21_endClearedWork" name="Cleared"></endEvent>
    <endEvent id="u21_end" name="Repaired"></endEvent>
    <boundaryEvent id="u21_clearedDuring" name="Cleared during work" attachedToRef="u21_dispatch" cancelActivity="true"><messageEventDefinition messageRef="msg_sangam_iot_clear"/></boundaryEvent>
    <sequenceFlow id="up21_iot_alarm_f1" sourceRef="u21_start" targetRef="u21_defaults"/>
    <sequenceFlow id="up21_iot_alarm_f2" sourceRef="u21_defaults" targetRef="u21_add"/>
