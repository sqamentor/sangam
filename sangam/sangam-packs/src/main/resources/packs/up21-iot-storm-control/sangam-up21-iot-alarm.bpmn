    <sequenceFlow id="up21_iot_alarm_f9" sourceRef="u21_clear" targetRef="u21_endCleared"/>
    <sequenceFlow id="up21_iot_alarm_f10" sourceRef="u21_debounce" targetRef="u21_eval"/>
    <sequenceFlow id="up21_iot_alarm_f11" sourceRef="u21_eval" targetRef="u21_gw"/>
    <sequenceFlow id="up21_iot_alarm_f12" name="noise" sourceRef="u21_gw" targetRef="u21_endNoise"><conditionExpression xsi:type="tFormalExpression">${!thresholdReached}</conditionExpression></sequenceFlow>
    <sequenceFlow id="up21_iot_alarm_f13" name="dispatch" sourceRef="u21_gw" targetRef="u21_dispatch"/>
    <sequenceFlow id="up21_iot_alarm_f14" sourceRef="u21_clearedDuring" targetRef="u21_endClearedWork"/>
    <sequenceFlow id="up21_iot_alarm_f15" sourceRef="u21_dispatch" targetRef="u21_end"/>
  </process>
