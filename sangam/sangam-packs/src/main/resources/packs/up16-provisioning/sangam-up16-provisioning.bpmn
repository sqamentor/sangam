    <serviceTask id="u16_laptop" name="Provision: Laptop" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>provision.laptop</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>provision</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>employeeId,employeeName</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>u16_laptop</operaton:string></operaton:field><operaton:field name="step"><operaton:string>u16_laptop</operaton:string></operaton:field><operaton:field name="errorOnFailure"><operaton:string>PROVISION_FAILED</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="u16_laptop_undo" name="Undo: Laptop" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true" isForCompensation="true"><extensionElements><operaton:field name="connector"><operaton:string>provision.undo</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>undo</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>employeeId</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>u16_laptopUndo</operaton:string></operaton:field><operaton:field name="step"><operaton:string>u16_laptop-undo</operaton:string></operaton:field></extensionElements></serviceTask>
    <intermediateThrowEvent id="u16_compensate" name="Undo what was provisioned"><compensateEventDefinition/></intermediateThrowEvent>
    <endEvent id="u16_endFailed" name="Provisioning failed (undone)"></endEvent>
    <parallelGateway id="u16_lfork" name="Revoke in parallel"></parallelGateway>
    <parallelGateway id="u16_ljoin" name="All revoked"></parallelGateway>
    <serviceTask id="u16_revokeAll" name="Revoke all access" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>iam.revokeAll</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>revoke</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>employeeId</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>u16_revokeAll</operaton:string></operaton:field><operaton:field name="step"><operaton:string>u16_revokeAll</operaton:string></operaton:field></extensionElements></serviceTask>
