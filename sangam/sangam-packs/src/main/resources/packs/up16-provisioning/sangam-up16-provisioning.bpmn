    <sequenceFlow id="up16_provisioning_f15" sourceRef="u16_laptop_fail" targetRef="u16_compensate"/>
    <sequenceFlow id="up16_provisioning_f16" sourceRef="u16_compensate" targetRef="u16_endFailed"/>
    <sequenceFlow id="up16_provisioning_f17" name="leaver" sourceRef="u16_mode" targetRef="u16_lfork"/>
