    <sequenceFlow id="up16_provisioning_f19" sourceRef="u16_revokeAll" targetRef="u16_ljoin"/>
    <sequenceFlow id="up16_provisioning_f20" sourceRef="u16_lfork" targetRef="u16_recoverAssets"/>
    <sequenceFlow id="up16_provisioning_f21" sourceRef="u16_recoverAssets" targetRef="u16_ljoin"/>
    <sequenceFlow id="up16_provisioning_f22" sourceRef="u16_jjoin" targetRef="u16_evidence"/>
    <sequenceFlow id="up16_provisioning_f23" sourceRef="u16_ljoin" targetRef="u16_evidence"/>
    <sequenceFlow id="up16_provisioning_f24" sourceRef="u16_evidence" targetRef="u16_end"/>
    <subProcess id="u16_late" name="Leaver deadline" triggeredByEvent="true">
      <startEvent id="u16_lateStart" name="Deadline passed" isInterrupting="false"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">PT4H</timeDuration></timerEventDefinition></startEvent>
      <serviceTask id="u16_lateNotify" name="Escalate to security" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>revocation-late</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>email,inapp</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>securitySeat</operaton:string></operaton:field></extensionElements></serviceTask>
      <endEvent id="u16_lateEnd" name="Escalated"></endEvent>
      <sequenceFlow id="up16_provisioning_f25" sourceRef="u16_lateStart" targetRef="u16_lateNotify"/>
      <sequenceFlow id="up16_provisioning_f26" sourceRef="u16_lateNotify" targetRef="u16_lateEnd"/>
    </subProcess>
    <association id="up16_provisioning_a6" associationDirection="One" sourceRef="u16_account_comp" targetRef="u16_account_undo"/>
    <association id="up16_provisioning_a10" associationDirection="One" sourceRef="u16_badge_comp" targetRef="u16_badge_undo"/>
    <association id="up16_provisioning_a14" associationDirection="One" sourceRef="u16_laptop_comp" targetRef="u16_laptop_undo"/>
