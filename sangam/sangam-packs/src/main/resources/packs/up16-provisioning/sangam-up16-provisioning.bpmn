  <error id="err_PROVISION_FAILED" name="PROVISION_FAILED" errorCode="PROVISION_FAILED"/>
  <process id="sangam-up16-provisioning" name="UP-16 Joiner / leaver provisioning" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>universal.up16-provisioning</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>employeeId,employeeName,mode</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="u16_start" name="Joiner or leaver" operaton:initiator="initiator" operaton:formKey="sangam:up16-provisioning/request"></startEvent>
    <serviceTask id="u16_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>mode=JOINER;securitySeat=SECURITY-OFFICER</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="u16_mode" name="Joiner or leaver?" default="up16_provisioning_f17"></exclusiveGateway>
    <parallelGateway id="u16_jfork" name="Provision in parallel"></parallelGateway>
    <parallelGateway id="u16_jjoin" name="All provisioned"></parallelGateway>
    <serviceTask id="u16_account" name="Provision: Accounts" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>provision.account</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>provision</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>employeeId,employeeName</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>u16_account</operaton:string></operaton:field><operaton:field name="step"><operaton:string>u16_account</operaton:string></operaton:field><operaton:field name="errorOnFailure"><operaton:string>PROVISION_FAILED</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="u16_account_undo" name="Undo: Accounts" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true" isForCompensation="true"><extensionElements><operaton:field name="connector"><operaton:string>provision.undo</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>undo</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>employeeId</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>u16_accountUndo</operaton:string></operaton:field><operaton:field name="step"><operaton:string>u16_account-undo</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="u16_badge" name="Provision: Badge" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>provision.badge</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>provision</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>employeeId,employeeName</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>u16_badge</operaton:string></operaton:field><operaton:field name="step"><operaton:string>u16_badge</operaton:string></operaton:field><operaton:field name="errorOnFailure"><operaton:string>PROVISION_FAILED</operaton:string></operaton:field></extensionElements></serviceTask>
