    <sequenceFlow id="up16_provisioning_f2" sourceRef="u16_defaults" targetRef="u16_mode"/>
    <sequenceFlow id="up16_provisioning_f3" name="joiner" sourceRef="u16_mode" targetRef="u16_jfork"><conditionExpression xsi:type="tFormalExpression">${mode == 'JOINER'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="up16_provisioning_f4" sourceRef="u16_jfork" targetRef="u16_account"/>
    <sequenceFlow id="up16_provisioning_f5" sourceRef="u16_account" targetRef="u16_jjoin"/>
    <sequenceFlow id="up16_provisioning_f7" sourceRef="u16_account_fail" targetRef="u16_compensate"/>
