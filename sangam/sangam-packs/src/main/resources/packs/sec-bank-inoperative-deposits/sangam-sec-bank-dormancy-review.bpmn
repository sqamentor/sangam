<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_sec_bank_dormancy_review" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.3">
  <process id="sangam-sec-bank-dormancy-review" name="Dormancy review" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.3">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.bank.inoperative-deposits</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.3</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>period</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="dv_timer" name="Cycle"><timerEventDefinition><timeCycle xsi:type="tFormalExpression">0 0 5 3 * ?</timeCycle></timerEventDefinition></startEvent>
    <serviceTask id="dv_load" name="Load items" operaton:class="org.sangam.packs.core.BatchDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>LOAD</operaton:string></operaton:field><operaton:field name="connector"><operaton:string>cbs.dormancyDue</operaton:string></operaton:field><operaton:field name="sampleSize"><operaton:string>3</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="dv_open" name="Open round" operaton:class="org.sangam.packs.core.BatchDelegate"><extensionElements><operaton:field name="op"><operaton:string>OPEN</operaton:string></operaton:field><operaton:field name="itemsVar"><operaton:string>items</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="dv_fanOut" name="Start one instance per item (chunk)" operaton:class="org.sangam.packs.core.BatchDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>FAN_OUT</operaton:string></operaton:field><operaton:field name="itemsVar"><operaton:string>items</operaton:string></operaton:field><operaton:field name="childProcessKey"><operaton:string>sangam-sec-bank-dormancy-account</operaton:string></operaton:field><operaton:field name="chunkSize"><operaton:string>100</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="dv_fanGw" name="All started?" default="sec_bank_dormancy_review_f5"></exclusiveGateway>
    <intermediateCatchEvent id="dv_poll" name="Poll aggregate"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">PT1H</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <serviceTask id="dv_aggregate" name="Aggregate outcomes" operaton:class="org.sangam.packs.core.BatchDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>AGGREGATE</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="dv_doneGw" name="Round complete?" default="sec_bank_dormancy_review_f10"></exclusiveGateway>
    <endEvent id="dv_end" name="Review closed"></endEvent>
    <serviceTask id="dv_seal" name="Seal the batch items (count, total, fingerprints; owner decision E1)" operaton:class="org.sangam.packs.core.BatchDelegate"><extensionElements><operaton:field name="op"><operaton:string>SEAL</operaton:string></operaton:field><operaton:field name="currency"><operaton:string>INR</operaton:string></operaton:field><operaton:field name="purpose"><operaton:string>Transfer to the DEA Fund</operaton:string></operaton:field><operaton:field name="itemsVar"><operaton:string>items</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="dv_bsanction" name="Sanction the sealed batch (core sanction, owner decision E1)" calledElement="sangam-core-sanction" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.3"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:in sourceExpression="${'ESCALATE'}" target="sanctionOnBreach"/><operaton:out variables="all"/></extensionElements></callActivity>
    <exclusiveGateway id="dv_bsgw" name="Batch sanctioned?" default="dv_bsgw_no"></exclusiveGateway>
    <endEvent id="dv_bnotReleased" name="Batch not released"></endEvent>
    <exclusiveGateway id="dv_bsanctionPrepareGw" name="Document to sign?" default="sec_bank_dormancy_review_f12"></exclusiveGateway>
    <userTask id="dv_bsanctionPrepare" name="Prepare the document to sign" operaton:candidateGroups="${initiatorSeat}" operaton:formKey="sangam:sec-bank-inoperative-deposits/prepare-sanction-note"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.DocumentSlotReadyListener"><operaton:field name="slots"><operaton:string>sanctionDocumentId:SANCTION_NOTE</operaton:string></operaton:field></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <sequenceFlow id="sec_bank_dormancy_review_f1" sourceRef="dv_timer" targetRef="dv_load"/>
    <sequenceFlow id="sec_bank_dormancy_review_f2" sourceRef="dv_open" targetRef="dv_fanOut"/>
    <sequenceFlow id="sec_bank_dormancy_review_f3" sourceRef="dv_fanOut" targetRef="dv_fanGw"/>
    <sequenceFlow id="sec_bank_dormancy_review_f4" name="next chunk" sourceRef="dv_fanGw" targetRef="dv_fanOut"><conditionExpression xsi:type="tFormalExpression">${!fanOutDone}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_dormancy_review_f5" name="all started" sourceRef="dv_fanGw" targetRef="dv_poll"/>
    <sequenceFlow id="sec_bank_dormancy_review_f6" sourceRef="dv_poll" targetRef="dv_aggregate"/>
    <sequenceFlow id="sec_bank_dormancy_review_f7" sourceRef="dv_aggregate" targetRef="dv_doneGw"/>
    <sequenceFlow id="sec_bank_dormancy_review_f8" name="not yet" sourceRef="dv_doneGw" targetRef="dv_poll"><conditionExpression xsi:type="tFormalExpression">${!batchComplete}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_dormancy_review_f9" sourceRef="dv_load" targetRef="dv_seal"/>
    <sequenceFlow id="sec_bank_dormancy_review_f10" name="complete" sourceRef="dv_doneGw" targetRef="dv_end"/>
    <sequenceFlow id="dv_seal_f" sourceRef="dv_seal" targetRef="dv_bsanctionPrepareGw"/>
    <sequenceFlow id="dv_bsanction_f" sourceRef="dv_bsanction" targetRef="dv_bsgw"/>
    <sequenceFlow id="dv_bsgw_yes" name="sanctioned" sourceRef="dv_bsgw" targetRef="dv_open"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="dv_bsgw_no" name="not sanctioned" sourceRef="dv_bsgw" targetRef="dv_bnotReleased"/>
    <sequenceFlow id="sec_bank_dormancy_review_f11" name="DSC signature needed" sourceRef="dv_bsanctionPrepareGw" targetRef="dv_bsanctionPrepare"><conditionExpression xsi:type="tFormalExpression">${execution.getVariable('signatureRequired') == true}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_dormancy_review_f12" name="no DSC signature" sourceRef="dv_bsanctionPrepareGw" targetRef="dv_bsanction"/>
    <sequenceFlow id="sec_bank_dormancy_review_f13" sourceRef="dv_bsanctionPrepare" targetRef="dv_bsanction"/>
  </process>
