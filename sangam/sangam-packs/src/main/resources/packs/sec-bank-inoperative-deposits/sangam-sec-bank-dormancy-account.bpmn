    <sequenceFlow id="sec_bank_dormancy_accoun_f3" sourceRef="da_rule" targetRef="da_gw"/>
    <sequenceFlow id="sec_bank_dormancy_accoun_f4" name="inoperative / unclaimed" sourceRef="da_gw" targetRef="da_notice"><conditionExpression xsi:type="tFormalExpression">${dormancyAction == 'INOPERATIVE' || dormancyAction == 'DEA'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_dormancy_accoun_f5" sourceRef="da_notice" targetRef="da_wait"/>
    <sequenceFlow id="sec_bank_dormancy_accoun_f6" name="none" sourceRef="da_gw" targetRef="da_endActive"/>
    <sequenceFlow id="sec_bank_dormancy_accoun_f7" sourceRef="da_wait" targetRef="da_active"/>
    <sequenceFlow id="sec_bank_dormancy_accoun_f8" sourceRef="da_wait" targetRef="da_period"/>
    <sequenceFlow id="sec_bank_dormancy_accoun_f9" sourceRef="da_active" targetRef="da_endReactivated"/>
    <sequenceFlow id="sec_bank_dormancy_accoun_f10" sourceRef="da_period" targetRef="da_g2"/>
    <sequenceFlow id="sec_bank_dormancy_accoun_f11" name="inoperative" sourceRef="da_g2" targetRef="da_mark"/>
    <sequenceFlow id="sec_bank_dormancy_accoun_f12" sourceRef="da_mark" targetRef="da_endInoperative"/>
    <sequenceFlow id="sec_bank_dormancy_accoun_f13" name="10 years" sourceRef="da_g2" targetRef="da_approve"><conditionExpression xsi:type="tFormalExpression">${dormancyAction == 'DEA'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_dormancy_accoun_f14" sourceRef="da_approve" targetRef="da_apGw"/>
    <sequenceFlow id="sec_bank_dormancy_accoun_f15" name="approve" sourceRef="da_apGw" targetRef="da_transfer"><conditionExpression xsi:type="tFormalExpression">${deaDecision == 'approve'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_dormancy_accoun_f16" name="retain (dispute / legal hold)" sourceRef="da_apGw" targetRef="da_mark"/>
    <sequenceFlow id="sec_bank_dormancy_accoun_f17" sourceRef="da_transfer" targetRef="da_endTransferred"/>
  </process>
