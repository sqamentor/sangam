  <message id="msg_sangam_account_reactivated" name="sangam.account.reactivated"/>
  <process id="sangam-sec-bank-dormancy-account" name="Dormancy of one account" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.bank.inoperative-deposits</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>key</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="da_start" name="Account inactive"></startEvent>
    <serviceTask id="da_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>yearsInactive=2;applicantRef=@key;opsSeat=OPS-CHECKER</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="da_rule" name="Inoperative / unclaimed (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-bank-dormancy</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <exclusiveGateway id="da_gw" name="Action?" default="sec_bank_dormancy_accoun_f6"></exclusiveGateway>
    <serviceTask id="da_notice" name="Advance intimation to the customer and nominee" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>account-inoperative-notice</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>sms,email,letter</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>applicantRef</operaton:string></operaton:field></extensionElements></serviceTask>
    <eventBasedGateway id="da_wait" name="Customer acts or notice period ends"></eventBasedGateway>
    <endEvent id="da_endActive" name="Still within limits"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <intermediateCatchEvent id="da_active" name="Customer transacts / updates KYC"><messageEventDefinition messageRef="msg_sangam_account_reactivated"/></intermediateCatchEvent>
    <intermediateCatchEvent id="da_period" name="Notice period over"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">P30D</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <endEvent id="da_endReactivated" name="Reactivated"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <exclusiveGateway id="da_g2" name="Unclaimed 10 years?" default="sec_bank_dormancy_accoun_f11"></exclusiveGateway>
    <serviceTask id="da_mark" name="Mark inoperative (no charge)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>cbs.markInoperative</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>mark</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>key</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>mark</operaton:string></operaton:field><operaton:field name="step"><operaton:string>mark</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="da_endInoperative" name="Inoperative"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>INOPERATIVE</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <userTask id="da_approve" name="Approve DEA Fund transfer (checker)" operaton:candidateGroups="${opsSeat}" operaton:formKey="sangam:sec-bank-inoperative-deposits/approve"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>deaDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="da_apGw" name="" default="sec_bank_dormancy_accoun_f16"></exclusiveGateway>
    <serviceTask id="da_transfer" name="Transfer to the DEA Fund" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>rbi.deaTransfer</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>transfer</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>key</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>dea</operaton:string></operaton:field><operaton:field name="step"><operaton:string>dea-transfer</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="da_endTransferred" name="Transferred to DEA Fund"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>TRANSFERRED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
