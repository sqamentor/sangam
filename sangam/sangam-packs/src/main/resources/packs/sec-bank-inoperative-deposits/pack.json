{
  "id": "sec.bank.inoperative-deposits",
  "version": "1.0.2",
  "name": {
    "en": "Inoperative accounts and unclaimed deposits (DEA Fund)",
    "hi": "निष्क्रिय खाते एवं अदावी जमा (डीईए निधि)"
  },
  "domain": "Banking",
  "description": "Monthly review, one case per account: no customer-induced transaction for 2 years makes the account inoperative (customer told in advance, no charge for activation); balances unclaimed for 10 years are transferred to the RBI DEA Fund; reactivation or claim with KYC updated, no fee, claim refunded from the DEA Fund with interest where payable.",
  "mainProcesses": [
    "sangam-sec-bank-dormancy-review"
  ],
  "resources": [
    {
      "kind": "BPMN",
      "path": "packs/sec-bank-inoperative-deposits/sangam-sec-bank-dormancy-review.bpmn"
    },
    {
      "kind": "BPMN",
      "path": "packs/sec-bank-inoperative-deposits/sangam-sec-bank-dormancy-account.bpmn"
    },
    {
      "kind": "BPMN",
      "path": "packs/sec-bank-inoperative-deposits/sangam-sec-bank-dea-claim.bpmn"
    },
    {
      "kind": "DMN",
      "path": "packs/sec-bank-inoperative-deposits/sec-bank-dormancy.dmn"
    },
    {
      "kind": "FORM",
      "path": "packs/sec-bank-inoperative-deposits/forms/approve.form.json"
    },
    {
      "kind": "FORM",
      "path": "packs/sec-bank-inoperative-deposits/forms/claim.form.json"
    },
    {
      "kind": "FORM",
      "path": "packs/sec-bank-inoperative-deposits/forms/verify.form.json"
    },
    {
      "kind": "SEED",
      "path": "packs/sec-bank-inoperative-deposits/seed.json"
    },
    {
      "kind": "OTHER",
      "path": "packs/sec-bank-inoperative-deposits/pack.json"
    }
  ],
  "seed": "packs/sec-bank-inoperative-deposits/seed.json",
  "connectors": [
    {
      "id": "cbs.dormancyDue",
      "moneyMovement": "NONE",
      "capabilityClass": "a",
      "govTag": "",
      "purpose": "Accounts by inactivity"
    },
    {
      "id": "cbs.markInoperative",
      "moneyMovement": "NONE",
      "capabilityClass": "a",
      "govTag": "",
      "purpose": "Flag"
    },
    {
      "id": "rbi.deaTransfer",
      "moneyMovement": "OUT",
      "capabilityClass": "c",
      "govTag": "",
      "purpose": "Transfer to DEA Fund"
    },
    {
      "id": "rbi.deaClaim",
      "moneyMovement": "IN",
      "capabilityClass": "a",
      "govTag": "",
      "purpose": "Claim from DEA Fund"
    },
    {
      "id": "cbs.credit",
      "moneyMovement": "OUT",
      "capabilityClass": "a",
      "govTag": "",
      "purpose": "Credit the claimant"
    }
  ],
  "covers": [
    "SEC-BANK-009",
    "UP-15",
    "GP-08",
    "GP-09",
    "GP-30"
  ],
  "acceptance": [],
  "dependsOn": [
    "sangam.core"
  ],
  "tenantOverrides": [],
  "calls": [
    "sangam-core-rejection"
  ],
  "documentSlots": [
    {
      "documentType": "SANCTION_NOTE",
      "slot": "sanctionDocumentId"
    }
  ],
  "money": {
    "unit": "MINOR",
    "currency": "INR",
    "exponent": 2,
    "currencyReason": "owner decision M1: the pack applies RBI's Depositor Education and Awareness (DEA) Fund scheme, which is in rupees, so the pack declares INR",
    "variables": [
      "payableAmount"
    ]
  },
  "currency": "INR",
  "powers": {
    "dc_credit_sanction": {
      "monetary": true,
      "currency": "INR",
      "limitTable": "sangam-core-powers",
      "ruleCaseType": "GENERAL"
    },
    "dv_bsanction": {
      "monetary": true,
      "currency": "INR",
      "limitTable": "sangam-core-powers",
      "ruleCaseType": "GENERAL"
    }
  }
}
