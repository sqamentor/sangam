    <sequenceFlow id="sec_scm_eway_bill_f11" sourceRef="ew_wait" targetRef="ew_rejected"/>
    <sequenceFlow id="sec_scm_eway_bill_f12" sourceRef="ew_wait" targetRef="ew_expiring"/>
    <sequenceFlow id="sec_scm_eway_bill_f13" sourceRef="ew_delivered" targetRef="ew_end"/>
    <sequenceFlow id="sec_scm_eway_bill_f14" sourceRef="ew_notMoved" targetRef="ew_cancel"/>
    <sequenceFlow id="sec_scm_eway_bill_f15" sourceRef="ew_cancel" targetRef="ew_endCancelled"/>
