<!-- E-way bill. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_sec_scm_eway_bill" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_ewb_delivered" name="sangam.ewb.delivered"/>
  <message id="msg_sangam_ewb_notMoved" name="sangam.ewb.notMoved"/>
  <message id="msg_sangam_ewb_rejected" name="sangam.ewb.rejected"/>
  <message id="msg_sangam_ewb_vehicleChange" name="sangam.ewb.vehicleChange"/>
  <process id="sangam-sec-scm-eway-bill" name="E-way bill" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.scm.eway-bill</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>invoiceNo,consignmentValue,distanceKm</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="ew_start" name="Dispatch planned" operaton:initiator="initiator" operaton:formKey="sangam:sec-scm-eway-bill/dispatch"></startEvent>
    <serviceTask id="ew_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>invoiceNo=@customerId;consignmentValue=100000;distanceKm=400;vehicleNo=X</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="ew_rule" name="E-way bill needed and validity (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-scm-ewb</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <exclusiveGateway id="ew_gw" name="Required?" default="sec_scm_eway_bill_f5"></exclusiveGateway>
    <endEvent id="ew_endNotReq" name="Not required (below threshold)"></endEvent>
    <serviceTask id="ew_generate" name="Generate e-way bill" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>ewb.generate</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>generate</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>invoiceNo,consignmentValue,vehicleNo</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>ewb</operaton:string></operaton:field><operaton:field name="step"><operaton:string>generate</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ew_valid" name="Regulatory clock: validity" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>validity</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${validitySpec}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <eventBasedGateway id="ew_wait" name="Delivered, moved, rejected or expiring"></eventBasedGateway>
    <intermediateCatchEvent id="ew_delivered" name="Delivered"><messageEventDefinition messageRef="msg_sangam_ewb_delivered"/></intermediateCatchEvent>
    <intermediateCatchEvent id="ew_notMoved" name="Goods not moved"><messageEventDefinition messageRef="msg_sangam_ewb_notMoved"/></intermediateCatchEvent>
    <intermediateCatchEvent id="ew_tranship" name="Transhipment / vehicle change"><messageEventDefinition messageRef="msg_sangam_ewb_vehicleChange"/></intermediateCatchEvent>
    <intermediateCatchEvent id="ew_rejected" name="Recipient rejects (72 hours)"><messageEventDefinition messageRef="msg_sangam_ewb_rejected"/></intermediateCatchEvent>
    <intermediateCatchEvent id="ew_expiring" name="Validity ending"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${validityDueAt}</timeDate></timerEventDefinition></intermediateCatchEvent>
    <endEvent id="ew_end" name="Delivered"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="ew_cancel" name="Cancel within 24 hours" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>ewb.cancel</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>cancel</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>invoiceNo</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>cancel</operaton:string></operaton:field><operaton:field name="step"><operaton:string>cancel</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="ew_endCancelled" name="Cancelled"></endEvent>
    <serviceTask id="ew_update" name="Update Part B" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>ewb.updateVehicle</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>update</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>invoiceNo,vehicleNo</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>upd</operaton:string></operaton:field><operaton:field name="step"><operaton:string>part-b</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="ew_endRejected" name="Rejected by the recipient"></endEvent>
    <serviceTask id="ew_extend" name="Extend validity (within 8 hours of expiry)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>ewb.extend</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>extend</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>invoiceNo</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>ext</operaton:string></operaton:field><operaton:field name="step"><operaton:string>extend</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ew_valid2" name="Regulatory clock: validity" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>validity</operaton:string></operaton:field><operaton:field name="spec"><operaton:string>1D</operaton:string></operaton:field></extensionElements></serviceTask>
    <sequenceFlow id="sec_scm_eway_bill_f1" sourceRef="ew_start" targetRef="ew_defaults"/>
    <sequenceFlow id="sec_scm_eway_bill_f2" sourceRef="ew_defaults" targetRef="ew_rule"/>
    <sequenceFlow id="sec_scm_eway_bill_f3" sourceRef="ew_rule" targetRef="ew_gw"/>
    <sequenceFlow id="sec_scm_eway_bill_f4" name="no" sourceRef="ew_gw" targetRef="ew_endNotReq"><conditionExpression xsi:type="tFormalExpression">${!ewbRequired}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_scm_eway_bill_f5" name="yes" sourceRef="ew_gw" targetRef="ew_generate"/>
    <sequenceFlow id="sec_scm_eway_bill_f6" sourceRef="ew_generate" targetRef="ew_valid"/>
    <sequenceFlow id="sec_scm_eway_bill_f7" sourceRef="ew_valid" targetRef="ew_wait"/>
    <sequenceFlow id="sec_scm_eway_bill_f8" sourceRef="ew_wait" targetRef="ew_delivered"/>
