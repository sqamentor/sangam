<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_sec_hr_exit_tat" name="Exit settlement periods (Code on Wages s.17(2); Code on Social Security; verify)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="sec-hr-exit-tat" name="Exit settlement periods (Code on Wages s.17(2); Code on Social Security; verify)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="sec-hr-exit-tat_t" hitPolicy="FIRST">
      <input id="sec-hr-exit-tat_i0" label="Exit type"><inputExpression id="sec-hr-exit-tat_ie0" typeRef="string"><text>exitType</text></inputExpression></input>
      <input id="sec-hr-exit-tat_i1" label="Qualifying service (years)"><inputExpression id="sec-hr-exit-tat_ie1" typeRef="number"><text>qualifyingService</text></inputExpression></input>
      <output id="sec-hr-exit-tat_o0" label="Wages within" name="fnfSpec" typeRef="string"/>
      <output id="sec-hr-exit-tat_o1" label="Gratuity within" name="gratuitySpec" typeRef="string"/>
      <output id="sec-hr-exit-tat_o2" label="Gratuity payable" name="gratuityPayable" typeRef="boolean"/>
      <rule id="sec-hr-exit-tat_r0"><description>death / disablement: no service condition</description>
        <inputEntry id="sec-hr-exit-tat_r0_i0"><text>"DEATH"</text></inputEntry>
        <inputEntry id="sec-hr-exit-tat_r0_i1"><text>-</text></inputEntry>
        <outputEntry id="sec-hr-exit-tat_r0_o0"><text>"2WD"</text></outputEntry>
        <outputEntry id="sec-hr-exit-tat_r0_o1"><text>"30D"</text></outputEntry>
        <outputEntry id="sec-hr-exit-tat_r0_o2"><text>true</text></outputEntry>
      </rule>
      <rule id="sec-hr-exit-tat_r1"><description>5 years (1 year for fixed-term employees, verify)</description>
        <inputEntry id="sec-hr-exit-tat_r1_i0"><text>-</text></inputEntry>
        <inputEntry id="sec-hr-exit-tat_r1_i1"><text>&gt;= 5</text></inputEntry>
        <outputEntry id="sec-hr-exit-tat_r1_o0"><text>"2WD"</text></outputEntry>
        <outputEntry id="sec-hr-exit-tat_r1_o1"><text>"30D"</text></outputEntry>
        <outputEntry id="sec-hr-exit-tat_r1_o2"><text>true</text></outputEntry>
      </rule>
      <rule id="sec-hr-exit-tat_r2">
        <inputEntry id="sec-hr-exit-tat_r2_i0"><text>-</text></inputEntry>
        <inputEntry id="sec-hr-exit-tat_r2_i1"><text>-</text></inputEntry>
        <outputEntry id="sec-hr-exit-tat_r2_o0"><text>"2WD"</text></outputEntry>
        <outputEntry id="sec-hr-exit-tat_r2_o1"><text>"30D"</text></outputEntry>
        <outputEntry id="sec-hr-exit-tat_r2_o2"><text>false</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
