<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- Discharge planning. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_sec_ushealth_discharge" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_cancelCase" name="sangam.cancelCase"/>
  <message id="msg_sangam_ushealth_dischargeOrder" name="sangam.ushealth.dischargeOrder"/>
  <message id="msg_sangam_withdrawCase" name="sangam.withdrawCase"/>
  <process id="sangam-sec-ushealth-discharge" name="Discharge planning" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.ushealth.discharge</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>patientName,medicareBeneficiary</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="dc_start" name="Patient admitted or placed in observation" operaton:initiator="initiator" operaton:formKey="sangam:sec-ushealth-discharge/admit"></startEvent>
    <serviceTask id="dc_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>patientName=@customerId;medicareBeneficiary=true;observationStatus=false;cmSeat=CASE-MANAGER;nurseSeat=CHARGE-NURSE;swSeat=SOCIAL-WORKER</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="dc_cfg" name="Discharge notice timeframes (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-ushealth-discharge-clocks</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <exclusiveGateway id="dc_obsGw" name="Observation?" default="sec_ushealth_discharge_f14"></exclusiveGateway>
    <serviceTask id="dc_moon_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>dc_moon</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${moonSpec}</operaton:expression></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="dc_moon" name="Deliver the MOON notice (observation)" operaton:candidateGroups="${nurseSeat}" operaton:formKey="sangam:sec-ushealth-discharge/moon" operaton:dueDate="${dc_moonDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="dc_moon_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>dc_moon</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>nurseSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="dc_moon_warnEnd" name="Warned"></endEvent>
    <serviceTask id="dc_moon_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>dc_moon</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>nurseSeat</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="dc_moon_breachGw" name="Deemed?" default="sec_ushealth_discharge_f9"></exclusiveGateway>
    <exclusiveGateway id="dc_moon_done" name=""></exclusiveGateway>
    <endEvent id="dc_endObs" name="Observation notice given"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>OBSERVATION</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <exclusiveGateway id="dc_imGw" name="Medicare beneficiary?" default="sec_ushealth_discharge_f24"></exclusiveGateway>
    <serviceTask id="dc_im_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>dc_im</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${imAdmissionSpec}</operaton:expression></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="dc_im" name="Deliver the Important Message from Medicare" operaton:candidateGroups="${nurseSeat}" operaton:formKey="sangam:sec-ushealth-discharge/im" operaton:dueDate="${dc_imDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="dc_im_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>dc_im</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>nurseSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="dc_im_warnEnd" name="Warned"></endEvent>
    <serviceTask id="dc_im_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>dc_im</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>nurseSeat</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="dc_im_breachGw" name="Deemed?" default="sec_ushealth_discharge_f20"></exclusiveGateway>
    <exclusiveGateway id="dc_im_done" name=""></exclusiveGateway>
    <exclusiveGateway id="dc_screenMerge" name=""></exclusiveGateway>
    <serviceTask id="dc_screen_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>dc_screen</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${screenSpec}</operaton:expression></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="dc_screen" name="Discharge planning screen" operaton:candidateGroups="${cmSeat}" operaton:formKey="sangam:sec-ushealth-discharge/screen" operaton:dueDate="${dc_screenDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>screenDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="dc_screen_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>dc_screen</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>cmSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="dc_screen_warnEnd" name="Warned"></endEvent>
    <serviceTask id="dc_screen_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>dc_screen</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>cmSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>screenDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="dc_screen_breachGw" name="Deemed?" default="sec_ushealth_discharge_f31"></exclusiveGateway>
    <exclusiveGateway id="dc_screen_done" name=""></exclusiveGateway>
    <exclusiveGateway id="dc_planGw" name="" default="sec_ushealth_discharge_f39"></exclusiveGateway>
    <userTask id="dc_eval" name="Discharge planning evaluation with patient and caregiver" operaton:candidateGroups="${cmSeat}" operaton:formKey="sangam:sec-ushealth-discharge/evaluation"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <userTask id="dc_choice" name="Patient choice of post-acute provider (list with quality data)" operaton:candidateGroups="${swSeat}" operaton:formKey="sangam:sec-ushealth-discharge/choice"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="dc_orderMerge" name=""></exclusiveGateway>
    <intermediateCatchEvent id="dc_order" name="Discharge order written"><messageEventDefinition messageRef="msg_sangam_ushealth_dischargeOrder"/></intermediateCatchEvent>
    <userTask id="dc_imFollow" name="Follow-up copy of the Important Message (no more than 2 days before discharge)" operaton:candidateGroups="${nurseSeat}" operaton:formKey="sangam:sec-ushealth-discharge/im-followup"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="dc_followOptGw" name="Medicare follow-up copy?" default="sec_ushealth_discharge_f42"></exclusiveGateway>
    <exclusiveGateway id="dc_followOptMerge" name=""></exclusiveGateway>
    <serviceTask id="dc_transfer" name="Send the necessary medical information to the next provider" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>fhir.transition</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>transaction</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>patientName,postAcuteProvider</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>toc</operaton:string></operaton:field><operaton:field name="step"><operaton:string>transition</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="dc_adt" name="ADT discharge notification to the PCP and post-acute provider" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>fhir.adt</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>create</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>patientName,postAcuteProvider</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>adt</operaton:string></operaton:field><operaton:field name="step"><operaton:string>adt</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="dc_end" name="Discharged with plan"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>DISCHARGED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="dc_moon_warn" name="SLA warning (75%)" attachedToRef="dc_moon" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${dc_moonWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="dc_moon_breach" name="SLA breached" attachedToRef="dc_moon" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${dc_moonDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="dc_im_warn" name="SLA warning (75%)" attachedToRef="dc_im" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${dc_imWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="dc_im_breach" name="SLA breached" attachedToRef="dc_im" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${dc_imDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="dc_screen_warn" name="SLA warning (75%)" attachedToRef="dc_screen" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${dc_screenWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="dc_screen_breach" name="SLA breached" attachedToRef="dc_screen" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${dc_screenDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="sec_ushealth_discharge_f1" sourceRef="dc_start" targetRef="dc_defaults"/>
    <sequenceFlow id="sec_ushealth_discharge_f2" sourceRef="dc_defaults" targetRef="dc_cfg"/>
    <sequenceFlow id="sec_ushealth_discharge_f3" sourceRef="dc_cfg" targetRef="dc_obsGw"/>
    <sequenceFlow id="sec_ushealth_discharge_f4" sourceRef="dc_moon_warn" targetRef="dc_moon_warnNotify"/>
    <sequenceFlow id="sec_ushealth_discharge_f5" sourceRef="dc_moon_warnNotify" targetRef="dc_moon_warnEnd"/>
    <sequenceFlow id="sec_ushealth_discharge_f6" sourceRef="dc_moon_breach" targetRef="dc_moon_breachAct"/>
    <sequenceFlow id="sec_ushealth_discharge_f7" sourceRef="dc_moon_breachAct" targetRef="dc_moon_breachGw"/>
    <sequenceFlow id="sec_ushealth_discharge_f8" name="deemed" sourceRef="dc_moon_breachGw" targetRef="dc_moon_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ushealth_discharge_f9" name="escalated" sourceRef="dc_moon_breachGw" targetRef="dc_moon_slaPlan"/>
    <sequenceFlow id="sec_ushealth_discharge_f10" sourceRef="dc_moon_slaPlan" targetRef="dc_moon"/>
    <sequenceFlow id="sec_ushealth_discharge_f11" sourceRef="dc_moon" targetRef="dc_moon_done"/>
    <sequenceFlow id="sec_ushealth_discharge_f12" name="observation" sourceRef="dc_obsGw" targetRef="dc_moon_slaPlan"><conditionExpression xsi:type="tFormalExpression">${observationStatus}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ushealth_discharge_f13" sourceRef="dc_moon_done" targetRef="dc_endObs"/>
    <sequenceFlow id="sec_ushealth_discharge_f14" name="inpatient" sourceRef="dc_obsGw" targetRef="dc_imGw"/>
    <sequenceFlow id="sec_ushealth_discharge_f15" sourceRef="dc_im_warn" targetRef="dc_im_warnNotify"/>
    <sequenceFlow id="sec_ushealth_discharge_f16" sourceRef="dc_im_warnNotify" targetRef="dc_im_warnEnd"/>
    <sequenceFlow id="sec_ushealth_discharge_f17" sourceRef="dc_im_breach" targetRef="dc_im_breachAct"/>
    <sequenceFlow id="sec_ushealth_discharge_f18" sourceRef="dc_im_breachAct" targetRef="dc_im_breachGw"/>
    <sequenceFlow id="sec_ushealth_discharge_f19" name="deemed" sourceRef="dc_im_breachGw" targetRef="dc_im_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ushealth_discharge_f20" name="escalated" sourceRef="dc_im_breachGw" targetRef="dc_im_slaPlan"/>
    <sequenceFlow id="sec_ushealth_discharge_f21" sourceRef="dc_im_slaPlan" targetRef="dc_im"/>
    <sequenceFlow id="sec_ushealth_discharge_f22" sourceRef="dc_im" targetRef="dc_im_done"/>
    <sequenceFlow id="sec_ushealth_discharge_f23" name="Medicare" sourceRef="dc_imGw" targetRef="dc_im_slaPlan"><conditionExpression xsi:type="tFormalExpression">${medicareBeneficiary}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ushealth_discharge_f24" name="other payer" sourceRef="dc_imGw" targetRef="dc_screenMerge"/>
    <sequenceFlow id="sec_ushealth_discharge_f25" sourceRef="dc_im_done" targetRef="dc_screenMerge"/>
    <sequenceFlow id="sec_ushealth_discharge_f26" sourceRef="dc_screen_warn" targetRef="dc_screen_warnNotify"/>
    <sequenceFlow id="sec_ushealth_discharge_f27" sourceRef="dc_screen_warnNotify" targetRef="dc_screen_warnEnd"/>
    <sequenceFlow id="sec_ushealth_discharge_f28" sourceRef="dc_screen_breach" targetRef="dc_screen_breachAct"/>
    <sequenceFlow id="sec_ushealth_discharge_f29" sourceRef="dc_screen_breachAct" targetRef="dc_screen_breachGw"/>
    <sequenceFlow id="sec_ushealth_discharge_f30" name="deemed" sourceRef="dc_screen_breachGw" targetRef="dc_screen_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ushealth_discharge_f31" name="escalated" sourceRef="dc_screen_breachGw" targetRef="dc_screen_slaPlan"/>
    <sequenceFlow id="sec_ushealth_discharge_f32" sourceRef="dc_screen_slaPlan" targetRef="dc_screen"/>
    <sequenceFlow id="sec_ushealth_discharge_f33" sourceRef="dc_screen" targetRef="dc_screen_done"/>
    <sequenceFlow id="sec_ushealth_discharge_f34" sourceRef="dc_screenMerge" targetRef="dc_screen_slaPlan"/>
    <sequenceFlow id="sec_ushealth_discharge_f35" sourceRef="dc_screen_done" targetRef="dc_planGw"/>
    <sequenceFlow id="sec_ushealth_discharge_f36" name="plan needed" sourceRef="dc_planGw" targetRef="dc_eval"><conditionExpression xsi:type="tFormalExpression">${screenDecision == 'needsPlan'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ushealth_discharge_f37" sourceRef="dc_eval" targetRef="dc_choice"/>
    <sequenceFlow id="sec_ushealth_discharge_f38" sourceRef="dc_choice" targetRef="dc_orderMerge"/>
    <sequenceFlow id="sec_ushealth_discharge_f39" name="no plan needed" sourceRef="dc_planGw" targetRef="dc_orderMerge"/>
    <sequenceFlow id="sec_ushealth_discharge_f40" sourceRef="dc_orderMerge" targetRef="dc_order"/>
    <sequenceFlow id="sec_ushealth_discharge_f41" name="yes" sourceRef="dc_followOptGw" targetRef="dc_imFollow"><conditionExpression xsi:type="tFormalExpression">${medicareBeneficiary}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ushealth_discharge_f42" name="no" sourceRef="dc_followOptGw" targetRef="dc_followOptMerge"/>
    <sequenceFlow id="sec_ushealth_discharge_f43" sourceRef="dc_imFollow" targetRef="dc_followOptMerge"/>
    <sequenceFlow id="sec_ushealth_discharge_f44" sourceRef="dc_order" targetRef="dc_followOptGw"/>
    <sequenceFlow id="sec_ushealth_discharge_f45" sourceRef="dc_followOptMerge" targetRef="dc_transfer"/>
    <sequenceFlow id="sec_ushealth_discharge_f46" sourceRef="dc_transfer" targetRef="dc_adt"/>
    <sequenceFlow id="sec_ushealth_discharge_f47" sourceRef="dc_adt" targetRef="dc_end"/>
    <subProcess id="dc_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="dc_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="dc_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="dc_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="dc_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="sec_ushealth_discharge_f48" sourceRef="dc_withdrawStart" targetRef="dc_withdrawKind"/>
      <sequenceFlow id="sec_ushealth_discharge_f49" sourceRef="dc_withdrawKind" targetRef="dc_withdrawCall"/>
      <sequenceFlow id="sec_ushealth_discharge_f50" sourceRef="dc_withdrawCall" targetRef="dc_withdrawEnd"/>
    </subProcess>
    <subProcess id="dc_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="dc_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="dc_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="dc_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="dc_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="sec_ushealth_discharge_f51" sourceRef="dc_cancelStart" targetRef="dc_cancelKind"/>
      <sequenceFlow id="sec_ushealth_discharge_f52" sourceRef="dc_cancelKind" targetRef="dc_cancelCall"/>
      <sequenceFlow id="sec_ushealth_discharge_f53" sourceRef="dc_cancelCall" targetRef="dc_cancelEnd"/>
    </subProcess>
  </process>
  <bpmndi:BPMNDiagram id="sec_ushealth_discharge_diagram">
    <bpmndi:BPMNPlane id="sec_ushealth_discharge_plane" bpmnElement="sangam-sec-ushealth-discharge">
      <bpmndi:BPMNShape id="dc_start_di" bpmnElement="dc_start"><dc:Bounds x="52" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dc_defaults_di" bpmnElement="dc_defaults"><dc:Bounds x="185" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dc_cfg_di" bpmnElement="dc_cfg"><dc:Bounds x="350" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dc_obsGw_di" bpmnElement="dc_obsGw"><dc:Bounds x="540" y="45" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dc_moon_slaPlan_di" bpmnElement="dc_moon_slaPlan"><dc:Bounds x="680" y="155" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dc_moon_di" bpmnElement="dc_moon"><dc:Bounds x="845" y="155" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="dc_moon_warnNotify_di" bpmnElement="dc_moon_warnNotify"><dc:Bounds x="1010" y="280" width="100" height="80"/></bpmndi:BPMNShape>
