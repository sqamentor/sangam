<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_audit_reply_authority" name="Audit reply approval" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="audit-reply-authority" name="Audit reply approval" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="audit-reply-authority_t" hitPolicy="FIRST">
      <input id="audit-reply-authority_i0" label="Amount"><inputExpression id="audit-reply-authority_ie0" typeRef="double"><text>amount</text></inputExpression></input>
      <output id="audit-reply-authority_o0" label="Competent role" name="competentRole" typeRef="string"/>
      <rule id="audit-reply-authority_r0">
        <inputEntry id="audit-reply-authority_r0_i0"><text>-</text></inputEntry>
        <outputEntry id="audit-reply-authority_r0_o0"><text>"HOD"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
