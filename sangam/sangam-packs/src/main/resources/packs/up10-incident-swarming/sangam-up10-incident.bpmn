<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- UP-10 Incident. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_up10_incident" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_incident_reprioritise" name="sangam.incident.reprioritise"/>
  <process id="sangam-up10-incident" name="UP-10 Incident" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>universal.up10-incident-swarming</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>incidentSummary,priority</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="u10_start" name="Incident raised" operaton:initiator="initiator" operaton:formKey="sangam:up10-incident-swarming/raise"></startEvent>
    <businessRuleTask id="u10_prio" name="Resolver group and SLA by priority (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>up10-priority</operaton:string></operaton:field><operaton:field name="binding"><operaton:string>latest</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <exclusiveGateway id="u10_majorGw" name="Major incident?" default="up10_incident_f11"></exclusiveGateway>
    <serviceTask id="u10_resolve_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>u10_resolve</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${slaSpec}</operaton:expression></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="u10_resolve" name="Resolve incident" operaton:candidateGroups="${resolverGroup}" operaton:formKey="sangam:up10-incident-swarming/resolve" operaton:dueDate="${u10_resolveDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>incidentDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="u10_resolve_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>u10_resolve</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>resolverGroup</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="u10_resolve_warnEnd" name="Warned"></endEvent>
    <serviceTask id="u10_resolve_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>u10_resolve</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>resolverGroup</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>incidentDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field><operaton:field name="maxEscalations"><operaton:string>3</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="u10_resolve_breachGw" name="Deemed?" default="up10_incident_f8"></exclusiveGateway>
    <exclusiveGateway id="u10_resolve_done" name=""></exclusiveGateway>
    <parallelGateway id="u10_swarm" name="Swarm"></parallelGateway>
    <exclusiveGateway id="u10_decGw" name="" default="up10_incident_f24"></exclusiveGateway>
    <parallelGateway id="u10_join" name="All groups done"></parallelGateway>
    <userTask id="u10_netops" name="Network investigation" operaton:candidateGroups="NET-OPS" operaton:formKey="sangam:up10-incident-swarming/swarm-net-ops"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <userTask id="u10_appops" name="Application investigation" operaton:candidateGroups="APP-OPS" operaton:formKey="sangam:up10-incident-swarming/swarm-app-ops"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <userTask id="u10_dbops" name="Database investigation" operaton:candidateGroups="DB-OPS" operaton:formKey="sangam:up10-incident-swarming/swarm-db-ops"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <userTask id="u10_incidentmgr" name="Major incident bridge" operaton:candidateGroups="INCIDENT-MGR" operaton:formKey="sangam:up10-incident-swarming/swarm-incident-mgr"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <userTask id="u10_confirm" name="Confirm resolution" operaton:candidateGroups="${initiatorSeat}" operaton:formKey="sangam:up10-incident-swarming/confirm"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>confirmDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="u10_confGw" name="" default="up10_incident_f27"></exclusiveGateway>
    <endEvent id="u10_end" name="Closed"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="u10_resolve_warn" name="SLA warning (75%)" attachedToRef="u10_resolve" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${u10_resolveWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="u10_resolve_breach" name="SLA breached" attachedToRef="u10_resolve" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${u10_resolveDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="up10_incident_f1" sourceRef="u10_start" targetRef="u10_prio"/>
    <sequenceFlow id="up10_incident_f2" sourceRef="u10_prio" targetRef="u10_majorGw"/>
    <sequenceFlow id="up10_incident_f3" sourceRef="u10_resolve_warn" targetRef="u10_resolve_warnNotify"/>
    <sequenceFlow id="up10_incident_f4" sourceRef="u10_resolve_warnNotify" targetRef="u10_resolve_warnEnd"/>
    <sequenceFlow id="up10_incident_f5" sourceRef="u10_resolve_breach" targetRef="u10_resolve_breachAct"/>
    <sequenceFlow id="up10_incident_f6" sourceRef="u10_resolve_breachAct" targetRef="u10_resolve_breachGw"/>
    <sequenceFlow id="up10_incident_f7" name="deemed" sourceRef="u10_resolve_breachGw" targetRef="u10_resolve_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="up10_incident_f8" name="escalated" sourceRef="u10_resolve_breachGw" targetRef="u10_resolve_slaPlan"/>
    <sequenceFlow id="up10_incident_f9" sourceRef="u10_resolve_slaPlan" targetRef="u10_resolve"/>
    <sequenceFlow id="up10_incident_f10" sourceRef="u10_resolve" targetRef="u10_resolve_done"/>
    <sequenceFlow id="up10_incident_f11" name="no" sourceRef="u10_majorGw" targetRef="u10_resolve_slaPlan"/>
    <sequenceFlow id="up10_incident_f12" name="major" sourceRef="u10_majorGw" targetRef="u10_swarm"><conditionExpression xsi:type="tFormalExpression">${majorIncident}</conditionExpression></sequenceFlow>
    <sequenceFlow id="up10_incident_f13" sourceRef="u10_resolve_done" targetRef="u10_decGw"/>
    <sequenceFlow id="up10_incident_f14" name="swarm" sourceRef="u10_decGw" targetRef="u10_swarm"><conditionExpression xsi:type="tFormalExpression">${incidentDecision == 'swarm'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="up10_incident_f15" sourceRef="u10_swarm" targetRef="u10_netops"/>
    <sequenceFlow id="up10_incident_f16" sourceRef="u10_netops" targetRef="u10_join"/>
    <sequenceFlow id="up10_incident_f17" sourceRef="u10_swarm" targetRef="u10_appops"/>
    <sequenceFlow id="up10_incident_f18" sourceRef="u10_appops" targetRef="u10_join"/>
    <sequenceFlow id="up10_incident_f19" sourceRef="u10_swarm" targetRef="u10_dbops"/>
    <sequenceFlow id="up10_incident_f20" sourceRef="u10_dbops" targetRef="u10_join"/>
    <sequenceFlow id="up10_incident_f21" sourceRef="u10_swarm" targetRef="u10_incidentmgr"/>
    <sequenceFlow id="up10_incident_f22" sourceRef="u10_incidentmgr" targetRef="u10_join"/>
    <sequenceFlow id="up10_incident_f23" sourceRef="u10_join" targetRef="u10_confirm"/>
    <sequenceFlow id="up10_incident_f24" name="fixed" sourceRef="u10_decGw" targetRef="u10_confirm"/>
    <sequenceFlow id="up10_incident_f25" sourceRef="u10_confirm" targetRef="u10_confGw"/>
    <sequenceFlow id="up10_incident_f26" name="reopen" sourceRef="u10_confGw" targetRef="u10_resolve_slaPlan"><conditionExpression xsi:type="tFormalExpression">${confirmDecision == 'reopen'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="up10_incident_f27" name="close" sourceRef="u10_confGw" targetRef="u10_end"/>
    <subProcess id="u10_reprioritise" name="Re-prioritise in flight" triggeredByEvent="true">
      <startEvent id="u10_rpStart" name="Priority changed" isInterrupting="false"><messageEventDefinition messageRef="msg_sangam_incident_reprioritise"/></startEvent>
      <businessRuleTask id="u10_rpRule" name="Re-evaluate" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>up10-priority</operaton:string></operaton:field><operaton:field name="binding"><operaton:string>latest</operaton:string></operaton:field></extensionElements></businessRuleTask>
      <endEvent id="u10_rpEnd" name="Updated"></endEvent>
      <sequenceFlow id="up10_incident_f28" sourceRef="u10_rpStart" targetRef="u10_rpRule"/>
      <sequenceFlow id="up10_incident_f29" sourceRef="u10_rpRule" targetRef="u10_rpEnd"/>
    </subProcess>
  </process>
  <bpmndi:BPMNDiagram id="up10_incident_diagram">
