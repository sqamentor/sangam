    <sequenceFlow id="sec_ushealth_provider_ac_f11" name="not attributed / opted out" sourceRef="pv_checkGw" targetRef="pv_endRefused"><conditionExpression xsi:type="tFormalExpression">${attrStatus == 'COMPLETED' &amp;&amp; attrAttributed != null &amp;&amp; optoutStatus == 'COMPLETED' &amp;&amp; optoutOptedOut != null &amp;&amp; (!attrAttributed || optoutOptedOut)}</conditionExpression></sequenceFlow>
