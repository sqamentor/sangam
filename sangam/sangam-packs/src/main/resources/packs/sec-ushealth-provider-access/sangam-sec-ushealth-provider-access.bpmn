    <serviceTask id="pv_optOut" name="Check the patient's opt-out" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>payer.memberRecord</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>optOut</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>memberId</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>optout</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="pv_checkGw" name="Data may be shared?" default="sec_ushealth_provider_ac_f13"></exclusiveGateway>
    <userTask id="pv_checkHold" name="Attribution or opt-out not confirmed: confirm at the source" operaton:candidateGroups="${memberSeat}" operaton:formKey="sangam:sec-ushealth-provider-access/checkHold"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
