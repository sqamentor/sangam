    <sequenceFlow id="sec_ushealth_provider_ac_f21" name="not confirmed" sourceRef="pv_sendGw" targetRef="pv_sendHold"><conditionExpression xsi:type="tFormalExpression">${sentStatus != 'COMPLETED' || sentReceiptRef == null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ushealth_provider_ac_f22" name="answered" sourceRef="pv_sendGw" targetRef="pv_end"/>
