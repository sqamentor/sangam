    <sequenceFlow id="sec_ushealth_provider_ac_f16" name="not confirmed" sourceRef="pv_exportGw" targetRef="pv_exportHold"><conditionExpression xsi:type="tFormalExpression">${exportStatus != 'COMPLETED' || exportBundleRef == null}</conditionExpression></sequenceFlow>
