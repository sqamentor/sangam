  <process id="sangam-budget-reappropriation" name="Budget re-appropriation" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.ifms.budget-reappropriation</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>fromHead,toHead,amount</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="br_start" name="Proposal submitted" operaton:initiator="initiator" operaton:formKey="sangam:budget-reappropriation/proposal"></startEvent>
    <serviceTask id="br_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>caseType=REAPPROPRIATION;routingDecisionKey=reapp-authority;scrutinySeat=BUDGET-SO;referToTenant=finance;referralQuestion=Concurrence for re-appropriation;executionConnector=ledger.transfer;executionStep=reappropriate;ledgerId=BUDGET;reconcileRequired=false;outputTemplate=reappropriation-order;appealAllowed=false;budgetAvailable=0;budgetHead=@fromHead</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="br_savings" name="Savings in the source head" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>ledger.available</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>available</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>ledgerId,fromHead,amount</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>budget</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="br_savGw" name="Savings enough?" default="budget_reappropriation_f7"></exclusiveGateway>
    <callActivity id="br_scrutiny" name="Budget section scrutiny (core)" calledElement="sangam-core-scrutiny"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <serviceTask id="br_rjSav_code" name="Reason: SAVINGS_NOT_AVAILABLE" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=SAVINGS_NOT_AVAILABLE</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="br_rjSav_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="br_rjSav_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <callActivity id="br_rj_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="br_rj_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <callActivity id="br_finance" name="Finance concurrence (core referral)" calledElement="sangam-core-referral"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <exclusiveGateway id="br_scrGw" name="scrutinyOutcome?" default="budget_reappropriation_f10"></exclusiveGateway>
    <callActivity id="br_sanction" name="Sanction by re-appropriation power (core)" calledElement="sangam-core-sanction"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <exclusiveGateway id="br_concurGw" name="Finance concurs?" default="budget_reappropriation_f16"></exclusiveGateway>
    <serviceTask id="br_rjFin_code" name="Reason: FINANCE_NOT_CONCURRED" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=FINANCE_NOT_CONCURRED</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="br_rjFin_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="br_rjFin_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <callActivity id="br_post" name="Post in IFMS (core execution)" calledElement="sangam-core-execution"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <exclusiveGateway id="br_sanGw" name="sanctionOutcome?" default="budget_reappropriation_f19"></exclusiveGateway>
    <callActivity id="br_close" name="Order and closure (core)" calledElement="sangam-core-closure"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <serviceTask id="br_postFailed" name="IFMS rejected the posting" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>ifms-posting-failed</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>inapp</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>initiatorSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="br_exGw" name="executionOutcome?" default="budget_reappropriation_f22"></exclusiveGateway>
