    <sequenceFlow id="budget_reappropriation_f1" sourceRef="br_start" targetRef="br_defaults"/>
    <sequenceFlow id="budget_reappropriation_f2" sourceRef="br_defaults" targetRef="br_savings"/>
    <sequenceFlow id="budget_reappropriation_f3" sourceRef="br_savings" targetRef="br_savGw"/>
    <sequenceFlow id="budget_reappropriation_f4" name="yes" sourceRef="br_savGw" targetRef="br_scrutiny"><conditionExpression xsi:type="tFormalExpression">${budgetAvailable &gt;= amount}</conditionExpression></sequenceFlow>
    <sequenceFlow id="budget_reappropriation_f5" sourceRef="br_rjSav_reject" targetRef="br_rjSav_endRejected"/>
    <sequenceFlow id="budget_reappropriation_f6" sourceRef="br_rjSav_code" targetRef="br_rjSav_reject"/>
    <sequenceFlow id="budget_reappropriation_f7" name="no" sourceRef="br_savGw" targetRef="br_rjSav_code"/>
    <sequenceFlow id="budget_reappropriation_f8" sourceRef="br_rj_reject" targetRef="br_rj_endRejected"/>
    <sequenceFlow id="budget_reappropriation_f9" name="ACCEPTED" sourceRef="br_scrGw" targetRef="br_finance"><conditionExpression xsi:type="tFormalExpression">${scrutinyOutcome == 'ACCEPTED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="budget_reappropriation_f10" name="otherwise" sourceRef="br_scrGw" targetRef="br_rj_reject"/>
    <sequenceFlow id="budget_reappropriation_f11" sourceRef="br_scrutiny" targetRef="br_scrGw"/>
    <sequenceFlow id="budget_reappropriation_f12" sourceRef="br_finance" targetRef="br_concurGw"/>
    <sequenceFlow id="budget_reappropriation_f13" name="concur" sourceRef="br_concurGw" targetRef="br_sanction"><conditionExpression xsi:type="tFormalExpression">${referralDecision == 'concur'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="budget_reappropriation_f14" sourceRef="br_rjFin_reject" targetRef="br_rjFin_endRejected"/>
    <sequenceFlow id="budget_reappropriation_f15" sourceRef="br_rjFin_code" targetRef="br_rjFin_reject"/>
    <sequenceFlow id="budget_reappropriation_f16" name="not concurred" sourceRef="br_concurGw" targetRef="br_rjFin_code"/>
    <sequenceFlow id="budget_reappropriation_f17" name="SANCTIONED" sourceRef="br_sanGw" targetRef="br_post"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="budget_reappropriation_f18" name="RETURNED" sourceRef="br_sanGw" targetRef="br_scrutiny"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'RETURNED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="budget_reappropriation_f19" name="otherwise" sourceRef="br_sanGw" targetRef="br_rj_reject"/>
    <sequenceFlow id="budget_reappropriation_f20" sourceRef="br_sanction" targetRef="br_sanGw"/>
    <sequenceFlow id="budget_reappropriation_f21" name="DONE" sourceRef="br_exGw" targetRef="br_close"><conditionExpression xsi:type="tFormalExpression">${executionOutcome == 'DONE'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="budget_reappropriation_f22" name="otherwise" sourceRef="br_exGw" targetRef="br_postFailed"/>
    <sequenceFlow id="budget_reappropriation_f23" sourceRef="br_post" targetRef="br_exGw"/>
    <sequenceFlow id="budget_reappropriation_f24" sourceRef="br_postFailed" targetRef="br_scrutiny"/>
    <sequenceFlow id="budget_reappropriation_f25" sourceRef="br_close" targetRef="br_end"/>
    <subProcess id="br_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="br_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="br_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="br_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="br_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="budget_reappropriation_f26" sourceRef="br_withdrawStart" targetRef="br_withdrawKind"/>
      <sequenceFlow id="budget_reappropriation_f27" sourceRef="br_withdrawKind" targetRef="br_withdrawCall"/>
      <sequenceFlow id="budget_reappropriation_f28" sourceRef="br_withdrawCall" targetRef="br_withdrawEnd"/>
    </subProcess>
    <subProcess id="br_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="br_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="br_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="br_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="br_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="budget_reappropriation_f29" sourceRef="br_cancelStart" targetRef="br_cancelKind"/>
      <sequenceFlow id="budget_reappropriation_f30" sourceRef="br_cancelKind" targetRef="br_cancelCall"/>
      <sequenceFlow id="budget_reappropriation_f31" sourceRef="br_cancelCall" targetRef="br_cancelEnd"/>
    </subProcess>
