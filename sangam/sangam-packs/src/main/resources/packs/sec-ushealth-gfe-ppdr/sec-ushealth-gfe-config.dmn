<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_sec_ushealth_gfe_config" name="GFE timeframes and PPDR threshold (45 CFR 149.610 / 149.620; tenant overridable)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <!-- US-HLT-110, US-HLT-112. $400 and 120 days: verify current CMS figures. -->
  <decision id="sec-ushealth-gfe-config" name="GFE timeframes and PPDR threshold (45 CFR 149.610 / 149.620; tenant overridable)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="sec-ushealth-gfe-config_t" hitPolicy="FIRST">
      <input id="sec-ushealth-gfe-config_i0" label="Business days until service"><inputExpression id="sec-ushealth-gfe-config_ie0" typeRef="integer"><text>daysUntilService</text></inputExpression></input>
      <output id="sec-ushealth-gfe-config_o0" label="GFE due within" name="gfeSpec" typeRef="string"/>
      <output id="sec-ushealth-gfe-config_o1" label="Dispute threshold (USD)" name="ppdrThreshold" typeRef="double"/>
      <output id="sec-ushealth-gfe-config_o2" label="Initiation window from the bill date" name="ppdrWindowLead" typeRef="string"/>
      <rule id="sec-ushealth-gfe-config_r0"><description>on request: 3 business days</description>
        <inputEntry id="sec-ushealth-gfe-config_r0_i0"><text>0</text></inputEntry>
        <outputEntry id="sec-ushealth-gfe-config_r0_o0"><text>"3WD"</text></outputEntry>
        <outputEntry id="sec-ushealth-gfe-config_r0_o1"><text>400</text></outputEntry>
        <outputEntry id="sec-ushealth-gfe-config_r0_o2"><text>"-P120D"</text></outputEntry>
      </rule>
      <rule id="sec-ushealth-gfe-config_r1"><description>scheduled 10+ business days ahead: 3 business days</description>
        <inputEntry id="sec-ushealth-gfe-config_r1_i0"><text>&gt;= 10</text></inputEntry>
        <outputEntry id="sec-ushealth-gfe-config_r1_o0"><text>"3WD"</text></outputEntry>
        <outputEntry id="sec-ushealth-gfe-config_r1_o1"><text>400</text></outputEntry>
        <outputEntry id="sec-ushealth-gfe-config_r1_o2"><text>"-P120D"</text></outputEntry>
      </rule>
      <rule id="sec-ushealth-gfe-config_r2"><description>scheduled 3-9 business days ahead: 1 business day</description>
        <inputEntry id="sec-ushealth-gfe-config_r2_i0"><text>&gt;= 3</text></inputEntry>
        <outputEntry id="sec-ushealth-gfe-config_r2_o0"><text>"1WD"</text></outputEntry>
        <outputEntry id="sec-ushealth-gfe-config_r2_o1"><text>400</text></outputEntry>
        <outputEntry id="sec-ushealth-gfe-config_r2_o2"><text>"-P120D"</text></outputEntry>
      </rule>
      <rule id="sec-ushealth-gfe-config_r3"><description>under 3 days: no GFE duty; SYNTHETIC courtesy</description>
        <inputEntry id="sec-ushealth-gfe-config_r3_i0"><text>-</text></inputEntry>
        <outputEntry id="sec-ushealth-gfe-config_r3_o0"><text>"1WD"</text></outputEntry>
        <outputEntry id="sec-ushealth-gfe-config_r3_o1"><text>400</text></outputEntry>
        <outputEntry id="sec-ushealth-gfe-config_r3_o2"><text>"-P120D"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
