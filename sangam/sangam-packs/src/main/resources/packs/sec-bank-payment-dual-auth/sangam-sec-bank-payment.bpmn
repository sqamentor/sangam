      <bpmndi:BPMNShape id="py_correct_wd_call_di" bpmnElement="py_correct_wd_call"><dc:Bounds x="3815" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="py_correct_wd_end_di" bpmnElement="py_correct_wd_end"><dc:Bounds x="4012" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="py_screen_di" bpmnElement="py_screen"><dc:Bounds x="680" y="30" width="100" height="80"/></bpmndi:BPMNShape>
