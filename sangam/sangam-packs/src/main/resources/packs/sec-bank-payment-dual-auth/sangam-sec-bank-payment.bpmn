    <boundaryEvent id="py_inv" name="Changed after approval" attachedToRef="py_pay" cancelActivity="true"><errorEventDefinition errorRef="err_APPROVAL_INVALIDATED"/></boundaryEvent>
    <sequenceFlow id="sec_bank_payment_f1" sourceRef="py_bene_clear" targetRef="py_bene"/>
    <sequenceFlow id="sec_bank_payment_f2" sourceRef="py_start" targetRef="py_defaults"/>
    <sequenceFlow id="sec_bank_payment_f3" sourceRef="py_defaults" targetRef="py_bene_clear"/>
    <sequenceFlow id="sec_bank_payment_f4" sourceRef="py_bene" targetRef="py_beneGw"/>
    <sequenceFlow id="sec_bank_payment_f5" sourceRef="py_correct" targetRef="py_correct_gw"/>
    <sequenceFlow id="sec_bank_payment_f6" name="resubmit" sourceRef="py_correct_gw" targetRef="py_correct_version"><conditionExpression xsi:type="tFormalExpression">${py_correctDecision == 'resubmit'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_payment_f7" sourceRef="py_correct_version" targetRef="py_bene_clear"/>
    <sequenceFlow id="sec_bank_payment_f8" sourceRef="py_correct_wd_kind" targetRef="py_correct_wd_call"/>
    <sequenceFlow id="sec_bank_payment_f9" sourceRef="py_correct_wd_call" targetRef="py_correct_wd_end"/>
    <sequenceFlow id="sec_bank_payment_f10" name="withdraw" sourceRef="py_correct_gw" targetRef="py_correct_wd_kind"/>
    <sequenceFlow id="sec_bank_payment_f11" sourceRef="py_rjBene_reject" targetRef="py_rjBene_endRejected"/>
    <sequenceFlow id="sec_bank_payment_f12" sourceRef="py_rjBene_code" targetRef="py_rjBene_reject"/>
    <sequenceFlow id="sec_bank_payment_f13" name="validation not confirmed" sourceRef="py_beneGw" targetRef="py_rjBene_code"><conditionExpression xsi:type="tFormalExpression">${beneStatus != 'COMPLETED' || beneNameMatch == null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_payment_f14" name="mismatch" sourceRef="py_beneGw" targetRef="py_correct"><conditionExpression xsi:type="tFormalExpression">${beneStatus == 'COMPLETED' &amp;&amp; beneNameMatch != null &amp;&amp; (!beneNameMatch)}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_payment_f15" sourceRef="py_screen_clear" targetRef="py_screen"/>
    <sequenceFlow id="sec_bank_payment_f16" name="match" sourceRef="py_beneGw" targetRef="py_screen_clear"/>
    <sequenceFlow id="sec_bank_payment_f17" sourceRef="py_screen" targetRef="py_screenGw"/>
    <sequenceFlow id="sec_bank_payment_f18" sourceRef="py_rjScreenCheck_reject" targetRef="py_rjScreenCheck_endRejected"/>
    <sequenceFlow id="sec_bank_payment_f19" sourceRef="py_rjScreenCheck_code" targetRef="py_rjScreenCheck_reject"/>
    <sequenceFlow id="sec_bank_payment_f20" name="screening not confirmed" sourceRef="py_screenGw" targetRef="py_rjScreenCheck_code"><conditionExpression xsi:type="tFormalExpression">${screenStatus != 'COMPLETED' || screenHit == null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_payment_f21" name="hit" sourceRef="py_screenGw" targetRef="py_compliance"><conditionExpression xsi:type="tFormalExpression">${screenStatus == 'COMPLETED' &amp;&amp; screenHit != null &amp;&amp; (screenHit)}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_payment_f22" name="clear" sourceRef="py_screenGw" targetRef="py_limits"/>
    <sequenceFlow id="sec_bank_payment_f23" sourceRef="py_compliance" targetRef="py_compGw"/>
    <sequenceFlow id="sec_bank_payment_f24" name="false positive" sourceRef="py_compGw" targetRef="py_limits"><conditionExpression xsi:type="tFormalExpression">${screenDecision == 'falsePositive'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_payment_f25" sourceRef="py_rjScreen_reject" targetRef="py_rjScreen_endRejected"/>
    <sequenceFlow id="sec_bank_payment_f26" sourceRef="py_rjScreen_code" targetRef="py_rjScreen_reject"/>
    <sequenceFlow id="sec_bank_payment_f27" name="reject" sourceRef="py_compGw" targetRef="py_rjScreen_code"/>
    <sequenceFlow id="sec_bank_payment_f28" sourceRef="py_limits" targetRef="py_limGw"/>
    <sequenceFlow id="sec_bank_payment_f29" name="rail not permitted for this amount: correct" sourceRef="py_limGw" targetRef="py_correct"><conditionExpression xsi:type="tFormalExpression">${!railAllowed}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_payment_f30" name="allowed" sourceRef="py_limGw" targetRef="py_auth1"/>
    <sequenceFlow id="sec_bank_payment_f31" sourceRef="py_auth1" targetRef="py_checkerPrepareGw"/>
    <sequenceFlow id="sec_bank_payment_f32" sourceRef="py_rj_reject" targetRef="py_rj_endRejected"/>
    <sequenceFlow id="sec_bank_payment_f33" name="SANCTIONED" sourceRef="py_chkGw" targetRef="py_levelGw"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_payment_f34" name="RETURNED" sourceRef="py_chkGw" targetRef="py_correct"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'RETURNED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_payment_f35" name="otherwise" sourceRef="py_chkGw" targetRef="py_rj_reject"/>
    <sequenceFlow id="sec_bank_payment_f36" sourceRef="py_checker" targetRef="py_chkGw"/>
    <sequenceFlow id="sec_bank_payment_f37" name="above the band" sourceRef="py_levelGw" targetRef="py_auth2"><conditionExpression xsi:type="tFormalExpression">${authLevels &gt; 1}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_payment_f38" sourceRef="py_auth2" targetRef="py_authoriserPrepareGw"/>
    <sequenceFlow id="sec_bank_payment_f39" name="one level" sourceRef="py_levelGw" targetRef="py_pay"/>
    <sequenceFlow id="sec_bank_payment_f40" name="SANCTIONED" sourceRef="py_authGw" targetRef="py_pay"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_payment_f41" name="RETURNED" sourceRef="py_authGw" targetRef="py_correct"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'RETURNED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_payment_f42" name="otherwise" sourceRef="py_authGw" targetRef="py_rj_reject"/>
    <sequenceFlow id="sec_bank_payment_f43" sourceRef="py_authoriser" targetRef="py_authGw"/>
    <sequenceFlow id="sec_bank_payment_f44" sourceRef="py_inv" targetRef="py_auth1"/>
    <sequenceFlow id="sec_bank_payment_f45" name="DONE" sourceRef="py_exGw" targetRef="py_close"><conditionExpression xsi:type="tFormalExpression">${executionOutcome == 'DONE'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_payment_f46" name="otherwise" sourceRef="py_exGw" targetRef="py_failed"/>
    <sequenceFlow id="sec_bank_payment_f47" sourceRef="py_pay" targetRef="py_exGw"/>
    <sequenceFlow id="sec_bank_payment_f48" sourceRef="py_failed" targetRef="py_correct"/>
    <sequenceFlow id="sec_bank_payment_f49" sourceRef="py_close" targetRef="py_end"/>
    <sequenceFlow id="sec_bank_payment_f59" name="DSC signature needed" sourceRef="py_checkerPrepareGw" targetRef="py_checkerPrepare"><conditionExpression xsi:type="tFormalExpression">${execution.getVariable('signatureRequired') == true}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_payment_f60" name="no DSC signature" sourceRef="py_checkerPrepareGw" targetRef="py_checker"/>
    <sequenceFlow id="sec_bank_payment_f61" sourceRef="py_checkerPrepare" targetRef="py_checker"/>
    <sequenceFlow id="sec_bank_payment_f62" name="DSC signature needed" sourceRef="py_authoriserPrepareGw" targetRef="py_authoriserPrepare"><conditionExpression xsi:type="tFormalExpression">${execution.getVariable('signatureRequired') == true}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_payment_f63" name="no DSC signature" sourceRef="py_authoriserPrepareGw" targetRef="py_authoriser"/>
    <sequenceFlow id="sec_bank_payment_f64" sourceRef="py_authoriserPrepare" targetRef="py_authoriser"/>
    <subProcess id="py_return" name="Payment returned by the beneficiary bank" triggeredByEvent="true">
      <startEvent id="py_retStart" name="Return received" isInterrupting="false"><messageEventDefinition messageRef="msg_sangam_payment_returned"/></startEvent>
      <callActivity id="py_retCredit_sanction" name="Approve release of money (core sanction, owner decision A1)" calledElement="sangam-core-sanction" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.3"><extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.SetVariablesDelegate"><operaton:field name="values"><operaton:string>caseType=PAYMENT</operaton:string></operaton:field></operaton:executionListener><operaton:executionListener event="start" class="org.sangam.packs.core.MoneyFieldsDelegate"><operaton:field name="payeeKeys"><operaton:string>remitterPartyId</operaton:string></operaton:field><operaton:field name="purpose"><operaton:string>Credit back a returned transfer to the remitter</operaton:string></operaton:field></operaton:executionListener><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:in sourceExpression="${true}" target="moneyOutRelease"/><operaton:in sourceExpression="${'ESCALATE'}" target="sanctionOnBreach"/><operaton:out variables="all"/></extensionElements></callActivity>
      <exclusiveGateway id="py_retCredit_sgw" name="Sanctioned?" default="py_retCredit_sgw_no"></exclusiveGateway>
      <endEvent id="py_retCredit_notReleased" name="Not released"></endEvent>
      <serviceTask id="py_retCredit" name="Credit back the remitter" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>cbs.credit</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>credit</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>payeeAccount,amount</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>retCredit</operaton:string></operaton:field><operaton:field name="step"><operaton:string>return-credit</operaton:string></operaton:field></extensionElements></serviceTask>
      <serviceTask id="py_retNotify" name="Tell the maker" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>payment-returned</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>inapp,email</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>initiatorSeat</operaton:string></operaton:field></extensionElements></serviceTask>
      <endEvent id="py_retEnd" name="Credited back"></endEvent>
      <exclusiveGateway id="py_retCredit_sanctionPrepareGw" name="Document to sign?" default="sec_bank_payment_f66"></exclusiveGateway>
      <userTask id="py_retCredit_sanctionPrepare" name="Prepare the document to sign" operaton:candidateGroups="${initiatorSeat}" operaton:formKey="sangam:sec-bank-payment-dual-auth/prepare-sanction-note"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.DocumentSlotReadyListener"><operaton:field name="slots"><operaton:string>sanctionDocumentId:SANCTION_NOTE</operaton:string></operaton:field></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
      <sequenceFlow id="sec_bank_payment_f50" sourceRef="py_retStart" targetRef="py_retCredit_sanctionPrepareGw"/>
      <sequenceFlow id="sec_bank_payment_f51" sourceRef="py_retCredit" targetRef="py_retNotify"/>
      <sequenceFlow id="sec_bank_payment_f52" sourceRef="py_retNotify" targetRef="py_retEnd"/>
      <sequenceFlow id="py_retCredit_sanction_f" sourceRef="py_retCredit_sanction" targetRef="py_retCredit_sgw"/>
      <sequenceFlow id="py_retCredit_sgw_yes" name="sanctioned" sourceRef="py_retCredit_sgw" targetRef="py_retCredit"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
      <sequenceFlow id="py_retCredit_sgw_no" name="not sanctioned" sourceRef="py_retCredit_sgw" targetRef="py_retCredit_notReleased"/>
      <sequenceFlow id="sec_bank_payment_f65" name="DSC signature needed" sourceRef="py_retCredit_sanctionPrepareGw" targetRef="py_retCredit_sanctionPrepare"><conditionExpression xsi:type="tFormalExpression">${execution.getVariable('signatureRequired') == true}</conditionExpression></sequenceFlow>
      <sequenceFlow id="sec_bank_payment_f66" name="no DSC signature" sourceRef="py_retCredit_sanctionPrepareGw" targetRef="py_retCredit_sanction"/>
      <sequenceFlow id="sec_bank_payment_f67" sourceRef="py_retCredit_sanctionPrepare" targetRef="py_retCredit_sanction"/>
    </subProcess>
    <subProcess id="py_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="py_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="py_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="py_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.3"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="py_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="sec_bank_payment_f53" sourceRef="py_withdrawStart" targetRef="py_withdrawKind"/>
      <sequenceFlow id="sec_bank_payment_f54" sourceRef="py_withdrawKind" targetRef="py_withdrawCall"/>
      <sequenceFlow id="sec_bank_payment_f55" sourceRef="py_withdrawCall" targetRef="py_withdrawEnd"/>
    </subProcess>
    <subProcess id="py_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="py_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="py_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="py_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.3"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="py_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="sec_bank_payment_f56" sourceRef="py_cancelStart" targetRef="py_cancelKind"/>
      <sequenceFlow id="sec_bank_payment_f57" sourceRef="py_cancelKind" targetRef="py_cancelCall"/>
      <sequenceFlow id="sec_bank_payment_f58" sourceRef="py_cancelCall" targetRef="py_cancelEnd"/>
    </subProcess>
  </process>
