      <bpmndi:BPMNShape id="py_compGw_di" bpmnElement="py_compGw"><dc:Bounds x="1200" y="45" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="py_rjScreen_code_di" bpmnElement="py_rjScreen_code"><dc:Bounds x="1340" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="py_rjScreen_reject_di" bpmnElement="py_rjScreen_reject"><dc:Bounds x="1505" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="py_rjScreen_endRejected_di" bpmnElement="py_rjScreen_endRejected"><dc:Bounds x="1702" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="py_limGw_di" bpmnElement="py_limGw"><dc:Bounds x="1530" y="170" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="py_auth1_di" bpmnElement="py_auth1"><dc:Bounds x="1670" y="155" width="100" height="80"/></bpmndi:BPMNShape>
