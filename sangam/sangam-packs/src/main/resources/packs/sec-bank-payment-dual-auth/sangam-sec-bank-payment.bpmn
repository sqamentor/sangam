<!-- Payment with dual authorisation. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_sec_bank_payment" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_cancelCase" name="sangam.cancelCase"/>
  <message id="msg_sangam_payment_returned" name="sangam.payment.returned"/>
  <message id="msg_sangam_withdrawCase" name="sangam.withdrawCase"/>
  <error id="err_APPROVAL_INVALIDATED" name="APPROVAL_INVALIDATED" errorCode="APPROVAL_INVALIDATED"/>
  <process id="sangam-sec-bank-payment" name="Payment with dual authorisation" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.bank.payment-dual-auth</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>payee,account,ifsc,amount,paymentRail</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="py_start" name="Payment initiated (maker)" operaton:initiator="initiator" operaton:formKey="sangam:sec-bank-payment-dual-auth/initiate"></startEvent>
    <serviceTask id="py_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>paymentRail=NEFT;purposeCode=P0101;beneNameMatch=true;screenHit=false;caseType=PAYMENT;routingDecisionKey=sec-bank-pay-checker;powersDecisionKey=sec-bank-pay-powers;executionConnector=bank.transfer;executionStep=pay;reconcileRequired=true;executionPayloadFields=payee,account,ifsc,amount,paymentRail;outputTemplate=payment-advice;appealAllowed=false;complianceSeat=AML-COMPLIANCE</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="py_bene" name="Validate beneficiary name" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>bene.validate</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>lookup</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>account,ifsc,payee</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>bene</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="py_beneGw" name="Name matches?" default="sec_bank_payment_f11"></exclusiveGateway>
    <userTask id="py_correct" name="Correct beneficiary details" operaton:candidateGroups="${initiatorSeat}" operaton:formKey="sangam:sec-bank-payment-dual-auth/correct"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>py_correctDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="py_correct_gw" name="Resubmit?" default="sec_bank_payment_f9"></exclusiveGateway>
    <serviceTask id="py_correct_version" name="New case version" operaton:class="org.sangam.packs.core.CaseRecordDelegate"><extensionElements><operaton:field name="op"><operaton:string>RESUBMIT</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="py_correct_wd_kind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="py_correct_wd_call" name="Withdraw (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="py_correct_wd_end" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="py_screen" name="Screen payee" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>sanctions.screen</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>screen</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>payee</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>screen</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="py_screenGw" name="Hit?" default="sec_bank_payment_f14"></exclusiveGateway>
    <userTask id="py_compliance" name="Review screening hit" operaton:candidateGroups="${complianceSeat}" operaton:formKey="sangam:sec-bank-payment-dual-auth/screening"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>screenDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <businessRuleTask id="py_limits" name="Rail limits and authorisation levels (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-bank-pay-limits</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <exclusiveGateway id="py_compGw" name="" default="sec_bank_payment_f19"></exclusiveGateway>
    <serviceTask id="py_rjScreen_code" name="Reason: SANCTIONS_MATCH" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=SANCTIONS_MATCH</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="py_rjScreen_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="py_rjScreen_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <exclusiveGateway id="py_limGw" name="Rail allowed?" default="sec_bank_payment_f22"></exclusiveGateway>
    <serviceTask id="py_auth1" name="Checker routing" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>routingDecisionKey=sec-bank-pay-checker</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="py_checker" name="Checker (core sanction)" calledElement="sangam-core-sanction"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <callActivity id="py_rj_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="py_rj_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <exclusiveGateway id="py_levelGw" name="Second authoriser?" default="sec_bank_payment_f31"></exclusiveGateway>
    <exclusiveGateway id="py_chkGw" name="sanctionOutcome?" default="sec_bank_payment_f27"></exclusiveGateway>
    <serviceTask id="py_auth2" name="Authoriser routing" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>routingDecisionKey=sec-bank-pay-authoriser</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="py_authoriser" name="Authoriser (core sanction, different person and seat)" calledElement="sangam-core-sanction"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <callActivity id="py_pay" name="Transfer (core execution, class c)" calledElement="sangam-core-execution"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <exclusiveGateway id="py_authGw" name="sanctionOutcome?" default="sec_bank_payment_f34"></exclusiveGateway>
    <callActivity id="py_close" name="Advice and closure (core)" calledElement="sangam-core-closure"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <serviceTask id="py_failed" name="Payment rejected by the rail" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>payment-failed</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>inapp</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>initiatorSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="py_exGw" name="executionOutcome?" default="sec_bank_payment_f38"></exclusiveGateway>
    <endEvent id="py_end" name="Paid"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="py_inv" name="Changed after approval" attachedToRef="py_pay" cancelActivity="true"><errorEventDefinition errorRef="err_APPROVAL_INVALIDATED"/></boundaryEvent>
    <sequenceFlow id="sec_bank_payment_f1" sourceRef="py_start" targetRef="py_defaults"/>
    <sequenceFlow id="sec_bank_payment_f2" sourceRef="py_defaults" targetRef="py_bene"/>
    <sequenceFlow id="sec_bank_payment_f3" sourceRef="py_bene" targetRef="py_beneGw"/>
    <sequenceFlow id="sec_bank_payment_f4" sourceRef="py_correct" targetRef="py_correct_gw"/>
    <sequenceFlow id="sec_bank_payment_f5" name="resubmit" sourceRef="py_correct_gw" targetRef="py_correct_version"><conditionExpression xsi:type="tFormalExpression">${py_correctDecision == 'resubmit'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_payment_f6" sourceRef="py_correct_version" targetRef="py_bene"/>
    <sequenceFlow id="sec_bank_payment_f7" sourceRef="py_correct_wd_kind" targetRef="py_correct_wd_call"/>
    <sequenceFlow id="sec_bank_payment_f8" sourceRef="py_correct_wd_call" targetRef="py_correct_wd_end"/>
    <sequenceFlow id="sec_bank_payment_f9" name="withdraw" sourceRef="py_correct_gw" targetRef="py_correct_wd_kind"/>
    <sequenceFlow id="sec_bank_payment_f10" name="mismatch" sourceRef="py_beneGw" targetRef="py_correct"><conditionExpression xsi:type="tFormalExpression">${!beneNameMatch}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_payment_f11" name="match" sourceRef="py_beneGw" targetRef="py_screen"/>
    <sequenceFlow id="sec_bank_payment_f12" sourceRef="py_screen" targetRef="py_screenGw"/>
    <sequenceFlow id="sec_bank_payment_f13" name="hit" sourceRef="py_screenGw" targetRef="py_compliance"><conditionExpression xsi:type="tFormalExpression">${screenHit}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_payment_f14" name="clear" sourceRef="py_screenGw" targetRef="py_limits"/>
    <sequenceFlow id="sec_bank_payment_f15" sourceRef="py_compliance" targetRef="py_compGw"/>
    <sequenceFlow id="sec_bank_payment_f16" name="false positive" sourceRef="py_compGw" targetRef="py_limits"><conditionExpression xsi:type="tFormalExpression">${screenDecision == 'falsePositive'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_payment_f17" sourceRef="py_rjScreen_reject" targetRef="py_rjScreen_endRejected"/>
    <sequenceFlow id="sec_bank_payment_f18" sourceRef="py_rjScreen_code" targetRef="py_rjScreen_reject"/>
    <sequenceFlow id="sec_bank_payment_f19" name="reject" sourceRef="py_compGw" targetRef="py_rjScreen_code"/>
    <sequenceFlow id="sec_bank_payment_f20" sourceRef="py_limits" targetRef="py_limGw"/>
    <sequenceFlow id="sec_bank_payment_f21" name="rail not permitted for this amount: correct" sourceRef="py_limGw" targetRef="py_correct"><conditionExpression xsi:type="tFormalExpression">${!railAllowed}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_payment_f22" name="allowed" sourceRef="py_limGw" targetRef="py_auth1"/>
    <sequenceFlow id="sec_bank_payment_f23" sourceRef="py_auth1" targetRef="py_checker"/>
    <sequenceFlow id="sec_bank_payment_f24" sourceRef="py_rj_reject" targetRef="py_rj_endRejected"/>
    <sequenceFlow id="sec_bank_payment_f25" name="SANCTIONED" sourceRef="py_chkGw" targetRef="py_levelGw"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_payment_f26" name="RETURNED" sourceRef="py_chkGw" targetRef="py_correct"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'RETURNED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_payment_f27" name="otherwise" sourceRef="py_chkGw" targetRef="py_rj_reject"/>
    <sequenceFlow id="sec_bank_payment_f28" sourceRef="py_checker" targetRef="py_chkGw"/>
    <sequenceFlow id="sec_bank_payment_f29" name="above the band" sourceRef="py_levelGw" targetRef="py_auth2"><conditionExpression xsi:type="tFormalExpression">${authLevels &gt; 1}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_payment_f30" sourceRef="py_auth2" targetRef="py_authoriser"/>
    <sequenceFlow id="sec_bank_payment_f31" name="one level" sourceRef="py_levelGw" targetRef="py_pay"/>
    <sequenceFlow id="sec_bank_payment_f32" name="SANCTIONED" sourceRef="py_authGw" targetRef="py_pay"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_payment_f33" name="RETURNED" sourceRef="py_authGw" targetRef="py_correct"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'RETURNED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_payment_f34" name="otherwise" sourceRef="py_authGw" targetRef="py_rj_reject"/>
    <sequenceFlow id="sec_bank_payment_f35" sourceRef="py_authoriser" targetRef="py_authGw"/>
    <sequenceFlow id="sec_bank_payment_f36" sourceRef="py_inv" targetRef="py_auth1"/>
    <sequenceFlow id="sec_bank_payment_f37" name="DONE" sourceRef="py_exGw" targetRef="py_close"><conditionExpression xsi:type="tFormalExpression">${executionOutcome == 'DONE'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_payment_f38" name="otherwise" sourceRef="py_exGw" targetRef="py_failed"/>
    <sequenceFlow id="sec_bank_payment_f39" sourceRef="py_pay" targetRef="py_exGw"/>
    <sequenceFlow id="sec_bank_payment_f40" sourceRef="py_failed" targetRef="py_correct"/>
    <sequenceFlow id="sec_bank_payment_f41" sourceRef="py_close" targetRef="py_end"/>
    <subProcess id="py_return" name="Payment returned by the beneficiary bank" triggeredByEvent="true">
      <startEvent id="py_retStart" name="Return received" isInterrupting="false"><messageEventDefinition messageRef="msg_sangam_payment_returned"/></startEvent>
      <serviceTask id="py_retCredit" name="Credit back the remitter" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>cbs.credit</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>credit</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>account,amount</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>retCredit</operaton:string></operaton:field><operaton:field name="step"><operaton:string>return-credit</operaton:string></operaton:field></extensionElements></serviceTask>
      <serviceTask id="py_retNotify" name="Tell the maker" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>payment-returned</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>inapp,email</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>initiatorSeat</operaton:string></operaton:field></extensionElements></serviceTask>
      <endEvent id="py_retEnd" name="Credited back"></endEvent>
      <sequenceFlow id="sec_bank_payment_f42" sourceRef="py_retStart" targetRef="py_retCredit"/>
      <sequenceFlow id="sec_bank_payment_f43" sourceRef="py_retCredit" targetRef="py_retNotify"/>
      <sequenceFlow id="sec_bank_payment_f44" sourceRef="py_retNotify" targetRef="py_retEnd"/>
    </subProcess>
    <subProcess id="py_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="py_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="py_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="py_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="py_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="sec_bank_payment_f45" sourceRef="py_withdrawStart" targetRef="py_withdrawKind"/>
      <sequenceFlow id="sec_bank_payment_f46" sourceRef="py_withdrawKind" targetRef="py_withdrawCall"/>
      <sequenceFlow id="sec_bank_payment_f47" sourceRef="py_withdrawCall" targetRef="py_withdrawEnd"/>
    </subProcess>
    <subProcess id="py_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="py_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="py_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="py_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="py_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="sec_bank_payment_f48" sourceRef="py_cancelStart" targetRef="py_cancelKind"/>
      <sequenceFlow id="sec_bank_payment_f49" sourceRef="py_cancelKind" targetRef="py_cancelCall"/>
      <sequenceFlow id="sec_bank_payment_f50" sourceRef="py_cancelCall" targetRef="py_cancelEnd"/>
    </subProcess>
  </process>
  <bpmndi:BPMNDiagram id="sec_bank_payment_diagram">
    <bpmndi:BPMNPlane id="sec_bank_payment_plane" bpmnElement="sangam-sec-bank-payment">
      <bpmndi:BPMNShape id="py_start_di" bpmnElement="py_start"><dc:Bounds x="52" y="52" width="36" height="36"/></bpmndi:BPMNShape>
