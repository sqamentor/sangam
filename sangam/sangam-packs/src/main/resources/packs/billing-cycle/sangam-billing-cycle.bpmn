      <bpmndi:BPMNShape id="bc_load_di" bpmnElement="bc_load"><dc:Bounds x="515" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="bc_open_di" bpmnElement="bc_open"><dc:Bounds x="680" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="bc_fanOut_di" bpmnElement="bc_fanOut"><dc:Bounds x="845" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="bc_fanGw_di" bpmnElement="bc_fanGw"><dc:Bounds x="1035" y="45" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="bc_poll_di" bpmnElement="bc_poll"><dc:Bounds x="1207" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="bc_aggregate_di" bpmnElement="bc_aggregate"><dc:Bounds x="1340" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="bc_doneGw_di" bpmnElement="bc_doneGw"><dc:Bounds x="1530" y="45" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="bc_report_di" bpmnElement="bc_report"><dc:Bounds x="1670" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="bc_end_di" bpmnElement="bc_end"><dc:Bounds x="1867" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="billing_cycle_f1_di" bpmnElement="billing_cycle_f1"><di:waypoint x="88" y="195"/><di:waypoint x="149" y="195"/><di:waypoint x="149" y="70"/><di:waypoint x="210" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="billing_cycle_f2_di" bpmnElement="billing_cycle_f2"><di:waypoint x="88" y="70"/><di:waypoint x="210" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="billing_cycle_f3_di" bpmnElement="billing_cycle_f3"><di:waypoint x="260" y="70"/><di:waypoint x="350" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="billing_cycle_f4_di" bpmnElement="billing_cycle_f4"><di:waypoint x="450" y="70"/><di:waypoint x="515" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="billing_cycle_f5_di" bpmnElement="billing_cycle_f5"><di:waypoint x="780" y="70"/><di:waypoint x="845" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="billing_cycle_f6_di" bpmnElement="billing_cycle_f6"><di:waypoint x="945" y="70"/><di:waypoint x="1035" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="billing_cycle_f7_di" bpmnElement="billing_cycle_f7"><di:waypoint x="1060" y="95"/><di:waypoint x="1060" y="142"/><di:waypoint x="895" y="142"/><di:waypoint x="895" y="110"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="billing_cycle_f8_di" bpmnElement="billing_cycle_f8"><di:waypoint x="1085" y="70"/><di:waypoint x="1207" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="billing_cycle_f9_di" bpmnElement="billing_cycle_f9"><di:waypoint x="1243" y="70"/><di:waypoint x="1340" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="billing_cycle_f10_di" bpmnElement="billing_cycle_f10"><di:waypoint x="1440" y="70"/><di:waypoint x="1530" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="billing_cycle_f11_di" bpmnElement="billing_cycle_f11"><di:waypoint x="1555" y="95"/><di:waypoint x="1555" y="127"/><di:waypoint x="1225" y="127"/><di:waypoint x="1225" y="88"/></bpmndi:BPMNEdge>
