  <message id="msg_sangam_billing_paymentReceived" name="sangam.billing.paymentReceived"/>
  <process id="sangam-billing-account" name="Billing of one account" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>universal.billing-cycle</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>key,consumer,cycle</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="ba_start" name="Account in cycle"></startEvent>
    <serviceTask id="ba_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>consumer=@key;tariffId=DEFAULT;ledgerId=DEMAND;dueWait=P15D;arrInArrears=false;officerSeat=BILL-OFFICER;checkerSeat=BILL-CHECKER;waiverAmount=0;billedUnits=0</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ba_invoice" name="Invoice from the tariff" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>billing.invoice</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>invoice</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>ledgerId,consumer,cycle,tariffId,billedUnits</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>inv</operaton:string></operaton:field><operaton:field name="step"><operaton:string>invoice</operaton:string></operaton:field></extensionElements></serviceTask>
    <eventBasedGateway id="ba_wait" name="Paid or due?"></eventBasedGateway>
    <intermediateCatchEvent id="ba_paid" name="Payment confirmed by the channel"><messageEventDefinition messageRef="msg_sangam_billing_paymentReceived"/></intermediateCatchEvent>
    <intermediateCatchEvent id="ba_due" name="Due date passed"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">P15D</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <serviceTask id="ba_collect" name="Collect and receipt" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>billing.collect</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>collect</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>ledgerId,consumer,channel,paymentRef,amount</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>col</operaton:string></operaton:field><operaton:field name="step"><operaton:string>collect</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ba_arrears" name="Outstanding / arrears" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>billing.arrears</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>arrears</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>ledgerId,consumer</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>arr</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="ba_arrGw" name="In arrears?" default="billing_account_f10"></exclusiveGateway>
    <endEvent id="ba_end" name="Settled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="ba_penalty" name="Penalty / interest (tariff)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>billing.penalty</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>penalty</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>ledgerId,consumer,tariffId</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>pen</operaton:string></operaton:field><operaton:field name="step"><operaton:string>penalty</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ba_remind" name="Reminder / demand notice" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>billing-demand-notice</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>sms</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>consumer</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ba_decide_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>ba_decide</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>10WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="ba_decide" name="Arrears: waive or recover" operaton:candidateGroups="${officerSeat}" operaton:formKey="sangam:billing-cycle/decide" operaton:dueDate="${ba_decideDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>arrearsDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="ba_decide_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>ba_decide</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>officerSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="ba_decide_warnEnd" name="Warned"></endEvent>
    <serviceTask id="ba_decide_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>ba_decide</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>officerSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>arrearsDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="ba_decide_breachGw" name="Deemed?" default="billing_account_f18"></exclusiveGateway>
    <exclusiveGateway id="ba_decide_done" name=""></exclusiveGateway>
    <exclusiveGateway id="ba_decGw" name="" default="billing_account_f33"></exclusiveGateway>
    <serviceTask id="ba_check_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>ba_check</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="ba_check" name="Approve waiver (checker)" operaton:candidateGroups="${checkerSeat}" operaton:formKey="sangam:billing-cycle/approve" operaton:dueDate="${ba_checkDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>waiverDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="ba_check_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>ba_check</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>checkerSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="ba_check_warnEnd" name="Warned"></endEvent>
    <serviceTask id="ba_check_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>ba_check</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>checkerSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>waiverDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="ba_check_breachGw" name="Deemed?" default="billing_account_f28"></exclusiveGateway>
    <exclusiveGateway id="ba_check_done" name=""></exclusiveGateway>
    <endEvent id="ba_recovery" name="Recovery proceedings"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>FAILED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="ba_waive" name="Waiver / write-off" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>billing.waive</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>waive</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>ledgerId,consumer,cycle,waiverAmount,orderRef</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>wv</operaton:string></operaton:field><operaton:field name="step"><operaton:string>waive</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="ba_wvGw" name="" default="billing_account_f36"></exclusiveGateway>
    <endEvent id="ba_endWaived" name="Waived"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="ba_decide_warn" name="SLA warning (75%)" attachedToRef="ba_decide" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${ba_decideWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="ba_decide_breach" name="SLA breached" attachedToRef="ba_decide" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${ba_decideDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="ba_check_warn" name="SLA warning (75%)" attachedToRef="ba_check" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${ba_checkWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="ba_check_breach" name="SLA breached" attachedToRef="ba_check" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${ba_checkDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="billing_account_f1" sourceRef="ba_start" targetRef="ba_defaults"/>
    <sequenceFlow id="billing_account_f2" sourceRef="ba_defaults" targetRef="ba_invoice"/>
    <sequenceFlow id="billing_account_f3" sourceRef="ba_invoice" targetRef="ba_wait"/>
    <sequenceFlow id="billing_account_f4" sourceRef="ba_wait" targetRef="ba_paid"/>
    <sequenceFlow id="billing_account_f5" sourceRef="ba_wait" targetRef="ba_due"/>
    <sequenceFlow id="billing_account_f6" sourceRef="ba_paid" targetRef="ba_collect"/>
    <sequenceFlow id="billing_account_f7" sourceRef="ba_collect" targetRef="ba_arrears"/>
    <sequenceFlow id="billing_account_f8" sourceRef="ba_due" targetRef="ba_arrears"/>
    <sequenceFlow id="billing_account_f9" sourceRef="ba_arrears" targetRef="ba_arrGw"/>
    <sequenceFlow id="billing_account_f10" name="nothing outstanding" sourceRef="ba_arrGw" targetRef="ba_end"/>
    <sequenceFlow id="billing_account_f11" name="arrears" sourceRef="ba_arrGw" targetRef="ba_penalty"><conditionExpression xsi:type="tFormalExpression">${arrInArrears}</conditionExpression></sequenceFlow>
    <sequenceFlow id="billing_account_f12" sourceRef="ba_penalty" targetRef="ba_remind"/>
    <sequenceFlow id="billing_account_f13" sourceRef="ba_decide_warn" targetRef="ba_decide_warnNotify"/>
    <sequenceFlow id="billing_account_f14" sourceRef="ba_decide_warnNotify" targetRef="ba_decide_warnEnd"/>
    <sequenceFlow id="billing_account_f15" sourceRef="ba_decide_breach" targetRef="ba_decide_breachAct"/>
    <sequenceFlow id="billing_account_f16" sourceRef="ba_decide_breachAct" targetRef="ba_decide_breachGw"/>
    <sequenceFlow id="billing_account_f17" name="deemed" sourceRef="ba_decide_breachGw" targetRef="ba_decide_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="billing_account_f18" name="escalated" sourceRef="ba_decide_breachGw" targetRef="ba_decide_slaPlan"/>
    <sequenceFlow id="billing_account_f19" sourceRef="ba_decide_slaPlan" targetRef="ba_decide"/>
    <sequenceFlow id="billing_account_f20" sourceRef="ba_decide" targetRef="ba_decide_done"/>
    <sequenceFlow id="billing_account_f21" sourceRef="ba_remind" targetRef="ba_decide_slaPlan"/>
    <sequenceFlow id="billing_account_f22" sourceRef="ba_decide_done" targetRef="ba_decGw"/>
    <sequenceFlow id="billing_account_f23" sourceRef="ba_check_warn" targetRef="ba_check_warnNotify"/>
    <sequenceFlow id="billing_account_f24" sourceRef="ba_check_warnNotify" targetRef="ba_check_warnEnd"/>
    <sequenceFlow id="billing_account_f25" sourceRef="ba_check_breach" targetRef="ba_check_breachAct"/>
    <sequenceFlow id="billing_account_f26" sourceRef="ba_check_breachAct" targetRef="ba_check_breachGw"/>
    <sequenceFlow id="billing_account_f27" name="deemed" sourceRef="ba_check_breachGw" targetRef="ba_check_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="billing_account_f28" name="escalated" sourceRef="ba_check_breachGw" targetRef="ba_check_slaPlan"/>
    <sequenceFlow id="billing_account_f29" sourceRef="ba_check_slaPlan" targetRef="ba_check"/>
    <sequenceFlow id="billing_account_f30" sourceRef="ba_check" targetRef="ba_check_done"/>
    <sequenceFlow id="billing_account_f31" name="waive" sourceRef="ba_decGw" targetRef="ba_check_slaPlan"><conditionExpression xsi:type="tFormalExpression">${arrearsDecision == 'waive'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="billing_account_f32" name="wait again" sourceRef="ba_decGw" targetRef="ba_wait"><conditionExpression xsi:type="tFormalExpression">${arrearsDecision == 'remindAgain'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="billing_account_f33" name="recover" sourceRef="ba_decGw" targetRef="ba_recovery"/>
    <sequenceFlow id="billing_account_f34" sourceRef="ba_check_done" targetRef="ba_wvGw"/>
    <sequenceFlow id="billing_account_f35" name="approved" sourceRef="ba_wvGw" targetRef="ba_waive"><conditionExpression xsi:type="tFormalExpression">${waiverDecision == 'approve'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="billing_account_f36" name="rejected" sourceRef="ba_wvGw" targetRef="ba_decide_slaPlan"/>
    <sequenceFlow id="billing_account_f37" sourceRef="ba_waive" targetRef="ba_endWaived"/>
  </process>
