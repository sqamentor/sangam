  <message id="msg_sangam_signatureResult" name="sangam.signatureResult"/>
  <process id="sangam-core-sanction" name="Core: sanction by the competent authority" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <documentation>SANCTION / APPROVAL (IX.3): the competent role comes from the routing DMN (routingDecisionKey, the rule in force today), the seat from the hierarchy (IX.5 rule 2); at completion the seat's delegated power is checked against the powers DMN (K6), SoD by person and seat (K5), and the approval is bound to the payload hash (K4). Deemed approval by the system principal on behalf of the seat where the law provides it (J-P4-E07). Optional signature over the approved hash (GP-34, J-P2-E06/E07). Output: sanctionOutcome SANCTIONED / REJECTED / RETURNED.</documentation>
    <startEvent id="sn_start" name="Sanction requested"></startEvent>
    <serviceTask id="sn_defaults" name="Defaults" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>deemedDecision=false</operaton:string></operaton:field><operaton:field name="defaults"><operaton:string>sanctionSla=5WD;sanctionOnBreach=ESCALATE;signatureRequired=false;powersDecisionKey=sangam-core-powers;routingDecisionKey=sangam-core-competent-authority;caseType=GENERAL;signMethod=esign;espId=ESP-1</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="sn_state" name="State: SANCTION" operaton:class="org.sangam.packs.core.LifecycleStateDelegate"><extensionElements><operaton:field name="state"><operaton:string>SANCTION</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="sn_route" name="Competent authority (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:expression>${routingDecisionKey}</operaton:expression></operaton:field><operaton:field name="binding"><operaton:string>latest</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <serviceTask id="sn_seat" name="Resolve competent seat" operaton:class="org.sangam.packs.core.SeatResolutionDelegate"><extensionElements><operaton:field name="op"><operaton:string>ROLE</operaton:string></operaton:field><operaton:field name="roleVar"><operaton:string>competentRole</operaton:string></operaton:field><operaton:field name="targetVar"><operaton:string>sanctionSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="sn_sanction_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>sn_sanction</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${sanctionSla}</operaton:expression></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="sn_sanction" name="Sanction / approval" operaton:candidateGroups="${sanctionSeat}" operaton:formKey="sangam:core/sanction" operaton:dueDate="${sn_sanctionDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.PowerLimitGuardListener"><operaton:field name="decisionKey"><operaton:expression>${powersDecisionKey}</operaton:expression></operaton:field><operaton:field name="approveValues"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>sanctionDecision</operaton:string></operaton:field></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ApprovalBindingListener"><operaton:field name="decisionVar"><operaton:string>sanctionDecision</operaton:string></operaton:field><operaton:field name="approveValues"><operaton:string>approve</operaton:string></operaton:field></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>sanctionDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="sn_sanction_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>sn_sanction</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>sanctionSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="sn_sanction_warnEnd" name="Warned"></endEvent>
    <serviceTask id="sn_sanction_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>sn_sanction</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:expression>${sanctionOnBreach}</operaton:expression></operaton:field><operaton:field name="seatVar"><operaton:string>sanctionSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>sanctionDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
