    <endEvent id="sn_endSanctioned" name="Sanctioned"></endEvent>
    <serviceTask id="sn_rejected" name="Rejected" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>sanctionOutcome=REJECTED</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="sn_endRejected" name="Rejected"></endEvent>
    <serviceTask id="sn_returned" name="Returned" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>sanctionOutcome=RETURNED</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="sn_endReturned" name="Returned"></endEvent>
