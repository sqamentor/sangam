    <serviceTask id="sn_approved" name="State: APPROVED" operaton:class="org.sangam.packs.core.LifecycleStateDelegate"><extensionElements><operaton:field name="state"><operaton:string>APPROVED</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="sn_signRes" name="Signed?" default="core_sanction_f29"></exclusiveGateway>
    <eventBasedGateway id="sn_signWait" name="Awaiting ESP"></eventBasedGateway>
    <intermediateCatchEvent id="sn_signMsg" name="Signature result"><messageEventDefinition messageRef="msg_sangam_signatureResult"/></intermediateCatchEvent>
    <intermediateCatchEvent id="sn_signTimeout" name="ESP timeout"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">PT15M</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <serviceTask id="sn_signApply" name="Apply signature result" operaton:class="org.sangam.packs.core.SignatureDelegate"><extensionElements><operaton:field name="op"><operaton:string>APPLY_RESULT</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="sn_signUnknown" name="Signature status unknown" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>signatureStatus=UNKNOWN</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="sn_signFailed" name="Signature not applied: the case has not moved" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>signature-failed</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>inapp</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>sanctionSeat</operaton:string></operaton:field></extensionElements></serviceTask>
