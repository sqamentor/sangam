    <boundaryEvent id="sn_sanction_warn" name="SLA warning (75%)" attachedToRef="sn_sanction" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${sn_sanctionWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="sn_sanction_breach" name="SLA breached" attachedToRef="sn_sanction" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${sn_sanctionDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="core_sanction_f1" sourceRef="sn_sanction_warn" targetRef="sn_sanction_warnNotify"/>
