    <sequenceFlow id="core_sanction_f14" sourceRef="sn_sanction_done" targetRef="sn_deemedGw"/>
    <sequenceFlow id="core_sanction_f15" name="deemed approval" sourceRef="sn_deemedGw" targetRef="sn_bindDeemed"><conditionExpression xsi:type="tFormalExpression">${deemedDecision &amp;&amp; sanctionDecision == 'approve'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_sanction_f16" sourceRef="sn_deemedGw" targetRef="sn_decGw"/>
    <sequenceFlow id="core_sanction_f17" sourceRef="sn_bindDeemed" targetRef="sn_decGw"/>
    <sequenceFlow id="core_sanction_f18" name="approve" sourceRef="sn_decGw" targetRef="sn_signGw"><conditionExpression xsi:type="tFormalExpression">${sanctionDecision == 'approve'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_sanction_f19" name="sign" sourceRef="sn_signGw" targetRef="sn_sign"><conditionExpression xsi:type="tFormalExpression">${signatureRequired &amp;&amp; !deemedDecision}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_sanction_f20" name="no signature" sourceRef="sn_signGw" targetRef="sn_approved"/>
    <sequenceFlow id="core_sanction_f21" sourceRef="sn_sign" targetRef="sn_signRes"/>
    <sequenceFlow id="core_sanction_f22" name="signed" sourceRef="sn_signRes" targetRef="sn_approved"><conditionExpression xsi:type="tFormalExpression">${signatureStatus == 'COMPLETED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_sanction_f23" name="pending" sourceRef="sn_signRes" targetRef="sn_signWait"><conditionExpression xsi:type="tFormalExpression">${signatureStatus == 'PENDING'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_sanction_f24" sourceRef="sn_signWait" targetRef="sn_signMsg"/>
    <sequenceFlow id="core_sanction_f25" sourceRef="sn_signWait" targetRef="sn_signTimeout"/>
    <sequenceFlow id="core_sanction_f26" sourceRef="sn_signMsg" targetRef="sn_signApply"/>
    <sequenceFlow id="core_sanction_f27" sourceRef="sn_signApply" targetRef="sn_signRes"/>
    <sequenceFlow id="core_sanction_f28" sourceRef="sn_signTimeout" targetRef="sn_signUnknown"/>
    <sequenceFlow id="core_sanction_f29" name="failed" sourceRef="sn_signRes" targetRef="sn_signFailed"/>
    <sequenceFlow id="core_sanction_f30" sourceRef="sn_signUnknown" targetRef="sn_signFailed"/>
    <sequenceFlow id="core_sanction_f31" sourceRef="sn_signFailed" targetRef="sn_sanction_slaPlan"/>
    <sequenceFlow id="core_sanction_f32" sourceRef="sn_approved" targetRef="sn_sanctioned"/>
    <sequenceFlow id="core_sanction_f33" sourceRef="sn_sanctioned" targetRef="sn_endSanctioned"/>
    <sequenceFlow id="core_sanction_f34" name="reject" sourceRef="sn_decGw" targetRef="sn_rejected"><conditionExpression xsi:type="tFormalExpression">${sanctionDecision == 'reject'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_sanction_f35" sourceRef="sn_rejected" targetRef="sn_endRejected"/>
    <sequenceFlow id="core_sanction_f36" name="return" sourceRef="sn_decGw" targetRef="sn_returned"><conditionExpression xsi:type="tFormalExpression">${sanctionDecision == 'return'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_sanction_f37" sourceRef="sn_returned" targetRef="sn_endReturned"/>
    <sequenceFlow id="core_sanction_f38" name="forward" sourceRef="sn_decGw" targetRef="sn_forward"/>
    <sequenceFlow id="core_sanction_f39" sourceRef="sn_forward" targetRef="sn_sanction_slaPlan"/>
