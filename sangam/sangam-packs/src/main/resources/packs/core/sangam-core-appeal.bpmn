<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- Core: appeal or reopen. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_core_appeal" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <process id="sangam-core-appeal" name="Core: appeal or reopen" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <documentation>Appeal after rejection or deemed refusal (GP-22, J-P3-E04, J-P4-E06): the appellate seat decides; everyone who acted on the original case is excluded (K5 extended). Output: appealOutcome ALLOWED / DISMISSED.</documentation>
    <startEvent id="ap_start" name="Appeal filed"></startEvent>
    <serviceTask id="ap_defaults" name="Defaults" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>appealSla=30D;appealOnBreach=ESCALATE;appellateSeat=appellate-authority</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ap_record" name="Record appeal" operaton:class="org.sangam.packs.core.CaseRecordDelegate"><extensionElements><operaton:field name="op"><operaton:string>APPEAL</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ap_state" name="State: APPEAL" operaton:class="org.sangam.packs.core.LifecycleStateDelegate"><extensionElements><operaton:field name="state"><operaton:string>APPEAL</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ap_hear_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>ap_hear</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${appealSla}</operaton:expression></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="ap_hear" name="Decide appeal" operaton:candidateGroups="${appellateSeat}" operaton:formKey="sangam:core/appeal" operaton:dueDate="${ap_hearDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"><operaton:field name="excludeVar"><operaton:string>appealExcludedPersons</operaton:string></operaton:field></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>appealDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="ap_hear_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>ap_hear</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>appellateSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="ap_hear_warnEnd" name="Warned"></endEvent>
    <serviceTask id="ap_hear_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>ap_hear</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:expression>${appealOnBreach}</operaton:expression></operaton:field><operaton:field name="seatVar"><operaton:string>appellateSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>appealDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="ap_hear_breachGw" name="Deemed?" default="core_appeal_f6"></exclusiveGateway>
    <exclusiveGateway id="ap_hear_done" name=""></exclusiveGateway>
    <serviceTask id="ap_order" name="Issue appellate order" operaton:class="org.sangam.packs.core.DocumentDelegate"><extensionElements><operaton:field name="template"><operaton:string>appellate-order</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="ap_gw" name="Allowed?" default="core_appeal_f16"></exclusiveGateway>
    <serviceTask id="ap_allowed" name="Allowed" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>appealOutcome=ALLOWED</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ap_dismissed" name="Dismissed" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>appealOutcome=DISMISSED</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="ap_endAllowed" name="Allowed"></endEvent>
    <endEvent id="ap_endDismissed" name="Dismissed"></endEvent>
    <boundaryEvent id="ap_hear_warn" name="SLA warning (75%)" attachedToRef="ap_hear" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${ap_hearWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="ap_hear_breach" name="SLA breached" attachedToRef="ap_hear" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${ap_hearDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="core_appeal_f1" sourceRef="ap_hear_warn" targetRef="ap_hear_warnNotify"/>
    <sequenceFlow id="core_appeal_f2" sourceRef="ap_hear_warnNotify" targetRef="ap_hear_warnEnd"/>
    <sequenceFlow id="core_appeal_f3" sourceRef="ap_hear_breach" targetRef="ap_hear_breachAct"/>
    <sequenceFlow id="core_appeal_f4" sourceRef="ap_hear_breachAct" targetRef="ap_hear_breachGw"/>
    <sequenceFlow id="core_appeal_f5" name="deemed" sourceRef="ap_hear_breachGw" targetRef="ap_hear_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_appeal_f6" name="escalated" sourceRef="ap_hear_breachGw" targetRef="ap_hear_slaPlan"/>
    <sequenceFlow id="core_appeal_f7" sourceRef="ap_hear_slaPlan" targetRef="ap_hear"/>
    <sequenceFlow id="core_appeal_f8" sourceRef="ap_hear" targetRef="ap_hear_done"/>
    <sequenceFlow id="core_appeal_f9" sourceRef="ap_start" targetRef="ap_defaults"/>
    <sequenceFlow id="core_appeal_f10" sourceRef="ap_defaults" targetRef="ap_record"/>
    <sequenceFlow id="core_appeal_f11" sourceRef="ap_record" targetRef="ap_state"/>
    <sequenceFlow id="core_appeal_f12" sourceRef="ap_state" targetRef="ap_hear_slaPlan"/>
    <sequenceFlow id="core_appeal_f13" sourceRef="ap_hear_done" targetRef="ap_order"/>
    <sequenceFlow id="core_appeal_f14" sourceRef="ap_order" targetRef="ap_gw"/>
    <sequenceFlow id="core_appeal_f15" name="allow / remand" sourceRef="ap_gw" targetRef="ap_allowed"><conditionExpression xsi:type="tFormalExpression">${appealDecision == 'allow' || appealDecision == 'remand'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_appeal_f16" name="dismiss" sourceRef="ap_gw" targetRef="ap_dismissed"/>
    <sequenceFlow id="core_appeal_f17" sourceRef="ap_allowed" targetRef="ap_endAllowed"/>
    <sequenceFlow id="core_appeal_f18" sourceRef="ap_dismissed" targetRef="ap_endDismissed"/>
  </process>
  <bpmndi:BPMNDiagram id="core_appeal_diagram">
    <bpmndi:BPMNPlane id="core_appeal_plane" bpmnElement="sangam-core-appeal">
      <bpmndi:BPMNShape id="ap_start_di" bpmnElement="ap_start"><dc:Bounds x="52" y="52" width="36" height="36"/></bpmndi:BPMNShape>
