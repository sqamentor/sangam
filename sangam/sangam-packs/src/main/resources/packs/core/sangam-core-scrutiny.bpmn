  <message id="msg_sangam_clarificationReceived" name="sangam.clarificationReceived"/>
  <process id="sangam-core-scrutiny" name="Core: scrutiny and clarification" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <documentation>SCRUTINY &lt;&gt; CLARIFICATION_SOUGHT (IX.3, GP-16). The statutory clock pauses while the applicant is asked for clarification when the pack says so (GP-45, J-P4 step 6), and the case version moves n to n+1 on the response (R43). Inputs: scrutinySeat, scrutinySla, clarificationWindow, pauseOnClarification. Output: scrutinyOutcome ACCEPTED / REJECTED / LAPSED.</documentation>
    <startEvent id="sc_start" name="Scrutiny requested"></startEvent>
    <serviceTask id="sc_defaults" name="Defaults" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>scrutinySeat=scrutiny-pool;scrutinySla=5WD;scrutinyOnBreach=ESCALATE;clarificationWindow=P15D;pauseOnClarification=true</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="sc_state" name="State: SCRUTINY" operaton:class="org.sangam.packs.core.LifecycleStateDelegate"><extensionElements><operaton:field name="state"><operaton:string>SCRUTINY</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="sc_scrutiny_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>sc_scrutiny</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${scrutinySla}</operaton:expression></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="sc_scrutiny" name="Scrutiny" operaton:candidateGroups="${scrutinySeat}" operaton:formKey="sangam:core/scrutiny" operaton:dueDate="${sc_scrutinyDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>scrutinyDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="sc_scrutiny_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>sc_scrutiny</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>scrutinySeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="sc_scrutiny_warnEnd" name="Warned"></endEvent>
    <serviceTask id="sc_scrutiny_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>sc_scrutiny</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:expression>${scrutinyOnBreach}</operaton:expression></operaton:field><operaton:field name="seatVar"><operaton:string>scrutinySeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>scrutinyDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="sc_scrutiny_breachGw" name="Deemed?" default="core_scrutiny_f6"></exclusiveGateway>
    <exclusiveGateway id="sc_scrutiny_done" name=""></exclusiveGateway>
    <exclusiveGateway id="sc_gw" name="Scrutiny decision?" default="core_scrutiny_f14"></exclusiveGateway>
    <serviceTask id="sc_accepted" name="Accepted" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>scrutinyOutcome=ACCEPTED</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="sc_rejected" name="Rejected" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>scrutinyOutcome=REJECTED</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="sc_endAccepted" name="Accepted"></endEvent>
    <endEvent id="sc_endRejected" name="Rejected"></endEvent>
    <serviceTask id="sc_clarState" name="State: CLARIFICATION_SOUGHT" operaton:class="org.sangam.packs.core.LifecycleStateDelegate"><extensionElements><operaton:field name="state"><operaton:string>CLARIFICATION_SOUGHT</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="sc_pauseGw" name="Pause clock?" default="core_scrutiny_f20"></exclusiveGateway>
    <serviceTask id="sc_pause" name="Pause statutory clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PAUSE</operaton:string></operaton:field><operaton:field name="reason"><operaton:string>clarification sought</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="sc_pauseJoin" name=""></exclusiveGateway>
    <serviceTask id="sc_deadline" name="Clarification window" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>clarification</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${clarificationWindow}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <serviceTask id="sc_notify" name="Tell applicant" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>clarification-sought</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>sms,email,inapp</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>applicantRef</operaton:string></operaton:field></extensionElements></serviceTask>
    <eventBasedGateway id="sc_wait" name="Response or lapse"></eventBasedGateway>
    <intermediateCatchEvent id="sc_received" name="Clarification received"><messageEventDefinition messageRef="msg_sangam_clarificationReceived"/></intermediateCatchEvent>
    <intermediateCatchEvent id="sc_lapsed" name="Window lapsed"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${clarificationDueAt}</timeDate></timerEventDefinition></intermediateCatchEvent>
    <serviceTask id="sc_resume" name="Resume statutory clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>RESUME</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="sc_version" name="New case version" operaton:class="org.sangam.packs.core.CaseRecordDelegate"><extensionElements><operaton:field name="op"><operaton:string>RESUBMIT</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="sc_backToScrutiny" name="State: SCRUTINY" operaton:class="org.sangam.packs.core.LifecycleStateDelegate"><extensionElements><operaton:field name="state"><operaton:string>SCRUTINY</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="sc_resume2" name="Resume statutory clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>RESUME</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="sc_lapsedOut" name="Lapsed" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>scrutinyOutcome=LAPSED</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="sc_endLapsed" name="Lapsed"></endEvent>
    <boundaryEvent id="sc_scrutiny_warn" name="SLA warning (75%)" attachedToRef="sc_scrutiny" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${sc_scrutinyWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="sc_scrutiny_breach" name="SLA breached" attachedToRef="sc_scrutiny" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${sc_scrutinyDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="core_scrutiny_f1" sourceRef="sc_scrutiny_warn" targetRef="sc_scrutiny_warnNotify"/>
    <sequenceFlow id="core_scrutiny_f2" sourceRef="sc_scrutiny_warnNotify" targetRef="sc_scrutiny_warnEnd"/>
    <sequenceFlow id="core_scrutiny_f3" sourceRef="sc_scrutiny_breach" targetRef="sc_scrutiny_breachAct"/>
    <sequenceFlow id="core_scrutiny_f4" sourceRef="sc_scrutiny_breachAct" targetRef="sc_scrutiny_breachGw"/>
    <sequenceFlow id="core_scrutiny_f5" name="deemed" sourceRef="sc_scrutiny_breachGw" targetRef="sc_scrutiny_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_scrutiny_f6" name="escalated" sourceRef="sc_scrutiny_breachGw" targetRef="sc_scrutiny_slaPlan"/>
    <sequenceFlow id="core_scrutiny_f7" sourceRef="sc_scrutiny_slaPlan" targetRef="sc_scrutiny"/>
    <sequenceFlow id="core_scrutiny_f8" sourceRef="sc_scrutiny" targetRef="sc_scrutiny_done"/>
    <sequenceFlow id="core_scrutiny_f9" sourceRef="sc_start" targetRef="sc_defaults"/>
    <sequenceFlow id="core_scrutiny_f10" sourceRef="sc_defaults" targetRef="sc_state"/>
    <sequenceFlow id="core_scrutiny_f11" sourceRef="sc_state" targetRef="sc_scrutiny_slaPlan"/>
    <sequenceFlow id="core_scrutiny_f12" sourceRef="sc_scrutiny_done" targetRef="sc_gw"/>
    <sequenceFlow id="core_scrutiny_f13" name="accept" sourceRef="sc_gw" targetRef="sc_accepted"><conditionExpression xsi:type="tFormalExpression">${scrutinyDecision == 'accept'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_scrutiny_f14" name="reject" sourceRef="sc_gw" targetRef="sc_rejected"/>
    <sequenceFlow id="core_scrutiny_f15" sourceRef="sc_accepted" targetRef="sc_endAccepted"/>
    <sequenceFlow id="core_scrutiny_f16" sourceRef="sc_rejected" targetRef="sc_endRejected"/>
    <sequenceFlow id="core_scrutiny_f17" name="clarify" sourceRef="sc_gw" targetRef="sc_clarState"><conditionExpression xsi:type="tFormalExpression">${scrutinyDecision == 'clarify'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_scrutiny_f18" sourceRef="sc_clarState" targetRef="sc_pauseGw"/>
    <sequenceFlow id="core_scrutiny_f19" name="pause" sourceRef="sc_pauseGw" targetRef="sc_pause"><conditionExpression xsi:type="tFormalExpression">${pauseOnClarification}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_scrutiny_f20" name="no pause" sourceRef="sc_pauseGw" targetRef="sc_pauseJoin"/>
    <sequenceFlow id="core_scrutiny_f21" sourceRef="sc_pause" targetRef="sc_pauseJoin"/>
    <sequenceFlow id="core_scrutiny_f22" sourceRef="sc_pauseJoin" targetRef="sc_deadline"/>
    <sequenceFlow id="core_scrutiny_f23" sourceRef="sc_deadline" targetRef="sc_notify"/>
    <sequenceFlow id="core_scrutiny_f24" sourceRef="sc_notify" targetRef="sc_wait"/>
    <sequenceFlow id="core_scrutiny_f25" sourceRef="sc_wait" targetRef="sc_received"/>
    <sequenceFlow id="core_scrutiny_f26" sourceRef="sc_wait" targetRef="sc_lapsed"/>
    <sequenceFlow id="core_scrutiny_f27" sourceRef="sc_received" targetRef="sc_resume"/>
    <sequenceFlow id="core_scrutiny_f28" sourceRef="sc_resume" targetRef="sc_version"/>
    <sequenceFlow id="core_scrutiny_f29" sourceRef="sc_version" targetRef="sc_backToScrutiny"/>
    <sequenceFlow id="core_scrutiny_f30" sourceRef="sc_backToScrutiny" targetRef="sc_scrutiny_slaPlan"/>
    <sequenceFlow id="core_scrutiny_f31" sourceRef="sc_lapsed" targetRef="sc_resume2"/>
    <sequenceFlow id="core_scrutiny_f32" sourceRef="sc_resume2" targetRef="sc_lapsedOut"/>
    <sequenceFlow id="core_scrutiny_f33" sourceRef="sc_lapsedOut" targetRef="sc_endLapsed"/>
  </process>
