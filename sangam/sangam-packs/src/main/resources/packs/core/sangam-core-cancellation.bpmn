<!-- Core: withdrawal and authorised cancellation. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_core_cancellation" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_cancelAck" name="sangam.cancelAck"/>
  <message id="msg_sangam_reconciliationResolved" name="sangam.reconciliationResolved"/>
  <process id="sangam-core-cancellation" name="Core: withdrawal and authorised cancellation" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <documentation>WITHDRAWN / CANCELLED (IX.3, VI.5, GP-14): an in-flight external operation goes to CANCEL_REQUESTED; an acknowledgement cancels, an effect that already happened becomes a LATE_RESULT reconciliation item, no acknowledgement in the window becomes UNKNOWN_OUTCOME (J-P1-E13). Encumbrances are released (GP-11) and the record is classified for retention.</documentation>
    <startEvent id="cn_start" name="Cancellation requested"></startEvent>
    <serviceTask id="cn_defaults" name="Defaults" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>cancelKind=CANCELLED;cancelAckWindow=PT2H;opStatus=NONE;encumbranceLedger=;encumbranceAccount=;releaseConnector=;cancelReason=not stated</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="cn_state" name="State: CANCEL_REQUESTED" operaton:class="org.sangam.packs.core.LifecycleStateDelegate"><extensionElements><operaton:field name="state"><operaton:string>CANCEL_REQUESTED</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="cn_inflight" name="Operation in flight?" default="core_cancellation_f5"></exclusiveGateway>
    <serviceTask id="cn_cancelOp" name="Cancel at external system" operaton:class="org.sangam.packs.core.ExternalOperationDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>CANCEL</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="cn_relGw" name="Encumbrance?" default="core_cancellation_f21"></exclusiveGateway>
    <exclusiveGateway id="cn_cancelGw" name="Cancel result?" default="core_cancellation_f16"></exclusiveGateway>
    <serviceTask id="cn_late" name="Effect already done: late-result item" operaton:class="org.sangam.packs.core.ExternalOperationDelegate"><extensionElements><operaton:field name="op"><operaton:string>OPEN_RECON</operaton:string></operaton:field><operaton:field name="kind"><operaton:string>LATE_RESULT</operaton:string></operaton:field></extensionElements></serviceTask>
    <eventBasedGateway id="cn_wait" name="Ack or window"></eventBasedGateway>
    <intermediateCatchEvent id="cn_ack" name="Cancel acknowledged"><messageEventDefinition messageRef="msg_sangam_cancelAck"/></intermediateCatchEvent>
    <intermediateCatchEvent id="cn_ackWindow" name="No acknowledgement"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">${cancelAckWindow}</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <serviceTask id="cn_applyAck" name="Apply acknowledgement" operaton:class="org.sangam.packs.core.ExternalOperationDelegate"><extensionElements><operaton:field name="op"><operaton:string>APPLY_CANCEL_ACK</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="cn_unknown" name="UNKNOWN_OUTCOME: reconciliation" operaton:class="org.sangam.packs.core.ExternalOperationDelegate"><extensionElements><operaton:field name="op"><operaton:string>OPEN_RECON</operaton:string></operaton:field><operaton:field name="kind"><operaton:string>UNKNOWN_OUTCOME</operaton:string></operaton:field></extensionElements></serviceTask>
    <intermediateCatchEvent id="cn_resolved" name="Resolved by operator"><messageEventDefinition messageRef="msg_sangam_reconciliationResolved"/></intermediateCatchEvent>
    <serviceTask id="cn_applyResolution" name="Apply resolution" operaton:class="org.sangam.packs.core.ExternalOperationDelegate"><extensionElements><operaton:field name="op"><operaton:string>APPLY_RESOLUTION</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="cn_release" name="Release ledger encumbrance" operaton:class="org.sangam.packs.core.LedgerDelegate"><extensionElements><operaton:field name="op"><operaton:string>RELEASE</operaton:string></operaton:field><operaton:field name="ledger"><operaton:expression>${encumbranceLedger}</operaton:expression></operaton:field><operaton:field name="account"><operaton:expression>${encumbranceAccount}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="cn_relJoin0" name=""></exclusiveGateway>
    <exclusiveGateway id="cn_relConnGw" name="External encumbrance?" default="core_cancellation_f25"></exclusiveGateway>
    <serviceTask id="cn_releaseExternal" name="Release external encumbrance" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:expression>${releaseConnector}</operaton:expression></operaton:field><operaton:field name="operation"><operaton:string>release</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>release</operaton:string></operaton:field><operaton:field name="step"><operaton:string>release</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="cn_relJoin" name=""></exclusiveGateway>
    <serviceTask id="cn_notify" name="Tell the parties" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>case-cancelled</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>sms,email,inapp</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>applicantRef</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="cn_kindGw" name="Withdrawn or cancelled?" default="core_cancellation_f30"></exclusiveGateway>
    <serviceTask id="cn_withdrawn" name="State: WITHDRAWN" operaton:class="org.sangam.packs.core.LifecycleStateDelegate"><extensionElements><operaton:field name="state"><operaton:string>WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="cn_cancelled" name="State: CANCELLED" operaton:class="org.sangam.packs.core.LifecycleStateDelegate"><extensionElements><operaton:field name="state"><operaton:string>CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="cn_retention" name="Classify for retention" operaton:class="org.sangam.packs.core.CaseRecordDelegate"><extensionElements><operaton:field name="op"><operaton:string>RETENTION</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="cn_end" name="Ended"></endEvent>
    <sequenceFlow id="core_cancellation_f1" sourceRef="cn_start" targetRef="cn_defaults"/>
    <sequenceFlow id="core_cancellation_f2" sourceRef="cn_defaults" targetRef="cn_state"/>
    <sequenceFlow id="core_cancellation_f3" sourceRef="cn_state" targetRef="cn_inflight"/>
    <sequenceFlow id="core_cancellation_f4" name="yes" sourceRef="cn_inflight" targetRef="cn_cancelOp"><conditionExpression xsi:type="tFormalExpression">${opStatus == 'PENDING' || opStatus == 'UNKNOWN' || opStatus == 'NEW'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_cancellation_f5" name="no" sourceRef="cn_inflight" targetRef="cn_relGw"/>
    <sequenceFlow id="core_cancellation_f6" sourceRef="cn_cancelOp" targetRef="cn_cancelGw"/>
    <sequenceFlow id="core_cancellation_f7" name="cancelled" sourceRef="cn_cancelGw" targetRef="cn_relGw"><conditionExpression xsi:type="tFormalExpression">${cancelStatus == 'CANCELLED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_cancellation_f8" name="too late" sourceRef="cn_cancelGw" targetRef="cn_late"><conditionExpression xsi:type="tFormalExpression">${cancelStatus == 'COMPLETED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_cancellation_f9" sourceRef="cn_late" targetRef="cn_relGw"/>
    <sequenceFlow id="core_cancellation_f10" name="pending" sourceRef="cn_cancelGw" targetRef="cn_wait"><conditionExpression xsi:type="tFormalExpression">${cancelStatus == 'PENDING'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_cancellation_f11" sourceRef="cn_wait" targetRef="cn_ack"/>
    <sequenceFlow id="core_cancellation_f12" sourceRef="cn_wait" targetRef="cn_ackWindow"/>
    <sequenceFlow id="core_cancellation_f13" sourceRef="cn_ack" targetRef="cn_applyAck"/>
    <sequenceFlow id="core_cancellation_f14" sourceRef="cn_applyAck" targetRef="cn_cancelGw"/>
    <sequenceFlow id="core_cancellation_f15" sourceRef="cn_ackWindow" targetRef="cn_unknown"/>
    <sequenceFlow id="core_cancellation_f16" name="unknown" sourceRef="cn_cancelGw" targetRef="cn_unknown"/>
    <sequenceFlow id="core_cancellation_f17" sourceRef="cn_unknown" targetRef="cn_resolved"/>
    <sequenceFlow id="core_cancellation_f18" sourceRef="cn_resolved" targetRef="cn_applyResolution"/>
    <sequenceFlow id="core_cancellation_f19" sourceRef="cn_applyResolution" targetRef="cn_relGw"/>
    <sequenceFlow id="core_cancellation_f20" name="yes" sourceRef="cn_relGw" targetRef="cn_release"><conditionExpression xsi:type="tFormalExpression">${encumbranceLedger != ''}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_cancellation_f21" name="no" sourceRef="cn_relGw" targetRef="cn_relJoin0"/>
    <sequenceFlow id="core_cancellation_f22" sourceRef="cn_release" targetRef="cn_relJoin0"/>
    <sequenceFlow id="core_cancellation_f23" sourceRef="cn_relJoin0" targetRef="cn_relConnGw"/>
    <sequenceFlow id="core_cancellation_f24" name="yes" sourceRef="cn_relConnGw" targetRef="cn_releaseExternal"><conditionExpression xsi:type="tFormalExpression">${releaseConnector != ''}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_cancellation_f25" name="no" sourceRef="cn_relConnGw" targetRef="cn_relJoin"/>
    <sequenceFlow id="core_cancellation_f26" sourceRef="cn_releaseExternal" targetRef="cn_relJoin"/>
    <sequenceFlow id="core_cancellation_f27" sourceRef="cn_relJoin" targetRef="cn_notify"/>
    <sequenceFlow id="core_cancellation_f28" sourceRef="cn_notify" targetRef="cn_kindGw"/>
    <sequenceFlow id="core_cancellation_f29" name="withdrawn" sourceRef="cn_kindGw" targetRef="cn_withdrawn"><conditionExpression xsi:type="tFormalExpression">${cancelKind == 'WITHDRAWN'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_cancellation_f30" name="cancelled" sourceRef="cn_kindGw" targetRef="cn_cancelled"/>
    <sequenceFlow id="core_cancellation_f31" sourceRef="cn_withdrawn" targetRef="cn_retention"/>
    <sequenceFlow id="core_cancellation_f32" sourceRef="cn_cancelled" targetRef="cn_retention"/>
    <sequenceFlow id="core_cancellation_f33" sourceRef="cn_retention" targetRef="cn_end"/>
  </process>
