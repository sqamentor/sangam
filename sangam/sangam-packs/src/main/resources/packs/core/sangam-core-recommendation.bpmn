<!-- Core: n-level recommendation by seat. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_core_recommendation" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <process id="sangam-core-recommendation" name="Core: n-level recommendation by seat" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <documentation>RECOMMENDATION 1..n by seat without multi-instance (GP-02): the chain is recommendationSeats; any level may recommend, return to any earlier level or to the initiator, reject, seek parallel comments (J-P2-E05) or mark out of hierarchy with a reason (J-P2-E01). SoD by person and seat per level (K5, J-P2-E04). Output: recOutcome RECOMMENDED / RETURNED / REJECTED.</documentation>
    <startEvent id="rc_start" name="Recommendation requested"></startEvent>
    <serviceTask id="rc_defaults" name="Defaults" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>recommendationSla=3WD;recOnBreach=ESCALATE;resubmitTo=START;outOfHierarchyAllowed=true;commentsWindow=P7D;recommendationSeats=;signEachLevel=false;signMethod=esign;espId=ESP-1</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="rc_state" name="State: RECOMMENDATION" operaton:class="org.sangam.packs.core.LifecycleStateDelegate"><extensionElements><operaton:field name="state"><operaton:string>RECOMMENDATION</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="rc_init" name="First level" operaton:class="org.sangam.packs.core.RecommendationLevelDelegate"><extensionElements><operaton:field name="op"><operaton:string>INIT</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="rc_doneGw" name="All levels done?" default="core_recommendation_f15"></exclusiveGateway>
    <serviceTask id="rc_recommended" name="Recommended" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>recOutcome=RECOMMENDED</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="rc_endRecommended" name="Recommended"></endEvent>
    <serviceTask id="rc_level_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>rc_level</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${recommendationSla}</operaton:expression></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="rc_level" name="Recommendation" operaton:candidateGroups="${currentSeat}" operaton:formKey="sangam:core/recommendation" operaton:dueDate="${rc_levelDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"><operaton:field name="stepSuffixVar"><operaton:string>recLevel</operaton:string></operaton:field></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>recDecision</operaton:string></operaton:field><operaton:field name="stepSuffixVar"><operaton:string>recLevel</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="rc_level_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>rc_level</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>currentSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="rc_level_warnEnd" name="Warned"></endEvent>
    <serviceTask id="rc_level_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>rc_level</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:expression>${recOnBreach}</operaton:expression></operaton:field><operaton:field name="seatVar"><operaton:string>currentSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>recDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="rc_level_breachGw" name="Deemed?" default="core_recommendation_f12"></exclusiveGateway>
    <exclusiveGateway id="rc_level_done" name=""></exclusiveGateway>
    <exclusiveGateway id="rc_decGw" name="Decision?" default="core_recommendation_f36"></exclusiveGateway>
    <serviceTask id="rc_advance" name="Next level" operaton:class="org.sangam.packs.core.RecommendationLevelDelegate"><extensionElements><operaton:field name="op"><operaton:string>ADVANCE</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="rc_signGw" name="Sign noting?" default="core_recommendation_f19"></exclusiveGateway>
    <serviceTask id="rc_sign" name="Sign noting (DSC / eSign)" operaton:class="org.sangam.packs.core.SignatureDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>REQUEST</operaton:string></operaton:field><operaton:field name="purpose"><operaton:string>noting</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="rc_signRes" name="Signed?" default="core_recommendation_f22"></exclusiveGateway>
    <serviceTask id="rc_signFailed" name="Signature not applied: the file has not moved" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>signature-failed</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>inapp</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>currentSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="rc_return" name="Return" operaton:class="org.sangam.packs.core.RecommendationLevelDelegate"><extensionElements><operaton:field name="op"><operaton:string>RETURN</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="rc_retGw" name="To initiator?" default="core_recommendation_f28"></exclusiveGateway>
    <serviceTask id="rc_returned" name="Returned" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>recOutcome=RETURNED</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="rc_endReturned" name="Returned to initiator"></endEvent>
    <serviceTask id="rc_mark" name="Out-of-hierarchy marking" operaton:class="org.sangam.packs.core.RecommendationLevelDelegate"><extensionElements><operaton:field name="op"><operaton:string>MARK</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="rc_commentsPrep" name="Seek comments" operaton:class="org.sangam.packs.core.RecommendationLevelDelegate"><extensionElements><operaton:field name="op"><operaton:string>COMMENTS</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="rc_comments" name="Comments" operaton:candidateGroups="${commentSeats.split(',')[loopCounter]}" operaton:formKey="sangam:core/comments"><extensionElements><operaton:properties><operaton:property name="sangam.maxCardinality" value="10"/></operaton:properties><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements><multiInstanceLoopCharacteristics isSequential="false"><loopCardinality xsi:type="tFormalExpression">${commentCount}</loopCardinality></multiInstanceLoopCharacteristics></userTask>
    <serviceTask id="rc_rejected" name="Rejected" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>recOutcome=REJECTED</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="rc_endRejected" name="Rejected"></endEvent>
    <boundaryEvent id="rc_level_warn" name="SLA warning (75%)" attachedToRef="rc_level" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${rc_levelWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="rc_level_breach" name="SLA breached" attachedToRef="rc_level" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${rc_levelDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="rc_commentsDeadline" name="Comment deadline" attachedToRef="rc_comments" cancelActivity="true"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">${commentsWindow}</timeDuration></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="core_recommendation_f1" sourceRef="rc_start" targetRef="rc_defaults"/>
    <sequenceFlow id="core_recommendation_f2" sourceRef="rc_defaults" targetRef="rc_state"/>
    <sequenceFlow id="core_recommendation_f3" sourceRef="rc_state" targetRef="rc_init"/>
    <sequenceFlow id="core_recommendation_f4" sourceRef="rc_init" targetRef="rc_doneGw"/>
    <sequenceFlow id="core_recommendation_f5" name="done" sourceRef="rc_doneGw" targetRef="rc_recommended"><conditionExpression xsi:type="tFormalExpression">${recDone}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_recommendation_f6" sourceRef="rc_recommended" targetRef="rc_endRecommended"/>
    <sequenceFlow id="core_recommendation_f7" sourceRef="rc_level_warn" targetRef="rc_level_warnNotify"/>
    <sequenceFlow id="core_recommendation_f8" sourceRef="rc_level_warnNotify" targetRef="rc_level_warnEnd"/>
    <sequenceFlow id="core_recommendation_f9" sourceRef="rc_level_breach" targetRef="rc_level_breachAct"/>
    <sequenceFlow id="core_recommendation_f10" sourceRef="rc_level_breachAct" targetRef="rc_level_breachGw"/>
    <sequenceFlow id="core_recommendation_f11" name="deemed" sourceRef="rc_level_breachGw" targetRef="rc_level_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_recommendation_f12" name="escalated" sourceRef="rc_level_breachGw" targetRef="rc_level_slaPlan"/>
    <sequenceFlow id="core_recommendation_f13" sourceRef="rc_level_slaPlan" targetRef="rc_level"/>
    <sequenceFlow id="core_recommendation_f14" sourceRef="rc_level" targetRef="rc_level_done"/>
    <sequenceFlow id="core_recommendation_f15" name="next level" sourceRef="rc_doneGw" targetRef="rc_level_slaPlan"/>
    <sequenceFlow id="core_recommendation_f16" sourceRef="rc_level_done" targetRef="rc_decGw"/>
    <sequenceFlow id="core_recommendation_f17" name="recommend" sourceRef="rc_decGw" targetRef="rc_signGw"><conditionExpression xsi:type="tFormalExpression">${recDecision == 'recommend'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_recommendation_f18" name="CSMOP: sign before forwarding" sourceRef="rc_signGw" targetRef="rc_sign"><conditionExpression xsi:type="tFormalExpression">${signEachLevel}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_recommendation_f19" name="no signature" sourceRef="rc_signGw" targetRef="rc_advance"/>
    <sequenceFlow id="core_recommendation_f20" sourceRef="rc_sign" targetRef="rc_signRes"/>
    <sequenceFlow id="core_recommendation_f21" name="signed" sourceRef="rc_signRes" targetRef="rc_advance"><conditionExpression xsi:type="tFormalExpression">${signatureStatus == 'COMPLETED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_recommendation_f22" name="not signed" sourceRef="rc_signRes" targetRef="rc_signFailed"/>
    <sequenceFlow id="core_recommendation_f23" sourceRef="rc_signFailed" targetRef="rc_level_slaPlan"/>
    <sequenceFlow id="core_recommendation_f24" sourceRef="rc_advance" targetRef="rc_doneGw"/>
    <sequenceFlow id="core_recommendation_f25" name="return" sourceRef="rc_decGw" targetRef="rc_return"><conditionExpression xsi:type="tFormalExpression">${recDecision == 'return'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_recommendation_f26" sourceRef="rc_return" targetRef="rc_retGw"/>
    <sequenceFlow id="core_recommendation_f27" name="initiator" sourceRef="rc_retGw" targetRef="rc_returned"><conditionExpression xsi:type="tFormalExpression">${recReturnedToInitiator}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_recommendation_f28" name="earlier level" sourceRef="rc_retGw" targetRef="rc_doneGw"/>
    <sequenceFlow id="core_recommendation_f29" sourceRef="rc_returned" targetRef="rc_endReturned"/>
    <sequenceFlow id="core_recommendation_f30" name="mark" sourceRef="rc_decGw" targetRef="rc_mark"><conditionExpression xsi:type="tFormalExpression">${recDecision == 'markTo'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_recommendation_f31" sourceRef="rc_mark" targetRef="rc_doneGw"/>
    <sequenceFlow id="core_recommendation_f32" name="comments" sourceRef="rc_decGw" targetRef="rc_commentsPrep"><conditionExpression xsi:type="tFormalExpression">${recDecision == 'seekComments'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_recommendation_f33" sourceRef="rc_commentsPrep" targetRef="rc_comments"/>
    <sequenceFlow id="core_recommendation_f34" sourceRef="rc_comments" targetRef="rc_level_slaPlan"/>
    <sequenceFlow id="core_recommendation_f35" sourceRef="rc_commentsDeadline" targetRef="rc_level_slaPlan"/>
    <sequenceFlow id="core_recommendation_f36" name="reject" sourceRef="rc_decGw" targetRef="rc_rejected"/>
    <sequenceFlow id="core_recommendation_f37" sourceRef="rc_rejected" targetRef="rc_endRejected"/>
  </process>
