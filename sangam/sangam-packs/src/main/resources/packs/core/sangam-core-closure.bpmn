  <process id="sangam-core-closure" name="Core: output, notification, retention and closure" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <documentation>CLOSED (IX.3): output document from the approved data only, notification on registered templates (R60), retention classification at closure (R61, CSMOP A / C) and the final state.</documentation>
    <startEvent id="cl_start" name="Close case"></startEvent>
    <serviceTask id="cl_defaults" name="Defaults" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>outputTemplate=generic-order;retentionCategory=C;closureTemplate=case-closed;issueOutput=true;requireApprovalForOutput=false</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="cl_outGw" name="Issue output?" default="core_closure_f4"></exclusiveGateway>
    <serviceTask id="cl_issue" name="Issue output document" operaton:class="org.sangam.packs.core.DocumentDelegate"><extensionElements><operaton:field name="template"><operaton:expression>${outputTemplate}</operaton:expression></operaton:field><operaton:field name="requireApproval"><operaton:expression>${requireApprovalForOutput}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="cl_join" name=""></exclusiveGateway>
    <serviceTask id="cl_notify" name="Notify" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:expression>${closureTemplate}</operaton:expression></operaton:field><operaton:field name="channel"><operaton:string>sms,email,inapp</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>applicantRef</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="cl_retention" name="Classify for retention" operaton:class="org.sangam.packs.core.CaseRecordDelegate"><extensionElements><operaton:field name="op"><operaton:string>RETENTION</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="cl_closed" name="State: CLOSED" operaton:class="org.sangam.packs.core.LifecycleStateDelegate"><extensionElements><operaton:field name="state"><operaton:string>CLOSED</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="cl_end" name="Closed"></endEvent>
    <sequenceFlow id="core_closure_f1" sourceRef="cl_start" targetRef="cl_defaults"/>
    <sequenceFlow id="core_closure_f2" sourceRef="cl_defaults" targetRef="cl_outGw"/>
    <sequenceFlow id="core_closure_f3" name="yes" sourceRef="cl_outGw" targetRef="cl_issue"><conditionExpression xsi:type="tFormalExpression">${issueOutput}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_closure_f4" name="no" sourceRef="cl_outGw" targetRef="cl_join"/>
    <sequenceFlow id="core_closure_f5" sourceRef="cl_issue" targetRef="cl_join"/>
    <sequenceFlow id="core_closure_f6" sourceRef="cl_join" targetRef="cl_notify"/>
    <sequenceFlow id="core_closure_f7" sourceRef="cl_notify" targetRef="cl_retention"/>
    <sequenceFlow id="core_closure_f8" sourceRef="cl_retention" targetRef="cl_closed"/>
    <sequenceFlow id="core_closure_f9" sourceRef="cl_closed" targetRef="cl_end"/>
  </process>
