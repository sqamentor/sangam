  <message id="msg_sangam_reconciliationResolved" name="sangam.reconciliationResolved"/>
  <process id="sangam-core-reconciliation" name="Core: standalone reconciliation item" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <documentation>An UNKNOWN_OUTCOME or mismatch item raised outside a running execution (restore from backup with known downstream effects J-P1-E14, late result after delete, statement exceptions): the operator confirms success with evidence, confirms failure, or retries the same operationId (class a/b only), OJ-02.</documentation>
    <startEvent id="rn_start" name="Item raised"></startEvent>
    <serviceTask id="rn_open" name="Open item" operaton:class="org.sangam.packs.core.ExternalOperationDelegate"><extensionElements><operaton:field name="op"><operaton:string>OPEN_RECON</operaton:string></operaton:field><operaton:field name="kind"><operaton:expression>${reconKind}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <serviceTask id="rn_defaults" name="Defaults" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>reconKind=UNKNOWN_OUTCOME</operaton:string></operaton:field></extensionElements></serviceTask>
    <intermediateCatchEvent id="rn_resolved" name="Resolved"><messageEventDefinition messageRef="msg_sangam_reconciliationResolved"/></intermediateCatchEvent>
    <serviceTask id="rn_apply" name="Apply resolution" operaton:class="org.sangam.packs.core.ExternalOperationDelegate"><extensionElements><operaton:field name="op"><operaton:string>APPLY_RESOLUTION</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="rn_gw" name="Retry?" default="core_reconciliation_f8"></exclusiveGateway>
    <serviceTask id="rn_retry" name="Retry same operationId" operaton:class="org.sangam.packs.core.ExternalOperationDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>SUBMIT</operaton:string></operaton:field><operaton:field name="connector"><operaton:expression>${opConnector}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <endEvent id="rn_end" name="Resolved"></endEvent>
    <sequenceFlow id="core_reconciliation_f1" sourceRef="rn_start" targetRef="rn_defaults"/>
    <sequenceFlow id="core_reconciliation_f2" sourceRef="rn_defaults" targetRef="rn_open"/>
    <sequenceFlow id="core_reconciliation_f3" sourceRef="rn_open" targetRef="rn_resolved"/>
    <sequenceFlow id="core_reconciliation_f4" sourceRef="rn_resolved" targetRef="rn_apply"/>
    <sequenceFlow id="core_reconciliation_f5" sourceRef="rn_apply" targetRef="rn_gw"/>
    <sequenceFlow id="core_reconciliation_f6" name="retry" sourceRef="rn_gw" targetRef="rn_retry"><conditionExpression xsi:type="tFormalExpression">${opStatus == 'RETRY'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_reconciliation_f7" sourceRef="rn_retry" targetRef="rn_gw"/>
    <sequenceFlow id="core_reconciliation_f8" name="resolved" sourceRef="rn_gw" targetRef="rn_end"/>
