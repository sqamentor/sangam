  <process id="sangam-core-execution" name="Core: execution with operationId, acknowledgement and reconciliation" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <documentation>EXECUTION &gt; ACKNOWLEDGED &gt; RECONCILED with UNKNOWN_OUTCOME (IX.3, VI.3, A-2, AC-03). The approval hash is re-verified first (K4: a change after approval throws APPROVAL_INVALIDATED, J-P1-E01); the effect goes through the ConnectorGateway with operationId = UUIDv5(businessKey, step, attempt); an unknown outcome opens a reconciliation item and nothing is repeated automatically for class (c). Inputs: executionConnector, executionOperation, executionStep, reconcileRequired, ackWindow. Output: executionOutcome DONE / FAILED (opReasonCode).</documentation>
    <startEvent id="ex_start" name="Execution requested"></startEvent>
    <serviceTask id="ex_defaults" name="Defaults" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>ackWindow=PT4H;reconcileRequired=false;verifyApproval=true;executionStep=execute;executionOperation=execute;executionPayloadFields=;reconRetry=PT1H;reconciliationSeat=reconciliation-desk</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ex_state" name="State: EXECUTION" operaton:class="org.sangam.packs.core.LifecycleStateDelegate"><extensionElements><operaton:field name="state"><operaton:string>EXECUTION</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ex_prepare" name="Verify approval, derive operationId" operaton:class="org.sangam.packs.core.ExternalOperationDelegate"><extensionElements><operaton:field name="op"><operaton:string>PREPARE</operaton:string></operaton:field><operaton:field name="step"><operaton:expression>${executionStep}</operaton:expression></operaton:field><operaton:field name="connector"><operaton:expression>${executionConnector}</operaton:expression></operaton:field><operaton:field name="verifyApproval"><operaton:expression>${verifyApproval}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ex_submit" name="Submit external operation" operaton:class="org.sangam.packs.core.ExternalOperationDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>SUBMIT</operaton:string></operaton:field><operaton:field name="connector"><operaton:expression>${executionConnector}</operaton:expression></operaton:field><operaton:field name="operation"><operaton:expression>${executionOperation}</operaton:expression></operaton:field><operaton:field name="payloadFields"><operaton:expression>${executionPayloadFields}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="ex_status" name="Outcome?" default="core_execution_f17"></exclusiveGateway>
    <serviceTask id="ex_ack" name="State: ACKNOWLEDGED" operaton:class="org.sangam.packs.core.LifecycleStateDelegate"><extensionElements><operaton:field name="state"><operaton:string>ACKNOWLEDGED</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ex_failed" name="Failed" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>executionOutcome=FAILED</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="ex_endFailed" name="Confirmed failure"></endEvent>
    <eventBasedGateway id="ex_wait" name="Result or window"></eventBasedGateway>
    <intermediateCatchEvent id="ex_result" name="Operation result (inbox)"><messageEventDefinition messageRef="msg_sangam_operationResult"/></intermediateCatchEvent>
    <intermediateCatchEvent id="ex_window" name="Acknowledgement window"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">${ackWindow}</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <serviceTask id="ex_applyResult" name="Apply result" operaton:class="org.sangam.packs.core.ExternalOperationDelegate"><extensionElements><operaton:field name="op"><operaton:string>APPLY_RESULT</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ex_lookup" name="Look up outcome" operaton:class="org.sangam.packs.core.ExternalOperationDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>LOOKUP</operaton:string></operaton:field><operaton:field name="maxLookups"><operaton:expression>${maxLookups}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ex_unknown" name="UNKNOWN_OUTCOME: open reconciliation item" operaton:class="org.sangam.packs.core.ExternalOperationDelegate"><extensionElements><operaton:field name="op"><operaton:string>OPEN_RECON</operaton:string></operaton:field><operaton:field name="kind"><operaton:string>UNKNOWN_OUTCOME</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ex_notifyOps" name="Alert reconciliation desk" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>recon-item-opened</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>inapp,email</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>reconciliationSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <intermediateCatchEvent id="ex_resolved" name="Resolved by operator"><messageEventDefinition messageRef="msg_sangam_reconciliationResolved"/></intermediateCatchEvent>
    <serviceTask id="ex_applyResolution" name="Apply resolution" operaton:class="org.sangam.packs.core.ExternalOperationDelegate"><extensionElements><operaton:field name="op"><operaton:string>APPLY_RESOLUTION</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="ex_reconGw" name="Reconcile with statement?" default="core_execution_f23"></exclusiveGateway>
    <serviceTask id="ex_done" name="Done" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>executionOutcome=DONE</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="ex_endDone" name="Done"></endEvent>
    <serviceTask id="ex_reconcile" name="Match with bank / treasury statement" operaton:class="org.sangam.packs.core.ExternalOperationDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>RECONCILE</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="ex_matchGw" name="Matched?" default="core_execution_f36"></exclusiveGateway>
    <serviceTask id="ex_reconciled" name="State: RECONCILED" operaton:class="org.sangam.packs.core.LifecycleStateDelegate"><extensionElements><operaton:field name="state"><operaton:string>RECONCILED</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ex_mismatch" name="Open mismatch item" operaton:class="org.sangam.packs.core.ExternalOperationDelegate"><extensionElements><operaton:field name="op"><operaton:string>OPEN_RECON</operaton:string></operaton:field><operaton:field name="kind"><operaton:string>MISMATCH</operaton:string></operaton:field></extensionElements></serviceTask>
    <intermediateCatchEvent id="ex_mmResolved" name="Mismatch resolved"><messageEventDefinition messageRef="msg_sangam_reconciliationResolved"/></intermediateCatchEvent>
    <serviceTask id="ex_mmApply" name="Apply resolution" operaton:class="org.sangam.packs.core.ExternalOperationDelegate"><extensionElements><operaton:field name="op"><operaton:string>APPLY_RESOLUTION</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="ex_mmGw" name="Resolution?" default="core_execution_f35"></exclusiveGateway>
    <intermediateCatchEvent id="ex_reconWait" name="Statement not yet in"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">${reconRetry}</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <sequenceFlow id="core_execution_f1" sourceRef="ex_start" targetRef="ex_defaults"/>
    <sequenceFlow id="core_execution_f2" sourceRef="ex_defaults" targetRef="ex_state"/>
    <sequenceFlow id="core_execution_f3" sourceRef="ex_state" targetRef="ex_prepare"/>
    <sequenceFlow id="core_execution_f4" sourceRef="ex_prepare" targetRef="ex_submit"/>
    <sequenceFlow id="core_execution_f5" sourceRef="ex_submit" targetRef="ex_status"/>
    <sequenceFlow id="core_execution_f6" name="completed" sourceRef="ex_status" targetRef="ex_ack"><conditionExpression xsi:type="tFormalExpression">${opStatus == 'COMPLETED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_execution_f7" name="failed" sourceRef="ex_status" targetRef="ex_failed"><conditionExpression xsi:type="tFormalExpression">${opStatus == 'FAILED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_execution_f8" sourceRef="ex_failed" targetRef="ex_endFailed"/>
    <sequenceFlow id="core_execution_f9" name="pending" sourceRef="ex_status" targetRef="ex_wait"><conditionExpression xsi:type="tFormalExpression">${opStatus == 'PENDING'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_execution_f10" sourceRef="ex_wait" targetRef="ex_result"/>
    <sequenceFlow id="core_execution_f11" sourceRef="ex_wait" targetRef="ex_window"/>
    <sequenceFlow id="core_execution_f12" sourceRef="ex_result" targetRef="ex_applyResult"/>
    <sequenceFlow id="core_execution_f13" sourceRef="ex_applyResult" targetRef="ex_status"/>
    <sequenceFlow id="core_execution_f14" sourceRef="ex_window" targetRef="ex_lookup"/>
    <sequenceFlow id="core_execution_f15" sourceRef="ex_lookup" targetRef="ex_status"/>
    <sequenceFlow id="core_execution_f16" name="retry same operationId" sourceRef="ex_status" targetRef="ex_submit"><conditionExpression xsi:type="tFormalExpression">${opStatus == 'RETRY'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_execution_f17" name="unknown" sourceRef="ex_status" targetRef="ex_unknown"/>
    <sequenceFlow id="core_execution_f18" sourceRef="ex_unknown" targetRef="ex_notifyOps"/>
    <sequenceFlow id="core_execution_f19" sourceRef="ex_notifyOps" targetRef="ex_resolved"/>
    <sequenceFlow id="core_execution_f20" sourceRef="ex_resolved" targetRef="ex_applyResolution"/>
    <sequenceFlow id="core_execution_f21" sourceRef="ex_applyResolution" targetRef="ex_status"/>
    <sequenceFlow id="core_execution_f22" sourceRef="ex_ack" targetRef="ex_reconGw"/>
    <sequenceFlow id="core_execution_f23" name="no" sourceRef="ex_reconGw" targetRef="ex_done"/>
    <sequenceFlow id="core_execution_f24" sourceRef="ex_done" targetRef="ex_endDone"/>
    <sequenceFlow id="core_execution_f25" name="yes" sourceRef="ex_reconGw" targetRef="ex_reconcile"><conditionExpression xsi:type="tFormalExpression">${reconcileRequired}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_execution_f26" sourceRef="ex_reconcile" targetRef="ex_matchGw"/>
    <sequenceFlow id="core_execution_f27" name="matched" sourceRef="ex_matchGw" targetRef="ex_reconciled"><conditionExpression xsi:type="tFormalExpression">${reconStatus == 'MATCHED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_execution_f28" sourceRef="ex_reconciled" targetRef="ex_done"/>
    <sequenceFlow id="core_execution_f29" name="mismatch" sourceRef="ex_matchGw" targetRef="ex_mismatch"><conditionExpression xsi:type="tFormalExpression">${reconStatus == 'MISMATCH'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_execution_f30" sourceRef="ex_mismatch" targetRef="ex_mmResolved"/>
    <sequenceFlow id="core_execution_f31" sourceRef="ex_mmResolved" targetRef="ex_mmApply"/>
    <sequenceFlow id="core_execution_f32" sourceRef="ex_mmApply" targetRef="ex_mmGw"/>
    <sequenceFlow id="core_execution_f33" name="confirmed" sourceRef="ex_mmGw" targetRef="ex_reconciled"><conditionExpression xsi:type="tFormalExpression">${opStatus == 'COMPLETED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_execution_f34" name="failed" sourceRef="ex_mmGw" targetRef="ex_failed"><conditionExpression xsi:type="tFormalExpression">${opStatus == 'FAILED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="core_execution_f35" name="check again" sourceRef="ex_mmGw" targetRef="ex_reconcile"/>
    <sequenceFlow id="core_execution_f36" name="pending" sourceRef="ex_matchGw" targetRef="ex_reconWait"/>
    <sequenceFlow id="core_execution_f37" sourceRef="ex_reconWait" targetRef="ex_reconcile"/>
  </process>
