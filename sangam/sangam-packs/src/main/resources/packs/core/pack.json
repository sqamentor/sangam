  "acceptance": [
    {
      "id": "CORE-1",
      "title": "Return to any earlier level and resubmission",
      "refs": [
        "GP-02",
        "R43",
        "T19"
      ],
      "given": "a chain of three recommendation seats",
      "when": "level 3 returns to level 1, then all recommend",
      "then": "caseVersion is unchanged, the case passes levels 1..3 again, CASE_RETURNED is audited",
      "startVariables": {},
      "expectState": null
    },
    {
      "id": "CORE-2",
      "title": "Deemed approval keeps the state machine",
      "refs": [
        "GP-44",
        "J-P4-E07",
        "IX.5 rule 6"
      ],
      "given": "sanctionOnBreach = DEEMED_APPROVAL",
      "when": "the sanction SLA lapses",
      "then": "DEEMED_DECISION by system on behalf of the seat, approval bound to the payload hash",
      "startVariables": {},
      "expectState": null
    },
    {
      "id": "CORE-3",
      "title": "Unknown outcome is never repeated for class (c)",
      "refs": [
        "AC-03",
        "VI.3",
        "T02"
      ],
      "given": "executionConnector = pfms.payment, sim_pfms_payment = UNKNOWN_THEN_COMPLETED",
      "when": "the operator tries RETRY_SAME_OPERATION",
      "then": "the retry is refused; CONFIRMED_SUCCESS with evidence closes",
      "startVariables": {},
      "expectState": null
    }
  ],
