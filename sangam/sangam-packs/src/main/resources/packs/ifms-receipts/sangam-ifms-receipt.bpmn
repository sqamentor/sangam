      <bpmndi:BPMNShape id="rc_unacc_di" bpmnElement="rc_unacc"><dc:Bounds x="2032" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rc_refunded_di" bpmnElement="rc_refunded"><dc:Bounds x="2197" y="177" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rc_end_di" bpmnElement="rc_end"><dc:Bounds x="2197" y="302" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rc_resolve_warn_di" bpmnElement="rc_resolve_warn"><dc:Bounds x="1183" y="92" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rc_resolve_breach_di" bpmnElement="rc_resolve_breach"><dc:Bounds x="1213" y="92" width="36" height="36"/></bpmndi:BPMNShape>
