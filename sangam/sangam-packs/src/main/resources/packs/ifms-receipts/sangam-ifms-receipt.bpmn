<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- Receipt (challan). Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_ifms_receipt" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_ifms_challanPaid" name="sangam.ifms.challanPaid"/>
  <process id="sangam-ifms-receipt" name="Receipt (challan)" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.ifms.receipts</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>challanNo,receiptHead,amount</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="rc_start" name="Challan generated" operaton:initiator="initiator" operaton:formKey="sangam:ifms-receipts/challan"></startEvent>
    <serviceTask id="rc_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>amount=0;receiptDeskSeat=AAO-1;scrollMatch=MATCHED;scrollAmount=0</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="rc_number" name="Challan number (series)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>config.series</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>series.next</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>receiptHead</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>chl</operaton:string></operaton:field><operaton:field name="step"><operaton:string>number</operaton:string></operaton:field></extensionElements></serviceTask>
    <intermediateCatchEvent id="rc_paid" name="Payment confirmed by the portal (CIN / UTR)"><messageEventDefinition messageRef="msg_sangam_ifms_challanPaid"/></intermediateCatchEvent>
    <serviceTask id="rc_scroll" name="Match with the e-scroll" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>treasury.scroll</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>match</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>challanNo,amount,utr</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>scroll</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="rc_matchGw" name="Matched?" default="ifms_receipt_f15"></exclusiveGateway>
    <serviceTask id="rc_book" name="Receipt voucher" operaton:class="org.sangam.packs.core.DocumentDelegate"><extensionElements><operaton:field name="template"><operaton:string>receipt-voucher</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="rc_resolve_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>rc_resolve</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>3WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="rc_resolve" name="Resolve receipt discrepancy" operaton:candidateGroups="${receiptDeskSeat}" operaton:formKey="sangam:ifms-receipts/resolve" operaton:dueDate="${rc_resolveDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>receiptDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="rc_resolve_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>rc_resolve</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>receiptDeskSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="rc_resolve_warnEnd" name="Warned"></endEvent>
    <serviceTask id="rc_resolve_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>rc_resolve</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>receiptDeskSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>receiptDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="rc_resolve_breachGw" name="Deemed?" default="ifms_receipt_f12"></exclusiveGateway>
    <exclusiveGateway id="rc_resolve_done" name=""></exclusiveGateway>
    <exclusiveGateway id="rc_resGw" name="" default="ifms_receipt_f19"></exclusiveGateway>
    <serviceTask id="rc_refund" name="Refund" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>receipt.refund</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>refund</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>challanNo,amount</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>refund</operaton:string></operaton:field><operaton:field name="step"><operaton:string>refund</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="rc_unacc" name="Unaccounted: SOP case"></endEvent>
    <endEvent id="rc_refunded" name="Refunded"></endEvent>
    <endEvent id="rc_end" name="Accounted"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="rc_resolve_warn" name="SLA warning (75%)" attachedToRef="rc_resolve" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${rc_resolveWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="rc_resolve_breach" name="SLA breached" attachedToRef="rc_resolve" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${rc_resolveDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="ifms_receipt_f1" sourceRef="rc_start" targetRef="rc_defaults"/>
    <sequenceFlow id="ifms_receipt_f2" sourceRef="rc_defaults" targetRef="rc_number"/>
    <sequenceFlow id="ifms_receipt_f3" sourceRef="rc_number" targetRef="rc_paid"/>
    <sequenceFlow id="ifms_receipt_f4" sourceRef="rc_paid" targetRef="rc_scroll"/>
    <sequenceFlow id="ifms_receipt_f5" sourceRef="rc_scroll" targetRef="rc_matchGw"/>
    <sequenceFlow id="ifms_receipt_f6" name="matched" sourceRef="rc_matchGw" targetRef="rc_book"><conditionExpression xsi:type="tFormalExpression">${scrollMatch == 'MATCHED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_receipt_f7" sourceRef="rc_resolve_warn" targetRef="rc_resolve_warnNotify"/>
    <sequenceFlow id="ifms_receipt_f8" sourceRef="rc_resolve_warnNotify" targetRef="rc_resolve_warnEnd"/>
    <sequenceFlow id="ifms_receipt_f9" sourceRef="rc_resolve_breach" targetRef="rc_resolve_breachAct"/>
    <sequenceFlow id="ifms_receipt_f10" sourceRef="rc_resolve_breachAct" targetRef="rc_resolve_breachGw"/>
    <sequenceFlow id="ifms_receipt_f11" name="deemed" sourceRef="rc_resolve_breachGw" targetRef="rc_resolve_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_receipt_f12" name="escalated" sourceRef="rc_resolve_breachGw" targetRef="rc_resolve_slaPlan"/>
    <sequenceFlow id="ifms_receipt_f13" sourceRef="rc_resolve_slaPlan" targetRef="rc_resolve"/>
    <sequenceFlow id="ifms_receipt_f14" sourceRef="rc_resolve" targetRef="rc_resolve_done"/>
    <sequenceFlow id="ifms_receipt_f15" name="short / unmatched" sourceRef="rc_matchGw" targetRef="rc_resolve_slaPlan"/>
    <sequenceFlow id="ifms_receipt_f16" sourceRef="rc_resolve_done" targetRef="rc_resGw"/>
    <sequenceFlow id="ifms_receipt_f17" name="book" sourceRef="rc_resGw" targetRef="rc_book"><conditionExpression xsi:type="tFormalExpression">${receiptDecision == 'book'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_receipt_f18" name="refund" sourceRef="rc_resGw" targetRef="rc_refund"><conditionExpression xsi:type="tFormalExpression">${receiptDecision == 'refund'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_receipt_f19" name="unaccounted" sourceRef="rc_resGw" targetRef="rc_unacc"/>
    <sequenceFlow id="ifms_receipt_f20" sourceRef="rc_refund" targetRef="rc_refunded"/>
    <sequenceFlow id="ifms_receipt_f21" sourceRef="rc_book" targetRef="rc_end"/>
  </process>
  <bpmndi:BPMNDiagram id="ifms_receipt_diagram">
    <bpmndi:BPMNPlane id="ifms_receipt_plane" bpmnElement="sangam-ifms-receipt">
