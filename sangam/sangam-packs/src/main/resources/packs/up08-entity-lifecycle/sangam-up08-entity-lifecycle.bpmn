<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_up08_entity_lifecycle" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_entity_cancel" name="sangam.entity.cancel"/>
  <message id="msg_sangam_entity_endorsement" name="sangam.entity.endorsement"/>
  <process id="sangam-up08-entity-lifecycle" name="UP-08 Entity lifecycle" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>universal.up08-entity-lifecycle</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>policyNo,customerId</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="u8_start" name="Entity created" operaton:initiator="initiator" operaton:formKey="sangam:up08-entity-lifecycle/create"></startEvent>
    <serviceTask id="u8_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>renewalCycle=P365D;cycles=0;continueAsNewAfter=5;serviceSeat=SERVICE-DESK</operaton:string></operaton:field></extensionElements></serviceTask>
    <eventBasedGateway id="u8_wait" name="Event or anniversary"></eventBasedGateway>
    <intermediateCatchEvent id="u8_endorse" name="Endorsement requested"><messageEventDefinition messageRef="msg_sangam_entity_endorsement"/></intermediateCatchEvent>
    <intermediateCatchEvent id="u8_anniversary" name="Anniversary"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">${renewalCycle}</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <intermediateCatchEvent id="u8_cancel" name="Cancelled"><messageEventDefinition messageRef="msg_sangam_entity_cancel"/></intermediateCatchEvent>
    <userTask id="u8_endorsement" name="Process endorsement" operaton:candidateGroups="${serviceSeat}" operaton:formKey="sangam:up08-entity-lifecycle/endorsement"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <userTask id="u8_renew" name="Renew or terminate" operaton:candidateGroups="${serviceSeat}" operaton:formKey="sangam:up08-entity-lifecycle/renew"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>renewalDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="u8_rg" name="" default="up08_entity_lifecycle_f11"></exclusiveGateway>
    <serviceTask id="u8_cycle" name="Count cycle" operaton:expression="${execution.setVariable('cycles', cycles + 1)}"></serviceTask>
    <endEvent id="u8_endTerminated" name="Terminated"></endEvent>
    <exclusiveGateway id="u8_can" name="Continue as new?" default="up08_entity_lifecycle_f14"></exclusiveGateway>
    <serviceTask id="u8_continue" name="Continue as a new linked instance" operaton:class="org.sangam.packs.core.LinkedInstanceDelegate"><extensionElements><operaton:field name="processKey"><operaton:string>sangam-up08-entity-lifecycle</operaton:string></operaton:field><operaton:field name="linkType"><operaton:string>continuation</operaton:string></operaton:field><operaton:field name="inherit"><operaton:string>policyNo,customerId,renewalCycle,continueAsNewAfter</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="u8_endContinued" name="Continued"></endEvent>
    <endEvent id="u8_endCancelled" name="Cancelled"></endEvent>
    <sequenceFlow id="up08_entity_lifecycle_f1" sourceRef="u8_start" targetRef="u8_defaults"/>
    <sequenceFlow id="up08_entity_lifecycle_f2" sourceRef="u8_defaults" targetRef="u8_wait"/>
    <sequenceFlow id="up08_entity_lifecycle_f3" sourceRef="u8_wait" targetRef="u8_endorse"/>
    <sequenceFlow id="up08_entity_lifecycle_f4" sourceRef="u8_wait" targetRef="u8_anniversary"/>
    <sequenceFlow id="up08_entity_lifecycle_f5" sourceRef="u8_wait" targetRef="u8_cancel"/>
    <sequenceFlow id="up08_entity_lifecycle_f6" sourceRef="u8_endorse" targetRef="u8_endorsement"/>
    <sequenceFlow id="up08_entity_lifecycle_f7" sourceRef="u8_endorsement" targetRef="u8_wait"/>
    <sequenceFlow id="up08_entity_lifecycle_f8" sourceRef="u8_anniversary" targetRef="u8_renew"/>
    <sequenceFlow id="up08_entity_lifecycle_f9" sourceRef="u8_renew" targetRef="u8_rg"/>
    <sequenceFlow id="up08_entity_lifecycle_f10" name="renew" sourceRef="u8_rg" targetRef="u8_cycle"><conditionExpression xsi:type="tFormalExpression">${renewalDecision == 'renew'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="up08_entity_lifecycle_f11" name="terminate" sourceRef="u8_rg" targetRef="u8_endTerminated"/>
    <sequenceFlow id="up08_entity_lifecycle_f12" sourceRef="u8_cycle" targetRef="u8_can"/>
    <sequenceFlow id="up08_entity_lifecycle_f13" name="same instance" sourceRef="u8_can" targetRef="u8_wait"><conditionExpression xsi:type="tFormalExpression">${cycles &lt; continueAsNewAfter}</conditionExpression></sequenceFlow>
    <sequenceFlow id="up08_entity_lifecycle_f14" name="bounded history" sourceRef="u8_can" targetRef="u8_continue"/>
    <sequenceFlow id="up08_entity_lifecycle_f15" sourceRef="u8_continue" targetRef="u8_endContinued"/>
    <sequenceFlow id="up08_entity_lifecycle_f16" sourceRef="u8_cancel" targetRef="u8_endCancelled"/>
  </process>
