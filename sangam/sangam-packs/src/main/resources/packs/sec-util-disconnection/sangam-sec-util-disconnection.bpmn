    <serviceTask id="ds_reconnect_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>ds_reconnect</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>reconnectSeat</operaton:string></operaton:field></extensionElements></serviceTask>
