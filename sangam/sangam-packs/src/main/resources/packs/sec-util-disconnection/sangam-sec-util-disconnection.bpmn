    <startEvent id="ds_start" name="Overdue bill" operaton:initiator="initiator" operaton:formKey="sangam:sec-util-disconnection/start"></startEvent>
    <serviceTask id="ds_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>consumerNo=@key;billAmount=0;areaType=MUNICIPAL;applicantRef=@consumerNo</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ds_notice" name="Serve 15 clear days notice (s.56)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>docs.notice</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>s56</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>consumerNo,billAmount</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>notice</operaton:string></operaton:field><operaton:field name="step"><operaton:string>notice</operaton:string></operaton:field></extensionElements></serviceTask>
    <eventBasedGateway id="ds_wait" name="Payment, appeal or notice period"></eventBasedGateway>
    <intermediateCatchEvent id="ds_paid" name="Paid"><messageEventDefinition messageRef="msg_sangam_util_paid"/></intermediateCatchEvent>
    <intermediateCatchEvent id="ds_appeal" name="Dispute / appeal with deposit"><messageEventDefinition messageRef="msg_sangam_util_appeal"/></intermediateCatchEvent>
    <intermediateCatchEvent id="ds_15d" name="15 clear days"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">P16D</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <endEvent id="ds_endPaid" name="Paid before disconnection"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <endEvent id="ds_endAppeal" name="Held: dispute before the forum"></endEvent>
