<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_sec_cap_checker" name="Onboarding checker" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <!-- SYNTHETIC bands; replace with the board policy. -->
  <decision id="sec-cap-checker" name="Onboarding checker" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="sec-cap-checker_t" hitPolicy="FIRST">
      <input id="sec-cap-checker_i0" label="Amount (INR)"><inputExpression id="sec-cap-checker_ie0" typeRef="double"><text>amount</text></inputExpression></input>
      <output id="sec-cap-checker_o0" label="Competent role" name="competentRole" typeRef="string"/>
      <rule id="sec-cap-checker_r0">
        <inputEntry id="sec-cap-checker_r0_i0"><text>-</text></inputEntry>
        <outputEntry id="sec-cap-checker_r0_o0"><text>"COMPLIANCE"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
