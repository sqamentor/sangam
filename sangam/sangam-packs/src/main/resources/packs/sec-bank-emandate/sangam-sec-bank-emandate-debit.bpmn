  <message id="msg_sangam_mandate_afaDone" name="sangam.mandate.afaDone"/>
  <message id="msg_sangam_mandate_optOut" name="sangam.mandate.optOut"/>
  <process id="sangam-sec-bank-emandate-debit" name="Recurring debit (one cycle)" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.bank.emandate</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>customerId,amount</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="ed_start" name="Debit due"></startEvent>
    <serviceTask id="ed_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>merchantCategory=GENERAL;afaDone=false;executionConnector=npci.debit;executionStep=debit;verifyApproval=false;reconcileRequired=false;applicantRef=@customerId</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="ed_afa" name="AFA needed? (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-bank-afa-limit</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <serviceTask id="ed_pre" name="Due date: preDebit" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BEFORE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>preDebit</operaton:string></operaton:field><operaton:field name="dateVar"><operaton:string>debitDate</operaton:string></operaton:field><operaton:field name="spec"><operaton:string>P1D</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ed_notify" name="Pre-debit notice (at least 24 hours before)" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>pre-debit-notice</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>sms,email</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>applicantRef</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ed_dueCalc" name="Due date: debit" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BEFORE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>debit</operaton:string></operaton:field><operaton:field name="dateVar"><operaton:string>debitDate</operaton:string></operaton:field><operaton:field name="spec"><operaton:string>PT0S</operaton:string></operaton:field></extensionElements></serviceTask>
    <intermediateCatchEvent id="ed_preWait" name="Notice time"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${preDebitDueAt}</timeDate></timerEventDefinition></intermediateCatchEvent>
    <eventBasedGateway id="ed_wait" name="Opt-out or debit time"></eventBasedGateway>
    <intermediateCatchEvent id="ed_optOut" name="Customer opts out of this debit"><messageEventDefinition messageRef="msg_sangam_mandate_optOut"/></intermediateCatchEvent>
    <intermediateCatchEvent id="ed_debitTime" name="Debit time"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${debitDueAt}</timeDate></timerEventDefinition></intermediateCatchEvent>
    <endEvent id="ed_endSkipped" name="Skipped by the customer"></endEvent>
    <exclusiveGateway id="ed_afaGw" name="AFA required?" default="sec_bank_emandate_debit_f16"></exclusiveGateway>
    <eventBasedGateway id="ed_afaWait" name="AFA or timeout"></eventBasedGateway>
    <intermediateCatchEvent id="ed_afaMsg" name="AFA completed"><messageEventDefinition messageRef="msg_sangam_mandate_afaDone"/></intermediateCatchEvent>
    <intermediateCatchEvent id="ed_afaTimeout" name="AFA not completed"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">PT24H</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <endEvent id="ed_endNoAfa" name="Not debited: AFA not completed"></endEvent>
    <callActivity id="ed_debit" name="Debit (core execution)" calledElement="sangam-core-execution"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="ed_end" name="Debited"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="ed_bounce" name="Debit returned: tell the customer" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>debit-bounce</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>sms,email</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>applicantRef</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="ed_exGw" name="executionOutcome?" default="sec_bank_emandate_debit_f19"></exclusiveGateway>
    <endEvent id="ed_endBounced" name="Bounced"></endEvent>
    <sequenceFlow id="sec_bank_emandate_debit_f1" sourceRef="ed_start" targetRef="ed_defaults"/>
