    <sequenceFlow id="sec_bank_emandate_debit_f6" sourceRef="ed_notify" targetRef="ed_dueCalc"/>
    <sequenceFlow id="sec_bank_emandate_debit_f7" sourceRef="ed_dueCalc" targetRef="ed_wait"/>
