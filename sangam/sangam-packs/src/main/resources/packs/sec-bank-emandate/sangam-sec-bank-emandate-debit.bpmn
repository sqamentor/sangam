    <sequenceFlow id="sec_bank_emandate_debit_f10" sourceRef="ed_optOut" targetRef="ed_endSkipped"/>
    <sequenceFlow id="sec_bank_emandate_debit_f11" sourceRef="ed_debitTime" targetRef="ed_afaGw"/>
    <sequenceFlow id="sec_bank_emandate_debit_f12" name="yes" sourceRef="ed_afaGw" targetRef="ed_afaWait"><conditionExpression xsi:type="tFormalExpression">${afaRequired}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_emandate_debit_f13" sourceRef="ed_afaWait" targetRef="ed_afaMsg"/>
    <sequenceFlow id="sec_bank_emandate_debit_f14" sourceRef="ed_afaWait" targetRef="ed_afaTimeout"/>
    <sequenceFlow id="sec_bank_emandate_debit_f15" sourceRef="ed_afaTimeout" targetRef="ed_endNoAfa"/>
    <sequenceFlow id="sec_bank_emandate_debit_f16" name="within the no-AFA limit" sourceRef="ed_afaGw" targetRef="ed_debit"/>
    <sequenceFlow id="sec_bank_emandate_debit_f17" sourceRef="ed_afaMsg" targetRef="ed_debit"/>
    <sequenceFlow id="sec_bank_emandate_debit_f18" name="DONE" sourceRef="ed_exGw" targetRef="ed_end"><conditionExpression xsi:type="tFormalExpression">${executionOutcome == 'DONE'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_emandate_debit_f19" name="otherwise" sourceRef="ed_exGw" targetRef="ed_bounce"/>
    <sequenceFlow id="sec_bank_emandate_debit_f20" sourceRef="ed_debit" targetRef="ed_exGw"/>
    <sequenceFlow id="sec_bank_emandate_debit_f21" sourceRef="ed_bounce" targetRef="ed_endBounced"/>
