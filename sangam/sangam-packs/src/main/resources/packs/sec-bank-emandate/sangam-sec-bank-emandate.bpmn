    <sequenceFlow id="sec_bank_emandate_f3" name="physical" sourceRef="em_typeGw" targetRef="em_verify"><conditionExpression xsi:type="tFormalExpression">${mandateType == 'NACH_PHYSICAL'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_emandate_f4" sourceRef="em_verify" targetRef="em_check"/>
