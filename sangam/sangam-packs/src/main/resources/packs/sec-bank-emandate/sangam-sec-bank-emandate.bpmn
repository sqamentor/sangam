  <process id="sangam-sec-bank-emandate" name="Mandate lifecycle" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.bank.emandate</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>customerId,account,amount,frequency,mandateType</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="em_start" name="Mandate requested" operaton:initiator="initiator" operaton:formKey="sangam:sec-bank-emandate/register"></startEvent>
    <serviceTask id="em_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>mandateType=API_EMANDATE;frequency=MONTHLY;merchantCategory=GENERAL;debitCycle=P30D;opsSeat=MANDATE-MAKER</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="em_typeGw" name="Physical NACH form?" default="sec_bank_emandate_f5"></exclusiveGateway>
    <userTask id="em_verify" name="Verify signed NACH form (maker)" operaton:candidateGroups="${opsSeat}" operaton:formKey="sangam:sec-bank-emandate/verify"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <userTask id="em_check" name="Approve mandate (checker)" operaton:candidateGroups="MANDATE-CHECKER" operaton:formKey="sangam:sec-bank-emandate/check"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>mandateDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="em_register" name="Register mandate (AFA by the customer)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>npci.mandate</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>register</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>customerId,account,amount,frequency</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>mandate</operaton:string></operaton:field><operaton:field name="step"><operaton:string>register</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="em_checkGw" name="" default="sec_bank_emandate_f8"></exclusiveGateway>
    <endEvent id="em_endRejected" name="Mandate rejected"></endEvent>
    <exclusiveGateway id="em_regGw" name="Registered?" default="sec_bank_emandate_f11"></exclusiveGateway>
    <endEvent id="em_endFailed" name="Registration failed"></endEvent>
    <eventBasedGateway id="em_wait" name="Next debit, change or revocation"></eventBasedGateway>
