    <sequenceFlow id="sec_bank_emandate_f6" sourceRef="em_check" targetRef="em_checkGw"/>
    <sequenceFlow id="sec_bank_emandate_f7" name="approve" sourceRef="em_checkGw" targetRef="em_register"><conditionExpression xsi:type="tFormalExpression">${mandateDecision == 'approve'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_emandate_f8" name="reject" sourceRef="em_checkGw" targetRef="em_endRejected"/>
    <sequenceFlow id="sec_bank_emandate_f9" sourceRef="em_register" targetRef="em_regGw"/>
    <sequenceFlow id="sec_bank_emandate_f10" name="failed" sourceRef="em_regGw" targetRef="em_endFailed"><conditionExpression xsi:type="tFormalExpression">${mandateStatus == 'FAILED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_emandate_f11" name="active" sourceRef="em_regGw" targetRef="em_wait"/>
    <sequenceFlow id="sec_bank_emandate_f12" sourceRef="em_wait" targetRef="em_next"/>
    <sequenceFlow id="sec_bank_emandate_f13" sourceRef="em_wait" targetRef="em_modify"/>
