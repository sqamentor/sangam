    <serviceTask id="em_doModify" name="Modify mandate" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>npci.mandate</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>modify</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>customerId,amount</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>mandateMod</operaton:string></operaton:field><operaton:field name="step"><operaton:string>modify</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="em_doRevoke" name="Revoke mandate" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>npci.mandate</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>revoke</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>customerId</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>mandateRev</operaton:string></operaton:field><operaton:field name="step"><operaton:string>revoke</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="em_endRevoked" name="Revoked"></endEvent>
