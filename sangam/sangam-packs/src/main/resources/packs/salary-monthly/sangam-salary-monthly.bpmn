      <bpmndi:BPMNShape id="sm_doneGw_di" bpmnElement="sm_doneGw"><dc:Bounds x="1530" y="45" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sm_report_di" bpmnElement="sm_report"><dc:Bounds x="1670" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sm_end_di" bpmnElement="sm_end"><dc:Bounds x="1867" y="52" width="36" height="36"/></bpmndi:BPMNShape>
