<!-- Monthly salary run. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_salary_monthly" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_salaryRunNow" name="sangam.salaryRunNow"/>
  <process id="sangam-salary-monthly" name="Monthly salary run" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.ifms.salary-monthly</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>period</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="sm_timer" name="Monthly on the 20th"><timerEventDefinition><timeCycle xsi:type="tFormalExpression">0 0 2 20 * ?</timeCycle></timerEventDefinition></startEvent>
    <startEvent id="sm_manual" name="Run now (message)"><messageEventDefinition messageRef="msg_sangam_salaryRunNow"/></startEvent>
    <exclusiveGateway id="sm_join" name=""></exclusiveGateway>
    <serviceTask id="sm_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>caseType=SALARY</operaton:string></operaton:field><operaton:field name="defaults"><operaton:string>period=current;actingSeat=CLERK-DDO;initiator=system;officeId=DPW-X</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="sm_load" name="Salary bills from HRMS" operaton:class="org.sangam.packs.core.BatchDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>LOAD</operaton:string></operaton:field><operaton:field name="connector"><operaton:string>hrms.salaryBills</operaton:string></operaton:field><operaton:field name="sampleSize"><operaton:string>3</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="sm_open" name="Open round" operaton:class="org.sangam.packs.core.BatchDelegate"><extensionElements><operaton:field name="op"><operaton:string>OPEN</operaton:string></operaton:field><operaton:field name="itemsVar"><operaton:string>items</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="sm_fanOut" name="Start one instance per item (chunk)" operaton:class="org.sangam.packs.core.BatchDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>FAN_OUT</operaton:string></operaton:field><operaton:field name="itemsVar"><operaton:string>items</operaton:string></operaton:field><operaton:field name="childProcessKey"><operaton:string>sangam-p1-bill-payment</operaton:string></operaton:field><operaton:field name="chunkSize"><operaton:string>200</operaton:string></operaton:field><operaton:field name="inherit"><operaton:string>caseType,period,officeId,actingSeat,initiator</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="sm_fanGw" name="All started?" default="salary_monthly_f8"></exclusiveGateway>
    <intermediateCatchEvent id="sm_poll" name="Poll aggregate"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">PT30M</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <serviceTask id="sm_aggregate" name="Aggregate outcomes" operaton:class="org.sangam.packs.core.BatchDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>AGGREGATE</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="sm_doneGw" name="Round complete?" default="salary_monthly_f13"></exclusiveGateway>
    <serviceTask id="sm_report" name="Salary run report" operaton:class="org.sangam.packs.core.DocumentDelegate"><extensionElements><operaton:field name="template"><operaton:string>salary-run-report</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="sm_end" name="Run closed"></endEvent>
    <sequenceFlow id="salary_monthly_f1" sourceRef="sm_timer" targetRef="sm_join"/>
    <sequenceFlow id="salary_monthly_f2" sourceRef="sm_manual" targetRef="sm_join"/>
    <sequenceFlow id="salary_monthly_f3" sourceRef="sm_join" targetRef="sm_defaults"/>
    <sequenceFlow id="salary_monthly_f4" sourceRef="sm_defaults" targetRef="sm_load"/>
    <sequenceFlow id="salary_monthly_f5" sourceRef="sm_open" targetRef="sm_fanOut"/>
    <sequenceFlow id="salary_monthly_f6" sourceRef="sm_fanOut" targetRef="sm_fanGw"/>
    <sequenceFlow id="salary_monthly_f7" name="next chunk" sourceRef="sm_fanGw" targetRef="sm_fanOut"><conditionExpression xsi:type="tFormalExpression">${!fanOutDone}</conditionExpression></sequenceFlow>
    <sequenceFlow id="salary_monthly_f8" name="all started" sourceRef="sm_fanGw" targetRef="sm_poll"/>
    <sequenceFlow id="salary_monthly_f9" sourceRef="sm_poll" targetRef="sm_aggregate"/>
    <sequenceFlow id="salary_monthly_f10" sourceRef="sm_aggregate" targetRef="sm_doneGw"/>
    <sequenceFlow id="salary_monthly_f11" name="not yet" sourceRef="sm_doneGw" targetRef="sm_poll"><conditionExpression xsi:type="tFormalExpression">${!batchComplete}</conditionExpression></sequenceFlow>
    <sequenceFlow id="salary_monthly_f12" sourceRef="sm_load" targetRef="sm_open"/>
    <sequenceFlow id="salary_monthly_f13" name="complete" sourceRef="sm_doneGw" targetRef="sm_report"/>
    <sequenceFlow id="salary_monthly_f14" sourceRef="sm_report" targetRef="sm_end"/>
  </process>
  <bpmndi:BPMNDiagram id="salary_monthly_diagram">
    <bpmndi:BPMNPlane id="salary_monthly_plane" bpmnElement="sangam-salary-monthly">
