<!-- UP-11 Change. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_up11_change" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <process id="sangam-up11-change" name="UP-11 Change" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>universal.up11-change-window</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>subject,description,rollbackPlan</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="u11_start" name="Change requested" operaton:initiator="initiator" operaton:formKey="sangam:up11-change-window/request"></startEvent>
    <serviceTask id="u11_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>priority=P3;committeeSeats=CAB-1,CAB-2,CAB-3;quorumRule=MAJORITY;freezeFrozen=false;implementerSeat=IMPLEMENTER</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="u11_risk" name="Risk and CAB need (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>up11-risk</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <exclusiveGateway id="u11_cabGw" name="CAB?" default="up11_change_f5"></exclusiveGateway>
    <callActivity id="u11_cab" name="Change advisory board (core committee)" calledElement="sangam-core-committee"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <serviceTask id="u11_freeze" name="Freeze calendar check" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>change.freezeCheck</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>check</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>changeWindowStart</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>freeze</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="u11_cabRes" name="Approved?" default="up11_change_f8"></exclusiveGateway>
    <endEvent id="u11_endRejected" name="Rejected by CAB"></endEvent>
    <exclusiveGateway id="u11_freezeGw" name="Frozen?" default="up11_change_f12"></exclusiveGateway>
    <userTask id="u11_reschedule" name="Window falls in a freeze: reschedule" operaton:candidateGroups="${initiatorSeat}" operaton:formKey="sangam:up11-change-window/reschedule"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <intermediateCatchEvent id="u11_window" name="Change window opens"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${changeWindowStart}</timeDate></timerEventDefinition></intermediateCatchEvent>
    <userTask id="u11_implement" name="Implement change" operaton:candidateGroups="${implementerSeat}" operaton:formKey="sangam:up11-change-window/implement"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <userTask id="u11_verify" name="Verify change" operaton:candidateGroups="${implementerSeat}" operaton:formKey="sangam:up11-change-window/verify"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>verificationResult</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="u11_rollback" name="Roll back change" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true" isForCompensation="true"><extensionElements><operaton:field name="connector"><operaton:string>change.rollback</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>rollback</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>subject,rollbackPlan</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>rollback</operaton:string></operaton:field><operaton:field name="step"><operaton:string>rollback</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="u11_verGw" name="" default="up11_change_f19"></exclusiveGateway>
    <intermediateThrowEvent id="u11_compensate" name="Roll back by compensation"><compensateEventDefinition/></intermediateThrowEvent>
    <endEvent id="u11_endRolledBack" name="Rolled back"></endEvent>
    <endEvent id="u11_end" name="Implemented"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="u11_implComp" name="Roll back" attachedToRef="u11_implement" cancelActivity="true"><compensateEventDefinition/></boundaryEvent>
    <sequenceFlow id="up11_change_f1" sourceRef="u11_start" targetRef="u11_defaults"/>
    <sequenceFlow id="up11_change_f2" sourceRef="u11_defaults" targetRef="u11_risk"/>
    <sequenceFlow id="up11_change_f3" sourceRef="u11_risk" targetRef="u11_cabGw"/>
    <sequenceFlow id="up11_change_f4" name="yes" sourceRef="u11_cabGw" targetRef="u11_cab"><conditionExpression xsi:type="tFormalExpression">${cabRequired}</conditionExpression></sequenceFlow>
    <sequenceFlow id="up11_change_f5" name="standard change" sourceRef="u11_cabGw" targetRef="u11_freeze"/>
    <sequenceFlow id="up11_change_f6" sourceRef="u11_cab" targetRef="u11_cabRes"/>
    <sequenceFlow id="up11_change_f7" name="approved" sourceRef="u11_cabRes" targetRef="u11_freeze"><conditionExpression xsi:type="tFormalExpression">${committeeApproved}</conditionExpression></sequenceFlow>
    <sequenceFlow id="up11_change_f8" name="rejected" sourceRef="u11_cabRes" targetRef="u11_endRejected"/>
    <sequenceFlow id="up11_change_f9" sourceRef="u11_freeze" targetRef="u11_freezeGw"/>
    <sequenceFlow id="up11_change_f10" name="frozen" sourceRef="u11_freezeGw" targetRef="u11_reschedule"><conditionExpression xsi:type="tFormalExpression">${freezeFrozen}</conditionExpression></sequenceFlow>
    <sequenceFlow id="up11_change_f11" sourceRef="u11_reschedule" targetRef="u11_freeze"/>
    <sequenceFlow id="up11_change_f12" name="clear" sourceRef="u11_freezeGw" targetRef="u11_window"/>
    <sequenceFlow id="up11_change_f13" sourceRef="u11_window" targetRef="u11_implement"/>
    <sequenceFlow id="up11_change_f14" sourceRef="u11_implement" targetRef="u11_verify"/>
    <sequenceFlow id="up11_change_f16" sourceRef="u11_verify" targetRef="u11_verGw"/>
    <sequenceFlow id="up11_change_f17" name="failed" sourceRef="u11_verGw" targetRef="u11_compensate"><conditionExpression xsi:type="tFormalExpression">${verificationResult == 'rollback'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="up11_change_f18" sourceRef="u11_compensate" targetRef="u11_endRolledBack"/>
    <sequenceFlow id="up11_change_f19" name="success" sourceRef="u11_verGw" targetRef="u11_end"/>
    <association id="up11_change_a15" associationDirection="One" sourceRef="u11_implComp" targetRef="u11_rollback"/>
  </process>
