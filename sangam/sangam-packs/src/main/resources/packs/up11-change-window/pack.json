{
  "id": "universal.up11-change-window",
  "version": "1.0.0",
  "name": {
    "en": "UP-11 Change approval with window and rollback",
    "hi": "यूपी-11 समय-खिड़की एवं वापसी सहित परिवर्तन अनुमोदन"
  },
