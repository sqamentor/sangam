      "path": "packs/up11-change-window/up11-risk.dmn"
    },
    {
      "kind": "FORM",
      "path": "packs/up11-change-window/forms/request.form.json"
    },
    {
      "kind": "FORM",
      "path": "packs/up11-change-window/forms/reschedule.form.json"
    },
    {
      "kind": "FORM",
      "path": "packs/up11-change-window/forms/implement.form.json"
    },
    {
      "kind": "FORM",
      "path": "packs/up11-change-window/forms/verify.form.json"
    },
    {
      "kind": "SEED",
