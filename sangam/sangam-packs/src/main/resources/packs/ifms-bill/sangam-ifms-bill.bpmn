<!-- Bill by catalogue type. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_ifms_bill" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_cancelCase" name="sangam.cancelCase"/>
  <message id="msg_sangam_ifms_fundsAllotted" name="sangam.ifms.fundsAllotted"/>
  <message id="msg_sangam_withdrawCase" name="sangam.withdrawCase"/>
  <process id="sangam-ifms-bill" name="Bill by catalogue type" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.ifms.bill</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>billType,headOfAccount,amount,payee,payeeAccount,sanctionRef</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="bl_start" name="Bill drafted by the DDO" operaton:initiator="initiator" operaton:formKey="sangam:ifms-bill/draft"></startEvent>
    <serviceTask id="bl_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>billType=CONTINGENT;headOfAccount=2054-00-001-01-00-13;amount=0;payee=;payeeAccount=;sanctionRef=;ddoCode=DDO-1;ledgerId=BUDGET;fundsAvailable=999999999999.0;docValid=true;clsValid=true;dupDuplicate=false;payeeMultiple=false;partyId=;ifsc=;docPaymentRail=DEFAULT;docApprovalChain=PAO_3;paoOutcome=PASSED;caseType=BILL;routingDecisionKey=ifms-bill-authority;scrutinySeat=DDO-1;executionStep=pay;reconcileRequired=true;outputTemplate=payment-advice;appealAllowed=false;encumbranceLedger=BUDGET;releaseConnector=ledger.release</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="bl_profile" name="Bind profile version" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>config.profile</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>profile.binding</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>billType</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>prof</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="bl_type" name="Bill type from the catalogue" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>config.documentType</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>documentType.get</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>billType</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>doc</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="bl_cls" name="Validate head of account" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>config.classification</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>classification.validate</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>headOfAccount</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>cls</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="bl_check" name="Check bill against its type" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>config.documentType</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>documentType.check</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>billType,headOfAccount,amount,sanctionRef,claimPeriod</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>doc</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="bl_dup" name="Duplicate / similar claim" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>ifms.duplicateBill</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>check</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>payee,amount,claimPeriod</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>dup</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="bl_payee" name="Payee golden record (party registry)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>registry.party</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>payee.resolve</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>partyId,payee,payeeAccount,ifsc</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>payee</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="bl_validGw" name="Valid?" default="ifms_bill_f21"></exclusiveGateway>
    <serviceTask id="bl_rjInvalid_code" name="Reason: BILL_INVALID" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=BILL_INVALID</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="bl_rjInvalid_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="bl_rjInvalid_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="bl_rjDup_code" name="Reason: DUPLICATE_CLAIM" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=DUPLICATE_CLAIM</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="bl_rjDup_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="bl_rjDup_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="bl_funds" name="Funds at the control dimension" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>ledger.available</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>available</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>ledgerId,headOfAccount,ddoCode</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>funds</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="bl_payeeReview" name="Confirm payee: account held by several parties" operaton:candidateGroups="PAO-1" operaton:formKey="sangam:ifms-bill/payee-review"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>payeeDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="bl_payeeGw" name="" default="ifms_bill_f20"></exclusiveGateway>
    <serviceTask id="bl_rjPayee_code" name="Reason: PAYEE_NOT_CONFIRMED" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=PAYEE_NOT_CONFIRMED</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="bl_rjPayee_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="bl_rjPayee_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <exclusiveGateway id="bl_fundsGw" name="Funds available?" default="ifms_bill_f25"></exclusiveGateway>
    <intermediateCatchEvent id="bl_hold" name="Held for budget (released on allotment)"><messageEventDefinition messageRef="msg_sangam_ifms_fundsAllotted"/></intermediateCatchEvent>
    <serviceTask id="bl_encumber" name="Encumber" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>ledger.encumber</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>encumber</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>ledgerId,headOfAccount,ddoCode,amount</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>enc</operaton:string></operaton:field><operaton:field name="step"><operaton:string>encumber</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="bl_rail" name="Payment rail (profile / tenant DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>ifms-rail-connector</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <callActivity id="bl_chain" name="PAO / treasury chain" calledElement="sangam-ifms-pao-chain"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <serviceTask id="bl_release" name="Release encumbrance" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>ledger.release</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>release</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>ledgerId,headOfAccount,ddoCode,amount</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>rel</operaton:string></operaton:field><operaton:field name="step"><operaton:string>release</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="bl_revise" name="Reply to objection / correct" operaton:candidateGroups="${initiatorSeat}" operaton:formKey="sangam:ifms-bill/revise"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>reviseDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <callActivity id="bl_pay" name="Payment through the rail (core execution)" calledElement="sangam-core-execution"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <exclusiveGateway id="bl_chainGw" name="paoOutcome?" default="ifms_bill_f29"></exclusiveGateway>
    <exclusiveGateway id="bl_revGw" name="" default="ifms_bill_f37"></exclusiveGateway>
    <serviceTask id="bl_version" name="New bill version (same case, GP-50)" operaton:class="org.sangam.packs.core.CaseRecordDelegate"><extensionElements><operaton:field name="op"><operaton:string>RESUBMIT</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="bl_wd_kind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="bl_wd_call" name="Withdraw (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="bl_wd_end" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="bl_consume" name="Post payment (consume)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>ledger.consume</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>consume</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>ledgerId,headOfAccount,ddoCode,amount,operationId</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>con</operaton:string></operaton:field><operaton:field name="step"><operaton:string>consume</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="bl_close" name="Payment advice and voucher (core closure)" calledElement="sangam-core-closure"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <serviceTask id="bl_payFailed" name="Payment failed: suspense, reissue with a new operation" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>ifms-payment-failed</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>inapp</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>initiatorSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="bl_exGw" name="executionOutcome?" default="ifms_bill_f39"></exclusiveGateway>
    <serviceTask id="bl_reissue" name="Reissue tag" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>reissueTag=true</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="bl_end" name="Closed"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <sequenceFlow id="ifms_bill_f1" sourceRef="bl_start" targetRef="bl_defaults"/>
    <sequenceFlow id="ifms_bill_f2" sourceRef="bl_defaults" targetRef="bl_profile"/>
    <sequenceFlow id="ifms_bill_f3" sourceRef="bl_profile" targetRef="bl_type"/>
    <sequenceFlow id="ifms_bill_f4" sourceRef="bl_type" targetRef="bl_cls"/>
    <sequenceFlow id="ifms_bill_f5" sourceRef="bl_cls" targetRef="bl_check"/>
    <sequenceFlow id="ifms_bill_f6" sourceRef="bl_check" targetRef="bl_dup"/>
    <sequenceFlow id="ifms_bill_f7" sourceRef="bl_dup" targetRef="bl_payee"/>
    <sequenceFlow id="ifms_bill_f8" sourceRef="bl_payee" targetRef="bl_validGw"/>
    <sequenceFlow id="ifms_bill_f9" sourceRef="bl_rjInvalid_reject" targetRef="bl_rjInvalid_endRejected"/>
    <sequenceFlow id="ifms_bill_f10" sourceRef="bl_rjInvalid_code" targetRef="bl_rjInvalid_reject"/>
    <sequenceFlow id="ifms_bill_f11" name="invalid (findings cite the rule)" sourceRef="bl_validGw" targetRef="bl_rjInvalid_code"><conditionExpression xsi:type="tFormalExpression">${!docValid || !clsValid}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_bill_f12" sourceRef="bl_rjDup_reject" targetRef="bl_rjDup_endRejected"/>
    <sequenceFlow id="ifms_bill_f13" sourceRef="bl_rjDup_code" targetRef="bl_rjDup_reject"/>
    <sequenceFlow id="ifms_bill_f14" name="duplicate" sourceRef="bl_validGw" targetRef="bl_rjDup_code"><conditionExpression xsi:type="tFormalExpression">${dupDuplicate}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_bill_f15" name="several beneficiaries on the account" sourceRef="bl_validGw" targetRef="bl_payeeReview"><conditionExpression xsi:type="tFormalExpression">${payeeMultiple}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_bill_f16" sourceRef="bl_payeeReview" targetRef="bl_payeeGw"/>
    <sequenceFlow id="ifms_bill_f17" name="confirmed" sourceRef="bl_payeeGw" targetRef="bl_funds"><conditionExpression xsi:type="tFormalExpression">${payeeDecision == 'approve'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_bill_f18" sourceRef="bl_rjPayee_reject" targetRef="bl_rjPayee_endRejected"/>
    <sequenceFlow id="ifms_bill_f19" sourceRef="bl_rjPayee_code" targetRef="bl_rjPayee_reject"/>
    <sequenceFlow id="ifms_bill_f20" name="rejected" sourceRef="bl_payeeGw" targetRef="bl_rjPayee_code"/>
    <sequenceFlow id="ifms_bill_f21" name="valid" sourceRef="bl_validGw" targetRef="bl_funds"/>
    <sequenceFlow id="ifms_bill_f22" sourceRef="bl_funds" targetRef="bl_fundsGw"/>
    <sequenceFlow id="ifms_bill_f23" name="pending for budget" sourceRef="bl_fundsGw" targetRef="bl_hold"><conditionExpression xsi:type="tFormalExpression">${fundsAvailable &lt; amount}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_bill_f24" sourceRef="bl_hold" targetRef="bl_funds"/>
    <sequenceFlow id="ifms_bill_f25" name="available" sourceRef="bl_fundsGw" targetRef="bl_encumber"/>
    <sequenceFlow id="ifms_bill_f26" sourceRef="bl_encumber" targetRef="bl_rail"/>
    <sequenceFlow id="ifms_bill_f27" sourceRef="bl_rail" targetRef="bl_chain"/>
    <sequenceFlow id="ifms_bill_f28" name="PASSED" sourceRef="bl_chainGw" targetRef="bl_pay"><conditionExpression xsi:type="tFormalExpression">${paoOutcome == 'PASSED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_bill_f29" name="otherwise" sourceRef="bl_chainGw" targetRef="bl_release"/>
    <sequenceFlow id="ifms_bill_f30" sourceRef="bl_chain" targetRef="bl_chainGw"/>
    <sequenceFlow id="ifms_bill_f31" sourceRef="bl_release" targetRef="bl_revise"/>
    <sequenceFlow id="ifms_bill_f32" sourceRef="bl_revise" targetRef="bl_revGw"/>
    <sequenceFlow id="ifms_bill_f33" name="resubmit" sourceRef="bl_revGw" targetRef="bl_version"><conditionExpression xsi:type="tFormalExpression">${reviseDecision == 'resubmit'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_bill_f34" sourceRef="bl_version" targetRef="bl_type"/>
    <sequenceFlow id="ifms_bill_f35" sourceRef="bl_wd_kind" targetRef="bl_wd_call"/>
    <sequenceFlow id="ifms_bill_f36" sourceRef="bl_wd_call" targetRef="bl_wd_end"/>
    <sequenceFlow id="ifms_bill_f37" name="withdraw" sourceRef="bl_revGw" targetRef="bl_wd_kind"/>
    <sequenceFlow id="ifms_bill_f38" name="DONE" sourceRef="bl_exGw" targetRef="bl_consume"><conditionExpression xsi:type="tFormalExpression">${executionOutcome == 'DONE'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_bill_f39" name="otherwise" sourceRef="bl_exGw" targetRef="bl_payFailed"/>
    <sequenceFlow id="ifms_bill_f40" sourceRef="bl_pay" targetRef="bl_exGw"/>
    <sequenceFlow id="ifms_bill_f41" sourceRef="bl_payFailed" targetRef="bl_reissue"/>
    <sequenceFlow id="ifms_bill_f42" sourceRef="bl_reissue" targetRef="bl_pay"/>
    <sequenceFlow id="ifms_bill_f43" sourceRef="bl_consume" targetRef="bl_close"/>
    <sequenceFlow id="ifms_bill_f44" sourceRef="bl_close" targetRef="bl_end"/>
    <subProcess id="bl_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="bl_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="bl_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="bl_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="bl_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="ifms_bill_f45" sourceRef="bl_withdrawStart" targetRef="bl_withdrawKind"/>
      <sequenceFlow id="ifms_bill_f46" sourceRef="bl_withdrawKind" targetRef="bl_withdrawCall"/>
      <sequenceFlow id="ifms_bill_f47" sourceRef="bl_withdrawCall" targetRef="bl_withdrawEnd"/>
    </subProcess>
    <subProcess id="bl_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="bl_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="bl_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="bl_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="bl_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="ifms_bill_f48" sourceRef="bl_cancelStart" targetRef="bl_cancelKind"/>
      <sequenceFlow id="ifms_bill_f49" sourceRef="bl_cancelKind" targetRef="bl_cancelCall"/>
      <sequenceFlow id="ifms_bill_f50" sourceRef="bl_cancelCall" targetRef="bl_cancelEnd"/>
    </subProcess>
  </process>
  <bpmndi:BPMNDiagram id="ifms_bill_diagram">
    <bpmndi:BPMNPlane id="ifms_bill_plane" bpmnElement="sangam-ifms-bill">
      <bpmndi:BPMNShape id="bl_start_di" bpmnElement="bl_start"><dc:Bounds x="52" y="52" width="36" height="36"/></bpmndi:BPMNShape>
