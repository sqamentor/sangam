    <sequenceFlow id="ifms_bill_f13" name="profile binding missing" sangam:priority="1" sourceRef="bl_validGw" targetRef="bl_bindingHold"><conditionExpression xsi:type="tFormalExpression">${docValid == null || clsValid == null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_bill_f14" sourceRef="bl_rjInvalid_reject" targetRef="bl_rjInvalid_endRejected"/>
    <sequenceFlow id="ifms_bill_f15" sourceRef="bl_rjInvalid_code" targetRef="bl_rjInvalid_reject"/>
    <sequenceFlow id="ifms_bill_f16" name="invalid (findings cite the rule)" sangam:priority="2" sourceRef="bl_validGw" targetRef="bl_rjInvalid_code"><conditionExpression xsi:type="tFormalExpression">${!docValid || !clsValid}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_bill_f17" sourceRef="bl_rjDupCheck_reject" targetRef="bl_rjDupCheck_endRejected"/>
    <sequenceFlow id="ifms_bill_f18" sourceRef="bl_rjDupCheck_code" targetRef="bl_rjDupCheck_reject"/>
    <sequenceFlow id="ifms_bill_f19" name="duplicate check not confirmed" sangam:priority="3" sourceRef="bl_validGw" targetRef="bl_rjDupCheck_code"><conditionExpression xsi:type="tFormalExpression">${dupStatus != 'COMPLETED' || dupDuplicate == null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_bill_f20" sourceRef="bl_rjDup_reject" targetRef="bl_rjDup_endRejected"/>
    <sequenceFlow id="ifms_bill_f21" sourceRef="bl_rjDup_code" targetRef="bl_rjDup_reject"/>
    <sequenceFlow id="ifms_bill_f22" name="duplicate" sangam:priority="4" sourceRef="bl_validGw" targetRef="bl_rjDup_code"><conditionExpression xsi:type="tFormalExpression">${dupStatus == 'COMPLETED' &amp;&amp; dupDuplicate != null &amp;&amp; (dupDuplicate)}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_bill_f23" sourceRef="bl_rjPayeeCheck_reject" targetRef="bl_rjPayeeCheck_endRejected"/>
    <sequenceFlow id="ifms_bill_f24" sourceRef="bl_rjPayeeCheck_code" targetRef="bl_rjPayeeCheck_reject"/>
    <sequenceFlow id="ifms_bill_f25" name="payee check not confirmed" sangam:priority="5" sourceRef="bl_validGw" targetRef="bl_rjPayeeCheck_code"><conditionExpression xsi:type="tFormalExpression">${payeeStatus != 'COMPLETED' || payeeMultiple == null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_bill_f26" sourceRef="bl_funds_clear" targetRef="bl_funds"/>
    <sequenceFlow id="ifms_bill_f27" name="several beneficiaries on the account" sangam:priority="6" sourceRef="bl_validGw" targetRef="bl_payeeReview"><conditionExpression xsi:type="tFormalExpression">${payeeStatus == 'COMPLETED' &amp;&amp; payeeMultiple != null &amp;&amp; (payeeMultiple)}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_bill_f28" sourceRef="bl_payeeReview" targetRef="bl_payeeGw"/>
    <sequenceFlow id="ifms_bill_f29" name="confirmed" sourceRef="bl_payeeGw" targetRef="bl_funds_clear"><conditionExpression xsi:type="tFormalExpression">${payeeDecision == 'approve'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_bill_f30" sourceRef="bl_rjPayee_reject" targetRef="bl_rjPayee_endRejected"/>
    <sequenceFlow id="ifms_bill_f31" sourceRef="bl_rjPayee_code" targetRef="bl_rjPayee_reject"/>
    <sequenceFlow id="ifms_bill_f32" name="rejected" sourceRef="bl_payeeGw" targetRef="bl_rjPayee_code"/>
    <sequenceFlow id="ifms_bill_f33" name="valid" sourceRef="bl_validGw" targetRef="bl_funds_clear"/>
    <sequenceFlow id="ifms_bill_f34" sourceRef="bl_funds" targetRef="bl_fundsGw"/>
    <sequenceFlow id="ifms_bill_f35" sourceRef="bl_rjFunds_reject" targetRef="bl_rjFunds_endRejected"/>
    <sequenceFlow id="ifms_bill_f36" sourceRef="bl_rjFunds_code" targetRef="bl_rjFunds_reject"/>
    <sequenceFlow id="ifms_bill_f37" name="availability not confirmed" sourceRef="bl_fundsGw" targetRef="bl_rjFunds_code"><conditionExpression xsi:type="tFormalExpression">${fundsStatus != 'COMPLETED' || fundsAvailable == null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_bill_f38" name="pending for budget" sourceRef="bl_fundsGw" targetRef="bl_hold"><conditionExpression xsi:type="tFormalExpression">${fundsStatus == 'COMPLETED' &amp;&amp; fundsAvailable != null &amp;&amp; fundsAvailable &lt; amount}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_bill_f39" sourceRef="bl_hold" targetRef="bl_funds_clear"/>
    <sequenceFlow id="ifms_bill_f40" name="available" sourceRef="bl_fundsGw" targetRef="bl_encumber"/>
    <sequenceFlow id="ifms_bill_f41" sourceRef="bl_encumber" targetRef="bl_rail"/>
    <sequenceFlow id="ifms_bill_f42" sourceRef="bl_rail" targetRef="bl_chain"/>
    <sequenceFlow id="ifms_bill_f43" name="PASSED" sourceRef="bl_chainGw" targetRef="bl_payeeVerify"><conditionExpression xsi:type="tFormalExpression">${paoOutcome == 'PASSED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_bill_f44" name="otherwise" sourceRef="bl_chainGw" targetRef="bl_release"/>
    <sequenceFlow id="ifms_bill_f45" sourceRef="bl_chain" targetRef="bl_chainGw"/>
    <sequenceFlow id="ifms_bill_f46" sourceRef="bl_release" targetRef="bl_revise"/>
    <sequenceFlow id="ifms_bill_f47" sourceRef="bl_revise" targetRef="bl_revGw"/>
    <sequenceFlow id="ifms_bill_f48" name="resubmit" sourceRef="bl_revGw" targetRef="bl_version"><conditionExpression xsi:type="tFormalExpression">${reviseDecision == 'resubmit'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_bill_f49" sourceRef="bl_version" targetRef="bl_type"/>
    <sequenceFlow id="ifms_bill_f50" sourceRef="bl_wd_kind" targetRef="bl_wd_call"/>
    <sequenceFlow id="ifms_bill_f51" sourceRef="bl_wd_call" targetRef="bl_wd_end"/>
    <sequenceFlow id="ifms_bill_f52" name="withdraw" sourceRef="bl_revGw" targetRef="bl_wd_kind"/>
    <sequenceFlow id="ifms_bill_f53" sourceRef="bl_payeeVerify" targetRef="bl_payeeVerifiedGw"/>
    <sequenceFlow id="ifms_bill_f54" name="verified" sourceRef="bl_payeeVerifiedGw" targetRef="bl_pay"><conditionExpression xsi:type="tFormalExpression">${payeeVerified}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_bill_f55" name="not verified" sourceRef="bl_payeeVerifiedGw" targetRef="bl_payeeHold"/>
    <sequenceFlow id="ifms_bill_f56" sourceRef="bl_payeeHold" targetRef="bl_payeeHoldGw"/>
    <sequenceFlow id="ifms_bill_f57" name="check again" sourceRef="bl_payeeHoldGw" targetRef="bl_payeeVerify"><conditionExpression xsi:type="tFormalExpression">${payeeHoldDecision == 'checkAgain'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_bill_f58" name="DONE" sourceRef="bl_exGw" targetRef="bl_consume"><conditionExpression xsi:type="tFormalExpression">${executionOutcome == 'DONE'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_bill_f59" name="otherwise" sourceRef="bl_exGw" targetRef="bl_payFailed"/>
    <sequenceFlow id="ifms_bill_f60" sourceRef="bl_pay" targetRef="bl_exGw"/>
    <boundaryEvent id="bl_payInvalidated" name="Payee account or payload changed after the PAO pass: fresh approval" attachedToRef="bl_pay" cancelActivity="true"><errorEventDefinition errorRef="err_APPROVAL_INVALIDATED"/></boundaryEvent>
    <sequenceFlow id="ifms_bill_f76" name="approval invalidated" sourceRef="bl_payInvalidated" targetRef="bl_rail"/>
    <sequenceFlow id="ifms_bill_f61" sourceRef="bl_payFailed" targetRef="bl_payCorrect"/>
    <sequenceFlow id="ifms_bill_f62" sourceRef="bl_payCorrect" targetRef="bl_payCorrectGw"/>
    <sequenceFlow id="ifms_bill_f63" name="reissue after correction" sourceRef="bl_payCorrectGw" targetRef="bl_rail"><conditionExpression xsi:type="tFormalExpression">${payCorrectDecision == 'reissue'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_bill_f64" sourceRef="bl_payCancel_kind" targetRef="bl_payCancel_call"/>
    <sequenceFlow id="ifms_bill_f65" sourceRef="bl_payCancel_call" targetRef="bl_payCancel_end"/>
    <sequenceFlow id="ifms_bill_f66" name="cancel" sourceRef="bl_payCorrectGw" targetRef="bl_payCancel_kind"/>
    <sequenceFlow id="ifms_bill_f67" name="cancel" sourceRef="bl_payeeHoldGw" targetRef="bl_payCancel_kind"/>
    <sequenceFlow id="ifms_bill_f68" sourceRef="bl_consume" targetRef="bl_close"/>
    <sequenceFlow id="ifms_bill_f69" sourceRef="bl_close" targetRef="bl_end"/>
    <subProcess id="bl_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="bl_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="bl_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="bl_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.2"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="bl_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="ifms_bill_f70" sourceRef="bl_withdrawStart" targetRef="bl_withdrawKind"/>
      <sequenceFlow id="ifms_bill_f71" sourceRef="bl_withdrawKind" targetRef="bl_withdrawCall"/>
      <sequenceFlow id="ifms_bill_f72" sourceRef="bl_withdrawCall" targetRef="bl_withdrawEnd"/>
    </subProcess>
    <subProcess id="bl_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="bl_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="bl_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="bl_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.2"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="bl_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="ifms_bill_f73" sourceRef="bl_cancelStart" targetRef="bl_cancelKind"/>
      <sequenceFlow id="ifms_bill_f74" sourceRef="bl_cancelKind" targetRef="bl_cancelCall"/>
      <sequenceFlow id="ifms_bill_f75" sourceRef="bl_cancelCall" targetRef="bl_cancelEnd"/>
    </subProcess>
