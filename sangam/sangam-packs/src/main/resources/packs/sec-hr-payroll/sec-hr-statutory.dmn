<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_sec_hr_statutory" name="PF and ESI rates (EPF Scheme / ESI Act; verify current notifications)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="sec-hr-statutory" name="PF and ESI rates (EPF Scheme / ESI Act; verify current notifications)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="sec-hr-statutory_t" hitPolicy="FIRST">
      <input id="sec-hr-statutory_i0" label="Period"><inputExpression id="sec-hr-statutory_ie0" typeRef="string"><text>period</text></inputExpression></input>
      <output id="sec-hr-statutory_o0" label="PF employee %" name="pfEmployeePct" typeRef="double"/>
      <output id="sec-hr-statutory_o1" label="PF employer %" name="pfEmployerPct" typeRef="double"/>
      <output id="sec-hr-statutory_o2" label="ESI employee %" name="esiEmployeePct" typeRef="double"/>
      <output id="sec-hr-statutory_o3" label="ESI employer %" name="esiEmployerPct" typeRef="double"/>
      <output id="sec-hr-statutory_o4" label="PF wage ceiling" name="pfWageCeiling" typeRef="double"/>
      <output id="sec-hr-statutory_o5" label="ESI wage limit" name="esiWageLimit" typeRef="double"/>
      <rule id="sec-hr-statutory_r0"><description>PF ceiling Rs 15,000; ESI limit Rs 21,000 (verify)</description>
        <inputEntry id="sec-hr-statutory_r0_i0"><text>-</text></inputEntry>
        <outputEntry id="sec-hr-statutory_r0_o0"><text>12</text></outputEntry>
        <outputEntry id="sec-hr-statutory_r0_o1"><text>12</text></outputEntry>
        <outputEntry id="sec-hr-statutory_r0_o2"><text>0.75</text></outputEntry>
        <outputEntry id="sec-hr-statutory_r0_o3"><text>3.25</text></outputEntry>
        <outputEntry id="sec-hr-statutory_r0_o4"><text>15000</text></outputEntry>
        <outputEntry id="sec-hr-statutory_r0_o5"><text>21000</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
