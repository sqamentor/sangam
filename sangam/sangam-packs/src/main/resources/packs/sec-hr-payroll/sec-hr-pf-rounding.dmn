<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_sec_hr_pf_rounding" name="PF contribution rounding (EPF Scheme) (decision 139 rounding policy)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <!-- Decision 139 rounding policy, generated from tools/packgen/rounding.py -->
  <decision id="sec-hr-pf-rounding" name="PF contribution rounding (EPF Scheme) (decision 139 rounding policy)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.2">
    <decisionTable id="sec-hr-pf-rounding_t" hitPolicy="UNIQUE">
      <input id="sec-hr-pf-rounding_i0" label="As of"><inputExpression id="sec-hr-pf-rounding_ie0" typeRef="date"><text>date(asOfDate)</text></inputExpression></input>
      <output id="sec-hr-pf-rounding_o0" label="Policy" name="policyId" typeRef="string"/>
      <output id="sec-hr-pf-rounding_o1" label="Policy version" name="policyVersion" typeRef="string"/>
      <output id="sec-hr-pf-rounding_o2" label="Evidence (VERIFIED / UNVERIFIED)" name="evidenceStatus" typeRef="string"/>
      <output id="sec-hr-pf-rounding_o3" label="Permitted use (PRODUCTION / SYNTHETIC_DEMO_ONLY)" name="permittedUse" typeRef="string"/>
      <output id="sec-hr-pf-rounding_o4" label="Why this evidence status and use" name="evidenceNote" typeRef="string"/>
      <output id="sec-hr-pf-rounding_o5" label="Rounding mode" name="mode" typeRef="string"/>
      <output id="sec-hr-pf-rounding_o6" label="Rounding unit (minor units)" name="quantumMinor" typeRef="number"/>
      <output id="sec-hr-pf-rounding_o7" label="Negative amounts" name="negatives" typeRef="string"/>
      <output id="sec-hr-pf-rounding_o8" label="Instalment that takes the remainder" name="residual" typeRef="string"/>
      <output id="sec-hr-pf-rounding_o9" label="Applied to" name="application" typeRef="string"/>
      <output id="sec-hr-pf-rounding_o10" label="Stage" name="stage" typeRef="string"/>
      <output id="sec-hr-pf-rounding_o11" label="Jurisdiction" name="jurisdiction" typeRef="string"/>
      <output id="sec-hr-pf-rounding_o12" label="Scheme" name="scheme" typeRef="string"/>
      <output id="sec-hr-pf-rounding_o13" label="Purpose" name="purpose" typeRef="string"/>
      <output id="sec-hr-pf-rounding_o14" label="Source" name="source" typeRef="string"/>
      <output id="sec-hr-pf-rounding_o15" label="Provision" name="provision" typeRef="string"/>
      <output id="sec-hr-pf-rounding_o16" label="Effective from" name="effectiveFrom" typeRef="string"/>
      <output id="sec-hr-pf-rounding_o17" label="Effective to" name="effectiveTo" typeRef="string"/>
      <rule id="sec-hr-pf-rounding_r0"><description>UNVERIFIED SYNTHETIC_DEMO_ONLY epf-2026-18-5</description>
        <inputEntry id="sec-hr-pf-rounding_r0_i0"><text>[date("2026-06-29")..date("9999-12-31")]</text></inputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o0"><text>"sec-hr-pf-rounding"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o1"><text>"epf-2026-18-5"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o2"><text>"UNVERIFIED"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o3"><text>"SYNTHETIC_DEMO_ONLY"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o4"><text>"UNVERIFIED, SYNTHETIC_DEMO_ONLY (decisions 288, 294): EPF Scheme 2026 para 18(5) was read and matches the rounding as implemented (sangam-handoff evidence/STATUTORY-EVIDENCE-288.md section 1), but the scheme is in force on the date of its publication and that date is open: the Gazette issue (No. 473) is dated 29 June 2026, the e-Gazette copy was signed and uploaded on 1 July 2026 00:40 IST; the row stays UNVERIFIED until the owner or counsel confirms which date applies. Para 18(4) works on the wages of the month: a wage period that is not a calendar month is refused (decision 293)"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o5"><text>"HALF_UP"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o6"><text>100</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o7"><text>"REFUSE"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o8"><text>""</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o9"><text>"each contribution (employee share, employer share) separately"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o10"><text>"per employee per calendar month (para 18(4); decision 293)"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o11"><text>"IN"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o12"><text>"EPF Scheme 2026"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o13"><text>"provident fund contribution"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o14"><text>"Employees' Provident Funds Scheme, 2026, G.S.R. 525(E) of 29 June 2026, Gazette of India Extraordinary Part II Sec 3(i) No. 473 (masthead 29 June 2026; e-Gazette signed and uploaded 1 July 2026 00:40 IST), in force on publication (para 1(2)); read, sangam-handoff evidence/STATUTORY-EVIDENCE-288.md section 1"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o15"><text>"para 18(5) (read): each contribution calculated to the nearest rupee, fifty paise or more counted as the next higher rupee and a fraction below fifty paise ignored"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o16"><text>"2026-06-29"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o17"><text>"9999-12-31"</text></outputEntry>
      </rule>
      <rule id="sec-hr-pf-rounding_r1"><description>UNVERIFIED SYNTHETIC_DEMO_ONLY epf-1952-unverified</description>
        <inputEntry id="sec-hr-pf-rounding_r1_i0"><text>[date("1900-01-01")..date("2026-06-28")]</text></inputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o0"><text>"sec-hr-pf-rounding"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o1"><text>"epf-1952-unverified"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o2"><text>"UNVERIFIED"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o3"><text>"SYNTHETIC_DEMO_ONLY"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o4"><text>"UNVERIFIED, SYNTHETIC_DEMO_ONLY (decision 288): a real rule whose cited primary text was not read or checked against the rounding as implemented; not a production rule until it is"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o5"><text>"HALF_UP"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o6"><text>100</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o7"><text>"REFUSE"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o8"><text>""</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o9"><text>"each contribution separately"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o10"><text>"per employee per wage period"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o11"><text>"IN"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o12"><text>"EPF Scheme 1952 (period before 29 June 2026)"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o13"><text>"provident fund contribution"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o14"><text>"EPF Scheme 1952: the rounding provision was not identified or read"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o15"><text>"not identified (nearest rupee assumed as for the 2026 row)"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o16"><text>"1900-01-01"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o17"><text>"2026-06-28"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
