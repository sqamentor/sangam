      <bpmndi:BPMNEdge id="sec_ushealth_p2p_request_f1_di" bpmnElement="sec_ushealth_p2p_request_f1"><di:waypoint x="88" y="70"/><di:waypoint x="185" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sec_ushealth_p2p_request_f2_di" bpmnElement="sec_ushealth_p2p_request_f2"><di:waypoint x="285" y="70"/><di:waypoint x="350" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sec_ushealth_p2p_request_f3_di" bpmnElement="sec_ushealth_p2p_request_f3"><di:waypoint x="450" y="70"/><di:waypoint x="540" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sec_ushealth_p2p_request_f4_di" bpmnElement="sec_ushealth_p2p_request_f4"><di:waypoint x="590" y="70"/><di:waypoint x="651" y="70"/><di:waypoint x="651" y="195"/><di:waypoint x="712" y="195"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sec_ushealth_p2p_request_f5_di" bpmnElement="sec_ushealth_p2p_request_f5"><di:waypoint x="780" y="70"/><di:waypoint x="845" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sec_ushealth_p2p_request_f6_di" bpmnElement="sec_ushealth_p2p_request_f6"><di:waypoint x="590" y="70"/><di:waypoint x="680" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="sec_ushealth_p2p_request_f7_di" bpmnElement="sec_ushealth_p2p_request_f7"><di:waypoint x="945" y="70"/><di:waypoint x="1035" y="70"/></bpmndi:BPMNEdge>
