<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- Payer-to-Payer: request data from the previous payer. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_sec_ushealth_p2p_request" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_cancelCase" name="sangam.cancelCase"/>
  <message id="msg_sangam_ushealth_p2pDataReady" name="sangam.ushealth.p2pDataReady"/>
  <message id="msg_sangam_withdrawCase" name="sangam.withdrawCase"/>
  <process id="sangam-sec-ushealth-p2p-request" name="Payer-to-Payer: request data from the previous payer" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.ushealth.payer-to-payer</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>memberId,previousPayerId,p2pOptIn</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="pq_start" name="New member enrolled" operaton:initiator="initiator" operaton:formKey="sangam:sec-ushealth-payer-to-payer/enrol"></startEvent>
    <serviceTask id="pq_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>patientName=@customerId;memberId=@customerId;payerProgram=MA;previousPayerId=SIMPAYER;p2pOptIn=false;interopSeat=INTEROP-ANALYST;memberSeat=MEMBER-SERVICES</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="pq_cfg" name="Payer API timeframes (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-ushealth-p2p-config</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <exclusiveGateway id="pq_optGw" name="Patient opted in?" default="sec_ushealth_p2p_request_f4"></exclusiveGateway>
    <endEvent id="pq_endNoOptIn" name="No opt-in: nothing requested"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>NOT_OPTED_IN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="pq_match_clear" name="Clear the previous check result" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>matchPatientId=null</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="pq_match" name="Member match at the previous payer ($member-match)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>payer.memberMatch</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>match</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>memberId,previousPayerId,previousMemberId,patientName</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>match</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="pq_matchGw" name="Member matched?" default="sec_ushealth_p2p_request_f10"></exclusiveGateway>
    <userTask id="pq_matchHold" name="No confirmed member match: correct the member data" operaton:candidateGroups="${memberSeat}" operaton:formKey="sangam:sec-ushealth-payer-to-payer/matchHold"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="pq_deadline" name="Regulatory clock: p2pResponse" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>p2pResponse</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${p2pResponseSpec}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <serviceTask id="pq_request_clear" name="Clear the previous check result" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>p2pDataBundleRef=null</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="pq_request" name="Request the member data of the look-back period (Bulk Data)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>payer.p2pData</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>request</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>matchPatientId,previousPayerId,p2pLookback</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>p2pData</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="pq_dataGw" name="Data received?" default="sec_ushealth_p2p_request_f23"></exclusiveGateway>
    <eventBasedGateway id="pq_wait" name="Data ready, or the response time passed"></eventBasedGateway>
    <intermediateCatchEvent id="pq_ready" name="Data ready at the previous payer"><messageEventDefinition messageRef="msg_sangam_ushealth_p2pDataReady"/></intermediateCatchEvent>
    <intermediateCatchEvent id="pq_late" name="Response time passed"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${p2pResponseDueAt}</timeDate></timerEventDefinition></intermediateCatchEvent>
    <userTask id="pq_chase" name="Previous payer did not answer in time: chase or close" operaton:candidateGroups="${interopSeat}" operaton:formKey="sangam:sec-ushealth-payer-to-payer/chase"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>chaseDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="pq_chaseGw" name="" default="sec_ushealth_p2p_request_f21"></exclusiveGateway>
    <endEvent id="pq_endUnanswered" name="Closed: no data received"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>NOT_RECEIVED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="pq_store_clear" name="Clear the previous check result" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>storeRecordRef=null</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="pq_store" name="Store the received data in the member record" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>payer.memberRecord</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>ingest</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>memberId,p2pDataBundleRef</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>store</operaton:string></operaton:field><operaton:field name="step"><operaton:string>p2p-store</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="pq_storeGw" name="Stored?" default="sec_ushealth_p2p_request_f27"></exclusiveGateway>
    <userTask id="pq_storeHold" name="Storing the received data not confirmed: check the member record" operaton:candidateGroups="${interopSeat}" operaton:formKey="sangam:sec-ushealth-payer-to-payer/storeHold"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <endEvent id="pq_end" name="Data received and stored"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>RECEIVED</operaton:string></operaton:field><operaton:field name="dataVars"><operaton:string>['storeRecordRef']</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <sequenceFlow id="sec_ushealth_p2p_request_f1" sourceRef="pq_start" targetRef="pq_defaults"/>
    <sequenceFlow id="sec_ushealth_p2p_request_f2" sourceRef="pq_defaults" targetRef="pq_cfg"/>
    <sequenceFlow id="sec_ushealth_p2p_request_f3" sourceRef="pq_cfg" targetRef="pq_optGw"/>
    <sequenceFlow id="sec_ushealth_p2p_request_f4" name="not opted in" sourceRef="pq_optGw" targetRef="pq_endNoOptIn"/>
    <sequenceFlow id="sec_ushealth_p2p_request_f5" sourceRef="pq_match_clear" targetRef="pq_match"/>
    <sequenceFlow id="sec_ushealth_p2p_request_f6" name="opted in" sourceRef="pq_optGw" targetRef="pq_match_clear"><conditionExpression xsi:type="tFormalExpression">${p2pOptIn == true}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ushealth_p2p_request_f7" sourceRef="pq_match" targetRef="pq_matchGw"/>
    <sequenceFlow id="sec_ushealth_p2p_request_f8" sourceRef="pq_matchHold" targetRef="pq_match_clear"/>
    <sequenceFlow id="sec_ushealth_p2p_request_f9" name="not matched" sourceRef="pq_matchGw" targetRef="pq_matchHold"><conditionExpression xsi:type="tFormalExpression">${matchStatus != 'COMPLETED' || matchPatientId == null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ushealth_p2p_request_f10" name="matched" sourceRef="pq_matchGw" targetRef="pq_deadline"/>
    <sequenceFlow id="sec_ushealth_p2p_request_f11" sourceRef="pq_request_clear" targetRef="pq_request"/>
    <sequenceFlow id="sec_ushealth_p2p_request_f12" sourceRef="pq_deadline" targetRef="pq_request_clear"/>
    <sequenceFlow id="sec_ushealth_p2p_request_f13" sourceRef="pq_request" targetRef="pq_dataGw"/>
    <sequenceFlow id="sec_ushealth_p2p_request_f14" name="not received yet" sourceRef="pq_dataGw" targetRef="pq_wait"><conditionExpression xsi:type="tFormalExpression">${p2pDataStatus != 'COMPLETED' || p2pDataBundleRef == null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ushealth_p2p_request_f15" sourceRef="pq_wait" targetRef="pq_ready"/>
    <sequenceFlow id="sec_ushealth_p2p_request_f16" sourceRef="pq_wait" targetRef="pq_late"/>
    <sequenceFlow id="sec_ushealth_p2p_request_f17" sourceRef="pq_ready" targetRef="pq_request_clear"/>
    <sequenceFlow id="sec_ushealth_p2p_request_f18" sourceRef="pq_late" targetRef="pq_chase"/>
    <sequenceFlow id="sec_ushealth_p2p_request_f19" sourceRef="pq_chase" targetRef="pq_chaseGw"/>
    <sequenceFlow id="sec_ushealth_p2p_request_f20" name="retry" sourceRef="pq_chaseGw" targetRef="pq_request_clear"><conditionExpression xsi:type="tFormalExpression">${chaseDecision == 'retry'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ushealth_p2p_request_f21" name="close" sourceRef="pq_chaseGw" targetRef="pq_endUnanswered"/>
    <sequenceFlow id="sec_ushealth_p2p_request_f22" sourceRef="pq_store_clear" targetRef="pq_store"/>
    <sequenceFlow id="sec_ushealth_p2p_request_f23" name="received" sourceRef="pq_dataGw" targetRef="pq_store_clear"/>
    <sequenceFlow id="sec_ushealth_p2p_request_f24" sourceRef="pq_store" targetRef="pq_storeGw"/>
    <sequenceFlow id="sec_ushealth_p2p_request_f25" sourceRef="pq_storeHold" targetRef="pq_store_clear"/>
    <sequenceFlow id="sec_ushealth_p2p_request_f26" name="not confirmed" sourceRef="pq_storeGw" targetRef="pq_storeHold"><conditionExpression xsi:type="tFormalExpression">${storeStatus != 'COMPLETED' || storeRecordRef == null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ushealth_p2p_request_f27" name="stored" sourceRef="pq_storeGw" targetRef="pq_end"/>
    <subProcess id="pq_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="pq_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="pq_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="pq_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.1"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="pq_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="sec_ushealth_p2p_request_f28" sourceRef="pq_withdrawStart" targetRef="pq_withdrawKind"/>
      <sequenceFlow id="sec_ushealth_p2p_request_f29" sourceRef="pq_withdrawKind" targetRef="pq_withdrawCall"/>
      <sequenceFlow id="sec_ushealth_p2p_request_f30" sourceRef="pq_withdrawCall" targetRef="pq_withdrawEnd"/>
    </subProcess>
    <subProcess id="pq_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="pq_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="pq_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="pq_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.1"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="pq_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="sec_ushealth_p2p_request_f31" sourceRef="pq_cancelStart" targetRef="pq_cancelKind"/>
      <sequenceFlow id="sec_ushealth_p2p_request_f32" sourceRef="pq_cancelKind" targetRef="pq_cancelCall"/>
      <sequenceFlow id="sec_ushealth_p2p_request_f33" sourceRef="pq_cancelCall" targetRef="pq_cancelEnd"/>
    </subProcess>
  </process>
  <bpmndi:BPMNDiagram id="sec_ushealth_p2p_request_diagram">
    <bpmndi:BPMNPlane id="sec_ushealth_p2p_request_plane" bpmnElement="sangam-sec-ushealth-p2p-request">
      <bpmndi:BPMNShape id="pq_start_di" bpmnElement="pq_start"><dc:Bounds x="52" y="52" width="36" height="36"/></bpmndi:BPMNShape>
