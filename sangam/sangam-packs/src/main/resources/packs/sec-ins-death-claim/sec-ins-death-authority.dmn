<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_sec_ins_death_authority" name="Death claim authority" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <!-- SYNTHETIC bands; replace with the board policy. -->
  <decision id="sec-ins-death-authority" name="Death claim authority" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="sec-ins-death-authority_t" hitPolicy="FIRST">
      <input id="sec-ins-death-authority_i0" label="Amount (INR)"><inputExpression id="sec-ins-death-authority_ie0" typeRef="double"><text>amount</text></inputExpression></input>
      <output id="sec-ins-death-authority_o0" label="Competent role" name="competentRole" typeRef="string"/>
      <rule id="sec-ins-death-authority_r0">
        <inputEntry id="sec-ins-death-authority_r0_i0"><text>&lt;= 2500000</text></inputEntry>
        <outputEntry id="sec-ins-death-authority_r0_o0"><text>"CLAIMSMGR"</text></outputEntry>
      </rule>
      <rule id="sec-ins-death-authority_r1">
        <inputEntry id="sec-ins-death-authority_r1_i0"><text>-</text></inputEntry>
        <outputEntry id="sec-ins-death-authority_r1_o0"><text>"CLAIMSHEAD"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
