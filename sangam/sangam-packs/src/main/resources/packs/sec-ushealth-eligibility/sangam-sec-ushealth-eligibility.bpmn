<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- Eligibility and benefits. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_sec_ushealth_eligibility" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_cancelCase" name="sangam.cancelCase"/>
  <message id="msg_sangam_withdrawCase" name="sangam.withdrawCase"/>
  <process id="sangam-sec-ushealth-eligibility" name="Eligibility and benefits" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.ushealth.eligibility</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>patientName,memberId,payerId</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="el_start" name="Patient registered" operaton:initiator="initiator" operaton:formKey="sangam:sec-ushealth-eligibility/register"></startEvent>
    <serviceTask id="el_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>patientName=@customerId;memberId=@customerId;payerId=SIMPAYER;providerNpi=1234567893;serviceTypes=30;visitType=SCHEDULED;eligEligibility=ACTIVE;npiStatus=COMPLETED;edSeat=ED-PHYSICIAN;regSeat=PATIENT-ACCESS;finSeat=FINANCIAL-COUNSELOR</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="el_cfg" name="Eligibility policy (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-ushealth-eligibility-config</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <exclusiveGateway id="el_erGw" name="Emergency arrival?" default="sec_ushealth_eligibility_f5"></exclusiveGateway>
    <userTask id="el_mse" name="Medical screening examination and stabilisation (no payment inquiry first)" operaton:candidateGroups="${edSeat}" operaton:formKey="sangam:sec-ushealth-eligibility/mse" operaton:priority="95"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="el_npi" name="Check provider NPI (NPPES)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>npi.registry</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>lookup</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>providerNpi</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>npi</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="el_270" name="Eligibility inquiry 270 / response 271" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>x12.eligibility</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>eligibility</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>memberId,payerId,providerNpi,serviceTypes,patientName</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>elig</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="el_resultGw" name="Coverage?" default="sec_ushealth_eligibility_f13"></exclusiveGateway>
    <userTask id="el_review" name="Review benefits and estimate patient responsibility" operaton:candidateGroups="${regSeat}" operaton:formKey="sangam:sec-ushealth-eligibility/review"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <endEvent id="el_end" name="Coverage verified"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <intermediateCatchEvent id="el_wait" name="Payer unavailable: retry later"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">${eligRetryAfter}</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <userTask id="el_resolve" name="Resolve coverage: correct data, other coverage, self-pay" operaton:candidateGroups="${finSeat}" operaton:formKey="sangam:sec-ushealth-eligibility/resolve"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>coverageDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="el_resolveGw" name="" default="sec_ushealth_eligibility_f16"></exclusiveGateway>
    <endEvent id="el_endSelf" name="Self-pay: good-faith estimate due"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SELF_PAY</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <sequenceFlow id="sec_ushealth_eligibility_f1" sourceRef="el_start" targetRef="el_defaults"/>
    <sequenceFlow id="sec_ushealth_eligibility_f2" sourceRef="el_defaults" targetRef="el_cfg"/>
    <sequenceFlow id="sec_ushealth_eligibility_f3" sourceRef="el_cfg" targetRef="el_erGw"/>
    <sequenceFlow id="sec_ushealth_eligibility_f4" name="emergency (EMTALA)" sourceRef="el_erGw" targetRef="el_mse"><conditionExpression xsi:type="tFormalExpression">${visitType == 'EMERGENCY'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ushealth_eligibility_f5" name="scheduled" sourceRef="el_erGw" targetRef="el_npi"/>
    <sequenceFlow id="sec_ushealth_eligibility_f6" sourceRef="el_mse" targetRef="el_npi"/>
    <sequenceFlow id="sec_ushealth_eligibility_f7" sourceRef="el_npi" targetRef="el_270"/>
    <sequenceFlow id="sec_ushealth_eligibility_f8" sourceRef="el_270" targetRef="el_resultGw"/>
    <sequenceFlow id="sec_ushealth_eligibility_f9" name="active" sourceRef="el_resultGw" targetRef="el_review"><conditionExpression xsi:type="tFormalExpression">${eligEligibility == 'ACTIVE'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ushealth_eligibility_f10" sourceRef="el_review" targetRef="el_end"/>
    <sequenceFlow id="sec_ushealth_eligibility_f11" name="no answer" sourceRef="el_resultGw" targetRef="el_wait"><conditionExpression xsi:type="tFormalExpression">${eligStatus == 'UNKNOWN' || eligStatus == 'PENDING'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ushealth_eligibility_f12" sourceRef="el_wait" targetRef="el_270"/>
    <sequenceFlow id="sec_ushealth_eligibility_f13" name="inactive / rejected (AAA)" sourceRef="el_resultGw" targetRef="el_resolve"/>
    <sequenceFlow id="sec_ushealth_eligibility_f14" sourceRef="el_resolve" targetRef="el_resolveGw"/>
    <sequenceFlow id="sec_ushealth_eligibility_f15" name="re-check" sourceRef="el_resolveGw" targetRef="el_270"><conditionExpression xsi:type="tFormalExpression">${coverageDecision != 'selfPay'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ushealth_eligibility_f16" name="self-pay" sourceRef="el_resolveGw" targetRef="el_endSelf"/>
    <subProcess id="el_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="el_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="el_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="el_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="el_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="sec_ushealth_eligibility_f17" sourceRef="el_withdrawStart" targetRef="el_withdrawKind"/>
      <sequenceFlow id="sec_ushealth_eligibility_f18" sourceRef="el_withdrawKind" targetRef="el_withdrawCall"/>
      <sequenceFlow id="sec_ushealth_eligibility_f19" sourceRef="el_withdrawCall" targetRef="el_withdrawEnd"/>
    </subProcess>
    <subProcess id="el_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="el_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="el_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="el_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="el_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="sec_ushealth_eligibility_f20" sourceRef="el_cancelStart" targetRef="el_cancelKind"/>
      <sequenceFlow id="sec_ushealth_eligibility_f21" sourceRef="el_cancelKind" targetRef="el_cancelCall"/>
      <sequenceFlow id="sec_ushealth_eligibility_f22" sourceRef="el_cancelCall" targetRef="el_cancelEnd"/>
    </subProcess>
  </process>
