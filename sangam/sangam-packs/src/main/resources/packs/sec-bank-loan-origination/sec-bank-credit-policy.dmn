<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_sec_bank_credit_policy" name="Credit policy (SYNTHETIC)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="sec-bank-credit-policy" name="Credit policy (SYNTHETIC)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="sec-bank-credit-policy_t" hitPolicy="FIRST">
      <input id="sec-bank-credit-policy_i0" label="Bureau score"><inputExpression id="sec-bank-credit-policy_ie0" typeRef="integer"><text>bureauScore</text></inputExpression></input>
      <input id="sec-bank-credit-policy_i1" label="FOIR %"><inputExpression id="sec-bank-credit-policy_ie1" typeRef="number"><text>foirPct</text></inputExpression></input>
      <output id="sec-bank-credit-policy_o0" label="Decision" name="creditDecision" typeRef="string"/>
      <output id="sec-bank-credit-policy_o1" label="KFS validity" name="kfsValidity" typeRef="string"/>
      <rule id="sec-bank-credit-policy_r0"><description>score below cut-off</description>
        <inputEntry id="sec-bank-credit-policy_r0_i0"><text>&lt; 650</text></inputEntry>
        <inputEntry id="sec-bank-credit-policy_r0_i1"><text>-</text></inputEntry>
        <outputEntry id="sec-bank-credit-policy_r0_o0"><text>"DECLINE"</text></outputEntry>
        <outputEntry id="sec-bank-credit-policy_r0_o1"><text>"3WD"</text></outputEntry>
      </rule>
      <rule id="sec-bank-credit-policy_r1"><description>FOIR above 60%</description>
        <inputEntry id="sec-bank-credit-policy_r1_i0"><text>-</text></inputEntry>
        <inputEntry id="sec-bank-credit-policy_r1_i1"><text>&gt; 60</text></inputEntry>
        <outputEntry id="sec-bank-credit-policy_r1_o0"><text>"DECLINE"</text></outputEntry>
        <outputEntry id="sec-bank-credit-policy_r1_o1"><text>"3WD"</text></outputEntry>
      </rule>
      <rule id="sec-bank-credit-policy_r2">
        <inputEntry id="sec-bank-credit-policy_r2_i0"><text>&gt;= 750</text></inputEntry>
        <inputEntry id="sec-bank-credit-policy_r2_i1"><text>&lt;= 50</text></inputEntry>
        <outputEntry id="sec-bank-credit-policy_r2_o0"><text>"ELIGIBLE"</text></outputEntry>
        <outputEntry id="sec-bank-credit-policy_r2_o1"><text>"3WD"</text></outputEntry>
      </rule>
      <rule id="sec-bank-credit-policy_r3"><description>manual appraisal; KFS valid 3 working days (tenor 7 days or more)</description>
        <inputEntry id="sec-bank-credit-policy_r3_i0"><text>-</text></inputEntry>
        <inputEntry id="sec-bank-credit-policy_r3_i1"><text>-</text></inputEntry>
        <outputEntry id="sec-bank-credit-policy_r3_o0"><text>"REFER"</text></outputEntry>
        <outputEntry id="sec-bank-credit-policy_r3_o1"><text>"3WD"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
