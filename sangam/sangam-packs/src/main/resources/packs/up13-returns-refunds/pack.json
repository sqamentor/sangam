{
  "id": "universal.up13-returns-refunds",
  "version": "1.0.2",
  "name": {
    "en": "UP-13 Returns, refunds and partial fulfilment",
    "hi": "यूपी-13 वापसी, धनवापसी एवं आंशिक पूर्ति"
  },
  "domain": "Universal",
  "description": "Return eligibility by policy, pickup, inspection of the returned quantity, partial refund computed on the accepted quantity and paid once by operationId (R36).",
  "mainProcesses": [
    "sangam-up13-returns"
  ],
  "resources": [
    {
      "kind": "BPMN",
      "path": "packs/up13-returns-refunds/sangam-up13-returns.bpmn"
    },
    {
      "kind": "DMN",
      "path": "packs/up13-returns-refunds/up13-refund-rounding.dmn"
    },
    {
      "kind": "DMN",
      "path": "packs/up13-returns-refunds/up13-policy.dmn"
    },
    {
      "kind": "FORM",
      "path": "packs/up13-returns-refunds/forms/request.form.json"
    },
    {
      "kind": "FORM",
      "path": "packs/up13-returns-refunds/forms/inspect.form.json"
    },
    {
      "kind": "SEED",
      "path": "packs/up13-returns-refunds/seed.json"
    },
    {
      "kind": "OTHER",
      "path": "packs/up13-returns-refunds/pack.json"
    }
  ],
  "seed": "packs/up13-returns-refunds/seed.json",
  "connectors": [
    {
      "id": "shipping.pickup",
      "moneyMovement": "NONE",
      "capabilityClass": "a",
      "govTag": "",
      "purpose": "Pickup"
    },
    {
      "id": "payment.refund",
      "moneyMovement": "OUT",
      "capabilityClass": "a",
      "govTag": "",
      "purpose": "Refund",
      "simulatorBinding": {
        "connector": "payment-gateway-sim",
        "operation": "createOrder"
      }
    }
  ],
  "covers": [
    "UP-13",
    "R36",
    "GP-13",
    "GP-12"
  ],
  "acceptance": [],
  "dependsOn": [
    "sangam.core"
  ],
  "tenantOverrides": [],
  "calls": [
    "sangam-core-execution"
  ],
  "placeholders": [
    {
      "decision": "up13-refund-rounding",
      "rule": "SYNTHETIC refund rounding: nearest paisa",
      "reason": "refund rounding is the tenant's business policy (or its payment provider's); deploy it as a tenant override (decision 139)"
    }
  ],
  "money": {
    "unit": "MINOR",
    "currency": "INR",
    "exponent": 2,
    "variables": [
      "refundAmount"
    ]
  },
  "documentSlots": [
    {
      "documentType": "SANCTION_NOTE",
      "slot": "sanctionDocumentId"
    }
  ],
  "currency": "INR",
  "powers": {
    "u13_refund_sanction": {
      "monetary": true,
      "currency": "INR",
      "limitTable": "sangam-core-powers",
      "ruleCaseType": "GENERAL"
    }
  }
}
