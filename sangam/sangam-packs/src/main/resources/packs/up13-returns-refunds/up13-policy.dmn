<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_up13_policy" name="Return policy" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="up13-policy" name="Return policy" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="up13-policy_t" hitPolicy="FIRST">
      <input id="up13-policy_i0" label="Category"><inputExpression id="up13-policy_ie0" typeRef="string"><text>category</text></inputExpression></input>
      <output id="up13-policy_o0" label="Eligible" name="returnEligible" typeRef="boolean"/>
      <output id="up13-policy_o1" label="Restocking fee %" name="restockingFeePct" typeRef="double"/>
      <rule id="up13-policy_r0">
        <inputEntry id="up13-policy_r0_i0"><text>"PERISHABLE"</text></inputEntry>
        <outputEntry id="up13-policy_r0_o0"><text>false</text></outputEntry>
        <outputEntry id="up13-policy_r0_o1"><text>0</text></outputEntry>
      </rule>
      <rule id="up13-policy_r1">
        <inputEntry id="up13-policy_r1_i0"><text>"ELECTRONICS"</text></inputEntry>
        <outputEntry id="up13-policy_r1_o0"><text>true</text></outputEntry>
        <outputEntry id="up13-policy_r1_o1"><text>10</text></outputEntry>
      </rule>
      <rule id="up13-policy_r2">
        <inputEntry id="up13-policy_r2_i0"><text>-</text></inputEntry>
        <outputEntry id="up13-policy_r2_o0"><text>true</text></outputEntry>
        <outputEntry id="up13-policy_r2_o1"><text>0</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
