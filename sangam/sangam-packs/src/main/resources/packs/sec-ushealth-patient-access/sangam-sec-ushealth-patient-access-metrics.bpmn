      <bpmndi:BPMNShape id="pm_withdrawStart_di" bpmnElement="pm_withdrawStart"><dc:Bounds x="92" y="347" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pm_withdrawKind_di" bpmnElement="pm_withdrawKind"><dc:Bounds x="225" y="325" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pm_withdrawCall_di" bpmnElement="pm_withdrawCall"><dc:Bounds x="390" y="325" width="100" height="80"/></bpmndi:BPMNShape>
