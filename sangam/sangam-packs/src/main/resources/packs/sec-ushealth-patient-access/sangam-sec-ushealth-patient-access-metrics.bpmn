      <bpmndi:BPMNShape id="pm_cancel_di" bpmnElement="pm_cancel" isExpanded="true"><dc:Bounds x="30" y="475" width="623" height="150"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="pm_cancelStart_di" bpmnElement="pm_cancelStart"><dc:Bounds x="92" y="537" width="36" height="36"/></bpmndi:BPMNShape>
