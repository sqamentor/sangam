<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- Patient Access API: prior authorization information. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_sec_ushealth_patient_acc" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.2">
  <message id="msg_sangam_cancelCase" name="sangam.cancelCase"/>
  <message id="msg_sangam_withdrawCase" name="sangam.withdrawCase"/>
  <process id="sangam-sec-ushealth-patient-access-pa" name="Patient Access API: prior authorization information" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.2">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.ushealth.patient-access</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.2</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>memberId,priorAuthNumber,itemCategory</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="pt_start" name="Prior authorization request or status change received" operaton:initiator="initiator" operaton:formKey="sangam:sec-ushealth-patient-access/pa-change"></startEvent>
    <serviceTask id="pt_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>patientName=@customerId;memberId=@customerId;payerProgram=MA;priorAuthNumber=@customerId;itemCategory=UNCLASSIFIED;paStatus=NOT_STATED;interopSeat=INTEROP-ANALYST;memberSeat=MEMBER-SERVICES</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="pt_cfg" name="Patient Access API scope and timeframes (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-ushealth-patient-access-config</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <exclusiveGateway id="pt_scopeGw" name="Part of the prior authorization information?" default="sec_ushealth_patient_acc_f7"></exclusiveGateway>
    <endEvent id="pt_endExcluded" name="Drug: not part of the prior authorization information"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>NOT_IN_SCOPE</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="pt_deadline" name="Regulatory clock: paPublish" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>paPublish</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${paPublishSpec}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <userTask id="pt_classifyHold" name="Item category or status not stated: classify before anything is published" operaton:candidateGroups="${memberSeat}" operaton:formKey="sangam:sec-ushealth-patient-access/classifyHold"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="pt_publish_clear" name="Clear the previous check result" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>publishRecordRef=null</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="pt_publish" name="Make the prior authorization information available (Patient Access API)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>payer.patientAccess</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>publish</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>memberId,priorAuthNumber,paStatus,paRetentionSpec</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>publish</operaton:string></operaton:field><operaton:field name="step"><operaton:string>pa-publish</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="pt_publishGw" name="Available to the patient?" default="sec_ushealth_patient_acc_f13"></exclusiveGateway>
    <userTask id="pt_publishHold" name="Publication not confirmed: check the Patient Access API" operaton:candidateGroups="${interopSeat}" operaton:formKey="sangam:sec-ushealth-patient-access/publishHold"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <endEvent id="pt_end" name="Prior authorization information available to the patient"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>PUBLISHED</operaton:string></operaton:field><operaton:field name="dataVars"><operaton:string>['publishRecordRef']</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <sequenceFlow id="sec_ushealth_patient_acc_f1" sourceRef="pt_start" targetRef="pt_defaults"/>
    <sequenceFlow id="sec_ushealth_patient_acc_f2" sourceRef="pt_defaults" targetRef="pt_cfg"/>
    <sequenceFlow id="sec_ushealth_patient_acc_f3" sourceRef="pt_cfg" targetRef="pt_scopeGw"/>
    <sequenceFlow id="sec_ushealth_patient_acc_f4" name="drug" sourceRef="pt_scopeGw" targetRef="pt_endExcluded"><conditionExpression xsi:type="tFormalExpression">${paScope == 'EXCLUDED_DRUG'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ushealth_patient_acc_f5" name="item or service" sourceRef="pt_scopeGw" targetRef="pt_deadline"><conditionExpression xsi:type="tFormalExpression">${paScope == 'IN_SCOPE' &amp;&amp; paStatus != 'NOT_STATED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ushealth_patient_acc_f6" sourceRef="pt_classifyHold" targetRef="pt_cfg"/>
    <sequenceFlow id="sec_ushealth_patient_acc_f7" name="not classified" sourceRef="pt_scopeGw" targetRef="pt_classifyHold"/>
    <sequenceFlow id="sec_ushealth_patient_acc_f8" sourceRef="pt_publish_clear" targetRef="pt_publish"/>
    <sequenceFlow id="sec_ushealth_patient_acc_f9" sourceRef="pt_deadline" targetRef="pt_publish_clear"/>
    <sequenceFlow id="sec_ushealth_patient_acc_f10" sourceRef="pt_publish" targetRef="pt_publishGw"/>
    <sequenceFlow id="sec_ushealth_patient_acc_f11" sourceRef="pt_publishHold" targetRef="pt_publish_clear"/>
    <sequenceFlow id="sec_ushealth_patient_acc_f12" name="not confirmed" sourceRef="pt_publishGw" targetRef="pt_publishHold"><conditionExpression xsi:type="tFormalExpression">${publishStatus != 'COMPLETED' || publishRecordRef == null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ushealth_patient_acc_f13" name="available" sourceRef="pt_publishGw" targetRef="pt_end"/>
    <subProcess id="pt_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="pt_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="pt_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="pt_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.3"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="pt_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="sec_ushealth_patient_acc_f14" sourceRef="pt_withdrawStart" targetRef="pt_withdrawKind"/>
      <sequenceFlow id="sec_ushealth_patient_acc_f15" sourceRef="pt_withdrawKind" targetRef="pt_withdrawCall"/>
      <sequenceFlow id="sec_ushealth_patient_acc_f16" sourceRef="pt_withdrawCall" targetRef="pt_withdrawEnd"/>
    </subProcess>
    <subProcess id="pt_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="pt_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="pt_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="pt_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.3"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="pt_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="sec_ushealth_patient_acc_f17" sourceRef="pt_cancelStart" targetRef="pt_cancelKind"/>
      <sequenceFlow id="sec_ushealth_patient_acc_f18" sourceRef="pt_cancelKind" targetRef="pt_cancelCall"/>
      <sequenceFlow id="sec_ushealth_patient_acc_f19" sourceRef="pt_cancelCall" targetRef="pt_cancelEnd"/>
    </subProcess>
  </process>
