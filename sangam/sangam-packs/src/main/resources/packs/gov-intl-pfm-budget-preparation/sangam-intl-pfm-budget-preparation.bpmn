  <message id="msg_sangam_withdrawCase" name="sangam.withdrawCase"/>
  <process id="sangam-intl-pfm-budget-preparation" name="Budget preparation" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.intl.pfm-budget-preparation</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>budgetYear,spendingUnit,circularRef</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="bp_start" name="Budget circular issued" operaton:initiator="initiator" operaton:formKey="sangam:gov-intl-pfm-budget-preparation/circular"></startEvent>
    <serviceTask id="bp_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>spendingUnit=SU-1;ledgerId=BUDGET;submitterSeat=SPENDING-UNIT;budgetOfficeSeat=BUDGET-OFFICE;executiveSeat=FINANCE-MINISTER</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="bp_cfg" name="Budget calendar (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>intl-pfm-budget-calendar</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <serviceTask id="bp_ceiling_clear" name="Clear the previous check result" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>ceilingAmount=null</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="bp_ceiling" name="Ceiling of the spending unit" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>ledger.ceilings</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>ceilings</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>ledgerId,budgetYear,spendingUnit</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>ceiling</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="bp_ceilingGw" name="Ceiling of the spending unit?" default="intl_pfm_budget_preparat_f16"></exclusiveGateway>
    <userTask id="bp_ceilingHold" name="Ceiling not confirmed: confirm it in the ledger" operaton:candidateGroups="${budgetOfficeSeat}" operaton:formKey="sangam:gov-intl-pfm-budget-preparation/ceilingHold"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="bp_submit_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>bp_submit</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${budgetSubmissionSpec}</operaton:expression></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="bp_submit" name="Prepare the budget submission within the ceiling" operaton:candidateGroups="${submitterSeat}" operaton:formKey="sangam:gov-intl-pfm-budget-preparation/submission" operaton:dueDate="${bp_submitDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="bp_submit_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>bp_submit</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>submitterSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="bp_submit_warnEnd" name="Warned"></endEvent>
    <serviceTask id="bp_submit_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>bp_submit</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>submitterSeat</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="bp_submit_breachGw" name="Deemed?" default="intl_pfm_budget_preparat_f13"></exclusiveGateway>
    <exclusiveGateway id="bp_submit_done" name=""></exclusiveGateway>
    <exclusiveGateway id="bp_overGw" name="Within the ceiling?" default="intl_pfm_budget_preparat_f27"></exclusiveGateway>
    <serviceTask id="bp_review_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>bp_review</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${budgetReviewSpec}</operaton:expression></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="bp_review" name="Review the submission (budget office)" operaton:candidateGroups="${budgetOfficeSeat}" operaton:formKey="sangam:gov-intl-pfm-budget-preparation/review" operaton:dueDate="${bp_reviewDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"><operaton:field name="steps"><operaton:string>bp_submit</operaton:string></operaton:field></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>reviewDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="bp_review_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>bp_review</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>budgetOfficeSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="bp_review_warnEnd" name="Warned"></endEvent>
    <serviceTask id="bp_review_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>bp_review</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>budgetOfficeSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>reviewDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="bp_review_breachGw" name="Deemed?" default="intl_pfm_budget_preparat_f24"></exclusiveGateway>
    <exclusiveGateway id="bp_review_done" name=""></exclusiveGateway>
    <exclusiveGateway id="bp_reviewGw" name="" default="intl_pfm_budget_preparat_f30"></exclusiveGateway>
    <userTask id="bp_executive" name="Executive approval of the budget proposal" operaton:candidateGroups="${executiveSeat}" operaton:formKey="sangam:gov-intl-pfm-budget-preparation/executive"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"><operaton:field name="steps"><operaton:string>bp_submit,bp_review</operaton:string></operaton:field></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>executiveDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="bp_executiveGw" name="" default="intl_pfm_budget_preparat_f33"></exclusiveGateway>
    <callActivity id="bp_bundle" name="Budget-document bundle (PFM-022)" calledElement="sangam-intl-pfm-budget-document-bundle"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <exclusiveGateway id="bp_bundleGw" name="Bundle complete?" default="intl_pfm_budget_preparat_f40"></exclusiveGateway>
    <serviceTask id="bp_legislature_clear" name="Clear the previous check result" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>legReceiptRef=null</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="bp_legislature" name="Submit the budget to the legislature" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>legislature.submit</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>budgetYear,spendingUnit,requestAmount</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>leg</operaton:string></operaton:field><operaton:field name="step"><operaton:string>legislature</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="bp_legislatureGw" name="Submit the budget to the legislature?" default="intl_pfm_budget_preparat_f41"></exclusiveGateway>
    <userTask id="bp_legislatureHold" name="Legislature receipt not confirmed: confirm and resend" operaton:candidateGroups="${budgetOfficeSeat}" operaton:formKey="sangam:gov-intl-pfm-budget-preparation/legislatureHold"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="bp_legClock" name="Regulatory clock: legislature" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>legislature</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${legislatureSpec}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <eventBasedGateway id="bp_wait" name="Enacted?"></eventBasedGateway>
    <intermediateCatchEvent id="bp_enactedMsg" name="Budget enacted"><messageEventDefinition messageRef="msg_sangam_pfm_budgetEnacted"/></intermediateCatchEvent>
    <intermediateCatchEvent id="bp_legLate" name="Legislature deadline passed"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${legislatureDueAt}</timeDate></timerEventDefinition></intermediateCatchEvent>
    <userTask id="bp_legFollowUp" name="Budget not yet enacted: follow up (interim authority per the profile)" operaton:candidateGroups="${budgetOfficeSeat}" operaton:formKey="sangam:gov-intl-pfm-budget-preparation/follow-up"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <userTask id="bp_record" name="Record the enacted appropriation" operaton:candidateGroups="${budgetOfficeSeat}" operaton:formKey="sangam:gov-intl-pfm-budget-preparation/enacted"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <endEvent id="bp_end" name="Budget enacted"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>ENACTED</operaton:string></operaton:field><operaton:field name="dataVars"><operaton:string>['appropriationActRef', 'enactedAmount', 'legReceiptRef']</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="bp_submit_warn" name="SLA warning (75%)" attachedToRef="bp_submit" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${bp_submitWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="bp_submit_breach" name="SLA breached" attachedToRef="bp_submit" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${bp_submitDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="bp_review_warn" name="SLA warning (75%)" attachedToRef="bp_review" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${bp_reviewWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="bp_review_breach" name="SLA breached" attachedToRef="bp_review" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${bp_reviewDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="intl_pfm_budget_preparat_f1" sourceRef="bp_ceiling_clear" targetRef="bp_ceiling"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f2" sourceRef="bp_ceiling" targetRef="bp_ceilingGw"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f3" sourceRef="bp_ceilingHold" targetRef="bp_ceiling_clear"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f4" name="not confirmed" sourceRef="bp_ceilingGw" targetRef="bp_ceilingHold"><conditionExpression xsi:type="tFormalExpression">${ceilingStatus != 'COMPLETED' || ceilingAmount == null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_budget_preparat_f5" sourceRef="bp_start" targetRef="bp_defaults"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f6" sourceRef="bp_defaults" targetRef="bp_cfg"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f7" sourceRef="bp_cfg" targetRef="bp_ceiling_clear"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f8" sourceRef="bp_submit_warn" targetRef="bp_submit_warnNotify"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f9" sourceRef="bp_submit_warnNotify" targetRef="bp_submit_warnEnd"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f10" sourceRef="bp_submit_breach" targetRef="bp_submit_breachAct"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f11" sourceRef="bp_submit_breachAct" targetRef="bp_submit_breachGw"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f12" name="deemed" sourceRef="bp_submit_breachGw" targetRef="bp_submit_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_budget_preparat_f13" name="escalated" sourceRef="bp_submit_breachGw" targetRef="bp_submit_slaPlan"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f14" sourceRef="bp_submit_slaPlan" targetRef="bp_submit"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f15" sourceRef="bp_submit" targetRef="bp_submit_done"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f16" name="confirmed" sourceRef="bp_ceilingGw" targetRef="bp_submit_slaPlan"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f17" sourceRef="bp_submit_done" targetRef="bp_overGw"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f18" name="above the ceiling: revise" sourceRef="bp_overGw" targetRef="bp_submit_slaPlan"><conditionExpression xsi:type="tFormalExpression">${requestAmount &gt; ceilingAmount}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_budget_preparat_f19" sourceRef="bp_review_warn" targetRef="bp_review_warnNotify"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f20" sourceRef="bp_review_warnNotify" targetRef="bp_review_warnEnd"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f21" sourceRef="bp_review_breach" targetRef="bp_review_breachAct"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f22" sourceRef="bp_review_breachAct" targetRef="bp_review_breachGw"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f23" name="deemed" sourceRef="bp_review_breachGw" targetRef="bp_review_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_budget_preparat_f24" name="escalated" sourceRef="bp_review_breachGw" targetRef="bp_review_slaPlan"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f25" sourceRef="bp_review_slaPlan" targetRef="bp_review"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f26" sourceRef="bp_review" targetRef="bp_review_done"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f27" name="within the ceiling" sourceRef="bp_overGw" targetRef="bp_review_slaPlan"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f28" sourceRef="bp_review_done" targetRef="bp_reviewGw"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f29" name="returned" sourceRef="bp_reviewGw" targetRef="bp_submit_slaPlan"><conditionExpression xsi:type="tFormalExpression">${reviewDecision == 'return'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_budget_preparat_f30" name="approved" sourceRef="bp_reviewGw" targetRef="bp_executive"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f31" sourceRef="bp_executive" targetRef="bp_executiveGw"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f32" name="returned to the budget office" sourceRef="bp_executiveGw" targetRef="bp_review_slaPlan"><conditionExpression xsi:type="tFormalExpression">${executiveDecision == 'return'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_budget_preparat_f33" name="approved" sourceRef="bp_executiveGw" targetRef="bp_bundle"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f34" sourceRef="bp_bundle" targetRef="bp_bundleGw"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f35" name="bundle returned: correct the data" sourceRef="bp_bundleGw" targetRef="bp_review_slaPlan"><conditionExpression xsi:type="tFormalExpression">${bundleDecision == 'return'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_budget_preparat_f36" sourceRef="bp_legislature_clear" targetRef="bp_legislature"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f37" sourceRef="bp_legislature" targetRef="bp_legislatureGw"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f38" sourceRef="bp_legislatureHold" targetRef="bp_legislature_clear"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f39" name="not confirmed" sourceRef="bp_legislatureGw" targetRef="bp_legislatureHold"><conditionExpression xsi:type="tFormalExpression">${legStatus != 'COMPLETED' || legReceiptRef == null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_budget_preparat_f40" name="complete" sourceRef="bp_bundleGw" targetRef="bp_legislature_clear"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f41" name="received" sourceRef="bp_legislatureGw" targetRef="bp_legClock"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f42" sourceRef="bp_legClock" targetRef="bp_wait"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f43" sourceRef="bp_wait" targetRef="bp_enactedMsg"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f44" sourceRef="bp_wait" targetRef="bp_legLate"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f45" sourceRef="bp_legLate" targetRef="bp_legFollowUp"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f46" sourceRef="bp_legFollowUp" targetRef="bp_legClock"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f47" sourceRef="bp_enactedMsg" targetRef="bp_record"/>
    <sequenceFlow id="intl_pfm_budget_preparat_f48" sourceRef="bp_record" targetRef="bp_end"/>
    <subProcess id="bp_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="bp_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="bp_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="bp_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.1"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="bp_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="intl_pfm_budget_preparat_f49" sourceRef="bp_withdrawStart" targetRef="bp_withdrawKind"/>
      <sequenceFlow id="intl_pfm_budget_preparat_f50" sourceRef="bp_withdrawKind" targetRef="bp_withdrawCall"/>
      <sequenceFlow id="intl_pfm_budget_preparat_f51" sourceRef="bp_withdrawCall" targetRef="bp_withdrawEnd"/>
    </subProcess>
    <subProcess id="bp_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="bp_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="bp_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="bp_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.1"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="bp_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="intl_pfm_budget_preparat_f52" sourceRef="bp_cancelStart" targetRef="bp_cancelKind"/>
      <sequenceFlow id="intl_pfm_budget_preparat_f53" sourceRef="bp_cancelKind" targetRef="bp_cancelCall"/>
      <sequenceFlow id="intl_pfm_budget_preparat_f54" sourceRef="bp_cancelCall" targetRef="bp_cancelEnd"/>
    </subProcess>
  </process>
  <bpmndi:BPMNDiagram id="intl_pfm_budget_preparat_diagram">
    <bpmndi:BPMNPlane id="intl_pfm_budget_preparat_plane" bpmnElement="sangam-intl-pfm-budget-preparation">
