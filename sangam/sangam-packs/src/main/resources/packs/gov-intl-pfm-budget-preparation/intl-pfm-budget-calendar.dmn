<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_intl_pfm_budget_calendar" name="Budget calendar (SYNTHETIC; per country)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <!-- SYNTHETIC: country law or policy. Deploy the confirmed table as a tenant override. -->
  <decision id="intl-pfm-budget-calendar" name="Budget calendar (SYNTHETIC; per country)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.1">
    <decisionTable id="intl-pfm-budget-calendar_t" hitPolicy="FIRST">
      <input id="intl-pfm-budget-calendar_i0" label="Spending unit"><inputExpression id="intl-pfm-budget-calendar_ie0" typeRef="string"><text>spendingUnit</text></inputExpression></input>
      <output id="intl-pfm-budget-calendar_o0" label="Submission within" name="budgetSubmissionSpec" typeRef="string"/>
      <output id="intl-pfm-budget-calendar_o1" label="Review within" name="budgetReviewSpec" typeRef="string"/>
      <output id="intl-pfm-budget-calendar_o2" label="Enactment expected within" name="legislatureSpec" typeRef="string"/>
      <rule id="intl-pfm-budget-calendar_r0"><description>SYNTHETIC</description>
        <inputEntry id="intl-pfm-budget-calendar_r0_i0"><text>-</text></inputEntry>
        <outputEntry id="intl-pfm-budget-calendar_r0_o0"><text>"30D"</text></outputEntry>
        <outputEntry id="intl-pfm-budget-calendar_r0_o1"><text>"15D"</text></outputEntry>
        <outputEntry id="intl-pfm-budget-calendar_r0_o2"><text>"90D"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
