<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_ifms_gpf_return_target" name="GPF return target by returning level" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="ifms-gpf-return-target" name="GPF return target by returning level" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.3">
    <decisionTable id="ifms-gpf-return-target_t" hitPolicy="FIRST">
      <input id="ifms-gpf-return-target_i0" label="Returning level"><inputExpression id="ifms-gpf-return-target_ie0" typeRef="string"><text>competentRole</text></inputExpression></input>
      <output id="ifms-gpf-return-target_o0" label="Return to seat" name="gpfReturnSeat" typeRef="string"/>
      <output id="ifms-gpf-return-target_o1" label="Rule" name="ruleRef" typeRef="string"/>
      <rule id="ifms-gpf-return-target_r0">
        <inputEntry id="ifms-gpf-return-target_r0_i0"><text>"HOO"</text></inputEntry>
        <outputEntry id="ifms-gpf-return-target_r0_o0"><text>"DDO-1"</text></outputEntry>
        <outputEntry id="ifms-gpf-return-target_r0_o1"><text>"Odisha FD 19582 (11-07-2023) p.15: HoO returns to the Operator"</text></outputEntry>
      </rule>
      <rule id="ifms-gpf-return-target_r1">
        <inputEntry id="ifms-gpf-return-target_r1_i0"><text>"AG"</text></inputEntry>
        <outputEntry id="ifms-gpf-return-target_r1_o0"><text>"DDO-2"</text></outputEntry>
        <outputEntry id="ifms-gpf-return-target_r1_o1"><text>"Odisha FD 19582 (11-07-2023) p.15: A.G. returns to the HoO approver"</text></outputEntry>
      </rule>
      <rule id="ifms-gpf-return-target_r2"><description>inferred</description>
        <inputEntry id="ifms-gpf-return-target_r2_i0"><text>-</text></inputEntry>
        <outputEntry id="ifms-gpf-return-target_r2_o0"><text>"DDO-1"</text></outputEntry>
        <outputEntry id="ifms-gpf-return-target_r2_o1"><text>"[INFERRED] other internal levels return to the Operator"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
