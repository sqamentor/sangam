  <process id="sangam-ifms-gpf" name="GPF advance / withdrawal" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.ifms.gpf</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>gpfAccount,amount,gpfPurpose</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="gp_start" name="Application" operaton:initiator="initiator" operaton:formKey="sangam:ifms-gpf/application"></startEvent>
    <serviceTask id="gp_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>amount=0;gpfBalance=0;qualifyingService=0;gpfPurpose=OTHER;billType=GPF_WITHDRAWAL;caseType=GPF;routingDecisionKey=ifms-gpf-authority;powersDecisionKey=ifms-gpf-powers;scrutinySeat=DDO-1;sanctionSla=15D;appealAllowed=false;outputTemplate=gpf-sanction</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="gp_rules" name="GPF eligibility (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>gpf-withdrawal</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <exclusiveGateway id="gp_okGw" name="" default="ifms_gpf_f7"></exclusiveGateway>
    <serviceTask id="gp_rjRule_code" name="Reason: GPF_NOT_ELIGIBLE" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=GPF_NOT_ELIGIBLE</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="gp_rjRule_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
