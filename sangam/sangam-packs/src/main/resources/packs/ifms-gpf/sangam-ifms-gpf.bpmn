<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_ifms_gpf" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.6">
  <message id="msg_sangam_cancelCase" name="sangam.cancelCase"/>
  <message id="msg_sangam_withdrawCase" name="sangam.withdrawCase"/>
  <process id="sangam-ifms-gpf" name="GPF advance / withdrawal" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.6">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.ifms.gpf</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.6</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>employeeId,gpfAccount,amount,gpfPurpose,payeeAccount,currency,purpose</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="gp_start" name="Application" operaton:initiator="initiator" operaton:formKey="sangam:ifms-gpf/application"></startEvent>
    <serviceTask id="gp_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>amount=0;gpfBalance=0;qualifyingService=0;gpfPurpose=OTHER;billType=GPF_WITHDRAWAL;caseType=GPF;routingDecisionKey=ifms-gpf-authority;powersDecisionKey=ifms-gpf-powers;scrutinySeat=DDO-1;sanctionSla=15D;appealAllowed=false;outputTemplate=gpf-sanction</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="gp_rules" name="GPF eligibility (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>gpf-withdrawal</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <exclusiveGateway id="gp_okGw" name="" default="ifms_gpf_f7"></exclusiveGateway>
    <serviceTask id="gp_rjRule_code" name="Reason: GPF_NOT_ELIGIBLE" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=GPF_NOT_ELIGIBLE</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="gp_rjRule_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.3"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="gp_rjRule_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <callActivity id="gp_sanction" name="Sanction (core)" calledElement="sangam-core-sanction" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.3"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <callActivity id="gp_rj_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.3"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="gp_rj_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <callActivity id="gp_bill" name="GPF bill" calledElement="sangam-ifms-bill" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.6"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <businessRuleTask id="gp_returnTarget" name="Return target by returning level (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>ifms-gpf-return-target</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <exclusiveGateway id="gp_retGw" name="Reason given?" default="ifms_gpf_f19"></exclusiveGateway>
    <serviceTask id="gp_rework_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>gp_rework</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="gp_rework" name="Rework and resubmit" operaton:candidateGroups="${gpfReturnSeat}" operaton:formKey="sangam:ifms-gpf/rework" operaton:dueDate="${gp_reworkDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>reworkDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="gp_rework_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>gp_rework</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>gpfReturnSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="gp_rework_warnEnd" name="Warned"></endEvent>
    <serviceTask id="gp_rework_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>gp_rework</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>gpfReturnSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>reworkDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="gp_rework_breachGw" name="Deemed?" default="ifms_gpf_f15"></exclusiveGateway>
    <exclusiveGateway id="gp_rework_done" name=""></exclusiveGateway>
    <serviceTask id="gp_version" name="New application version (same case, GP-50)" operaton:class="org.sangam.packs.core.CaseRecordDelegate"><extensionElements><operaton:field name="op"><operaton:string>RESUBMIT</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="gp_sanGw" name="sanctionOutcome?" default="ifms_gpf_f24"></exclusiveGateway>
    <endEvent id="gp_end" name="Closed"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <exclusiveGateway id="gp_sanctionPrepareGw" name="Document to sign?" default="ifms_gpf_f34"></exclusiveGateway>
    <userTask id="gp_sanctionPrepare" name="Prepare the document to sign" operaton:candidateGroups="${initiatorSeat}" operaton:formKey="sangam:ifms-gpf/prepare-sanction-note"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.DocumentSlotReadyListener"><operaton:field name="slots"><operaton:string>sanctionDocumentId:SANCTION_NOTE</operaton:string></operaton:field></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <boundaryEvent id="gp_rework_warn" name="SLA warning (75%)" attachedToRef="gp_rework" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${gp_reworkWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="gp_rework_breach" name="SLA breached" attachedToRef="gp_rework" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${gp_reworkDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="ifms_gpf_f1" sourceRef="gp_start" targetRef="gp_defaults"/>
    <sequenceFlow id="ifms_gpf_f2" sourceRef="gp_defaults" targetRef="gp_rules"/>
    <sequenceFlow id="ifms_gpf_f3" sourceRef="gp_rules" targetRef="gp_okGw"/>
    <sequenceFlow id="ifms_gpf_f4" sourceRef="gp_rjRule_reject" targetRef="gp_rjRule_endRejected"/>
    <sequenceFlow id="ifms_gpf_f5" sourceRef="gp_rjRule_code" targetRef="gp_rjRule_reject"/>
    <sequenceFlow id="ifms_gpf_f6" name="not eligible" sourceRef="gp_okGw" targetRef="gp_rjRule_code"><conditionExpression xsi:type="tFormalExpression">${gpfEligible == false}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_gpf_f7" name="eligible" sourceRef="gp_okGw" targetRef="gp_sanctionPrepareGw"/>
    <sequenceFlow id="ifms_gpf_f8" sourceRef="gp_rj_reject" targetRef="gp_rj_endRejected"/>
    <sequenceFlow id="ifms_gpf_f9" sourceRef="gp_returnTarget" targetRef="gp_retGw"/>
    <sequenceFlow id="ifms_gpf_f10" sourceRef="gp_rework_warn" targetRef="gp_rework_warnNotify"/>
    <sequenceFlow id="ifms_gpf_f11" sourceRef="gp_rework_warnNotify" targetRef="gp_rework_warnEnd"/>
    <sequenceFlow id="ifms_gpf_f12" sourceRef="gp_rework_breach" targetRef="gp_rework_breachAct"/>
    <sequenceFlow id="ifms_gpf_f13" sourceRef="gp_rework_breachAct" targetRef="gp_rework_breachGw"/>
    <sequenceFlow id="ifms_gpf_f14" name="deemed" sourceRef="gp_rework_breachGw" targetRef="gp_rework_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_gpf_f15" name="escalated" sourceRef="gp_rework_breachGw" targetRef="gp_rework_slaPlan"/>
    <sequenceFlow id="ifms_gpf_f16" sourceRef="gp_rework_slaPlan" targetRef="gp_rework"/>
    <sequenceFlow id="ifms_gpf_f17" sourceRef="gp_rework" targetRef="gp_rework_done"/>
    <sequenceFlow id="ifms_gpf_f18" name="reason given" sourceRef="gp_retGw" targetRef="gp_rework_slaPlan"><conditionExpression xsi:type="tFormalExpression">${execution.getVariable('returnReason') != null &amp;&amp; execution.getVariable('returnReason') != ''}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_gpf_f19" name="no reason: the authority is asked again" sourceRef="gp_retGw" targetRef="gp_sanctionPrepareGw"/>
    <sequenceFlow id="ifms_gpf_f20" sourceRef="gp_rework_done" targetRef="gp_version"/>
    <sequenceFlow id="ifms_gpf_f21" sourceRef="gp_version" targetRef="gp_rules"/>
    <sequenceFlow id="ifms_gpf_f22" name="SANCTIONED" sourceRef="gp_sanGw" targetRef="gp_bill"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_gpf_f23" name="RETURNED" sourceRef="gp_sanGw" targetRef="gp_returnTarget"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'RETURNED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_gpf_f24" name="otherwise" sourceRef="gp_sanGw" targetRef="gp_rj_reject"/>
    <sequenceFlow id="ifms_gpf_f25" sourceRef="gp_sanction" targetRef="gp_sanGw"/>
    <sequenceFlow id="ifms_gpf_f26" sourceRef="gp_bill" targetRef="gp_end"/>
    <sequenceFlow id="ifms_gpf_f33" name="DSC signature needed" sourceRef="gp_sanctionPrepareGw" targetRef="gp_sanctionPrepare"><conditionExpression xsi:type="tFormalExpression">${execution.getVariable('signatureRequired') == true}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_gpf_f34" name="no DSC signature" sourceRef="gp_sanctionPrepareGw" targetRef="gp_sanction"/>
    <sequenceFlow id="ifms_gpf_f35" sourceRef="gp_sanctionPrepare" targetRef="gp_sanction"/>
    <subProcess id="gp_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="gp_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="gp_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="gp_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.3"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="gp_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="ifms_gpf_f27" sourceRef="gp_withdrawStart" targetRef="gp_withdrawKind"/>
      <sequenceFlow id="ifms_gpf_f28" sourceRef="gp_withdrawKind" targetRef="gp_withdrawCall"/>
      <sequenceFlow id="ifms_gpf_f29" sourceRef="gp_withdrawCall" targetRef="gp_withdrawEnd"/>
    </subProcess>
    <subProcess id="gp_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="gp_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="gp_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="gp_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.3"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="gp_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="ifms_gpf_f30" sourceRef="gp_cancelStart" targetRef="gp_cancelKind"/>
      <sequenceFlow id="ifms_gpf_f31" sourceRef="gp_cancelKind" targetRef="gp_cancelCall"/>
      <sequenceFlow id="ifms_gpf_f32" sourceRef="gp_cancelCall" targetRef="gp_cancelEnd"/>
    </subProcess>
  </process>
