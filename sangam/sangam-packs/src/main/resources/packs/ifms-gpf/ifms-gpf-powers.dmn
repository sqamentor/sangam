<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_ifms_gpf_powers" name="Delegated powers by role" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <!-- Delegated powers for GPF (SL-31). UNVERIFIED: the GPF (CS) Rules 1960 sanctioning authority is not read (corpus IFC-171 [U: department order]); confirm and deploy it as a tenant DMN override -->
  <decision id="ifms-gpf-powers" name="Delegated powers by role" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="ifms-gpf-powers_t" hitPolicy="FIRST">
      <input id="ifms-gpf-powers_i0" label="Seat role"><inputExpression id="ifms-gpf-powers_ie0" typeRef="string"><text>seatRole</text></inputExpression></input>
      <input id="ifms-gpf-powers_i1" label="Case type"><inputExpression id="ifms-gpf-powers_ie1" typeRef="string"><text>caseType</text></inputExpression></input>
      <output id="ifms-gpf-powers_o0" label="Power limit (INR)" name="powerLimit" typeRef="number"/>
      <output id="ifms-gpf-powers_o1" label="Allowed" name="allowed" typeRef="boolean"/>
      <output id="ifms-gpf-powers_o2" label="No monetary limit" name="noMonetaryLimit" typeRef="boolean"/>
      <rule id="ifms-gpf-powers_r0"><description>Head of Office sanctions GPF advances / withdrawals within gpf-withdrawal (pack default)</description>
        <inputEntry id="ifms-gpf-powers_r0_i0"><text>"HOO"</text></inputEntry>
        <inputEntry id="ifms-gpf-powers_r0_i1"><text>"GPF"</text></inputEntry>
        <outputEntry id="ifms-gpf-powers_r0_o0"><text>null</text></outputEntry>
        <outputEntry id="ifms-gpf-powers_r0_o1"><text>true</text></outputEntry>
        <outputEntry id="ifms-gpf-powers_r0_o2"><text>true</text></outputEntry>
      </rule>
      <rule id="ifms-gpf-powers_r1"><description>no delegated power</description>
        <inputEntry id="ifms-gpf-powers_r1_i0"><text>-</text></inputEntry>
        <inputEntry id="ifms-gpf-powers_r1_i1"><text>-</text></inputEntry>
        <outputEntry id="ifms-gpf-powers_r1_o0"><text>0</text></outputEntry>
        <outputEntry id="ifms-gpf-powers_r1_o1"><text>false</text></outputEntry>
        <outputEntry id="ifms-gpf-powers_r1_o2"><text>false</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
