{
  "key": "gov-intl-pfm-pefa-evidence/review",
  "version": "1.0.1",
  "pack": "gov.intl.pfm-pefa-evidence",
  "title": {
    "en": "Review the evidence pack (not the compiler)",
    "hi": "साक्ष्य की समीक्षा"
  },
  "caseSummary": {
    "source": "materialFields",
    "label": {
      "en": "Case details",
      "hi": "प्रकरण का विवरण"
    }
  },
  "fields": [
    {
      "id": "extractDatasetRef",
      "type": "readonly",
      "required": false,
      "label": {
        "en": "Report data set (ledger extract)",
        "hi": "रिपोर्ट डेटा सेट"
      }
    },
    {
      "id": "evidenceNote",
      "type": "text",
      "required": false,
      "label": {
        "en": "Evidence by indicator; sources outside Sangam listed",
        "hi": "संकेतकवार साक्ष्य"
      }
    },
    {
      "id": "remarks",
      "type": "text",
      "required": false,
      "label": {
        "en": "Remarks",
        "hi": "टिप्पणी"
      }
    }
  ],
  "decision": {
    "variable": "reviewDecision",
    "required": true,
    "options": [
      {
        "value": "approve",
        "label": {
          "en": "Approve / sanction",
          "hi": "अनुमोदित / स्वीकृत करें"
        }
      },
      {
        "value": "return",
        "label": {
          "en": "Return",
          "hi": "वापस करें"
        }
      }
    ]
  }
}
