<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- PEFA evidence pack. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_intl_pfm_pefa_evidence" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.1">
  <message id="msg_sangam_cancelCase" name="sangam.cancelCase"/>
  <message id="msg_sangam_withdrawCase" name="sangam.withdrawCase"/>
  <process id="sangam-intl-pfm-pefa-evidence" name="PEFA evidence pack" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.1">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.intl.pfm-pefa-evidence</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.1</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>assessmentRef,reportPeriod,indicatorSet</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="pf_start" name="Evidence requested" operaton:initiator="initiator" operaton:formKey="sangam:gov-intl-pfm-pefa-evidence/request"></startEvent>
    <serviceTask id="pf_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>ledgerId=BUDGET;indicatorSet=PI-1..PI-31;coordinatorSeat=PEFA-COORDINATOR;reviewerSeat=ACCOUNTING-OFFICER</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="pf_extract_clear" name="Clear the previous check result" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>extractDatasetRef=null</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="pf_extract" name="Ledger report set" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>ledger.report</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>pefaEvidence</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>ledgerId,indicatorSet,reportPeriod</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>extract</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="pf_extractGw" name="Ledger report set?" default="intl_pfm_pefa_evidence_f7"></exclusiveGateway>
    <userTask id="pf_extractHold" name="Ledger report set not confirmed: check the ledger" operaton:candidateGroups="${coordinatorSeat}" operaton:formKey="sangam:gov-intl-pfm-pefa-evidence/extractHold"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <userTask id="pf_compile" name="Compile the evidence by indicator" operaton:candidateGroups="${coordinatorSeat}" operaton:formKey="sangam:gov-intl-pfm-pefa-evidence/compile"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <userTask id="pf_review" name="Review the evidence pack (not the compiler)" operaton:candidateGroups="${reviewerSeat}" operaton:formKey="sangam:gov-intl-pfm-pefa-evidence/review"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"><operaton:field name="steps"><operaton:string>pf_compile</operaton:string></operaton:field></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>reviewDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="pf_reviewGw" name="" default="intl_pfm_pefa_evidence_f11"></exclusiveGateway>
    <serviceTask id="pf_doc" name="PEFA evidence pack" operaton:class="org.sangam.packs.core.DocumentDelegate"><extensionElements><operaton:field name="template"><operaton:string>pefa-evidence-pack</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="pf_end" name="Evidence pack issued"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>ISSUED</operaton:string></operaton:field><operaton:field name="dataVars"><operaton:string>['extractDatasetRef']</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <sequenceFlow id="intl_pfm_pefa_evidence_f1" sourceRef="pf_extract_clear" targetRef="pf_extract"/>
    <sequenceFlow id="intl_pfm_pefa_evidence_f2" sourceRef="pf_extract" targetRef="pf_extractGw"/>
    <sequenceFlow id="intl_pfm_pefa_evidence_f3" sourceRef="pf_extractHold" targetRef="pf_extract_clear"/>
    <sequenceFlow id="intl_pfm_pefa_evidence_f4" name="not confirmed" sourceRef="pf_extractGw" targetRef="pf_extractHold"><conditionExpression xsi:type="tFormalExpression">${extractStatus != 'COMPLETED' || extractDatasetRef == null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_pefa_evidence_f5" sourceRef="pf_start" targetRef="pf_defaults"/>
    <sequenceFlow id="intl_pfm_pefa_evidence_f6" sourceRef="pf_defaults" targetRef="pf_extract_clear"/>
    <sequenceFlow id="intl_pfm_pefa_evidence_f7" name="confirmed" sourceRef="pf_extractGw" targetRef="pf_compile"/>
    <sequenceFlow id="intl_pfm_pefa_evidence_f8" sourceRef="pf_compile" targetRef="pf_review"/>
    <sequenceFlow id="intl_pfm_pefa_evidence_f9" sourceRef="pf_review" targetRef="pf_reviewGw"/>
    <sequenceFlow id="intl_pfm_pefa_evidence_f10" name="returned" sourceRef="pf_reviewGw" targetRef="pf_compile"><conditionExpression xsi:type="tFormalExpression">${reviewDecision == 'return'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_pefa_evidence_f11" name="approved" sourceRef="pf_reviewGw" targetRef="pf_doc"/>
    <sequenceFlow id="intl_pfm_pefa_evidence_f12" sourceRef="pf_doc" targetRef="pf_end"/>
    <subProcess id="pf_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="pf_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="pf_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="pf_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.2"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="pf_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="intl_pfm_pefa_evidence_f13" sourceRef="pf_withdrawStart" targetRef="pf_withdrawKind"/>
      <sequenceFlow id="intl_pfm_pefa_evidence_f14" sourceRef="pf_withdrawKind" targetRef="pf_withdrawCall"/>
      <sequenceFlow id="intl_pfm_pefa_evidence_f15" sourceRef="pf_withdrawCall" targetRef="pf_withdrawEnd"/>
    </subProcess>
    <subProcess id="pf_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="pf_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="pf_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="pf_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.2"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="pf_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="intl_pfm_pefa_evidence_f16" sourceRef="pf_cancelStart" targetRef="pf_cancelKind"/>
      <sequenceFlow id="intl_pfm_pefa_evidence_f17" sourceRef="pf_cancelKind" targetRef="pf_cancelCall"/>
      <sequenceFlow id="intl_pfm_pefa_evidence_f18" sourceRef="pf_cancelCall" targetRef="pf_cancelEnd"/>
    </subProcess>
  </process>
  <bpmndi:BPMNDiagram id="intl_pfm_pefa_evidence_diagram">
    <bpmndi:BPMNPlane id="intl_pfm_pefa_evidence_plane" bpmnElement="sangam-intl-pfm-pefa-evidence">
