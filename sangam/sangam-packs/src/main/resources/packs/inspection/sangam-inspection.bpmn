<!-- Inspection of an establishment. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_inspection" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_complianceReported" name="sangam.complianceReported"/>
  <process id="sangam-inspection" name="Inspection of an establishment" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.inspection</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>key,premisesId</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="in_start" name="Inspection due" operaton:initiator="initiator" operaton:formKey="sangam:inspection/case"></startEvent>
    <serviceTask id="in_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>inspectorPool=INSP-1,INSP-2,INSP-3;complianceWindow=P30D;caseType=PENALTY;routingDecisionKey=inspection-penalty-authority;amount=0;appealAllowed=true;appellateSeat=APPELLATE-INSP;reinspection=false</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="in_assign" name="Least-loaded inspector (R82)" operaton:class="org.sangam.packs.core.AssignmentStrategyDelegate"><extensionElements><operaton:field name="strategy"><operaton:string>LEAST_LOADED</operaton:string></operaton:field><operaton:field name="candidatesVar"><operaton:string>inspectorPool</operaton:string></operaton:field><operaton:field name="resultVar"><operaton:string>inspectorSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="in_inspect_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>in_inspect</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>10WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="in_inspect" name="Schedule and inspect" operaton:candidateGroups="${inspectorSeat}" operaton:formKey="sangam:inspection/inspect" operaton:dueDate="${in_inspectDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>inspectionDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="in_inspect_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>in_inspect</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>inspectorSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="in_inspect_warnEnd" name="Warned"></endEvent>
    <serviceTask id="in_inspect_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>in_inspect</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>inspectorSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>inspectionDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="in_inspect_breachGw" name="Deemed?" default="inspection_f6"></exclusiveGateway>
    <exclusiveGateway id="in_inspect_done" name=""></exclusiveGateway>
    <exclusiveGateway id="in_gw" name="Result?" default="inspection_f17"></exclusiveGateway>
    <serviceTask id="in_reassign" name="Reassign (round robin)" operaton:class="org.sangam.packs.core.AssignmentStrategyDelegate"><extensionElements><operaton:field name="strategy"><operaton:string>ROUND_ROBIN</operaton:string></operaton:field><operaton:field name="candidatesVar"><operaton:string>inspectorPool</operaton:string></operaton:field><operaton:field name="resultVar"><operaton:string>inspectorSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="in_report" name="Inspection report" operaton:class="org.sangam.packs.core.DocumentDelegate"><extensionElements><operaton:field name="template"><operaton:string>inspection-report</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="in_end" name="Inspected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="in_notice" name="Compliance notice" operaton:class="org.sangam.packs.core.DocumentDelegate"><extensionElements><operaton:field name="template"><operaton:string>compliance-notice</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="in_tell" name="Serve notice" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>compliance-notice</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>sms,email</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>premisesId</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="in_window" name="Compliance window" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>compliance</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${complianceWindow}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <eventBasedGateway id="in_wait" name="Compliance reported?"></eventBasedGateway>
    <intermediateCatchEvent id="in_reported" name="Compliance reported"><messageEventDefinition messageRef="msg_sangam_complianceReported"/></intermediateCatchEvent>
    <intermediateCatchEvent id="in_lapse" name="Window lapsed"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${complianceDueAt}</timeDate></timerEventDefinition></intermediateCatchEvent>
    <serviceTask id="in_reinspect" name="Re-inspection" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>reinspection=true</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="in_penalty" name="Penalty order (core sanction)" calledElement="sangam-core-sanction"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <serviceTask id="in_penaltyOrder" name="Penalty order" operaton:class="org.sangam.packs.core.DocumentDelegate"><extensionElements><operaton:field name="template"><operaton:string>penalty-order</operaton:string></operaton:field><operaton:field name="requireApproval"><operaton:string>true</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="in_rj_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="in_rj_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <exclusiveGateway id="in_sanGw" name="sanctionOutcome?" default="inspection_f28"></exclusiveGateway>
    <endEvent id="in_endPenalty" name="Penalty imposed"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>PENALTY</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="in_inspect_warn" name="SLA warning (75%)" attachedToRef="in_inspect" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${in_inspectWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="in_inspect_breach" name="SLA breached" attachedToRef="in_inspect" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${in_inspectDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="inspection_f1" sourceRef="in_inspect_warn" targetRef="in_inspect_warnNotify"/>
    <sequenceFlow id="inspection_f2" sourceRef="in_inspect_warnNotify" targetRef="in_inspect_warnEnd"/>
    <sequenceFlow id="inspection_f3" sourceRef="in_inspect_breach" targetRef="in_inspect_breachAct"/>
    <sequenceFlow id="inspection_f4" sourceRef="in_inspect_breachAct" targetRef="in_inspect_breachGw"/>
    <sequenceFlow id="inspection_f5" name="deemed" sourceRef="in_inspect_breachGw" targetRef="in_inspect_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="inspection_f6" name="escalated" sourceRef="in_inspect_breachGw" targetRef="in_inspect_slaPlan"/>
    <sequenceFlow id="inspection_f7" sourceRef="in_inspect_slaPlan" targetRef="in_inspect"/>
    <sequenceFlow id="inspection_f8" sourceRef="in_inspect" targetRef="in_inspect_done"/>
    <sequenceFlow id="inspection_f9" sourceRef="in_start" targetRef="in_defaults"/>
    <sequenceFlow id="inspection_f10" sourceRef="in_defaults" targetRef="in_assign"/>
    <sequenceFlow id="inspection_f11" sourceRef="in_assign" targetRef="in_inspect_slaPlan"/>
    <sequenceFlow id="inspection_f12" sourceRef="in_inspect_done" targetRef="in_gw"/>
    <sequenceFlow id="inspection_f13" name="reschedule (GP-17)" sourceRef="in_gw" targetRef="in_reassign"><conditionExpression xsi:type="tFormalExpression">${inspectionDecision == 'reschedule'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="inspection_f14" sourceRef="in_reassign" targetRef="in_inspect_slaPlan"/>
    <sequenceFlow id="inspection_f15" name="satisfactory" sourceRef="in_gw" targetRef="in_report"><conditionExpression xsi:type="tFormalExpression">${inspectionDecision == 'satisfactory'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="inspection_f16" sourceRef="in_report" targetRef="in_end"/>
    <sequenceFlow id="inspection_f17" name="unsatisfactory" sourceRef="in_gw" targetRef="in_notice"/>
    <sequenceFlow id="inspection_f18" sourceRef="in_notice" targetRef="in_tell"/>
    <sequenceFlow id="inspection_f19" sourceRef="in_tell" targetRef="in_window"/>
    <sequenceFlow id="inspection_f20" sourceRef="in_window" targetRef="in_wait"/>
    <sequenceFlow id="inspection_f21" sourceRef="in_wait" targetRef="in_reported"/>
    <sequenceFlow id="inspection_f22" sourceRef="in_wait" targetRef="in_lapse"/>
    <sequenceFlow id="inspection_f23" sourceRef="in_reported" targetRef="in_reinspect"/>
    <sequenceFlow id="inspection_f24" sourceRef="in_reinspect" targetRef="in_inspect_slaPlan"/>
    <sequenceFlow id="inspection_f25" sourceRef="in_lapse" targetRef="in_penalty"/>
    <sequenceFlow id="inspection_f26" sourceRef="in_rj_reject" targetRef="in_rj_endRejected"/>
    <sequenceFlow id="inspection_f27" name="SANCTIONED" sourceRef="in_sanGw" targetRef="in_penaltyOrder"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="inspection_f28" name="otherwise" sourceRef="in_sanGw" targetRef="in_rj_reject"/>
    <sequenceFlow id="inspection_f29" sourceRef="in_penalty" targetRef="in_sanGw"/>
    <sequenceFlow id="inspection_f30" sourceRef="in_penaltyOrder" targetRef="in_endPenalty"/>
  </process>
