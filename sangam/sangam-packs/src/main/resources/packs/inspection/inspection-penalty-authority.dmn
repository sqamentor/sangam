<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_inspection_penalty_authority" name="Penalty authority" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="inspection-penalty-authority" name="Penalty authority" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="inspection-penalty-authority_t" hitPolicy="FIRST">
      <input id="inspection-penalty-authority_i0" label="Amount"><inputExpression id="inspection-penalty-authority_ie0" typeRef="number"><text>amount</text></inputExpression></input>
      <output id="inspection-penalty-authority_o0" label="Competent role" name="competentRole" typeRef="string"/>
      <rule id="inspection-penalty-authority_r0">
        <inputEntry id="inspection-penalty-authority_r0_i0"><text>-</text></inputEntry>
        <outputEntry id="inspection-penalty-authority_r0_o0"><text>"DC"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
