<!-- Court case. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_court_case" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_hearingDateSet" name="sangam.hearingDateSet"/>
  <process id="sangam-court-case" name="Court case" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.court-case</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>caseNo,court</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="cc_start" name="Notice received" operaton:initiator="initiator" operaton:formKey="sangam:court-case/notice"></startEvent>
    <serviceTask id="cc_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>nodalSeat=LEGAL-NODAL;deptSeat=DEPT-OFFICER;limitationPeriod=P90D;stayInForce=false;impugnedCaseKey=null</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="cc_counsel" name="Engage counsel and assign" operaton:candidateGroups="${nodalSeat}" operaton:formKey="sangam:court-case/counsel"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="cc_comments_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>cc_comments</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>10WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="cc_comments" name="Para-wise comments" operaton:candidateGroups="${deptSeat}" operaton:formKey="sangam:court-case/comments" operaton:dueDate="${cc_commentsDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="cc_comments_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>cc_comments</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>deptSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="cc_comments_warnEnd" name="Warned"></endEvent>
    <serviceTask id="cc_comments_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>cc_comments</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>deptSeat</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="cc_comments_breachGw" name="Deemed?" default="court_case_f6"></exclusiveGateway>
    <exclusiveGateway id="cc_comments_done" name=""></exclusiveGateway>
    <userTask id="cc_affidavit" name="File counter affidavit" operaton:candidateGroups="${nodalSeat}" operaton:formKey="sangam:court-case/affidavit"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="cc_schedule" name="Next hearing (GP-51)" operaton:class="org.sangam.packs.gov.HearingScheduleDelegate"></serviceTask>
    <eventBasedGateway id="cc_waitA" name="Reminder or new date"></eventBasedGateway>
    <intermediateCatchEvent id="cc_reminder" name="Three days before"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${hearingReminderAt}</timeDate></timerEventDefinition></intermediateCatchEvent>
    <intermediateCatchEvent id="cc_newDate1" name="Date changed (LIMBS)"><messageEventDefinition messageRef="msg_sangam_hearingDateSet"/></intermediateCatchEvent>
    <serviceTask id="cc_brief" name="Brief counsel" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>hearing-brief</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>email,inapp</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>nodalSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <eventBasedGateway id="cc_waitB" name="Hearing or new date"></eventBasedGateway>
    <intermediateCatchEvent id="cc_hearing" name="Hearing"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${hearingAt}</timeDate></timerEventDefinition></intermediateCatchEvent>
    <intermediateCatchEvent id="cc_newDate2" name="Date changed (LIMBS)"><messageEventDefinition messageRef="msg_sangam_hearingDateSet"/></intermediateCatchEvent>
    <userTask id="cc_outcome" name="Record hearing outcome" operaton:candidateGroups="${nodalSeat}" operaton:formKey="sangam:court-case/outcome"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>hearingOutcome</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="cc_outGw" name="Outcome?" default="court_case_f28"></exclusiveGateway>
    <serviceTask id="cc_stay" name="Stay: suspend the impugned case (GP-40)" operaton:class="org.sangam.packs.core.SuspensionDelegate"><extensionElements><operaton:field name="op"><operaton:string>SUSPEND</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="cc_stayGw" name="Stay in force?" default="court_case_f30"></exclusiveGateway>
    <serviceTask id="cc_vacate" name="Stay vacated: resume" operaton:class="org.sangam.packs.core.SuspensionDelegate"><extensionElements><operaton:field name="op"><operaton:string>RESUME</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="cc_decide" name="Comply or appeal" operaton:candidateGroups="${nodalSeat}" operaton:formKey="sangam:court-case/decide"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>judgmentDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="cc_decGw" name="" default="court_case_f36"></exclusiveGateway>
    <serviceTask id="cc_limitation" name="Limitation period" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>limitation</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${limitationPeriod}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <userTask id="cc_fileAppeal" name="File appeal before limitation" operaton:candidateGroups="${nodalSeat}" operaton:formKey="sangam:court-case/file-appeal" operaton:dueDate="${limitationDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="cc_appealCase" name="Appeal as a linked case" operaton:class="org.sangam.packs.core.LinkedInstanceDelegate"><extensionElements><operaton:field name="processKey"><operaton:string>sangam-court-case</operaton:string></operaton:field><operaton:field name="linkType"><operaton:string>appeal</operaton:string></operaton:field><operaton:field name="inherit"><operaton:string>subject,caseNo,court,impugnedCaseKey,actingSeat,initiator</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="cc_comply" name="Implement the order" operaton:candidateGroups="${deptSeat}" operaton:formKey="sangam:court-case/comply"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <callActivity id="cc_close" name="Close (core)" calledElement="sangam-core-closure"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="cc_end" name="Closed"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="cc_comments_warn" name="SLA warning (75%)" attachedToRef="cc_comments" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${cc_commentsWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="cc_comments_breach" name="SLA breached" attachedToRef="cc_comments" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${cc_commentsDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="court_case_f1" sourceRef="cc_comments_warn" targetRef="cc_comments_warnNotify"/>
    <sequenceFlow id="court_case_f2" sourceRef="cc_comments_warnNotify" targetRef="cc_comments_warnEnd"/>
    <sequenceFlow id="court_case_f3" sourceRef="cc_comments_breach" targetRef="cc_comments_breachAct"/>
    <sequenceFlow id="court_case_f4" sourceRef="cc_comments_breachAct" targetRef="cc_comments_breachGw"/>
    <sequenceFlow id="court_case_f5" name="deemed" sourceRef="cc_comments_breachGw" targetRef="cc_comments_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="court_case_f6" name="escalated" sourceRef="cc_comments_breachGw" targetRef="cc_comments_slaPlan"/>
    <sequenceFlow id="court_case_f7" sourceRef="cc_comments_slaPlan" targetRef="cc_comments"/>
    <sequenceFlow id="court_case_f8" sourceRef="cc_comments" targetRef="cc_comments_done"/>
    <sequenceFlow id="court_case_f9" sourceRef="cc_start" targetRef="cc_defaults"/>
    <sequenceFlow id="court_case_f10" sourceRef="cc_defaults" targetRef="cc_counsel"/>
    <sequenceFlow id="court_case_f11" sourceRef="cc_counsel" targetRef="cc_comments_slaPlan"/>
    <sequenceFlow id="court_case_f12" sourceRef="cc_comments_done" targetRef="cc_affidavit"/>
    <sequenceFlow id="court_case_f13" sourceRef="cc_affidavit" targetRef="cc_schedule"/>
    <sequenceFlow id="court_case_f14" sourceRef="cc_schedule" targetRef="cc_waitA"/>
    <sequenceFlow id="court_case_f15" sourceRef="cc_waitA" targetRef="cc_reminder"/>
    <sequenceFlow id="court_case_f16" sourceRef="cc_waitA" targetRef="cc_newDate1"/>
    <sequenceFlow id="court_case_f17" sourceRef="cc_newDate1" targetRef="cc_schedule"/>
    <sequenceFlow id="court_case_f18" sourceRef="cc_reminder" targetRef="cc_brief"/>
    <sequenceFlow id="court_case_f19" sourceRef="cc_brief" targetRef="cc_waitB"/>
    <sequenceFlow id="court_case_f20" sourceRef="cc_waitB" targetRef="cc_hearing"/>
    <sequenceFlow id="court_case_f21" sourceRef="cc_waitB" targetRef="cc_newDate2"/>
    <sequenceFlow id="court_case_f22" sourceRef="cc_newDate2" targetRef="cc_schedule"/>
    <sequenceFlow id="court_case_f23" sourceRef="cc_hearing" targetRef="cc_outcome"/>
    <sequenceFlow id="court_case_f24" sourceRef="cc_outcome" targetRef="cc_outGw"/>
    <sequenceFlow id="court_case_f25" name="adjourned" sourceRef="cc_outGw" targetRef="cc_schedule"><conditionExpression xsi:type="tFormalExpression">${hearingOutcome == 'adjourned'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="court_case_f26" name="stay" sourceRef="cc_outGw" targetRef="cc_stay"><conditionExpression xsi:type="tFormalExpression">${hearingOutcome == 'interimOrder'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="court_case_f27" sourceRef="cc_stay" targetRef="cc_schedule"/>
    <sequenceFlow id="court_case_f28" name="judgment" sourceRef="cc_outGw" targetRef="cc_stayGw"/>
    <sequenceFlow id="court_case_f29" name="yes" sourceRef="cc_stayGw" targetRef="cc_vacate"><conditionExpression xsi:type="tFormalExpression">${stayInForce}</conditionExpression></sequenceFlow>
    <sequenceFlow id="court_case_f30" name="no" sourceRef="cc_stayGw" targetRef="cc_decide"/>
    <sequenceFlow id="court_case_f31" sourceRef="cc_vacate" targetRef="cc_decide"/>
    <sequenceFlow id="court_case_f32" sourceRef="cc_decide" targetRef="cc_decGw"/>
    <sequenceFlow id="court_case_f33" name="appeal" sourceRef="cc_decGw" targetRef="cc_limitation"><conditionExpression xsi:type="tFormalExpression">${judgmentDecision == 'appeal'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="court_case_f34" sourceRef="cc_limitation" targetRef="cc_fileAppeal"/>
    <sequenceFlow id="court_case_f35" sourceRef="cc_fileAppeal" targetRef="cc_appealCase"/>
    <sequenceFlow id="court_case_f36" name="comply" sourceRef="cc_decGw" targetRef="cc_comply"/>
    <sequenceFlow id="court_case_f37" sourceRef="cc_appealCase" targetRef="cc_close"/>
    <sequenceFlow id="court_case_f38" sourceRef="cc_comply" targetRef="cc_close"/>
    <sequenceFlow id="court_case_f39" sourceRef="cc_close" targetRef="cc_end"/>
  </process>
