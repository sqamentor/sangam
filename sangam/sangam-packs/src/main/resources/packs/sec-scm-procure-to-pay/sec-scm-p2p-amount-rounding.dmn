<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_sec_scm_p2p_amount_rounding" name="Requisition value rounding (quantity x unit price) (decision 139 rounding policy)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <!-- Decision 139 rounding policy, generated from tools/packgen/rounding.py -->
  <decision id="sec-scm-p2p-amount-rounding" name="Requisition value rounding (quantity x unit price) (decision 139 rounding policy)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.2">
    <decisionTable id="sec-scm-p2p-amount-rounding_t" hitPolicy="UNIQUE">
      <input id="sec-scm-p2p-amount-rounding_i0" label="As of"><inputExpression id="sec-scm-p2p-amount-rounding_ie0" typeRef="date"><text>date(asOfDate)</text></inputExpression></input>
      <output id="sec-scm-p2p-amount-rounding_o0" label="Policy" name="policyId" typeRef="string"/>
      <output id="sec-scm-p2p-amount-rounding_o1" label="Policy version" name="policyVersion" typeRef="string"/>
      <output id="sec-scm-p2p-amount-rounding_o2" label="Evidence (VERIFIED / UNVERIFIED)" name="evidenceStatus" typeRef="string"/>
      <output id="sec-scm-p2p-amount-rounding_o3" label="Permitted use (PRODUCTION / SYNTHETIC_DEMO_ONLY)" name="permittedUse" typeRef="string"/>
      <output id="sec-scm-p2p-amount-rounding_o4" label="Why this evidence status and use" name="evidenceNote" typeRef="string"/>
      <output id="sec-scm-p2p-amount-rounding_o5" label="Rounding mode" name="mode" typeRef="string"/>
      <output id="sec-scm-p2p-amount-rounding_o6" label="Rounding unit (minor units)" name="quantumMinor" typeRef="number"/>
      <output id="sec-scm-p2p-amount-rounding_o7" label="Negative amounts" name="negatives" typeRef="string"/>
      <output id="sec-scm-p2p-amount-rounding_o8" label="Instalment that takes the remainder" name="residual" typeRef="string"/>
      <output id="sec-scm-p2p-amount-rounding_o9" label="Applied to" name="application" typeRef="string"/>
      <output id="sec-scm-p2p-amount-rounding_o10" label="Stage" name="stage" typeRef="string"/>
      <output id="sec-scm-p2p-amount-rounding_o11" label="Jurisdiction" name="jurisdiction" typeRef="string"/>
      <output id="sec-scm-p2p-amount-rounding_o12" label="Scheme" name="scheme" typeRef="string"/>
      <output id="sec-scm-p2p-amount-rounding_o13" label="Purpose" name="purpose" typeRef="string"/>
      <output id="sec-scm-p2p-amount-rounding_o14" label="Source" name="source" typeRef="string"/>
      <output id="sec-scm-p2p-amount-rounding_o15" label="Provision" name="provision" typeRef="string"/>
      <output id="sec-scm-p2p-amount-rounding_o16" label="Effective from" name="effectiveFrom" typeRef="string"/>
      <output id="sec-scm-p2p-amount-rounding_o17" label="Effective to" name="effectiveTo" typeRef="string"/>
      <rule id="sec-scm-p2p-amount-rounding_r0"><description>UNVERIFIED SYNTHETIC_DEMO_ONLY demo-1</description>
        <inputEntry id="sec-scm-p2p-amount-rounding_r0_i0"><text>[date("1900-01-01")..date("9999-12-31")]</text></inputEntry>
        <outputEntry id="sec-scm-p2p-amount-rounding_r0_o0"><text>"sec-scm-p2p-amount-rounding"</text></outputEntry>
        <outputEntry id="sec-scm-p2p-amount-rounding_r0_o1"><text>"demo-1"</text></outputEntry>
        <outputEntry id="sec-scm-p2p-amount-rounding_r0_o2"><text>"UNVERIFIED"</text></outputEntry>
        <outputEntry id="sec-scm-p2p-amount-rounding_r0_o3"><text>"SYNTHETIC_DEMO_ONLY"</text></outputEntry>
        <outputEntry id="sec-scm-p2p-amount-rounding_r0_o4"><text>"UNVERIFIED, SYNTHETIC_DEMO_ONLY: a demonstration rule, no statutory or contractual rule was identified"</text></outputEntry>
        <outputEntry id="sec-scm-p2p-amount-rounding_r0_o5"><text>"HALF_UP"</text></outputEntry>
        <outputEntry id="sec-scm-p2p-amount-rounding_r0_o6"><text>1</text></outputEntry>
        <outputEntry id="sec-scm-p2p-amount-rounding_r0_o7"><text>"REFUSE"</text></outputEntry>
        <outputEntry id="sec-scm-p2p-amount-rounding_r0_o8"><text>""</text></outputEntry>
        <outputEntry id="sec-scm-p2p-amount-rounding_r0_o9"><text>"line"</text></outputEntry>
        <outputEntry id="sec-scm-p2p-amount-rounding_r0_o10"><text>"line value"</text></outputEntry>
        <outputEntry id="sec-scm-p2p-amount-rounding_r0_o11"><text>"any (demonstration)"</text></outputEntry>
        <outputEntry id="sec-scm-p2p-amount-rounding_r0_o12"><text>"demonstration"</text></outputEntry>
        <outputEntry id="sec-scm-p2p-amount-rounding_r0_o13"><text>"requisition / order value"</text></outputEntry>
        <outputEntry id="sec-scm-p2p-amount-rounding_r0_o14"><text>"none found (SYNTHETIC_DEMO: not a statutory or contractual rule; deploy the confirmed policy as a tenant override)"</text></outputEntry>
        <outputEntry id="sec-scm-p2p-amount-rounding_r0_o15"><text>"SEC-SCM-001: value rules are company policy (SYNTHETIC); quantity is a decimal field"</text></outputEntry>
        <outputEntry id="sec-scm-p2p-amount-rounding_r0_o16"><text>"1900-01-01"</text></outputEntry>
        <outputEntry id="sec-scm-p2p-amount-rounding_r0_o17"><text>"9999-12-31"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
