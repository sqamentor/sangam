<!-- Purchase of goods. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_gem_purchase" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_cancelCase" name="sangam.cancelCase"/>
  <message id="msg_sangam_goodsDelivered" name="sangam.goodsDelivered"/>
  <message id="msg_sangam_withdrawCase" name="sangam.withdrawCase"/>
  <process id="sangam-gem-purchase" name="Purchase of goods" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.gem-purchase</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>itemDescription,quantity,unitPrice,budgetHead,amount</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="gm_start" name="Indent raised" operaton:initiator="initiator" operaton:formKey="sangam:gem-purchase/indent"></startEvent>
    <serviceTask id="gm_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>caseType=PURCHASE;routingDecisionKey=gem-purchase-authority;deliveryPeriod=P30D;consigneeSeat=STORE-GM;executionConnector=gem.order;executionStep=gem-order;executionOperation=placeOrder;reconcileRequired=false;releaseConnector=ifms.release;budgetAvailable=0;appealAllowed=false;supplierAccount=;supplierIfsc=;supplierName=GeM seller</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="gm_amount" name="Value" operaton:expression="${execution.setVariable('amount', quantity * unitPrice)}"></serviceTask>
    <businessRuleTask id="gm_mode" name="Mode of procurement (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>gem-procurement-mode</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <serviceTask id="gm_budget" name="Budget available" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>ifms.budget</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>available</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>budgetHead,amount</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>budget</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="gm_budgetGw" name="Budget?" default="gem_purchase_f9"></exclusiveGateway>
    <serviceTask id="gm_encumber" name="Encumber" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>ifms.encumber</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>encumber</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>budgetHead,amount</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>encumber</operaton:string></operaton:field><operaton:field name="step"><operaton:string>encumber</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="gm_rjBudget_code" name="Reason: BUDGET_NOT_AVAILABLE" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=BUDGET_NOT_AVAILABLE</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="gm_rjBudget_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="gm_rjBudget_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <exclusiveGateway id="gm_autoGw" name="Auto-approve (GP-29)?" default="gem_purchase_f12"></exclusiveGateway>
    <serviceTask id="gm_autoApprove" name="Auto-approval below threshold" operaton:class="org.sangam.packs.core.CaseRecordDelegate"><extensionElements><operaton:field name="op"><operaton:string>BIND_DEEMED</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="gm_sanction" name="Purchase sanction (core)" calledElement="sangam-core-sanction"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <callActivity id="gm_rj_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="gm_rj_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <exclusiveGateway id="gm_modeGw" name="Mode?" default="gem_purchase_f20"></exclusiveGateway>
    <exclusiveGateway id="gm_sanGw" name="sanctionOutcome?" default="gem_purchase_f16"></exclusiveGateway>
    <callActivity id="gm_bid" name="Bid / outside-GeM tender (gov.tender)" calledElement="sangam-tender"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}/BID"/><operaton:in source="itemDescription" target="itemDescription"/><operaton:in source="amount" target="estimateAmount"/><operaton:in source="initiatorSeat" target="actingSeat"/><operaton:in source="initiatorPerson" target="initiator"/><operaton:in source="officeId" target="officeId"/><operaton:in source="tenderId" target="tenderId"/><operaton:in source="nitText" target="nitText"/><operaton:in source="bidDueAt" target="bidDueAt"/><operaton:in source="openingAt" target="openingAt"/><operaton:out source="tenderOutcome" target="tenderOutcome"/><operaton:out source="contractorId" target="supplierName"/></extensionElements></callActivity>
    <callActivity id="gm_order" name="GeM order (core execution)" calledElement="sangam-core-execution"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <userTask id="gm_bidDoc" name="Prepare bid document" operaton:candidateGroups="SO-GM" operaton:formKey="sangam:gem-purchase/bid-document"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="gm_tenderGw" name="" default="gem_purchase_f23"></exclusiveGateway>
    <serviceTask id="gm_deliveryDue" name="Delivery period" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>delivery</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${deliveryPeriod}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="gm_orderGw" name="executionOutcome?" default="gem_purchase_f25"></exclusiveGateway>
    <eventBasedGateway id="gm_wait" name="Delivered?"></eventBasedGateway>
    <intermediateCatchEvent id="gm_delivered" name="Goods delivered"><messageEventDefinition messageRef="msg_sangam_goodsDelivered"/></intermediateCatchEvent>
    <intermediateCatchEvent id="gm_late" name="Delivery overdue"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${deliveryDueAt}</timeDate></timerEventDefinition></intermediateCatchEvent>
    <userTask id="gm_overdue" name="Delivery overdue: extend or cancel" operaton:candidateGroups="${consigneeSeat}" operaton:formKey="sangam:gem-purchase/overdue"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>lateDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="gm_lateGw" name="" default="gem_purchase_f35"></exclusiveGateway>
    <serviceTask id="gm_terminate_kind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="gm_terminate_call" name="Withdraw (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="gm_terminate_end" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="gm_inspect_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>gm_inspect</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="gm_inspect" name="Inspect and accept (CRAC)" operaton:candidateGroups="${consigneeSeat}" operaton:formKey="sangam:gem-purchase/crac" operaton:dueDate="${gm_inspectDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>cracDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="gm_inspect_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>gm_inspect</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>consigneeSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="gm_inspect_warnEnd" name="Warned"></endEvent>
    <serviceTask id="gm_inspect_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>gm_inspect</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>consigneeSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>cracDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="gm_inspect_breachGw" name="Deemed?" default="gem_purchase_f41"></exclusiveGateway>
    <exclusiveGateway id="gm_inspect_done" name=""></exclusiveGateway>
    <exclusiveGateway id="gm_cracGw" name="" default="gem_purchase_f48"></exclusiveGateway>
    <serviceTask id="gm_rejectGoods" name="Reject goods on GeM" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>gem.rejectGoods</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>reject</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>acceptedQty,receivedQty</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>gemReject</operaton:string></operaton:field><operaton:field name="step"><operaton:string>reject-goods</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="gm_cracDoc" name="CRAC" operaton:class="org.sangam.packs.core.DocumentDelegate"><extensionElements><operaton:field name="template"><operaton:string>crac</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="gm_bill" name="Bill within the payment SLA (P1)" calledElement="sangam-p1-bill-payment"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}/BILL"/><operaton:in source="supplierName" target="payee"/><operaton:in source="supplierAccount" target="account"/><operaton:in source="supplierIfsc" target="ifsc"/><operaton:in source="amount" target="amount"/><operaton:in source="budgetHead" target="budgetHead"/><operaton:in source="approvedPayloadHash" target="sanctionRef"/><operaton:in source="initiatorSeat" target="actingSeat"/><operaton:in source="initiatorPerson" target="initiator"/><operaton:in source="officeId" target="officeId"/><operaton:in sourceExpression="${'3WD'}" target="scrutinySla"/><operaton:in sourceExpression="${'3WD'}" target="sanctionSla"/><operaton:out source="caseState" target="billState"/></extensionElements></callActivity>
    <callActivity id="gm_close" name="Closure (core)" calledElement="sangam-core-closure"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="gm_end" name="Purchased and paid"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="gm_inspect_warn" name="SLA warning (75%)" attachedToRef="gm_inspect" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${gm_inspectWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="gm_inspect_breach" name="SLA breached" attachedToRef="gm_inspect" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${gm_inspectDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="gem_purchase_f1" sourceRef="gm_start" targetRef="gm_defaults"/>
    <sequenceFlow id="gem_purchase_f2" sourceRef="gm_defaults" targetRef="gm_amount"/>
    <sequenceFlow id="gem_purchase_f3" sourceRef="gm_amount" targetRef="gm_mode"/>
    <sequenceFlow id="gem_purchase_f4" sourceRef="gm_mode" targetRef="gm_budget"/>
    <sequenceFlow id="gem_purchase_f5" sourceRef="gm_budget" targetRef="gm_budgetGw"/>
    <sequenceFlow id="gem_purchase_f6" name="yes" sourceRef="gm_budgetGw" targetRef="gm_encumber"><conditionExpression xsi:type="tFormalExpression">${budgetAvailable &gt;= amount}</conditionExpression></sequenceFlow>
    <sequenceFlow id="gem_purchase_f7" sourceRef="gm_rjBudget_reject" targetRef="gm_rjBudget_endRejected"/>
    <sequenceFlow id="gem_purchase_f8" sourceRef="gm_rjBudget_code" targetRef="gm_rjBudget_reject"/>
    <sequenceFlow id="gem_purchase_f9" name="no" sourceRef="gm_budgetGw" targetRef="gm_rjBudget_code"/>
    <sequenceFlow id="gem_purchase_f10" sourceRef="gm_encumber" targetRef="gm_autoGw"/>
    <sequenceFlow id="gem_purchase_f11" name="yes" sourceRef="gm_autoGw" targetRef="gm_autoApprove"><conditionExpression xsi:type="tFormalExpression">${autoApprove}</conditionExpression></sequenceFlow>
    <sequenceFlow id="gem_purchase_f12" name="no" sourceRef="gm_autoGw" targetRef="gm_sanction"/>
    <sequenceFlow id="gem_purchase_f13" sourceRef="gm_rj_reject" targetRef="gm_rj_endRejected"/>
    <sequenceFlow id="gem_purchase_f14" sourceRef="gm_autoApprove" targetRef="gm_modeGw"/>
    <sequenceFlow id="gem_purchase_f15" name="SANCTIONED" sourceRef="gm_sanGw" targetRef="gm_modeGw"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="gem_purchase_f16" name="otherwise" sourceRef="gm_sanGw" targetRef="gm_rj_reject"/>
    <sequenceFlow id="gem_purchase_f17" sourceRef="gm_sanction" targetRef="gm_sanGw"/>
    <sequenceFlow id="gem_purchase_f18" name="bid" sourceRef="gm_modeGw" targetRef="gm_bidDoc"><conditionExpression xsi:type="tFormalExpression">${procurementMode == 'BID' || procurementMode == 'OUTSIDE_GEM'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="gem_purchase_f19" sourceRef="gm_bidDoc" targetRef="gm_bid"/>
    <sequenceFlow id="gem_purchase_f20" name="direct / L1" sourceRef="gm_modeGw" targetRef="gm_order"/>
    <sequenceFlow id="gem_purchase_f21" sourceRef="gm_bid" targetRef="gm_tenderGw"/>
    <sequenceFlow id="gem_purchase_f22" name="awarded" sourceRef="gm_tenderGw" targetRef="gm_order"><conditionExpression xsi:type="tFormalExpression">${tenderOutcome == 'AWARDED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="gem_purchase_f23" name="failed" sourceRef="gm_tenderGw" targetRef="gm_rj_reject"/>
    <sequenceFlow id="gem_purchase_f24" name="DONE" sourceRef="gm_orderGw" targetRef="gm_deliveryDue"><conditionExpression xsi:type="tFormalExpression">${executionOutcome == 'DONE'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="gem_purchase_f25" name="otherwise" sourceRef="gm_orderGw" targetRef="gm_rj_reject"/>
    <sequenceFlow id="gem_purchase_f26" sourceRef="gm_order" targetRef="gm_orderGw"/>
    <sequenceFlow id="gem_purchase_f27" sourceRef="gm_deliveryDue" targetRef="gm_wait"/>
    <sequenceFlow id="gem_purchase_f28" sourceRef="gm_wait" targetRef="gm_delivered"/>
    <sequenceFlow id="gem_purchase_f29" sourceRef="gm_wait" targetRef="gm_late"/>
    <sequenceFlow id="gem_purchase_f30" sourceRef="gm_late" targetRef="gm_overdue"/>
    <sequenceFlow id="gem_purchase_f31" sourceRef="gm_overdue" targetRef="gm_lateGw"/>
    <sequenceFlow id="gem_purchase_f32" name="extend" sourceRef="gm_lateGw" targetRef="gm_deliveryDue"><conditionExpression xsi:type="tFormalExpression">${lateDecision == 'extend'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="gem_purchase_f33" sourceRef="gm_terminate_kind" targetRef="gm_terminate_call"/>
    <sequenceFlow id="gem_purchase_f34" sourceRef="gm_terminate_call" targetRef="gm_terminate_end"/>
    <sequenceFlow id="gem_purchase_f35" name="terminate" sourceRef="gm_lateGw" targetRef="gm_terminate_kind"/>
    <sequenceFlow id="gem_purchase_f36" sourceRef="gm_inspect_warn" targetRef="gm_inspect_warnNotify"/>
    <sequenceFlow id="gem_purchase_f37" sourceRef="gm_inspect_warnNotify" targetRef="gm_inspect_warnEnd"/>
    <sequenceFlow id="gem_purchase_f38" sourceRef="gm_inspect_breach" targetRef="gm_inspect_breachAct"/>
    <sequenceFlow id="gem_purchase_f39" sourceRef="gm_inspect_breachAct" targetRef="gm_inspect_breachGw"/>
    <sequenceFlow id="gem_purchase_f40" name="deemed" sourceRef="gm_inspect_breachGw" targetRef="gm_inspect_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="gem_purchase_f41" name="escalated" sourceRef="gm_inspect_breachGw" targetRef="gm_inspect_slaPlan"/>
    <sequenceFlow id="gem_purchase_f42" sourceRef="gm_inspect_slaPlan" targetRef="gm_inspect"/>
    <sequenceFlow id="gem_purchase_f43" sourceRef="gm_inspect" targetRef="gm_inspect_done"/>
    <sequenceFlow id="gem_purchase_f44" sourceRef="gm_delivered" targetRef="gm_inspect_slaPlan"/>
    <sequenceFlow id="gem_purchase_f45" sourceRef="gm_inspect_done" targetRef="gm_cracGw"/>
    <sequenceFlow id="gem_purchase_f46" name="reject" sourceRef="gm_cracGw" targetRef="gm_rejectGoods"><conditionExpression xsi:type="tFormalExpression">${cracDecision == 'reject'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="gem_purchase_f47" sourceRef="gm_rejectGoods" targetRef="gm_deliveryDue"/>
    <sequenceFlow id="gem_purchase_f48" name="accept" sourceRef="gm_cracGw" targetRef="gm_cracDoc"/>
    <sequenceFlow id="gem_purchase_f49" sourceRef="gm_cracDoc" targetRef="gm_bill"/>
    <sequenceFlow id="gem_purchase_f50" sourceRef="gm_bill" targetRef="gm_close"/>
    <sequenceFlow id="gem_purchase_f51" sourceRef="gm_close" targetRef="gm_end"/>
    <subProcess id="gm_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="gm_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="gm_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="gm_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="gm_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="gem_purchase_f52" sourceRef="gm_withdrawStart" targetRef="gm_withdrawKind"/>
      <sequenceFlow id="gem_purchase_f53" sourceRef="gm_withdrawKind" targetRef="gm_withdrawCall"/>
      <sequenceFlow id="gem_purchase_f54" sourceRef="gm_withdrawCall" targetRef="gm_withdrawEnd"/>
    </subProcess>
    <subProcess id="gm_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="gm_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="gm_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="gm_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="gm_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="gem_purchase_f55" sourceRef="gm_cancelStart" targetRef="gm_cancelKind"/>
      <sequenceFlow id="gem_purchase_f56" sourceRef="gm_cancelKind" targetRef="gm_cancelCall"/>
      <sequenceFlow id="gem_purchase_f57" sourceRef="gm_cancelCall" targetRef="gm_cancelEnd"/>
    </subProcess>
  </process>
  <bpmndi:BPMNDiagram id="gem_purchase_diagram">
    <bpmndi:BPMNPlane id="gem_purchase_plane" bpmnElement="sangam-gem-purchase">
      <bpmndi:BPMNShape id="gm_start_di" bpmnElement="gm_start"><dc:Bounds x="52" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gm_defaults_di" bpmnElement="gm_defaults"><dc:Bounds x="185" y="30" width="100" height="80"/></bpmndi:BPMNShape>
