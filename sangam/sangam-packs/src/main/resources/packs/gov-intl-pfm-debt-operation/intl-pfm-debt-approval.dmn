<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_intl_pfm_debt_approval" name="Approver of debt operations (SYNTHETIC; per country)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <!-- SYNTHETIC: country law or policy. Deploy the confirmed table as a tenant override. -->
  <decision id="intl-pfm-debt-approval" name="Approver of debt operations (SYNTHETIC; per country)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="intl-pfm-debt-approval_t" hitPolicy="FIRST">
      <input id="intl-pfm-debt-approval_i0" label="Debt operation"><inputExpression id="intl-pfm-debt-approval_ie0" typeRef="string"><text>debtOperationType</text></inputExpression></input>
      <output id="intl-pfm-debt-approval_o0" label="Approver seat" name="approverSeat" typeRef="string"/>
      <rule id="intl-pfm-debt-approval_r0"><description>SYNTHETIC</description>
        <inputEntry id="intl-pfm-debt-approval_r0_i0"><text>-</text></inputEntry>
        <outputEntry id="intl-pfm-debt-approval_r0_o0"><text>"FINANCE-MINISTER"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
