    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.intl.pfm-debt-operation</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.2</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>debtOperationType,lenderName,debtAmount,debtCurrency</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="do_start" name="Debt operation proposed" operaton:initiator="initiator" operaton:formKey="sangam:gov-intl-pfm-debt-operation/proposal"></startEvent>
    <serviceTask id="do_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>debtOperationType=BORROWING;debtOfficeSeat=DEBT-OFFICE;legalSeat=LEGAL-ADVISER</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="do_cfg" name="Approver of the operation (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>intl-pfm-debt-approval</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <serviceTask id="do_limit_clear" name="Clear the previous check result" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>authorityRemainingLimit=null</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="do_limit" name="Remaining authority (debt system)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>debt.limit</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>remaining</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>debtOperationType</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>authority</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="do_limitGw" name="Remaining authority (debt system)?" default="intl_pfm_debt_operation_f10"></exclusiveGateway>
    <userTask id="do_limitHold" name="Remaining authority not confirmed: check the debt system" operaton:candidateGroups="${debtOfficeSeat}" operaton:formKey="sangam:gov-intl-pfm-debt-operation/limitHold"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <userTask id="do_aboveLimit" name="Above the remaining authority: record the outcome" operaton:candidateGroups="${debtOfficeSeat}" operaton:formKey="sangam:gov-intl-pfm-debt-operation/above-limit"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <endEvent id="do_endAbove" name="Above the authority"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>ABOVE_AUTHORITY</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <userTask id="do_analysis" name="Sustainability and cost-risk analysis (debt office)" operaton:candidateGroups="${debtOfficeSeat}" operaton:formKey="sangam:gov-intl-pfm-debt-operation/analysis"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <userTask id="do_legal" name="Legal opinion" operaton:candidateGroups="${legalSeat}" operaton:formKey="sangam:gov-intl-pfm-debt-operation/legal"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"><operaton:field name="steps"><operaton:string>do_analysis</operaton:string></operaton:field></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>legalDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="do_legalGw" name="" default="intl_pfm_debt_operation_f14"></exclusiveGateway>
