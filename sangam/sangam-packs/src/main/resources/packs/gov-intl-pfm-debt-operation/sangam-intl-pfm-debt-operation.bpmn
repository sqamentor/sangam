    <sequenceFlow id="intl_pfm_debt_operation_f12" sourceRef="do_legal" targetRef="do_legalGw"/>
    <sequenceFlow id="intl_pfm_debt_operation_f13" name="returned" sourceRef="do_legalGw" targetRef="do_analysis"><conditionExpression xsi:type="tFormalExpression">${legalDecision == 'return'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_debt_operation_f14" name="cleared" sourceRef="do_legalGw" targetRef="do_approve"/>
    <sequenceFlow id="intl_pfm_debt_operation_f15" sourceRef="do_approve" targetRef="do_approveGw"/>
