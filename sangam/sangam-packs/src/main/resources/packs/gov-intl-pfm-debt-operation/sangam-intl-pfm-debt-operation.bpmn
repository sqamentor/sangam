    <serviceTask id="do_record" name="Record in the debt system" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>debt.record</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>record</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>debtOperationType,lenderName,debtAmount,debtCurrency</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>record</operaton:string></operaton:field><operaton:field name="step"><operaton:string>record</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="do_recordGw" name="Record in the debt system?" default="intl_pfm_debt_operation_f22"></exclusiveGateway>
