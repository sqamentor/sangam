    <endEvent id="do_end" name="Approved and recorded"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>APPROVED</operaton:string></operaton:field><operaton:field name="dataVars"><operaton:string>['recordRef']</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <sequenceFlow id="intl_pfm_debt_operation_f1" sourceRef="do_limit_clear" targetRef="do_limit"/>
