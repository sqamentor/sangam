    <sequenceFlow id="intl_pfm_debt_operation_f8" name="above the authority" sourceRef="do_limitGw" targetRef="do_aboveLimit"><conditionExpression xsi:type="tFormalExpression">${authorityRemainingLimit &lt; debtAmount}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_debt_operation_f9" sourceRef="do_aboveLimit" targetRef="do_endAbove"/>
    <sequenceFlow id="intl_pfm_debt_operation_f10" name="within the authority" sourceRef="do_limitGw" targetRef="do_analysis"/>
