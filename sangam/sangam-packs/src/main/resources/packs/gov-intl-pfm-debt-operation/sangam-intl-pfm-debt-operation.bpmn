    <sequenceFlow id="intl_pfm_debt_operation_f20" name="not confirmed" sourceRef="do_recordGw" targetRef="do_recordHold"><conditionExpression xsi:type="tFormalExpression">${recordStatus != 'COMPLETED' || recordRef == null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_debt_operation_f21" name="approved" sourceRef="do_approveGw" targetRef="do_record_clear"/>
    <sequenceFlow id="intl_pfm_debt_operation_f22" name="recorded" sourceRef="do_recordGw" targetRef="do_end"/>
