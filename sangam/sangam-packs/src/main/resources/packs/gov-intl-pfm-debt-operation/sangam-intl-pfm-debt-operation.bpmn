    <sequenceFlow id="intl_pfm_debt_operation_f4" name="not confirmed" sourceRef="do_limitGw" targetRef="do_limitHold"><conditionExpression xsi:type="tFormalExpression">${authorityStatus != 'COMPLETED' || authorityRemainingLimit == null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_debt_operation_f5" sourceRef="do_start" targetRef="do_defaults"/>
