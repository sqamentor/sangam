<!-- New connection. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_sec_util_connection" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_cancelCase" name="sangam.cancelCase"/>
  <message id="msg_sangam_util_firstBill" name="sangam.util.firstBill"/>
  <message id="msg_sangam_withdrawCase" name="sangam.withdrawCase"/>
  <process id="sangam-sec-util-connection" name="New connection" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.util.new-connection</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>applicantName,premisesAddress,loadKw</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="uc_start" name="Application" operaton:initiator="initiator" operaton:formKey="sangam:sec-util-new-connection/apply"></startEvent>
    <serviceTask id="uc_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>areaType=MUNICIPAL;loadKw=5;worksRequired=false;compensationDue=false;scrutinySeat=SUBDIV-CLERK;scrutinySla=1WD;pauseOnClarification=true;executionConnector=pg.collect;executionStep=charges;verifyApproval=false;reconcileRequired=false;executionPayloadFields=applicantName,loadKw;appealAllowed=false</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="uc_sop" name="Standard of performance (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-util-sop</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <serviceTask id="uc_clock" name="Regulatory clock: connection" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>connection</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${connSpec}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <callActivity id="uc_scrutiny" name="Document scrutiny (core)" calledElement="sangam-core-scrutiny"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <callActivity id="uc_rj_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="uc_rj_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <userTask id="uc_inspect" name="Site inspection and feasibility" operaton:candidateGroups="JE-FIELD" operaton:formKey="sangam:sec-util-new-connection/inspect" operaton:dueDate="${connectionDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>feasibility</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="uc_scrGw" name="scrutinyOutcome?" default="sec_util_connection_f7"></exclusiveGateway>
    <exclusiveGateway id="uc_feasGw" name="" default="sec_util_connection_f14"></exclusiveGateway>
    <serviceTask id="uc_rjFeas_code" name="Reason: NOT_FEASIBLE" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=NOT_FEASIBLE</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="uc_rjFeas_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="uc_rjFeas_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <userTask id="uc_estimate" name="Estimate and demand note" operaton:candidateGroups="AE-SUBDIV" operaton:formKey="sangam:sec-util-new-connection/estimate"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <callActivity id="uc_fee" name="Collect charges (core execution)" calledElement="sangam-core-execution"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <userTask id="uc_install" name="Install meter and energise" operaton:candidateGroups="JE-FIELD" operaton:formKey="sangam:sec-util-new-connection/install" operaton:dueDate="${connectionDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="uc_inspect_lateFlag" name="Compensation due" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>compensationDue=true</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="uc_inspect_lateEnd" name="Recorded"></endEvent>
    <serviceTask id="uc_install_lateFlag" name="Compensation due" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>compensationDue=true</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="uc_install_lateEnd" name="Recorded"></endEvent>
    <serviceTask id="uc_mdm" name="Register meter" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>mdm.install</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>register</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>meterNo,applicantName,applicantRef</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>mdm</operaton:string></operaton:field><operaton:field name="step"><operaton:string>meter</operaton:string></operaton:field></extensionElements></serviceTask>
    <eventBasedGateway id="uc_compWait" name="First bill or timeout"></eventBasedGateway>
    <intermediateCatchEvent id="uc_firstBill" name="First bill raised"><messageEventDefinition messageRef="msg_sangam_util_firstBill"/></intermediateCatchEvent>
    <intermediateCatchEvent id="uc_noBill" name="No bill in time"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">P60D</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <serviceTask id="uc_compCfg" name="Compensation credit inputs" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>amount=@compensationAmount</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="uc_comp" name="Credit compensation in the next bill" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>billing.credit</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>credit</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>consumer,amount,head,cycle</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>comp</operaton:string></operaton:field><operaton:field name="step"><operaton:string>compensation</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="uc_compRes" name="Credited?" default="sec_util_connection_f27"></exclusiveGateway>
    <userTask id="uc_compManual" name="Compensation not credited: credit by hand" operaton:candidateGroups="AE-SUBDIV" operaton:formKey="sangam:sec-util-new-connection/compensation-manual"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="uc_compJoin" name=""></exclusiveGateway>
    <exclusiveGateway id="uc_compOptGw" name="Delayed?" default="sec_util_connection_f32"></exclusiveGateway>
    <exclusiveGateway id="uc_compOptMerge" name=""></exclusiveGateway>
    <endEvent id="uc_end" name="Energised"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="uc_inspect_late" name="Standard of performance missed" attachedToRef="uc_inspect" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${connectionDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="uc_install_late" name="Standard of performance missed" attachedToRef="uc_install" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${connectionDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="sec_util_connection_f1" sourceRef="uc_start" targetRef="uc_defaults"/>
    <sequenceFlow id="sec_util_connection_f2" sourceRef="uc_defaults" targetRef="uc_sop"/>
    <sequenceFlow id="sec_util_connection_f3" sourceRef="uc_sop" targetRef="uc_clock"/>
    <sequenceFlow id="sec_util_connection_f4" sourceRef="uc_clock" targetRef="uc_scrutiny"/>
    <sequenceFlow id="sec_util_connection_f5" sourceRef="uc_rj_reject" targetRef="uc_rj_endRejected"/>
    <sequenceFlow id="sec_util_connection_f6" name="ACCEPTED" sourceRef="uc_scrGw" targetRef="uc_inspect"><conditionExpression xsi:type="tFormalExpression">${scrutinyOutcome == 'ACCEPTED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_util_connection_f7" name="otherwise" sourceRef="uc_scrGw" targetRef="uc_rj_reject"/>
    <sequenceFlow id="sec_util_connection_f8" sourceRef="uc_scrutiny" targetRef="uc_scrGw"/>
    <sequenceFlow id="sec_util_connection_f9" sourceRef="uc_inspect" targetRef="uc_feasGw"/>
    <sequenceFlow id="sec_util_connection_f10" sourceRef="uc_rjFeas_reject" targetRef="uc_rjFeas_endRejected"/>
    <sequenceFlow id="sec_util_connection_f11" sourceRef="uc_rjFeas_code" targetRef="uc_rjFeas_reject"/>
    <sequenceFlow id="sec_util_connection_f12" name="not feasible" sourceRef="uc_feasGw" targetRef="uc_rjFeas_code"><conditionExpression xsi:type="tFormalExpression">${feasibility == 'notFeasible'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_util_connection_f13" name="works needed" sourceRef="uc_feasGw" targetRef="uc_estimate"><conditionExpression xsi:type="tFormalExpression">${feasibility == 'worksNeeded'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_util_connection_f14" name="feasible" sourceRef="uc_feasGw" targetRef="uc_fee"/>
    <sequenceFlow id="sec_util_connection_f15" sourceRef="uc_estimate" targetRef="uc_fee"/>
    <sequenceFlow id="sec_util_connection_f16" sourceRef="uc_fee" targetRef="uc_install"/>
    <sequenceFlow id="sec_util_connection_f17" sourceRef="uc_inspect_late" targetRef="uc_inspect_lateFlag"/>
    <sequenceFlow id="sec_util_connection_f18" sourceRef="uc_inspect_lateFlag" targetRef="uc_inspect_lateEnd"/>
    <sequenceFlow id="sec_util_connection_f19" sourceRef="uc_install_late" targetRef="uc_install_lateFlag"/>
    <sequenceFlow id="sec_util_connection_f20" sourceRef="uc_install_lateFlag" targetRef="uc_install_lateEnd"/>
    <sequenceFlow id="sec_util_connection_f21" sourceRef="uc_compWait" targetRef="uc_firstBill"/>
    <sequenceFlow id="sec_util_connection_f22" sourceRef="uc_compWait" targetRef="uc_noBill"/>
    <sequenceFlow id="sec_util_connection_f23" sourceRef="uc_firstBill" targetRef="uc_compCfg"/>
    <sequenceFlow id="sec_util_connection_f24" sourceRef="uc_compCfg" targetRef="uc_comp"/>
    <sequenceFlow id="sec_util_connection_f25" sourceRef="uc_comp" targetRef="uc_compRes"/>
    <sequenceFlow id="sec_util_connection_f26" name="refused (no demand in that cycle yet)" sourceRef="uc_compRes" targetRef="uc_compManual"><conditionExpression xsi:type="tFormalExpression">${compStatus == 'FAILED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_util_connection_f27" name="credited" sourceRef="uc_compRes" targetRef="uc_compJoin"/>
    <sequenceFlow id="sec_util_connection_f28" sourceRef="uc_compManual" targetRef="uc_compJoin"/>
    <sequenceFlow id="sec_util_connection_f29" sourceRef="uc_noBill" targetRef="uc_compManual"/>
    <sequenceFlow id="sec_util_connection_f30" sourceRef="uc_install" targetRef="uc_mdm"/>
    <sequenceFlow id="sec_util_connection_f31" name="yes" sourceRef="uc_compOptGw" targetRef="uc_compWait"><conditionExpression xsi:type="tFormalExpression">${compensationDue}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_util_connection_f32" name="no" sourceRef="uc_compOptGw" targetRef="uc_compOptMerge"/>
    <sequenceFlow id="sec_util_connection_f33" sourceRef="uc_compJoin" targetRef="uc_compOptMerge"/>
    <sequenceFlow id="sec_util_connection_f34" sourceRef="uc_mdm" targetRef="uc_compOptGw"/>
    <sequenceFlow id="sec_util_connection_f35" sourceRef="uc_compOptMerge" targetRef="uc_end"/>
    <subProcess id="uc_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="uc_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="uc_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="uc_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="uc_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="sec_util_connection_f36" sourceRef="uc_withdrawStart" targetRef="uc_withdrawKind"/>
      <sequenceFlow id="sec_util_connection_f37" sourceRef="uc_withdrawKind" targetRef="uc_withdrawCall"/>
      <sequenceFlow id="sec_util_connection_f38" sourceRef="uc_withdrawCall" targetRef="uc_withdrawEnd"/>
    </subProcess>
    <subProcess id="uc_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="uc_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="uc_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="uc_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="uc_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="sec_util_connection_f39" sourceRef="uc_cancelStart" targetRef="uc_cancelKind"/>
      <sequenceFlow id="sec_util_connection_f40" sourceRef="uc_cancelKind" targetRef="uc_cancelCall"/>
      <sequenceFlow id="sec_util_connection_f41" sourceRef="uc_cancelCall" targetRef="uc_cancelEnd"/>
    </subProcess>
  </process>
