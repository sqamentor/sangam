    <sequenceFlow id="p1_bill_payment_f55" name="DONE" sourceRef="p1_exGw" targetRef="p1_close"><conditionExpression xsi:type="tFormalExpression">${executionOutcome == 'DONE'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p1_bill_payment_f56" name="otherwise" sourceRef="p1_exGw" targetRef="p1_correct"/>
    <sequenceFlow id="p1_bill_payment_f57" sourceRef="p1_execute" targetRef="p1_exGw"/>
