    <endEvent id="p1_end" name="Paid and reconciled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <exclusiveGateway id="p1_recommendPrepareGw" name="Document to sign?" default="p1_bill_payment_f73"></exclusiveGateway>
    <userTask id="p1_recommendPrepare" name="Prepare the document to sign" operaton:candidateGroups="${initiatorSeat}" operaton:formKey="sangam:p1-bill-payment/prepare-noting"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.DocumentSlotReadyListener"><operaton:field name="slots"><operaton:string>notingDocumentId:NOTING</operaton:string></operaton:field></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="p1_sanctionPrepareGw" name="Document to sign?" default="p1_bill_payment_f76"></exclusiveGateway>
    <userTask id="p1_sanctionPrepare" name="Prepare the document to sign" operaton:candidateGroups="${initiatorSeat}" operaton:formKey="sangam:p1-bill-payment/prepare-sanction-note"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.DocumentSlotReadyListener"><operaton:field name="slots"><operaton:string>sanctionDocumentId:SANCTION_NOTE</operaton:string></operaton:field></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <boundaryEvent id="p1_invalidated" name="Approval invalidated" attachedToRef="p1_execute" cancelActivity="true"><errorEventDefinition errorRef="err_APPROVAL_INVALIDATED"/></boundaryEvent>
    <sequenceFlow id="p1_bill_payment_f1" sourceRef="p1_start" targetRef="p1_defaults"/>
    <sequenceFlow id="p1_bill_payment_f2" sourceRef="p1_dupCheck_clear" targetRef="p1_dupCheck"/>
    <sequenceFlow id="p1_bill_payment_f3" sourceRef="p1_defaults" targetRef="p1_dupCheck_clear"/>
    <sequenceFlow id="p1_bill_payment_f4" sourceRef="p1_dupCheck" targetRef="p1_dupGw"/>
    <sequenceFlow id="p1_bill_payment_f5" sourceRef="p1_rjDupCheck_reject" targetRef="p1_rjDupCheck_endRejected"/>
    <sequenceFlow id="p1_bill_payment_f6" sourceRef="p1_rjDupCheck_code" targetRef="p1_rjDupCheck_reject"/>
    <sequenceFlow id="p1_bill_payment_f7" name="duplicate check not confirmed" sourceRef="p1_dupGw" targetRef="p1_rjDupCheck_code"><conditionExpression xsi:type="tFormalExpression">${dupStatus != 'COMPLETED' || dupDuplicate == null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p1_bill_payment_f8" name="J-P1-E03" sourceRef="p1_dupGw" targetRef="p1_dupReview"><conditionExpression xsi:type="tFormalExpression">${dupStatus == 'COMPLETED' &amp;&amp; dupDuplicate != null &amp;&amp; (dupDuplicate)}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p1_bill_payment_f9" sourceRef="p1_budget_clear" targetRef="p1_budget"/>
    <sequenceFlow id="p1_bill_payment_f10" name="no duplicate" sourceRef="p1_dupGw" targetRef="p1_budget_clear"/>
    <sequenceFlow id="p1_bill_payment_f11" sourceRef="p1_dupReview" targetRef="p1_dupDecGw"/>
    <sequenceFlow id="p1_bill_payment_f12" name="proceed" sourceRef="p1_dupDecGw" targetRef="p1_budget_clear"><conditionExpression xsi:type="tFormalExpression">${dupDecision == 'proceed'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p1_bill_payment_f13" sourceRef="p1_rjDup_reject" targetRef="p1_rjDup_endRejected"/>
    <sequenceFlow id="p1_bill_payment_f14" sourceRef="p1_rjDup_code" targetRef="p1_rjDup_reject"/>
    <sequenceFlow id="p1_bill_payment_f15" name="reject" sourceRef="p1_dupDecGw" targetRef="p1_rjDup_code"/>
    <sequenceFlow id="p1_bill_payment_f16" sourceRef="p1_budget" targetRef="p1_budgetGw"/>
    <sequenceFlow id="p1_bill_payment_f17" sourceRef="p1_rjBudget_reject" targetRef="p1_rjBudget_endRejected"/>
    <sequenceFlow id="p1_bill_payment_f18" sourceRef="p1_rjBudget_code" targetRef="p1_rjBudget_reject"/>
    <sequenceFlow id="p1_bill_payment_f19" name="budget not confirmed" sourceRef="p1_budgetGw" targetRef="p1_rjBudget_code"><conditionExpression xsi:type="tFormalExpression">${budgetStatus != 'COMPLETED' || budgetAvailable == null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p1_bill_payment_f20" name="yes" sourceRef="p1_budgetGw" targetRef="p1_encumber"><conditionExpression xsi:type="tFormalExpression">${budgetStatus == 'COMPLETED' &amp;&amp; budgetAvailable != null &amp;&amp; (budgetAvailable &gt;= amount)}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p1_bill_payment_f21" name="J-P1-E11" sourceRef="p1_budgetGw" targetRef="p1_budgetShort"/>
    <sequenceFlow id="p1_bill_payment_f22" sourceRef="p1_encumber" targetRef="p1_checker"/>
    <sequenceFlow id="p1_bill_payment_f23" sourceRef="p1_checker" targetRef="p1_checkerSeat"/>
    <sequenceFlow id="p1_bill_payment_f24" sourceRef="p1_checkerSeat" targetRef="p1_scrutiny"/>
    <sequenceFlow id="p1_bill_payment_f25" sourceRef="p1_revise" targetRef="p1_revise_gw"/>
    <sequenceFlow id="p1_bill_payment_f26" name="resubmit" sourceRef="p1_revise_gw" targetRef="p1_revise_version"><conditionExpression xsi:type="tFormalExpression">${p1_reviseDecision == 'resubmit'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p1_bill_payment_f27" sourceRef="p1_revise_version" targetRef="p1_dupCheck_clear"/>
    <sequenceFlow id="p1_bill_payment_f28" sourceRef="p1_revise_wd_kind" targetRef="p1_revise_wd_call"/>
    <sequenceFlow id="p1_bill_payment_f29" sourceRef="p1_revise_wd_call" targetRef="p1_revise_wd_end"/>
    <sequenceFlow id="p1_bill_payment_f30" name="withdraw" sourceRef="p1_revise_gw" targetRef="p1_revise_wd_kind"/>
    <sequenceFlow id="p1_bill_payment_f31" sourceRef="p1_budgetShort" targetRef="p1_revise"/>
    <sequenceFlow id="p1_bill_payment_f32" sourceRef="p1_rj_reject" targetRef="p1_rj_endRejected"/>
    <sequenceFlow id="p1_bill_payment_f33" sourceRef="p1_rjLapsed_reject" targetRef="p1_rjLapsed_endRejected"/>
    <sequenceFlow id="p1_bill_payment_f34" sourceRef="p1_rjLapsed_code" targetRef="p1_rjLapsed_reject"/>
    <sequenceFlow id="p1_bill_payment_f35" name="ACCEPTED" sourceRef="p1_scrGw" targetRef="p1_recommendPrepareGw"><conditionExpression xsi:type="tFormalExpression">${scrutinyOutcome == 'ACCEPTED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p1_bill_payment_f36" name="LAPSED" sourceRef="p1_scrGw" targetRef="p1_rjLapsed_code"><conditionExpression xsi:type="tFormalExpression">${scrutinyOutcome == 'LAPSED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p1_bill_payment_f37" name="otherwise" sourceRef="p1_scrGw" targetRef="p1_rj_reject"/>
    <sequenceFlow id="p1_bill_payment_f38" sourceRef="p1_scrutiny" targetRef="p1_scrGw"/>
    <sequenceFlow id="p1_bill_payment_f39" name="RECOMMENDED" sourceRef="p1_recGw" targetRef="p1_sanctionPrepareGw"><conditionExpression xsi:type="tFormalExpression">${recOutcome == 'RECOMMENDED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p1_bill_payment_f40" name="RETURNED" sourceRef="p1_recGw" targetRef="p1_revise"><conditionExpression xsi:type="tFormalExpression">${recOutcome == 'RETURNED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p1_bill_payment_f41" name="otherwise" sourceRef="p1_recGw" targetRef="p1_rj_reject"/>
    <sequenceFlow id="p1_bill_payment_f42" sourceRef="p1_recommend" targetRef="p1_recGw"/>
    <sequenceFlow id="p1_bill_payment_f43" name="SANCTIONED" sourceRef="p1_sanGw" targetRef="p1_jointGw"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p1_bill_payment_f44" name="RETURNED" sourceRef="p1_sanGw" targetRef="p1_revise"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'RETURNED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p1_bill_payment_f45" name="otherwise" sourceRef="p1_sanGw" targetRef="p1_rj_reject"/>
    <sequenceFlow id="p1_bill_payment_f46" sourceRef="p1_sanction" targetRef="p1_sanGw"/>
    <sequenceFlow id="p1_bill_payment_f47" sourceRef="p1_jointSeats" targetRef="p1_joint"/>
    <sequenceFlow id="p1_bill_payment_f48" name="J-P1-E09" sourceRef="p1_jointGw" targetRef="p1_jointSeats"><conditionExpression xsi:type="tFormalExpression">${amount &gt; jointApprovalThreshold}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p1_bill_payment_f49" name="no" sourceRef="p1_jointGw" targetRef="p1_execute"/>
    <sequenceFlow id="p1_bill_payment_f50" sourceRef="p1_joint" targetRef="p1_jointRes"/>
    <sequenceFlow id="p1_bill_payment_f51" name="approved" sourceRef="p1_jointRes" targetRef="p1_execute"><conditionExpression xsi:type="tFormalExpression">${jointDecision == 'approve'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p1_bill_payment_f52" name="rejected" sourceRef="p1_jointRes" targetRef="p1_rj_reject"/>
