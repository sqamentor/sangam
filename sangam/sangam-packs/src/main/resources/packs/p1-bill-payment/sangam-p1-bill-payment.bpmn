    <sequenceFlow id="p1_bill_payment_f76" name="no DSC signature" sourceRef="p1_sanctionPrepareGw" targetRef="p1_sanction"/>
    <sequenceFlow id="p1_bill_payment_f77" sourceRef="p1_sanctionPrepare" targetRef="p1_sanction"/>
