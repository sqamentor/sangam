    <sequenceFlow id="p1_bill_payment_f59" name="J-P1-E12 correct" sourceRef="p1_correctGw" targetRef="p1_applyFix"><conditionExpression xsi:type="tFormalExpression">${correctDecision == 'correct'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p1_bill_payment_f60" sourceRef="p1_applyFix" targetRef="p1_fixVersion"/>
    <sequenceFlow id="p1_bill_payment_f61" sourceRef="p1_fixVersion" targetRef="p1_recommendPrepareGw"/>
