    <sequenceFlow id="p1_bill_payment_f64" name="withdraw" sourceRef="p1_correctGw" targetRef="p1_wdTreasury_kind"/>
    <sequenceFlow id="p1_bill_payment_f65" sourceRef="p1_close" targetRef="p1_end"/>
    <sequenceFlow id="p1_bill_payment_f72" name="DSC signature needed" sourceRef="p1_recommendPrepareGw" targetRef="p1_recommendPrepare"><conditionExpression xsi:type="tFormalExpression">${execution.getVariable('signEachLevel') == true}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p1_bill_payment_f73" name="no DSC signature" sourceRef="p1_recommendPrepareGw" targetRef="p1_recommend"/>
    <sequenceFlow id="p1_bill_payment_f74" sourceRef="p1_recommendPrepare" targetRef="p1_recommend"/>
