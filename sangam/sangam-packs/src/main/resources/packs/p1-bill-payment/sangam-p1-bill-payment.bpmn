    <serviceTask id="p1_jointSeats" name="Joint approval seats (excluding earlier actors)" operaton:class="org.sangam.packs.core.SeatResolutionDelegate"><extensionElements><operaton:field name="op"><operaton:string>EXCLUDE_ACTORS</operaton:string></operaton:field><operaton:field name="seatsVar"><operaton:string>jointApprovalSeats</operaton:string></operaton:field><operaton:field name="targetVar"><operaton:string>jointSeats</operaton:string></operaton:field><operaton:field name="step"><operaton:string>p1_joint</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="p1_joint" name="Joint approval" operaton:candidateGroups="${jointSeats.split(',')[loopCounter]}" operaton:formKey="sangam:p1-bill-payment/joint-approval"><extensionElements><operaton:properties><operaton:property name="sangam.maxCardinality" value="5"/></operaton:properties><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ApprovalBindingListener"><operaton:field name="decisionVar"><operaton:string>jointDecision</operaton:string></operaton:field><operaton:field name="approveValues"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>JOINT</operaton:string></operaton:field></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>jointDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements><multiInstanceLoopCharacteristics isSequential="false"><loopCardinality xsi:type="tFormalExpression">${jointSeatsCount}</loopCardinality></multiInstanceLoopCharacteristics></userTask>
