<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- Recruitment campaign. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_recruitment_campaign" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_recruit_challenge" name="sangam.recruit.challenge"/>
  <message id="msg_sangam_recruit_vacated" name="sangam.recruit.vacated"/>
  <process id="sangam-recruitment-campaign" name="Recruitment campaign" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.recruitment</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>postName,vacancies</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="rc2_start" name="Requisition" operaton:initiator="initiator" operaton:formKey="sangam:recruitment/requisition"></startEvent>
    <serviceTask id="rc2_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>batchRound=1;scoreRound=1</operaton:string></operaton:field><operaton:field name="defaults"><operaton:string>caseType=RECRUITMENT;amount=0;routingDecisionKey=recruit-authority;applicationWindow=P30D;scrutinyPeriod=P15D;examGap=P30D;challengeWindow=P7D;recruitmentValidity=P365D;challengeCount=0;examCtrlSeat=EXAM-CTRL;expertSeat=EXPERT-PANEL;appealAllowed=false</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="rc2_batchId" name="Campaign id" operaton:expression="${execution.setVariable('batchId', execution.processBusinessKey)}"></serviceTask>
    <callActivity id="rc2_approve" name="Notification approval (core sanction)" calledElement="sangam-core-sanction"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <serviceTask id="rc2_publish" name="Publish notification" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>recruit.publish</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>publish</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>postName,vacancies</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>publish</operaton:string></operaton:field><operaton:field name="step"><operaton:string>publish</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="rc2_rj_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="rc2_rj_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <exclusiveGateway id="rc2_sanGw" name="sanctionOutcome?" default="recruitment_campaign_f6"></exclusiveGateway>
    <serviceTask id="rc2_window" name="Application window (GP-24)" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>applications</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${applicationWindow}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <intermediateCatchEvent id="rc2_closeApps" name="Applications close"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${applicationsDueAt}</timeDate></timerEventDefinition></intermediateCatchEvent>
    <serviceTask id="rc2_closed_notify" name="Notify items: sangam.recruit.applicationsClosed" operaton:class="org.sangam.packs.core.BatchDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>NOTIFY_ITEMS</operaton:string></operaton:field><operaton:field name="messageName"><operaton:string>sangam.recruit.applicationsClosed</operaton:string></operaton:field><operaton:field name="itemsAreBusinessKeys"><operaton:string>true</operaton:string></operaton:field><operaton:field name="chunkSize"><operaton:string>200</operaton:string></operaton:field><operaton:field name="round"><operaton:string>1</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="rc2_closed_notifyGw" name="All notified?" default="recruitment_campaign_f13"></exclusiveGateway>
    <intermediateCatchEvent id="rc2_scrutinyPeriod" name="Scrutiny period"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">${scrutinyPeriod}</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <serviceTask id="rc2_admit_notify" name="Notify items: sangam.recruit.admitCards" operaton:class="org.sangam.packs.core.BatchDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>NOTIFY_ITEMS</operaton:string></operaton:field><operaton:field name="messageName"><operaton:string>sangam.recruit.admitCards</operaton:string></operaton:field><operaton:field name="itemsAreBusinessKeys"><operaton:string>true</operaton:string></operaton:field><operaton:field name="chunkSize"><operaton:string>200</operaton:string></operaton:field><operaton:field name="round"><operaton:string>1</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="rc2_admit_notifyGw" name="All notified?" default="recruitment_campaign_f17"></exclusiveGateway>
    <serviceTask id="rc2_examDate" name="Examination date" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>exam</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${examGap}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <intermediateCatchEvent id="rc2_exam" name="Examination held"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${examDueAt}</timeDate></timerEventDefinition></intermediateCatchEvent>
    <serviceTask id="rc2_prov_notify" name="Notify items: sangam.recruit.scores" operaton:class="org.sangam.packs.core.BatchDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>NOTIFY_ITEMS</operaton:string></operaton:field><operaton:field name="messageName"><operaton:string>sangam.recruit.scores</operaton:string></operaton:field><operaton:field name="itemsAreBusinessKeys"><operaton:string>true</operaton:string></operaton:field><operaton:field name="chunkSize"><operaton:string>200</operaton:string></operaton:field><operaton:field name="round"><operaton:string>1</operaton:string></operaton:field><operaton:field name="roundToOpen"><operaton:string>1</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="rc2_prov_notifyGw" name="All notified?" default="recruitment_campaign_f22"></exclusiveGateway>
    <userTask id="rc2_provKey" name="Publish provisional answer key and results" operaton:candidateGroups="${examCtrlSeat}" operaton:formKey="sangam:recruitment/provisional-key"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="rc2_challengeWindow" name="Challenge window (GP-47)" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>challenge</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${challengeWindow}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <eventBasedGateway id="rc2_challenges" name="Challenges"></eventBasedGateway>
    <intermediateCatchEvent id="rc2_challenge" name="Paid challenge received"><messageEventDefinition messageRef="msg_sangam_recruit_challenge"/></intermediateCatchEvent>
    <serviceTask id="rc2_countChallenge" name="Count" operaton:expression="${execution.setVariable('challengeCount', challengeCount + 1)}"></serviceTask>
    <intermediateCatchEvent id="rc2_challengeClose" name="Challenge window closes"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${challengeDueAt}</timeDate></timerEventDefinition></intermediateCatchEvent>
    <userTask id="rc2_expert" name="Expert review of challenges" operaton:candidateGroups="${expertSeat}" operaton:formKey="sangam:recruitment/expert-review"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>expertVerdict</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="rc2_finalRound" name="Final key: score round 2" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>scoreRound=2</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="rc2_final_notify" name="Notify items: sangam.recruit.scores" operaton:class="org.sangam.packs.core.BatchDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>NOTIFY_ITEMS</operaton:string></operaton:field><operaton:field name="messageName"><operaton:string>sangam.recruit.scores</operaton:string></operaton:field><operaton:field name="itemsAreBusinessKeys"><operaton:string>true</operaton:string></operaton:field><operaton:field name="chunkSize"><operaton:string>200</operaton:string></operaton:field><operaton:field name="round"><operaton:string>1</operaton:string></operaton:field><operaton:field name="roundToOpen"><operaton:string>2</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="rc2_final_notifyGw" name="All notified?" default="recruitment_campaign_f34"></exclusiveGateway>
    <intermediateCatchEvent id="rc2_poll" name="Poll scores"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">PT10M</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <serviceTask id="rc2_aggregate" name="Scores recorded?" operaton:class="org.sangam.packs.core.BatchDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>AGGREGATE</operaton:string></operaton:field><operaton:field name="round"><operaton:string>2</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="rc2_aggGw" name="All scored?" default="recruitment_campaign_f38"></exclusiveGateway>
    <serviceTask id="rc2_merit" name="Merit list with reservation (GP-26)" operaton:class="org.sangam.packs.gov.MeritListDelegate"><extensionElements><operaton:field name="minimumScore"><operaton:string>0</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="rc2_resultDoc" name="Publish result" operaton:class="org.sangam.packs.core.DocumentDelegate"><extensionElements><operaton:field name="template"><operaton:string>recruitment-result</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="rc2_result_notify" name="Notify items: sangam.recruit.result" operaton:class="org.sangam.packs.core.BatchDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>NOTIFY_ITEMS</operaton:string></operaton:field><operaton:field name="messageName"><operaton:string>sangam.recruit.result</operaton:string></operaton:field><operaton:field name="selectedVar"><operaton:string>selectedKeys</operaton:string></operaton:field><operaton:field name="itemsAreBusinessKeys"><operaton:string>true</operaton:string></operaton:field><operaton:field name="chunkSize"><operaton:string>200</operaton:string></operaton:field><operaton:field name="round"><operaton:string>1</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="rc2_result_notifyGw" name="All notified?" default="recruitment_campaign_f43"></exclusiveGateway>
    <serviceTask id="rc2_validity" name="Panel validity" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>panel</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${recruitmentValidity}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <eventBasedGateway id="rc2_waitlist" name="Vacated posts"></eventBasedGateway>
    <intermediateCatchEvent id="rc2_vacated" name="Selected candidate vacated"><messageEventDefinition messageRef="msg_sangam_recruit_vacated"/></intermediateCatchEvent>
    <intermediateCatchEvent id="rc2_panelExpiry" name="Panel expires"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${panelDueAt}</timeDate></timerEventDefinition></intermediateCatchEvent>
    <serviceTask id="rc2_promote" name="Waitlist promotion (GP-28)" operaton:class="org.sangam.packs.gov.WaitlistDelegate"></serviceTask>
    <exclusiveGateway id="rc2_promGw" name="Someone to promote?" default="recruitment_campaign_f52"></exclusiveGateway>
    <serviceTask id="rc2_selectFlag" name="Offer to the promoted candidate" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>promotedSelected=true</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="rc2_tellPromoted" name="Tell the promoted candidate" operaton:class="org.sangam.packs.core.CorrelationDelegate"><extensionElements><operaton:field name="messageName"><operaton:string>sangam.recruit.result</operaton:string></operaton:field><operaton:field name="targetBusinessKey"><operaton:expression>${promotedKey}</operaton:expression></operaton:field><operaton:field name="variables"><operaton:string>promotedSelected:selected</operaton:string></operaton:field><operaton:field name="optional"><operaton:string>true</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="rc2_carry" name="Close the panel (carry-forward recorded in roster)" operaton:class="org.sangam.packs.core.DocumentDelegate"><extensionElements><operaton:field name="template"><operaton:string>recruitment-closure</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="rc2_end" name="Campaign closed"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <sequenceFlow id="recruitment_campaign_f1" sourceRef="rc2_start" targetRef="rc2_defaults"/>
    <sequenceFlow id="recruitment_campaign_f2" sourceRef="rc2_defaults" targetRef="rc2_batchId"/>
    <sequenceFlow id="recruitment_campaign_f3" sourceRef="rc2_batchId" targetRef="rc2_approve"/>
    <sequenceFlow id="recruitment_campaign_f4" sourceRef="rc2_rj_reject" targetRef="rc2_rj_endRejected"/>
    <sequenceFlow id="recruitment_campaign_f5" name="SANCTIONED" sourceRef="rc2_sanGw" targetRef="rc2_publish"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="recruitment_campaign_f6" name="otherwise" sourceRef="rc2_sanGw" targetRef="rc2_rj_reject"/>
    <sequenceFlow id="recruitment_campaign_f7" sourceRef="rc2_approve" targetRef="rc2_sanGw"/>
    <sequenceFlow id="recruitment_campaign_f8" sourceRef="rc2_publish" targetRef="rc2_window"/>
    <sequenceFlow id="recruitment_campaign_f9" sourceRef="rc2_window" targetRef="rc2_closeApps"/>
    <sequenceFlow id="recruitment_campaign_f10" sourceRef="rc2_closed_notify" targetRef="rc2_closed_notifyGw"/>
    <sequenceFlow id="recruitment_campaign_f11" name="next chunk" sourceRef="rc2_closed_notifyGw" targetRef="rc2_closed_notify"><conditionExpression xsi:type="tFormalExpression">${!notifyDone}</conditionExpression></sequenceFlow>
    <sequenceFlow id="recruitment_campaign_f12" sourceRef="rc2_closeApps" targetRef="rc2_closed_notify"/>
    <sequenceFlow id="recruitment_campaign_f13" name="all told" sourceRef="rc2_closed_notifyGw" targetRef="rc2_scrutinyPeriod"/>
    <sequenceFlow id="recruitment_campaign_f14" sourceRef="rc2_admit_notify" targetRef="rc2_admit_notifyGw"/>
    <sequenceFlow id="recruitment_campaign_f15" name="next chunk" sourceRef="rc2_admit_notifyGw" targetRef="rc2_admit_notify"><conditionExpression xsi:type="tFormalExpression">${!notifyDone}</conditionExpression></sequenceFlow>
    <sequenceFlow id="recruitment_campaign_f16" sourceRef="rc2_scrutinyPeriod" targetRef="rc2_admit_notify"/>
    <sequenceFlow id="recruitment_campaign_f17" name="admit cards out" sourceRef="rc2_admit_notifyGw" targetRef="rc2_examDate"/>
    <sequenceFlow id="recruitment_campaign_f18" sourceRef="rc2_examDate" targetRef="rc2_exam"/>
    <sequenceFlow id="recruitment_campaign_f19" sourceRef="rc2_prov_notify" targetRef="rc2_prov_notifyGw"/>
    <sequenceFlow id="recruitment_campaign_f20" name="next chunk" sourceRef="rc2_prov_notifyGw" targetRef="rc2_prov_notify"><conditionExpression xsi:type="tFormalExpression">${!notifyDone}</conditionExpression></sequenceFlow>
    <sequenceFlow id="recruitment_campaign_f21" sourceRef="rc2_exam" targetRef="rc2_prov_notify"/>
    <sequenceFlow id="recruitment_campaign_f22" name="provisional scores requested" sourceRef="rc2_prov_notifyGw" targetRef="rc2_provKey"/>
    <sequenceFlow id="recruitment_campaign_f23" sourceRef="rc2_provKey" targetRef="rc2_challengeWindow"/>
    <sequenceFlow id="recruitment_campaign_f24" sourceRef="rc2_challengeWindow" targetRef="rc2_challenges"/>
    <sequenceFlow id="recruitment_campaign_f25" sourceRef="rc2_challenges" targetRef="rc2_challenge"/>
    <sequenceFlow id="recruitment_campaign_f26" sourceRef="rc2_challenges" targetRef="rc2_challengeClose"/>
    <sequenceFlow id="recruitment_campaign_f27" sourceRef="rc2_challenge" targetRef="rc2_countChallenge"/>
    <sequenceFlow id="recruitment_campaign_f28" sourceRef="rc2_countChallenge" targetRef="rc2_challenges"/>
    <sequenceFlow id="recruitment_campaign_f29" sourceRef="rc2_challengeClose" targetRef="rc2_expert"/>
    <sequenceFlow id="recruitment_campaign_f30" sourceRef="rc2_final_notify" targetRef="rc2_final_notifyGw"/>
    <sequenceFlow id="recruitment_campaign_f31" name="next chunk" sourceRef="rc2_final_notifyGw" targetRef="rc2_final_notify"><conditionExpression xsi:type="tFormalExpression">${!notifyDone}</conditionExpression></sequenceFlow>
    <sequenceFlow id="recruitment_campaign_f32" sourceRef="rc2_expert" targetRef="rc2_finalRound"/>
    <sequenceFlow id="recruitment_campaign_f33" sourceRef="rc2_finalRound" targetRef="rc2_final_notify"/>
    <sequenceFlow id="recruitment_campaign_f34" name="final scores requested" sourceRef="rc2_final_notifyGw" targetRef="rc2_poll"/>
    <sequenceFlow id="recruitment_campaign_f35" sourceRef="rc2_poll" targetRef="rc2_aggregate"/>
    <sequenceFlow id="recruitment_campaign_f36" sourceRef="rc2_aggregate" targetRef="rc2_aggGw"/>
    <sequenceFlow id="recruitment_campaign_f37" name="not yet" sourceRef="rc2_aggGw" targetRef="rc2_poll"><conditionExpression xsi:type="tFormalExpression">${!batchComplete}</conditionExpression></sequenceFlow>
    <sequenceFlow id="recruitment_campaign_f38" name="complete" sourceRef="rc2_aggGw" targetRef="rc2_merit"/>
    <sequenceFlow id="recruitment_campaign_f39" sourceRef="rc2_result_notify" targetRef="rc2_result_notifyGw"/>
    <sequenceFlow id="recruitment_campaign_f40" name="next chunk" sourceRef="rc2_result_notifyGw" targetRef="rc2_result_notify"><conditionExpression xsi:type="tFormalExpression">${!notifyDone}</conditionExpression></sequenceFlow>
    <sequenceFlow id="recruitment_campaign_f41" sourceRef="rc2_merit" targetRef="rc2_resultDoc"/>
    <sequenceFlow id="recruitment_campaign_f42" sourceRef="rc2_resultDoc" targetRef="rc2_result_notify"/>
    <sequenceFlow id="recruitment_campaign_f43" name="results out" sourceRef="rc2_result_notifyGw" targetRef="rc2_validity"/>
    <sequenceFlow id="recruitment_campaign_f44" sourceRef="rc2_validity" targetRef="rc2_waitlist"/>
    <sequenceFlow id="recruitment_campaign_f45" sourceRef="rc2_waitlist" targetRef="rc2_vacated"/>
    <sequenceFlow id="recruitment_campaign_f46" sourceRef="rc2_waitlist" targetRef="rc2_panelExpiry"/>
    <sequenceFlow id="recruitment_campaign_f47" sourceRef="rc2_vacated" targetRef="rc2_promote"/>
    <sequenceFlow id="recruitment_campaign_f48" sourceRef="rc2_promote" targetRef="rc2_promGw"/>
    <sequenceFlow id="recruitment_campaign_f49" name="promote" sourceRef="rc2_promGw" targetRef="rc2_selectFlag"><conditionExpression xsi:type="tFormalExpression">${!waitlistExhausted}</conditionExpression></sequenceFlow>
    <sequenceFlow id="recruitment_campaign_f50" sourceRef="rc2_selectFlag" targetRef="rc2_tellPromoted"/>
    <sequenceFlow id="recruitment_campaign_f51" sourceRef="rc2_tellPromoted" targetRef="rc2_waitlist"/>
    <sequenceFlow id="recruitment_campaign_f52" name="waitlist exhausted" sourceRef="rc2_promGw" targetRef="rc2_waitlist"/>
    <sequenceFlow id="recruitment_campaign_f53" sourceRef="rc2_panelExpiry" targetRef="rc2_carry"/>
    <sequenceFlow id="recruitment_campaign_f54" sourceRef="rc2_carry" targetRef="rc2_end"/>
  </process>
  <bpmndi:BPMNDiagram id="recruitment_campaign_diagram">
    <bpmndi:BPMNPlane id="recruitment_campaign_plane" bpmnElement="sangam-recruitment-campaign">
      <bpmndi:BPMNShape id="rc2_start_di" bpmnElement="rc2_start"><dc:Bounds x="52" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rc2_defaults_di" bpmnElement="rc2_defaults"><dc:Bounds x="185" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rc2_batchId_di" bpmnElement="rc2_batchId"><dc:Bounds x="350" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rc2_approve_di" bpmnElement="rc2_approve"><dc:Bounds x="515" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rc2_publish_di" bpmnElement="rc2_publish"><dc:Bounds x="845" y="155" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rc2_rj_reject_di" bpmnElement="rc2_rj_reject"><dc:Bounds x="845" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rc2_rj_endRejected_di" bpmnElement="rc2_rj_endRejected"><dc:Bounds x="1042" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rc2_sanGw_di" bpmnElement="rc2_sanGw"><dc:Bounds x="705" y="45" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rc2_window_di" bpmnElement="rc2_window"><dc:Bounds x="1010" y="155" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rc2_closeApps_di" bpmnElement="rc2_closeApps"><dc:Bounds x="1207" y="177" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rc2_closed_notify_di" bpmnElement="rc2_closed_notify"><dc:Bounds x="1340" y="155" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rc2_closed_notifyGw_di" bpmnElement="rc2_closed_notifyGw"><dc:Bounds x="1530" y="170" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rc2_scrutinyPeriod_di" bpmnElement="rc2_scrutinyPeriod"><dc:Bounds x="1702" y="177" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rc2_admit_notify_di" bpmnElement="rc2_admit_notify"><dc:Bounds x="1835" y="155" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rc2_admit_notifyGw_di" bpmnElement="rc2_admit_notifyGw"><dc:Bounds x="2025" y="170" width="50" height="50"/></bpmndi:BPMNShape>
