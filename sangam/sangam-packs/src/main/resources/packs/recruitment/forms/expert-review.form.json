{
  "key": "recruitment/expert-review",
  "version": "1.0.0",
  "pack": "gov.recruitment",
  "title": {
    "en": "Expert review of challenges",
    "hi": "चुनौतियों की विशेषज्ञ समीक्षा"
  },
  "caseSummary": {
    "source": "materialFields",
    "label": {
