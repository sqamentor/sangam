    "required": true,
    "options": [
      {
        "value": "accept",
        "label": {
          "en": "Accept",
          "hi": "स्वीकार करें"
        }
      },
      {
        "value": "reject",
        "label": {
          "en": "Reject",
          "hi": "अस्वीकार करें"
        }
      }
