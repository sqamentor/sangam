          },
          {
            "at": "rc2_closeApps",
            "action": "start",
            "process": "sangam-recruitment-application",
            "key": "app-6",
            "vars": {
              "campaignId": "@case",
              "applicantName": "Candidate app-6",
              "applicantRef": "mobile:9XXXXapp-6",
              "dob": "1996-01-06",
              "socialCategory": "UR",
              "qualification": "GRADUATE",
              "pwd": false,
              "sim_exam_score": "score=72"
            }
          },
          {
            "at": "rc2_closeApps",
            "action": "start",
            "process": "sangam-recruitment-application",
            "key": "app-7",
            "vars": {
              "campaignId": "@case",
              "applicantName": "Candidate app-7",
              "applicantRef": "mobile:9XXXXapp-7",
              "dob": "1996-01-07",
              "socialCategory": "OBC",
              "qualification": "GRADUATE",
              "pwd": false,
              "sim_exam_score": "score=65"
            }
          },
          {
            "at": "rc2_closeApps",
            "advance": "P31D"
          },
          {
            "at": "rc2_scrutinyPeriod",
            "advance": "P16D"
          },
          {
            "at": "rc2_exam",
            "advance": "P31D"
          },
          {
            "at": "rc2_challengeClose",
            "advance": "P8D"
          },
          {
            "at": "rc2_poll",
            "advance": "PT11M"
          },
          {
            "at": "ra_declined",
            "case": "app-4",
            "action": "correlate"
          }
        ],
        "expect": {
          "tasks": [
            "ra_dv",
            "ra_dv",
            "ra_dv",
            "ra_dv",
            "ra_dv",
            "ra_dv"
          ],
          "audit": [
            "MERIT_LIST_PREPARED",
            "WAITLIST_PROMOTED"
          ],
          "merit": {
            "selected": [
              "app-1",
              "app-2",
              "app-3",
              "app-5",
              "app-7"
            ],
            "waitlist": [
              "app-6"
            ],
            "promoted": "app-7",
            "allotted": {
