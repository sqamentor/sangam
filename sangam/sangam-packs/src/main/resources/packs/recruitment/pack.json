              "dob": "1996-01-02",
              "socialCategory": "UR",
              "qualification": "GRADUATE",
              "pwd": false,
              "sim_exam_score": "score=85"
            }
          },
          {
            "at": "rc2_closeApps",
            "action": "start",
            "process": "sangam-recruitment-application",
            "key": "app-3",
            "vars": {
              "campaignId": "@case",
              "applicantName": "Candidate app-3",
              "applicantRef": "mobile:9XXXXapp-3",
              "dob": "1996-01-03",
