{
  "id": "gov.recruitment",
  "version": "1.0.3",
  "name": {
    "en": "e-Recruitment",
    "hi": "ई-भर्ती"
  },
  "domain": "e-Recruitment",
  "description": "Notification approved and published; every application is its own case that joins the campaign (GP-08/09) with fee through the gateway (GP-15); eligibility; admit cards in bulk (GP-27); provisional scores, paid challenges to the answer key, expert review and bulk recompute (GP-47); merit list with reservation (GP-26) and roster carried forward (GP-48); document verification; waitlist promotion when a selected candidate declines or fails DV (GP-28) (D-RECRUIT).",
  "mainProcesses": [
    "sangam-recruitment-campaign"
  ],
  "resources": [
    {
      "kind": "BPMN",
      "path": "packs/recruitment/sangam-recruitment-campaign.bpmn"
    },
    {
      "kind": "BPMN",
      "path": "packs/recruitment/sangam-recruitment-application.bpmn"
    },
    {
      "kind": "DMN",
      "path": "packs/recruitment/recruit-fee.dmn"
    },
    {
      "kind": "DMN",
      "path": "packs/recruitment/recruit-eligibility.dmn"
    },
    {
      "kind": "DMN",
      "path": "packs/recruitment/recruit-authority.dmn"
    },
    {
      "kind": "FORM",
      "path": "packs/recruitment/forms/requisition.form.json"
    },
    {
      "kind": "FORM",
      "path": "packs/recruitment/forms/provisional-key.form.json"
    },
    {
      "kind": "FORM",
      "path": "packs/recruitment/forms/expert-review.form.json"
    },
    {
      "kind": "FORM",
      "path": "packs/recruitment/forms/prepare-sanction-note.form.json"
    },
    {
      "kind": "FORM",
      "path": "packs/recruitment/forms/application.form.json"
    },
    {
      "kind": "FORM",
      "path": "packs/recruitment/forms/dv.form.json"
    },
    {
      "kind": "SEED",
      "path": "packs/recruitment/seed.json"
    },
    {
      "kind": "OTHER",
      "path": "packs/recruitment/pack.json"
    }
  ],
  "seed": "packs/recruitment/seed.json",
  "connectors": [
    {
      "id": "recruit.publish",
      "moneyMovement": "NONE",
      "capabilityClass": "b",
      "govTag": "",
      "purpose": "Notification on the recruitment portal"
    },
    {
      "id": "paygov.fee",
      "moneyMovement": "IN",
      "capabilityClass": "b",
      "govTag": "G-PG",
      "purpose": "Application fee"
    },
    {
      "id": "exam.score",
      "moneyMovement": "NONE",
      "capabilityClass": "a",
      "govTag": "",
      "purpose": "Score of a candidate for a key version"
    },
    {
      "id": "docs.render",
      "moneyMovement": "NONE",
      "capabilityClass": "a",
      "govTag": "G-LANG",
      "purpose": "Admit cards and offer letters (external task)"
    }
  ],
  "covers": [
    "D-RECRUIT",
    "GP-08",
    "GP-09",
    "GP-15",
    "GP-24",
    "GP-26",
    "GP-27",
    "GP-28",
    "GP-47",
    "GP-48",
    "GP-33",
    "GP-39",
    "GP-14",
    "VI.5"
  ],
  "acceptance": [
    {
      "id": "GP-47",
      "title": "Answer-key challenge and bulk recompute",
      "refs": [
        "GP-47",
        "GP-09"
      ],
      "given": "provisional scores in round 1",
      "when": "challenges accepted by the expert panel",
      "then": "every application re-fetches its score into round 2; the merit list uses round 2",
      "startVariables": {
        "postName": "Junior Assistant",
        "vacancies": "{\"UR\":3,\"OBC\":1,\"SC\":1}"
      },
      "expectState": null,
      "run": {
        "steps": [
          {
            "at": "rc2_closeApps",
            "action": "start",
            "process": "sangam-recruitment-application",
            "key": "app-1",
            "vars": {
              "campaignId": "@case",
              "applicantName": "Candidate app-1",
              "applicantRef": "mobile:9XXXXapp-1",
              "dob": "1996-01-01",
              "socialCategory": "UR",
              "qualification": "GRADUATE",
              "pwd": false,
              "sim_exam_score": "score=90"
            }
          },
          {
            "at": "rc2_closeApps",
            "action": "start",
            "process": "sangam-recruitment-application",
            "key": "app-2",
            "vars": {
              "campaignId": "@case",
              "applicantName": "Candidate app-2",
              "applicantRef": "mobile:9XXXXapp-2",
              "dob": "1996-01-02",
              "socialCategory": "UR",
              "qualification": "GRADUATE",
              "pwd": false,
              "sim_exam_score": "score=85"
            }
          },
          {
            "at": "rc2_closeApps",
            "action": "start",
            "process": "sangam-recruitment-application",
            "key": "app-3",
            "vars": {
              "campaignId": "@case",
              "applicantName": "Candidate app-3",
              "applicantRef": "mobile:9XXXXapp-3",
              "dob": "1996-01-03",
              "socialCategory": "UR",
              "qualification": "GRADUATE",
              "pwd": false,
              "sim_exam_score": "score=80 @ scoreRound=1 || score=50 @ scoreRound=2"
            }
          },
          {
            "at": "rc2_closeApps",
            "action": "start",
            "process": "sangam-recruitment-application",
            "key": "app-4",
            "vars": {
              "campaignId": "@case",
              "applicantName": "Candidate app-4",
              "applicantRef": "mobile:9XXXXapp-4",
              "dob": "1996-01-04",
              "socialCategory": "OBC",
              "qualification": "GRADUATE",
              "pwd": false,
              "sim_exam_score": "score=70"
            }
          },
          {
            "at": "rc2_closeApps",
            "action": "start",
            "process": "sangam-recruitment-application",
            "key": "app-5",
            "vars": {
              "campaignId": "@case",
              "applicantName": "Candidate app-5",
              "applicantRef": "mobile:9XXXXapp-5",
              "dob": "1996-01-05",
              "socialCategory": "SC",
              "qualification": "GRADUATE",
              "pwd": false,
              "sim_exam_score": "score=60"
            }
          },
          {
            "at": "rc2_closeApps",
            "action": "start",
            "process": "sangam-recruitment-application",
            "key": "app-6",
            "vars": {
              "campaignId": "@case",
              "applicantName": "Candidate app-6",
              "applicantRef": "mobile:9XXXXapp-6",
              "dob": "1996-01-06",
              "socialCategory": "UR",
              "qualification": "GRADUATE",
              "pwd": false,
              "sim_exam_score": "score=75 @ scoreRound=1 || score=95 @ scoreRound=2"
            }
          },
          {
            "at": "rc2_closeApps",
            "advance": "P31D"
          },
          {
            "at": "rc2_scrutinyPeriod",
            "advance": "P16D"
          },
          {
            "at": "rc2_exam",
            "advance": "P31D"
          },
          {
            "at": "rc2_challenge",
            "action": "correlate"
          },
          {
            "at": "rc2_challengeClose",
            "advance": "P8D"
          },
          {
            "at": "rc2_poll",
            "advance": "PT11M"
          }
        ],
        "expect": {
          "tasks": [
            "rc2_provKey",
            "rc2_expert"
          ],
          "audit": [
            "MERIT_LIST_PREPARED"
          ],
          "merit": {
            "selected": [
              "app-6",
              "app-1",
              "app-2",
              "app-4",
              "app-5"
            ],
            "waitlist": [
              "app-3"
            ],
            "scores": {
              "app-6": 95,
              "app-3": 50,
              "app-1": 90
            }
          }
        }
      }
    },
    {
      "id": "GP-28",
      "title": "Waitlist promotion on decline",
      "refs": [
        "GP-28",
        "GP-26"
      ],
      "given": "merit list published",
      "when": "a selected OBC candidate declines the offer",
      "then": "the next waitlisted OBC candidate receives the offer",
      "startVariables": {
        "postName": "Junior Assistant",
        "vacancies": "{\"UR\":3,\"OBC\":1,\"SC\":1}"
      },
      "expectState": null,
      "run": {
        "steps": [
          {
            "at": "rc2_closeApps",
            "action": "start",
            "process": "sangam-recruitment-application",
            "key": "app-1",
            "vars": {
              "campaignId": "@case",
              "applicantName": "Candidate app-1",
              "applicantRef": "mobile:9XXXXapp-1",
              "dob": "1996-01-01",
              "socialCategory": "UR",
              "qualification": "GRADUATE",
              "pwd": false,
              "sim_exam_score": "score=90"
            }
          },
          {
            "at": "rc2_closeApps",
            "action": "start",
            "process": "sangam-recruitment-application",
            "key": "app-2",
            "vars": {
