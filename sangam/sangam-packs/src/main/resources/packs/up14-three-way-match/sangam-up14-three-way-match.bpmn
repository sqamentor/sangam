<!-- UP-14 Three-way match. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_up14_three_way_match" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_supplierResponse" name="sangam.supplierResponse"/>
  <process id="sangam-up14-three-way-match" name="UP-14 Three-way match" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>universal.up14-three-way-match</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>poQty,grnQty,invoiceQty,poPrice,invoicePrice</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="u14_start" name="Invoice received" operaton:initiator="initiator" operaton:formKey="sangam:up14-three-way-match/invoice"></startEvent>
    <serviceTask id="u14_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>apSeat=AP-CLERK;executionConnector=ap.post;executionStep=post;verifyApproval=false;reconcileRequired=false</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="u14_match" name="Match with tolerances (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>up14-tolerance</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <exclusiveGateway id="u14_gw" name="Result?" default="up14_three_way_match_f5"></exclusiveGateway>
    <callActivity id="u14_post" name="Post (core execution)" calledElement="sangam-core-execution"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <userTask id="u14_exception" name="Resolve match exception" operaton:candidateGroups="${apSeat}" operaton:formKey="sangam:up14-three-way-match/exception"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>exceptionDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="u14_eg" name="" default="up14_three_way_match_f11"></exclusiveGateway>
    <serviceTask id="u14_ask" name="Ask supplier to clarify" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>supplier-clarification</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>email</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>supplierName</operaton:string></operaton:field></extensionElements></serviceTask>
    <intermediateCatchEvent id="u14_response" name="Supplier response (credit note / corrected invoice)"><messageEventDefinition messageRef="msg_sangam_supplierResponse"/></intermediateCatchEvent>
    <endEvent id="u14_endRejected" name="Invoice rejected"></endEvent>
    <endEvent id="u14_end" name="Posted"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <sequenceFlow id="up14_three_way_match_f1" sourceRef="u14_start" targetRef="u14_defaults"/>
    <sequenceFlow id="up14_three_way_match_f2" sourceRef="u14_defaults" targetRef="u14_match"/>
    <sequenceFlow id="up14_three_way_match_f3" sourceRef="u14_match" targetRef="u14_gw"/>
    <sequenceFlow id="up14_three_way_match_f4" name="match / within tolerance" sourceRef="u14_gw" targetRef="u14_post"><conditionExpression xsi:type="tFormalExpression">${matchResult != 'EXCEPTION'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="up14_three_way_match_f5" name="exception" sourceRef="u14_gw" targetRef="u14_exception"/>
    <sequenceFlow id="up14_three_way_match_f6" sourceRef="u14_exception" targetRef="u14_eg"/>
    <sequenceFlow id="up14_three_way_match_f7" name="approve" sourceRef="u14_eg" targetRef="u14_post"><conditionExpression xsi:type="tFormalExpression">${exceptionDecision == 'approve'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="up14_three_way_match_f8" name="clarify" sourceRef="u14_eg" targetRef="u14_ask"><conditionExpression xsi:type="tFormalExpression">${exceptionDecision == 'clarify'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="up14_three_way_match_f9" sourceRef="u14_ask" targetRef="u14_response"/>
    <sequenceFlow id="up14_three_way_match_f10" sourceRef="u14_response" targetRef="u14_match"/>
    <sequenceFlow id="up14_three_way_match_f11" name="reject" sourceRef="u14_eg" targetRef="u14_endRejected"/>
    <sequenceFlow id="up14_three_way_match_f12" sourceRef="u14_post" targetRef="u14_end"/>
  </process>
