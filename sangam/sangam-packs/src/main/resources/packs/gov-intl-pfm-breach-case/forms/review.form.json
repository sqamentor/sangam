{
  "key": "gov-intl-pfm-breach-case/review",
  "version": "1.0.0",
  "pack": "gov.intl.pfm-breach-case",
  "title": {
    "en": "Review the breach report (accounting officer)",
    "hi": "उल्लंघन रिपोर्ट की समीक्षा"
  },
  "caseSummary": {
    "source": "materialFields",
    "label": {
      "en": "Case details",
      "hi": "प्रकरण का विवरण"
    }
  },
  "fields": [
    {
      "id": "investigationFindings",
      "type": "text",
      "required": false,
      "label": {
        "en": "Investigation findings and responsibility",
        "hi": "जाँच के निष्कर्ष एवं उत्तरदायित्व"
      }
    },
    {
      "id": "correctiveAction",
      "type": "text",
      "required": false,
      "label": {
        "en": "Corrective action taken",
        "hi": "सुधारात्मक कार्रवाई"
      }
    },
    {
      "id": "remarks",
      "type": "text",
      "required": false,
      "label": {
        "en": "Remarks",
        "hi": "टिप्पणी"
      }
    }
  ],
  "decision": {
    "variable": "reviewDecision",
    "required": true,
    "options": [
      {
        "value": "approve",
        "label": {
          "en": "Approve / sanction",
          "hi": "अनुमोदित / स्वीकृत करें"
        }
      },
      {
        "value": "reject",
        "label": {
          "en": "Reject",
          "hi": "अस्वीकार करें"
        }
      }
    ]
  }
}
