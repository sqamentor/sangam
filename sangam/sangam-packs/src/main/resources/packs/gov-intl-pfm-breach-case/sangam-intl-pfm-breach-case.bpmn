<!-- Budget limit breach case. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_intl_pfm_breach_case" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.2">
  <message id="msg_sangam_cancelCase" name="sangam.cancelCase"/>
  <message id="msg_sangam_withdrawCase" name="sangam.withdrawCase"/>
  <process id="sangam-intl-pfm-breach-case" name="Budget limit breach case" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.2">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.intl.pfm-breach-case</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.2</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>spendingUnit,budgetLine,amount,breachKind</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="bc_start" name="Breach detected" operaton:initiator="initiator" operaton:formKey="sangam:gov-intl-pfm-breach-case/report"></startEvent>
    <serviceTask id="bc_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>spendingUnit=SU-1;budgetLine=GEN-01;amount=0;breachKind=OTHER;investigatorSeat=BREACH-INVESTIGATOR;accountingSeat=ACCOUNTING-OFFICER;budgetOfficeSeat=BUDGET-OFFICE</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="bc_cfg" name="Breach reporting rule (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>intl-pfm-breach-reporting</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <serviceTask id="bc_deadline" name="Regulatory clock: breachReport" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>breachReport</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${breachReportSpec}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <userTask id="bc_investigate" name="Investigate: findings, responsibility and corrective action" operaton:candidateGroups="${investigatorSeat}" operaton:formKey="sangam:gov-intl-pfm-breach-case/investigate" operaton:dueDate="${breachReportDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <userTask id="bc_review" name="Review the breach report (accounting officer)" operaton:candidateGroups="${accountingSeat}" operaton:formKey="sangam:gov-intl-pfm-breach-case/review" operaton:dueDate="${breachReportDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"><operaton:field name="steps"><operaton:string>bc_investigate</operaton:string></operaton:field></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>reviewDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="bc_reviewGw" name="" default="intl_pfm_breach_case_f9"></exclusiveGateway>
    <serviceTask id="bc_send_clear" name="Clear the previous check result" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>reportReceiptRef=null</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="bc_send" name="Report to the configured authorities" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>authority.report</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>report</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>breachAuthorities,breachKind,breachFacts,investigationFindings,correctiveAction</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>report</operaton:string></operaton:field><operaton:field name="step"><operaton:string>breach-report</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="bc_sentGw" name="Report received?" default="intl_pfm_breach_case_f13"></exclusiveGateway>
    <userTask id="bc_sendHold" name="Report not confirmed by the authority: confirm and resend" operaton:candidateGroups="${budgetOfficeSeat}" operaton:formKey="sangam:gov-intl-pfm-breach-case/sendHold"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <endEvent id="bc_end" name="Breach reported"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REPORTED</operaton:string></operaton:field><operaton:field name="dataVars"><operaton:string>['reportReceiptRef']</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <sequenceFlow id="intl_pfm_breach_case_f1" sourceRef="bc_start" targetRef="bc_defaults"/>
    <sequenceFlow id="intl_pfm_breach_case_f2" sourceRef="bc_defaults" targetRef="bc_cfg"/>
    <sequenceFlow id="intl_pfm_breach_case_f3" sourceRef="bc_cfg" targetRef="bc_deadline"/>
    <sequenceFlow id="intl_pfm_breach_case_f4" sourceRef="bc_deadline" targetRef="bc_investigate"/>
    <sequenceFlow id="intl_pfm_breach_case_f5" sourceRef="bc_investigate" targetRef="bc_review"/>
    <sequenceFlow id="intl_pfm_breach_case_f6" sourceRef="bc_review" targetRef="bc_reviewGw"/>
    <sequenceFlow id="intl_pfm_breach_case_f7" name="investigate again" sourceRef="bc_reviewGw" targetRef="bc_investigate"><conditionExpression xsi:type="tFormalExpression">${reviewDecision == 'reject'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_breach_case_f8" sourceRef="bc_send_clear" targetRef="bc_send"/>
    <sequenceFlow id="intl_pfm_breach_case_f9" name="approved" sourceRef="bc_reviewGw" targetRef="bc_send_clear"/>
    <sequenceFlow id="intl_pfm_breach_case_f10" sourceRef="bc_send" targetRef="bc_sentGw"/>
    <sequenceFlow id="intl_pfm_breach_case_f11" sourceRef="bc_sendHold" targetRef="bc_send_clear"/>
    <sequenceFlow id="intl_pfm_breach_case_f12" name="not confirmed" sourceRef="bc_sentGw" targetRef="bc_sendHold"><conditionExpression xsi:type="tFormalExpression">${reportStatus != 'COMPLETED' || reportReceiptRef == null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_breach_case_f13" name="reported" sourceRef="bc_sentGw" targetRef="bc_end"/>
    <subProcess id="bc_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="bc_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="bc_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="bc_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.3"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="bc_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="intl_pfm_breach_case_f14" sourceRef="bc_withdrawStart" targetRef="bc_withdrawKind"/>
      <sequenceFlow id="intl_pfm_breach_case_f15" sourceRef="bc_withdrawKind" targetRef="bc_withdrawCall"/>
      <sequenceFlow id="intl_pfm_breach_case_f16" sourceRef="bc_withdrawCall" targetRef="bc_withdrawEnd"/>
    </subProcess>
    <subProcess id="bc_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="bc_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="bc_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="bc_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.3"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="bc_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="intl_pfm_breach_case_f17" sourceRef="bc_cancelStart" targetRef="bc_cancelKind"/>
      <sequenceFlow id="intl_pfm_breach_case_f18" sourceRef="bc_cancelKind" targetRef="bc_cancelCall"/>
      <sequenceFlow id="intl_pfm_breach_case_f19" sourceRef="bc_cancelCall" targetRef="bc_cancelEnd"/>
    </subProcess>
  </process>
