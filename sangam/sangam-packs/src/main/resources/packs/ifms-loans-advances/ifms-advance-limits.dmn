<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_ifms_advance_limits" name="Advance limits" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="ifms-advance-limits" name="Advance limits" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="ifms-advance-limits_t" hitPolicy="FIRST">
      <input id="ifms-advance-limits_i0" label="Kind"><inputExpression id="ifms-advance-limits_ie0" typeRef="string"><text>advanceKind</text></inputExpression></input>
      <input id="ifms-advance-limits_i1" label="Amount"><inputExpression id="ifms-advance-limits_ie1" typeRef="double"><text>amount</text></inputExpression></input>
      <output id="ifms-advance-limits_o0" label="Allowed" name="advanceAllowed" typeRef="boolean"/>
      <output id="ifms-advance-limits_o1" label="Rule" name="ruleRef" typeRef="string"/>
      <rule id="ifms-advance-limits_r0"><description>placeholder</description>
        <inputEntry id="ifms-advance-limits_r0_i0"><text>"COMPUTER"</text></inputEntry>
        <inputEntry id="ifms-advance-limits_r0_i1"><text>&gt; 50000</text></inputEntry>
        <outputEntry id="ifms-advance-limits_r0_o0"><text>false</text></outputEntry>
        <outputEntry id="ifms-advance-limits_r0_o1"><text>"[U] computer advance ceiling to confirm"</text></outputEntry>
      </rule>
      <rule id="ifms-advance-limits_r1"><description>placeholder</description>
        <inputEntry id="ifms-advance-limits_r1_i0"><text>"HBA"</text></inputEntry>
        <inputEntry id="ifms-advance-limits_r1_i1"><text>&gt; 2500000</text></inputEntry>
        <outputEntry id="ifms-advance-limits_r1_o0"><text>false</text></outputEntry>
        <outputEntry id="ifms-advance-limits_r1_o1"><text>"[U] HBA ceiling (34 x basic pay, max 25 lakh) to confirm"</text></outputEntry>
      </rule>
      <rule id="ifms-advance-limits_r2">
        <inputEntry id="ifms-advance-limits_r2_i0"><text>-</text></inputEntry>
        <inputEntry id="ifms-advance-limits_r2_i1"><text>-</text></inputEntry>
        <outputEntry id="ifms-advance-limits_r2_o0"><text>true</text></outputEntry>
        <outputEntry id="ifms-advance-limits_r2_o1"><text>"Compendium of Rules on Advances [U]"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
