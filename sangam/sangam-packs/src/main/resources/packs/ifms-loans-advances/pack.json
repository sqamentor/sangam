{
  "id": "gov.ifms.loans-advances",
  "version": "1.0.0",
  "name": {
    "en": "Loans and advances to employees",
    "hi": "कर्मचारियों को ऋण और अग्रिम"
  },
  "domain": "IFMS",
  "description": "HBA, computer and short-term advances: eligibility and amount by DMN, sanction, payment bill, recovery schedule as a RECEIVABLE ledger (instalments, interest), closure on full recovery.",
