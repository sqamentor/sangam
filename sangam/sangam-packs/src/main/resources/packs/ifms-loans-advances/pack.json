    "sangam-ifms-advance"
  ],
  "resources": [
    {
      "kind": "BPMN",
      "path": "packs/ifms-loans-advances/sangam-ifms-advance.bpmn"
    },
    {
      "kind": "DMN",
      "path": "packs/ifms-loans-advances/ifms-advance-limits.dmn"
    },
    {
      "kind": "DMN",
      "path": "packs/ifms-loans-advances/ifms-advance-authority.dmn"
    },
    {
      "kind": "FORM",
      "path": "packs/ifms-loans-advances/forms/application.form.json"
    },
    {
      "kind": "SEED",
      "path": "packs/ifms-loans-advances/seed.json"
    }
  ],
  "seed": "packs/ifms-loans-advances/seed.json",
  "connectors": [
    {
      "id": "config.profile",
      "capabilityClass": "a",
      "govTag": "G-CONFIG",
      "purpose": "Profile values of the tenant (sangam-config)"
    },
    {
      "id": "config.documentType",
      "capabilityClass": "a",
      "govTag": "G-CONFIG",
      "purpose": "Document-type catalogue (bill types, forms, chains, rails)"
    },
    {
      "id": "config.classification",
      "capabilityClass": "a",
      "govTag": "G-CONFIG",
      "purpose": "Classification validation (head of account)"
    },
    {
      "id": "config.series",
      "capabilityClass": "a",
      "govTag": "G-CONFIG",
      "purpose": "Number series (token, voucher)"
    },
    {
      "id": "ledger.allocate",
      "capabilityClass": "a",
      "govTag": "G-LEDGER",
      "purpose": "Raise the recovery demand (RECEIVABLE) (sangam-ledger, idempotent by operationId)"
    }
  ],
  "covers": [
    "IFC-180",
    "IFC-107",
    "IFC-210",
    "IFC-025",
    "GP-14",
    "VI.5"
  ],
  "acceptance": [],
