{
  "id": "gov.ifms.reappropriation",
  "version": "1.0.0",
  "name": {
    "en": "Re-appropriation (rule set)",
    "hi": "पुनर्विनियोजन (नियम समूह)"
  },
  "domain": "IFMS",
  "description": "Re-appropriation between lines of one grant and section: restrictions as hard rules with citations (no charged <-> voted, no capital <-> revenue, no NS/NIS, not from a head augmented by a supplementary or a CF-advance activity, works only with AA/TS), the Q1 ban, object-group monetary limits, Finance Ministry / Budget Division cases, C&AG for secret service, Parliament reporting; FA consultation mandatory; posted as a ledger TRANSFER with the same constraints enforced by the ledger. DFPR 2024 defaults; States override the DMN.",
  "mainProcesses": [
    "sangam-ifms-reappropriation"
  ],
  "resources": [
