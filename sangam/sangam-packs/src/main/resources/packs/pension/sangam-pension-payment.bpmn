  <process id="sangam-pension-payment" name="Pension payment for one pensioner" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.pension</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>key,amount,bankAccount,ifsc</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="pp_start" name="Item"></startEvent>
    <serviceTask id="pp_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>lifeCertificateValid=true;executionConnector=pfms.payment;executionStep=pension;verifyApproval=false;reconcileRequired=true;bankAccount=;ifsc=</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="pp_lifeGw" name="Life certificate valid?" default="pension_payment_f4"></exclusiveGateway>
    <userTask id="pp_life" name="Life certificate awaited" operaton:candidateGroups="PAO-P" operaton:formKey="sangam:pension/life-certificate"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>lifeDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <callActivity id="pp_pay" name="Pension payment (core execution)" calledElement="sangam-core-execution"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <exclusiveGateway id="pp_holdGw" name="" default="pension_payment_f7"></exclusiveGateway>
    <endEvent id="pp_endHeld" name="Held"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>HELD</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <endEvent id="pp_endPaid" name="Paid"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <endEvent id="pp_endFailed" name="Failed"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>FAILED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>opReasonCode</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <exclusiveGateway id="pp_exGw" name="executionOutcome?" default="pension_payment_f9"></exclusiveGateway>
    <sequenceFlow id="pension_payment_f1" sourceRef="pp_start" targetRef="pp_defaults"/>
    <sequenceFlow id="pension_payment_f2" sourceRef="pp_defaults" targetRef="pp_lifeGw"/>
    <sequenceFlow id="pension_payment_f3" name="hold" sourceRef="pp_lifeGw" targetRef="pp_life"><conditionExpression xsi:type="tFormalExpression">${!lifeCertificateValid}</conditionExpression></sequenceFlow>
    <sequenceFlow id="pension_payment_f4" name="valid" sourceRef="pp_lifeGw" targetRef="pp_pay"/>
    <sequenceFlow id="pension_payment_f5" sourceRef="pp_life" targetRef="pp_holdGw"/>
    <sequenceFlow id="pension_payment_f6" name="certificate received" sourceRef="pp_holdGw" targetRef="pp_pay"><conditionExpression xsi:type="tFormalExpression">${lifeDecision == 'proceed'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="pension_payment_f7" name="held" sourceRef="pp_holdGw" targetRef="pp_endHeld"/>
    <sequenceFlow id="pension_payment_f8" name="DONE" sourceRef="pp_exGw" targetRef="pp_endPaid"><conditionExpression xsi:type="tFormalExpression">${executionOutcome == 'DONE'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="pension_payment_f9" name="otherwise" sourceRef="pp_exGw" targetRef="pp_endFailed"/>
    <sequenceFlow id="pension_payment_f10" sourceRef="pp_pay" targetRef="pp_exGw"/>
  </process>
