<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_pension_powers" name="Delegated powers by role" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <!-- Pension sanction power (SL-30). CCS (Pension) Rules 2021 r.59 (HoO completes Form 7 and assesses the pension) and r.44(1) (maximum 1,25,000 a month); corpus S45, IFMS-CENTRAL IFC-174 / IFC-179 (verified). -->
  <decision id="pension-powers" name="Delegated powers by role" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="pension-powers_t" hitPolicy="FIRST">
      <input id="pension-powers_i0" label="Seat role"><inputExpression id="pension-powers_ie0" typeRef="string"><text>seatRole</text></inputExpression></input>
      <input id="pension-powers_i1" label="Case type"><inputExpression id="pension-powers_ie1" typeRef="string"><text>caseType</text></inputExpression></input>
      <output id="pension-powers_o0" label="Power limit (INR)" name="powerLimit" typeRef="number"/>
      <output id="pension-powers_o1" label="Allowed" name="allowed" typeRef="boolean"/>
      <rule id="pension-powers_r0"><description>Head of Office: monthly pension up to the r.44(1) maximum (CCS (Pension) Rules 2021 r.59, r.44(1))</description>
        <inputEntry id="pension-powers_r0_i0"><text>"HOO"</text></inputEntry>
        <inputEntry id="pension-powers_r0_i1"><text>"PENSION"</text></inputEntry>
        <outputEntry id="pension-powers_r0_o0"><text>125000</text></outputEntry>
        <outputEntry id="pension-powers_r0_o1"><text>true</text></outputEntry>
      </rule>
      <rule id="pension-powers_r1"><description>no delegated power</description>
        <inputEntry id="pension-powers_r1_i0"><text>-</text></inputEntry>
        <inputEntry id="pension-powers_r1_i1"><text>-</text></inputEntry>
        <outputEntry id="pension-powers_r1_o0"><text>0</text></outputEntry>
        <outputEntry id="pension-powers_r1_o1"><text>false</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
