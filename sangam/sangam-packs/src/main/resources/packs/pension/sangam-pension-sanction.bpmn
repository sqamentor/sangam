  <message id="msg_sangam_cancelCase" name="sangam.cancelCase"/>
  <message id="msg_sangam_withdrawCase" name="sangam.withdrawCase"/>
  <process id="sangam-pension-sanction" name="Pension sanction and PPO" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.2">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.pension</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.2</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>employeeId,qualifyingService,lastPay,pensionAmount</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="ps_start" name="Pension papers initiated" operaton:initiator="initiator" operaton:formKey="sangam:pension/papers"></startEvent>
    <serviceTask id="ps_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>caseType=PENSION;scrutinySeat=PENSION-CLERK;routingDecisionKey=pension-sanction-authority;powersDecisionKey=pension-powers;executionConnector=ag.pensionCase;executionStep=ag;executionOperation=submitPensionCase;reconcileRequired=false;ackWindow=P7D;outputTemplate=ppo;appealAllowed=true;appellateSeat=HOD-P;verifySeat=HOO-P;amount=0;averageEmoluments=0;ageNextBirthday=61</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="ps_compute" name="Pension computation (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>pension-computation</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <serviceTask id="ps_amount" name="Amount for power check" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>amount=@pensionAmount</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="ps_scrutiny" name="Pension section scrutiny (core)" calledElement="sangam-core-scrutiny" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.2"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <serviceTask id="ps_exPension" name="pensionAmount: exact, whole minor units or held (DEC-5)" operaton:class="org.sangam.packs.core.MoneyCalculationDelegate"><extensionElements><operaton:field name="result"><operaton:string>pensionAmount</operaton:string></operaton:field><operaton:field name="op"><operaton:string>EXACT</operaton:string></operaton:field><operaton:field name="formula"><operaton:string>computedPension</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="ps_exPension_heldGw" name="Whole minor units?" default="pension_sanction_f13"></exclusiveGateway>
    <userTask id="ps_exPension_enter" name="Payable pensionAmount: exact value held, rounding rule not configured" operaton:candidateGroups="${scrutinySeat}" operaton:formKey="sangam:pension/payable-pensionAmount"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="ps_exGratuity" name="retirementGratuity: exact, whole minor units or held (DEC-5)" operaton:class="org.sangam.packs.core.MoneyCalculationDelegate"><extensionElements><operaton:field name="result"><operaton:string>retirementGratuity</operaton:string></operaton:field><operaton:field name="op"><operaton:string>EXACT</operaton:string></operaton:field><operaton:field name="formula"><operaton:string>computedGratuity</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="ps_exGratuity_heldGw" name="Whole minor units?" default="pension_sanction_f14"></exclusiveGateway>
    <userTask id="ps_exGratuity_enter" name="Payable retirementGratuity: exact value held, rounding rule not configured" operaton:candidateGroups="${scrutinySeat}" operaton:formKey="sangam:pension/payable-retirementGratuity"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="ps_exFamily" name="familyPension: exact, whole minor units or held (DEC-5)" operaton:class="org.sangam.packs.core.MoneyCalculationDelegate"><extensionElements><operaton:field name="result"><operaton:string>familyPension</operaton:string></operaton:field><operaton:field name="op"><operaton:string>EXACT</operaton:string></operaton:field><operaton:field name="formula"><operaton:string>computedFamilyPension</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="ps_exFamily_heldGw" name="Whole minor units?" default="pension_sanction_f15"></exclusiveGateway>
    <userTask id="ps_exFamily_enter" name="Payable familyPension: exact value held, rounding rule not configured" operaton:candidateGroups="${scrutinySeat}" operaton:formKey="sangam:pension/payable-familyPension"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <callActivity id="ps_rj_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.2"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="ps_rj_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <exclusiveGateway id="ps_rj_appealGw" name="Appeal allowed?" default="pension_sanction_f19"></exclusiveGateway>
    <serviceTask id="ps_verify_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>ps_verify</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>10WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="ps_verify" name="Verify service record" operaton:candidateGroups="${verifySeat}" operaton:formKey="sangam:pension/verify-service" operaton:dueDate="${ps_verifyDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>serviceVerdict</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="ps_verify_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>ps_verify</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>verifySeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="ps_verify_warnEnd" name="Warned"></endEvent>
    <serviceTask id="ps_verify_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>ps_verify</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>verifySeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>serviceVerdict</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="ps_verify_breachGw" name="Deemed?" default="pension_sanction_f25"></exclusiveGateway>
    <exclusiveGateway id="ps_verify_done" name=""></exclusiveGateway>
    <exclusiveGateway id="ps_scrGw" name="scrutinyOutcome?" default="pension_sanction_f31"></exclusiveGateway>
    <serviceTask id="ps_scrGw_lapsedReason" name="Reason: CLARIFICATION_LAPSED" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=CLARIFICATION_LAPSED</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="ps_sanction" name="Head of Office sanction (core)" calledElement="sangam-core-sanction" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.2"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <exclusiveGateway id="ps_verGw" name="" default="pension_sanction_f38"></exclusiveGateway>
    <serviceTask id="ps_rjVerify_code" name="Reason: SERVICE_NOT_VERIFIED" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=SERVICE_NOT_VERIFIED</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="ps_rjVerify_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.2"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="ps_rjVerify_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <exclusiveGateway id="ps_rjVerify_appealGw" name="Appeal allowed?" default="pension_sanction_f36"></exclusiveGateway>
    <serviceTask id="ps_verified" name="Service verified" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>serviceVerified=true</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="ps_ag" name="Authorisation by AG / PAO (core execution)" calledElement="sangam-core-execution" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.2"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <exclusiveGateway id="ps_sanGw" name="sanctionOutcome?" default="pension_sanction_f43"></exclusiveGateway>
    <userTask id="ps_objection" name="Reply to AG objection" operaton:candidateGroups="${initiatorSeat}" operaton:formKey="sangam:pension/objection"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>objDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="ps_ppo" name="Issue PPO" operaton:class="org.sangam.packs.core.DocumentDelegate"><extensionElements><operaton:field name="template"><operaton:string>ppo</operaton:string></operaton:field><operaton:field name="resultVar"><operaton:string>ppoNo</operaton:string></operaton:field><operaton:field name="requireApproval"><operaton:string>true</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="ps_agGw" name="executionOutcome?" default="pension_sanction_f46"></exclusiveGateway>
    <exclusiveGateway id="ps_objGw" name="" default="pension_sanction_f53"></exclusiveGateway>
    <serviceTask id="ps_objVersion" name="Same case, new version (GP-50)" operaton:class="org.sangam.packs.core.CaseRecordDelegate"><extensionElements><operaton:field name="op"><operaton:string>RESUBMIT</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ps_wd_kind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="ps_wd_call" name="Withdraw (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.2"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="ps_wd_end" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="ps_roll" name="Enter in pension roll" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>pension.rollAdd</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>add</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>employeeId,ppoNo,pensionAmount,bankAccount,ifsc</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>roll</operaton:string></operaton:field><operaton:field name="step"><operaton:string>roll</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="ps_close" name="Notify and close (core)" calledElement="sangam-core-closure" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.2"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="ps_end" name="Closed"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="ps_verify_warn" name="SLA warning (75%)" attachedToRef="ps_verify" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${ps_verifyWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="ps_verify_breach" name="SLA breached" attachedToRef="ps_verify" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${ps_verifyDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="pension_sanction_f1" sourceRef="ps_exPension" targetRef="ps_exPension_heldGw"/>
    <sequenceFlow id="pension_sanction_f2" name="held: reviewer enters the amount" sourceRef="ps_exPension_heldGw" targetRef="ps_exPension_enter"><conditionExpression xsi:type="tFormalExpression">${pensionAmountHeld == true}</conditionExpression></sequenceFlow>
    <sequenceFlow id="pension_sanction_f3" sourceRef="ps_exPension_enter" targetRef="ps_exPension"/>
    <sequenceFlow id="pension_sanction_f4" sourceRef="ps_exGratuity" targetRef="ps_exGratuity_heldGw"/>
    <sequenceFlow id="pension_sanction_f5" name="held: reviewer enters the amount" sourceRef="ps_exGratuity_heldGw" targetRef="ps_exGratuity_enter"><conditionExpression xsi:type="tFormalExpression">${retirementGratuityHeld == true}</conditionExpression></sequenceFlow>
    <sequenceFlow id="pension_sanction_f6" sourceRef="ps_exGratuity_enter" targetRef="ps_exGratuity"/>
    <sequenceFlow id="pension_sanction_f7" sourceRef="ps_exFamily" targetRef="ps_exFamily_heldGw"/>
    <sequenceFlow id="pension_sanction_f8" name="held: reviewer enters the amount" sourceRef="ps_exFamily_heldGw" targetRef="ps_exFamily_enter"><conditionExpression xsi:type="tFormalExpression">${familyPensionHeld == true}</conditionExpression></sequenceFlow>
    <sequenceFlow id="pension_sanction_f9" sourceRef="ps_exFamily_enter" targetRef="ps_exFamily"/>
    <sequenceFlow id="pension_sanction_f10" sourceRef="ps_start" targetRef="ps_defaults"/>
    <sequenceFlow id="pension_sanction_f11" sourceRef="ps_defaults" targetRef="ps_compute"/>
    <sequenceFlow id="pension_sanction_f12" sourceRef="ps_compute" targetRef="ps_exPension"/>
    <sequenceFlow id="pension_sanction_f13" name="whole minor units" sourceRef="ps_exPension_heldGw" targetRef="ps_exGratuity"/>
    <sequenceFlow id="pension_sanction_f14" name="whole minor units" sourceRef="ps_exGratuity_heldGw" targetRef="ps_exFamily"/>
    <sequenceFlow id="pension_sanction_f15" name="whole minor units" sourceRef="ps_exFamily_heldGw" targetRef="ps_amount"/>
    <sequenceFlow id="pension_sanction_f16" sourceRef="ps_amount" targetRef="ps_scrutiny"/>
    <sequenceFlow id="pension_sanction_f17" sourceRef="ps_rj_reject" targetRef="ps_rj_appealGw"/>
    <sequenceFlow id="pension_sanction_f18" name="appeal allowed: re-verify" sourceRef="ps_rj_appealGw" targetRef="ps_scrutiny"><conditionExpression xsi:type="tFormalExpression">${rejectionOutcome == 'APPEAL_ALLOWED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="pension_sanction_f19" name="final" sourceRef="ps_rj_appealGw" targetRef="ps_rj_endRejected"/>
    <sequenceFlow id="pension_sanction_f20" sourceRef="ps_verify_warn" targetRef="ps_verify_warnNotify"/>
    <sequenceFlow id="pension_sanction_f21" sourceRef="ps_verify_warnNotify" targetRef="ps_verify_warnEnd"/>
    <sequenceFlow id="pension_sanction_f22" sourceRef="ps_verify_breach" targetRef="ps_verify_breachAct"/>
    <sequenceFlow id="pension_sanction_f23" sourceRef="ps_verify_breachAct" targetRef="ps_verify_breachGw"/>
    <sequenceFlow id="pension_sanction_f24" name="deemed" sourceRef="ps_verify_breachGw" targetRef="ps_verify_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="pension_sanction_f25" name="escalated" sourceRef="ps_verify_breachGw" targetRef="ps_verify_slaPlan"/>
    <sequenceFlow id="pension_sanction_f26" sourceRef="ps_verify_slaPlan" targetRef="ps_verify"/>
    <sequenceFlow id="pension_sanction_f27" sourceRef="ps_verify" targetRef="ps_verify_done"/>
    <sequenceFlow id="pension_sanction_f28" name="ACCEPTED" sourceRef="ps_scrGw" targetRef="ps_verify_slaPlan"><conditionExpression xsi:type="tFormalExpression">${scrutinyOutcome == 'ACCEPTED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="pension_sanction_f29" name="LAPSED" sourceRef="ps_scrGw" targetRef="ps_scrGw_lapsedReason"><conditionExpression xsi:type="tFormalExpression">${scrutinyOutcome == 'LAPSED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="pension_sanction_f30" sourceRef="ps_scrGw_lapsedReason" targetRef="ps_rj_reject"/>
    <sequenceFlow id="pension_sanction_f31" name="otherwise" sourceRef="ps_scrGw" targetRef="ps_rj_reject"/>
    <sequenceFlow id="pension_sanction_f32" sourceRef="ps_scrutiny" targetRef="ps_scrGw"/>
    <sequenceFlow id="pension_sanction_f33" sourceRef="ps_verify_done" targetRef="ps_verGw"/>
    <sequenceFlow id="pension_sanction_f34" sourceRef="ps_rjVerify_reject" targetRef="ps_rjVerify_appealGw"/>
    <sequenceFlow id="pension_sanction_f35" name="appeal allowed: re-verify" sourceRef="ps_rjVerify_appealGw" targetRef="ps_scrutiny"><conditionExpression xsi:type="tFormalExpression">${rejectionOutcome == 'APPEAL_ALLOWED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="pension_sanction_f36" name="final" sourceRef="ps_rjVerify_appealGw" targetRef="ps_rjVerify_endRejected"/>
    <sequenceFlow id="pension_sanction_f37" sourceRef="ps_rjVerify_code" targetRef="ps_rjVerify_reject"/>
    <sequenceFlow id="pension_sanction_f38" name="not verified" sourceRef="ps_verGw" targetRef="ps_rjVerify_code"/>
    <sequenceFlow id="pension_sanction_f39" name="verified" sourceRef="ps_verGw" targetRef="ps_verified"><conditionExpression xsi:type="tFormalExpression">${serviceVerdict == 'verified'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="pension_sanction_f40" sourceRef="ps_verified" targetRef="ps_sanction"/>
    <sequenceFlow id="pension_sanction_f41" name="SANCTIONED" sourceRef="ps_sanGw" targetRef="ps_ag"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="pension_sanction_f42" name="RETURNED" sourceRef="ps_sanGw" targetRef="ps_scrutiny"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'RETURNED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="pension_sanction_f43" name="otherwise" sourceRef="ps_sanGw" targetRef="ps_rj_reject"/>
    <sequenceFlow id="pension_sanction_f44" sourceRef="ps_sanction" targetRef="ps_sanGw"/>
    <sequenceFlow id="pension_sanction_f45" name="DONE" sourceRef="ps_agGw" targetRef="ps_ppo"><conditionExpression xsi:type="tFormalExpression">${executionOutcome == 'DONE'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="pension_sanction_f46" name="otherwise" sourceRef="ps_agGw" targetRef="ps_objection"/>
    <sequenceFlow id="pension_sanction_f47" sourceRef="ps_ag" targetRef="ps_agGw"/>
    <sequenceFlow id="pension_sanction_f48" sourceRef="ps_objection" targetRef="ps_objGw"/>
    <sequenceFlow id="pension_sanction_f49" name="resubmit to AG" sourceRef="ps_objGw" targetRef="ps_objVersion"><conditionExpression xsi:type="tFormalExpression">${objDecision == 'resubmit'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="pension_sanction_f50" sourceRef="ps_objVersion" targetRef="ps_sanction"/>
    <sequenceFlow id="pension_sanction_f51" sourceRef="ps_wd_kind" targetRef="ps_wd_call"/>
    <sequenceFlow id="pension_sanction_f52" sourceRef="ps_wd_call" targetRef="ps_wd_end"/>
    <sequenceFlow id="pension_sanction_f53" name="withdraw" sourceRef="ps_objGw" targetRef="ps_wd_kind"/>
    <sequenceFlow id="pension_sanction_f54" sourceRef="ps_ppo" targetRef="ps_roll"/>
    <sequenceFlow id="pension_sanction_f55" sourceRef="ps_roll" targetRef="ps_close"/>
    <sequenceFlow id="pension_sanction_f56" sourceRef="ps_close" targetRef="ps_end"/>
    <subProcess id="ps_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="ps_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="ps_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="ps_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.2"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="ps_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="pension_sanction_f57" sourceRef="ps_withdrawStart" targetRef="ps_withdrawKind"/>
      <sequenceFlow id="pension_sanction_f58" sourceRef="ps_withdrawKind" targetRef="ps_withdrawCall"/>
      <sequenceFlow id="pension_sanction_f59" sourceRef="ps_withdrawCall" targetRef="ps_withdrawEnd"/>
    </subProcess>
