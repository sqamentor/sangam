  <process id="sangam-pension-monthly" name="Monthly pension disbursement" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.pension</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>period</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="pm_timer" name="Monthly on the 25th"><timerEventDefinition><timeCycle xsi:type="tFormalExpression">0 0 1 25 * ?</timeCycle></timerEventDefinition></startEvent>
    <serviceTask id="pm_load" name="Pension roll" operaton:class="org.sangam.packs.core.BatchDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>LOAD</operaton:string></operaton:field><operaton:field name="connector"><operaton:string>pension.roll</operaton:string></operaton:field><operaton:field name="sampleSize"><operaton:string>3</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="pm_open" name="Open round" operaton:class="org.sangam.packs.core.BatchDelegate"><extensionElements><operaton:field name="op"><operaton:string>OPEN</operaton:string></operaton:field><operaton:field name="itemsVar"><operaton:string>items</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="pm_fanOut" name="Start one instance per item (chunk)" operaton:class="org.sangam.packs.core.BatchDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>FAN_OUT</operaton:string></operaton:field><operaton:field name="itemsVar"><operaton:string>items</operaton:string></operaton:field><operaton:field name="childProcessKey"><operaton:string>sangam-pension-payment</operaton:string></operaton:field><operaton:field name="chunkSize"><operaton:string>200</operaton:string></operaton:field><operaton:field name="inherit"><operaton:string>period</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="pm_fanGw" name="All started?" default="pension_monthly_f5"></exclusiveGateway>
    <intermediateCatchEvent id="pm_poll" name="Poll aggregate"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">PT5M</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <serviceTask id="pm_aggregate" name="Aggregate outcomes" operaton:class="org.sangam.packs.core.BatchDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>AGGREGATE</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="pm_doneGw" name="Round complete?" default="pension_monthly_f10"></exclusiveGateway>
    <serviceTask id="pm_report" name="Disbursement report" operaton:class="org.sangam.packs.core.DocumentDelegate"><extensionElements><operaton:field name="template"><operaton:string>pension-disbursement-report</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="pm_end" name="Month closed"></endEvent>
    <sequenceFlow id="pension_monthly_f1" sourceRef="pm_timer" targetRef="pm_load"/>
    <sequenceFlow id="pension_monthly_f2" sourceRef="pm_open" targetRef="pm_fanOut"/>
    <sequenceFlow id="pension_monthly_f3" sourceRef="pm_fanOut" targetRef="pm_fanGw"/>
    <sequenceFlow id="pension_monthly_f4" name="next chunk" sourceRef="pm_fanGw" targetRef="pm_fanOut"><conditionExpression xsi:type="tFormalExpression">${!fanOutDone}</conditionExpression></sequenceFlow>
    <sequenceFlow id="pension_monthly_f5" name="all started" sourceRef="pm_fanGw" targetRef="pm_poll"/>
    <sequenceFlow id="pension_monthly_f6" sourceRef="pm_poll" targetRef="pm_aggregate"/>
    <sequenceFlow id="pension_monthly_f7" sourceRef="pm_aggregate" targetRef="pm_doneGw"/>
    <sequenceFlow id="pension_monthly_f8" name="not yet" sourceRef="pm_doneGw" targetRef="pm_poll"><conditionExpression xsi:type="tFormalExpression">${!batchComplete}</conditionExpression></sequenceFlow>
    <sequenceFlow id="pension_monthly_f9" sourceRef="pm_load" targetRef="pm_open"/>
    <sequenceFlow id="pension_monthly_f10" name="complete" sourceRef="pm_doneGw" targetRef="pm_report"/>
    <sequenceFlow id="pension_monthly_f11" sourceRef="pm_report" targetRef="pm_end"/>
  </process>
