  <process id="sangam-ifms-year-end-closing" name="Year-end closing" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.ifms.year-end-closing</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>fiscalYear,closingCut</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="yc_start" name="Closing cut opened" operaton:initiator="initiator" operaton:formKey="sangam:ifms-year-end-closing/cut"></startEvent>
    <serviceTask id="yc_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>closingCut=MARCH_PRELIM;paoSeat=PAO-1;caaSeat=SECY-1;executionConnector=accounts.render;executionStep=render;reconcileRequired=false</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="yc_compile_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>yc_compile</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>10WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="yc_compile" name="Compile the cut" operaton:candidateGroups="${paoSeat}" operaton:formKey="sangam:ifms-year-end-closing/compile" operaton:dueDate="${yc_compileDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>compileDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="yc_compile_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>yc_compile</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>paoSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="yc_compile_warnEnd" name="Warned"></endEvent>
    <serviceTask id="yc_compile_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>yc_compile</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>paoSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>compileDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="yc_compile_breachGw" name="Deemed?" default="ifms_year_end_closing_f6"></exclusiveGateway>
    <exclusiveGateway id="yc_compile_done" name=""></exclusiveGateway>
    <serviceTask id="yc_appr" name="Appropriation Accounts from the ledger" operaton:class="org.sangam.packs.core.DocumentDelegate"><extensionElements><operaton:field name="template"><operaton:string>appropriation-accounts</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="yc_sign_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>yc_sign</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>10WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="yc_sign" name="Sign Appropriation Accounts (CAA)" operaton:candidateGroups="${caaSeat}" operaton:formKey="sangam:ifms-year-end-closing/sign" operaton:dueDate="${yc_signDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>signDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="yc_sign_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>yc_sign</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>caaSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="yc_sign_warnEnd" name="Warned"></endEvent>
    <serviceTask id="yc_sign_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>yc_sign</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>caaSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>signDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="yc_sign_breachGw" name="Deemed?" default="ifms_year_end_closing_f14"></exclusiveGateway>
    <exclusiveGateway id="yc_sign_done" name=""></exclusiveGateway>
    <callActivity id="yc_render" name="Render (core execution)" calledElement="sangam-core-execution"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <exclusiveGateway id="yc_signGw" name="" default="ifms_year_end_closing_f23"></exclusiveGateway>
    <endEvent id="yc_end" name="Closed"></endEvent>
    <boundaryEvent id="yc_compile_warn" name="SLA warning (75%)" attachedToRef="yc_compile" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${yc_compileWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="yc_compile_breach" name="SLA breached" attachedToRef="yc_compile" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${yc_compileDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="yc_sign_warn" name="SLA warning (75%)" attachedToRef="yc_sign" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${yc_signWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="yc_sign_breach" name="SLA breached" attachedToRef="yc_sign" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${yc_signDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="ifms_year_end_closing_f1" sourceRef="yc_compile_warn" targetRef="yc_compile_warnNotify"/>
    <sequenceFlow id="ifms_year_end_closing_f2" sourceRef="yc_compile_warnNotify" targetRef="yc_compile_warnEnd"/>
    <sequenceFlow id="ifms_year_end_closing_f3" sourceRef="yc_compile_breach" targetRef="yc_compile_breachAct"/>
    <sequenceFlow id="ifms_year_end_closing_f4" sourceRef="yc_compile_breachAct" targetRef="yc_compile_breachGw"/>
    <sequenceFlow id="ifms_year_end_closing_f5" name="deemed" sourceRef="yc_compile_breachGw" targetRef="yc_compile_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_year_end_closing_f6" name="escalated" sourceRef="yc_compile_breachGw" targetRef="yc_compile_slaPlan"/>
    <sequenceFlow id="ifms_year_end_closing_f7" sourceRef="yc_compile_slaPlan" targetRef="yc_compile"/>
