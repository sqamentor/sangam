    <sequenceFlow id="ifms_year_end_closing_f11" sourceRef="yc_sign_breach" targetRef="yc_sign_breachAct"/>
    <sequenceFlow id="ifms_year_end_closing_f12" sourceRef="yc_sign_breachAct" targetRef="yc_sign_breachGw"/>
    <sequenceFlow id="ifms_year_end_closing_f13" name="deemed" sourceRef="yc_sign_breachGw" targetRef="yc_sign_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_year_end_closing_f14" name="escalated" sourceRef="yc_sign_breachGw" targetRef="yc_sign_slaPlan"/>
    <sequenceFlow id="ifms_year_end_closing_f15" sourceRef="yc_sign_slaPlan" targetRef="yc_sign"/>
    <sequenceFlow id="ifms_year_end_closing_f16" sourceRef="yc_sign" targetRef="yc_sign_done"/>
    <sequenceFlow id="ifms_year_end_closing_f17" sourceRef="yc_start" targetRef="yc_defaults"/>
    <sequenceFlow id="ifms_year_end_closing_f18" sourceRef="yc_defaults" targetRef="yc_compile_slaPlan"/>
    <sequenceFlow id="ifms_year_end_closing_f19" sourceRef="yc_compile_done" targetRef="yc_appr"/>
    <sequenceFlow id="ifms_year_end_closing_f20" sourceRef="yc_appr" targetRef="yc_sign_slaPlan"/>
    <sequenceFlow id="ifms_year_end_closing_f21" sourceRef="yc_sign_done" targetRef="yc_signGw"/>
    <sequenceFlow id="ifms_year_end_closing_f22" name="returned" sourceRef="yc_signGw" targetRef="yc_compile_slaPlan"><conditionExpression xsi:type="tFormalExpression">${signDecision == 'returnBill'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_year_end_closing_f23" name="signed" sourceRef="yc_signGw" targetRef="yc_render"/>
    <sequenceFlow id="ifms_year_end_closing_f24" sourceRef="yc_render" targetRef="yc_end"/>
  </process>
