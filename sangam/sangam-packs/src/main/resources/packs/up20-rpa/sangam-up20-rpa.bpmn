  <error id="err_RPA_SCREEN_FAILURE" name="RPA_SCREEN_FAILURE" errorCode="RPA_SCREEN_FAILURE"/>
  <process id="sangam-up20-rpa" name="UP-20 RPA step" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>universal.up20-rpa</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>description,rpaScript</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="u20_start" name="Work item" operaton:initiator="initiator" operaton:formKey="sangam:up20-rpa/item"></startEvent>
    <serviceTask id="u20_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>rpaScript=legacy-entry;rpaScriptVersion=1.0.0;botPool=unattended;credentialRef=vault:legacy-erp;operatorSeat=BOT-OPERATOR</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="u20_bot" name="Bot runs the legacy screen" operaton:type="external" operaton:topic="sangam.rpa"></serviceTask>
    <userTask id="u20_handle" name="Bot failed: retry or do manually" operaton:candidateGroups="${operatorSeat}" operaton:formKey="sangam:up20-rpa/handle"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>botDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="u20_gw" name="" default="up20_rpa_f6"></exclusiveGateway>
    <userTask id="u20_manual" name="Attended step" operaton:candidateGroups="${operatorSeat}" operaton:formKey="sangam:up20-rpa/manual"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <endEvent id="u20_end" name="Done"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="u20_screenFail" name="Screen failure" attachedToRef="u20_bot" cancelActivity="true"><errorEventDefinition errorRef="err_RPA_SCREEN_FAILURE"/></boundaryEvent>
    <sequenceFlow id="up20_rpa_f1" sourceRef="u20_start" targetRef="u20_defaults"/>
    <sequenceFlow id="up20_rpa_f2" sourceRef="u20_defaults" targetRef="u20_bot"/>
    <sequenceFlow id="up20_rpa_f3" sourceRef="u20_screenFail" targetRef="u20_handle"/>
    <sequenceFlow id="up20_rpa_f4" sourceRef="u20_handle" targetRef="u20_gw"/>
    <sequenceFlow id="up20_rpa_f5" name="retry" sourceRef="u20_gw" targetRef="u20_bot"><conditionExpression xsi:type="tFormalExpression">${botDecision == 'retry'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="up20_rpa_f6" name="manual" sourceRef="u20_gw" targetRef="u20_manual"/>
    <sequenceFlow id="up20_rpa_f7" sourceRef="u20_bot" targetRef="u20_end"/>
    <sequenceFlow id="up20_rpa_f8" sourceRef="u20_manual" targetRef="u20_end"/>
  </process>
