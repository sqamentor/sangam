<!-- Collection transfer deadline. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_intl_pfm_transfer_deadli" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.2">
  <message id="msg_sangam_cancelCase" name="sangam.cancelCase"/>
  <message id="msg_sangam_pfm_tsaCredited" name="sangam.pfm.tsaCredited"/>
  <message id="msg_sangam_withdrawCase" name="sangam.withdrawCase"/>
  <process id="sangam-intl-pfm-transfer-deadline" name="Collection transfer deadline" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.2">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.intl.pfm-transfer-deadline</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.2</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>collectionChannel,collectionRef,collectionAmount</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="td_start" name="Collection reported" operaton:initiator="initiator" operaton:formKey="sangam:gov-intl-pfm-transfer-deadline/collection"></startEvent>
    <serviceTask id="td_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>collectionChannel=AGENT-BANK;treasurySeat=TREASURY-OFFICER;transferLate=false</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="td_cfg" name="Transfer deadline of the channel (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>intl-pfm-transfer-deadline</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <serviceTask id="td_deadline" name="Regulatory clock: transfer" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>transfer</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${transferSpec}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <eventBasedGateway id="td_wait" name="Credited in time?"></eventBasedGateway>
    <intermediateCatchEvent id="td_credited" name="TSA credit reported"><messageEventDefinition messageRef="msg_sangam_pfm_tsaCredited"/></intermediateCatchEvent>
    <intermediateCatchEvent id="td_late" name="Transfer deadline passed"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${transferDueAt}</timeDate></timerEventDefinition></intermediateCatchEvent>
    <serviceTask id="td_lateMark" name="Late transfer" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>transferLate=true</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="td_overdue" name="Transfer overdue: pursue the collecting agent" operaton:candidateGroups="${treasurySeat}" operaton:formKey="sangam:gov-intl-pfm-transfer-deadline/overdue"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <intermediateCatchEvent id="td_creditedLate" name="TSA credit reported (late)"><messageEventDefinition messageRef="msg_sangam_pfm_tsaCredited"/></intermediateCatchEvent>
    <serviceTask id="td_match_clear" name="Clear the previous check result" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>creditAmount=null</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="td_match" name="TSA credit of the collection" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>tsa.credit</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>lookup</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>collectionChannel,collectionRef</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>credit</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="td_matchGw" name="TSA credit of the collection?" default="intl_pfm_transfer_deadli_f18"></exclusiveGateway>
    <userTask id="td_matchHold" name="TSA credit not confirmed: check the bank statement" operaton:candidateGroups="${treasurySeat}" operaton:formKey="sangam:gov-intl-pfm-transfer-deadline/matchHold"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <userTask id="td_mismatch" name="Credit differs from the collection: investigate" operaton:candidateGroups="${treasurySeat}" operaton:formKey="sangam:gov-intl-pfm-transfer-deadline/mismatch"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <endEvent id="td_endDifference" name="Difference recorded"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>DIFFERENCE</operaton:string></operaton:field><operaton:field name="dataVars"><operaton:string>['creditAmount', 'transferLate']</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <endEvent id="td_end" name="Transferred"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>TRANSFERRED</operaton:string></operaton:field><operaton:field name="dataVars"><operaton:string>['creditAmount', 'transferLate']</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <sequenceFlow id="intl_pfm_transfer_deadli_f1" sourceRef="td_start" targetRef="td_defaults"/>
    <sequenceFlow id="intl_pfm_transfer_deadli_f2" sourceRef="td_defaults" targetRef="td_cfg"/>
    <sequenceFlow id="intl_pfm_transfer_deadli_f3" sourceRef="td_cfg" targetRef="td_deadline"/>
    <sequenceFlow id="intl_pfm_transfer_deadli_f4" sourceRef="td_deadline" targetRef="td_wait"/>
    <sequenceFlow id="intl_pfm_transfer_deadli_f5" sourceRef="td_wait" targetRef="td_credited"/>
    <sequenceFlow id="intl_pfm_transfer_deadli_f6" sourceRef="td_wait" targetRef="td_late"/>
    <sequenceFlow id="intl_pfm_transfer_deadli_f7" sourceRef="td_late" targetRef="td_lateMark"/>
    <sequenceFlow id="intl_pfm_transfer_deadli_f8" sourceRef="td_lateMark" targetRef="td_overdue"/>
    <sequenceFlow id="intl_pfm_transfer_deadli_f9" sourceRef="td_overdue" targetRef="td_creditedLate"/>
    <sequenceFlow id="intl_pfm_transfer_deadli_f10" sourceRef="td_match_clear" targetRef="td_match"/>
    <sequenceFlow id="intl_pfm_transfer_deadli_f11" sourceRef="td_match" targetRef="td_matchGw"/>
    <sequenceFlow id="intl_pfm_transfer_deadli_f12" sourceRef="td_matchHold" targetRef="td_match_clear"/>
    <sequenceFlow id="intl_pfm_transfer_deadli_f13" name="not confirmed" sourceRef="td_matchGw" targetRef="td_matchHold"><conditionExpression xsi:type="tFormalExpression">${creditStatus != 'COMPLETED' || creditAmount == null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_transfer_deadli_f14" sourceRef="td_credited" targetRef="td_match_clear"/>
    <sequenceFlow id="intl_pfm_transfer_deadli_f15" sourceRef="td_creditedLate" targetRef="td_match_clear"/>
    <sequenceFlow id="intl_pfm_transfer_deadli_f16" name="difference" sourceRef="td_matchGw" targetRef="td_mismatch"><conditionExpression xsi:type="tFormalExpression">${creditAmount != collectionAmount}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_transfer_deadli_f17" sourceRef="td_mismatch" targetRef="td_endDifference"/>
    <sequenceFlow id="intl_pfm_transfer_deadli_f18" name="credited in full" sourceRef="td_matchGw" targetRef="td_end"/>
    <subProcess id="td_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="td_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="td_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="td_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.3"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="td_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="intl_pfm_transfer_deadli_f19" sourceRef="td_withdrawStart" targetRef="td_withdrawKind"/>
      <sequenceFlow id="intl_pfm_transfer_deadli_f20" sourceRef="td_withdrawKind" targetRef="td_withdrawCall"/>
      <sequenceFlow id="intl_pfm_transfer_deadli_f21" sourceRef="td_withdrawCall" targetRef="td_withdrawEnd"/>
    </subProcess>
    <subProcess id="td_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="td_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="td_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="td_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.3"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="td_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="intl_pfm_transfer_deadli_f22" sourceRef="td_cancelStart" targetRef="td_cancelKind"/>
      <sequenceFlow id="intl_pfm_transfer_deadli_f23" sourceRef="td_cancelKind" targetRef="td_cancelCall"/>
      <sequenceFlow id="intl_pfm_transfer_deadli_f24" sourceRef="td_cancelCall" targetRef="td_cancelEnd"/>
    </subProcess>
  </process>
