<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_leave_yearend" name="EL credit with 300-day cap (synthetic)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="leave-yearend" name="EL credit with 300-day cap (synthetic)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="leave-yearend_t" hitPolicy="FIRST">
      <input id="leave-yearend_i0" label="Balance"><inputExpression id="leave-yearend_ie0" typeRef="number"><text>leaveBalance</text></inputExpression></input>
      <output id="leave-yearend_o0" label="Net credit" name="netCredit" typeRef="number"/>
      <rule id="leave-yearend_r0"><description>at cap: nothing more accrues</description>
        <inputEntry id="leave-yearend_r0_i0"><text>&gt;= 300</text></inputEntry>
        <outputEntry id="leave-yearend_r0_o0"><text>0</text></outputEntry>
      </rule>
      <rule id="leave-yearend_r1"><description>up to the cap</description>
        <inputEntry id="leave-yearend_r1_i0"><text>&gt; 270</text></inputEntry>
        <outputEntry id="leave-yearend_r1_o0"><text>300 - leaveBalance</text></outputEntry>
      </rule>
      <rule id="leave-yearend_r2"><description>30 days a year</description>
        <inputEntry id="leave-yearend_r2_i0"><text>-</text></inputEntry>
        <outputEntry id="leave-yearend_r2_o0"><text>30</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
