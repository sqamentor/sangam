<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_leave_authority" name="Leave sanctioning authority" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="leave-authority" name="Leave sanctioning authority" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="leave-authority_t" hitPolicy="FIRST">
      <input id="leave-authority_i0" label="Route"><inputExpression id="leave-authority_ie0" typeRef="string"><text>leaveRoute</text></inputExpression></input>
      <output id="leave-authority_o0" label="Competent role" name="competentRole" typeRef="string"/>
      <rule id="leave-authority_r0">
        <inputEntry id="leave-authority_r0_i0"><text>"HOD"</text></inputEntry>
        <outputEntry id="leave-authority_r0_o0"><text>"HOD"</text></outputEntry>
      </rule>
      <rule id="leave-authority_r1">
        <inputEntry id="leave-authority_r1_i0"><text>-</text></inputEntry>
        <outputEntry id="leave-authority_r1_o0"><text>"CONTROLLING"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
