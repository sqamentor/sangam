<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_leave" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_cancelCase" name="sangam.cancelCase"/>
  <message id="msg_sangam_withdrawCase" name="sangam.withdrawCase"/>
  <error id="err_INSUFFICIENT_BALANCE" name="INSUFFICIENT_BALANCE" errorCode="INSUFFICIENT_BALANCE"/>
  <process id="sangam-leave" name="Leave application" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.leave</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>employeeId,leaveType,leaveFrom,leaveTo,leaveDays</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="lv_start" name="Leave applied" operaton:initiator="initiator" operaton:formKey="sangam:leave/application"></startEvent>
    <serviceTask id="lv_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>caseType=LEAVE;amount=0;routingDecisionKey=leave-authority;chargeSeat=null;encumbranceLedger=leave;appealAllowed=false;issueOutput=true;outputTemplate=leave-order</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="lv_account" name="Ledger account" operaton:expression="${execution.setVariable('encumbranceAccount', employeeId.concat(':').concat(leaveType))}"></serviceTask>
    <serviceTask id="lv_balance" name="Leave balance (GP-48)" operaton:class="org.sangam.packs.core.LedgerDelegate"><extensionElements><operaton:field name="op"><operaton:string>BALANCE</operaton:string></operaton:field><operaton:field name="ledger"><operaton:string>leave</operaton:string></operaton:field><operaton:field name="account"><operaton:expression>${encumbranceAccount}</operaton:expression></operaton:field><operaton:field name="resultVar"><operaton:string>leaveBalance</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="lv_route" name="Routing (DMN, tenant override GP-37)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>leave-routing</operaton:string></operaton:field><operaton:field name="binding"><operaton:string>latest</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <callActivity id="lv_rj_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="lv_rj_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="lv_auto" name="Auto-approved below threshold (GP-29)" operaton:class="org.sangam.packs.core.CaseRecordDelegate"><extensionElements><operaton:field name="op"><operaton:string>BIND_DEEMED</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="lv_sanction" name="Leave sanction (core)" calledElement="sangam-core-sanction"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <serviceTask id="lv_debit" name="Debit balance" operaton:class="org.sangam.packs.core.LedgerDelegate"><extensionElements><operaton:field name="op"><operaton:string>ENCUMBER</operaton:string></operaton:field><operaton:field name="unit"><operaton:string>DAYS</operaton:string></operaton:field><operaton:field name="ledger"><operaton:string>leave</operaton:string></operaton:field><operaton:field name="account"><operaton:expression>${encumbranceAccount}</operaton:expression></operaton:field><operaton:field name="amount"><operaton:expression>${leaveDays}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <serviceTask id="lv_rjShort_code" name="Reason: INSUFFICIENT_LEAVE_BALANCE" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=INSUFFICIENT_LEAVE_BALANCE</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="lv_rjShort_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="lv_rjShort_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <exclusiveGateway id="lv_routeGw" name="leaveRoute?" default="leave_f10"></exclusiveGateway>
    <exclusiveGateway id="lv_sanGw" name="sanctionOutcome?" default="leave_f14"></exclusiveGateway>
    <serviceTask id="lv_order" name="Leave order" operaton:class="org.sangam.packs.core.DocumentDelegate"><extensionElements><operaton:field name="template"><operaton:string>leave-order</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="lv_chargeGw" name="Charge arrangement?" default="leave_f20"></exclusiveGateway>
    <serviceTask id="lv_charge" name="Create additional charge for the period (GP-18)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>hr.chargeArrangement</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>grant</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>employeeId,chargeSeat,leaveFrom,leaveTo</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>charge</operaton:string></operaton:field><operaton:field name="step"><operaton:string>charge</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="lv_chargeJoin" name=""></exclusiveGateway>
    <intermediateCatchEvent id="lv_leaveEnds" name="Leave ends"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${leaveTo}</timeDate></timerEventDefinition></intermediateCatchEvent>
    <userTask id="lv_joining" name="Submit joining report" operaton:candidateGroups="${initiatorSeat}" operaton:formKey="sangam:leave/joining"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="lv_revert" name="End the additional charge" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>hr.chargeRevert</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>revert</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>employeeId,chargeSeat</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>chargeRevert</operaton:string></operaton:field><operaton:field name="step"><operaton:string>charge-revert</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="lv_close" name="Close (core)" calledElement="sangam-core-closure"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <serviceTask id="lv_noOutput" name="No second order" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>issueOutput=false</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="lv_end" name="Rejoined"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="lv_noBalance" name="Insufficient balance" attachedToRef="lv_debit" cancelActivity="true"><errorEventDefinition errorRef="err_INSUFFICIENT_BALANCE"/></boundaryEvent>
    <sequenceFlow id="leave_f1" sourceRef="lv_start" targetRef="lv_defaults"/>
    <sequenceFlow id="leave_f2" sourceRef="lv_defaults" targetRef="lv_account"/>
    <sequenceFlow id="leave_f3" sourceRef="lv_account" targetRef="lv_balance"/>
    <sequenceFlow id="leave_f4" sourceRef="lv_balance" targetRef="lv_route"/>
    <sequenceFlow id="leave_f5" sourceRef="lv_rj_reject" targetRef="lv_rj_endRejected"/>
    <sequenceFlow id="leave_f6" sourceRef="lv_rjShort_reject" targetRef="lv_rjShort_endRejected"/>
    <sequenceFlow id="leave_f7" sourceRef="lv_rjShort_code" targetRef="lv_rjShort_reject"/>
    <sequenceFlow id="leave_f8" name="AUTO" sourceRef="lv_routeGw" targetRef="lv_auto"><conditionExpression xsi:type="tFormalExpression">${leaveRoute == 'AUTO'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="leave_f9" name="INSUFFICIENT" sourceRef="lv_routeGw" targetRef="lv_rjShort_code"><conditionExpression xsi:type="tFormalExpression">${leaveRoute == 'INSUFFICIENT'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="leave_f10" name="otherwise" sourceRef="lv_routeGw" targetRef="lv_sanction"/>
    <sequenceFlow id="leave_f11" sourceRef="lv_route" targetRef="lv_routeGw"/>
    <sequenceFlow id="leave_f12" sourceRef="lv_auto" targetRef="lv_debit"/>
    <sequenceFlow id="leave_f13" name="SANCTIONED" sourceRef="lv_sanGw" targetRef="lv_debit"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="leave_f14" name="otherwise" sourceRef="lv_sanGw" targetRef="lv_rj_reject"/>
    <sequenceFlow id="leave_f15" sourceRef="lv_sanction" targetRef="lv_sanGw"/>
    <sequenceFlow id="leave_f16" sourceRef="lv_noBalance" targetRef="lv_rjShort_code"/>
    <sequenceFlow id="leave_f17" sourceRef="lv_debit" targetRef="lv_order"/>
    <sequenceFlow id="leave_f18" sourceRef="lv_order" targetRef="lv_chargeGw"/>
    <sequenceFlow id="leave_f19" name="yes" sourceRef="lv_chargeGw" targetRef="lv_charge"><conditionExpression xsi:type="tFormalExpression">${chargeSeat != null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="leave_f20" name="no" sourceRef="lv_chargeGw" targetRef="lv_chargeJoin"/>
    <sequenceFlow id="leave_f21" sourceRef="lv_charge" targetRef="lv_chargeJoin"/>
    <sequenceFlow id="leave_f22" sourceRef="lv_chargeJoin" targetRef="lv_leaveEnds"/>
    <sequenceFlow id="leave_f23" sourceRef="lv_leaveEnds" targetRef="lv_joining"/>
    <sequenceFlow id="leave_f24" sourceRef="lv_joining" targetRef="lv_revert"/>
    <sequenceFlow id="leave_f25" sourceRef="lv_revert" targetRef="lv_noOutput"/>
    <sequenceFlow id="leave_f26" sourceRef="lv_noOutput" targetRef="lv_close"/>
    <sequenceFlow id="leave_f27" sourceRef="lv_close" targetRef="lv_end"/>
    <subProcess id="lv_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="lv_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="lv_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="lv_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="lv_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="leave_f28" sourceRef="lv_withdrawStart" targetRef="lv_withdrawKind"/>
      <sequenceFlow id="leave_f29" sourceRef="lv_withdrawKind" targetRef="lv_withdrawCall"/>
      <sequenceFlow id="leave_f30" sourceRef="lv_withdrawCall" targetRef="lv_withdrawEnd"/>
    </subProcess>
    <subProcess id="lv_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="lv_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="lv_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="lv_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="lv_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="leave_f31" sourceRef="lv_cancelStart" targetRef="lv_cancelKind"/>
      <sequenceFlow id="leave_f32" sourceRef="lv_cancelKind" targetRef="lv_cancelCall"/>
      <sequenceFlow id="leave_f33" sourceRef="lv_cancelCall" targetRef="lv_cancelEnd"/>
    </subProcess>
  </process>
