<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_leave_routing" name="Leave routing (central rules, synthetic)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <!-- GP-37: the state-b tenant deploys its own version from overrides/state-b. -->
  <decision id="leave-routing" name="Leave routing (central rules, synthetic)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="leave-routing_t" hitPolicy="FIRST">
      <input id="leave-routing_i0" label="Leave type"><inputExpression id="leave-routing_ie0" typeRef="string"><text>leaveType</text></inputExpression></input>
      <input id="leave-routing_i1" label="Days"><inputExpression id="leave-routing_ie1" typeRef="integer"><text>leaveDays</text></inputExpression></input>
      <input id="leave-routing_i2" label="Balance"><inputExpression id="leave-routing_ie2" typeRef="double"><text>leaveBalance</text></inputExpression></input>
      <output id="leave-routing_o0" label="Route" name="leaveRoute" typeRef="string"/>
      <output id="leave-routing_o1" label="Note" name="note" typeRef="string"/>
      <rule id="leave-routing_r0"><description>casual leave up to 3 days: auto (GP-29)</description>
        <inputEntry id="leave-routing_r0_i0"><text>"CL"</text></inputEntry>
        <inputEntry id="leave-routing_r0_i1"><text>&lt;= 3</text></inputEntry>
        <inputEntry id="leave-routing_r0_i2"><text>-</text></inputEntry>
        <outputEntry id="leave-routing_r0_o0"><text>"AUTO"</text></outputEntry>
        <outputEntry id="leave-routing_r0_o1"><text>""</text></outputEntry>
      </rule>
      <rule id="leave-routing_r1"><description>balance short</description>
        <inputEntry id="leave-routing_r1_i0"><text>-</text></inputEntry>
        <inputEntry id="leave-routing_r1_i1"><text>-</text></inputEntry>
        <inputEntry id="leave-routing_r1_i2"><text>&lt; leaveDays</text></inputEntry>
        <outputEntry id="leave-routing_r1_o0"><text>"INSUFFICIENT"</text></outputEntry>
        <outputEntry id="leave-routing_r1_o1"><text>""</text></outputEntry>
      </rule>
      <rule id="leave-routing_r2">
        <inputEntry id="leave-routing_r2_i0"><text>"EL"</text></inputEntry>
        <inputEntry id="leave-routing_r2_i1"><text>&lt;= 30</text></inputEntry>
        <inputEntry id="leave-routing_r2_i2"><text>-</text></inputEntry>
        <outputEntry id="leave-routing_r2_o0"><text>"CONTROLLING"</text></outputEntry>
        <outputEntry id="leave-routing_r2_o1"><text>""</text></outputEntry>
      </rule>
      <rule id="leave-routing_r3"><description>longer leave to the head of department</description>
        <inputEntry id="leave-routing_r3_i0"><text>-</text></inputEntry>
        <inputEntry id="leave-routing_r3_i1"><text>-</text></inputEntry>
        <inputEntry id="leave-routing_r3_i2"><text>-</text></inputEntry>
        <outputEntry id="leave-routing_r3_o0"><text>"HOD"</text></outputEntry>
        <outputEntry id="leave-routing_r3_o1"><text>""</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
