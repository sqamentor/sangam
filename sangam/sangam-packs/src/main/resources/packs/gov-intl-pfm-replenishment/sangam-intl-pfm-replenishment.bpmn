      <bpmndi:BPMNEdge id="intl_pfm_replenishment_f1_di" bpmnElement="intl_pfm_replenishment_f1"><di:waypoint x="88" y="70"/><di:waypoint x="185" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="intl_pfm_replenishment_f2_di" bpmnElement="intl_pfm_replenishment_f2"><di:waypoint x="285" y="70"/><di:waypoint x="350" y="70"/></bpmndi:BPMNEdge>
