      <bpmndi:BPMNShape id="rp_cancelKind_di" bpmnElement="rp_cancelKind"><dc:Bounds x="225" y="765" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rp_cancelCall_di" bpmnElement="rp_cancelCall"><dc:Bounds x="390" y="765" width="100" height="80"/></bpmndi:BPMNShape>
