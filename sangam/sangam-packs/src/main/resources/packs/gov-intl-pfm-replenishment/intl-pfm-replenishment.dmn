<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_intl_pfm_replenishment" name="Expected replenishment period (SYNTHETIC; per agreement)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <!-- SYNTHETIC: country law or policy. Deploy the confirmed table as a tenant override. -->
  <decision id="intl-pfm-replenishment" name="Expected replenishment period (SYNTHETIC; per agreement)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.1">
    <decisionTable id="intl-pfm-replenishment_t" hitPolicy="FIRST">
      <input id="intl-pfm-replenishment_i0" label="Project"><inputExpression id="intl-pfm-replenishment_ie0" typeRef="string"><text>projectId</text></inputExpression></input>
      <output id="intl-pfm-replenishment_o0" label="Receipt expected within" name="receiptSpec" typeRef="string"/>
      <rule id="intl-pfm-replenishment_r0"><description>SYNTHETIC</description>
        <inputEntry id="intl-pfm-replenishment_r0_i0"><text>-</text></inputEntry>
        <outputEntry id="intl-pfm-replenishment_r0_o0"><text>"30D"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
