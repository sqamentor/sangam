      "decision": "intl-pfm-replenishment",
      "rule": "SYNTHETIC 30-day receipt period",
      "reason": "replenishment period of the financing agreement not verified (PFM-062, PFM-CH-6)"
    }
  ],
  "money": {
    "unit": "MINOR",
    "currency": "USD",
    "exponent": 2,
    "variables": [
      "claimAmount",
      "creditAmount"
    ]
  }
