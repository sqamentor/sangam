{
  "key": "gov-intl-pfm-replenishment/revise",
  "version": "1.0.1",
  "pack": "gov.intl.pfm-replenishment",
  "title": {
    "en": "Correct the withdrawal application",
    "hi": "आवेदन सुधारें"
  },
  "caseSummary": {
    "source": "materialFields",
    "label": {
      "en": "Case details",
      "hi": "प्रकरण का विवरण"
    }
  },
  "fields": [
    {
      "id": "claimAmount",
      "type": "money",
      "currency": "USD",
      "exponent": 2,
      "required": true,
      "label": {
        "en": "Claim amount",
        "hi": "दावा राशि"
      }
    },
    {
      "id": "soeRef",
      "type": "string",
      "required": true,
      "label": {
        "en": "Statement of expenditure reference",
        "hi": "व्यय विवरण संदर्भ"
      }
    },
    {
      "id": "documents",
      "type": "attachments",
      "required": false,
      "label": {
        "en": "Documents",
        "hi": "दस्तावेज़"
      }
    },
    {
      "id": "remarks",
      "type": "text",
      "required": false,
      "label": {
        "en": "Remarks",
        "hi": "टिप्पणी"
      }
    }
  ],
  "decision": {
    "variable": "rp_reviseDecision",
    "required": true,
    "options": [
      {
        "value": "resubmit",
        "label": {
          "en": "Resubmit",
          "hi": "पुनः प्रस्तुत करें"
        }
      },
      {
        "value": "withdraw",
        "label": {
          "en": "Withdraw",
          "hi": "वापस लें"
        }
      }
    ]
  }
}
