<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_intl_pfm_report_calendar" name="Report due dates (SYNTHETIC; per country)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <!-- SYNTHETIC: country law or policy. Deploy the confirmed table as a tenant override. -->
  <decision id="intl-pfm-report-calendar" name="Report due dates (SYNTHETIC; per country)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.2">
    <decisionTable id="intl-pfm-report-calendar_t" hitPolicy="FIRST">
      <input id="intl-pfm-report-calendar_i0" label="Report set"><inputExpression id="intl-pfm-report-calendar_ie0" typeRef="string"><text>reportSet</text></inputExpression></input>
      <output id="intl-pfm-report-calendar_o0" label="Report due within" name="reportDueSpec" typeRef="string"/>
      <rule id="intl-pfm-report-calendar_r0"><description>SYNTHETIC</description>
        <inputEntry id="intl-pfm-report-calendar_r0_i0"><text>-</text></inputEntry>
        <outputEntry id="intl-pfm-report-calendar_r0_o0"><text>"15D"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
