<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- Standard budget execution report. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_intl_pfm_standard_report" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.1">
  <message id="msg_sangam_cancelCase" name="sangam.cancelCase"/>
  <message id="msg_sangam_withdrawCase" name="sangam.withdrawCase"/>
  <process id="sangam-intl-pfm-standard-reports" name="Standard budget execution report" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.1">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.intl.pfm-standard-reports</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.1</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>reportSet,reportPeriod,ledgerId</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="sr_start" name="Report period closed" operaton:initiator="initiator" operaton:formKey="sangam:gov-intl-pfm-standard-reports/period"></startEvent>
    <serviceTask id="sr_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>ledgerId=BUDGET;reportSet=MONTHLY;preparerSeat=ACCOUNTS-OFFICER;reviewerSeat=ACCOUNTING-OFFICER</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="sr_cfg" name="Report due date (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>intl-pfm-report-calendar</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <serviceTask id="sr_due" name="Regulatory clock: report" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>report</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${reportDueSpec}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <serviceTask id="sr_extract_clear" name="Clear the previous check result" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>extractDatasetRef=null</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="sr_extract" name="Ledger extract" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>ledger.report</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>report</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>ledgerId,reportSet,reportPeriod</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>extract</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="sr_extractGw" name="Ledger extract?" default="intl_pfm_standard_report_f9"></exclusiveGateway>
    <userTask id="sr_extractHold" name="Ledger extract not confirmed: check the ledger" operaton:candidateGroups="${preparerSeat}" operaton:formKey="sangam:gov-intl-pfm-standard-reports/extractHold"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <userTask id="sr_prepare" name="Prepare the report and explain variances" operaton:candidateGroups="${preparerSeat}" operaton:formKey="sangam:gov-intl-pfm-standard-reports/prepare" operaton:dueDate="${reportDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <userTask id="sr_review" name="Approve the report (not the preparer)" operaton:candidateGroups="${reviewerSeat}" operaton:formKey="sangam:gov-intl-pfm-standard-reports/review" operaton:dueDate="${reportDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"><operaton:field name="steps"><operaton:string>sr_prepare</operaton:string></operaton:field></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>reviewDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="sr_reviewGw" name="" default="intl_pfm_standard_report_f13"></exclusiveGateway>
    <serviceTask id="sr_doc" name="Issue the report" operaton:class="org.sangam.packs.core.DocumentDelegate"><extensionElements><operaton:field name="template"><operaton:string>budget-execution-report</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="sr_end" name="Report issued"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>ISSUED</operaton:string></operaton:field><operaton:field name="dataVars"><operaton:string>['extractDatasetRef']</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <sequenceFlow id="intl_pfm_standard_report_f1" sourceRef="sr_extract_clear" targetRef="sr_extract"/>
    <sequenceFlow id="intl_pfm_standard_report_f2" sourceRef="sr_extract" targetRef="sr_extractGw"/>
    <sequenceFlow id="intl_pfm_standard_report_f3" sourceRef="sr_extractHold" targetRef="sr_extract_clear"/>
    <sequenceFlow id="intl_pfm_standard_report_f4" name="not confirmed" sourceRef="sr_extractGw" targetRef="sr_extractHold"><conditionExpression xsi:type="tFormalExpression">${extractStatus != 'COMPLETED' || extractDatasetRef == null}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_standard_report_f5" sourceRef="sr_start" targetRef="sr_defaults"/>
    <sequenceFlow id="intl_pfm_standard_report_f6" sourceRef="sr_defaults" targetRef="sr_cfg"/>
    <sequenceFlow id="intl_pfm_standard_report_f7" sourceRef="sr_cfg" targetRef="sr_due"/>
    <sequenceFlow id="intl_pfm_standard_report_f8" sourceRef="sr_due" targetRef="sr_extract_clear"/>
    <sequenceFlow id="intl_pfm_standard_report_f9" name="confirmed" sourceRef="sr_extractGw" targetRef="sr_prepare"/>
    <sequenceFlow id="intl_pfm_standard_report_f10" sourceRef="sr_prepare" targetRef="sr_review"/>
    <sequenceFlow id="intl_pfm_standard_report_f11" sourceRef="sr_review" targetRef="sr_reviewGw"/>
    <sequenceFlow id="intl_pfm_standard_report_f12" name="returned" sourceRef="sr_reviewGw" targetRef="sr_prepare"><conditionExpression xsi:type="tFormalExpression">${reviewDecision == 'return'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_standard_report_f13" name="approved" sourceRef="sr_reviewGw" targetRef="sr_doc"/>
    <sequenceFlow id="intl_pfm_standard_report_f14" sourceRef="sr_doc" targetRef="sr_end"/>
    <subProcess id="sr_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="sr_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="sr_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="sr_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.2"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="sr_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="intl_pfm_standard_report_f15" sourceRef="sr_withdrawStart" targetRef="sr_withdrawKind"/>
      <sequenceFlow id="intl_pfm_standard_report_f16" sourceRef="sr_withdrawKind" targetRef="sr_withdrawCall"/>
      <sequenceFlow id="intl_pfm_standard_report_f17" sourceRef="sr_withdrawCall" targetRef="sr_withdrawEnd"/>
    </subProcess>
    <subProcess id="sr_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="sr_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="sr_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="sr_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.2"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="sr_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="intl_pfm_standard_report_f18" sourceRef="sr_cancelStart" targetRef="sr_cancelKind"/>
      <sequenceFlow id="intl_pfm_standard_report_f19" sourceRef="sr_cancelKind" targetRef="sr_cancelCall"/>
      <sequenceFlow id="intl_pfm_standard_report_f20" sourceRef="sr_cancelCall" targetRef="sr_cancelEnd"/>
    </subProcess>
  </process>
  <bpmndi:BPMNDiagram id="intl_pfm_standard_report_diagram">
    <bpmndi:BPMNPlane id="intl_pfm_standard_report_plane" bpmnElement="sangam-intl-pfm-standard-reports">
      <bpmndi:BPMNShape id="sr_start_di" bpmnElement="sr_start"><dc:Bounds x="52" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sr_defaults_di" bpmnElement="sr_defaults"><dc:Bounds x="185" y="30" width="100" height="80"/></bpmndi:BPMNShape>
