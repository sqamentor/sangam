      <bpmndi:BPMNShape id="sr_review_di" bpmnElement="sr_review"><dc:Bounds x="1340" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sr_reviewGw_di" bpmnElement="sr_reviewGw"><dc:Bounds x="1530" y="45" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sr_doc_di" bpmnElement="sr_doc"><dc:Bounds x="1670" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sr_end_di" bpmnElement="sr_end"><dc:Bounds x="1867" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sr_withdraw_di" bpmnElement="sr_withdraw" isExpanded="true"><dc:Bounds x="30" y="285" width="623" height="150"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sr_withdrawStart_di" bpmnElement="sr_withdrawStart"><dc:Bounds x="92" y="347" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sr_withdrawKind_di" bpmnElement="sr_withdrawKind"><dc:Bounds x="225" y="325" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sr_withdrawCall_di" bpmnElement="sr_withdrawCall"><dc:Bounds x="390" y="325" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sr_withdrawEnd_di" bpmnElement="sr_withdrawEnd"><dc:Bounds x="587" y="347" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sr_cancel_di" bpmnElement="sr_cancel" isExpanded="true"><dc:Bounds x="30" y="475" width="623" height="150"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sr_cancelStart_di" bpmnElement="sr_cancelStart"><dc:Bounds x="92" y="537" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sr_cancelKind_di" bpmnElement="sr_cancelKind"><dc:Bounds x="225" y="515" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sr_cancelCall_di" bpmnElement="sr_cancelCall"><dc:Bounds x="390" y="515" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sr_cancelEnd_di" bpmnElement="sr_cancelEnd"><dc:Bounds x="587" y="537" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="intl_pfm_standard_report_f1_di" bpmnElement="intl_pfm_standard_report_f1"><di:waypoint x="780" y="70"/><di:waypoint x="845" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="intl_pfm_standard_report_f2_di" bpmnElement="intl_pfm_standard_report_f2"><di:waypoint x="945" y="70"/><di:waypoint x="1035" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="intl_pfm_standard_report_f3_di" bpmnElement="intl_pfm_standard_report_f3"><di:waypoint x="1225" y="235"/><di:waypoint x="1225" y="267"/><di:waypoint x="730" y="267"/><di:waypoint x="730" y="110"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="intl_pfm_standard_report_f4_di" bpmnElement="intl_pfm_standard_report_f4"><di:waypoint x="1085" y="70"/><di:waypoint x="1130" y="70"/><di:waypoint x="1130" y="195"/><di:waypoint x="1175" y="195"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="intl_pfm_standard_report_f5_di" bpmnElement="intl_pfm_standard_report_f5"><di:waypoint x="88" y="70"/><di:waypoint x="185" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="intl_pfm_standard_report_f6_di" bpmnElement="intl_pfm_standard_report_f6"><di:waypoint x="285" y="70"/><di:waypoint x="350" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="intl_pfm_standard_report_f7_di" bpmnElement="intl_pfm_standard_report_f7"><di:waypoint x="450" y="70"/><di:waypoint x="515" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="intl_pfm_standard_report_f8_di" bpmnElement="intl_pfm_standard_report_f8"><di:waypoint x="615" y="70"/><di:waypoint x="680" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="intl_pfm_standard_report_f9_di" bpmnElement="intl_pfm_standard_report_f9"><di:waypoint x="1085" y="70"/><di:waypoint x="1175" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="intl_pfm_standard_report_f10_di" bpmnElement="intl_pfm_standard_report_f10"><di:waypoint x="1275" y="70"/><di:waypoint x="1340" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="intl_pfm_standard_report_f11_di" bpmnElement="intl_pfm_standard_report_f11"><di:waypoint x="1440" y="70"/><di:waypoint x="1530" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="intl_pfm_standard_report_f12_di" bpmnElement="intl_pfm_standard_report_f12"><di:waypoint x="1555" y="95"/><di:waypoint x="1555" y="149"/><di:waypoint x="1225" y="149"/><di:waypoint x="1225" y="110"/></bpmndi:BPMNEdge>
