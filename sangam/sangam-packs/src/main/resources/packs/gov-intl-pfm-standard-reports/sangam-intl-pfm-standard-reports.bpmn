      <bpmndi:BPMNShape id="sr_due_di" bpmnElement="sr_due"><dc:Bounds x="515" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sr_extract_clear_di" bpmnElement="sr_extract_clear"><dc:Bounds x="680" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sr_extract_di" bpmnElement="sr_extract"><dc:Bounds x="845" y="30" width="100" height="80"/></bpmndi:BPMNShape>
