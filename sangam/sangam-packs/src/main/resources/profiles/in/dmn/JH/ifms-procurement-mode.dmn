<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_ifms_procurement_mode" name="Procurement mode by value (JH)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <!-- Procurement rule pack family per profile (IFS-031). JH -->
  <decision id="ifms-procurement-mode" name="Procurement mode by value (JH)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="ifms-procurement-mode_t" hitPolicy="FIRST">
      <input id="ifms-procurement-mode_i0" label="Estimated value (INR)"><inputExpression id="ifms-procurement-mode_ie0" typeRef="double"><text>amount</text></inputExpression></input>
      <input id="ifms-procurement-mode_i1" label="Scientific department"><inputExpression id="ifms-procurement-mode_ie1" typeRef="boolean"><text>scientificDepartment</text></inputExpression></input>
      <output id="ifms-procurement-mode_o0" label="Procurement mode" name="procurementMode" typeRef="string"/>
      <output id="ifms-procurement-mode_o1" label="Rule" name="ruleRef" typeRef="string"/>
      <rule id="ifms-procurement-mode_r0"><description>[U] central default, replace from Jharkhand Financial Rules 2025 Ch.7 (r.165 GeM) (was: GFR 2017 r.154 / r.149 (direct purchase up to 50,000))</description>
        <inputEntry id="ifms-procurement-mode_r0_i0"><text>&lt;= 50000</text></inputEntry>
        <inputEntry id="ifms-procurement-mode_r0_i1"><text>false</text></inputEntry>
        <outputEntry id="ifms-procurement-mode_r0_o0"><text>"DIRECT"</text></outputEntry>
        <outputEntry id="ifms-procurement-mode_r0_o1"><text>"[U] central default, replace from Jharkhand Financial Rules 2025 Ch.7 (r.165 GeM) (was: GFR 2017 r.154 / r.149 (direct purchase up to 50,000))"</text></outputEntry>
      </rule>
      <rule id="ifms-procurement-mode_r1"><description>[U] central default, replace from Jharkhand Financial Rules 2025 Ch.7 (r.165 GeM) (was: GFR 2017 r.149 (GeM L1 above 50,000 to 10 lakh))</description>
        <inputEntry id="ifms-procurement-mode_r1_i0"><text>&lt;= 1000000</text></inputEntry>
        <inputEntry id="ifms-procurement-mode_r1_i1"><text>false</text></inputEntry>
        <outputEntry id="ifms-procurement-mode_r1_o0"><text>"GEM_L1"</text></outputEntry>
        <outputEntry id="ifms-procurement-mode_r1_o1"><text>"[U] central default, replace from Jharkhand Financial Rules 2025 Ch.7 (r.165 GeM) (was: GFR 2017 r.149 (GeM L1 above 50,000 to 10 lakh))"</text></outputEntry>
      </rule>
      <rule id="ifms-procurement-mode_r2"><description>[U] central default, replace from Jharkhand Financial Rules 2025 Ch.7 (r.165 GeM) (was: GFR 2017 (limited tender up to 50 lakh; delta IFC-188))</description>
        <inputEntry id="ifms-procurement-mode_r2_i0"><text>&lt;= 5000000</text></inputEntry>
        <inputEntry id="ifms-procurement-mode_r2_i1"><text>false</text></inputEntry>
        <outputEntry id="ifms-procurement-mode_r2_o0"><text>"LIMITED_TENDER"</text></outputEntry>
        <outputEntry id="ifms-procurement-mode_r2_o1"><text>"[U] central default, replace from Jharkhand Financial Rules 2025 Ch.7 (r.165 GeM) (was: GFR 2017 (limited tender up to 50 lakh; delta IFC-188))"</text></outputEntry>
      </rule>
      <rule id="ifms-procurement-mode_r3"><description>[U] central default, replace from Jharkhand Financial Rules 2025 Ch.7 (r.165 GeM) (was: scientific departments: limited tender up to 1 crore (delta IFC-188))</description>
        <inputEntry id="ifms-procurement-mode_r3_i0"><text>&lt;= 10000000</text></inputEntry>
        <inputEntry id="ifms-procurement-mode_r3_i1"><text>true</text></inputEntry>
        <outputEntry id="ifms-procurement-mode_r3_o0"><text>"LIMITED_TENDER"</text></outputEntry>
        <outputEntry id="ifms-procurement-mode_r3_o1"><text>"[U] central default, replace from Jharkhand Financial Rules 2025 Ch.7 (r.165 GeM) (was: scientific departments: limited tender up to 1 crore (delta IFC-188))"</text></outputEntry>
      </rule>
      <rule id="ifms-procurement-mode_r4"><description>[U] central default, replace from Jharkhand Financial Rules 2025 Ch.7 (r.165 GeM) (was: GFR 2017 r.161 (advertised tender))</description>
        <inputEntry id="ifms-procurement-mode_r4_i0"><text>-</text></inputEntry>
        <inputEntry id="ifms-procurement-mode_r4_i1"><text>-</text></inputEntry>
        <outputEntry id="ifms-procurement-mode_r4_o0"><text>"OPEN_TENDER"</text></outputEntry>
        <outputEntry id="ifms-procurement-mode_r4_o1"><text>"[U] central default, replace from Jharkhand Financial Rules 2025 Ch.7 (r.165 GeM) (was: GFR 2017 r.161 (advertised tender))"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
