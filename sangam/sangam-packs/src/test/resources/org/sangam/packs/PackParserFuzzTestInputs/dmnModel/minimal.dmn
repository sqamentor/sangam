<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_fuzz_dmn" name="Fuzz" namespace="http://sangam.org/packs">
  <decision id="fuzz-decision" name="Fuzz" operaton:historyTimeToLive="30">
    <decisionTable id="t" hitPolicy="FIRST">
      <input id="i0" label="Amount"><inputExpression id="ie0" typeRef="number"><text>amount</text></inputExpression></input>
      <output id="o0" label="Role" name="role" typeRef="string"/>
      <rule id="r0"><inputEntry id="r0i"><text>&lt;= 100</text></inputEntry><outputEntry id="r0o"><text>"A"</text></outputEntry></rule>
    </decisionTable>
  </decision>
</definitions>
