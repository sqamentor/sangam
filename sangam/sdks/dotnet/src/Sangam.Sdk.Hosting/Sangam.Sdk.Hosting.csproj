<!-- Sangam .NET SDK framework adapter (M-027): runs the SangamWorker as a hosted service of the .NET generic host /
     ASP.NET Core. Separate package so the core SDK keeps no dependency; uses only the in-box ASP.NET Core shared
     framework (Microsoft.Extensions.Hosting / DependencyInjection / Options / Logging), no NuGet package. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 is the supported target; SangamTargetFramework overrides it only for compile checks on older SDKs -->
    <SangamTargetFramework Condition="'$(SangamTargetFramework)' == ''">net8.0</SangamTargetFramework>
    <TargetFramework>$(SangamTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Sangam.Sdk.Hosting</RootNamespace>
    <AssemblyName>Sangam.Sdk.Hosting</AssemblyName>
    <PackageId>Sangam.Sdk.Hosting</PackageId>
    <Version>0.1.0</Version>
    <Authors>Sangam</Authors>
    <Description>Hosted-service adapter for the Sangam .NET worker: AddSangamWorker(...) for the generic host and ASP.NET Core.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/sqamentor/sangam</PackageProjectUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sangam.Sdk\Sangam.Sdk.csproj" />
  </ItemGroup>

</Project>
