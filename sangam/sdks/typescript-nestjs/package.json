{
  "name": "@sangam/nestjs",
  "version": "0.1.0",
  "description": "NestJS adapter for the Sangam TypeScript SDK: runs the SangamWorker with the Nest application lifecycle (M-027).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "test": "tsc -p test/tsconfig.json && node --test build-test/test/*.test.js"
  },
  "keywords": [
    "sangam",
    "workflow",
    "nestjs",
    "external-worker"
  ],
  "peerDependencies": {
    "@sangam/sdk": "0.1.0",
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.9.3"
  }
}
