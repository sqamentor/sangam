<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- Sangam compliance pack (jurisdiction-neutral). Timelines arrive as process variables computed from the jurisdiction pack. No diagram layout yet: open in the Sangam modeller and auto-layout. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" id="defs_sangam_dsr_access" targetNamespace="http://sangam.org/packs/compliance" exporter="sangam-compliance" exporterVersion="0.1.0">
  <process id="sangam-dsr-access" name="Data-subject access request" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <documentation>Access right (IN: DPDP s.11). Due date from the pack SLA; non-interrupting escalation at the due date.</documentation>
    <startEvent id="start" name="Request received"/>
    <serviceTask id="s_start" name="Mark in progress" operaton:class="org.sangam.compliance.bpmn.ComplianceStepDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="step"><operaton:string>rights.start</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="u_compile" name="Verify identity and compile data summary" operaton:candidateGroups="DPO" operaton:formKey="sangam:compliance/access-compile"></userTask>
    <serviceTask id="s_summary" name="Build access summary" operaton:class="org.sangam.compliance.bpmn.ComplianceStepDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="step"><operaton:string>rights.accessSummary</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="u_release" name="Review and release summary" operaton:candidateGroups="DPO" operaton:formKey="sangam:compliance/access-release"></userTask>
    <boundaryEvent id="t_due" name="Due date" attachedToRef="u_release" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${dueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <serviceTask id="s_close" name="Close request" operaton:class="org.sangam.compliance.bpmn.ComplianceStepDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="step"><operaton:string>rights.closeAccess</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="end" name="Answered"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="s_start"/>
    <sequenceFlow id="f2" sourceRef="s_start" targetRef="u_compile"/>
    <sequenceFlow id="f3" sourceRef="u_compile" targetRef="s_summary"/>
    <sequenceFlow id="f4" sourceRef="s_summary" targetRef="u_release"/>
    <sequenceFlow id="f5" sourceRef="u_release" targetRef="s_close"/>
    <sequenceFlow id="f6" sourceRef="s_close" targetRef="end"/>
    <serviceTask id="esc" name="Escalate overdue request" operaton:class="org.sangam.compliance.bpmn.ComplianceStepDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="step"><operaton:string>rights.escalate</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="end_esc" name="Escalated"/>
    <sequenceFlow id="f_esc1" sourceRef="t_due" targetRef="esc"/>
    <sequenceFlow id="f_esc2" sourceRef="esc" targetRef="end_esc"/>
  </process>
</definitions>