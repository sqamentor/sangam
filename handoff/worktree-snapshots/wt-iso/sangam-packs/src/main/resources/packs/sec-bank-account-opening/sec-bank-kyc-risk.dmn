<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_sec_bank_kyc_risk" name="Customer risk category and re-KYC cycle" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="sec-bank-kyc-risk" name="Customer risk category and re-KYC cycle" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="sec-bank-kyc-risk_t" hitPolicy="FIRST">
      <input id="sec-bank-kyc-risk_i0" label="PEP"><inputExpression id="sec-bank-kyc-risk_ie0" typeRef="boolean"><text>pepFlag</text></inputExpression></input>
      <input id="sec-bank-kyc-risk_i1" label="Occupation"><inputExpression id="sec-bank-kyc-risk_ie1" typeRef="string"><text>occupation</text></inputExpression></input>
      <input id="sec-bank-kyc-risk_i2" label="KYC mode"><inputExpression id="sec-bank-kyc-risk_ie2" typeRef="string"><text>kycMode</text></inputExpression></input>
      <output id="sec-bank-kyc-risk_o0" label="Risk" name="riskCategory" typeRef="string"/>
      <output id="sec-bank-kyc-risk_o1" label="Re-KYC every (years)" name="rekycYears" typeRef="integer"/>
      <output id="sec-bank-kyc-risk_o2" label="EDD" name="eddRequired" typeRef="boolean"/>
      <rule id="sec-bank-kyc-risk_r0"><description>PEP: high risk, EDD, senior approval</description>
        <inputEntry id="sec-bank-kyc-risk_r0_i0"><text>true</text></inputEntry>
        <inputEntry id="sec-bank-kyc-risk_r0_i1"><text>-</text></inputEntry>
        <inputEntry id="sec-bank-kyc-risk_r0_i2"><text>-</text></inputEntry>
        <outputEntry id="sec-bank-kyc-risk_r0_o0"><text>"HIGH"</text></outputEntry>
        <outputEntry id="sec-bank-kyc-risk_r0_o1"><text>2</text></outputEntry>
        <outputEntry id="sec-bank-kyc-risk_r0_o2"><text>true</text></outputEntry>
      </rule>
      <rule id="sec-bank-kyc-risk_r1"><description>cash-intensive business</description>
        <inputEntry id="sec-bank-kyc-risk_r1_i0"><text>-</text></inputEntry>
        <inputEntry id="sec-bank-kyc-risk_r1_i1"><text>"CASH_INTENSIVE"</text></inputEntry>
        <inputEntry id="sec-bank-kyc-risk_r1_i2"><text>-</text></inputEntry>
        <outputEntry id="sec-bank-kyc-risk_r1_o0"><text>"HIGH"</text></outputEntry>
        <outputEntry id="sec-bank-kyc-risk_r1_o1"><text>2</text></outputEntry>
        <outputEntry id="sec-bank-kyc-risk_r1_o2"><text>true</text></outputEntry>
      </rule>
      <rule id="sec-bank-kyc-risk_r2">
        <inputEntry id="sec-bank-kyc-risk_r2_i0"><text>-</text></inputEntry>
        <inputEntry id="sec-bank-kyc-risk_r2_i1"><text>"SELF_EMPLOYED"</text></inputEntry>
        <inputEntry id="sec-bank-kyc-risk_r2_i2"><text>-</text></inputEntry>
        <outputEntry id="sec-bank-kyc-risk_r2_o0"><text>"MEDIUM"</text></outputEntry>
        <outputEntry id="sec-bank-kyc-risk_r2_o1"><text>8</text></outputEntry>
        <outputEntry id="sec-bank-kyc-risk_r2_o2"><text>false</text></outputEntry>
      </rule>
      <rule id="sec-bank-kyc-risk_r3"><description>periodic updation 2 / 8 / 10 years (KYC MD para 38)</description>
        <inputEntry id="sec-bank-kyc-risk_r3_i0"><text>-</text></inputEntry>
        <inputEntry id="sec-bank-kyc-risk_r3_i1"><text>-</text></inputEntry>
        <inputEntry id="sec-bank-kyc-risk_r3_i2"><text>-</text></inputEntry>
        <outputEntry id="sec-bank-kyc-risk_r3_o0"><text>"LOW"</text></outputEntry>
        <outputEntry id="sec-bank-kyc-risk_r3_o1"><text>10</text></outputEntry>
        <outputEntry id="sec-bank-kyc-risk_r3_o2"><text>false</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
