<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_sec_ushealth_access_clocks" name="Right-of-access timeframes (45 CFR 164.524(b)(2), 171.204(b); tenant overridable)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <!-- US-HLT-002, US-HLT-048. -->
  <decision id="sec-ushealth-access-clocks" name="Right-of-access timeframes (45 CFR 164.524(b)(2), 171.204(b); tenant overridable)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="sec-ushealth-access-clocks_t" hitPolicy="FIRST">
      <input id="sec-ushealth-access-clocks_i0" label="Request type"><inputExpression id="sec-ushealth-access-clocks_ie0" typeRef="string"><text>requestType</text></inputExpression></input>
      <output id="sec-ushealth-access-clocks_o0" label="Act within" name="accessSpec" typeRef="string"/>
      <output id="sec-ushealth-access-clocks_o1" label="Extension (from the extension notice)" name="accessExtensionSpec" typeRef="string"/>
      <output id="sec-ushealth-access-clocks_o2" label="Infeasibility response within" name="infeasibilitySpec" typeRef="string"/>
      <output id="sec-ushealth-access-clocks_o3" label="Extension used" name="accessExtended" typeRef="boolean"/>
      <output id="sec-ushealth-access-clocks_o4" label="Review requested (set by the form)" name="reviewRequested" typeRef="boolean"/>
      <rule id="sec-ushealth-access-clocks_r0"><description>30 + 30 days; state law may be shorter (override); 15+15 was only proposed (2020 NPRM)</description>
        <inputEntry id="sec-ushealth-access-clocks_r0_i0"><text>-</text></inputEntry>
        <outputEntry id="sec-ushealth-access-clocks_r0_o0"><text>"30D"</text></outputEntry>
        <outputEntry id="sec-ushealth-access-clocks_r0_o1"><text>"30D"</text></outputEntry>
        <outputEntry id="sec-ushealth-access-clocks_r0_o2"><text>"10WD"</text></outputEntry>
        <outputEntry id="sec-ushealth-access-clocks_r0_o3"><text>false</text></outputEntry>
        <outputEntry id="sec-ushealth-access-clocks_r0_o4"><text>false</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
