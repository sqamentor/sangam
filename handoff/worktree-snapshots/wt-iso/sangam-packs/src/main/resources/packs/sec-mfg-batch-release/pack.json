{
  "id": "sec.mfg.batch-release",
  "version": "1.0.0",
  "name": {
    "en": "Manufacturing batch record review and release",
    "hi": "विनिर्माण बैच अभिलेख समीक्षा एवं निर्गमन"
  },
  "domain": "Manufacturing",
  "description": "GMP batch release (Schedule M style): batch manufacturing record, in-process and finished-product QC, deviations opened as CAPA cases (UP-18), QA review with SoD from production, release or reject with e-signature bound to the batch record, release to the warehouse.",
  "mainProcesses": [
    "sangam-sec-mfg-batch-release"
  ],
  "resources": [
    {
      "kind": "BPMN",
      "path": "packs/sec-mfg-batch-release/sangam-sec-mfg-batch-release.bpmn"
    },
    {
      "kind": "FORM",
      "path": "packs/sec-mfg-batch-release/forms/batch.form.json"
    },
    {
      "kind": "FORM",
      "path": "packs/sec-mfg-batch-release/forms/qc.form.json"
    },
    {
      "kind": "FORM",
      "path": "packs/sec-mfg-batch-release/forms/qa.form.json"
    },
    {
      "kind": "SEED",
      "path": "packs/sec-mfg-batch-release/seed.json"
    }
  ],
  "seed": "packs/sec-mfg-batch-release/seed.json",
  "connectors": [
    {
      "id": "mes.batchRecord",
      "capabilityClass": "a",
      "govTag": "",
      "purpose": "Batch record"
    },
    {
      "id": "wms.release",
      "capabilityClass": "a",
      "govTag": "",
      "purpose": "Release to warehouse"
    }
  ],
  "covers": [
    "SEC-MFG-001",
    "SEC-MFG-002",
    "UP-18",
    "GP-34",
    "UP-05"
  ],
  "acceptance": [],
  "dependsOn": [
    "sangam.core"
  ],
  "tenantOverrides": [],
  "calls": []
}
