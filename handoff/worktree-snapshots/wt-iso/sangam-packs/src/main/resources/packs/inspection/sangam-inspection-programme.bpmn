<!-- Inspection programme. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_inspection_programme" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_inspectionDrive" name="sangam.inspectionDrive"/>
  <process id="sangam-inspection-programme" name="Inspection programme" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.inspection</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>period</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="ip_timer" name="Monthly on the 1st"><timerEventDefinition><timeCycle xsi:type="tFormalExpression">0 0 3 1 * ?</timeCycle></timerEventDefinition></startEvent>
    <startEvent id="ip_manual" name="Special drive (message)"><messageEventDefinition messageRef="msg_sangam_inspectionDrive"/></startEvent>
    <exclusiveGateway id="ip_join" name=""></exclusiveGateway>
    <serviceTask id="ip_load" name="Establishments due (risk-ranked)" operaton:class="org.sangam.packs.core.BatchDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>LOAD</operaton:string></operaton:field><operaton:field name="connector"><operaton:string>inspection.establishments</operaton:string></operaton:field><operaton:field name="sampleSize"><operaton:string>3</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ip_open" name="Open round" operaton:class="org.sangam.packs.core.BatchDelegate"><extensionElements><operaton:field name="op"><operaton:string>OPEN</operaton:string></operaton:field><operaton:field name="itemsVar"><operaton:string>items</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ip_fanOut" name="Start one instance per item (chunk)" operaton:class="org.sangam.packs.core.BatchDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>FAN_OUT</operaton:string></operaton:field><operaton:field name="itemsVar"><operaton:string>items</operaton:string></operaton:field><operaton:field name="childProcessKey"><operaton:string>sangam-inspection</operaton:string></operaton:field><operaton:field name="chunkSize"><operaton:string>200</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="ip_fanGw" name="All started?" default="inspection_programme_f7"></exclusiveGateway>
    <intermediateCatchEvent id="ip_poll" name="Poll aggregate"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">PT1H</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <serviceTask id="ip_aggregate" name="Aggregate outcomes" operaton:class="org.sangam.packs.core.BatchDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>AGGREGATE</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="ip_doneGw" name="Round complete?" default="inspection_programme_f12"></exclusiveGateway>
    <serviceTask id="ip_report" name="Programme report" operaton:class="org.sangam.packs.core.DocumentDelegate"><extensionElements><operaton:field name="template"><operaton:string>inspection-programme-report</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="ip_end" name="Programme closed"></endEvent>
    <sequenceFlow id="inspection_programme_f1" sourceRef="ip_timer" targetRef="ip_join"/>
    <sequenceFlow id="inspection_programme_f2" sourceRef="ip_manual" targetRef="ip_join"/>
    <sequenceFlow id="inspection_programme_f3" sourceRef="ip_join" targetRef="ip_load"/>
    <sequenceFlow id="inspection_programme_f4" sourceRef="ip_open" targetRef="ip_fanOut"/>
    <sequenceFlow id="inspection_programme_f5" sourceRef="ip_fanOut" targetRef="ip_fanGw"/>
    <sequenceFlow id="inspection_programme_f6" name="next chunk" sourceRef="ip_fanGw" targetRef="ip_fanOut"><conditionExpression xsi:type="tFormalExpression">${!fanOutDone}</conditionExpression></sequenceFlow>
    <sequenceFlow id="inspection_programme_f7" name="all started" sourceRef="ip_fanGw" targetRef="ip_poll"/>
    <sequenceFlow id="inspection_programme_f8" sourceRef="ip_poll" targetRef="ip_aggregate"/>
    <sequenceFlow id="inspection_programme_f9" sourceRef="ip_aggregate" targetRef="ip_doneGw"/>
    <sequenceFlow id="inspection_programme_f10" name="not yet" sourceRef="ip_doneGw" targetRef="ip_poll"><conditionExpression xsi:type="tFormalExpression">${!batchComplete}</conditionExpression></sequenceFlow>
    <sequenceFlow id="inspection_programme_f11" sourceRef="ip_load" targetRef="ip_open"/>
    <sequenceFlow id="inspection_programme_f12" name="complete" sourceRef="ip_doneGw" targetRef="ip_report"/>
    <sequenceFlow id="inspection_programme_f13" sourceRef="ip_report" targetRef="ip_end"/>
  </process>
