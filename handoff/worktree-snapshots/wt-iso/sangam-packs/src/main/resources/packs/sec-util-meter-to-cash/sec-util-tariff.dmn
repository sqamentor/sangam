<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_sec_util_tariff" name="Tariff (SYNTHETIC; SERC tariff order)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="sec-util-tariff" name="Tariff (SYNTHETIC; SERC tariff order)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="sec-util-tariff_t" hitPolicy="FIRST">
      <input id="sec-util-tariff_i0" label="Category"><inputExpression id="sec-util-tariff_ie0" typeRef="string"><text>tariffCategory</text></inputExpression></input>
      <input id="sec-util-tariff_i1" label="Units"><inputExpression id="sec-util-tariff_ie1" typeRef="number"><text>units</text></inputExpression></input>
      <output id="sec-util-tariff_o0" label="Fixed charge" name="fixedCharge" typeRef="number"/>
      <output id="sec-util-tariff_o1" label="Energy rate per unit" name="energyRate" typeRef="number"/>
      <output id="sec-util-tariff_o2" label="Bill head (must equal the tariff line head)" name="head" typeRef="string"/>
      <rule id="sec-util-tariff_r0">
        <inputEntry id="sec-util-tariff_r0_i0"><text>"DOMESTIC"</text></inputEntry>
        <inputEntry id="sec-util-tariff_r0_i1"><text>&lt;= 100</text></inputEntry>
        <outputEntry id="sec-util-tariff_r0_o0"><text>50</text></outputEntry>
        <outputEntry id="sec-util-tariff_r0_o1"><text>3.5</text></outputEntry>
        <outputEntry id="sec-util-tariff_r0_o2"><text>"ENERGY"</text></outputEntry>
      </rule>
      <rule id="sec-util-tariff_r1">
        <inputEntry id="sec-util-tariff_r1_i0"><text>"DOMESTIC"</text></inputEntry>
        <inputEntry id="sec-util-tariff_r1_i1"><text>-</text></inputEntry>
        <outputEntry id="sec-util-tariff_r1_o0"><text>50</text></outputEntry>
        <outputEntry id="sec-util-tariff_r1_o1"><text>5.5</text></outputEntry>
        <outputEntry id="sec-util-tariff_r1_o2"><text>"ENERGY"</text></outputEntry>
      </rule>
      <rule id="sec-util-tariff_r2"><description>commercial</description>
        <inputEntry id="sec-util-tariff_r2_i0"><text>-</text></inputEntry>
        <inputEntry id="sec-util-tariff_r2_i1"><text>-</text></inputEntry>
        <outputEntry id="sec-util-tariff_r2_o0"><text>200</text></outputEntry>
        <outputEntry id="sec-util-tariff_r2_o1"><text>8</text></outputEntry>
        <outputEntry id="sec-util-tariff_r2_o2"><text>"ENERGY"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
