<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_sec_bank_cheque_rules" name="Cheque return rules (SYNTHETIC board policy)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="sec-bank-cheque-rules" name="Cheque return rules (SYNTHETIC board policy)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="sec-bank-cheque-rules_t" hitPolicy="FIRST">
      <input id="sec-bank-cheque-rules_i0" label="Reason"><inputExpression id="sec-bank-cheque-rules_ie0" typeRef="string"><text>returnReason</text></inputExpression></input>
      <input id="sec-bank-cheque-rules_i1" label="Returns this year"><inputExpression id="sec-bank-cheque-rules_ie1" typeRef="integer"><text>returnCount</text></inputExpression></input>
      <input id="sec-bank-cheque-rules_i2" label="Amount"><inputExpression id="sec-bank-cheque-rules_ie2" typeRef="number"><text>amount</text></inputExpression></input>
      <output id="sec-bank-cheque-rules_o0" label="Withdraw facility" name="withdrawChequeBook" typeRef="boolean"/>
      <output id="sec-bank-cheque-rules_o1" label="Charge (INR)" name="returnCharge" typeRef="integer"/>
      <rule id="sec-bank-cheque-rules_r0"><description>dishonour four times in a financial year for 1 crore or more</description>
        <inputEntry id="sec-bank-cheque-rules_r0_i0"><text>"FUNDS_INSUFFICIENT"</text></inputEntry>
        <inputEntry id="sec-bank-cheque-rules_r0_i1"><text>&gt;= 4</text></inputEntry>
        <inputEntry id="sec-bank-cheque-rules_r0_i2"><text>&gt;= 10000000</text></inputEntry>
        <outputEntry id="sec-bank-cheque-rules_r0_o0"><text>true</text></outputEntry>
        <outputEntry id="sec-bank-cheque-rules_r0_o1"><text>500</text></outputEntry>
      </rule>
      <rule id="sec-bank-cheque-rules_r1">
        <inputEntry id="sec-bank-cheque-rules_r1_i0"><text>"FUNDS_INSUFFICIENT"</text></inputEntry>
        <inputEntry id="sec-bank-cheque-rules_r1_i1"><text>-</text></inputEntry>
        <inputEntry id="sec-bank-cheque-rules_r1_i2"><text>-</text></inputEntry>
        <outputEntry id="sec-bank-cheque-rules_r1_o0"><text>false</text></outputEntry>
        <outputEntry id="sec-bank-cheque-rules_r1_o1"><text>500</text></outputEntry>
      </rule>
      <rule id="sec-bank-cheque-rules_r2"><description>technical reasons: no charge to the customer</description>
        <inputEntry id="sec-bank-cheque-rules_r2_i0"><text>-</text></inputEntry>
        <inputEntry id="sec-bank-cheque-rules_r2_i1"><text>-</text></inputEntry>
        <inputEntry id="sec-bank-cheque-rules_r2_i2"><text>-</text></inputEntry>
        <outputEntry id="sec-bank-cheque-rules_r2_o0"><text>false</text></outputEntry>
        <outputEntry id="sec-bank-cheque-rules_r2_o1"><text>0</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
