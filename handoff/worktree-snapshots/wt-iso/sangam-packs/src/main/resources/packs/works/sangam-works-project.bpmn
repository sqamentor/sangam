    <sequenceFlow id="works_project_f67" sourceRef="wk_cumulative" targetRef="wk_thrGw"/>
    <sequenceFlow id="works_project_f68" name="GP-42" sourceRef="wk_thrGw" targetRef="wk_raaCfg"><conditionExpression xsi:type="tFormalExpression">${thresholdCrossed}</conditionExpression></sequenceFlow>
