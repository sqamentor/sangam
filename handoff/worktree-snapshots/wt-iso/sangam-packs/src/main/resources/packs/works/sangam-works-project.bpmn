    <sequenceFlow id="works_project_f72" sourceRef="wk_raaOk" targetRef="wk_billNo"/>
    <sequenceFlow id="works_project_f73" sourceRef="wk_billNo" targetRef="wk_net"/>
    <sequenceFlow id="works_project_f74" sourceRef="wk_net" targetRef="wk_raBill"/>
    <sequenceFlow id="works_project_f75" sourceRef="wk_raBill" targetRef="wk_ldCleared"/>
    <sequenceFlow id="works_project_f76" sourceRef="wk_ldCleared" targetRef="wk_finalGw"/>
    <sequenceFlow id="works_project_f77" name="next month" sourceRef="wk_finalGw" targetRef="wk_cycle"><conditionExpression xsi:type="tFormalExpression">${!finalBill}</conditionExpression></sequenceFlow>
    <sequenceFlow id="works_project_f78" name="final" sourceRef="wk_finalGw" targetRef="wk_completion"/>
    <sequenceFlow id="works_project_f79" sourceRef="wk_completion" targetRef="wk_dlp"/>
