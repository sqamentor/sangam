    <sequenceFlow id="works_project_f82" name="no defects" sourceRef="wk_dlpGw" targetRef="wk_releaseSecurity"><conditionExpression xsi:type="tFormalExpression">${dlpDecision == 'satisfactory'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="works_project_f83" name="defects not rectified" sourceRef="wk_dlpGw" targetRef="wk_invokeSecurity"/>
    <sequenceFlow id="works_project_f84" sourceRef="wk_releaseSecurity" targetRef="wk_close"/>
    <sequenceFlow id="works_project_f85" sourceRef="wk_invokeSecurity" targetRef="wk_close"/>
    <sequenceFlow id="works_project_f86" sourceRef="wk_close" targetRef="wk_end"/>
    <subProcess id="wk_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="wk_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="wk_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="wk_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="wk_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="works_project_f87" sourceRef="wk_withdrawStart" targetRef="wk_withdrawKind"/>
      <sequenceFlow id="works_project_f88" sourceRef="wk_withdrawKind" targetRef="wk_withdrawCall"/>
      <sequenceFlow id="works_project_f89" sourceRef="wk_withdrawCall" targetRef="wk_withdrawEnd"/>
    </subProcess>
    <subProcess id="wk_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="wk_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="wk_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="wk_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="wk_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="works_project_f90" sourceRef="wk_cancelStart" targetRef="wk_cancelKind"/>
      <sequenceFlow id="works_project_f91" sourceRef="wk_cancelKind" targetRef="wk_cancelCall"/>
      <sequenceFlow id="works_project_f92" sourceRef="wk_cancelCall" targetRef="wk_cancelEnd"/>
    </subProcess>
    <subProcess id="wk_amendmentReq" name="Request an amendment" triggeredByEvent="true">
      <startEvent id="wk_amReqStart" name="Amendment requested" isInterrupting="false"><messageEventDefinition messageRef="msg_sangam_requestAmendment"/></startEvent>
      <serviceTask id="wk_amLink" name="Amendment case (linked)" operaton:class="org.sangam.packs.core.LinkedInstanceDelegate"><extensionElements><operaton:field name="processKey"><operaton:string>sangam-contract-amendment</operaton:string></operaton:field><operaton:field name="linkType"><operaton:string>amendment</operaton:string></operaton:field><operaton:field name="inherit"><operaton:string>contractValue,contractorId,amendmentType,amendmentAmount,extensionDays,delayDays,escalationIndex,justification,initiatorSeat,initiatorPerson,actingSeat,initiator</operaton:string></operaton:field></extensionElements></serviceTask>
      <endEvent id="wk_amReqEnd" name="Requested"></endEvent>
      <sequenceFlow id="works_project_f93" sourceRef="wk_amReqStart" targetRef="wk_amLink"/>
      <sequenceFlow id="works_project_f94" sourceRef="wk_amLink" targetRef="wk_amReqEnd"/>
    </subProcess>
    <subProcess id="wk_amendmentApplied" name="Amendment approved: apply to the running contract" triggeredByEvent="true">
      <startEvent id="wk_amApStart" name="Amendment approved" isInterrupting="false"><messageEventDefinition messageRef="msg_sangam_amendmentApproved"/></startEvent>
      <exclusiveGateway id="wk_amTypeGw" name="Type?" default="works_project_f98"></exclusiveGateway>
      <serviceTask id="wk_eot" name="Extend completion date (re-arms the timer)" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>SHIFT</operaton:string></operaton:field><operaton:field name="dateVar"><operaton:string>completionDueAt</operaton:string></operaton:field><operaton:field name="daysVar"><operaton:string>extensionDays</operaton:string></operaton:field></extensionElements></serviceTask>
      <serviceTask id="wk_ldApply" name="LD recoverable from next bill" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>ldRecoverable=@ldAmount</operaton:string></operaton:field></extensionElements></serviceTask>
      <serviceTask id="wk_variation" name="Add to cumulative (variation / escalation)" operaton:class="org.sangam.packs.core.CumulativeThresholdDelegate"><extensionElements><operaton:field name="totalVar"><operaton:string>cumulativeAmount</operaton:string></operaton:field><operaton:field name="add"><operaton:expression>${amendmentAmount + escalationAmount}</operaton:expression></operaton:field><operaton:field name="limit"><operaton:expression>${aaAmount}</operaton:expression></operaton:field><operaton:field name="tolerancePct"><operaton:expression>${aaTolerancePct}</operaton:expression></operaton:field></extensionElements></serviceTask>
      <endEvent id="wk_amApEnd" name="Applied"></endEvent>
      <sequenceFlow id="works_project_f95" sourceRef="wk_amApStart" targetRef="wk_amTypeGw"/>
      <sequenceFlow id="works_project_f96" name="EoT" sourceRef="wk_amTypeGw" targetRef="wk_eot"><conditionExpression xsi:type="tFormalExpression">${amendmentType == 'EOT'}</conditionExpression></sequenceFlow>
      <sequenceFlow id="works_project_f97" name="LD" sourceRef="wk_amTypeGw" targetRef="wk_ldApply"><conditionExpression xsi:type="tFormalExpression">${amendmentType == 'LD'}</conditionExpression></sequenceFlow>
      <sequenceFlow id="works_project_f98" name="variation / extra item / escalation" sourceRef="wk_amTypeGw" targetRef="wk_variation"/>
      <sequenceFlow id="works_project_f99" sourceRef="wk_eot" targetRef="wk_amApEnd"/>
      <sequenceFlow id="works_project_f100" sourceRef="wk_ldApply" targetRef="wk_amApEnd"/>
      <sequenceFlow id="works_project_f101" sourceRef="wk_variation" targetRef="wk_amApEnd"/>
    </subProcess>
  </process>
