  <process id="sangam-works-project" name="Works project" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <documentation>Order of sanctions from the pack configuration works-config (per tenant by override deployment, per office by rule row): TS_FIRST (default: estimate, technical sanction, administrative approval) or AA_FIRST.</documentation>
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.works</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>workName,estimateAmount,budgetHead</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="wk_start" name="Estimate submitted" operaton:initiator="initiator" operaton:formKey="sangam:works/estimate"></startEvent>
