    <callActivity id="wk_tender" name="Tender (gov.tender)" calledElement="sangam-tender"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}/TENDER"/><operaton:in source="workName" target="itemDescription"/><operaton:in source="estimateAmount" target="estimateAmount"/><operaton:in source="initiatorSeat" target="actingSeat"/><operaton:in source="initiatorPerson" target="initiator"/><operaton:in source="officeId" target="officeId"/><operaton:in source="tenderId" target="tenderId"/><operaton:in source="nitText" target="nitText"/><operaton:in source="bidDueAt" target="bidDueAt"/><operaton:in source="openingAt" target="openingAt"/><operaton:out source="tenderOutcome" target="tenderOutcome"/><operaton:out source="contractorId" target="contractorId"/><operaton:out source="contractValue" target="contractValue"/></extensionElements></callActivity>
