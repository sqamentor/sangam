    <intermediateCatchEvent id="wk_completionDue" name="Stipulated completion date"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${completionDueAt}</timeDate></timerEventDefinition></intermediateCatchEvent>
    <userTask id="wk_delay" name="Completion overdue: assess delay (monthly)" operaton:candidateGroups="${eeSeat}" operaton:formKey="sangam:works/delay"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>delayDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="wk_requestLd" name="LD / EoT amendment case" operaton:class="org.sangam.packs.core.LinkedInstanceDelegate"><extensionElements><operaton:field name="processKey"><operaton:string>sangam-contract-amendment</operaton:string></operaton:field><operaton:field name="linkType"><operaton:string>amendment</operaton:string></operaton:field><operaton:field name="inherit"><operaton:string>contractValue,contractorId,delayDays,initiatorSeat,initiatorPerson,actingSeat,initiator</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="wk_rearm" name="Next delay review in 30 days" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>SHIFT</operaton:string></operaton:field><operaton:field name="dateVar"><operaton:string>completionDueAt</operaton:string></operaton:field><operaton:field name="daysVar"><operaton:string>delayReviewDays</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="wk_mb" name="Record measurements in MB" operaton:candidateGroups="${aeSeat}" operaton:formKey="sangam:works/measurement"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="wk_checkMeasure_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>wk_checkMeasure</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="wk_checkMeasure" name="Check-measure" operaton:candidateGroups="${eeSeat}" operaton:formKey="sangam:works/check-measure" operaton:dueDate="${wk_checkMeasureDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>cmDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="wk_checkMeasure_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>wk_checkMeasure</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>eeSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="wk_checkMeasure_warnEnd" name="Warned"></endEvent>
    <serviceTask id="wk_checkMeasure_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>wk_checkMeasure</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>eeSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>cmDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="wk_checkMeasure_breachGw" name="Deemed?" default="works_project_f59"></exclusiveGateway>
    <exclusiveGateway id="wk_checkMeasure_done" name=""></exclusiveGateway>
    <exclusiveGateway id="wk_cmGw" name="Accepted?" default="works_project_f66"></exclusiveGateway>
    <serviceTask id="wk_cumulative" name="Cumulative against AA (GP-42)" operaton:class="org.sangam.packs.core.CumulativeThresholdDelegate"><extensionElements><operaton:field name="totalVar"><operaton:string>cumulativeAmount</operaton:string></operaton:field><operaton:field name="add"><operaton:expression>${measuredValue}</operaton:expression></operaton:field><operaton:field name="limit"><operaton:expression>${aaAmount}</operaton:expression></operaton:field><operaton:field name="tolerancePct"><operaton:expression>${aaTolerancePct}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="wk_thrGw" name="Over AA + tolerance?" default="works_project_f71"></exclusiveGateway>
    <serviceTask id="wk_raaCfg" name="Revised AA" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>caseType=WORKS_RAA;routingDecisionKey=works-aa-authority;amount=@cumulativeAmount</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="wk_raa" name="Revised administrative approval (core)" calledElement="sangam-core-sanction"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <serviceTask id="wk_raaOk" name="New AA amount" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>aaAmount=@cumulativeAmount;thresholdCrossed=false</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="wk_billNo" name="Next RA bill number" operaton:expression="${execution.setVariable('raBillNo', raBillNo + 1)}"></serviceTask>
    <serviceTask id="wk_net" name="Net of LD recoverable" operaton:expression="${execution.setVariable('raBillAmount', measuredValue - ldRecoverable)}"></serviceTask>
    <callActivity id="wk_raBill" name="Running account bill (P1)" calledElement="sangam-p1-bill-payment"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}/RA-#{raBillNo}"/><operaton:in source="contractorId" target="payee"/><operaton:in source="contractorAccount" target="account"/><operaton:in source="contractorIfsc" target="ifsc"/><operaton:in source="raBillAmount" target="amount"/><operaton:in source="budgetHead" target="budgetHead"/><operaton:in source="aaRef" target="sanctionRef"/><operaton:in source="raBillNo" target="invoiceNo"/><operaton:in source="officeId" target="officeId"/><operaton:in source="initiatorSeat" target="actingSeat"/><operaton:in source="initiatorPerson" target="initiator"/><operaton:in sourceExpression="${'RA_BILL'}" target="caseType"/><operaton:out source="caseState" target="raBillState"/></extensionElements></callActivity>
    <serviceTask id="wk_ldCleared" name="LD recovered" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>ldRecoverable=0</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="wk_finalGw" name="Final bill?" default="works_project_f78"></exclusiveGateway>
    <userTask id="wk_completion" name="Completion certificate" operaton:candidateGroups="${eeSeat}" operaton:formKey="sangam:works/completion"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <intermediateCatchEvent id="wk_dlp" name="Defect liability period"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">${dlpPeriod}</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <userTask id="wk_dlpCheck" name="Defects during DLP?" operaton:candidateGroups="${eeSeat}" operaton:formKey="sangam:works/dlp"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>dlpDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="wk_dlpGw" name="" default="works_project_f83"></exclusiveGateway>
    <serviceTask id="wk_releaseSecurity" name="Release performance security" operaton:class="org.sangam.packs.core.CorrelationDelegate"><extensionElements><operaton:field name="messageName"><operaton:string>sangam.contractCompleted</operaton:string></operaton:field><operaton:field name="optional"><operaton:string>true</operaton:string></operaton:field><operaton:field name="targetBusinessKey"><operaton:expression>${execution.processBusinessKey}/WO/performance-security-1</operaton:expression></operaton:field></extensionElements></serviceTask>
    <serviceTask id="wk_invokeSecurity" name="Invoke security for defects" operaton:class="org.sangam.packs.core.CorrelationDelegate"><extensionElements><operaton:field name="messageName"><operaton:string>sangam.contractDefault</operaton:string></operaton:field><operaton:field name="optional"><operaton:string>true</operaton:string></operaton:field><operaton:field name="targetBusinessKey"><operaton:expression>${execution.processBusinessKey}/WO/performance-security-1</operaton:expression></operaton:field></extensionElements></serviceTask>
    <callActivity id="wk_close" name="Completion and closure (core)" calledElement="sangam-core-closure"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="wk_end" name="Work completed"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="wk_checkMeasure_warn" name="SLA warning (75%)" attachedToRef="wk_checkMeasure" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${wk_checkMeasureWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="wk_checkMeasure_breach" name="SLA breached" attachedToRef="wk_checkMeasure" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${wk_checkMeasureDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="works_project_f1" sourceRef="wk_start" targetRef="wk_defaults"/>
    <sequenceFlow id="works_project_f2" sourceRef="wk_defaults" targetRef="wk_estimate"/>
    <sequenceFlow id="works_project_f3" sourceRef="wk_rj_reject" targetRef="wk_rj_endRejected"/>
    <sequenceFlow id="works_project_f4" name="ACCEPTED" sourceRef="wk_scrGw" targetRef="wk_config"><conditionExpression xsi:type="tFormalExpression">${scrutinyOutcome == 'ACCEPTED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="works_project_f5" name="otherwise" sourceRef="wk_scrGw" targetRef="wk_rj_reject"/>
    <sequenceFlow id="works_project_f6" sourceRef="wk_estimate" targetRef="wk_scrGw"/>
    <sequenceFlow id="works_project_f7" name="AA_FIRST" sourceRef="wk_orderGw" targetRef="wk_aaFirstCfg"><conditionExpression xsi:type="tFormalExpression">${worksSanctionOrder == 'AA_FIRST'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="works_project_f8" name="otherwise" sourceRef="wk_orderGw" targetRef="wk_tsCfg"/>
    <sequenceFlow id="works_project_f9" sourceRef="wk_config" targetRef="wk_orderGw"/>
    <sequenceFlow id="works_project_f10" sourceRef="wk_tsCfg" targetRef="wk_ts"/>
    <sequenceFlow id="works_project_f11" name="SANCTIONED" sourceRef="wk_tsGw" targetRef="wk_aaCfg"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="works_project_f12" name="RETURNED" sourceRef="wk_tsGw" targetRef="wk_estimate"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'RETURNED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="works_project_f13" name="otherwise" sourceRef="wk_tsGw" targetRef="wk_rj_reject"/>
    <sequenceFlow id="works_project_f14" sourceRef="wk_ts" targetRef="wk_tsGw"/>
    <sequenceFlow id="works_project_f15" sourceRef="wk_aaCfg" targetRef="wk_aa"/>
    <sequenceFlow id="works_project_f16" name="SANCTIONED" sourceRef="wk_aaGw" targetRef="wk_aaRef"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="works_project_f17" name="RETURNED" sourceRef="wk_aaGw" targetRef="wk_estimate"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'RETURNED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="works_project_f18" name="otherwise" sourceRef="wk_aaGw" targetRef="wk_rj_reject"/>
    <sequenceFlow id="works_project_f19" sourceRef="wk_aa" targetRef="wk_aaGw"/>
    <sequenceFlow id="works_project_f20" sourceRef="wk_aaRef" targetRef="wk_encumber"/>
    <sequenceFlow id="works_project_f21" sourceRef="wk_aaFirstCfg" targetRef="wk_aaFirst"/>
    <sequenceFlow id="works_project_f22" name="SANCTIONED" sourceRef="wk_aaFirstGw" targetRef="wk_aaFirstRef"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="works_project_f23" name="RETURNED" sourceRef="wk_aaFirstGw" targetRef="wk_estimate"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'RETURNED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="works_project_f24" name="otherwise" sourceRef="wk_aaFirstGw" targetRef="wk_rj_reject"/>
    <sequenceFlow id="works_project_f25" sourceRef="wk_aaFirst" targetRef="wk_aaFirstGw"/>
    <sequenceFlow id="works_project_f26" sourceRef="wk_aaFirstRef" targetRef="wk_tsSecondCfg"/>
    <sequenceFlow id="works_project_f27" sourceRef="wk_tsSecondCfg" targetRef="wk_tsSecond"/>
    <sequenceFlow id="works_project_f28" name="SANCTIONED" sourceRef="wk_tsSecondGw" targetRef="wk_tsSecondAmount"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="works_project_f29" name="RETURNED" sourceRef="wk_tsSecondGw" targetRef="wk_estimate"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'RETURNED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="works_project_f30" name="otherwise" sourceRef="wk_tsSecondGw" targetRef="wk_rj_reject"/>
    <sequenceFlow id="works_project_f31" sourceRef="wk_tsSecond" targetRef="wk_tsSecondGw"/>
    <sequenceFlow id="works_project_f32" sourceRef="wk_tsSecondAmount" targetRef="wk_encumber"/>
    <sequenceFlow id="works_project_f33" sourceRef="wk_encumber" targetRef="wk_aaAmount"/>
    <sequenceFlow id="works_project_f34" sourceRef="wk_aaAmount" targetRef="wk_nit"/>
    <sequenceFlow id="works_project_f35" sourceRef="wk_nit" targetRef="wk_tender"/>
    <sequenceFlow id="works_project_f36" sourceRef="wk_contractDates" targetRef="wk_workOrder"/>
    <sequenceFlow id="works_project_f37" name="AWARDED" sourceRef="wk_tenderGw" targetRef="wk_contractDates"><conditionExpression xsi:type="tFormalExpression">${tenderOutcome == 'AWARDED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="works_project_f38" name="otherwise" sourceRef="wk_tenderGw" targetRef="wk_tenderFailed"/>
    <sequenceFlow id="works_project_f39" sourceRef="wk_tender" targetRef="wk_tenderGw"/>
    <sequenceFlow id="works_project_f40" sourceRef="wk_tenderFailed" targetRef="wk_tfGw"/>
    <sequenceFlow id="works_project_f41" name="retender" sourceRef="wk_tfGw" targetRef="wk_nit"><conditionExpression xsi:type="tFormalExpression">${tfDecision == 'retender'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="works_project_f42" sourceRef="wk_drop_kind" targetRef="wk_drop_call"/>
    <sequenceFlow id="works_project_f43" sourceRef="wk_drop_call" targetRef="wk_drop_end"/>
    <sequenceFlow id="works_project_f44" name="drop" sourceRef="wk_tfGw" targetRef="wk_drop_kind"/>
    <sequenceFlow id="works_project_f45" name="ISSUED" sourceRef="wk_woGw" targetRef="wk_cycle"><conditionExpression xsi:type="tFormalExpression">${workOrderOutcome == 'ISSUED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="works_project_f46" name="otherwise" sourceRef="wk_woGw" targetRef="wk_tenderFailed"/>
    <sequenceFlow id="works_project_f47" sourceRef="wk_workOrder" targetRef="wk_woGw"/>
    <sequenceFlow id="works_project_f48" sourceRef="wk_cycle" targetRef="wk_month"/>
