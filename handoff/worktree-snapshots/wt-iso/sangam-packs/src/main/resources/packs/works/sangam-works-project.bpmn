    <sequenceFlow id="works_project_f51" sourceRef="wk_delay" targetRef="wk_requestLd"/>
    <sequenceFlow id="works_project_f52" sourceRef="wk_requestLd" targetRef="wk_rearm"/>
    <sequenceFlow id="works_project_f53" sourceRef="wk_rearm" targetRef="wk_cycle"/>
    <sequenceFlow id="works_project_f54" sourceRef="wk_checkMeasure_warn" targetRef="wk_checkMeasure_warnNotify"/>
    <sequenceFlow id="works_project_f55" sourceRef="wk_checkMeasure_warnNotify" targetRef="wk_checkMeasure_warnEnd"/>
    <sequenceFlow id="works_project_f56" sourceRef="wk_checkMeasure_breach" targetRef="wk_checkMeasure_breachAct"/>
    <sequenceFlow id="works_project_f57" sourceRef="wk_checkMeasure_breachAct" targetRef="wk_checkMeasure_breachGw"/>
    <sequenceFlow id="works_project_f58" name="deemed" sourceRef="wk_checkMeasure_breachGw" targetRef="wk_checkMeasure_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="works_project_f59" name="escalated" sourceRef="wk_checkMeasure_breachGw" targetRef="wk_checkMeasure_slaPlan"/>
    <sequenceFlow id="works_project_f60" sourceRef="wk_checkMeasure_slaPlan" targetRef="wk_checkMeasure"/>
    <sequenceFlow id="works_project_f61" sourceRef="wk_checkMeasure" targetRef="wk_checkMeasure_done"/>
    <sequenceFlow id="works_project_f62" sourceRef="wk_month" targetRef="wk_mb"/>
    <sequenceFlow id="works_project_f63" sourceRef="wk_mb" targetRef="wk_checkMeasure_slaPlan"/>
    <sequenceFlow id="works_project_f64" sourceRef="wk_checkMeasure_done" targetRef="wk_cmGw"/>
    <sequenceFlow id="works_project_f65" name="return to AE" sourceRef="wk_cmGw" targetRef="wk_mb"><conditionExpression xsi:type="tFormalExpression">${cmDecision == 'return'}</conditionExpression></sequenceFlow>
