  <process id="sangam-sec-health-blood-donation" name="Blood donation" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.health.blood-bank</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>donorName,bloodGroup</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="bd_start" name="Donor registers" operaton:initiator="initiator" operaton:formKey="sangam:sec-health-blood-bank/donor"></startEvent>
    <serviceTask id="bd_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>donorName=@customerId;bloodGroup=O+;haemoglobin=13;ttiReactive=false</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="bd_elig" name="Donor eligibility (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-health-donor</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <exclusiveGateway id="bd_gw" name="Eligible?" default="sec_health_blood_donatio_f5"></exclusiveGateway>
    <endEvent id="bd_endDeferred" name="Deferred (reason told to the donor)"></endEvent>
    <userTask id="bd_collect" name="Collect blood and label" operaton:candidateGroups="BB-TECH" operaton:formKey="sangam:sec-health-blood-bank/collect"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <userTask id="bd_tti" name="TTI testing" operaton:candidateGroups="BB-TECH" operaton:formKey="sangam:sec-health-blood-bank/tti"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="bd_ttiGw" name="Reactive?" default="sec_health_blood_donatio_f10"></exclusiveGateway>
    <userTask id="bd_discard" name="Discard and counsel the donor" operaton:candidateGroups="BB-MO" operaton:formKey="sangam:sec-health-blood-bank/discard"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <endEvent id="bd_endDiscarded" name="Discarded"></endEvent>
    <serviceTask id="bd_inventory" name="Release to inventory" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>bbms.inventory</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>add</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>sampleBarcode,bloodGroup</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>inv</operaton:string></operaton:field><operaton:field name="step"><operaton:string>inventory</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="bd_end" name="In inventory"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <sequenceFlow id="sec_health_blood_donatio_f1" sourceRef="bd_start" targetRef="bd_defaults"/>
    <sequenceFlow id="sec_health_blood_donatio_f2" sourceRef="bd_defaults" targetRef="bd_elig"/>
    <sequenceFlow id="sec_health_blood_donatio_f3" sourceRef="bd_elig" targetRef="bd_gw"/>
    <sequenceFlow id="sec_health_blood_donatio_f4" name="defer" sourceRef="bd_gw" targetRef="bd_endDeferred"><conditionExpression xsi:type="tFormalExpression">${!donorEligible}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_health_blood_donatio_f5" name="yes" sourceRef="bd_gw" targetRef="bd_collect"/>
    <sequenceFlow id="sec_health_blood_donatio_f6" sourceRef="bd_collect" targetRef="bd_tti"/>
    <sequenceFlow id="sec_health_blood_donatio_f7" sourceRef="bd_tti" targetRef="bd_ttiGw"/>
    <sequenceFlow id="sec_health_blood_donatio_f8" name="reactive" sourceRef="bd_ttiGw" targetRef="bd_discard"><conditionExpression xsi:type="tFormalExpression">${ttiReactive}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_health_blood_donatio_f9" sourceRef="bd_discard" targetRef="bd_endDiscarded"/>
    <sequenceFlow id="sec_health_blood_donatio_f10" name="non-reactive" sourceRef="bd_ttiGw" targetRef="bd_inventory"/>
    <sequenceFlow id="sec_health_blood_donatio_f11" sourceRef="bd_inventory" targetRef="bd_end"/>
  </process>
