  <message id="msg_sangam_cancelCase" name="sangam.cancelCase"/>
  <message id="msg_sangam_withdrawCase" name="sangam.withdrawCase"/>
  <process id="sangam-p4-licence" name="P4 Licence / permit" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <documentation>Pack P4. Material fields: applicantName, licenceType, tradeName, premisesAddress, durationYears, fee.</documentation>
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.p4.licence</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>applicantName,licenceType,tradeName,premisesAddress,durationYears,fee</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="p4_start" name="Application received" operaton:initiator="initiator" operaton:formKey="sangam:p4-licence/application"></startEvent>
    <serviceTask id="p4_defaults" name="Pack configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>caseType=LICENCE;routingDecisionKey=p4-approving-authority;powersDecisionKey=sangam-core-powers;signatureRequired=true;outputTemplate=licence-certificate;requireApprovalForOutput=true;appealAllowed=true;appealWindow=P30D;appellateSeat=APPELLATE-LIC;pauseOnClarification=true;retentionCategory=C;retentionYears=10;releaseConnector=paygov.refund;issueOutput=false;amount=0</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="p4_fee" name="Fee (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>p4-fee</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <businessRuleTask id="p4_timeline" name="Service timeline and deemed approval (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>p4-service-timeline</operaton:string></operaton:field><operaton:field name="binding"><operaton:string>deployment</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <serviceTask id="p4_payConfig" name="Fee payment step" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>executionConnector=paygov.fee;executionOperation=collectFee;executionStep=fee;verifyApproval=false;reconcileRequired=false;ackWindow=PT30M;executionPayloadFields=fee,applicantRef,licenceType</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="p4_payFee" name="Fee payment (core execution)" calledElement="sangam-core-execution"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <serviceTask id="p4_clock" name="Statutory clock starts on fee confirmation" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>case</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${caseSla}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <userTask id="p4_payAgain" name="Payment failed: pay again" operaton:candidateGroups="${initiatorSeat}" operaton:formKey="sangam:p4-licence/pay-again"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>payDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="p4_feeGw" name="executionOutcome?" default="p4_licence_f7"></exclusiveGateway>
    <exclusiveGateway id="p4_payAgainGw" name="" default="p4_licence_f13"></exclusiveGateway>
    <serviceTask id="p4_wdFee_kind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="p4_wdFee_call" name="Withdraw (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="p4_wdFee_end" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="p4_scrutinySeat" name="Scrutiny clerk for the ward" operaton:class="org.sangam.packs.core.SeatResolutionDelegate"><extensionElements><operaton:field name="op"><operaton:string>ROLE</operaton:string></operaton:field><operaton:field name="role"><operaton:string>SCRUTINY-CLERK</operaton:string></operaton:field><operaton:field name="targetVar"><operaton:string>scrutinySeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="p4_scrutiny" name="Scrutiny with clarification (core)" calledElement="sangam-core-scrutiny"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <callActivity id="p4_rj_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="p4_rj_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <exclusiveGateway id="p4_rj_appealGw" name="Appeal allowed?" default="p4_licence_f18"></exclusiveGateway>
    <businessRuleTask id="p4_inspRule" name="Inspection required? (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>p4-inspection-required</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <serviceTask id="p4_rjLapsed_code" name="Reason: CLARIFICATION_LAPSED" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=CLARIFICATION_LAPSED</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="p4_rjLapsed_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="p4_rjLapsed_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <exclusiveGateway id="p4_scrGw" name="scrutinyOutcome?" default="p4_licence_f23"></exclusiveGateway>
    <exclusiveGateway id="p4_inspGw" name="Inspection?" default="p4_licence_f46"></exclusiveGateway>
    <serviceTask id="p4_inspSeat" name="Inspector for the ward" operaton:class="org.sangam.packs.core.SeatResolutionDelegate"><extensionElements><operaton:field name="op"><operaton:string>ROLE</operaton:string></operaton:field><operaton:field name="role"><operaton:string>INSPECTOR</operaton:string></operaton:field><operaton:field name="targetVar"><operaton:string>inspectorSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="p4_inspect_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>p4_inspect</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${inspectionSla}</operaton:expression></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="p4_inspect" name="Schedule and conduct inspection" operaton:candidateGroups="${inspectorSeat}" operaton:formKey="sangam:p4-licence/inspection" operaton:dueDate="${p4_inspectDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>inspectionDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="p4_inspect_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>p4_inspect</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>inspectorSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="p4_inspect_warnEnd" name="Warned"></endEvent>
    <serviceTask id="p4_inspect_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>p4_inspect</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>inspectorSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>inspectionDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="p4_inspect_breachGw" name="Deemed?" default="p4_licence_f32"></exclusiveGateway>
    <exclusiveGateway id="p4_inspect_done" name=""></exclusiveGateway>
    <exclusiveGateway id="p4_inspRes" name="Inspection result?" default="p4_licence_f45"></exclusiveGateway>
    <exclusiveGateway id="p4_whoGw" name="Requested by applicant?" default="p4_licence_f39"></exclusiveGateway>
    <serviceTask id="p4_pause" name="Pause clock (applicant asked)" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PAUSE</operaton:string></operaton:field><operaton:field name="reason"><operaton:string>applicant reschedule</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="p4_newSlot" name="Tell applicant the new slot" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>inspection-rescheduled</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>sms,inapp</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>applicantRef</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="p4_resume" name="Resume clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>RESUME</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="p4_rjInsp_code" name="Reason: INSPECTION_UNSATISFACTORY" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=INSPECTION_UNSATISFACTORY</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="p4_rjInsp_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="p4_rjInsp_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="p4_breachRule" name="Approval breach rule from the timeline" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>sanctionOnBreach=@deemedAction;sanctionSla=@approvalSla</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="p4_approve" name="Approval (core sanction, deemed approval if the law provides)" calledElement="sangam-core-sanction"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <serviceTask id="p4_certificate" name="Signed certificate from the approved data" operaton:class="org.sangam.packs.core.DocumentDelegate"><extensionElements><operaton:field name="template"><operaton:string>licence-certificate</operaton:string></operaton:field><operaton:field name="requireApproval"><operaton:string>true</operaton:string></operaton:field><operaton:field name="resultVar"><operaton:string>licenceNo</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="p4_sanGw" name="sanctionOutcome?" default="p4_licence_f51"></exclusiveGateway>
    <serviceTask id="p4_pushConfig" name="DigiLocker push step" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>executionConnector=digilocker.push;executionOperation=pushCertificate;executionStep=digilocker;verifyApproval=true;reconcileRequired=false;ackWindow=PT1H;executionPayloadFields=licenceNo,applicantName,licenceType,approvedPayloadHash</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="p4_push" name="Push to DigiLocker (core execution)" calledElement="sangam-core-execution"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <callActivity id="p4_close" name="Notify and close (core)" calledElement="sangam-core-closure"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <serviceTask id="p4_pushPending" name="Partial success: DigiLocker copy pending" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>digilocker-pending</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>sms,inapp</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>applicantRef</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="p4_pushGw" name="executionOutcome?" default="p4_licence_f56"></exclusiveGateway>
    <endEvent id="p4_end" name="Licence issued"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="p4_inspect_warn" name="SLA warning (75%)" attachedToRef="p4_inspect" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${p4_inspectWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="p4_inspect_breach" name="SLA breached" attachedToRef="p4_inspect" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${p4_inspectDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="p4_licence_f1" sourceRef="p4_start" targetRef="p4_defaults"/>
    <sequenceFlow id="p4_licence_f2" sourceRef="p4_defaults" targetRef="p4_fee"/>
    <sequenceFlow id="p4_licence_f3" sourceRef="p4_fee" targetRef="p4_timeline"/>
    <sequenceFlow id="p4_licence_f4" sourceRef="p4_timeline" targetRef="p4_payConfig"/>
    <sequenceFlow id="p4_licence_f5" sourceRef="p4_payConfig" targetRef="p4_payFee"/>
    <sequenceFlow id="p4_licence_f6" name="DONE" sourceRef="p4_feeGw" targetRef="p4_clock"><conditionExpression xsi:type="tFormalExpression">${executionOutcome == 'DONE'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p4_licence_f7" name="otherwise" sourceRef="p4_feeGw" targetRef="p4_payAgain"/>
    <sequenceFlow id="p4_licence_f8" sourceRef="p4_payFee" targetRef="p4_feeGw"/>
    <sequenceFlow id="p4_licence_f9" sourceRef="p4_payAgain" targetRef="p4_payAgainGw"/>
    <sequenceFlow id="p4_licence_f10" name="pay again" sourceRef="p4_payAgainGw" targetRef="p4_payFee"><conditionExpression xsi:type="tFormalExpression">${payDecision == 'resubmit'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p4_licence_f11" sourceRef="p4_wdFee_kind" targetRef="p4_wdFee_call"/>
    <sequenceFlow id="p4_licence_f12" sourceRef="p4_wdFee_call" targetRef="p4_wdFee_end"/>
    <sequenceFlow id="p4_licence_f13" name="withdraw" sourceRef="p4_payAgainGw" targetRef="p4_wdFee_kind"/>
    <sequenceFlow id="p4_licence_f14" sourceRef="p4_clock" targetRef="p4_scrutinySeat"/>
    <sequenceFlow id="p4_licence_f15" sourceRef="p4_scrutinySeat" targetRef="p4_scrutiny"/>
    <sequenceFlow id="p4_licence_f16" sourceRef="p4_rj_reject" targetRef="p4_rj_appealGw"/>
    <sequenceFlow id="p4_licence_f17" name="appeal allowed: re-verify" sourceRef="p4_rj_appealGw" targetRef="p4_breachRule"><conditionExpression xsi:type="tFormalExpression">${rejectionOutcome == 'APPEAL_ALLOWED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p4_licence_f18" name="final" sourceRef="p4_rj_appealGw" targetRef="p4_rj_endRejected"/>
    <sequenceFlow id="p4_licence_f19" sourceRef="p4_rjLapsed_reject" targetRef="p4_rjLapsed_endRejected"/>
    <sequenceFlow id="p4_licence_f20" sourceRef="p4_rjLapsed_code" targetRef="p4_rjLapsed_reject"/>
    <sequenceFlow id="p4_licence_f21" name="ACCEPTED" sourceRef="p4_scrGw" targetRef="p4_inspRule"><conditionExpression xsi:type="tFormalExpression">${scrutinyOutcome == 'ACCEPTED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p4_licence_f22" name="LAPSED" sourceRef="p4_scrGw" targetRef="p4_rjLapsed_code"><conditionExpression xsi:type="tFormalExpression">${scrutinyOutcome == 'LAPSED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p4_licence_f23" name="otherwise" sourceRef="p4_scrGw" targetRef="p4_rj_reject"/>
    <sequenceFlow id="p4_licence_f24" sourceRef="p4_scrutiny" targetRef="p4_scrGw"/>
    <sequenceFlow id="p4_licence_f25" sourceRef="p4_inspRule" targetRef="p4_inspGw"/>
    <sequenceFlow id="p4_licence_f26" name="yes" sourceRef="p4_inspGw" targetRef="p4_inspSeat"><conditionExpression xsi:type="tFormalExpression">${inspectionRequired}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p4_licence_f27" sourceRef="p4_inspect_warn" targetRef="p4_inspect_warnNotify"/>
    <sequenceFlow id="p4_licence_f28" sourceRef="p4_inspect_warnNotify" targetRef="p4_inspect_warnEnd"/>
    <sequenceFlow id="p4_licence_f29" sourceRef="p4_inspect_breach" targetRef="p4_inspect_breachAct"/>
    <sequenceFlow id="p4_licence_f30" sourceRef="p4_inspect_breachAct" targetRef="p4_inspect_breachGw"/>
    <sequenceFlow id="p4_licence_f31" name="deemed" sourceRef="p4_inspect_breachGw" targetRef="p4_inspect_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p4_licence_f32" name="escalated" sourceRef="p4_inspect_breachGw" targetRef="p4_inspect_slaPlan"/>
    <sequenceFlow id="p4_licence_f33" sourceRef="p4_inspect_slaPlan" targetRef="p4_inspect"/>
    <sequenceFlow id="p4_licence_f34" sourceRef="p4_inspect" targetRef="p4_inspect_done"/>
    <sequenceFlow id="p4_licence_f35" sourceRef="p4_inspSeat" targetRef="p4_inspect_slaPlan"/>
    <sequenceFlow id="p4_licence_f36" sourceRef="p4_inspect_done" targetRef="p4_inspRes"/>
    <sequenceFlow id="p4_licence_f37" name="J-P4-E05" sourceRef="p4_inspRes" targetRef="p4_whoGw"><conditionExpression xsi:type="tFormalExpression">${inspectionDecision == 'reschedule'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p4_licence_f38" name="applicant" sourceRef="p4_whoGw" targetRef="p4_pause"><conditionExpression xsi:type="tFormalExpression">${rescheduleRequestedBy == 'applicant'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p4_licence_f39" name="department" sourceRef="p4_whoGw" targetRef="p4_newSlot"/>
    <sequenceFlow id="p4_licence_f40" sourceRef="p4_pause" targetRef="p4_newSlot"/>
    <sequenceFlow id="p4_licence_f41" sourceRef="p4_newSlot" targetRef="p4_inspect_slaPlan"/>
    <sequenceFlow id="p4_licence_f42" name="satisfactory" sourceRef="p4_inspRes" targetRef="p4_resume"><conditionExpression xsi:type="tFormalExpression">${inspectionDecision == 'satisfactory'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p4_licence_f43" sourceRef="p4_rjInsp_reject" targetRef="p4_rjInsp_endRejected"/>
    <sequenceFlow id="p4_licence_f44" sourceRef="p4_rjInsp_code" targetRef="p4_rjInsp_reject"/>
    <sequenceFlow id="p4_licence_f45" name="unsatisfactory" sourceRef="p4_inspRes" targetRef="p4_rjInsp_code"/>
    <sequenceFlow id="p4_licence_f46" name="no inspection" sourceRef="p4_inspGw" targetRef="p4_breachRule"/>
    <sequenceFlow id="p4_licence_f47" sourceRef="p4_resume" targetRef="p4_breachRule"/>
    <sequenceFlow id="p4_licence_f48" sourceRef="p4_breachRule" targetRef="p4_approve"/>
    <sequenceFlow id="p4_licence_f49" name="SANCTIONED" sourceRef="p4_sanGw" targetRef="p4_certificate"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p4_licence_f50" name="RETURNED" sourceRef="p4_sanGw" targetRef="p4_scrutinySeat"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'RETURNED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p4_licence_f51" name="otherwise" sourceRef="p4_sanGw" targetRef="p4_rj_reject"/>
    <sequenceFlow id="p4_licence_f52" sourceRef="p4_approve" targetRef="p4_sanGw"/>
    <sequenceFlow id="p4_licence_f53" sourceRef="p4_certificate" targetRef="p4_pushConfig"/>
    <sequenceFlow id="p4_licence_f54" sourceRef="p4_pushConfig" targetRef="p4_push"/>
    <sequenceFlow id="p4_licence_f55" name="DONE" sourceRef="p4_pushGw" targetRef="p4_close"><conditionExpression xsi:type="tFormalExpression">${executionOutcome == 'DONE'}</conditionExpression></sequenceFlow>
