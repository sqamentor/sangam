<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_sec_health_drug_control" name="Drug schedule controls" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="sec-health-drug-control" name="Drug schedule controls" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="sec-health-drug-control_t" hitPolicy="FIRST">
      <input id="sec-health-drug-control_i0" label="Schedule"><inputExpression id="sec-health-drug-control_ie0" typeRef="string"><text>drugSchedule</text></inputExpression></input>
      <output id="sec-health-drug-control_o0" label="Prescription" name="prescriptionRequired" typeRef="boolean"/>
      <output id="sec-health-drug-control_o1" label="Register" name="registerRequired" typeRef="boolean"/>
      <output id="sec-health-drug-control_o2" label="Second pharmacist" name="dualCheck" typeRef="boolean"/>
      <rule id="sec-health-drug-control_r0">
        <inputEntry id="sec-health-drug-control_r0_i0"><text>"OTC"</text></inputEntry>
        <outputEntry id="sec-health-drug-control_r0_o0"><text>false</text></outputEntry>
        <outputEntry id="sec-health-drug-control_r0_o1"><text>false</text></outputEntry>
        <outputEntry id="sec-health-drug-control_r0_o2"><text>false</text></outputEntry>
      </rule>
      <rule id="sec-health-drug-control_r1">
        <inputEntry id="sec-health-drug-control_r1_i0"><text>"H"</text></inputEntry>
        <outputEntry id="sec-health-drug-control_r1_o0"><text>true</text></outputEntry>
        <outputEntry id="sec-health-drug-control_r1_o1"><text>false</text></outputEntry>
        <outputEntry id="sec-health-drug-control_r1_o2"><text>false</text></outputEntry>
      </rule>
      <rule id="sec-health-drug-control_r2"><description>H1 register: patient, prescriber, drug, quantity</description>
        <inputEntry id="sec-health-drug-control_r2_i0"><text>"H1"</text></inputEntry>
        <outputEntry id="sec-health-drug-control_r2_o0"><text>true</text></outputEntry>
        <outputEntry id="sec-health-drug-control_r2_o1"><text>true</text></outputEntry>
        <outputEntry id="sec-health-drug-control_r2_o2"><text>false</text></outputEntry>
      </rule>
      <rule id="sec-health-drug-control_r3"><description>Schedule X: copy retained, dual check</description>
        <inputEntry id="sec-health-drug-control_r3_i0"><text>"X"</text></inputEntry>
        <outputEntry id="sec-health-drug-control_r3_o0"><text>true</text></outputEntry>
        <outputEntry id="sec-health-drug-control_r3_o1"><text>true</text></outputEntry>
        <outputEntry id="sec-health-drug-control_r3_o2"><text>true</text></outputEntry>
      </rule>
      <rule id="sec-health-drug-control_r4"><description>NDPS and anything unknown: strictest</description>
        <inputEntry id="sec-health-drug-control_r4_i0"><text>-</text></inputEntry>
        <outputEntry id="sec-health-drug-control_r4_o0"><text>true</text></outputEntry>
        <outputEntry id="sec-health-drug-control_r4_o1"><text>true</text></outputEntry>
        <outputEntry id="sec-health-drug-control_r4_o2"><text>true</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
