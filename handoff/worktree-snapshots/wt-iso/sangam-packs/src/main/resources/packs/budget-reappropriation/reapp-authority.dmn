<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_reapp_authority" name="Re-appropriation power" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="reapp-authority" name="Re-appropriation power" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="reapp-authority_t" hitPolicy="FIRST">
      <input id="reapp-authority_i0" label="Amount"><inputExpression id="reapp-authority_ie0" typeRef="number"><text>amount</text></inputExpression></input>
      <output id="reapp-authority_o0" label="Competent role" name="competentRole" typeRef="string"/>
      <rule id="reapp-authority_r0">
        <inputEntry id="reapp-authority_r0_i0"><text>&lt;= 1000000</text></inputEntry>
        <outputEntry id="reapp-authority_r0_o0"><text>"HOD"</text></outputEntry>
      </rule>
      <rule id="reapp-authority_r1">
        <inputEntry id="reapp-authority_r1_i0"><text>&lt;= 10000000</text></inputEntry>
        <outputEntry id="reapp-authority_r1_o0"><text>"SECRETARY"</text></outputEntry>
      </rule>
      <rule id="reapp-authority_r2">
        <inputEntry id="reapp-authority_r2_i0"><text>-</text></inputEntry>
        <outputEntry id="reapp-authority_r2_o0"><text>"FIN-SECY"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
