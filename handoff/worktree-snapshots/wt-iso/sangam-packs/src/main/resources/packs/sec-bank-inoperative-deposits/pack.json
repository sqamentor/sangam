{
  "id": "sec.bank.inoperative-deposits",
  "version": "1.0.0",
  "name": {
    "en": "Inoperative accounts and unclaimed deposits (DEA Fund)",
    "hi": "निष्क्रिय खाते एवं अदावी जमा (डीईए निधि)"
  },
  "domain": "Banking",
  "description": "Monthly review, one case per account: no customer-induced transaction for 2 years makes the account inoperative (customer told in advance, no charge for activation); balances unclaimed for 10 years are transferred to the RBI DEA Fund; reactivation or claim with KYC updated, no fee, claim refunded from the DEA Fund with interest where payable.",
