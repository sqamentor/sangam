<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_ifms_reapp_authority" name="Competent authority" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <!-- Re-appropriation power is not re-delegable (IFC-007). -->
  <decision id="ifms-reapp-authority" name="Competent authority" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="ifms-reapp-authority_t" hitPolicy="FIRST">
      <input id="ifms-reapp-authority_i0" label="Amount (INR)"><inputExpression id="ifms-reapp-authority_ie0" typeRef="number"><text>amount</text></inputExpression></input>
      <output id="ifms-reapp-authority_o0" label="Competent role" name="competentRole" typeRef="string"/>
      <rule id="ifms-reapp-authority_r0"><description>Secretary as Chief Accounting Authority (DFPR r.10(9)); non-delegable (r.12(2))</description>
        <inputEntry id="ifms-reapp-authority_r0_i0"><text>-</text></inputEntry>
        <outputEntry id="ifms-reapp-authority_r0_o0"><text>"CAA"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
