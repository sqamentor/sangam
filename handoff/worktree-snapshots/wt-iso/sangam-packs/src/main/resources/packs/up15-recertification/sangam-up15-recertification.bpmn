  <process id="sangam-up15-recertification" name="UP-15 Recertification campaign" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>universal.up15-recertification</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>period</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="u15_timer" name="Monthly"><timerEventDefinition><timeCycle xsi:type="tFormalExpression">0 0 6 1 * ?</timeCycle></timerEventDefinition></startEvent>
    <serviceTask id="u15_load" name="Entities due" operaton:class="org.sangam.packs.core.BatchDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>LOAD</operaton:string></operaton:field><operaton:field name="connector"><operaton:string>iam.entitiesDue</operaton:string></operaton:field><operaton:field name="sampleSize"><operaton:string>4</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="u15_open" name="Open round" operaton:class="org.sangam.packs.core.BatchDelegate"><extensionElements><operaton:field name="op"><operaton:string>OPEN</operaton:string></operaton:field><operaton:field name="itemsVar"><operaton:string>items</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="u15_fanOut" name="Start one instance per item (chunk)" operaton:class="org.sangam.packs.core.BatchDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>FAN_OUT</operaton:string></operaton:field><operaton:field name="itemsVar"><operaton:string>items</operaton:string></operaton:field><operaton:field name="childProcessKey"><operaton:string>sangam-up15-recertify</operaton:string></operaton:field><operaton:field name="chunkSize"><operaton:string>100</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="u15_fanGw" name="All started?" default="up15_recertification_f5"></exclusiveGateway>
    <intermediateCatchEvent id="u15_poll" name="Poll aggregate"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">PT1H</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <serviceTask id="u15_aggregate" name="Aggregate outcomes" operaton:class="org.sangam.packs.core.BatchDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>AGGREGATE</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="u15_doneGw" name="Round complete?" default="up15_recertification_f10"></exclusiveGateway>
    <endEvent id="u15_end" name="Campaign closed"></endEvent>
    <sequenceFlow id="up15_recertification_f1" sourceRef="u15_timer" targetRef="u15_load"/>
    <sequenceFlow id="up15_recertification_f2" sourceRef="u15_open" targetRef="u15_fanOut"/>
    <sequenceFlow id="up15_recertification_f3" sourceRef="u15_fanOut" targetRef="u15_fanGw"/>
    <sequenceFlow id="up15_recertification_f4" name="next chunk" sourceRef="u15_fanGw" targetRef="u15_fanOut"><conditionExpression xsi:type="tFormalExpression">${!fanOutDone}</conditionExpression></sequenceFlow>
    <sequenceFlow id="up15_recertification_f5" name="all started" sourceRef="u15_fanGw" targetRef="u15_poll"/>
    <sequenceFlow id="up15_recertification_f6" sourceRef="u15_poll" targetRef="u15_aggregate"/>
    <sequenceFlow id="up15_recertification_f7" sourceRef="u15_aggregate" targetRef="u15_doneGw"/>
    <sequenceFlow id="up15_recertification_f8" name="not yet" sourceRef="u15_doneGw" targetRef="u15_poll"><conditionExpression xsi:type="tFormalExpression">${!batchComplete}</conditionExpression></sequenceFlow>
    <sequenceFlow id="up15_recertification_f9" sourceRef="u15_load" targetRef="u15_open"/>
    <sequenceFlow id="up15_recertification_f10" name="complete" sourceRef="u15_doneGw" targetRef="u15_end"/>
  </process>
