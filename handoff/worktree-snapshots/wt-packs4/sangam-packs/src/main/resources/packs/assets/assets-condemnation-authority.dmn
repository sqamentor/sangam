<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_assets_condemnation_authority" name="Condemnation powers by book value" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="assets-condemnation-authority" name="Condemnation powers by book value" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="assets-condemnation-authority_t" hitPolicy="FIRST">
      <input id="assets-condemnation-authority_i0" label="Amount"><inputExpression id="assets-condemnation-authority_ie0" typeRef="number"><text>amount</text></inputExpression></input>
      <output id="assets-condemnation-authority_o0" label="Competent role" name="competentRole" typeRef="string"/>
      <rule id="assets-condemnation-authority_r0">
        <inputEntry id="assets-condemnation-authority_r0_i0"><text>&lt;= 50000000</text></inputEntry>
        <outputEntry id="assets-condemnation-authority_r0_o0"><text>"HOO"</text></outputEntry>
      </rule>
      <rule id="assets-condemnation-authority_r1">
        <inputEntry id="assets-condemnation-authority_r1_i0"><text>-</text></inputEntry>
        <outputEntry id="assets-condemnation-authority_r1_o0"><text>"HOD"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
