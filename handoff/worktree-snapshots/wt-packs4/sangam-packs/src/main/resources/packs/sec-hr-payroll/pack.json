      "capabilityClass": "c",
      "govTag": "",
      "purpose": "Salary payment file"
    },
    {
      "id": "epfo.ecr",
      "capabilityClass": "b",
      "govTag": "",
      "purpose": "PF ECR"
    },
    {
      "id": "esic.contribution",
      "capabilityClass": "b",
      "govTag": "",
      "purpose": "ESI contribution"
    },
    {
      "id": "docs.payslip",
      "capabilityClass": "a",
      "govTag": "",
      "purpose": "Payslips"
    }
  ],
  "covers": [
    "SEC-HR-005",
    "GP-01",
    "GP-30",
    "GP-12",
    "UP-05"
  ],
