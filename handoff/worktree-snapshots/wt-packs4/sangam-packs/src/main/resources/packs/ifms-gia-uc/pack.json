      "path": "packs/ifms-gia-uc/forms/release.form.json"
    },
    {
      "kind": "FORM",
      "path": "packs/ifms-gia-uc/forms/fa.form.json"
    },
    {
      "kind": "FORM",
      "path": "packs/ifms-gia-uc/forms/uc-review.form.json"
