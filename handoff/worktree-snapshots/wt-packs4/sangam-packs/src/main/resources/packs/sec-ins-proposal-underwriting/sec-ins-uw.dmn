<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_sec_ins_uw" name="Underwriting route (SYNTHETIC grid)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="sec-ins-uw" name="Underwriting route (SYNTHETIC grid)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="sec-ins-uw_t" hitPolicy="FIRST">
      <input id="sec-ins-uw_i0" label="Age"><inputExpression id="sec-ins-uw_ie0" typeRef="integer"><text>age</text></inputExpression></input>
      <input id="sec-ins-uw_i1" label="Sum assured"><inputExpression id="sec-ins-uw_ie1" typeRef="number"><text>sumAssured</text></inputExpression></input>
      <input id="sec-ins-uw_i2" label="Smoker"><inputExpression id="sec-ins-uw_ie2" typeRef="boolean"><text>smoker</text></inputExpression></input>
      <output id="sec-ins-uw_o0" label="Route" name="uwRoute" typeRef="string"/>
      <output id="sec-ins-uw_o1" label="Medicals" name="medicalRequired" typeRef="boolean"/>
      <output id="sec-ins-uw_o2" label="Decide within" name="decisionSpec" typeRef="string"/>
      <output id="sec-ins-uw_o3" label="Free-look period" name="freeLookSpec" typeRef="string"/>
      <rule id="sec-ins-uw_r0"><description>above 50: medicals</description>
        <inputEntry id="sec-ins-uw_r0_i0"><text>&gt; 50</text></inputEntry>
        <inputEntry id="sec-ins-uw_r0_i1"><text>-</text></inputEntry>
        <inputEntry id="sec-ins-uw_r0_i2"><text>-</text></inputEntry>
        <outputEntry id="sec-ins-uw_r0_o0"><text>"MANUAL"</text></outputEntry>
        <outputEntry id="sec-ins-uw_r0_o1"><text>true</text></outputEntry>
        <outputEntry id="sec-ins-uw_r0_o2"><text>"7D"</text></outputEntry>
        <outputEntry id="sec-ins-uw_r0_o3"><text>"30D"</text></outputEntry>
      </rule>
      <rule id="sec-ins-uw_r1"><description>above 1 crore</description>
        <inputEntry id="sec-ins-uw_r1_i0"><text>-</text></inputEntry>
        <inputEntry id="sec-ins-uw_r1_i1"><text>&gt; 1000000000</text></inputEntry>
        <inputEntry id="sec-ins-uw_r1_i2"><text>-</text></inputEntry>
        <outputEntry id="sec-ins-uw_r1_o0"><text>"MANUAL"</text></outputEntry>
        <outputEntry id="sec-ins-uw_r1_o1"><text>true</text></outputEntry>
        <outputEntry id="sec-ins-uw_r1_o2"><text>"7D"</text></outputEntry>
        <outputEntry id="sec-ins-uw_r1_o3"><text>"30D"</text></outputEntry>
      </rule>
      <rule id="sec-ins-uw_r2"><description>smoker: manual</description>
        <inputEntry id="sec-ins-uw_r2_i0"><text>-</text></inputEntry>
        <inputEntry id="sec-ins-uw_r2_i1"><text>-</text></inputEntry>
        <inputEntry id="sec-ins-uw_r2_i2"><text>true</text></inputEntry>
        <outputEntry id="sec-ins-uw_r2_o0"><text>"MANUAL"</text></outputEntry>
        <outputEntry id="sec-ins-uw_r2_o1"><text>false</text></outputEntry>
        <outputEntry id="sec-ins-uw_r2_o2"><text>"7D"</text></outputEntry>
        <outputEntry id="sec-ins-uw_r2_o3"><text>"30D"</text></outputEntry>
      </rule>
      <rule id="sec-ins-uw_r3"><description>decide within 7 days of the complete proposal; free-look 30 days (verify)</description>
        <inputEntry id="sec-ins-uw_r3_i0"><text>-</text></inputEntry>
        <inputEntry id="sec-ins-uw_r3_i1"><text>-</text></inputEntry>
        <inputEntry id="sec-ins-uw_r3_i2"><text>-</text></inputEntry>
        <outputEntry id="sec-ins-uw_r3_o0"><text>"STP"</text></outputEntry>
        <outputEntry id="sec-ins-uw_r3_o1"><text>false</text></outputEntry>
        <outputEntry id="sec-ins-uw_r3_o2"><text>"7D"</text></outputEntry>
        <outputEntry id="sec-ins-uw_r3_o3"><text>"30D"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
