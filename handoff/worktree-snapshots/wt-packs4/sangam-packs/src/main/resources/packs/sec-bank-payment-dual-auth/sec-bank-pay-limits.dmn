<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_sec_bank_pay_limits" name="Rail limits and authorisation levels (SYNTHETIC bands)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="sec-bank-pay-limits" name="Rail limits and authorisation levels (SYNTHETIC bands)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="sec-bank-pay-limits_t" hitPolicy="FIRST">
      <input id="sec-bank-pay-limits_i0" label="Rail"><inputExpression id="sec-bank-pay-limits_ie0" typeRef="string"><text>paymentRail</text></inputExpression></input>
      <input id="sec-bank-pay-limits_i1" label="Amount"><inputExpression id="sec-bank-pay-limits_ie1" typeRef="number"><text>amount</text></inputExpression></input>
      <output id="sec-bank-pay-limits_o0" label="Rail allowed" name="railAllowed" typeRef="boolean"/>
      <output id="sec-bank-pay-limits_o1" label="Authorisation levels" name="authLevels" typeRef="integer"/>
      <output id="sec-bank-pay-limits_o2" label="Ceiling of the authoriser band covering the amount (INR)" name="authBandMax" typeRef="number"/>
      <rule id="sec-bank-pay-limits_r0"><description>RTGS minimum 2 lakh</description>
        <inputEntry id="sec-bank-pay-limits_r0_i0"><text>"RTGS"</text></inputEntry>
        <inputEntry id="sec-bank-pay-limits_r0_i1"><text>&lt; 20000000</text></inputEntry>
        <outputEntry id="sec-bank-pay-limits_r0_o0"><text>false</text></outputEntry>
        <outputEntry id="sec-bank-pay-limits_r0_o1"><text>1</text></outputEntry>
        <outputEntry id="sec-bank-pay-limits_r0_o2"><text>0</text></outputEntry>
      </rule>
      <rule id="sec-bank-pay-limits_r1"><description>IMPS per-transaction cap 5 lakh</description>
        <inputEntry id="sec-bank-pay-limits_r1_i0"><text>"IMPS"</text></inputEntry>
        <inputEntry id="sec-bank-pay-limits_r1_i1"><text>&gt; 50000000</text></inputEntry>
        <outputEntry id="sec-bank-pay-limits_r1_o0"><text>false</text></outputEntry>
        <outputEntry id="sec-bank-pay-limits_r1_o1"><text>1</text></outputEntry>
        <outputEntry id="sec-bank-pay-limits_r1_o2"><text>0</text></outputEntry>
      </rule>
      <rule id="sec-bank-pay-limits_r2"><description>above every authoriser band: no concurrence possible (SL-50)</description>
        <inputEntry id="sec-bank-pay-limits_r2_i0"><text>-</text></inputEntry>
        <inputEntry id="sec-bank-pay-limits_r2_i1"><text>&gt; 1000000000000</text></inputEntry>
        <outputEntry id="sec-bank-pay-limits_r2_o0"><text>true</text></outputEntry>
        <outputEntry id="sec-bank-pay-limits_r2_o1"><text>2</text></outputEntry>
        <outputEntry id="sec-bank-pay-limits_r2_o2"><text>0</text></outputEntry>
      </rule>
      <rule id="sec-bank-pay-limits_r3"><description>checker and authoriser; band of TREASURYHEAD</description>
        <inputEntry id="sec-bank-pay-limits_r3_i0"><text>-</text></inputEntry>
        <inputEntry id="sec-bank-pay-limits_r3_i1"><text>&gt; 10000000000</text></inputEntry>
        <outputEntry id="sec-bank-pay-limits_r3_o0"><text>true</text></outputEntry>
        <outputEntry id="sec-bank-pay-limits_r3_o1"><text>2</text></outputEntry>
        <outputEntry id="sec-bank-pay-limits_r3_o2"><text>1000000000000</text></outputEntry>
      </rule>
      <rule id="sec-bank-pay-limits_r4"><description>checker and authoriser; band of PAYAUTH</description>
        <inputEntry id="sec-bank-pay-limits_r4_i0"><text>-</text></inputEntry>
        <inputEntry id="sec-bank-pay-limits_r4_i1"><text>&gt; 250000000</text></inputEntry>
        <outputEntry id="sec-bank-pay-limits_r4_o0"><text>true</text></outputEntry>
        <outputEntry id="sec-bank-pay-limits_r4_o1"><text>2</text></outputEntry>
        <outputEntry id="sec-bank-pay-limits_r4_o2"><text>10000000000</text></outputEntry>
      </rule>
      <rule id="sec-bank-pay-limits_r5"><description>checker alone</description>
        <inputEntry id="sec-bank-pay-limits_r5_i0"><text>-</text></inputEntry>
        <inputEntry id="sec-bank-pay-limits_r5_i1"><text>-</text></inputEntry>
        <outputEntry id="sec-bank-pay-limits_r5_o0"><text>true</text></outputEntry>
        <outputEntry id="sec-bank-pay-limits_r5_o1"><text>1</text></outputEntry>
        <outputEntry id="sec-bank-pay-limits_r5_o2"><text>0</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
