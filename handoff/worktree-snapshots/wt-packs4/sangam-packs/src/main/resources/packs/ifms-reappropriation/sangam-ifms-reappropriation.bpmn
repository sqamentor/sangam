      <bpmndi:BPMNShape id="ra_fa_slaPlan_di" bpmnElement="ra_fa_slaPlan"><dc:Bounds x="845" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ra_fa_di" bpmnElement="ra_fa"><dc:Bounds x="1010" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ra_fa_warnNotify_di" bpmnElement="ra_fa_warnNotify"><dc:Bounds x="1175" y="155" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ra_fa_warnEnd_di" bpmnElement="ra_fa_warnEnd"><dc:Bounds x="1372" y="177" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ra_fa_breachAct_di" bpmnElement="ra_fa_breachAct"><dc:Bounds x="1175" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ra_fa_breachGw_di" bpmnElement="ra_fa_breachGw"><dc:Bounds x="1365" y="45" width="50" height="50"/></bpmndi:BPMNShape>
