<!-- Commitment to payment. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_intl_pfm_execution" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_cancelCase" name="sangam.cancelCase"/>
  <message id="msg_sangam_withdrawCase" name="sangam.withdrawCase"/>
  <process id="sangam-intl-pfm-execution" name="Commitment to payment" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.intl.pfm-execution</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>spendingUnit,budgetLine,amount,payee</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="pe_start" name="Commitment requested" operaton:initiator="initiator" operaton:formKey="sangam:gov-intl-pfm-execution/request"></startEvent>
    <serviceTask id="pe_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>spendingUnit=SU-1;budgetLine=GEN-01;commitmentType=ORDINARY;amount=0;payee=;ledgerId=BUDGET;fundsAvailable=0;payeeClear=true;caseType=COMMITMENT;routingDecisionKey=intl-pfm-commitment-authority;powersDecisionKey=intl-pfm-powers;scrutinySeat=BUDGET-HOLDER;executionConnector=treasury.pay;executionStep=pay;reconcileRequired=true;reconcileConnector=bank.statement;executionPayloadFields=payee,amount,budgetLine;outputTemplate=payment-advice;appealAllowed=false;verifierSeat=VERIFIER;certifierSeat=CERTIFYING-OFFICER;budgetOfficeSeat=BUDGET-OFFICE</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="pe_available" name="Available released authority (PFM-034)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>ledger.available</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>available</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>ledgerId,budgetLine,spendingUnit</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>funds</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="pe_fundsGw" name="Authority available?" default="intl_pfm_execution_f6"></exclusiveGateway>
    <userTask id="pe_breach" name="Breach: report to the configured authorities (PFM-039)" operaton:candidateGroups="${budgetOfficeSeat}" operaton:formKey="sangam:gov-intl-pfm-execution/breach"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <endEvent id="pe_endBreach" name="Breach reported, no commitment"></endEvent>
    <callActivity id="pe_scrutiny" name="Budget holder scrutiny (core)" calledElement="sangam-core-scrutiny"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <callActivity id="pe_commit" name="Commitment approver (core sanction, delegation DMN)" calledElement="sangam-core-sanction"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <callActivity id="pe_rj_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="pe_rj_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <exclusiveGateway id="pe_scGw" name="scrutinyOutcome?" default="intl_pfm_execution_f9"></exclusiveGateway>
    <serviceTask id="pe_encumber" name="Record the commitment (encumbrance)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>ledger.encumber</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>encumber</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>ledgerId,budgetLine,spendingUnit,amount</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>enc</operaton:string></operaton:field><operaton:field name="step"><operaton:string>commit</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="pe_snGw" name="sanctionOutcome?" default="intl_pfm_execution_f12"></exclusiveGateway>
    <userTask id="pe_verify" name="Verify receipt (not the committer, PFM-041)" operaton:candidateGroups="${verifierSeat}" operaton:formKey="sangam:gov-intl-pfm-execution/verify"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"><operaton:field name="steps"><operaton:string>sn_sanction</operaton:string></operaton:field></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>verifyDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="pe_verifyGw" name="" default="intl_pfm_execution_f17"></exclusiveGateway>
    <serviceTask id="pe_payee" name="Payee integrity (PFM-049)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>payee.integrity</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>check</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>payee</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>payee</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="pe_payeeGw" name="Payee clear?" default="intl_pfm_execution_f20"></exclusiveGateway>
    <userTask id="pe_certify" name="Certify the payment order (PFM-048)" operaton:candidateGroups="${certifierSeat}" operaton:formKey="sangam:gov-intl-pfm-execution/certify"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"><operaton:field name="steps"><operaton:string>pe_verify,sn_sanction</operaton:string></operaton:field></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>certifyDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="pe_certGw" name="" default="intl_pfm_execution_f23"></exclusiveGateway>
    <callActivity id="pe_pay" name="Payment (core execution, class c)" calledElement="sangam-core-execution"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <callActivity id="pe_close" name="Advice and closure (core)" calledElement="sangam-core-closure"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <serviceTask id="pe_failed" name="Payment failed on the rail" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>payment-failed</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>inapp</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>initiatorSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="pe_exGw" name="executionOutcome?" default="intl_pfm_execution_f25"></exclusiveGateway>
    <endEvent id="pe_endFailed" name="Payment failed"></endEvent>
    <endEvent id="pe_end" name="Paid"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <sequenceFlow id="intl_pfm_execution_f1" sourceRef="pe_start" targetRef="pe_defaults"/>
    <sequenceFlow id="intl_pfm_execution_f2" sourceRef="pe_defaults" targetRef="pe_available"/>
    <sequenceFlow id="intl_pfm_execution_f3" sourceRef="pe_available" targetRef="pe_fundsGw"/>
    <sequenceFlow id="intl_pfm_execution_f4" name="short of authority" sourceRef="pe_fundsGw" targetRef="pe_breach"><conditionExpression xsi:type="tFormalExpression">${fundsAvailable &lt; amount}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_execution_f5" sourceRef="pe_breach" targetRef="pe_endBreach"/>
    <sequenceFlow id="intl_pfm_execution_f6" name="available" sourceRef="pe_fundsGw" targetRef="pe_scrutiny"/>
    <sequenceFlow id="intl_pfm_execution_f7" sourceRef="pe_rj_reject" targetRef="pe_rj_endRejected"/>
    <sequenceFlow id="intl_pfm_execution_f8" name="ACCEPTED" sourceRef="pe_scGw" targetRef="pe_commit"><conditionExpression xsi:type="tFormalExpression">${scrutinyOutcome == 'ACCEPTED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_execution_f9" name="otherwise" sourceRef="pe_scGw" targetRef="pe_rj_reject"/>
    <sequenceFlow id="intl_pfm_execution_f10" sourceRef="pe_scrutiny" targetRef="pe_scGw"/>
    <sequenceFlow id="intl_pfm_execution_f11" name="SANCTIONED" sourceRef="pe_snGw" targetRef="pe_encumber"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_execution_f12" name="otherwise" sourceRef="pe_snGw" targetRef="pe_rj_reject"/>
    <sequenceFlow id="intl_pfm_execution_f13" sourceRef="pe_commit" targetRef="pe_snGw"/>
    <sequenceFlow id="intl_pfm_execution_f14" sourceRef="pe_encumber" targetRef="pe_verify"/>
    <sequenceFlow id="intl_pfm_execution_f15" sourceRef="pe_verify" targetRef="pe_verifyGw"/>
    <sequenceFlow id="intl_pfm_execution_f16" name="not received" sourceRef="pe_verifyGw" targetRef="pe_rj_reject"><conditionExpression xsi:type="tFormalExpression">${verifyDecision == 'reject'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_execution_f17" name="verified" sourceRef="pe_verifyGw" targetRef="pe_payee"/>
    <sequenceFlow id="intl_pfm_execution_f18" sourceRef="pe_payee" targetRef="pe_payeeGw"/>
    <sequenceFlow id="intl_pfm_execution_f19" name="payee excluded" sourceRef="pe_payeeGw" targetRef="pe_rj_reject"><conditionExpression xsi:type="tFormalExpression">${!payeeClear}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_execution_f20" name="clear" sourceRef="pe_payeeGw" targetRef="pe_certify"/>
    <sequenceFlow id="intl_pfm_execution_f21" sourceRef="pe_certify" targetRef="pe_certGw"/>
    <sequenceFlow id="intl_pfm_execution_f22" name="not certified" sourceRef="pe_certGw" targetRef="pe_rj_reject"><conditionExpression xsi:type="tFormalExpression">${certifyDecision == 'reject'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_execution_f23" name="certified" sourceRef="pe_certGw" targetRef="pe_pay"/>
    <sequenceFlow id="intl_pfm_execution_f24" name="DONE" sourceRef="pe_exGw" targetRef="pe_close"><conditionExpression xsi:type="tFormalExpression">${executionOutcome == 'DONE'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="intl_pfm_execution_f25" name="otherwise" sourceRef="pe_exGw" targetRef="pe_failed"/>
    <sequenceFlow id="intl_pfm_execution_f26" sourceRef="pe_pay" targetRef="pe_exGw"/>
    <sequenceFlow id="intl_pfm_execution_f27" sourceRef="pe_failed" targetRef="pe_endFailed"/>
    <sequenceFlow id="intl_pfm_execution_f28" sourceRef="pe_close" targetRef="pe_end"/>
    <subProcess id="pe_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="pe_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="pe_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="pe_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="pe_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="intl_pfm_execution_f29" sourceRef="pe_withdrawStart" targetRef="pe_withdrawKind"/>
      <sequenceFlow id="intl_pfm_execution_f30" sourceRef="pe_withdrawKind" targetRef="pe_withdrawCall"/>
      <sequenceFlow id="intl_pfm_execution_f31" sourceRef="pe_withdrawCall" targetRef="pe_withdrawEnd"/>
    </subProcess>
    <subProcess id="pe_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="pe_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="pe_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="pe_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="pe_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="intl_pfm_execution_f32" sourceRef="pe_cancelStart" targetRef="pe_cancelKind"/>
      <sequenceFlow id="intl_pfm_execution_f33" sourceRef="pe_cancelKind" targetRef="pe_cancelCall"/>
      <sequenceFlow id="intl_pfm_execution_f34" sourceRef="pe_cancelCall" targetRef="pe_cancelEnd"/>
    </subProcess>
  </process>
