<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_sangam_core_powers" name="Delegation of powers by seat role" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <!-- K6 / IX.5 rule 3: checked at the moment of action against the version in force. SYNTHETIC limits. -->
  <decision id="sangam-core-powers" name="Delegation of powers by seat role" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="sangam-core-powers_t" hitPolicy="FIRST">
      <input id="sangam-core-powers_i0" label="Seat role"><inputExpression id="sangam-core-powers_ie0" typeRef="string"><text>seatRole</text></inputExpression></input>
      <input id="sangam-core-powers_i1" label="Case type"><inputExpression id="sangam-core-powers_ie1" typeRef="string"><text>caseType</text></inputExpression></input>
      <output id="sangam-core-powers_o0" label="Power limit (INR)" name="powerLimit" typeRef="number"/>
      <output id="sangam-core-powers_o1" label="Allowed" name="allowed" typeRef="boolean"/>
      <rule id="sangam-core-powers_r0"><description>SO up to 100000</description>
        <inputEntry id="sangam-core-powers_r0_i0"><text>"SO"</text></inputEntry>
        <inputEntry id="sangam-core-powers_r0_i1"><text>-</text></inputEntry>
        <outputEntry id="sangam-core-powers_r0_o0"><text>10000000</text></outputEntry>
        <outputEntry id="sangam-core-powers_r0_o1"><text>true</text></outputEntry>
      </rule>
      <rule id="sangam-core-powers_r1"><description>US up to 500000</description>
        <inputEntry id="sangam-core-powers_r1_i0"><text>"US"</text></inputEntry>
        <inputEntry id="sangam-core-powers_r1_i1"><text>-</text></inputEntry>
        <outputEntry id="sangam-core-powers_r1_o0"><text>50000000</text></outputEntry>
        <outputEntry id="sangam-core-powers_r1_o1"><text>true</text></outputEntry>
      </rule>
      <rule id="sangam-core-powers_r2"><description>DS up to 2500000</description>
        <inputEntry id="sangam-core-powers_r2_i0"><text>"DS"</text></inputEntry>
        <inputEntry id="sangam-core-powers_r2_i1"><text>-</text></inputEntry>
        <outputEntry id="sangam-core-powers_r2_o0"><text>250000000</text></outputEntry>
        <outputEntry id="sangam-core-powers_r2_o1"><text>true</text></outputEntry>
      </rule>
      <rule id="sangam-core-powers_r3"><description>JS up to 10000000</description>
        <inputEntry id="sangam-core-powers_r3_i0"><text>"JS"</text></inputEntry>
        <inputEntry id="sangam-core-powers_r3_i1"><text>-</text></inputEntry>
        <outputEntry id="sangam-core-powers_r3_o0"><text>1000000000</text></outputEntry>
        <outputEntry id="sangam-core-powers_r3_o1"><text>true</text></outputEntry>
      </rule>
      <rule id="sangam-core-powers_r4"><description>SECRETARY up to 100000000</description>
        <inputEntry id="sangam-core-powers_r4_i0"><text>"SECRETARY"</text></inputEntry>
        <inputEntry id="sangam-core-powers_r4_i1"><text>-</text></inputEntry>
        <outputEntry id="sangam-core-powers_r4_o0"><text>10000000000</text></outputEntry>
        <outputEntry id="sangam-core-powers_r4_o1"><text>true</text></outputEntry>
      </rule>
      <rule id="sangam-core-powers_r5"><description>Executive Engineer up to 5 lakh</description>
        <inputEntry id="sangam-core-powers_r5_i0"><text>"EE"</text></inputEntry>
        <inputEntry id="sangam-core-powers_r5_i1"><text>-</text></inputEntry>
        <outputEntry id="sangam-core-powers_r5_o0"><text>50000000</text></outputEntry>
        <outputEntry id="sangam-core-powers_r5_o1"><text>true</text></outputEntry>
      </rule>
      <rule id="sangam-core-powers_r6"><description>Superintending Engineer up to 25 lakh</description>
        <inputEntry id="sangam-core-powers_r6_i0"><text>"SE"</text></inputEntry>
        <inputEntry id="sangam-core-powers_r6_i1"><text>-</text></inputEntry>
        <outputEntry id="sangam-core-powers_r6_o0"><text>250000000</text></outputEntry>
        <outputEntry id="sangam-core-powers_r6_o1"><text>true</text></outputEntry>
      </rule>
      <rule id="sangam-core-powers_r7"><description>Chief Engineer</description>
        <inputEntry id="sangam-core-powers_r7_i0"><text>"CE"</text></inputEntry>
        <inputEntry id="sangam-core-powers_r7_i1"><text>-</text></inputEntry>
        <outputEntry id="sangam-core-powers_r7_o0"><text>100000000000</text></outputEntry>
        <outputEntry id="sangam-core-powers_r7_o1"><text>true</text></outputEntry>
      </rule>
      <rule id="sangam-core-powers_r8"><description>District Welfare Officer up to 2 lakh</description>
        <inputEntry id="sangam-core-powers_r8_i0"><text>"DWO"</text></inputEntry>
        <inputEntry id="sangam-core-powers_r8_i1"><text>-</text></inputEntry>
        <outputEntry id="sangam-core-powers_r8_o0"><text>20000000</text></outputEntry>
        <outputEntry id="sangam-core-powers_r8_o1"><text>true</text></outputEntry>
      </rule>
      <rule id="sangam-core-powers_r9"><description>Joint Director up to 10 lakh</description>
        <inputEntry id="sangam-core-powers_r9_i0"><text>"JD"</text></inputEntry>
        <inputEntry id="sangam-core-powers_r9_i1"><text>-</text></inputEntry>
        <outputEntry id="sangam-core-powers_r9_o0"><text>100000000</text></outputEntry>
        <outputEntry id="sangam-core-powers_r9_o1"><text>true</text></outputEntry>
      </rule>
      <rule id="sangam-core-powers_r10"><description>Director up to 50 lakh</description>
        <inputEntry id="sangam-core-powers_r10_i0"><text>"DIRECTOR"</text></inputEntry>
        <inputEntry id="sangam-core-powers_r10_i1"><text>-</text></inputEntry>
        <outputEntry id="sangam-core-powers_r10_o0"><text>500000000</text></outputEntry>
        <outputEntry id="sangam-core-powers_r10_o1"><text>true</text></outputEntry>
      </rule>
      <rule id="sangam-core-powers_r11"><description>Licensing officer (no money limit)</description>
        <inputEntry id="sangam-core-powers_r11_i0"><text>"LO"</text></inputEntry>
        <inputEntry id="sangam-core-powers_r11_i1"><text>-</text></inputEntry>
        <outputEntry id="sangam-core-powers_r11_o0"><text>100000000000</text></outputEntry>
        <outputEntry id="sangam-core-powers_r11_o1"><text>true</text></outputEntry>
      </rule>
      <rule id="sangam-core-powers_r12"><description>Deputy Commissioner (no money limit)</description>
        <inputEntry id="sangam-core-powers_r12_i0"><text>"DC"</text></inputEntry>
        <inputEntry id="sangam-core-powers_r12_i1"><text>-</text></inputEntry>
        <outputEntry id="sangam-core-powers_r12_o0"><text>100000000000</text></outputEntry>
        <outputEntry id="sangam-core-powers_r12_o1"><text>true</text></outputEntry>
      </rule>
      <rule id="sangam-core-powers_r13"><description>Head of department up to 1 crore</description>
        <inputEntry id="sangam-core-powers_r13_i0"><text>"HOD"</text></inputEntry>
        <inputEntry id="sangam-core-powers_r13_i1"><text>-</text></inputEntry>
        <outputEntry id="sangam-core-powers_r13_o0"><text>1000000000</text></outputEntry>
        <outputEntry id="sangam-core-powers_r13_o1"><text>true</text></outputEntry>
      </rule>
      <rule id="sangam-core-powers_r14"><description>Drawing and disbursing officer up to 10 lakh</description>
        <inputEntry id="sangam-core-powers_r14_i0"><text>"DDO"</text></inputEntry>
        <inputEntry id="sangam-core-powers_r14_i1"><text>-</text></inputEntry>
        <outputEntry id="sangam-core-powers_r14_o0"><text>100000000</text></outputEntry>
        <outputEntry id="sangam-core-powers_r14_o1"><text>true</text></outputEntry>
      </rule>
      <rule id="sangam-core-powers_r15"><description>no delegated power</description>
        <inputEntry id="sangam-core-powers_r15_i0"><text>-</text></inputEntry>
        <inputEntry id="sangam-core-powers_r15_i1"><text>-</text></inputEntry>
        <outputEntry id="sangam-core-powers_r15_o0"><text>0</text></outputEntry>
        <outputEntry id="sangam-core-powers_r15_o1"><text>false</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
