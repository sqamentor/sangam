<!-- RTI request. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_rti_request" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_appealFiled" name="sangam.appealFiled"/>
  <message id="msg_sangam_cancelCase" name="sangam.cancelCase"/>
  <message id="msg_sangam_feePaid" name="sangam.feePaid"/>
  <message id="msg_sangam_thirdPartySubmission" name="sangam.thirdPartySubmission"/>
  <message id="msg_sangam_withdrawCase" name="sangam.withdrawCase"/>
  <process id="sangam-rti-request" name="RTI request" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.rti</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>information,applicantName</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="rt_start" name="Request received" operaton:initiator="initiator" operaton:formKey="sangam:rti/request"></startEvent>
    <serviceTask id="rt_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>lifeLiberty=false;bplApplicant=false;viaApio=false;pioSeat=PIO-1;appellateSeat=FAA-1;appealSla=30D;appealWindow=P30D;appealAllowed=true;fee=1000;thirdPartyWindow=P10D;thirdPartyTimeline=P40D;additionalFeeWindow=P30D;retentionCategory=C;retentionYears=3;rejectionTemplate=rti-rejection;outputTemplate=rti-reply;issueOutput=false;thirdPartyName=null</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="rt_limit" name="Time limit (DMN: 30 days / 48 hours / APIO)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>rti-time-limit</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <serviceTask id="rt_clock" name="Statutory clock from receipt" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>case</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${caseSla}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="rt_feeGw" name="Fee payable?" default="rti_request_f14"></exclusiveGateway>
    <serviceTask id="rt_payCfg" name="Fee step" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>executionConnector=paygov.fee;executionStep=fee;verifyApproval=false;reconcileRequired=false;executionPayloadFields=fee,applicantRef</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="rt_pay" name="RTI fee (core execution)" calledElement="sangam-core-execution"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <serviceTask id="rt_pio_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>rt_pio</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${caseSla}</operaton:expression></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="rt_pio" name="PIO: decide request" operaton:candidateGroups="${pioSeat}" operaton:formKey="sangam:rti/pio-decision" operaton:dueDate="${rt_pioDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>pioDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="rt_pio_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>rt_pio</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>pioSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="rt_pio_warnEnd" name="Warned"></endEvent>
    <serviceTask id="rt_pio_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>rt_pio</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>DEEMED_REFUSAL</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>pioSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>pioDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>supply</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="rt_pio_breachGw" name="Deemed?" default="rti_request_f10"></exclusiveGateway>
    <exclusiveGateway id="rt_pio_done" name=""></exclusiveGateway>
    <exclusiveGateway id="rt_decGw" name="PIO decision?"></exclusiveGateway>
    <serviceTask id="rt_reply" name="Issue reply" operaton:class="org.sangam.packs.core.DocumentDelegate"><extensionElements><operaton:field name="template"><operaton:string>rti-reply</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="rt_notifyReply" name="Send reply" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>rti-reply-sent</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>sms,email</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>applicantRef</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="rt_appealWindow" name="First appeal window" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>appeal</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${appealWindow}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <eventBasedGateway id="rt_appealWait" name="First appeal?"></eventBasedGateway>
    <intermediateCatchEvent id="rt_appealFiled" name="First appeal filed"><messageEventDefinition messageRef="msg_sangam_appealFiled"/></intermediateCatchEvent>
    <intermediateCatchEvent id="rt_appealLapse" name="Appeal window lapsed"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${appealDueAt}</timeDate></timerEventDefinition></intermediateCatchEvent>
    <callActivity id="rt_firstAppeal" name="First appeal before the FAA (core)" calledElement="sangam-core-appeal"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <exclusiveGateway id="rt_appealGw" name="Appeal allowed?" default="rti_request_f27"></exclusiveGateway>
    <callActivity id="rt_close" name="Close and classify (core)" calledElement="sangam-core-closure"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <serviceTask id="rt_secondAppeal" name="Tell applicant about the second appeal (Information Commission)" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>rti-second-appeal-route</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>sms,email</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>applicantRef</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="rt_rejectReason" name="Exemption as reason" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=@exemptionSection</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="rt_reject" name="Rejection with appeal route (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <exclusiveGateway id="rt_rejGw" name="Appeal allowed?" default="rti_request_f34"></exclusiveGateway>
    <endEvent id="rt_endRejected" name="Rejected"></endEvent>
    <serviceTask id="rt_transfer" name="Transfer to the public authority (s.6(3))" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>referral.send</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>transferRti</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>information,transferToAuthority,applicantRef</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>transfer</operaton:string></operaton:field><operaton:field name="step"><operaton:string>transfer</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="rt_tellTransfer" name="Tell applicant of the transfer" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>rti-transferred</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>sms,email</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>applicantRef</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="rt_endTransferred" name="Transferred"></endEvent>
    <serviceTask id="rt_pause" name="Pause clock (s.7(3))" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PAUSE</operaton:string></operaton:field><operaton:field name="reason"><operaton:string>additional fee awaited</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="rt_askFee" name="Ask for additional fee" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>rti-additional-fee</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>sms,email</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>applicantRef</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="rt_feeWindow" name="Fee window" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>additionalFee</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${additionalFeeWindow}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <eventBasedGateway id="rt_feeWait" name="Fee paid?"></eventBasedGateway>
    <intermediateCatchEvent id="rt_feePaid" name="Additional fee paid"><messageEventDefinition messageRef="msg_sangam_feePaid"/></intermediateCatchEvent>
    <intermediateCatchEvent id="rt_feeLapse" name="Not paid"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${additionalFeeDueAt}</timeDate></timerEventDefinition></intermediateCatchEvent>
    <serviceTask id="rt_resume" name="Resume clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>RESUME</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="rt_thirdParty" name="Notice to third party (s.11)" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>rti-third-party-notice</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>sms,email</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>thirdPartyName</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="rt_tpWindow" name="Objection window" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>thirdParty</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${thirdPartyWindow}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <serviceTask id="rt_tpClock" name="Decision within 40 days of receipt" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>case</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${thirdPartyTimeline}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <eventBasedGateway id="rt_tpWait" name="Submission or lapse"></eventBasedGateway>
    <intermediateCatchEvent id="rt_tpSubmission" name="Third-party submission"><messageEventDefinition messageRef="msg_sangam_thirdPartySubmission"/></intermediateCatchEvent>
    <intermediateCatchEvent id="rt_tpLapse" name="Window closes"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${thirdPartyDueAt}</timeDate></timerEventDefinition></intermediateCatchEvent>
    <endEvent id="rt_end" name="Disposed"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="rt_pio_warn" name="SLA warning (75%)" attachedToRef="rt_pio" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${rt_pioWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="rt_pio_breach" name="SLA breached" attachedToRef="rt_pio" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${rt_pioDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="rti_request_f1" sourceRef="rt_start" targetRef="rt_defaults"/>
    <sequenceFlow id="rti_request_f2" sourceRef="rt_defaults" targetRef="rt_limit"/>
    <sequenceFlow id="rti_request_f3" sourceRef="rt_limit" targetRef="rt_clock"/>
    <sequenceFlow id="rti_request_f4" sourceRef="rt_clock" targetRef="rt_feeGw"/>
    <sequenceFlow id="rti_request_f5" sourceRef="rt_pio_warn" targetRef="rt_pio_warnNotify"/>
    <sequenceFlow id="rti_request_f6" sourceRef="rt_pio_warnNotify" targetRef="rt_pio_warnEnd"/>
    <sequenceFlow id="rti_request_f7" sourceRef="rt_pio_breach" targetRef="rt_pio_breachAct"/>
    <sequenceFlow id="rti_request_f8" sourceRef="rt_pio_breachAct" targetRef="rt_pio_breachGw"/>
    <sequenceFlow id="rti_request_f9" name="deemed" sourceRef="rt_pio_breachGw" targetRef="rt_pio_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="rti_request_f10" name="escalated" sourceRef="rt_pio_breachGw" targetRef="rt_pio_slaPlan"/>
    <sequenceFlow id="rti_request_f11" sourceRef="rt_pio_slaPlan" targetRef="rt_pio"/>
    <sequenceFlow id="rti_request_f12" sourceRef="rt_pio" targetRef="rt_pio_done"/>
    <sequenceFlow id="rti_request_f13" name="yes" sourceRef="rt_feeGw" targetRef="rt_payCfg"><conditionExpression xsi:type="tFormalExpression">${!bplApplicant}</conditionExpression></sequenceFlow>
    <sequenceFlow id="rti_request_f14" name="BPL exempt" sourceRef="rt_feeGw" targetRef="rt_pio_slaPlan"/>
    <sequenceFlow id="rti_request_f15" sourceRef="rt_payCfg" targetRef="rt_pay"/>
    <sequenceFlow id="rti_request_f16" sourceRef="rt_pay" targetRef="rt_pio_slaPlan"/>
    <sequenceFlow id="rti_request_f17" sourceRef="rt_pio_done" targetRef="rt_decGw"/>
    <sequenceFlow id="rti_request_f18" name="supply" sourceRef="rt_decGw" targetRef="rt_reply"><conditionExpression xsi:type="tFormalExpression">${pioDecision == 'supply'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="rti_request_f19" sourceRef="rt_reply" targetRef="rt_notifyReply"/>
    <sequenceFlow id="rti_request_f20" sourceRef="rt_notifyReply" targetRef="rt_appealWindow"/>
    <sequenceFlow id="rti_request_f21" sourceRef="rt_appealWindow" targetRef="rt_appealWait"/>
    <sequenceFlow id="rti_request_f22" sourceRef="rt_appealWait" targetRef="rt_appealFiled"/>
    <sequenceFlow id="rti_request_f23" sourceRef="rt_appealWait" targetRef="rt_appealLapse"/>
    <sequenceFlow id="rti_request_f24" sourceRef="rt_appealFiled" targetRef="rt_firstAppeal"/>
    <sequenceFlow id="rti_request_f25" sourceRef="rt_firstAppeal" targetRef="rt_appealGw"/>
    <sequenceFlow id="rti_request_f26" name="FAA directs the PIO" sourceRef="rt_appealGw" targetRef="rt_pio_slaPlan"><conditionExpression xsi:type="tFormalExpression">${appealOutcome == 'ALLOWED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="rti_request_f27" name="dismissed" sourceRef="rt_appealGw" targetRef="rt_secondAppeal"/>
    <sequenceFlow id="rti_request_f28" sourceRef="rt_secondAppeal" targetRef="rt_close"/>
    <sequenceFlow id="rti_request_f29" sourceRef="rt_appealLapse" targetRef="rt_close"/>
    <sequenceFlow id="rti_request_f30" name="reject / deemed refusal" sourceRef="rt_decGw" targetRef="rt_rejectReason"><conditionExpression xsi:type="tFormalExpression">${pioDecision == 'reject'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="rti_request_f31" sourceRef="rt_rejectReason" targetRef="rt_reject"/>
    <sequenceFlow id="rti_request_f32" sourceRef="rt_reject" targetRef="rt_rejGw"/>
    <sequenceFlow id="rti_request_f33" name="FAA directs supply" sourceRef="rt_rejGw" targetRef="rt_pio_slaPlan"><conditionExpression xsi:type="tFormalExpression">${rejectionOutcome == 'APPEAL_ALLOWED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="rti_request_f34" name="final" sourceRef="rt_rejGw" targetRef="rt_endRejected"/>
    <sequenceFlow id="rti_request_f35" name="transfer" sourceRef="rt_decGw" targetRef="rt_transfer"><conditionExpression xsi:type="tFormalExpression">${pioDecision == 'transfer'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="rti_request_f36" sourceRef="rt_transfer" targetRef="rt_tellTransfer"/>
    <sequenceFlow id="rti_request_f37" sourceRef="rt_tellTransfer" targetRef="rt_endTransferred"/>
    <sequenceFlow id="rti_request_f38" name="additional fee" sourceRef="rt_decGw" targetRef="rt_pause"><conditionExpression xsi:type="tFormalExpression">${pioDecision == 'additionalFee'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="rti_request_f39" sourceRef="rt_pause" targetRef="rt_askFee"/>
    <sequenceFlow id="rti_request_f40" sourceRef="rt_askFee" targetRef="rt_feeWindow"/>
    <sequenceFlow id="rti_request_f41" sourceRef="rt_feeWindow" targetRef="rt_feeWait"/>
    <sequenceFlow id="rti_request_f42" sourceRef="rt_feeWait" targetRef="rt_feePaid"/>
    <sequenceFlow id="rti_request_f43" sourceRef="rt_feeWait" targetRef="rt_feeLapse"/>
    <sequenceFlow id="rti_request_f44" sourceRef="rt_feePaid" targetRef="rt_resume"/>
    <sequenceFlow id="rti_request_f45" sourceRef="rt_resume" targetRef="rt_pio_slaPlan"/>
    <sequenceFlow id="rti_request_f46" sourceRef="rt_feeLapse" targetRef="rt_close"/>
    <sequenceFlow id="rti_request_f47" name="third party" sourceRef="rt_decGw" targetRef="rt_thirdParty"><conditionExpression xsi:type="tFormalExpression">${pioDecision == 'thirdParty'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="rti_request_f48" sourceRef="rt_thirdParty" targetRef="rt_tpWindow"/>
    <sequenceFlow id="rti_request_f49" sourceRef="rt_tpWindow" targetRef="rt_tpClock"/>
    <sequenceFlow id="rti_request_f50" sourceRef="rt_tpClock" targetRef="rt_tpWait"/>
    <sequenceFlow id="rti_request_f51" sourceRef="rt_tpWait" targetRef="rt_tpSubmission"/>
    <sequenceFlow id="rti_request_f52" sourceRef="rt_tpWait" targetRef="rt_tpLapse"/>
    <sequenceFlow id="rti_request_f53" sourceRef="rt_tpSubmission" targetRef="rt_pio_slaPlan"/>
    <sequenceFlow id="rti_request_f54" sourceRef="rt_tpLapse" targetRef="rt_pio_slaPlan"/>
    <sequenceFlow id="rti_request_f55" sourceRef="rt_close" targetRef="rt_end"/>
    <subProcess id="rt_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="rt_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="rt_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="rt_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="rt_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="rti_request_f56" sourceRef="rt_withdrawStart" targetRef="rt_withdrawKind"/>
      <sequenceFlow id="rti_request_f57" sourceRef="rt_withdrawKind" targetRef="rt_withdrawCall"/>
      <sequenceFlow id="rti_request_f58" sourceRef="rt_withdrawCall" targetRef="rt_withdrawEnd"/>
    </subProcess>
    <subProcess id="rt_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="rt_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="rt_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="rt_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="rt_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="rti_request_f59" sourceRef="rt_cancelStart" targetRef="rt_cancelKind"/>
      <sequenceFlow id="rti_request_f60" sourceRef="rt_cancelKind" targetRef="rt_cancelCall"/>
      <sequenceFlow id="rti_request_f61" sourceRef="rt_cancelCall" targetRef="rt_cancelEnd"/>
    </subProcess>
  </process>
  <bpmndi:BPMNDiagram id="rti_request_diagram">
    <bpmndi:BPMNPlane id="rti_request_plane" bpmnElement="sangam-rti-request">
      <bpmndi:BPMNShape id="rt_start_di" bpmnElement="rt_start"><dc:Bounds x="52" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="rt_defaults_di" bpmnElement="rt_defaults"><dc:Bounds x="185" y="30" width="100" height="80"/></bpmndi:BPMNShape>
