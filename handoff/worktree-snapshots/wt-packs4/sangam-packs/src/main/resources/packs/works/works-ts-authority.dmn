<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_works_ts_authority" name="Technical sanction powers (synthetic)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="works-ts-authority" name="Technical sanction powers (synthetic)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="works-ts-authority_t" hitPolicy="FIRST">
      <input id="works-ts-authority_i0" label="Amount"><inputExpression id="works-ts-authority_ie0" typeRef="number"><text>amount</text></inputExpression></input>
      <output id="works-ts-authority_o0" label="Competent role" name="competentRole" typeRef="string"/>
      <rule id="works-ts-authority_r0">
        <inputEntry id="works-ts-authority_r0_i0"><text>&lt;= 250000000</text></inputEntry>
        <outputEntry id="works-ts-authority_r0_o0"><text>"EE"</text></outputEntry>
      </rule>
      <rule id="works-ts-authority_r1">
        <inputEntry id="works-ts-authority_r1_i0"><text>&lt;= 2000000000</text></inputEntry>
        <outputEntry id="works-ts-authority_r1_o0"><text>"SE"</text></outputEntry>
      </rule>
      <rule id="works-ts-authority_r2">
        <inputEntry id="works-ts-authority_r2_i0"><text>-</text></inputEntry>
        <outputEntry id="works-ts-authority_r2_o0"><text>"CE"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
