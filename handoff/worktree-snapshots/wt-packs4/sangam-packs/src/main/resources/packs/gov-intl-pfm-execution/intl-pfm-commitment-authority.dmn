<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_intl_pfm_commitment_authority" name="Commitment approver (SYNTHETIC delegation)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <!-- SYNTHETIC bands; replace with the board policy. -->
  <decision id="intl-pfm-commitment-authority" name="Commitment approver (SYNTHETIC delegation)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="intl-pfm-commitment-authority_t" hitPolicy="FIRST">
      <input id="intl-pfm-commitment-authority_i0" label="Amount (INR)"><inputExpression id="intl-pfm-commitment-authority_ie0" typeRef="number"><text>amount</text></inputExpression></input>
      <output id="intl-pfm-commitment-authority_o0" label="Competent role" name="competentRole" typeRef="string"/>
      <rule id="intl-pfm-commitment-authority_r0">
        <inputEntry id="intl-pfm-commitment-authority_r0_i0"><text>&lt;= 10000000</text></inputEntry>
        <outputEntry id="intl-pfm-commitment-authority_r0_o0"><text>"COMMITMENT-OFFICER"</text></outputEntry>
      </rule>
      <rule id="intl-pfm-commitment-authority_r1">
        <inputEntry id="intl-pfm-commitment-authority_r1_i0"><text>-</text></inputEntry>
        <outputEntry id="intl-pfm-commitment-authority_r1_o0"><text>"ACCOUNTING-OFFICER"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
