<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_sec_scm_pr_authority" name="Requisition approver" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <!-- SYNTHETIC bands; replace with the board policy. -->
  <decision id="sec-scm-pr-authority" name="Requisition approver" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="sec-scm-pr-authority_t" hitPolicy="FIRST">
      <input id="sec-scm-pr-authority_i0" label="Amount (INR)"><inputExpression id="sec-scm-pr-authority_ie0" typeRef="number"><text>amount</text></inputExpression></input>
      <output id="sec-scm-pr-authority_o0" label="Competent role" name="competentRole" typeRef="string"/>
      <rule id="sec-scm-pr-authority_r0">
        <inputEntry id="sec-scm-pr-authority_r0_i0"><text>&lt;= 50000000</text></inputEntry>
        <outputEntry id="sec-scm-pr-authority_r0_o0"><text>"DEPTHEAD"</text></outputEntry>
      </rule>
      <rule id="sec-scm-pr-authority_r1">
        <inputEntry id="sec-scm-pr-authority_r1_i0"><text>&lt;= 500000000</text></inputEntry>
        <outputEntry id="sec-scm-pr-authority_r1_o0"><text>"PROCHEAD"</text></outputEntry>
      </rule>
      <rule id="sec-scm-pr-authority_r2">
        <inputEntry id="sec-scm-pr-authority_r2_i0"><text>-</text></inputEntry>
        <outputEntry id="sec-scm-pr-authority_r2_o0"><text>"CFO"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
