{
  "id": "gov.ifms.sna-sparsh",
  "version": "1.0.0",
  "name": {
    "en": "SNA-SPARSH just-in-time release",
    "hi": "एसएनए-स्पर्श समय पर विमुक्ति"
  },
  "domain": "IFMS",
  "description": "Mother sanction per SLS (one active, lapse 23:59 on 31 March IST) held as a ledger limit; state treasury pushes IA payment files with centre / state / top-up shares; daily sanction by the PD checker (DSC), Pr.AO payment authorisation, PAO pass, batch to RBI before the 15:00 cut-off (next business day after it), reissue tag on re-push, SLS reconciliation. 3-role chain by default, 7-role chain by profile.",
  "mainProcesses": [
    "sangam-ifms-sna-sparsh-release"
  ],
  "resources": [
    {
      "kind": "BPMN",
      "path": "packs/ifms-sna-sparsh/sangam-ifms-sna-sparsh-release.bpmn"
    },
    {
      "kind": "DMN",
      "path": "packs/ifms-sna-sparsh/ifms-sna-authority.dmn"
    },
    {
      "kind": "FORM",
      "path": "packs/ifms-sna-sparsh/forms/claim.form.json"
    },
    {
      "kind": "FORM",
      "path": "packs/ifms-sna-sparsh/forms/daily.form.json"
    },
    {
      "kind": "FORM",
      "path": "packs/ifms-sna-sparsh/forms/authorise.form.json"
    },
    {
      "kind": "FORM",
      "path": "packs/ifms-sna-sparsh/forms/pao.form.json"
    },
    {
      "kind": "SEED",
      "path": "packs/ifms-sna-sparsh/seed.json"
    }
  ],
  "seed": "packs/ifms-sna-sparsh/seed.json",
  "connectors": [
    {
      "id": "config.profile",
      "capabilityClass": "a",
      "govTag": "G-CONFIG",
      "purpose": "Profile values of the tenant (sangam-config)"
    },
    {
      "id": "config.documentType",
      "capabilityClass": "a",
      "govTag": "G-CONFIG",
      "purpose": "Document-type catalogue (bill types, forms, chains, rails)"
    },
    {
      "id": "config.classification",
      "capabilityClass": "a",
