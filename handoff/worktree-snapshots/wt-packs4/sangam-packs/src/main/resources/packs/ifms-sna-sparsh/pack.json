      "purpose": "Classification validation (head of account)"
    },
    {
      "id": "config.series",
      "capabilityClass": "a",
      "govTag": "G-CONFIG",
      "purpose": "Number series (token, voucher)"
    },
    {
      "id": "ledger.available",
      "capabilityClass": "a",
      "govTag": "G-LEDGER",
      "purpose": "Mother sanction balance (sangam-ledger, idempotent by operationId)"
    },
    {
      "id": "ledger.consume",
      "capabilityClass": "a",
      "govTag": "G-LEDGER",
      "purpose": "Daily sanction against the mother sanction (sangam-ledger, idempotent by operationId)"
    },
    {
      "id": "rail.ekuber",
      "capabilityClass": "c",
      "govTag": "G-RBI",
      "purpose": "Batch to RBI"
    },
    {
      "id": "pfms.childSanction",
      "capabilityClass": "a",
      "govTag": "G-PFMS",
      "purpose": "Child sanction / DN-CN notifications"
    }
  ],
