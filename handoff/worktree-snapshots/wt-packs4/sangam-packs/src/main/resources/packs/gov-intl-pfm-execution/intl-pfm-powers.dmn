<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_intl_pfm_powers" name="Delegated powers by role" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <!-- SYNTHETIC delegation in major units of the pack currency (shipped in minor units); each country deploys its own (INTERNATIONAL-PFM-REQUIREMENTS PFM-CH-2, unverified per country). -->
  <decision id="intl-pfm-powers" name="Delegated powers by role" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="intl-pfm-powers_t" hitPolicy="FIRST">
      <input id="intl-pfm-powers_i0" label="Seat role"><inputExpression id="intl-pfm-powers_ie0" typeRef="string"><text>seatRole</text></inputExpression></input>
      <input id="intl-pfm-powers_i1" label="Case type"><inputExpression id="intl-pfm-powers_ie1" typeRef="string"><text>caseType</text></inputExpression></input>
      <output id="intl-pfm-powers_o0" label="Power limit (INR)" name="powerLimit" typeRef="number"/>
      <output id="intl-pfm-powers_o1" label="Allowed" name="allowed" typeRef="boolean"/>
      <rule id="intl-pfm-powers_r0"><description>SYNTHETIC</description>
        <inputEntry id="intl-pfm-powers_r0_i0"><text>"COMMITMENT-OFFICER"</text></inputEntry>
        <inputEntry id="intl-pfm-powers_r0_i1"><text>-</text></inputEntry>
        <outputEntry id="intl-pfm-powers_r0_o0"><text>10000000</text></outputEntry>
        <outputEntry id="intl-pfm-powers_r0_o1"><text>true</text></outputEntry>
      </rule>
      <rule id="intl-pfm-powers_r1"><description>SYNTHETIC</description>
        <inputEntry id="intl-pfm-powers_r1_i0"><text>"ACCOUNTING-OFFICER"</text></inputEntry>
        <inputEntry id="intl-pfm-powers_r1_i1"><text>-</text></inputEntry>
        <outputEntry id="intl-pfm-powers_r1_o0"><text>1000000000</text></outputEntry>
        <outputEntry id="intl-pfm-powers_r1_o1"><text>true</text></outputEntry>
      </rule>
      <rule id="intl-pfm-powers_r2"><description>no delegated power</description>
        <inputEntry id="intl-pfm-powers_r2_i0"><text>-</text></inputEntry>
        <inputEntry id="intl-pfm-powers_r2_i1"><text>-</text></inputEntry>
        <outputEntry id="intl-pfm-powers_r2_o0"><text>0</text></outputEntry>
        <outputEntry id="intl-pfm-powers_r2_o1"><text>false</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
