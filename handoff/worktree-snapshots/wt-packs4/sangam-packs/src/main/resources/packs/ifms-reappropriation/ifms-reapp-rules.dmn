  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <!-- FIRST hit, ordered: refusals, then Finance Ministry cases, then Parliament reporting, then within CAA powers. Thresholds come from the GOI profile budgetControl.reappropriation; a State deploys its own table as a tenant override. -->
  <decision id="ifms-reapp-rules" name="Re-appropriation rules (DFPR 2024 Rule 10 and GoI decisions)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
