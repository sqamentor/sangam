    <sequenceFlow id="ifms_sna_sparsh_release_f48" sourceRef="ss_returned" targetRef="ss_endRet"/>
    <subProcess id="ss_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="ss_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="ss_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
