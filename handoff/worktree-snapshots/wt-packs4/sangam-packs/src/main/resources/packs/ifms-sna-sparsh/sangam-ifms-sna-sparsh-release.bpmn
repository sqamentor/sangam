    <sequenceFlow id="ifms_sna_sparsh_release_f39" name="passed" sourceRef="ss_paoGw" targetRef="ss_cutoff"><conditionExpression xsi:type="tFormalExpression">${paoDecision == 'passBill'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_sna_sparsh_release_f40" name="returned" sourceRef="ss_paoGw" targetRef="ss_returned"/>
