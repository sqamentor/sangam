    <sequenceFlow id="ifms_sna_sparsh_release_f33" name="signed" sourceRef="ss_pdGw" targetRef="ss_prao_slaPlan"><conditionExpression xsi:type="tFormalExpression">${pdDecision == 'signed'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_sna_sparsh_release_f34" name="returned" sourceRef="ss_pdGw" targetRef="ss_returned"/>
    <sequenceFlow id="ifms_sna_sparsh_release_f35" sourceRef="ss_prao_done" targetRef="ss_praoGw"/>
    <sequenceFlow id="ifms_sna_sparsh_release_f36" name="authorised" sourceRef="ss_praoGw" targetRef="ss_pao_slaPlan"><conditionExpression xsi:type="tFormalExpression">${praoDecision == 'signed'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_sna_sparsh_release_f37" name="returned" sourceRef="ss_praoGw" targetRef="ss_returned"/>
