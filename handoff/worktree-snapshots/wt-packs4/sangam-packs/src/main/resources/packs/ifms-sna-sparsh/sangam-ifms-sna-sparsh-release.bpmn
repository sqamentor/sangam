      <endEvent id="ss_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="ifms_sna_sparsh_release_f49" sourceRef="ss_withdrawStart" targetRef="ss_withdrawKind"/>
      <sequenceFlow id="ifms_sna_sparsh_release_f50" sourceRef="ss_withdrawKind" targetRef="ss_withdrawCall"/>
      <sequenceFlow id="ifms_sna_sparsh_release_f51" sourceRef="ss_withdrawCall" targetRef="ss_withdrawEnd"/>
    </subProcess>
    <subProcess id="ss_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="ss_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
