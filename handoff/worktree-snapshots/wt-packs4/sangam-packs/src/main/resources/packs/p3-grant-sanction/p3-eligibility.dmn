<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_p3_eligibility" name="P3 eligibility (scheme rule)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <!-- SYNTHETIC scheme rule. Bound to the deployment (GP-19, J-P3-E08): in-flight cases keep it. -->
  <decision id="p3-eligibility" name="P3 eligibility (scheme rule)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="p3-eligibility_t" hitPolicy="FIRST">
      <input id="p3-eligibility_i0" label="Scheme"><inputExpression id="p3-eligibility_ie0" typeRef="string"><text>schemeId</text></inputExpression></input>
      <input id="p3-eligibility_i1" label="Income"><inputExpression id="p3-eligibility_ie1" typeRef="number"><text>income</text></inputExpression></input>
      <input id="p3-eligibility_i2" label="Age"><inputExpression id="p3-eligibility_ie2" typeRef="integer"><text>age</text></inputExpression></input>
      <input id="p3-eligibility_i3" label="Child with guardian"><inputExpression id="p3-eligibility_ie3" typeRef="boolean"><text>childApplicant</text></inputExpression></input>
      <output id="p3-eligibility_o0" label="Eligible" name="eligible" typeRef="boolean"/>
      <output id="p3-eligibility_o1" label="Reason code" name="eligibilityReasonCode" typeRef="string"/>
      <rule id="p3-eligibility_r0"><description>income ceiling</description>
        <inputEntry id="p3-eligibility_r0_i0"><text>-</text></inputEntry>
        <inputEntry id="p3-eligibility_r0_i1"><text>&gt; 25000000</text></inputEntry>
        <inputEntry id="p3-eligibility_r0_i2"><text>-</text></inputEntry>
        <inputEntry id="p3-eligibility_r0_i3"><text>-</text></inputEntry>
        <outputEntry id="p3-eligibility_r0_o0"><text>false</text></outputEntry>
        <outputEntry id="p3-eligibility_r0_o1"><text>"INCOME_ABOVE_LIMIT"</text></outputEntry>
      </rule>
      <rule id="p3-eligibility_r1">
        <inputEntry id="p3-eligibility_r1_i0"><text>"OLD-AGE-PENSION"</text></inputEntry>
        <inputEntry id="p3-eligibility_r1_i1"><text>-</text></inputEntry>
        <inputEntry id="p3-eligibility_r1_i2"><text>&lt; 60</text></inputEntry>
        <inputEntry id="p3-eligibility_r1_i3"><text>-</text></inputEntry>
        <outputEntry id="p3-eligibility_r1_o0"><text>false</text></outputEntry>
        <outputEntry id="p3-eligibility_r1_o1"><text>"AGE_BELOW_60"</text></outputEntry>
      </rule>
      <rule id="p3-eligibility_r2">
        <inputEntry id="p3-eligibility_r2_i0"><text>-</text></inputEntry>
        <inputEntry id="p3-eligibility_r2_i1"><text>-</text></inputEntry>
        <inputEntry id="p3-eligibility_r2_i2"><text>&lt; 18</text></inputEntry>
        <inputEntry id="p3-eligibility_r2_i3"><text>false</text></inputEntry>
        <outputEntry id="p3-eligibility_r2_o0"><text>false</text></outputEntry>
        <outputEntry id="p3-eligibility_r2_o1"><text>"MINOR_WITHOUT_GUARDIAN"</text></outputEntry>
      </rule>
      <rule id="p3-eligibility_r3">
        <inputEntry id="p3-eligibility_r3_i0"><text>-</text></inputEntry>
        <inputEntry id="p3-eligibility_r3_i1"><text>-</text></inputEntry>
        <inputEntry id="p3-eligibility_r3_i2"><text>-</text></inputEntry>
        <inputEntry id="p3-eligibility_r3_i3"><text>-</text></inputEntry>
        <outputEntry id="p3-eligibility_r3_o0"><text>true</text></outputEntry>
        <outputEntry id="p3-eligibility_r3_o1"><text>"ELIGIBLE"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
