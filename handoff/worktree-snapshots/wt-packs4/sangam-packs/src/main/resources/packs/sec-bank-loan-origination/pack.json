{
  "id": "sec.bank.loan-origination",
  "version": "1.0.0",
  "name": {
    "en": "Loan origination to disbursal",
    "hi": "ऋण आवेदन से संवितरण तक"
  },
  "domain": "Banking",
  "description": "Retail / MSME loan: consent, KYC status, bureau pull, indicative FOIR, credit policy by rule (auto decline with reasons), appraisal with clarification, legal and valuation in parallel for secured loans, committee above the band, sanction by delegated power with SoD and payload binding, Key Facts Statement with APR and a validity window, e-signed agreement, disbursal to the borrower account with operationId, loan booked in the LMS.",
