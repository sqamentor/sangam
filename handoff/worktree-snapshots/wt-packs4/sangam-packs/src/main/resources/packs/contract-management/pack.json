{
  "id": "gov.contract-management",
  "version": "1.0.0",
  "name": {
    "en": "Contract amendment: variation, extra item, EoT, LD, price escalation",
    "hi": "अनुबंध संशोधन: परिवर्तन, अतिरिक्त मद, समय विस्तार, परिनिर्धारित नुकसानी, मूल्य वृद्धि"
  },
  "domain": "Contracts",
  "description": "A running contract is amended: variation and extra items, extension of time, liquidated damages and price escalation are computed by rule, sanctioned by the competent authority and applied to the running works or supply case by message (GP-43, GP-42).",
