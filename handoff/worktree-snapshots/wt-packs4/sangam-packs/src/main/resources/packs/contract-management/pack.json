    "sangam-contract-amendment"
  ],
  "resources": [
    {
      "kind": "BPMN",
      "path": "packs/contract-management/sangam-contract-amendment.bpmn"
    },
    {
      "kind": "DMN",
      "path": "packs/contract-management/contract-ld.dmn"
    },
    {
      "kind": "DMN",
      "path": "packs/contract-management/contract-price-escalation.dmn"
    },
    {
      "kind": "DMN",
      "path": "packs/contract-management/contract-amendment-authority.dmn"
    },
    {
      "kind": "FORM",
      "path": "packs/contract-management/forms/proposal.form.json"
    },
    {
      "kind": "SEED",
      "path": "packs/contract-management/seed.json"
    }
  ],
  "seed": "packs/contract-management/seed.json",
  "connectors": [],
  "covers": [
    "GP-43",
    "GP-42",
    "GP-05",
    "GP-19",
    "GP-14",
    "VI.5"
  ],
  "acceptance": [],
  "dependsOn": [
    "sangam.core"
  ],
  "tenantOverrides": [],
  "calls": [
    "sangam-core-cancellation",
    "sangam-core-closure",
    "sangam-core-rejection",
    "sangam-core-sanction",
    "sangam-core-scrutiny"
  ],
  "money": {
    "unit": "MINOR",
    "currency": "INR",
