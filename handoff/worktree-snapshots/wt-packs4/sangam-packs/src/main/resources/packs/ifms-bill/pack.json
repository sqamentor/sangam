  "acceptance": [
    {
      "id": "BL-1",
      "title": "A bill mixing two major heads is refused with the rule cited",
      "refs": [
        "IFC-042"
      ],
      "given": "GOI profile, bill type CONTINGENT",
      "when": "lines carry 2054 and 2052",
      "then": "BILL_INVALID with RPR SI 2.2(5)(g)",
      "startVariables": {
        "docValid": false
      },
      "expectState": null,
      "run": {
        "expect": {
          "audit": [
            "CASE_REJECTED"
          ],
          "notAudit": [
            "CASE_APPROVED"
          ],
          "ended": true
        }
      }
    }
