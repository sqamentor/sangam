  "version": "1.0.0",
  "name": {
    "en": "Bill by catalogue type (all bill-type families)",
    "hi": "सूची प्रकार अनुसार बिल (सभी बिल श्रेणियाँ)"
  },
  "domain": "IFMS",
  "description": "One catalogue-driven bill process: the bill type (form number, attachments, certificates, allowed heads, one-major-head rule, sanction requirement, chain, rail) comes from the tenant profile (config.documentType); the head of account is validated against the classification master; funds are checked and encumbered in the ledger at the profile control dimension (hold-for-budget queue when short); the PAO / treasury chain runs; payment goes through the rail the profile selects (rail DMN, tenant override per State) with operationId and reconciliation; consumption is posted. One thin process per bill-type family sets the family defaults.",
  "mainProcesses": [
    "sangam-ifms-bill"
  ],
