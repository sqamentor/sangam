<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_works_aa_authority" name="Administrative approval powers (synthetic)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="works-aa-authority" name="Administrative approval powers (synthetic)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="works-aa-authority_t" hitPolicy="FIRST">
      <input id="works-aa-authority_i0" label="Case type"><inputExpression id="works-aa-authority_ie0" typeRef="string"><text>caseType</text></inputExpression></input>
      <input id="works-aa-authority_i1" label="Amount"><inputExpression id="works-aa-authority_ie1" typeRef="number"><text>amount</text></inputExpression></input>
      <output id="works-aa-authority_o0" label="Competent role" name="competentRole" typeRef="string"/>
      <rule id="works-aa-authority_r0">
        <inputEntry id="works-aa-authority_r0_i0"><text>-</text></inputEntry>
        <inputEntry id="works-aa-authority_r0_i1"><text>&lt;= 1000000000</text></inputEntry>
        <outputEntry id="works-aa-authority_r0_o0"><text>"HOD"</text></outputEntry>
      </rule>
      <rule id="works-aa-authority_r1">
        <inputEntry id="works-aa-authority_r1_i0"><text>-</text></inputEntry>
        <inputEntry id="works-aa-authority_r1_i1"><text>&lt;= 50000000000</text></inputEntry>
        <outputEntry id="works-aa-authority_r1_o0"><text>"SECRETARY"</text></outputEntry>
      </rule>
      <rule id="works-aa-authority_r2"><description>with Finance</description>
        <inputEntry id="works-aa-authority_r2_i0"><text>-</text></inputEntry>
        <inputEntry id="works-aa-authority_r2_i1"><text>-</text></inputEntry>
        <outputEntry id="works-aa-authority_r2_o0"><text>"FIN-SECY"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
