<!-- Loan origination. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_sec_bank_loan_originatio" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_cancelCase" name="sangam.cancelCase"/>
  <message id="msg_sangam_clarificationReceived" name="sangam.clarificationReceived"/>
  <message id="msg_sangam_withdrawCase" name="sangam.withdrawCase"/>
  <process id="sangam-sec-bank-loan-origination" name="Loan origination" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.bank.loan-origination</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>customerId,loanProduct,amount,tenureMonths,roiPct</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="lo_start" name="Loan application" operaton:initiator="initiator" operaton:formKey="sangam:sec-bank-loan-origination/application"></startEvent>
    <serviceTask id="lo_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>loanProduct=PERSONAL;tenureMonths=36;monthlyIncome=5000000;existingEmi=0;collateralType=NONE;consentGiven=true;kycCompliant=true;bureauScore=750;roiPct=12;caseType=LOAN;committeeThreshold=5000000000;routingDecisionKey=sec-bank-loan-authority;powersDecisionKey=sec-bank-loan-powers;signatureRequired=true;committeeSeats=CREDIT-COMM-1,CREDIT-COMM-2,CREDIT-COMM-3;quorumRule=MAJORITY;analystSeat=CREDIT-ANALYST;kfsValidity=3WD;executionConnector=bank.transfer;executionStep=disburse;reconcileRequired=true;executionPayloadFields=customerId,amount;outputTemplate=sanction-letter;appealAllowed=false</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="lo_consentGw" name="Consent for bureau pull?" default="sec_bank_loan_originatio_f4"></exclusiveGateway>
    <endEvent id="lo_endNoConsent" name="Stopped: no consent"></endEvent>
    <serviceTask id="lo_kyc" name="KYC status" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>cbs.kycStatus</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>status</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>customerId</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>kyc</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="lo_kycGw" name="KYC compliant?" default="sec_bank_loan_originatio_f9"></exclusiveGateway>
    <serviceTask id="lo_rjKyc_code" name="Reason: KYC_NOT_COMPLIANT" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=KYC_NOT_COMPLIANT</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="lo_rjKyc_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="lo_rjKyc_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="lo_bureau" name="Credit bureau report" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>bureau.pull</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>report</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>customerId</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>bureau</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="lo_foir" name="Indicative FOIR" operaton:expression="${execution.setVariable('foirPct', (existingEmi + amount / tenureMonths) * 100 / monthlyIncome)}"></serviceTask>
    <businessRuleTask id="lo_policy" name="Credit policy (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-bank-credit-policy</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <exclusiveGateway id="lo_policyGw" name="Policy result?" default="sec_bank_loan_originatio_f24"></exclusiveGateway>
    <serviceTask id="lo_rjPolicy_code" name="Reason: CREDIT_POLICY_DECLINE" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=CREDIT_POLICY_DECLINE</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="lo_rjPolicy_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="lo_rjPolicy_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="lo_appraise_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>lo_appraise</operaton:string></operaton:field><operaton:field name="spec"><operaton:string>3WD</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="lo_appraise" name="Credit appraisal" operaton:candidateGroups="${analystSeat}" operaton:formKey="sangam:sec-bank-loan-origination/appraisal" operaton:dueDate="${lo_appraiseDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>appraisalDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="lo_appraise_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>lo_appraise</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>analystSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="lo_appraise_warnEnd" name="Warned"></endEvent>
    <serviceTask id="lo_appraise_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>lo_appraise</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>analystSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>appraisalDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="lo_appraise_breachGw" name="Deemed?" default="sec_bank_loan_originatio_f21"></exclusiveGateway>
    <exclusiveGateway id="lo_appraise_done" name=""></exclusiveGateway>
    <exclusiveGateway id="lo_apprGw" name="" default="sec_bank_loan_originatio_f31"></exclusiveGateway>
    <serviceTask id="lo_ask" name="Ask the applicant for documents" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>loan-clarification</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>sms,email</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>applicantRef</operaton:string></operaton:field></extensionElements></serviceTask>
    <intermediateCatchEvent id="lo_clar" name="Documents received"><messageEventDefinition messageRef="msg_sangam_clarificationReceived"/></intermediateCatchEvent>
    <callActivity id="lo_rj_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="lo_rj_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <exclusiveGateway id="lo_secGw" name="Secured?" default="sec_bank_loan_originatio_f38"></exclusiveGateway>
    <parallelGateway id="lo_fork" name="Legal and valuation"></parallelGateway>
    <parallelGateway id="lo_join" name=""></parallelGateway>
    <userTask id="lo_legalofficer" name="Legal scrutiny of title" operaton:candidateGroups="LEGAL-OFFICER" operaton:formKey="sangam:sec-bank-loan-origination/legal-officer"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <userTask id="lo_valuer" name="Valuation of collateral" operaton:candidateGroups="VALUER" operaton:formKey="sangam:sec-bank-loan-origination/valuer"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="lo_commGw" name="Above the committee band?" default="sec_bank_loan_originatio_f40"></exclusiveGateway>
    <callActivity id="lo_committee" name="Credit committee (core committee)" calledElement="sangam-core-committee"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <callActivity id="lo_sanction" name="Sanction by delegated power (core sanction, SoD, signature)" calledElement="sangam-core-sanction"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <exclusiveGateway id="lo_commRes" name="" default="sec_bank_loan_originatio_f45"></exclusiveGateway>
    <serviceTask id="lo_rjComm_code" name="Reason: COMMITTEE_DECLINED" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=COMMITTEE_DECLINED</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="lo_rjComm_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="lo_rjComm_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="lo_kfs" name="Issue Key Facts Statement (APR, fees, recovery, grievance officer)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>docs.kfs</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>issue</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>customerId,amount,tenureMonths,roiPct</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>kfs</operaton:string></operaton:field><operaton:field name="step"><operaton:string>kfs</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="lo_sanGw" name="sanctionOutcome?" default="sec_bank_loan_originatio_f48"></exclusiveGateway>
    <serviceTask id="lo_accept_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>lo_accept</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${kfsValidity}</operaton:expression></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="lo_accept" name="Borrower accepts KFS and sanction terms" operaton:candidateGroups="${borrowerGroup}" operaton:formKey="sangam:sec-bank-loan-origination/accept" operaton:dueDate="${lo_acceptDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>kfsDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="lo_accept_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>lo_accept</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>borrowerGroup</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="lo_accept_warnEnd" name="Warned"></endEvent>
    <serviceTask id="lo_accept_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>lo_accept</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>DEEMED_REFUSAL</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>borrowerGroup</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>kfsDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>accept</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>declined</operaton:string></operaton:field><operaton:field name="maxEscalations"><operaton:string>0</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="lo_accept_breachGw" name="Deemed?" default="sec_bank_loan_originatio_f55"></exclusiveGateway>
    <exclusiveGateway id="lo_accept_done" name=""></exclusiveGateway>
    <serviceTask id="lo_borrower" name="Borrower portal group" operaton:expression="${execution.setVariable('borrowerGroup', 'external:'.concat(customerId))}"></serviceTask>
    <exclusiveGateway id="lo_acceptGw" name="Accepted within validity?" default="sec_bank_loan_originatio_f62"></exclusiveGateway>
    <endEvent id="lo_endDeclined" name="Offer lapsed / declined"></endEvent>
    <serviceTask id="lo_agreement" name="E-sign loan agreement over the sanctioned terms" operaton:class="org.sangam.packs.core.SignatureDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>REQUEST</operaton:string></operaton:field><operaton:field name="purpose"><operaton:string>loan-agreement</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="lo_disburse" name="Disburse to the borrower account (core execution)" calledElement="sangam-core-execution"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <serviceTask id="lo_book" name="Book loan in LMS (repayment schedule)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>lms.book</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>book</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>customerId,amount,tenureMonths,roiPct</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>lms</operaton:string></operaton:field><operaton:field name="step"><operaton:string>book</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="lo_disbFailed" name="Disbursal failed" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>disbursal-failed</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>inapp</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>initiatorSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="lo_exGw" name="executionOutcome?" default="sec_bank_loan_originatio_f65"></exclusiveGateway>
    <callActivity id="lo_close" name="Sanction letter and closure (core)" calledElement="sangam-core-closure"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="lo_end" name="Disbursed"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="lo_appraise_warn" name="SLA warning (75%)" attachedToRef="lo_appraise" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${lo_appraiseWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="lo_appraise_breach" name="SLA breached" attachedToRef="lo_appraise" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${lo_appraiseDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="lo_accept_warn" name="SLA warning (75%)" attachedToRef="lo_accept" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${lo_acceptWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="lo_accept_breach" name="SLA breached" attachedToRef="lo_accept" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${lo_acceptDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="sec_bank_loan_originatio_f1" sourceRef="lo_start" targetRef="lo_defaults"/>
    <sequenceFlow id="sec_bank_loan_originatio_f2" sourceRef="lo_defaults" targetRef="lo_consentGw"/>
    <sequenceFlow id="sec_bank_loan_originatio_f3" name="no" sourceRef="lo_consentGw" targetRef="lo_endNoConsent"><conditionExpression xsi:type="tFormalExpression">${!consentGiven}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_loan_originatio_f4" name="yes" sourceRef="lo_consentGw" targetRef="lo_kyc"/>
    <sequenceFlow id="sec_bank_loan_originatio_f5" sourceRef="lo_kyc" targetRef="lo_kycGw"/>
    <sequenceFlow id="sec_bank_loan_originatio_f6" sourceRef="lo_rjKyc_reject" targetRef="lo_rjKyc_endRejected"/>
    <sequenceFlow id="sec_bank_loan_originatio_f7" sourceRef="lo_rjKyc_code" targetRef="lo_rjKyc_reject"/>
    <sequenceFlow id="sec_bank_loan_originatio_f8" name="no" sourceRef="lo_kycGw" targetRef="lo_rjKyc_code"><conditionExpression xsi:type="tFormalExpression">${!kycCompliant}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_loan_originatio_f9" name="yes" sourceRef="lo_kycGw" targetRef="lo_bureau"/>
    <sequenceFlow id="sec_bank_loan_originatio_f10" sourceRef="lo_bureau" targetRef="lo_foir"/>
    <sequenceFlow id="sec_bank_loan_originatio_f11" sourceRef="lo_foir" targetRef="lo_policy"/>
    <sequenceFlow id="sec_bank_loan_originatio_f12" sourceRef="lo_policy" targetRef="lo_policyGw"/>
    <sequenceFlow id="sec_bank_loan_originatio_f13" sourceRef="lo_rjPolicy_reject" targetRef="lo_rjPolicy_endRejected"/>
    <sequenceFlow id="sec_bank_loan_originatio_f14" sourceRef="lo_rjPolicy_code" targetRef="lo_rjPolicy_reject"/>
    <sequenceFlow id="sec_bank_loan_originatio_f15" name="decline (reasons communicated)" sourceRef="lo_policyGw" targetRef="lo_rjPolicy_code"><conditionExpression xsi:type="tFormalExpression">${creditDecision == 'DECLINE'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_loan_originatio_f16" sourceRef="lo_appraise_warn" targetRef="lo_appraise_warnNotify"/>
    <sequenceFlow id="sec_bank_loan_originatio_f17" sourceRef="lo_appraise_warnNotify" targetRef="lo_appraise_warnEnd"/>
    <sequenceFlow id="sec_bank_loan_originatio_f18" sourceRef="lo_appraise_breach" targetRef="lo_appraise_breachAct"/>
    <sequenceFlow id="sec_bank_loan_originatio_f19" sourceRef="lo_appraise_breachAct" targetRef="lo_appraise_breachGw"/>
    <sequenceFlow id="sec_bank_loan_originatio_f20" name="deemed" sourceRef="lo_appraise_breachGw" targetRef="lo_appraise_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_loan_originatio_f21" name="escalated" sourceRef="lo_appraise_breachGw" targetRef="lo_appraise_slaPlan"/>
    <sequenceFlow id="sec_bank_loan_originatio_f22" sourceRef="lo_appraise_slaPlan" targetRef="lo_appraise"/>
    <sequenceFlow id="sec_bank_loan_originatio_f23" sourceRef="lo_appraise" targetRef="lo_appraise_done"/>
    <sequenceFlow id="sec_bank_loan_originatio_f24" name="eligible / refer" sourceRef="lo_policyGw" targetRef="lo_appraise_slaPlan"/>
    <sequenceFlow id="sec_bank_loan_originatio_f25" sourceRef="lo_appraise_done" targetRef="lo_apprGw"/>
    <sequenceFlow id="sec_bank_loan_originatio_f26" name="clarify" sourceRef="lo_apprGw" targetRef="lo_ask"><conditionExpression xsi:type="tFormalExpression">${appraisalDecision == 'clarify'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_loan_originatio_f27" sourceRef="lo_ask" targetRef="lo_clar"/>
    <sequenceFlow id="sec_bank_loan_originatio_f28" sourceRef="lo_clar" targetRef="lo_appraise_slaPlan"/>
    <sequenceFlow id="sec_bank_loan_originatio_f29" sourceRef="lo_rj_reject" targetRef="lo_rj_endRejected"/>
    <sequenceFlow id="sec_bank_loan_originatio_f30" name="reject" sourceRef="lo_apprGw" targetRef="lo_rj_reject"><conditionExpression xsi:type="tFormalExpression">${appraisalDecision == 'reject'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_loan_originatio_f31" name="recommend" sourceRef="lo_apprGw" targetRef="lo_secGw"/>
    <sequenceFlow id="sec_bank_loan_originatio_f32" name="secured" sourceRef="lo_secGw" targetRef="lo_fork"><conditionExpression xsi:type="tFormalExpression">${collateralType != 'NONE'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_loan_originatio_f33" sourceRef="lo_fork" targetRef="lo_legalofficer"/>
    <sequenceFlow id="sec_bank_loan_originatio_f34" sourceRef="lo_legalofficer" targetRef="lo_join"/>
    <sequenceFlow id="sec_bank_loan_originatio_f35" sourceRef="lo_fork" targetRef="lo_valuer"/>
    <sequenceFlow id="sec_bank_loan_originatio_f36" sourceRef="lo_valuer" targetRef="lo_join"/>
    <sequenceFlow id="sec_bank_loan_originatio_f37" sourceRef="lo_join" targetRef="lo_commGw"/>
    <sequenceFlow id="sec_bank_loan_originatio_f38" name="unsecured" sourceRef="lo_secGw" targetRef="lo_commGw"/>
    <sequenceFlow id="sec_bank_loan_originatio_f39" name="above 5 crore (committeeThreshold, minor units)" sourceRef="lo_commGw" targetRef="lo_committee"><conditionExpression xsi:type="tFormalExpression">${amount &gt; committeeThreshold}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_loan_originatio_f40" name="within delegated power" sourceRef="lo_commGw" targetRef="lo_sanction"/>
    <sequenceFlow id="sec_bank_loan_originatio_f41" sourceRef="lo_committee" targetRef="lo_commRes"/>
    <sequenceFlow id="sec_bank_loan_originatio_f42" name="approved" sourceRef="lo_commRes" targetRef="lo_sanction"><conditionExpression xsi:type="tFormalExpression">${committeeApproved}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_loan_originatio_f43" sourceRef="lo_rjComm_reject" targetRef="lo_rjComm_endRejected"/>
    <sequenceFlow id="sec_bank_loan_originatio_f44" sourceRef="lo_rjComm_code" targetRef="lo_rjComm_reject"/>
    <sequenceFlow id="sec_bank_loan_originatio_f45" name="declined" sourceRef="lo_commRes" targetRef="lo_rjComm_code"/>
    <sequenceFlow id="sec_bank_loan_originatio_f46" name="SANCTIONED" sourceRef="lo_sanGw" targetRef="lo_kfs"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_loan_originatio_f47" name="RETURNED" sourceRef="lo_sanGw" targetRef="lo_appraise_slaPlan"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'RETURNED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_loan_originatio_f48" name="otherwise" sourceRef="lo_sanGw" targetRef="lo_rj_reject"/>
    <sequenceFlow id="sec_bank_loan_originatio_f49" sourceRef="lo_sanction" targetRef="lo_sanGw"/>
    <sequenceFlow id="sec_bank_loan_originatio_f50" sourceRef="lo_accept_warn" targetRef="lo_accept_warnNotify"/>
