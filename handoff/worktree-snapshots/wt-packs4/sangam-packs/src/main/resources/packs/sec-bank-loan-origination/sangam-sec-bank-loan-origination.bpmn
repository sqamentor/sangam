    <sequenceFlow id="sec_bank_loan_originatio_f60" sourceRef="lo_accept_done" targetRef="lo_acceptGw"/>
    <sequenceFlow id="sec_bank_loan_originatio_f61" name="declined / lapsed" sourceRef="lo_acceptGw" targetRef="lo_endDeclined"><conditionExpression xsi:type="tFormalExpression">${kfsDecision != 'accept'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_loan_originatio_f62" name="accepted" sourceRef="lo_acceptGw" targetRef="lo_agreement"/>
