    <sequenceFlow id="sec_bank_loan_originatio_f53" sourceRef="lo_accept_breachAct" targetRef="lo_accept_breachGw"/>
    <sequenceFlow id="sec_bank_loan_originatio_f54" name="deemed" sourceRef="lo_accept_breachGw" targetRef="lo_accept_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_loan_originatio_f55" name="escalated" sourceRef="lo_accept_breachGw" targetRef="lo_accept_slaPlan"/>
