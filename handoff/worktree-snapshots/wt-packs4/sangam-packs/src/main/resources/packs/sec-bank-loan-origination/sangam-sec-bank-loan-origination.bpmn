    <sequenceFlow id="sec_bank_loan_originatio_f64" name="DONE" sourceRef="lo_exGw" targetRef="lo_book"><conditionExpression xsi:type="tFormalExpression">${executionOutcome == 'DONE'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_bank_loan_originatio_f65" name="otherwise" sourceRef="lo_exGw" targetRef="lo_disbFailed"/>
    <sequenceFlow id="sec_bank_loan_originatio_f66" sourceRef="lo_disburse" targetRef="lo_exGw"/>
    <sequenceFlow id="sec_bank_loan_originatio_f67" sourceRef="lo_disbFailed" targetRef="lo_sanction"/>
    <sequenceFlow id="sec_bank_loan_originatio_f68" sourceRef="lo_book" targetRef="lo_close"/>
    <sequenceFlow id="sec_bank_loan_originatio_f69" sourceRef="lo_close" targetRef="lo_end"/>
