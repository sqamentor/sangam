<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_ifms_bill_authority" name="Competent authority" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <!-- Bill authority. Delegation comes from the department order; replace by tenant override. -->
  <decision id="ifms-bill-authority" name="Competent authority" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="ifms-bill-authority_t" hitPolicy="FIRST">
      <input id="ifms-bill-authority_i0" label="Amount (INR)"><inputExpression id="ifms-bill-authority_ie0" typeRef="number"><text>amount</text></inputExpression></input>
      <output id="ifms-bill-authority_o0" label="Competent role" name="competentRole" typeRef="string"/>
      <rule id="ifms-bill-authority_r0"><description>DDO passes bills within the sanction</description>
        <inputEntry id="ifms-bill-authority_r0_i0"><text>&lt;= 100000000</text></inputEntry>
        <outputEntry id="ifms-bill-authority_r0_o0"><text>"DDO"</text></outputEntry>
      </rule>
      <rule id="ifms-bill-authority_r1"><description>Head of Office above 10 lakh [U: department order]</description>
        <inputEntry id="ifms-bill-authority_r1_i0"><text>-</text></inputEntry>
        <outputEntry id="ifms-bill-authority_r1_o0"><text>"HOO"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
