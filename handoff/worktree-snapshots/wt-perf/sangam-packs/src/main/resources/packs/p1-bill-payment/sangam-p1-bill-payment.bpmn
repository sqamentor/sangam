<!-- P1 Bill / payment approval. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_p1_bill_payment" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_cancelCase" name="sangam.cancelCase"/>
  <message id="msg_sangam_withdrawCase" name="sangam.withdrawCase"/>
  <error id="err_APPROVAL_INVALIDATED" name="APPROVAL_INVALIDATED" errorCode="APPROVAL_INVALIDATED"/>
  <process id="sangam-p1-bill-payment" name="P1 Bill / payment approval" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <documentation>Pack P1. Material fields: payee, account, ifsc, amount, budgetHead, sanctionRef (K4).</documentation>
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.p1.bill-payment</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>payee,account,ifsc,amount,budgetHead,sanctionRef</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="p1_start" name="Bill submitted" operaton:initiator="initiator" operaton:formKey="sangam:p1-bill-payment/bill-draft"></startEvent>
    <serviceTask id="p1_defaults" name="Pack configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>caseType=BILL;checkerRole=AO;fallbackSeat=ACCTS-HEAD;scrutinySla=3WD;sanctionSla=3WD;routingDecisionKey=p1-competent-authority;powersDecisionKey=sangam-core-powers;signatureRequired=true;executionConnector=pfms.payment;executionOperation=submitPaymentFile;executionStep=payment;reconcileRequired=true;reconcileConnector=bank.statement;ackWindow=PT4H;outputTemplate=payment-advice;closureTemplate=bill-paid;retentionCategory=C;retentionYears=10;appealAllowed=false;releaseConnector=ifms.release;jointApprovalThreshold=10000000;jointApprovalSeats=SE-CIRCLE,CE-ZONE;recommendationSeats=;dupDuplicate=false;budgetAvailable=0;applicantRef=@payee</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="p1_dupCheck" name="Duplicate-bill check" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>ifms.duplicateBill</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>check</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>payee,invoiceNo,amount</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>dup</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="p1_dupGw" name="Similar bill exists?" default="p1_bill_payment_f5"></exclusiveGateway>
    <userTask id="p1_dupReview" name="Similar bill exists: pass with reason or reject" operaton:candidateGroups="${fallbackSeat}" operaton:formKey="sangam:p1-bill-payment/duplicate-review"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>dupDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="p1_budget" name="Budget-head availability" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>ifms.budget</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>available</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>budgetHead,amount</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>budget</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="p1_dupDecGw" name="Proceed?" default="p1_bill_payment_f10"></exclusiveGateway>
    <serviceTask id="p1_rjDup_code" name="Reason: DUPLICATE_BILL" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=DUPLICATE_BILL</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="p1_rjDup_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="p1_rjDup_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <exclusiveGateway id="p1_budgetGw" name="Budget sufficient?" default="p1_bill_payment_f13"></exclusiveGateway>
    <serviceTask id="p1_encumber" name="Encumber budget (commitment control)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>ifms.encumber</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>encumber</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>budgetHead,amount,sanctionRef</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>encumber</operaton:string></operaton:field><operaton:field name="step"><operaton:string>encumber</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="p1_budgetShort" name="Tell initiator: budget insufficient" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>budget-insufficient</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>inapp</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>initiatorSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="p1_checker" name="Eligible checker (S07)" operaton:class="org.sangam.packs.core.SeatResolutionDelegate"><extensionElements><operaton:field name="op"><operaton:string>CANDIDATES</operaton:string></operaton:field><operaton:field name="roleVar"><operaton:string>checkerRole</operaton:string></operaton:field><operaton:field name="targetVar"><operaton:string>checkerSeat</operaton:string></operaton:field><operaton:field name="fallbackSeat"><operaton:expression>${fallbackSeat}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <serviceTask id="p1_checkerSeat" name="Checker seat" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>scrutinySeat=@checkerSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="p1_scrutiny" name="Checker scrutiny (core)" calledElement="sangam-core-scrutiny"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <userTask id="p1_revise" name="Revise bill" operaton:candidateGroups="${initiatorSeat}" operaton:formKey="sangam:p1-bill-payment/revise"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>p1_reviseDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="p1_revise_gw" name="Resubmit?" default="p1_bill_payment_f22"></exclusiveGateway>
    <serviceTask id="p1_revise_version" name="New case version" operaton:class="org.sangam.packs.core.CaseRecordDelegate"><extensionElements><operaton:field name="op"><operaton:string>RESUBMIT</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="p1_revise_wd_kind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="p1_revise_wd_call" name="Withdraw (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="p1_revise_wd_end" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <callActivity id="p1_rj_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="p1_rj_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="p1_rjLapsed_code" name="Reason: CLARIFICATION_LAPSED" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=CLARIFICATION_LAPSED</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="p1_rjLapsed_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="p1_rjLapsed_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <callActivity id="p1_recommend" name="Recommendation levels (core)" calledElement="sangam-core-recommendation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <exclusiveGateway id="p1_scrGw" name="scrutinyOutcome?" default="p1_bill_payment_f29"></exclusiveGateway>
    <callActivity id="p1_sanction" name="Approver by amount band (core)" calledElement="sangam-core-sanction"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <exclusiveGateway id="p1_recGw" name="recOutcome?" default="p1_bill_payment_f33"></exclusiveGateway>
    <exclusiveGateway id="p1_jointGw" name="Joint approval needed?" default="p1_bill_payment_f40"></exclusiveGateway>
    <exclusiveGateway id="p1_sanGw" name="sanctionOutcome?" default="p1_bill_payment_f37"></exclusiveGateway>
    <userTask id="p1_joint" name="Joint approval" operaton:candidateGroups="${jointApprovalSeats.split(',')[loopCounter]}" operaton:formKey="sangam:p1-bill-payment/joint-approval"><extensionElements><operaton:properties><operaton:property name="sangam.maxCardinality" value="5"/></operaton:properties><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ApprovalBindingListener"><operaton:field name="decisionVar"><operaton:string>jointDecision</operaton:string></operaton:field><operaton:field name="approveValues"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>JOINT</operaton:string></operaton:field></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>jointDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements><multiInstanceLoopCharacteristics isSequential="false"><loopCardinality xsi:type="tFormalExpression">2</loopCardinality></multiInstanceLoopCharacteristics></userTask>
    <callActivity id="p1_execute" name="Payment instruction (core execution)" calledElement="sangam-core-execution"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <exclusiveGateway id="p1_jointRes" name="Both approved?" default="p1_bill_payment_f43"></exclusiveGateway>
    <serviceTask id="p1_invNotify" name="Approval no longer valid: re-approval" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>approval-invalidated</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>inapp</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>initiatorSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="p1_correct" name="Rejected by treasury: correct the bill" operaton:candidateGroups="${initiatorSeat}" operaton:formKey="sangam:p1-bill-payment/treasury-rejection"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>correctDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <callActivity id="p1_close" name="Payment advice, voucher, closure (core)" calledElement="sangam-core-closure"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <exclusiveGateway id="p1_exGw" name="executionOutcome?" default="p1_bill_payment_f47"></exclusiveGateway>
    <exclusiveGateway id="p1_correctGw" name="Correct?" default="p1_bill_payment_f55"></exclusiveGateway>
    <serviceTask id="p1_applyFix" name="Apply corrected bank details" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>account=@correctedAccount;ifsc=@correctedIfsc</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="p1_fixVersion" name="New case version (approval invalidated)" operaton:class="org.sangam.packs.core.CaseRecordDelegate"><extensionElements><operaton:field name="op"><operaton:string>RESUBMIT</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="p1_wdTreasury_kind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="p1_wdTreasury_call" name="Withdraw (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="p1_wdTreasury_end" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <endEvent id="p1_end" name="Paid and reconciled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="p1_invalidated" name="Approval invalidated" attachedToRef="p1_execute" cancelActivity="true"><errorEventDefinition errorRef="err_APPROVAL_INVALIDATED"/></boundaryEvent>
    <sequenceFlow id="p1_bill_payment_f1" sourceRef="p1_start" targetRef="p1_defaults"/>
    <sequenceFlow id="p1_bill_payment_f2" sourceRef="p1_defaults" targetRef="p1_dupCheck"/>
    <sequenceFlow id="p1_bill_payment_f3" sourceRef="p1_dupCheck" targetRef="p1_dupGw"/>
    <sequenceFlow id="p1_bill_payment_f4" name="J-P1-E03" sourceRef="p1_dupGw" targetRef="p1_dupReview"><conditionExpression xsi:type="tFormalExpression">${dupDuplicate}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p1_bill_payment_f5" name="no duplicate" sourceRef="p1_dupGw" targetRef="p1_budget"/>
    <sequenceFlow id="p1_bill_payment_f6" sourceRef="p1_dupReview" targetRef="p1_dupDecGw"/>
    <sequenceFlow id="p1_bill_payment_f7" name="proceed" sourceRef="p1_dupDecGw" targetRef="p1_budget"><conditionExpression xsi:type="tFormalExpression">${dupDecision == 'proceed'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p1_bill_payment_f8" sourceRef="p1_rjDup_reject" targetRef="p1_rjDup_endRejected"/>
    <sequenceFlow id="p1_bill_payment_f9" sourceRef="p1_rjDup_code" targetRef="p1_rjDup_reject"/>
    <sequenceFlow id="p1_bill_payment_f10" name="reject" sourceRef="p1_dupDecGw" targetRef="p1_rjDup_code"/>
    <sequenceFlow id="p1_bill_payment_f11" sourceRef="p1_budget" targetRef="p1_budgetGw"/>
    <sequenceFlow id="p1_bill_payment_f12" name="yes" sourceRef="p1_budgetGw" targetRef="p1_encumber"><conditionExpression xsi:type="tFormalExpression">${budgetAvailable &gt;= amount}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p1_bill_payment_f13" name="J-P1-E11" sourceRef="p1_budgetGw" targetRef="p1_budgetShort"/>
    <sequenceFlow id="p1_bill_payment_f14" sourceRef="p1_encumber" targetRef="p1_checker"/>
    <sequenceFlow id="p1_bill_payment_f15" sourceRef="p1_checker" targetRef="p1_checkerSeat"/>
    <sequenceFlow id="p1_bill_payment_f16" sourceRef="p1_checkerSeat" targetRef="p1_scrutiny"/>
    <sequenceFlow id="p1_bill_payment_f17" sourceRef="p1_revise" targetRef="p1_revise_gw"/>
    <sequenceFlow id="p1_bill_payment_f18" name="resubmit" sourceRef="p1_revise_gw" targetRef="p1_revise_version"><conditionExpression xsi:type="tFormalExpression">${p1_reviseDecision == 'resubmit'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p1_bill_payment_f19" sourceRef="p1_revise_version" targetRef="p1_dupCheck"/>
    <sequenceFlow id="p1_bill_payment_f20" sourceRef="p1_revise_wd_kind" targetRef="p1_revise_wd_call"/>
    <sequenceFlow id="p1_bill_payment_f21" sourceRef="p1_revise_wd_call" targetRef="p1_revise_wd_end"/>
    <sequenceFlow id="p1_bill_payment_f22" name="withdraw" sourceRef="p1_revise_gw" targetRef="p1_revise_wd_kind"/>
    <sequenceFlow id="p1_bill_payment_f23" sourceRef="p1_budgetShort" targetRef="p1_revise"/>
    <sequenceFlow id="p1_bill_payment_f24" sourceRef="p1_rj_reject" targetRef="p1_rj_endRejected"/>
    <sequenceFlow id="p1_bill_payment_f25" sourceRef="p1_rjLapsed_reject" targetRef="p1_rjLapsed_endRejected"/>
    <sequenceFlow id="p1_bill_payment_f26" sourceRef="p1_rjLapsed_code" targetRef="p1_rjLapsed_reject"/>
    <sequenceFlow id="p1_bill_payment_f27" name="ACCEPTED" sourceRef="p1_scrGw" targetRef="p1_recommend"><conditionExpression xsi:type="tFormalExpression">${scrutinyOutcome == 'ACCEPTED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p1_bill_payment_f28" name="LAPSED" sourceRef="p1_scrGw" targetRef="p1_rjLapsed_code"><conditionExpression xsi:type="tFormalExpression">${scrutinyOutcome == 'LAPSED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p1_bill_payment_f29" name="otherwise" sourceRef="p1_scrGw" targetRef="p1_rj_reject"/>
    <sequenceFlow id="p1_bill_payment_f30" sourceRef="p1_scrutiny" targetRef="p1_scrGw"/>
    <sequenceFlow id="p1_bill_payment_f31" name="RECOMMENDED" sourceRef="p1_recGw" targetRef="p1_sanction"><conditionExpression xsi:type="tFormalExpression">${recOutcome == 'RECOMMENDED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p1_bill_payment_f32" name="RETURNED" sourceRef="p1_recGw" targetRef="p1_revise"><conditionExpression xsi:type="tFormalExpression">${recOutcome == 'RETURNED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p1_bill_payment_f33" name="otherwise" sourceRef="p1_recGw" targetRef="p1_rj_reject"/>
    <sequenceFlow id="p1_bill_payment_f34" sourceRef="p1_recommend" targetRef="p1_recGw"/>
    <sequenceFlow id="p1_bill_payment_f35" name="SANCTIONED" sourceRef="p1_sanGw" targetRef="p1_jointGw"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p1_bill_payment_f36" name="RETURNED" sourceRef="p1_sanGw" targetRef="p1_revise"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'RETURNED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p1_bill_payment_f37" name="otherwise" sourceRef="p1_sanGw" targetRef="p1_rj_reject"/>
    <sequenceFlow id="p1_bill_payment_f38" sourceRef="p1_sanction" targetRef="p1_sanGw"/>
    <sequenceFlow id="p1_bill_payment_f39" name="J-P1-E09" sourceRef="p1_jointGw" targetRef="p1_joint"><conditionExpression xsi:type="tFormalExpression">${amount &gt; jointApprovalThreshold}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p1_bill_payment_f40" name="no" sourceRef="p1_jointGw" targetRef="p1_execute"/>
    <sequenceFlow id="p1_bill_payment_f41" sourceRef="p1_joint" targetRef="p1_jointRes"/>
    <sequenceFlow id="p1_bill_payment_f42" name="approved" sourceRef="p1_jointRes" targetRef="p1_execute"><conditionExpression xsi:type="tFormalExpression">${jointDecision == 'approve'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p1_bill_payment_f43" name="rejected" sourceRef="p1_jointRes" targetRef="p1_rj_reject"/>
    <sequenceFlow id="p1_bill_payment_f44" sourceRef="p1_invalidated" targetRef="p1_invNotify"/>
    <sequenceFlow id="p1_bill_payment_f45" sourceRef="p1_invNotify" targetRef="p1_recommend"/>
    <sequenceFlow id="p1_bill_payment_f46" name="DONE" sourceRef="p1_exGw" targetRef="p1_close"><conditionExpression xsi:type="tFormalExpression">${executionOutcome == 'DONE'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p1_bill_payment_f47" name="otherwise" sourceRef="p1_exGw" targetRef="p1_correct"/>
    <sequenceFlow id="p1_bill_payment_f48" sourceRef="p1_execute" targetRef="p1_exGw"/>
    <sequenceFlow id="p1_bill_payment_f49" sourceRef="p1_correct" targetRef="p1_correctGw"/>
    <sequenceFlow id="p1_bill_payment_f50" name="J-P1-E12 correct" sourceRef="p1_correctGw" targetRef="p1_applyFix"><conditionExpression xsi:type="tFormalExpression">${correctDecision == 'correct'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="p1_bill_payment_f51" sourceRef="p1_applyFix" targetRef="p1_fixVersion"/>
    <sequenceFlow id="p1_bill_payment_f52" sourceRef="p1_fixVersion" targetRef="p1_recommend"/>
    <sequenceFlow id="p1_bill_payment_f53" sourceRef="p1_wdTreasury_kind" targetRef="p1_wdTreasury_call"/>
    <sequenceFlow id="p1_bill_payment_f54" sourceRef="p1_wdTreasury_call" targetRef="p1_wdTreasury_end"/>
    <sequenceFlow id="p1_bill_payment_f55" name="withdraw" sourceRef="p1_correctGw" targetRef="p1_wdTreasury_kind"/>
    <sequenceFlow id="p1_bill_payment_f56" sourceRef="p1_close" targetRef="p1_end"/>
