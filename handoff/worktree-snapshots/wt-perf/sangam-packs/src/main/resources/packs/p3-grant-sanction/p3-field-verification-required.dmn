<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_p3_field_verification_required" name="P3 field verification required?" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="p3-field-verification-required" name="P3 field verification required?" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="p3-field-verification-required_t" hitPolicy="FIRST">
      <input id="p3-field-verification-required_i0" label="Land holding (ha)"><inputExpression id="p3-field-verification-required_ie0" typeRef="number"><text>landHolding</text></inputExpression></input>
      <input id="p3-field-verification-required_i1" label="Self-uploaded documents"><inputExpression id="p3-field-verification-required_ie1" typeRef="boolean"><text>documentsSelfUploaded</text></inputExpression></input>
      <output id="p3-field-verification-required_o0" label="Field verification" name="fieldVerification" typeRef="boolean"/>
      <rule id="p3-field-verification-required_r0"><description>documents not from DigiLocker</description>
        <inputEntry id="p3-field-verification-required_r0_i0"><text>-</text></inputEntry>
        <inputEntry id="p3-field-verification-required_r0_i1"><text>true</text></inputEntry>
        <outputEntry id="p3-field-verification-required_r0_o0"><text>true</text></outputEntry>
      </rule>
      <rule id="p3-field-verification-required_r1"><description>larger holdings are visited</description>
        <inputEntry id="p3-field-verification-required_r1_i0"><text>&gt; 2</text></inputEntry>
        <inputEntry id="p3-field-verification-required_r1_i1"><text>-</text></inputEntry>
        <outputEntry id="p3-field-verification-required_r1_o0"><text>true</text></outputEntry>
      </rule>
      <rule id="p3-field-verification-required_r2">
        <inputEntry id="p3-field-verification-required_r2_i0"><text>-</text></inputEntry>
        <inputEntry id="p3-field-verification-required_r2_i1"><text>-</text></inputEntry>
        <outputEntry id="p3-field-verification-required_r2_o0"><text>false</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
