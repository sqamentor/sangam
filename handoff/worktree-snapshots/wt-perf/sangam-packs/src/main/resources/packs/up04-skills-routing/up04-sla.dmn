<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_up04_sla" name="SLA and pool by priority" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="up04-sla" name="SLA and pool by priority" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="up04-sla_t" hitPolicy="FIRST">
      <input id="up04-sla_i0" label="Priority"><inputExpression id="up04-sla_ie0" typeRef="string"><text>priority</text></inputExpression></input>
      <output id="up04-sla_o0" label="SLA" name="slaSpec" typeRef="string"/>
      <output id="up04-sla_o1" label="Pool" name="pool" typeRef="string"/>
      <rule id="up04-sla_r0">
        <inputEntry id="up04-sla_r0_i0"><text>"P1"</text></inputEntry>
        <outputEntry id="up04-sla_r0_o0"><text>"4WH"</text></outputEntry>
        <outputEntry id="up04-sla_r0_o1"><text>"TEAM-C,TEAM-A"</text></outputEntry>
      </rule>
      <rule id="up04-sla_r1">
        <inputEntry id="up04-sla_r1_i0"><text>"P2"</text></inputEntry>
        <outputEntry id="up04-sla_r1_o0"><text>"2WD"</text></outputEntry>
        <outputEntry id="up04-sla_r1_o1"><text>"TEAM-A,TEAM-B,TEAM-C"</text></outputEntry>
      </rule>
      <rule id="up04-sla_r2">
        <inputEntry id="up04-sla_r2_i0"><text>-</text></inputEntry>
        <outputEntry id="up04-sla_r2_o0"><text>"5WD"</text></outputEntry>
        <outputEntry id="up04-sla_r2_o1"><text>"TEAM-A,TEAM-B,TEAM-C"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
