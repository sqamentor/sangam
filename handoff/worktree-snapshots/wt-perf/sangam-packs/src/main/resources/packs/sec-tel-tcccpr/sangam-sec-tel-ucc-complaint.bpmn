<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- UCC complaint. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_sec_tel_ucc_complaint" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <process id="sangam-sec-tel-ucc-complaint" name="UCC complaint" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.tel.tcccpr</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>msisdn,senderHeader</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="uc_start" name="Spam complaint (1909 / app)" operaton:initiator="initiator" operaton:formKey="sangam:sec-tel-tcccpr/complaint"></startEvent>
    <serviceTask id="uc_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>msisdn=@customerId;senderHeader=X;consentFound=false;priorViolations=0;opsSeat=UCC-DESK;applicantRef=@msisdn</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="uc_clock" name="Regulatory clock: ucc" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>ucc</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${uccSpec}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="uc_rule" name="Timeline and graded action (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-tel-ucc</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <serviceTask id="uc_consent" name="Check preference and consent registers" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>dlt.consent</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>check</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>msisdn,senderHeader</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>consent</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="uc_verify_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>uc_verify</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${uccSpec}</operaton:expression></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="uc_verify" name="Verify complaint" operaton:candidateGroups="${opsSeat}" operaton:formKey="sangam:sec-tel-tcccpr/verify" operaton:dueDate="${uc_verifyDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>uccDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="uc_verify_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>uc_verify</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>opsSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="uc_verify_warnEnd" name="Warned"></endEvent>
    <serviceTask id="uc_verify_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>uc_verify</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>opsSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>uccDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="uc_verify_breachGw" name="Deemed?" default="sec_tel_ucc_complaint_f10"></exclusiveGateway>
    <exclusiveGateway id="uc_verify_done" name=""></exclusiveGateway>
    <exclusiveGateway id="uc_gw" name="" default="sec_tel_ucc_complaint_f16"></exclusiveGateway>
    <serviceTask id="uc_action" name="Graded action on the sender (warn / suspend / blacklist)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>dlt.action</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>act</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>senderHeader,senderAction</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>act</operaton:string></operaton:field><operaton:field name="step"><operaton:string>action</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="uc_notify" name="Tell the complainant" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>ucc-outcome</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>sms</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>applicantRef</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="uc_end" name="Closed"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="uc_verify_warn" name="SLA warning (75%)" attachedToRef="uc_verify" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${uc_verifyWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="uc_verify_breach" name="SLA breached" attachedToRef="uc_verify" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${uc_verifyDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="sec_tel_ucc_complaint_f1" sourceRef="uc_start" targetRef="uc_defaults"/>
    <sequenceFlow id="sec_tel_ucc_complaint_f2" sourceRef="uc_defaults" targetRef="uc_rule"/>
    <sequenceFlow id="sec_tel_ucc_complaint_f3" sourceRef="uc_rule" targetRef="uc_clock"/>
    <sequenceFlow id="sec_tel_ucc_complaint_f4" sourceRef="uc_clock" targetRef="uc_consent"/>
    <sequenceFlow id="sec_tel_ucc_complaint_f5" sourceRef="uc_verify_warn" targetRef="uc_verify_warnNotify"/>
    <sequenceFlow id="sec_tel_ucc_complaint_f6" sourceRef="uc_verify_warnNotify" targetRef="uc_verify_warnEnd"/>
    <sequenceFlow id="sec_tel_ucc_complaint_f7" sourceRef="uc_verify_breach" targetRef="uc_verify_breachAct"/>
    <sequenceFlow id="sec_tel_ucc_complaint_f8" sourceRef="uc_verify_breachAct" targetRef="uc_verify_breachGw"/>
    <sequenceFlow id="sec_tel_ucc_complaint_f9" name="deemed" sourceRef="uc_verify_breachGw" targetRef="uc_verify_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_tel_ucc_complaint_f10" name="escalated" sourceRef="uc_verify_breachGw" targetRef="uc_verify_slaPlan"/>
    <sequenceFlow id="sec_tel_ucc_complaint_f11" sourceRef="uc_verify_slaPlan" targetRef="uc_verify"/>
    <sequenceFlow id="sec_tel_ucc_complaint_f12" sourceRef="uc_verify" targetRef="uc_verify_done"/>
    <sequenceFlow id="sec_tel_ucc_complaint_f13" sourceRef="uc_consent" targetRef="uc_verify_slaPlan"/>
    <sequenceFlow id="sec_tel_ucc_complaint_f14" sourceRef="uc_verify_done" targetRef="uc_gw"/>
    <sequenceFlow id="sec_tel_ucc_complaint_f15" name="valid" sourceRef="uc_gw" targetRef="uc_action"><conditionExpression xsi:type="tFormalExpression">${uccDecision == 'valid'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_tel_ucc_complaint_f16" name="invalid (consent on record)" sourceRef="uc_gw" targetRef="uc_notify"/>
    <sequenceFlow id="sec_tel_ucc_complaint_f17" sourceRef="uc_action" targetRef="uc_notify"/>
    <sequenceFlow id="sec_tel_ucc_complaint_f18" sourceRef="uc_notify" targetRef="uc_end"/>
  </process>
