<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_p2_disposal_authority" name="P2 who can dispose, by subject head" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="p2-disposal-authority" name="P2 who can dispose, by subject head" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="p2-disposal-authority_t" hitPolicy="FIRST">
      <input id="p2-disposal-authority_i0" label="Subject head"><inputExpression id="p2-disposal-authority_ie0" typeRef="string"><text>subjectHead</text></inputExpression></input>
      <output id="p2-disposal-authority_o0" label="Competent role" name="competentRole" typeRef="string"/>
      <rule id="p2-disposal-authority_r0">
        <inputEntry id="p2-disposal-authority_r0_i0"><text>"ESTABLISHMENT"</text></inputEntry>
        <outputEntry id="p2-disposal-authority_r0_o0"><text>"DS"</text></outputEntry>
      </rule>
      <rule id="p2-disposal-authority_r1">
        <inputEntry id="p2-disposal-authority_r1_i0"><text>"BUDGET"</text></inputEntry>
        <outputEntry id="p2-disposal-authority_r1_o0"><text>"JS"</text></outputEntry>
      </rule>
      <rule id="p2-disposal-authority_r2">
        <inputEntry id="p2-disposal-authority_r2_i0"><text>"VIGILANCE"</text></inputEntry>
        <outputEntry id="p2-disposal-authority_r2_o0"><text>"SECRETARY"</text></outputEntry>
      </rule>
      <rule id="p2-disposal-authority_r3">
        <inputEntry id="p2-disposal-authority_r3_i0"><text>"POLICY"</text></inputEntry>
        <outputEntry id="p2-disposal-authority_r3_o0"><text>"JS"</text></outputEntry>
      </rule>
      <rule id="p2-disposal-authority_r4">
        <inputEntry id="p2-disposal-authority_r4_i0"><text>-</text></inputEntry>
        <outputEntry id="p2-disposal-authority_r4_o0"><text>"DS"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
