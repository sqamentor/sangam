      {
        "value": "reject",
        "label": {
          "en": "Reject",
          "hi": "अस्वीकार करें"
        }
      },
      {
        "value": "return",
        "label": {
          "en": "Return",
          "hi": "वापस करें"
        }
      },
      {
        "value": "forward",
        "label": {
          "en": "Forward",
          "hi": "अग्रेषित करें"
        }
