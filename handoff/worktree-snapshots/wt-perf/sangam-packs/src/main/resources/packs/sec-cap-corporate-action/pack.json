    },
    {
      "id": "bank.unpaidDividend",
      "capabilityClass": "a",
      "govTag": "",
      "purpose": "Unpaid dividend account"
    }
  ],
  "covers": [
    "SEC-CAP-007",
    "GP-08",
    "GP-09",
    "GP-12",
    "GP-30"
  ],
  "acceptance": [],
