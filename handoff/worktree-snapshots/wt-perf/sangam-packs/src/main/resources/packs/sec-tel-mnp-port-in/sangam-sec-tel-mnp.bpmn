  <process id="sangam-sec-tel-mnp" name="Port-in" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.tel.mnp-port-in</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>msisdn,upc,donorOperator,lsaType</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="mn_start" name="Port-in request" operaton:initiator="initiator" operaton:formKey="sangam:sec-tel-mnp-port-in/request"></startEvent>
    <serviceTask id="mn_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>msisdn=@customerId;upc=X;donorOperator=OP-X;lsaType=INTRA;customerType=INDIVIDUAL;kycOk=true;opsSeat=MNP-DESK;applicantRef=@msisdn</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="mn_tl" name="Porting timeline (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-tel-mnp-timeline</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <serviceTask id="mn_kyc" name="Subscriber KYC" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>dot.kyc</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>ekyc</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>msisdn,customerName</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>kyc</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="mn_kycGw" name="KYC ok?" default="sec_tel_mnp_f8"></exclusiveGateway>
    <serviceTask id="mn_rjKyc_code" name="Reason: KYC_FAILED" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=KYC_FAILED</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="mn_rjKyc_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="mn_rjKyc_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="mn_clock" name="Regulatory clock: port" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>port</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${portSpec}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <serviceTask id="mn_request" name="Port request to MNPSP" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>mnpsp.port</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>request</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>msisdn,upc,donorOperator</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>port</operaton:string></operaton:field><operaton:field name="step"><operaton:string>port-request</operaton:string></operaton:field></extensionElements></serviceTask>
    <eventBasedGateway id="mn_wait" name="Donor response or timeline"></eventBasedGateway>
    <intermediateCatchEvent id="mn_accepted" name="Donor accepted"><messageEventDefinition messageRef="msg_sangam_mnp_donorAccepted"/></intermediateCatchEvent>
    <intermediateCatchEvent id="mn_rejected" name="Donor rejected (coded reason)"><messageEventDefinition messageRef="msg_sangam_mnp_donorRejected"/></intermediateCatchEvent>
    <intermediateCatchEvent id="mn_late" name="Timeline at risk"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${portDueAt}</timeDate></timerEventDefinition></intermediateCatchEvent>
    <serviceTask id="mn_rejNotify" name="Tell the subscriber the reason" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>mnp-rejected</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>sms</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>applicantRef</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="mn_endRejected" name="Port rejected"></endEvent>
    <userTask id="mn_escalate" name="Escalate delayed port to the MNPSP" operaton:candidateGroups="${opsSeat}" operaton:formKey="sangam:sec-tel-mnp-port-in/escalate"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <intermediateCatchEvent id="mn_window" name="Porting window"><messageEventDefinition messageRef="msg_sangam_mnp_portWindow"/></intermediateCatchEvent>
    <serviceTask id="mn_activate" name="Activate on the recipient network" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>hlr.activate</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>activate</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>msisdn</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>hlr</operaton:string></operaton:field><operaton:field name="step"><operaton:string>activate</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="mn_end" name="Ported in"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <sequenceFlow id="sec_tel_mnp_f1" sourceRef="mn_start" targetRef="mn_defaults"/>
    <sequenceFlow id="sec_tel_mnp_f2" sourceRef="mn_defaults" targetRef="mn_tl"/>
