    <sequenceFlow id="sec_ins_intermediary_f6" name="no" sourceRef="ag_gw" targetRef="ag_rj_code"><conditionExpression xsi:type="tFormalExpression">${!eligible}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ins_intermediary_f7" name="yes" sourceRef="ag_gw" targetRef="ag_typeGw"/>
    <sequenceFlow id="sec_ins_intermediary_f8" name="agent" sourceRef="ag_typeGw" targetRef="ag_training"><conditionExpression xsi:type="tFormalExpression">${intermediaryType == 'AGENT'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ins_intermediary_f9" sourceRef="ag_training" targetRef="ag_exam"/>
    <sequenceFlow id="sec_ins_intermediary_f10" sourceRef="ag_exam" targetRef="ag_result"/>
    <sequenceFlow id="sec_ins_intermediary_f11" sourceRef="ag_result" targetRef="ag_examGw"/>
    <sequenceFlow id="sec_ins_intermediary_f12" name="retake" sourceRef="ag_examGw" targetRef="ag_exam"><conditionExpression xsi:type="tFormalExpression">${!examPassed}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ins_intermediary_f13" name="passed" sourceRef="ag_examGw" targetRef="ag_appoint"/>
    <sequenceFlow id="sec_ins_intermediary_f14" sourceRef="ag_appoint" targetRef="ag_apGw"/>
    <sequenceFlow id="sec_ins_intermediary_f15" name="approve" sourceRef="ag_apGw" targetRef="ag_upload"><conditionExpression xsi:type="tFormalExpression">${appointDecision == 'approve'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ins_intermediary_f16" name="reject" sourceRef="ag_apGw" targetRef="ag_endRejected"/>
    <sequenceFlow id="sec_ins_intermediary_f17" sourceRef="ag_upload" targetRef="ag_end"/>
    <sequenceFlow id="sec_ins_intermediary_f18" name="broker" sourceRef="ag_typeGw" targetRef="ag_broker"/>
    <sequenceFlow id="sec_ins_intermediary_f19" sourceRef="ag_broker" targetRef="ag_brokerResult"/>
    <sequenceFlow id="sec_ins_intermediary_f20" sourceRef="ag_brokerResult" targetRef="ag_endBroker"/>
    <subProcess id="ag_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="ag_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="ag_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="ag_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="ag_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="sec_ins_intermediary_f21" sourceRef="ag_withdrawStart" targetRef="ag_withdrawKind"/>
      <sequenceFlow id="sec_ins_intermediary_f22" sourceRef="ag_withdrawKind" targetRef="ag_withdrawCall"/>
      <sequenceFlow id="sec_ins_intermediary_f23" sourceRef="ag_withdrawCall" targetRef="ag_withdrawEnd"/>
    </subProcess>
    <subProcess id="ag_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="ag_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="ag_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="ag_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="ag_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="sec_ins_intermediary_f24" sourceRef="ag_cancelStart" targetRef="ag_cancelKind"/>
      <sequenceFlow id="sec_ins_intermediary_f25" sourceRef="ag_cancelKind" targetRef="ag_cancelCall"/>
      <sequenceFlow id="sec_ins_intermediary_f26" sourceRef="ag_cancelCall" targetRef="ag_cancelEnd"/>
    </subProcess>
