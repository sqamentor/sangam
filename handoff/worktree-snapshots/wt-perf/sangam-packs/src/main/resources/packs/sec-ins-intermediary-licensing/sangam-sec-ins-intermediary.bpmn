  <process id="sangam-sec-ins-intermediary" name="Intermediary registration" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.ins.intermediary-licensing</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>applicantName,intermediaryType</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="ag_start" name="Application" operaton:initiator="initiator" operaton:formKey="sangam:sec-ins-intermediary-licensing/apply"></startEvent>
    <serviceTask id="ag_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>intermediaryType=AGENT;qualification=12TH;netWorth=0;examPassed=false;agencySeat=AGENCY-ADMIN</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="ag_rule" name="Eligibility (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-ins-intermediary</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <exclusiveGateway id="ag_gw" name="Eligible?" default="sec_ins_intermediary_f7"></exclusiveGateway>
    <serviceTask id="ag_rj_code" name="Reason: NOT_ELIGIBLE" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=NOT_ELIGIBLE</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="ag_rj_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="ag_rj_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <exclusiveGateway id="ag_typeGw" name="Agent or broker?" default="sec_ins_intermediary_f18"></exclusiveGateway>
    <userTask id="ag_training" name="Pre-licensing training completed" operaton:candidateGroups="${agencySeat}" operaton:formKey="sangam:sec-ins-intermediary-licensing/training"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="ag_exam" name="Book examination" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>exam.book</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>book</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>applicantName</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>exam</operaton:string></operaton:field><operaton:field name="step"><operaton:string>exam</operaton:string></operaton:field></extensionElements></serviceTask>
    <intermediateCatchEvent id="ag_result" name="Examination result"><messageEventDefinition messageRef="msg_sangam_exam_result"/></intermediateCatchEvent>
    <exclusiveGateway id="ag_examGw" name="Passed?" default="sec_ins_intermediary_f13"></exclusiveGateway>
    <userTask id="ag_appoint" name="Background check and appointment" operaton:candidateGroups="PRINCIPAL-OFFICER" operaton:formKey="sangam:sec-ins-intermediary-licensing/appoint"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>appointDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="ag_apGw" name="" default="sec_ins_intermediary_f16"></exclusiveGateway>
    <serviceTask id="ag_upload" name="Upload appointment to the IRDAI agency portal" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>irdai.agencyPortal</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>appoint</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>applicantName,pan</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>portal</operaton:string></operaton:field><operaton:field name="step"><operaton:string>appoint</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="ag_endRejected" name="Not appointed"></endEvent>
    <endEvent id="ag_end" name="Code issued"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="ag_broker" name="Apply to IRDAI for a broker licence" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>irdai.brokerApply</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>apply</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>applicantName,netWorth</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>broker</operaton:string></operaton:field><operaton:field name="step"><operaton:string>broker</operaton:string></operaton:field></extensionElements></serviceTask>
