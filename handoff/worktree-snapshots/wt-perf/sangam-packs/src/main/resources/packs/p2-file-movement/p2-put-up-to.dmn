<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_p2_put_up_to" name="P2 &quot;put up to&quot; chain by subject head" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="p2-put-up-to" name="P2 &quot;put up to&quot; chain by subject head" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="p2-put-up-to_t" hitPolicy="FIRST">
      <input id="p2-put-up-to_i0" label="Subject head"><inputExpression id="p2-put-up-to_ie0" typeRef="string"><text>subjectHead</text></inputExpression></input>
      <output id="p2-put-up-to_o0" label="Chain of roles" name="recommendationRoles" typeRef="string"/>
      <output id="p2-put-up-to_o1" label="Marking allowed" name="outOfHierarchyAllowed" typeRef="boolean"/>
      <rule id="p2-put-up-to_r0">
        <inputEntry id="p2-put-up-to_r0_i0"><text>"ESTABLISHMENT"</text></inputEntry>
        <outputEntry id="p2-put-up-to_r0_o0"><text>"SO,US"</text></outputEntry>
        <outputEntry id="p2-put-up-to_r0_o1"><text>true</text></outputEntry>
      </rule>
      <rule id="p2-put-up-to_r1">
        <inputEntry id="p2-put-up-to_r1_i0"><text>"BUDGET"</text></inputEntry>
        <outputEntry id="p2-put-up-to_r1_o0"><text>"SO,US,DS"</text></outputEntry>
        <outputEntry id="p2-put-up-to_r1_o1"><text>true</text></outputEntry>
      </rule>
      <rule id="p2-put-up-to_r2"><description>no out-of-hierarchy marking</description>
        <inputEntry id="p2-put-up-to_r2_i0"><text>"VIGILANCE"</text></inputEntry>
        <outputEntry id="p2-put-up-to_r2_o0"><text>"SO,US,DS"</text></outputEntry>
        <outputEntry id="p2-put-up-to_r2_o1"><text>false</text></outputEntry>
      </rule>
      <rule id="p2-put-up-to_r3">
        <inputEntry id="p2-put-up-to_r3_i0"><text>"POLICY"</text></inputEntry>
        <outputEntry id="p2-put-up-to_r3_o0"><text>"SO,US,DS"</text></outputEntry>
        <outputEntry id="p2-put-up-to_r3_o1"><text>true</text></outputEntry>
      </rule>
      <rule id="p2-put-up-to_r4"><description>default</description>
        <inputEntry id="p2-put-up-to_r4_i0"><text>-</text></inputEntry>
        <outputEntry id="p2-put-up-to_r4_o0"><text>"SO,US,DS"</text></outputEntry>
        <outputEntry id="p2-put-up-to_r4_o1"><text>true</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
