  <process id="sangam-sec-nbfc-dlg" name="DLG arrangement" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.nbfc.dlg-arrangement</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>dlgProvider,portfolioAmount,dlgAmount,dlgForm</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="dg_start" name="DLG proposal" operaton:initiator="initiator" operaton:formKey="sangam:sec-nbfc-dlg-arrangement/proposal"></startEvent>
    <serviceTask id="dg_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>dlgProvider=LSP-1;portfolioAmount=100000000;dlgAmount=4000000;dlgForm=FIXED_DEPOSIT;daysOverdue=90;amount=@dlgAmount;caseType=DLG;routingDecisionKey=sec-nbfc-dlg-authority;powersDecisionKey=sec-nbfc-dlg-powers;appealAllowed=false;dlgTenure=P365D</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="dg_pct" name="Cover as % of the portfolio" operaton:expression="${execution.setVariable('dlgPct', dlgAmount * 100 / portfolioAmount)}"></serviceTask>
    <businessRuleTask id="dg_cap" name="Cap and form (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-nbfc-dlg-cap</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <exclusiveGateway id="dg_capGw" name="Within the cap?" default="sec_nbfc_dlg_f8"></exclusiveGateway>
    <serviceTask id="dg_rjCap_code" name="Reason: DLG_ABOVE_CAP_OR_FORM" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=DLG_ABOVE_CAP_OR_FORM</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="dg_rjCap_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="dg_rjCap_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <callActivity id="dg_sanction" name="Approve under the board policy (core sanction)" calledElement="sangam-core-sanction"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <serviceTask id="dg_register" name="Record DLG and disclose" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>dlg.register</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>register</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>dlgProvider,portfolioAmount,dlgAmount,dlgForm</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>dlgReg</operaton:string></operaton:field><operaton:field name="step"><operaton:string>register</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="dg_rj_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="dg_rj_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <exclusiveGateway id="dg_sanGw" name="sanctionOutcome?" default="sec_nbfc_dlg_f11"></exclusiveGateway>
    <eventBasedGateway id="dg_wait" name="Invocation or tenure ends"></eventBasedGateway>
    <intermediateCatchEvent id="dg_invoke" name="Loan in default: invocation requested"><messageEventDefinition messageRef="msg_sangam_dlg_invoke"/></intermediateCatchEvent>
    <intermediateCatchEvent id="dg_tenure" name="Tenure over"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">${dlgTenure}</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <businessRuleTask id="dg_invRule" name="Invocation window (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-nbfc-dlg-invocation</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <exclusiveGateway id="dg_invGw" name="Within 120 days overdue?" default="sec_nbfc_dlg_f19"></exclusiveGateway>
    <serviceTask id="dg_doInvoke" name="Invoke DLG" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>dlg.invoke</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>invoke</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>dlgProvider,daysOverdue</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>inv</operaton:string></operaton:field><operaton:field name="step"><operaton:string>invoke</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="dg_end" name="Arrangement ended"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
