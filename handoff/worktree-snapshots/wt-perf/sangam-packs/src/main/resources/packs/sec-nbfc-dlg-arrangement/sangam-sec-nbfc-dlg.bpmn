    <sequenceFlow id="sec_nbfc_dlg_f7" name="no" sourceRef="dg_capGw" targetRef="dg_rjCap_code"><conditionExpression xsi:type="tFormalExpression">${!dlgAllowed}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_nbfc_dlg_f8" name="yes" sourceRef="dg_capGw" targetRef="dg_sanction"/>
    <sequenceFlow id="sec_nbfc_dlg_f9" sourceRef="dg_rj_reject" targetRef="dg_rj_endRejected"/>
