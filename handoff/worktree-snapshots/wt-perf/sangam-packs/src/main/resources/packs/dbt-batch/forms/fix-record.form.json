{
  "key": "dbt-batch/fix-record",
  "version": "1.0.0",
  "pack": "gov.dbt.batch",
  "title": {
    "en": "Correct failed record",
    "hi": "विफल अभिलेख सुधारें"
  },
  "caseSummary": {
    "source": "materialFields",
    "label": {
      "en": "Case details",
      "hi": "प्रकरण का विवरण"
    }
  },
  "fields": [
    {
      "id": "correctedAccount",
      "type": "masked",
      "required": false,
      "label": {
        "en": "Corrected bank account",
        "hi": "संशोधित बैंक खाता"
      }
    },
    {
      "id": "correctedIfsc",
      "type": "string",
      "required": false,
      "label": {
        "en": "Corrected IFSC",
        "hi": "संशोधित आईएफएससी"
      }
    },
    {
      "id": "remarks",
      "type": "text",
      "required": false,
      "label": {
        "en": "Remarks",
        "hi": "टिप्पणी"
      }
    }
  ],
  "decision": {
    "variable": "fixDecision",
    "required": true,
    "options": [
      {
        "value": "correct",
        "label": {
          "en": "Correct and resubmit",
          "hi": "सुधार कर पुनः प्रस्तुत करें"
        }
      },
      {
        "value": "drop",
        "label": {
          "en": "Drop the proposal",
          "hi": "प्रस्ताव छोड़ें"
        }
      }
    ]
  }
}
