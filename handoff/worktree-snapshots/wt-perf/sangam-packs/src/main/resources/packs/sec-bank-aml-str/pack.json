{
  "id": "sec.bank.aml-str",
  "version": "1.0.0",
  "name": {
    "en": "AML alert investigation and STR / CTR to FIU-IND",
    "hi": "धन-शोधन चेतावनी जाँच एवं एफआईयू-आईएनडी को एसटीआर / सीटीआर"
  },
  "domain": "Banking",
