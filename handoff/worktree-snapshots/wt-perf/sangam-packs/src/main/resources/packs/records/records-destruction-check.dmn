<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_records_destruction_check" name="Appraisal before destruction (Public Records Rules r.9)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="records-destruction-check" name="Appraisal before destruction (Public Records Rules r.9)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="records-destruction-check_t" hitPolicy="FIRST">
      <input id="records-destruction-check_i0" label="Category"><inputExpression id="records-destruction-check_ie0" typeRef="string"><text>retentionCategory</text></inputExpression></input>
      <input id="records-destruction-check_i1" label="Age (years)"><inputExpression id="records-destruction-check_ie1" typeRef="integer"><text>recordAgeYears</text></inputExpression></input>
      <output id="records-destruction-check_o0" label="Appraisal" name="appraisalRequired" typeRef="boolean"/>
      <rule id="records-destruction-check_r0"><description>category A</description>
        <inputEntry id="records-destruction-check_r0_i0"><text>"A"</text></inputEntry>
        <inputEntry id="records-destruction-check_r0_i1"><text>-</text></inputEntry>
        <outputEntry id="records-destruction-check_r0_o0"><text>true</text></outputEntry>
      </rule>
      <rule id="records-destruction-check_r1"><description>older than 25 years</description>
        <inputEntry id="records-destruction-check_r1_i0"><text>-</text></inputEntry>
        <inputEntry id="records-destruction-check_r1_i1"><text>&gt;= 25</text></inputEntry>
        <outputEntry id="records-destruction-check_r1_o0"><text>true</text></outputEntry>
      </rule>
      <rule id="records-destruction-check_r2">
        <inputEntry id="records-destruction-check_r2_i0"><text>-</text></inputEntry>
        <inputEntry id="records-destruction-check_r2_i1"><text>-</text></inputEntry>
        <outputEntry id="records-destruction-check_r2_o0"><text>false</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
