<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_sec_ins_reinsurance" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_ins_claimPaid" name="sangam.ins.claimPaid"/>
  <message id="msg_sangam_ins_recoveryPaid" name="sangam.ins.recoveryPaid"/>
  <process id="sangam-sec-ins-reinsurance" name="Reinsurance of one risk" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.ins.reinsurance</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>policyNo,sumInsured</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="ri_start" name="Risk accepted" operaton:initiator="initiator" operaton:formKey="sangam:sec-ins-reinsurance/risk"></startEvent>
    <serviceTask id="ri_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>sumInsured=@amount;lineOfBusiness=FIRE;riSeat=RI-DESK</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="ri_rule" name="Retention and cession (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-ins-ri-cession</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <serviceTask id="ri_cede" name="Record obligatory and treaty cession" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>re.cede</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>cede</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>policyNo,sumInsured,lineOfBusiness</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>cede</operaton:string></operaton:field><operaton:field name="step"><operaton:string>cede</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="ri_facGw" name="Facultative needed?" default="sec_ins_reinsurance_f7"></exclusiveGateway>
    <userTask id="ri_fac" name="Place facultative (Indian reinsurers first)" operaton:candidateGroups="${riSeat}" operaton:formKey="sangam:sec-ins-reinsurance/fac"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="ri_facSend" name="Placement slip" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>re.placeFac</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>place</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>policyNo,reinsurerPanel</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>fac</operaton:string></operaton:field><operaton:field name="step"><operaton:string>fac</operaton:string></operaton:field></extensionElements></serviceTask>
    <eventBasedGateway id="ri_wait" name="Claim or expiry"></eventBasedGateway>
    <intermediateCatchEvent id="ri_claim" name="Claim on the risk"><messageEventDefinition messageRef="msg_sangam_ins_claimPaid"/></intermediateCatchEvent>
    <intermediateCatchEvent id="ri_expiry" name="Policy expiry"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">P365D</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <endEvent id="ri_endExpired" name="Expired without claim"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="ri_recover" name="Raise recovery on reinsurers" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>re.recovery</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>claim</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>policyNo</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>rec</operaton:string></operaton:field><operaton:field name="step"><operaton:string>recovery</operaton:string></operaton:field></extensionElements></serviceTask>
    <eventBasedGateway id="ri_recWait" name="Paid or follow up"></eventBasedGateway>
    <intermediateCatchEvent id="ri_paid" name="Recovery received"><messageEventDefinition messageRef="msg_sangam_ins_recoveryPaid"/></intermediateCatchEvent>
    <intermediateCatchEvent id="ri_follow" name="Follow up"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">P30D</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <userTask id="ri_followTask" name="Follow up recovery" operaton:candidateGroups="${riSeat}" operaton:formKey="sangam:sec-ins-reinsurance/follow"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <endEvent id="ri_end" name="Recovered"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <sequenceFlow id="sec_ins_reinsurance_f1" sourceRef="ri_start" targetRef="ri_defaults"/>
    <sequenceFlow id="sec_ins_reinsurance_f2" sourceRef="ri_defaults" targetRef="ri_rule"/>
    <sequenceFlow id="sec_ins_reinsurance_f3" sourceRef="ri_rule" targetRef="ri_cede"/>
    <sequenceFlow id="sec_ins_reinsurance_f4" sourceRef="ri_cede" targetRef="ri_facGw"/>
    <sequenceFlow id="sec_ins_reinsurance_f5" name="yes" sourceRef="ri_facGw" targetRef="ri_fac"><conditionExpression xsi:type="tFormalExpression">${facultativeRequired}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ins_reinsurance_f6" sourceRef="ri_fac" targetRef="ri_facSend"/>
    <sequenceFlow id="sec_ins_reinsurance_f7" name="no" sourceRef="ri_facGw" targetRef="ri_wait"/>
    <sequenceFlow id="sec_ins_reinsurance_f8" sourceRef="ri_facSend" targetRef="ri_wait"/>
    <sequenceFlow id="sec_ins_reinsurance_f9" sourceRef="ri_wait" targetRef="ri_claim"/>
    <sequenceFlow id="sec_ins_reinsurance_f10" sourceRef="ri_wait" targetRef="ri_expiry"/>
    <sequenceFlow id="sec_ins_reinsurance_f11" sourceRef="ri_expiry" targetRef="ri_endExpired"/>
    <sequenceFlow id="sec_ins_reinsurance_f12" sourceRef="ri_claim" targetRef="ri_recover"/>
    <sequenceFlow id="sec_ins_reinsurance_f13" sourceRef="ri_recover" targetRef="ri_recWait"/>
    <sequenceFlow id="sec_ins_reinsurance_f14" sourceRef="ri_recWait" targetRef="ri_paid"/>
    <sequenceFlow id="sec_ins_reinsurance_f15" sourceRef="ri_recWait" targetRef="ri_follow"/>
    <sequenceFlow id="sec_ins_reinsurance_f16" sourceRef="ri_follow" targetRef="ri_followTask"/>
    <sequenceFlow id="sec_ins_reinsurance_f17" sourceRef="ri_followTask" targetRef="ri_recWait"/>
    <sequenceFlow id="sec_ins_reinsurance_f18" sourceRef="ri_paid" targetRef="ri_end"/>
