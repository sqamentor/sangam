<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_sec_tel_mnp_timeline" name="Porting timeline (verify against the current TRAI MNP regulations)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="sec-tel-mnp-timeline" name="Porting timeline (verify against the current TRAI MNP regulations)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="sec-tel-mnp-timeline_t" hitPolicy="FIRST">
      <input id="sec-tel-mnp-timeline_i0" label="Service area"><inputExpression id="sec-tel-mnp-timeline_ie0" typeRef="string"><text>lsaType</text></inputExpression></input>
      <input id="sec-tel-mnp-timeline_i1" label="Customer type"><inputExpression id="sec-tel-mnp-timeline_ie1" typeRef="string"><text>customerType</text></inputExpression></input>
      <output id="sec-tel-mnp-timeline_o0" label="Port within" name="portSpec" typeRef="string"/>
      <rule id="sec-tel-mnp-timeline_r0"><description>corporate</description>
        <inputEntry id="sec-tel-mnp-timeline_r0_i0"><text>-</text></inputEntry>
        <inputEntry id="sec-tel-mnp-timeline_r0_i1"><text>"CORPORATE"</text></inputEntry>
        <outputEntry id="sec-tel-mnp-timeline_r0_o0"><text>"5WD"</text></outputEntry>
      </rule>
      <rule id="sec-tel-mnp-timeline_r1"><description>same service area</description>
        <inputEntry id="sec-tel-mnp-timeline_r1_i0"><text>"INTRA"</text></inputEntry>
        <inputEntry id="sec-tel-mnp-timeline_r1_i1"><text>-</text></inputEntry>
        <outputEntry id="sec-tel-mnp-timeline_r1_o0"><text>"3WD"</text></outputEntry>
      </rule>
      <rule id="sec-tel-mnp-timeline_r2"><description>another service area</description>
        <inputEntry id="sec-tel-mnp-timeline_r2_i0"><text>-</text></inputEntry>
        <inputEntry id="sec-tel-mnp-timeline_r2_i1"><text>-</text></inputEntry>
        <outputEntry id="sec-tel-mnp-timeline_r2_o0"><text>"5WD"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
