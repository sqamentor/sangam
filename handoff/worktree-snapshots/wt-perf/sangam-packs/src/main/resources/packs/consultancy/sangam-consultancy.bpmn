  <message id="msg_sangam_cancelCase" name="sangam.cancelCase"/>
  <message id="msg_sangam_withdrawCase" name="sangam.withdrawCase"/>
  <process id="sangam-consultancy" name="Consultancy (QCBS)" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.consultancy</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>itemDescription,estimateAmount</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="cs_start" name="Requirement" operaton:initiator="initiator" operaton:formKey="sangam:consultancy/requirement"></startEvent>
    <serviceTask id="cs_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>caseType=CONSULTANCY;amount=@estimateAmount;routingDecisionKey=tender-authority;committeeSeats=CEC-1,CEC-2,CEC-3;quorumRule=MAJORITY;eoiWindow=P21D;rfpWindow=P30D;appealAllowed=false</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="cs_eoi" name="Publish EOI" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>cppp.publish</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>publishEoi</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>itemDescription</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>eoi</operaton:string></operaton:field><operaton:field name="step"><operaton:string>eoi</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="cs_eoiWindow" name="EOI window" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>eoi</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${eoiWindow}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <intermediateCatchEvent id="cs_eoiClose" name="EOI closes"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${eoiDueAt}</timeDate></timerEventDefinition></intermediateCatchEvent>
    <callActivity id="cs_shortlist" name="Shortlist (core committee)" calledElement="sangam-core-committee"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <serviceTask id="cs_rfp" name="Issue RFP to shortlisted" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>cppp.publish</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>issueRfp</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>itemDescription</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>rfp</operaton:string></operaton:field><operaton:field name="step"><operaton:string>rfp</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="cs_rfpWindow" name="Proposal window" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>rfp</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${rfpWindow}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <intermediateCatchEvent id="cs_rfpClose" name="Proposals close"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${rfpDueAt}</timeDate></timerEventDefinition></intermediateCatchEvent>
    <callActivity id="cs_techEval" name="Technical evaluation (core committee)" calledElement="sangam-core-committee"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <userTask id="cs_techScores" name="Record technical scores" operaton:candidateGroups="CEC-1" operaton:formKey="sangam:consultancy/technical-scores"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <userTask id="cs_finOpen" name="Open financial proposals of the qualified" operaton:candidateGroups="CEC-1" operaton:formKey="sangam:consultancy/financial"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="cs_rank" name="Combined score (QCBS)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>eproc.qcbs</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>rank</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>technicalScore,financialQuote</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>evaluate</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="cs_negotiate" name="Negotiate with the top-ranked firm" operaton:candidateGroups="CEC-1" operaton:formKey="sangam:consultancy/negotiation"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>negDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="cs_award" name="Award values" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>amount=@negotiatedAmount;caseType=CONSULTANCY_AWARD</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="cs_sanction" name="Award sanction (core)" calledElement="sangam-core-sanction"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <exclusiveGateway id="cs_negGw" name="" default="consultancy_f16"></exclusiveGateway>
    <callActivity id="cs_rj_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="cs_rj_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="cs_contract" name="Contract" operaton:class="org.sangam.packs.core.DocumentDelegate"><extensionElements><operaton:field name="template"><operaton:string>consultancy-contract</operaton:string></operaton:field><operaton:field name="requireApproval"><operaton:string>true</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="cs_sanGw" name="sanctionOutcome?" default="consultancy_f20"></exclusiveGateway>
    <endEvent id="cs_end" name="Contracted"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <sequenceFlow id="consultancy_f1" sourceRef="cs_start" targetRef="cs_defaults"/>
    <sequenceFlow id="consultancy_f2" sourceRef="cs_defaults" targetRef="cs_eoi"/>
    <sequenceFlow id="consultancy_f3" sourceRef="cs_eoi" targetRef="cs_eoiWindow"/>
    <sequenceFlow id="consultancy_f4" sourceRef="cs_eoiWindow" targetRef="cs_eoiClose"/>
    <sequenceFlow id="consultancy_f5" sourceRef="cs_eoiClose" targetRef="cs_shortlist"/>
    <sequenceFlow id="consultancy_f6" sourceRef="cs_shortlist" targetRef="cs_rfp"/>
    <sequenceFlow id="consultancy_f7" sourceRef="cs_rfp" targetRef="cs_rfpWindow"/>
    <sequenceFlow id="consultancy_f8" sourceRef="cs_rfpWindow" targetRef="cs_rfpClose"/>
    <sequenceFlow id="consultancy_f9" sourceRef="cs_rfpClose" targetRef="cs_techEval"/>
    <sequenceFlow id="consultancy_f10" sourceRef="cs_techEval" targetRef="cs_techScores"/>
    <sequenceFlow id="consultancy_f11" sourceRef="cs_techScores" targetRef="cs_finOpen"/>
    <sequenceFlow id="consultancy_f12" sourceRef="cs_finOpen" targetRef="cs_rank"/>
    <sequenceFlow id="consultancy_f13" sourceRef="cs_rank" targetRef="cs_negotiate"/>
    <sequenceFlow id="consultancy_f14" sourceRef="cs_negotiate" targetRef="cs_negGw"/>
    <sequenceFlow id="consultancy_f15" name="accepted" sourceRef="cs_negGw" targetRef="cs_award"><conditionExpression xsi:type="tFormalExpression">${negDecision == 'accepted'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="consultancy_f16" name="declined: next ranked (re-issue)" sourceRef="cs_negGw" targetRef="cs_rfp"/>
    <sequenceFlow id="consultancy_f17" sourceRef="cs_award" targetRef="cs_sanction"/>
    <sequenceFlow id="consultancy_f18" sourceRef="cs_rj_reject" targetRef="cs_rj_endRejected"/>
    <sequenceFlow id="consultancy_f19" name="SANCTIONED" sourceRef="cs_sanGw" targetRef="cs_contract"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="consultancy_f20" name="otherwise" sourceRef="cs_sanGw" targetRef="cs_rj_reject"/>
    <sequenceFlow id="consultancy_f21" sourceRef="cs_sanction" targetRef="cs_sanGw"/>
    <sequenceFlow id="consultancy_f22" sourceRef="cs_contract" targetRef="cs_end"/>
    <subProcess id="cs_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="cs_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="cs_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="cs_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="cs_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="consultancy_f23" sourceRef="cs_withdrawStart" targetRef="cs_withdrawKind"/>
      <sequenceFlow id="consultancy_f24" sourceRef="cs_withdrawKind" targetRef="cs_withdrawCall"/>
      <sequenceFlow id="consultancy_f25" sourceRef="cs_withdrawCall" targetRef="cs_withdrawEnd"/>
    </subProcess>
    <subProcess id="cs_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="cs_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="cs_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="cs_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="cs_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="consultancy_f26" sourceRef="cs_cancelStart" targetRef="cs_cancelKind"/>
      <sequenceFlow id="consultancy_f27" sourceRef="cs_cancelKind" targetRef="cs_cancelCall"/>
      <sequenceFlow id="consultancy_f28" sourceRef="cs_cancelCall" targetRef="cs_cancelEnd"/>
    </subProcess>
  </process>
