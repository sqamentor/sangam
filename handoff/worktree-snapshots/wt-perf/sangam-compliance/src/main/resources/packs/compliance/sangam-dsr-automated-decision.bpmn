<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- Sangam compliance pack (jurisdiction-neutral). Timelines arrive as process variables computed from the jurisdiction pack. No diagram layout yet. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" id="defs_sangam_dsr_automated_decision" targetNamespace="http://sangam.org/packs/compliance" exporter="sangam-compliance" exporterVersion="0.2.0">
  <process id="sangam-dsr-automated-decision" name="Human review of an automated decision" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <documentation>Right not to be subject to a solely automated decision (EU-GDPR Art. 22(3)): human intervention and contest.</documentation>
    <startEvent id="start" name="Request received"/>
    <serviceTask id="s_start" name="Mark in progress" operaton:class="org.sangam.compliance.bpmn.ComplianceStepDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="step"><operaton:string>rights.start</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="u_review" name="Human review of the decision" operaton:candidateGroups="DPO" operaton:formKey="sangam:compliance/automated-decision-review"></userTask>
    <boundaryEvent id="t_due" name="Due date" attachedToRef="u_review" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${dueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <serviceTask id="s_record" name="Record review outcome" operaton:class="org.sangam.compliance.bpmn.ComplianceStepDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="step"><operaton:string>rights.humanReview</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="end" name="Reviewed"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="s_start"/>
    <sequenceFlow id="f2" sourceRef="s_start" targetRef="u_review"/>
    <sequenceFlow id="f3" sourceRef="u_review" targetRef="s_record"/>
    <sequenceFlow id="f4" sourceRef="s_record" targetRef="end"/>
    <serviceTask id="esc" name="Escalate overdue request" operaton:class="org.sangam.compliance.bpmn.ComplianceStepDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="step"><operaton:string>rights.escalate</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="end_esc" name="Escalated"/>
    <sequenceFlow id="f_esc1" sourceRef="t_due" targetRef="esc"/>
    <sequenceFlow id="f_esc2" sourceRef="esc" targetRef="end_esc"/>
  </process>
</definitions>