<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- sangam-geo (M7, N13): thin geometry master data. Points, lines and polygons as GeoJSON/WKT, admin-boundary and
     jurisdiction hierarchies defined by data for any country, point-in-polygon and nearest-N rules for DMN (FEEL
     functions) and BPMN (delegates), geofence checks, a portable geohash-cell spatial index with an optional PostGIS
     index, and WMS/WFS connectors through the core connector SPI. Rendering and editing stay outside Sangam.
     Geometry is computed in plain Java: no JTS dependency. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.sangam</groupId>
    <artifactId>sangam-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>sangam-geo</artifactId>
  <name>Sangam geo (geometry, jurisdiction layers, geofences, GIS connectors)</name>

  <dependencies>
    <!-- Dialect, Jdbc, Transactions, AuditChain, Hashes, connector SPI -->
    <dependency>
      <groupId>org.sangam</groupId>
      <artifactId>sangam-core</artifactId>
    </dependency>
    <!-- Apache-2.0 -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- FEEL custom functions + ProcessEnginePlugin + JavaDelegates. Apache-2.0. Provided by sangam-engine at runtime. -->
    <dependency>
      <groupId>org.operaton.bpm</groupId>
      <artifactId>operaton-engine</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.operaton.bpm.dmn</groupId>
      <artifactId>operaton-engine-feel-scala</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- REST controller (optional; the port is framework-neutral). Apache-2.0 / EPL-2.0+GPL-2.0-with-CPE (servlet API). -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-webmvc</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
