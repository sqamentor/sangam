<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_sec_ushealth_claim_clocks" name="Claim timelines by payer program (tenant overridable)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <!-- US-HLT-100…103. -->
  <decision id="sec-ushealth-claim-clocks" name="Claim timelines by payer program (tenant overridable)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="sec-ushealth-claim-clocks_t" hitPolicy="FIRST">
      <input id="sec-ushealth-claim-clocks_i0" label="Payer program"><inputExpression id="sec-ushealth-claim-clocks_ie0" typeRef="string"><text>payerProgram</text></inputExpression></input>
      <output id="sec-ushealth-claim-clocks_o0" label="Timely filing limit" name="filingSpec" typeRef="string"/>
      <output id="sec-ushealth-claim-clocks_o1" label="Status follow-up after" name="statusFollowUp" typeRef="string"/>
      <output id="sec-ushealth-claim-clocks_o2" label="Appeal filing window" name="appealFilingSpec" typeRef="string"/>
      <output id="sec-ushealth-claim-clocks_o3" label="Appeal decision within" name="appealDecisionSpec" typeRef="string"/>
      <rule id="sec-ushealth-claim-clocks_r0"><description>42 CFR 424.44; clean claim 30 d; redetermination 405.942 / 405.950</description>
        <inputEntry id="sec-ushealth-claim-clocks_r0_i0"><text>"MEDICARE_FFS"</text></inputEntry>
        <outputEntry id="sec-ushealth-claim-clocks_r0_o0"><text>"365D"</text></outputEntry>
        <outputEntry id="sec-ushealth-claim-clocks_r0_o1"><text>"P30D"</text></outputEntry>
        <outputEntry id="sec-ushealth-claim-clocks_r0_o2"><text>"120D"</text></outputEntry>
        <outputEntry id="sec-ushealth-claim-clocks_r0_o3"><text>"60D"</text></outputEntry>
      </rule>
      <rule id="sec-ushealth-claim-clocks_r1"><description>MA plan terms (verify contract)</description>
        <inputEntry id="sec-ushealth-claim-clocks_r1_i0"><text>"MA"</text></inputEntry>
        <outputEntry id="sec-ushealth-claim-clocks_r1_o0"><text>"365D"</text></outputEntry>
        <outputEntry id="sec-ushealth-claim-clocks_r1_o1"><text>"P30D"</text></outputEntry>
        <outputEntry id="sec-ushealth-claim-clocks_r1_o2"><text>"60D"</text></outputEntry>
        <outputEntry id="sec-ushealth-claim-clocks_r1_o3"><text>"60D"</text></outputEntry>
      </rule>
      <rule id="sec-ushealth-claim-clocks_r2"><description>state Medicaid (verify state)</description>
        <inputEntry id="sec-ushealth-claim-clocks_r2_i0"><text>"MEDICAID"</text></inputEntry>
        <outputEntry id="sec-ushealth-claim-clocks_r2_o0"><text>"365D"</text></outputEntry>
        <outputEntry id="sec-ushealth-claim-clocks_r2_o1"><text>"P30D"</text></outputEntry>
        <outputEntry id="sec-ushealth-claim-clocks_r2_o2"><text>"120D"</text></outputEntry>
        <outputEntry id="sec-ushealth-claim-clocks_r2_o3"><text>"90D"</text></outputEntry>
      </rule>
      <rule id="sec-ushealth-claim-clocks_r3"><description>commercial: 45 CFR 147.136 (180 d to appeal, post-service 60 d); SYNTHETIC filing limit</description>
        <inputEntry id="sec-ushealth-claim-clocks_r3_i0"><text>-</text></inputEntry>
        <outputEntry id="sec-ushealth-claim-clocks_r3_o0"><text>"180D"</text></outputEntry>
        <outputEntry id="sec-ushealth-claim-clocks_r3_o1"><text>"P30D"</text></outputEntry>
        <outputEntry id="sec-ushealth-claim-clocks_r3_o2"><text>"180D"</text></outputEntry>
        <outputEntry id="sec-ushealth-claim-clocks_r3_o3"><text>"60D"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
