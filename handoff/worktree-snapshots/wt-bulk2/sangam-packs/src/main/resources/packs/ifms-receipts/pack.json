{
  "id": "gov.ifms.receipts",
  "version": "1.0.0",
  "name": {
    "en": "Receipts: challan / e-receipt lifecycle and scroll reconciliation",
    "hi": "प्राप्तियाँ: चालान जीवनचक्र और स्क्रॉल मिलान"
  },
  "domain": "IFMS",
  "description": "Challan (GRN / CPIN) generated with the receipt heads and apportionment rules of the profile, paid through the portal / bank (CIN / UTR), matched with the e-scroll or RBI credit notification, booked to the heads; unaccounted credits follow the SOP (trace, book or refund); short deposits rejected; card settlement within T+n; refund and defacement.",
  "mainProcesses": [
    "sangam-ifms-receipt"
  ],
  "resources": [
    {
      "kind": "BPMN",
      "path": "packs/ifms-receipts/sangam-ifms-receipt.bpmn"
    },
    {
      "kind": "FORM",
      "path": "packs/ifms-receipts/forms/challan.form.json"
    },
    {
      "kind": "FORM",
      "path": "packs/ifms-receipts/forms/resolve.form.json"
    },
    {
      "kind": "SEED",
      "path": "packs/ifms-receipts/seed.json"
    }
  ],
  "seed": "packs/ifms-receipts/seed.json",
  "connectors": [
    {
      "id": "config.profile",
      "capabilityClass": "a",
      "govTag": "G-CONFIG",
      "purpose": "Profile values of the tenant (sangam-config)"
    },
    {
      "id": "config.documentType",
      "capabilityClass": "a",
      "govTag": "G-CONFIG",
      "purpose": "Document-type catalogue (bill types, forms, chains, rails)"
    },
    {
      "id": "config.classification",
      "capabilityClass": "a",
      "govTag": "G-CONFIG",
      "purpose": "Classification validation (head of account)"
    },
    {
      "id": "config.series",
      "capabilityClass": "a",
      "govTag": "G-CONFIG",
      "purpose": "Number series (token, voucher)"
    },
    {
      "id": "receipt.portal",
      "capabilityClass": "b",
      "govTag": "G-PG",
      "purpose": "Challan / payment portal (Bharatkosh, GRAS, GRIPS ...)"
    },
    {
      "id": "treasury.scroll",
      "capabilityClass": "a",
      "govTag": "G-PFMS",
      "purpose": "Bank / RBI e-scroll"
    },
    {
      "id": "receipt.refund",
      "capabilityClass": "c",
      "govTag": "G-PG",
      "purpose": "Refund of a deposit"
    }
  ],
  "covers": [
