    },
    {
      "kind": "BPMN",
      "path": "packs/stores/sangam-stock-discrepancy.bpmn"
    },
    {
      "kind": "DMN",
      "path": "packs/stores/stores-writeoff-authority.dmn"
    },
    {
      "kind": "FORM",
      "path": "packs/stores/forms/count.form.json"
    },
    {
      "kind": "FORM",
      "path": "packs/stores/forms/investigate.form.json"
    },
    {
      "kind": "SEED",
      "path": "packs/stores/seed.json"
    }
  ],
  "seed": "packs/stores/seed.json",
  "connectors": [
