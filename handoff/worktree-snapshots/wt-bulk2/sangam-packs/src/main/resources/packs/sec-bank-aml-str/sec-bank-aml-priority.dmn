<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_sec_bank_aml_priority" name="Alert priority" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="sec-bank-aml-priority" name="Alert priority" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="sec-bank-aml-priority_t" hitPolicy="FIRST">
      <input id="sec-bank-aml-priority_i0" label="Score"><inputExpression id="sec-bank-aml-priority_ie0" typeRef="integer"><text>alertScore</text></inputExpression></input>
      <output id="sec-bank-aml-priority_o0" label="L1 SLA" name="l1Spec" typeRef="string"/>
      <output id="sec-bank-aml-priority_o1" label="STR within (of the conclusion)" name="strSla" typeRef="string"/>
      <rule id="sec-bank-aml-priority_r0"><description>high</description>
        <inputEntry id="sec-bank-aml-priority_r0_i0"><text>&gt;= 80</text></inputEntry>
        <outputEntry id="sec-bank-aml-priority_r0_o0"><text>"1WD"</text></outputEntry>
        <outputEntry id="sec-bank-aml-priority_r0_o1"><text>"7D"</text></outputEntry>
      </rule>
      <rule id="sec-bank-aml-priority_r1"><description>STR within 7 days (PML Rules r.8)</description>
        <inputEntry id="sec-bank-aml-priority_r1_i0"><text>-</text></inputEntry>
        <outputEntry id="sec-bank-aml-priority_r1_o0"><text>"3WD"</text></outputEntry>
        <outputEntry id="sec-bank-aml-priority_r1_o1"><text>"7D"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
