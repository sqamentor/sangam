<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_p2_disposal_powers" name="P2 disposal powers by seat role" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="p2-disposal-powers" name="P2 disposal powers by seat role" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="p2-disposal-powers_t" hitPolicy="FIRST">
      <input id="p2-disposal-powers_i0" label="Seat role"><inputExpression id="p2-disposal-powers_ie0" typeRef="string"><text>seatRole</text></inputExpression></input>
      <input id="p2-disposal-powers_i1" label="Subject head"><inputExpression id="p2-disposal-powers_ie1" typeRef="string"><text>subjectHead</text></inputExpression></input>
      <output id="p2-disposal-powers_o0" label="Power limit" name="powerLimit" typeRef="number"/>
      <output id="p2-disposal-powers_o1" label="May dispose" name="allowed" typeRef="boolean"/>
      <rule id="p2-disposal-powers_r0">
        <inputEntry id="p2-disposal-powers_r0_i0"><text>"SECRETARY"</text></inputEntry>
        <inputEntry id="p2-disposal-powers_r0_i1"><text>-</text></inputEntry>
        <outputEntry id="p2-disposal-powers_r0_o0"><text>1000000000</text></outputEntry>
        <outputEntry id="p2-disposal-powers_r0_o1"><text>true</text></outputEntry>
      </rule>
      <rule id="p2-disposal-powers_r1">
        <inputEntry id="p2-disposal-powers_r1_i0"><text>"JS"</text></inputEntry>
        <inputEntry id="p2-disposal-powers_r1_i1"><text>not("VIGILANCE")</text></inputEntry>
        <outputEntry id="p2-disposal-powers_r1_o0"><text>1000000000</text></outputEntry>
        <outputEntry id="p2-disposal-powers_r1_o1"><text>true</text></outputEntry>
      </rule>
      <rule id="p2-disposal-powers_r2">
        <inputEntry id="p2-disposal-powers_r2_i0"><text>"DS"</text></inputEntry>
        <inputEntry id="p2-disposal-powers_r2_i1"><text>"ESTABLISHMENT"</text></inputEntry>
        <outputEntry id="p2-disposal-powers_r2_o0"><text>1000000000</text></outputEntry>
        <outputEntry id="p2-disposal-powers_r2_o1"><text>true</text></outputEntry>
      </rule>
      <rule id="p2-disposal-powers_r3"><description>no disposal power</description>
        <inputEntry id="p2-disposal-powers_r3_i0"><text>-</text></inputEntry>
        <inputEntry id="p2-disposal-powers_r3_i1"><text>-</text></inputEntry>
        <outputEntry id="p2-disposal-powers_r3_o0"><text>0</text></outputEntry>
        <outputEntry id="p2-disposal-powers_r3_o1"><text>false</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
