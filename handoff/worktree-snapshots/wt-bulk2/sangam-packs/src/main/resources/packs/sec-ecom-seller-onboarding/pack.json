    {
      "id": "pan.verify",
      "capabilityClass": "a",
      "govTag": "",
      "purpose": "PAN"
    },
    {
      "id": "bene.validate",
      "capabilityClass": "a",
      "govTag": "",
      "purpose": "Penny drop"
    },
    {
      "id": "marketplace.createSeller",
      "capabilityClass": "a",
      "govTag": "",
      "purpose": "Seller account"
    },
    {
      "id": "catalogue.publishSeller",
      "capabilityClass": "a",
      "govTag": "",
