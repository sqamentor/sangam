  <process id="sangam-ifms-surrender" name="Surrender of savings" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.ifms.surrender-lapse</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>headOfAccount,surrenderAmount</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="su_start" name="Savings foreseen" operaton:initiator="initiator" operaton:formKey="sangam:ifms-surrender-lapse/surrender"></startEvent>
    <serviceTask id="su_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>surrenderAmount=0;amount=0;faSeat=FA-1;ledgerId=BUDGET;caseType=SURRENDER;routingDecisionKey=ifms-surrender-authority;powersDecisionKey=ifms-surrender-powers;scrutinySeat=PRAO-1;executionConnector=ledger.withdraw;executionStep=withdraw;reconcileRequired=false;outputTemplate=surrender-order;appealAllowed=false</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="su_amount" name="Amount" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>amount=@surrenderAmount</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="su_fa_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>su_fa</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>3WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="su_fa" name="FA concurrence" operaton:candidateGroups="${faSeat}" operaton:formKey="sangam:ifms-surrender-lapse/fa" operaton:dueDate="${su_faDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>faDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="su_fa_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>su_fa</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>faSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="su_fa_warnEnd" name="Warned"></endEvent>
    <serviceTask id="su_fa_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>su_fa</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>faSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>faDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="su_fa_breachGw" name="Deemed?" default="ifms_surrender_f6"></exclusiveGateway>
    <exclusiveGateway id="su_fa_done" name=""></exclusiveGateway>
    <callActivity id="su_sanction" name="CAA approval (core)" calledElement="sangam-core-sanction"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <callActivity id="su_post" name="Ledger WITHDRAW (core execution)" calledElement="sangam-core-execution"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <callActivity id="su_close" name="Communicate to the accounts officer (core closure)" calledElement="sangam-core-closure"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <callActivity id="su_rj_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="su_rj_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <exclusiveGateway id="su_faGw" name="" default="ifms_surrender_f15"></exclusiveGateway>
    <endEvent id="su_retained" name="Retained"></endEvent>
    <exclusiveGateway id="su_sanGw" name="sanctionOutcome?" default="ifms_surrender_f17"></exclusiveGateway>
    <exclusiveGateway id="su_exGw" name="executionOutcome?" default="ifms_surrender_f20"></exclusiveGateway>
    <endEvent id="su_end" name="Closed"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="su_fa_warn" name="SLA warning (75%)" attachedToRef="su_fa" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${su_faWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="su_fa_breach" name="SLA breached" attachedToRef="su_fa" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${su_faDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="ifms_surrender_f1" sourceRef="su_fa_warn" targetRef="su_fa_warnNotify"/>
    <sequenceFlow id="ifms_surrender_f2" sourceRef="su_fa_warnNotify" targetRef="su_fa_warnEnd"/>
    <sequenceFlow id="ifms_surrender_f3" sourceRef="su_fa_breach" targetRef="su_fa_breachAct"/>
    <sequenceFlow id="ifms_surrender_f4" sourceRef="su_fa_breachAct" targetRef="su_fa_breachGw"/>
    <sequenceFlow id="ifms_surrender_f5" name="deemed" sourceRef="su_fa_breachGw" targetRef="su_fa_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_surrender_f6" name="escalated" sourceRef="su_fa_breachGw" targetRef="su_fa_slaPlan"/>
    <sequenceFlow id="ifms_surrender_f7" sourceRef="su_fa_slaPlan" targetRef="su_fa"/>
    <sequenceFlow id="ifms_surrender_f8" sourceRef="su_fa" targetRef="su_fa_done"/>
    <sequenceFlow id="ifms_surrender_f9" sourceRef="su_rj_reject" targetRef="su_rj_endRejected"/>
    <sequenceFlow id="ifms_surrender_f10" sourceRef="su_start" targetRef="su_defaults"/>
    <sequenceFlow id="ifms_surrender_f11" sourceRef="su_defaults" targetRef="su_amount"/>
    <sequenceFlow id="ifms_surrender_f12" sourceRef="su_amount" targetRef="su_fa_slaPlan"/>
    <sequenceFlow id="ifms_surrender_f13" sourceRef="su_fa_done" targetRef="su_faGw"/>
    <sequenceFlow id="ifms_surrender_f14" name="surrender" sourceRef="su_faGw" targetRef="su_sanction"><conditionExpression xsi:type="tFormalExpression">${faDecision == 'surrenderNow'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_surrender_f15" name="retain" sourceRef="su_faGw" targetRef="su_retained"/>
    <sequenceFlow id="ifms_surrender_f16" name="SANCTIONED" sourceRef="su_sanGw" targetRef="su_post"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_surrender_f17" name="otherwise" sourceRef="su_sanGw" targetRef="su_rj_reject"/>
    <sequenceFlow id="ifms_surrender_f18" sourceRef="su_sanction" targetRef="su_sanGw"/>
    <sequenceFlow id="ifms_surrender_f19" name="DONE" sourceRef="su_exGw" targetRef="su_close"><conditionExpression xsi:type="tFormalExpression">${executionOutcome == 'DONE'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_surrender_f20" name="otherwise" sourceRef="su_exGw" targetRef="su_rj_reject"/>
    <sequenceFlow id="ifms_surrender_f21" sourceRef="su_post" targetRef="su_exGw"/>
    <sequenceFlow id="ifms_surrender_f22" sourceRef="su_close" targetRef="su_end"/>
    <subProcess id="su_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="su_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="su_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="su_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="su_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="ifms_surrender_f23" sourceRef="su_withdrawStart" targetRef="su_withdrawKind"/>
      <sequenceFlow id="ifms_surrender_f24" sourceRef="su_withdrawKind" targetRef="su_withdrawCall"/>
      <sequenceFlow id="ifms_surrender_f25" sourceRef="su_withdrawCall" targetRef="su_withdrawEnd"/>
    </subProcess>
    <subProcess id="su_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="su_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="su_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="su_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="su_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="ifms_surrender_f26" sourceRef="su_cancelStart" targetRef="su_cancelKind"/>
      <sequenceFlow id="ifms_surrender_f27" sourceRef="su_cancelKind" targetRef="su_cancelCall"/>
      <sequenceFlow id="ifms_surrender_f28" sourceRef="su_cancelCall" targetRef="su_cancelEnd"/>
    </subProcess>
  </process>
