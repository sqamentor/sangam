<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_ccs_commutation_factor" name="Commutation factor by age next birthday (CCS (Commutation of Pension) Rules)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="ccs-commutation-factor" name="Commutation factor by age next birthday (CCS (Commutation of Pension) Rules)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="ccs-commutation-factor_t" hitPolicy="FIRST">
      <input id="ccs-commutation-factor_i0" label="Age next birthday"><inputExpression id="ccs-commutation-factor_ie0" typeRef="integer"><text>ageNextBirthday</text></inputExpression></input>
      <output id="ccs-commutation-factor_o0" label="Commutation factor" name="commutationFactor" typeRef="number"/>
      <output id="ccs-commutation-factor_o1" label="Rule" name="ruleRef" typeRef="string"/>
      <rule id="ccs-commutation-factor_r0"><description>retirement at 60</description>
        <inputEntry id="ccs-commutation-factor_r0_i0"><text>61</text></inputEntry>
        <outputEntry id="ccs-commutation-factor_r0_o0"><text>8.194</text></outputEntry>
        <outputEntry id="ccs-commutation-factor_r0_o1"><text>"commutation table (age 61 next birthday)"</text></outputEntry>
      </rule>
      <rule id="ccs-commutation-factor_r1"><description>placeholder</description>
        <inputEntry id="ccs-commutation-factor_r1_i0"><text>-</text></inputEntry>
        <outputEntry id="ccs-commutation-factor_r1_o0"><text>8.194</text></outputEntry>
        <outputEntry id="ccs-commutation-factor_r1_o1"><text>"[U] load the full commutation table; default row is a placeholder"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
