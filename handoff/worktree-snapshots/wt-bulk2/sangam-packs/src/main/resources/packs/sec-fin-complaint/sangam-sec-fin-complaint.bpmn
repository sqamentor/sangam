<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- Customer complaint. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_sec_fin_complaint" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_complaint_reopen" name="sangam.complaint.reopen"/>
  <process id="sangam-sec-fin-complaint" name="Customer complaint" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.fin.complaint</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>customerId,regulatorScheme,grievanceText</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="fc_start" name="Complaint received" operaton:initiator="initiator" operaton:formKey="sangam:sec-fin-complaint/complaint"></startEvent>
    <serviceTask id="fc_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>regulatorScheme=RBI;groSeat=GRO;ioSeat=INTERNAL-OMBUDSMAN;reopened=false;applicantRef=@customerId</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="fc_tat" name="Clocks by regulator scheme (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-fin-complaint-tat</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <serviceTask id="fc_crm" name="Register complaint reference" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>crm.case</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>register</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>customerId,regulatorScheme</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>crm</operaton:string></operaton:field><operaton:field name="step"><operaton:string>register</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="fc_ack" name="Acknowledge with reference and timeline" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>complaint-ack</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>sms,email,inapp</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>applicantRef</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="fc_resolve_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>fc_resolve</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${resolveSpec}</operaton:expression></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="fc_resolve" name="Resolve complaint" operaton:candidateGroups="${groSeat}" operaton:formKey="sangam:sec-fin-complaint/resolve" operaton:dueDate="${fc_resolveDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>complaintDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="fc_resolve_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>fc_resolve</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>groSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="fc_resolve_warnEnd" name="Warned"></endEvent>
    <serviceTask id="fc_resolve_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>fc_resolve</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>groSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>complaintDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="fc_resolve_breachGw" name="Deemed?" default="sec_fin_complaint_f10"></exclusiveGateway>
    <exclusiveGateway id="fc_resolve_done" name=""></exclusiveGateway>
    <exclusiveGateway id="fc_gw" name="Rejected or partly?" default="sec_fin_complaint_f19"></exclusiveGateway>
    <userTask id="fc_io" name="Internal ombudsman review before rejection" operaton:candidateGroups="${ioSeat}" operaton:formKey="sangam:sec-fin-complaint/io"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>ioDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="fc_ioGw" name="" default="sec_fin_complaint_f18"></exclusiveGateway>
    <serviceTask id="fc_reply" name="Final reply with the escalation route" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>complaint-final-reply</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>sms,email,letter</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>applicantRef</operaton:string></operaton:field></extensionElements></serviceTask>
    <eventBasedGateway id="fc_wait" name="Reopen or close"></eventBasedGateway>
    <intermediateCatchEvent id="fc_reopen" name="Customer not satisfied"><messageEventDefinition messageRef="msg_sangam_complaint_reopen"/></intermediateCatchEvent>
    <intermediateCatchEvent id="fc_closeAfter" name="Window over"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">P30D</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <exclusiveGateway id="fc_reopenGw" name="First reopen?" default="sec_fin_complaint_f26"></exclusiveGateway>
    <serviceTask id="fc_mark" name="Reopened" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>reopened=true</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="fc_end" name="Closed"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="fc_resolve_warn" name="SLA warning (75%)" attachedToRef="fc_resolve" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${fc_resolveWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="fc_resolve_breach" name="SLA breached" attachedToRef="fc_resolve" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${fc_resolveDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="sec_fin_complaint_f1" sourceRef="fc_start" targetRef="fc_defaults"/>
    <sequenceFlow id="sec_fin_complaint_f2" sourceRef="fc_defaults" targetRef="fc_tat"/>
    <sequenceFlow id="sec_fin_complaint_f3" sourceRef="fc_tat" targetRef="fc_crm"/>
    <sequenceFlow id="sec_fin_complaint_f4" sourceRef="fc_crm" targetRef="fc_ack"/>
    <sequenceFlow id="sec_fin_complaint_f5" sourceRef="fc_resolve_warn" targetRef="fc_resolve_warnNotify"/>
    <sequenceFlow id="sec_fin_complaint_f6" sourceRef="fc_resolve_warnNotify" targetRef="fc_resolve_warnEnd"/>
    <sequenceFlow id="sec_fin_complaint_f7" sourceRef="fc_resolve_breach" targetRef="fc_resolve_breachAct"/>
    <sequenceFlow id="sec_fin_complaint_f8" sourceRef="fc_resolve_breachAct" targetRef="fc_resolve_breachGw"/>
    <sequenceFlow id="sec_fin_complaint_f9" name="deemed" sourceRef="fc_resolve_breachGw" targetRef="fc_resolve_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_fin_complaint_f10" name="escalated" sourceRef="fc_resolve_breachGw" targetRef="fc_resolve_slaPlan"/>
    <sequenceFlow id="sec_fin_complaint_f11" sourceRef="fc_resolve_slaPlan" targetRef="fc_resolve"/>
    <sequenceFlow id="sec_fin_complaint_f12" sourceRef="fc_resolve" targetRef="fc_resolve_done"/>
    <sequenceFlow id="sec_fin_complaint_f13" sourceRef="fc_ack" targetRef="fc_resolve_slaPlan"/>
    <sequenceFlow id="sec_fin_complaint_f14" sourceRef="fc_resolve_done" targetRef="fc_gw"/>
    <sequenceFlow id="sec_fin_complaint_f15" name="reject (IO first)" sourceRef="fc_gw" targetRef="fc_io"><conditionExpression xsi:type="tFormalExpression">${complaintDecision == 'reject' &amp;&amp; ioRequired}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_fin_complaint_f16" sourceRef="fc_io" targetRef="fc_ioGw"/>
    <sequenceFlow id="sec_fin_complaint_f17" name="overturned: resolve" sourceRef="fc_ioGw" targetRef="fc_resolve_slaPlan"><conditionExpression xsi:type="tFormalExpression">${ioDecision == 'overturn'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_fin_complaint_f18" name="upheld" sourceRef="fc_ioGw" targetRef="fc_reply"/>
    <sequenceFlow id="sec_fin_complaint_f19" name="resolved" sourceRef="fc_gw" targetRef="fc_reply"/>
    <sequenceFlow id="sec_fin_complaint_f20" sourceRef="fc_reply" targetRef="fc_wait"/>
    <sequenceFlow id="sec_fin_complaint_f21" sourceRef="fc_wait" targetRef="fc_reopen"/>
    <sequenceFlow id="sec_fin_complaint_f22" sourceRef="fc_wait" targetRef="fc_closeAfter"/>
    <sequenceFlow id="sec_fin_complaint_f23" sourceRef="fc_reopen" targetRef="fc_reopenGw"/>
    <sequenceFlow id="sec_fin_complaint_f24" name="yes" sourceRef="fc_reopenGw" targetRef="fc_mark"><conditionExpression xsi:type="tFormalExpression">${!reopened}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_fin_complaint_f25" sourceRef="fc_mark" targetRef="fc_resolve_slaPlan"/>
    <sequenceFlow id="sec_fin_complaint_f26" name="already reopened: regulator route" sourceRef="fc_reopenGw" targetRef="fc_end"/>
    <sequenceFlow id="sec_fin_complaint_f27" sourceRef="fc_closeAfter" targetRef="fc_end"/>
  </process>
