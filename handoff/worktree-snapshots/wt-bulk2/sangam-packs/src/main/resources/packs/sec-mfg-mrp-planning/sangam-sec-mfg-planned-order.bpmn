      <bpmndi:BPMNEdge id="sec_mfg_planned_order_f8_di" bpmnElement="sec_mfg_planned_order_f8"><di:waypoint x="945" y="195"/><di:waypoint x="993" y="195"/><di:waypoint x="993" y="70"/><di:waypoint x="1042" y="70"/></bpmndi:BPMNEdge>
