<!-- Planned order. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_sec_mfg_planned_order" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <process id="sangam-sec-mfg-planned-order" name="Planned order" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.mfg.mrp-planning</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>key</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="po_start" name="Planned order"></startEvent>
    <serviceTask id="po_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>procurementType=BUY;itemDescription=@key;quantity=10;unitPrice=100</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="po_firm" name="Firm the planned order" operaton:candidateGroups="PLANNER" operaton:formKey="sangam:sec-mfg-mrp-planning/firm"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>firmDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="po_gw" name="" default="sec_mfg_planned_order_f5"></exclusiveGateway>
    <endEvent id="po_endDropped" name="Dropped"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>DROPPED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <exclusiveGateway id="po_typeGw" name="Buy or make?" default="sec_mfg_planned_order_f7"></exclusiveGateway>
    <serviceTask id="po_pr" name="Raise purchase requisition (procure-to-pay)" operaton:class="org.sangam.packs.core.LinkedInstanceDelegate"><extensionElements><operaton:field name="processKey"><operaton:string>sangam-sec-scm-p2p</operaton:string></operaton:field><operaton:field name="linkType"><operaton:string>requisition</operaton:string></operaton:field><operaton:field name="inherit"><operaton:string>itemDescription,quantity,unitPrice</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="po_make" name="Create production order" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>erp.productionOrder</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>create</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>key,quantity</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>prod</operaton:string></operaton:field><operaton:field name="step"><operaton:string>production-order</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="po_end" name="Converted"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <sequenceFlow id="sec_mfg_planned_order_f1" sourceRef="po_start" targetRef="po_defaults"/>
    <sequenceFlow id="sec_mfg_planned_order_f2" sourceRef="po_defaults" targetRef="po_firm"/>
    <sequenceFlow id="sec_mfg_planned_order_f3" sourceRef="po_firm" targetRef="po_gw"/>
    <sequenceFlow id="sec_mfg_planned_order_f4" name="reject" sourceRef="po_gw" targetRef="po_endDropped"><conditionExpression xsi:type="tFormalExpression">${firmDecision == 'reject'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_mfg_planned_order_f5" name="approve" sourceRef="po_gw" targetRef="po_typeGw"/>
    <sequenceFlow id="sec_mfg_planned_order_f6" name="buy" sourceRef="po_typeGw" targetRef="po_pr"><conditionExpression xsi:type="tFormalExpression">${procurementType == 'BUY'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_mfg_planned_order_f7" name="make" sourceRef="po_typeGw" targetRef="po_make"/>
    <sequenceFlow id="sec_mfg_planned_order_f8" sourceRef="po_pr" targetRef="po_end"/>
    <sequenceFlow id="sec_mfg_planned_order_f9" sourceRef="po_make" targetRef="po_end"/>
  </process>
