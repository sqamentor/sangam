      <bpmndi:BPMNEdge id="sec_mfg_planned_order_f5_di" bpmnElement="sec_mfg_planned_order_f5"><di:waypoint x="590" y="70"/><di:waypoint x="705" y="70"/></bpmndi:BPMNEdge>
