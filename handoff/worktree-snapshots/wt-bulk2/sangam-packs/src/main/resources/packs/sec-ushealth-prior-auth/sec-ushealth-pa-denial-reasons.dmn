<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_sec_ushealth_pa_denial_reasons" name="Denial reason routing (SYNTHETIC mapping of payer reason codes)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="sec-ushealth-pa-denial-reasons" name="Denial reason routing (SYNTHETIC mapping of payer reason codes)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="sec-ushealth-pa-denial-reasons_t" hitPolicy="FIRST">
      <input id="sec-ushealth-pa-denial-reasons_i0" label="Reason code"><inputExpression id="sec-ushealth-pa-denial-reasons_ie0" typeRef="string"><text>pasReasonCode</text></inputExpression></input>
      <output id="sec-ushealth-pa-denial-reasons_o0" label="Specific denial reason" name="denialReason" typeRef="string"/>
      <output id="sec-ushealth-pa-denial-reasons_o1" label="Category" name="denialCategory" typeRef="string"/>
      <rule id="sec-ushealth-pa-denial-reasons_r0">
        <inputEntry id="sec-ushealth-pa-denial-reasons_r0_i0"><text>"MED-NEC"</text></inputEntry>
        <outputEntry id="sec-ushealth-pa-denial-reasons_r0_o0"><text>"Not medically necessary per the payer criteria"</text></outputEntry>
        <outputEntry id="sec-ushealth-pa-denial-reasons_r0_o1"><text>"CLINICAL"</text></outputEntry>
      </rule>
      <rule id="sec-ushealth-pa-denial-reasons_r1">
        <inputEntry id="sec-ushealth-pa-denial-reasons_r1_i0"><text>"DOC"</text></inputEntry>
        <outputEntry id="sec-ushealth-pa-denial-reasons_r1_o0"><text>"Documentation missing or incomplete"</text></outputEntry>
        <outputEntry id="sec-ushealth-pa-denial-reasons_r1_o1"><text>"DOCUMENTATION"</text></outputEntry>
      </rule>
      <rule id="sec-ushealth-pa-denial-reasons_r2">
        <inputEntry id="sec-ushealth-pa-denial-reasons_r2_i0"><text>"NOT-COVERED"</text></inputEntry>
        <outputEntry id="sec-ushealth-pa-denial-reasons_r2_o0"><text>"Service not a covered benefit"</text></outputEntry>
        <outputEntry id="sec-ushealth-pa-denial-reasons_r2_o1"><text>"BENEFIT"</text></outputEntry>
      </rule>
      <rule id="sec-ushealth-pa-denial-reasons_r3">
        <inputEntry id="sec-ushealth-pa-denial-reasons_r3_i0"><text>"OON"</text></inputEntry>
        <outputEntry id="sec-ushealth-pa-denial-reasons_r3_o0"><text>"Out-of-network provider"</text></outputEntry>
        <outputEntry id="sec-ushealth-pa-denial-reasons_r3_o1"><text>"NETWORK"</text></outputEntry>
      </rule>
      <rule id="sec-ushealth-pa-denial-reasons_r4"><description>payer must give a specific reason</description>
        <inputEntry id="sec-ushealth-pa-denial-reasons_r4_i0"><text>-</text></inputEntry>
        <outputEntry id="sec-ushealth-pa-denial-reasons_r4_o0"><text>"Payer reason code (see ClaimResponse)"</text></outputEntry>
        <outputEntry id="sec-ushealth-pa-denial-reasons_r4_o1"><text>"OTHER"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
