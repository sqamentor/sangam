{
  "realm": "sangam",
  "displayName": "Sangam (development)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "hi"
  ],
  "defaultLocale": "en",
  "passwordPolicy": "length(12) and notUsername",
  "eventsEnabled": true,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "roles": {
    "realm": [
      {
        "name": "sangam-admin",
        "description": "Platform administrator (tenants, policies, seats)"
      },
      {
        "name": "sangam-operator",
        "description": "Operations: incidents, jobs, outbox, reconciliation console"
      },
      {
        "name": "sangam-auditor",
        "description": "Read audit timelines and verify audit chains (READ_AUDIT)"
      },
      {
        "name": "sangam-modeller",
        "description": "Author BPMN/DMN/forms packages"
      },
      {
        "name": "MODEL_REVIEWER",
        "description": "Review a model package (reviewer != author, by person and seat)"
      },
      {
        "name": "MODEL_APPROVER",
        "description": "Approve a model package for deployment"
      },
      {
        "name": "sangam-deployer",
        "description": "Deploy approved packages"
      },
      {
        "name": "sangam-worker",
        "description": "External-task worker (worker API /api/v1/work)"
      },
      {
        "name": "sangam-user",
        "description": "Every interactive user"
      },
      {
        "name": "p1-initiator",
        "description": "P1 Bill / payment approval: Initiator (DDO office)"
      },
      {
        "name": "p1-checker",
        "description": "P1 Bill / payment approval: Financial checker"
      },
      {
        "name": "p1-approver",
        "description": "P1 Bill / payment approval: Final approver (by amount band)"
      },
      {
        "name": "p1-treasury",
        "description": "P1 Bill / payment approval: Treasury / payment system operator"
      },
      {
        "name": "p2-dealing-assistant",
