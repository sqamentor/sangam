  <message id="msg_sangam_edu_meritPublished" name="sangam.edu.meritPublished"/>
  <message id="msg_sangam_edu_withdraw" name="sangam.edu.withdraw"/>
  <process id="sangam-sec-edu-admission" name="Admission" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.edu.admission</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>applicantName,programme,score</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="ed_start" name="Application submitted" operaton:initiator="initiator" operaton:formKey="sangam:sec-edu-admission/apply"></startEvent>
    <serviceTask id="ed_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>programme=BA;score=60;offered=true;daysBeforeLastDate=20;scrutinySeat=ADMISSION-OFFICE;executionConnector=pg.collect;executionStep=fee;verifyApproval=false;reconcileRequired=false;executionPayloadFields=applicantName,feeAmount;feeAmount=50000</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ed_pull" name="Pull marksheets (DigiLocker / APAAR)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>digilocker.pull</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>pull</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>applicantName</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>dl</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="ed_elig" name="Eligibility (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-edu-eligibility</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <exclusiveGateway id="ed_eligGw" name="Eligible?" default="sec_edu_admission_f8"></exclusiveGateway>
    <serviceTask id="ed_rjElig_code" name="Reason: NOT_ELIGIBLE" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=NOT_ELIGIBLE</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="ed_rjElig_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="ed_rjElig_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <callActivity id="ed_scrutiny" name="Document scrutiny (core)" calledElement="sangam-core-scrutiny" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <callActivity id="ed_rj_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="ed_rj_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <intermediateCatchEvent id="ed_merit" name="Merit list published"><messageEventDefinition messageRef="msg_sangam_edu_meritPublished"/></intermediateCatchEvent>
    <exclusiveGateway id="ed_scrGw" name="scrutinyOutcome?" default="sec_edu_admission_f11"></exclusiveGateway>
    <exclusiveGateway id="ed_offerGw" name="Offered a seat?" default="sec_edu_admission_f23"></exclusiveGateway>
    <endEvent id="ed_endNotOffered" name="Not offered (waitlist)"></endEvent>
    <serviceTask id="ed_group" name="Applicant group" operaton:expression="${execution.setVariable('applicantGroup', 'external:'.concat(applicantName))}"></serviceTask>
    <serviceTask id="ed_accept_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>ed_accept</operaton:string></operaton:field><operaton:field name="spec"><operaton:string>7D</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="ed_accept" name="Accept offer and pay fee" operaton:candidateGroups="${applicantGroup}" operaton:formKey="sangam:sec-edu-admission/accept" operaton:dueDate="${ed_acceptDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>offerDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="ed_accept_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>ed_accept</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>applicantGroup</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="ed_accept_warnEnd" name="Warned"></endEvent>
    <serviceTask id="ed_accept_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>ed_accept</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>DEEMED_REFUSAL</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>applicantGroup</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>offerDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>accept</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>declined</operaton:string></operaton:field><operaton:field name="maxEscalations"><operaton:string>0</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="ed_accept_breachGw" name="Deemed?" default="sec_edu_admission_f20"></exclusiveGateway>
    <exclusiveGateway id="ed_accept_done" name=""></exclusiveGateway>
    <exclusiveGateway id="ed_accGw" name="" default="sec_edu_admission_f27"></exclusiveGateway>
    <endEvent id="ed_endLapsed" name="Offer lapsed: seat released"></endEvent>
    <callActivity id="ed_fee" name="Collect fee (core execution)" calledElement="sangam-core-execution" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <serviceTask id="ed_enrol" name="Enrol and register on ABC" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>sis.enrol</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>enrol</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>applicantName,programme</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>sis</operaton:string></operaton:field><operaton:field name="step"><operaton:string>enrol</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="ed_end" name="Enrolled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="ed_accept_warn" name="SLA warning (75%)" attachedToRef="ed_accept" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${ed_acceptWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="ed_accept_breach" name="SLA breached" attachedToRef="ed_accept" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${ed_acceptDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="sec_edu_admission_f1" sourceRef="ed_start" targetRef="ed_defaults"/>
    <sequenceFlow id="sec_edu_admission_f2" sourceRef="ed_defaults" targetRef="ed_pull"/>
    <sequenceFlow id="sec_edu_admission_f3" sourceRef="ed_pull" targetRef="ed_elig"/>
    <sequenceFlow id="sec_edu_admission_f4" sourceRef="ed_elig" targetRef="ed_eligGw"/>
    <sequenceFlow id="sec_edu_admission_f5" sourceRef="ed_rjElig_reject" targetRef="ed_rjElig_endRejected"/>
    <sequenceFlow id="sec_edu_admission_f6" sourceRef="ed_rjElig_code" targetRef="ed_rjElig_reject"/>
    <sequenceFlow id="sec_edu_admission_f7" name="no" sourceRef="ed_eligGw" targetRef="ed_rjElig_code"><conditionExpression xsi:type="tFormalExpression">${!eligible}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_edu_admission_f8" name="yes" sourceRef="ed_eligGw" targetRef="ed_scrutiny"/>
    <sequenceFlow id="sec_edu_admission_f9" sourceRef="ed_rj_reject" targetRef="ed_rj_endRejected"/>
    <sequenceFlow id="sec_edu_admission_f10" name="ACCEPTED" sourceRef="ed_scrGw" targetRef="ed_merit"><conditionExpression xsi:type="tFormalExpression">${scrutinyOutcome == 'ACCEPTED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_edu_admission_f11" name="otherwise" sourceRef="ed_scrGw" targetRef="ed_rj_reject"/>
    <sequenceFlow id="sec_edu_admission_f12" sourceRef="ed_scrutiny" targetRef="ed_scrGw"/>
    <sequenceFlow id="sec_edu_admission_f13" sourceRef="ed_merit" targetRef="ed_offerGw"/>
    <sequenceFlow id="sec_edu_admission_f14" name="no" sourceRef="ed_offerGw" targetRef="ed_endNotOffered"><conditionExpression xsi:type="tFormalExpression">${!offered}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_edu_admission_f15" sourceRef="ed_accept_warn" targetRef="ed_accept_warnNotify"/>
    <sequenceFlow id="sec_edu_admission_f16" sourceRef="ed_accept_warnNotify" targetRef="ed_accept_warnEnd"/>
    <sequenceFlow id="sec_edu_admission_f17" sourceRef="ed_accept_breach" targetRef="ed_accept_breachAct"/>
    <sequenceFlow id="sec_edu_admission_f18" sourceRef="ed_accept_breachAct" targetRef="ed_accept_breachGw"/>
    <sequenceFlow id="sec_edu_admission_f19" name="deemed" sourceRef="ed_accept_breachGw" targetRef="ed_accept_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_edu_admission_f20" name="escalated" sourceRef="ed_accept_breachGw" targetRef="ed_accept_slaPlan"/>
    <sequenceFlow id="sec_edu_admission_f21" sourceRef="ed_accept_slaPlan" targetRef="ed_accept"/>
    <sequenceFlow id="sec_edu_admission_f22" sourceRef="ed_accept" targetRef="ed_accept_done"/>
    <sequenceFlow id="sec_edu_admission_f23" name="yes" sourceRef="ed_offerGw" targetRef="ed_group"/>
    <sequenceFlow id="sec_edu_admission_f24" sourceRef="ed_group" targetRef="ed_accept_slaPlan"/>
    <sequenceFlow id="sec_edu_admission_f25" sourceRef="ed_accept_done" targetRef="ed_accGw"/>
    <sequenceFlow id="sec_edu_admission_f26" name="no" sourceRef="ed_accGw" targetRef="ed_endLapsed"><conditionExpression xsi:type="tFormalExpression">${offerDecision != 'accept'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_edu_admission_f27" name="accept" sourceRef="ed_accGw" targetRef="ed_fee"/>
    <sequenceFlow id="sec_edu_admission_f28" sourceRef="ed_fee" targetRef="ed_enrol"/>
    <sequenceFlow id="sec_edu_admission_f29" sourceRef="ed_enrol" targetRef="ed_end"/>
    <subProcess id="ed_withdraw" name="Withdrawal of admission" triggeredByEvent="true">
      <startEvent id="ed_wdStart" name="Withdrawal" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_edu_withdraw"/></startEvent>
      <businessRuleTask id="ed_wdRule" name="Refund under the UGC schedule (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-edu-refund</operaton:string></operaton:field></extensionElements></businessRuleTask>
      <serviceTask id="ed_wdCfg" name="Refund settings" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>executionConnector=pg.refund;executionStep=withdrawal-refund;executionPayloadFields=applicantName,refundPct,feeAmount</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="ed_wdRefund" name="Refund (core execution)" calledElement="sangam-core-execution" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="ed_wdEnd" name="Withdrawn with refund"></endEvent>
      <sequenceFlow id="sec_edu_admission_f30" sourceRef="ed_wdStart" targetRef="ed_wdRule"/>
      <sequenceFlow id="sec_edu_admission_f31" sourceRef="ed_wdRule" targetRef="ed_wdCfg"/>
      <sequenceFlow id="sec_edu_admission_f32" sourceRef="ed_wdCfg" targetRef="ed_wdRefund"/>
      <sequenceFlow id="sec_edu_admission_f33" sourceRef="ed_wdRefund" targetRef="ed_wdEnd"/>
    </subProcess>
  </process>
