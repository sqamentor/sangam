<!-- Return and refund. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_sec_ecom_return" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_returnReceived" name="sangam.returnReceived"/>
  <process id="sangam-sec-ecom-return" name="Return and refund" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.ecom.return-refund</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>orderId,returnReason,refundAmount</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="er_start" name="Return requested" operaton:initiator="initiator" operaton:formKey="sangam:sec-ecom-return-refund/request"></startEvent>
    <serviceTask id="er_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>returnReason=DAMAGED;resolutionPref=REFUND;category=GENERAL;qcSeat=RETURNS-QC;executionConnector=pg.refund;executionStep=refund;verifyApproval=false;reconcileRequired=false;executionPayloadFields=orderId,refundAmount;applicantRef=@customerId</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="er_policy" name="Return policy (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-ecom-return-policy</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <exclusiveGateway id="er_gw" name="Eligible?" default="sec_ecom_return_f6"></exclusiveGateway>
    <serviceTask id="er_notEligible" name="Not eligible: reason given" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>return-not-eligible</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>sms,email</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>applicantRef</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="er_endIneligible" name="Not eligible"></endEvent>
    <serviceTask id="er_pickup" name="Arrange reverse pickup" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>shipping.pickup</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>pickup</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>orderId</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>pickup</operaton:string></operaton:field><operaton:field name="step"><operaton:string>pickup</operaton:string></operaton:field></extensionElements></serviceTask>
    <eventBasedGateway id="er_wait" name="Received or pickup failed"></eventBasedGateway>
    <intermediateCatchEvent id="er_received" name="Received at the warehouse"><messageEventDefinition messageRef="msg_sangam_returnReceived"/></intermediateCatchEvent>
    <intermediateCatchEvent id="er_pickFail" name="Pickup not done"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">P10D</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <serviceTask id="er_pickNotify" name="Pickup failed: reschedule or self-ship" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>pickup-failed</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>sms,email</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>applicantRef</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="er_endPickFailed" name="Pickup failed"></endEvent>
    <userTask id="er_qc" name="Quality check" operaton:candidateGroups="${qcSeat}" operaton:formKey="sangam:sec-ecom-return-refund/qc"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>qcDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="er_qcGw" name="" default="sec_ecom_return_f17"></exclusiveGateway>
    <userTask id="er_dispute" name="Marketplace arbitration of the seller dispute" operaton:candidateGroups="MARKETPLACE-ARB" operaton:formKey="sangam:sec-ecom-return-refund/dispute"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>disputeDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="er_dispGw" name="" default="sec_ecom_return_f18"></exclusiveGateway>
    <endEvent id="er_endRejected" name="Return rejected: item sent back"></endEvent>
    <exclusiveGateway id="er_resGw" name="Refund or replacement?" default="sec_ecom_return_f21"></exclusiveGateway>
    <serviceTask id="er_replace" name="Create replacement order" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>order.replacement</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>create</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>orderId</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>repl</operaton:string></operaton:field><operaton:field name="step"><operaton:string>replacement</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="er_endReplaced" name="Replaced"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <callActivity id="er_refund" name="Refund to the original method (core execution)" calledElement="sangam-core-execution" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="er_end" name="Refunded"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <sequenceFlow id="sec_ecom_return_f1" sourceRef="er_start" targetRef="er_defaults"/>
    <sequenceFlow id="sec_ecom_return_f2" sourceRef="er_defaults" targetRef="er_policy"/>
    <sequenceFlow id="sec_ecom_return_f3" sourceRef="er_policy" targetRef="er_gw"/>
    <sequenceFlow id="sec_ecom_return_f4" name="no" sourceRef="er_gw" targetRef="er_notEligible"><conditionExpression xsi:type="tFormalExpression">${!returnEligible}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ecom_return_f5" sourceRef="er_notEligible" targetRef="er_endIneligible"/>
    <sequenceFlow id="sec_ecom_return_f6" name="yes" sourceRef="er_gw" targetRef="er_pickup"/>
    <sequenceFlow id="sec_ecom_return_f7" sourceRef="er_pickup" targetRef="er_wait"/>
    <sequenceFlow id="sec_ecom_return_f8" sourceRef="er_wait" targetRef="er_received"/>
    <sequenceFlow id="sec_ecom_return_f9" sourceRef="er_wait" targetRef="er_pickFail"/>
    <sequenceFlow id="sec_ecom_return_f10" sourceRef="er_pickFail" targetRef="er_pickNotify"/>
    <sequenceFlow id="sec_ecom_return_f11" sourceRef="er_pickNotify" targetRef="er_endPickFailed"/>
    <sequenceFlow id="sec_ecom_return_f12" sourceRef="er_received" targetRef="er_qc"/>
    <sequenceFlow id="sec_ecom_return_f13" sourceRef="er_qc" targetRef="er_qcGw"/>
    <sequenceFlow id="sec_ecom_return_f14" name="QC failed" sourceRef="er_qcGw" targetRef="er_dispute"><conditionExpression xsi:type="tFormalExpression">${qcDecision == 'reject'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ecom_return_f15" sourceRef="er_dispute" targetRef="er_dispGw"/>
    <sequenceFlow id="sec_ecom_return_f16" name="seller" sourceRef="er_dispGw" targetRef="er_endRejected"><conditionExpression xsi:type="tFormalExpression">${disputeDecision == 'seller'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ecom_return_f17" name="accept" sourceRef="er_qcGw" targetRef="er_resGw"/>
    <sequenceFlow id="sec_ecom_return_f18" name="customer" sourceRef="er_dispGw" targetRef="er_resGw"/>
    <sequenceFlow id="sec_ecom_return_f19" name="replace" sourceRef="er_resGw" targetRef="er_replace"><conditionExpression xsi:type="tFormalExpression">${resolutionPref == 'REPLACE'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ecom_return_f20" sourceRef="er_replace" targetRef="er_endReplaced"/>
    <sequenceFlow id="sec_ecom_return_f21" name="refund" sourceRef="er_resGw" targetRef="er_refund"/>
    <sequenceFlow id="sec_ecom_return_f22" sourceRef="er_refund" targetRef="er_end"/>
  </process>
