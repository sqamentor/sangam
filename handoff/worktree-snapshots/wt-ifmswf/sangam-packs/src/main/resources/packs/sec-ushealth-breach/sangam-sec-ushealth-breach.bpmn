      <bpmndi:BPMNShape id="bn_leShift_di" bpmnElement="bn_leShift"><dc:Bounds x="1670" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="bn_leOptGw_di" bpmnElement="bn_leOptGw"><dc:Bounds x="1530" y="45" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="bn_leOptMerge_di" bpmnElement="bn_leOptMerge"><dc:Bounds x="1860" y="45" width="50" height="50"/></bpmndi:BPMNShape>
