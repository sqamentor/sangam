      <bpmndi:BPMNShape id="bn_annualWait_di" bpmnElement="bn_annualWait"><dc:Bounds x="2692" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="bn_hhsAnnual_di" bpmnElement="bn_hhsAnnual"><dc:Bounds x="2825" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="bn_close_di" bpmnElement="bn_close"><dc:Bounds x="3320" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="bn_end_di" bpmnElement="bn_end"><dc:Bounds x="3517" y="52" width="36" height="36"/></bpmndi:BPMNShape>
