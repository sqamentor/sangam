      <bpmndi:BPMNShape id="bn_hhsMerge_di" bpmnElement="bn_hhsMerge"><dc:Bounds x="3015" y="45" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="bn_hhs_di" bpmnElement="bn_hhs"><dc:Bounds x="2330" y="155" width="100" height="80"/></bpmndi:BPMNShape>
