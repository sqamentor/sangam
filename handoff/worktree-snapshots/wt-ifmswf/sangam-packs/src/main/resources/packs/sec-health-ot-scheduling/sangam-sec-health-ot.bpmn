    <sequenceFlow id="sec_health_ot_f5" name="unfit / defer" sourceRef="ot_pacGw" targetRef="ot_endDeferred"><conditionExpression xsi:type="tFormalExpression">${pacDecision == 'defer'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_health_ot_f6" name="fit" sourceRef="ot_pacGw" targetRef="ot_consent"/>
    <sequenceFlow id="sec_health_ot_f7" sourceRef="ot_consent" targetRef="ot_book"/>
    <sequenceFlow id="sec_health_ot_f8" sourceRef="ot_book" targetRef="ot_signIn"/>
    <sequenceFlow id="sec_health_ot_f9" sourceRef="ot_signIn" targetRef="ot_timeOut"/>
    <sequenceFlow id="sec_health_ot_f10" sourceRef="ot_timeOut" targetRef="ot_toGw"/>
    <sequenceFlow id="sec_health_ot_f11" name="abort" sourceRef="ot_toGw" targetRef="ot_endAborted"><conditionExpression xsi:type="tFormalExpression">${timeOutDecision == 'abort'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_health_ot_f12" name="proceed" sourceRef="ot_toGw" targetRef="ot_signOut"/>
    <sequenceFlow id="sec_health_ot_f13" sourceRef="ot_signOut" targetRef="ot_specimen"/>
    <sequenceFlow id="sec_health_ot_f14" sourceRef="ot_specimen" targetRef="ot_recovery"/>
    <sequenceFlow id="sec_health_ot_f15" sourceRef="ot_recovery" targetRef="ot_end"/>
