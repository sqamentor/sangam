  <message id="msg_sangam_cancelCase" name="sangam.cancelCase"/>
  <message id="msg_sangam_withdrawCase" name="sangam.withdrawCase"/>
  <process id="sangam-sec-health-ot" name="Surgery" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.health.ot-scheduling</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>patientName,procedureName,urgency</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="ot_start" name="Surgery requested" operaton:initiator="initiator" operaton:formKey="sangam:sec-health-ot-scheduling/request"></startEvent>
    <serviceTask id="ot_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>patientName=@customerId;procedureName=X;urgency=ELECTIVE;surgeonSeat=SURGEON;anaesSeat=ANAESTHETIST;otSeat=OT-NURSE</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="ot_rule" name="Slot window by urgency (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-health-ot-urgency</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <userTask id="ot_pac" name="Pre-anaesthetic check" operaton:candidateGroups="${anaesSeat}" operaton:formKey="sangam:sec-health-ot-scheduling/pac"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>pacDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="ot_pacGw" name="" default="sec_health_ot_f6"></exclusiveGateway>
    <endEvent id="ot_endDeferred" name="Deferred (optimise and re-request)"></endEvent>
    <userTask id="ot_consent" name="Informed consent for surgery and anaesthesia" operaton:candidateGroups="${surgeonSeat}" operaton:formKey="sangam:sec-health-ot-scheduling/consent"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="ot_book" name="Book OT slot" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>ot.book</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>book</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>patientName,procedureName,otWindow</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>ot</operaton:string></operaton:field><operaton:field name="step"><operaton:string>book</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="ot_signIn" name="Sign in (before induction)" operaton:candidateGroups="${otSeat}" operaton:formKey="sangam:sec-health-ot-scheduling/sign-in"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <userTask id="ot_timeOut" name="Time out (before incision)" operaton:candidateGroups="${surgeonSeat}" operaton:formKey="sangam:sec-health-ot-scheduling/time-out"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>timeOutDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="ot_toGw" name="" default="sec_health_ot_f12"></exclusiveGateway>
    <endEvent id="ot_endAborted" name="Aborted at time out"></endEvent>
    <userTask id="ot_signOut" name="Sign out: counts, specimen, notes" operaton:candidateGroups="${otSeat}" operaton:formKey="sangam:sec-health-ot-scheduling/sign-out"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="ot_specimen" name="Specimen to histopathology" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>lis.specimen</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>send</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>patientName</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>spec</operaton:string></operaton:field><operaton:field name="step"><operaton:string>specimen</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="ot_recovery" name="Post-operative recovery and handover" operaton:candidateGroups="RECOVERY-NURSE" operaton:formKey="sangam:sec-health-ot-scheduling/recovery"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <endEvent id="ot_end" name="Surgery complete"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <sequenceFlow id="sec_health_ot_f1" sourceRef="ot_start" targetRef="ot_defaults"/>
