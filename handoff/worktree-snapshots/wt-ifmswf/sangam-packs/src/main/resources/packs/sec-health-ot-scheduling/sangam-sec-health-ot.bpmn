      <sequenceFlow id="sec_health_ot_f18" sourceRef="ot_withdrawCall" targetRef="ot_withdrawEnd"/>
    </subProcess>
    <subProcess id="ot_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="ot_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="ot_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="ot_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="ot_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="sec_health_ot_f19" sourceRef="ot_cancelStart" targetRef="ot_cancelKind"/>
      <sequenceFlow id="sec_health_ot_f20" sourceRef="ot_cancelKind" targetRef="ot_cancelCall"/>
      <sequenceFlow id="sec_health_ot_f21" sourceRef="ot_cancelCall" targetRef="ot_cancelEnd"/>
    </subProcess>
  </process>
