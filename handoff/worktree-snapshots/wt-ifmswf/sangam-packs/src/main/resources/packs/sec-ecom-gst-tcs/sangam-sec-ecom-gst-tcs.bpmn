<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- Monthly GST TCS. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_sec_ecom_gst_tcs" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <process id="sangam-sec-ecom-gst-tcs" name="Monthly GST TCS" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.ecom.gst-tcs</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>period</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="gt_timer" name="First of the month"><timerEventDefinition><timeCycle xsi:type="tFormalExpression">0 0 6 1 * ?</timeCycle></timerEventDefinition></startEvent>
    <serviceTask id="gt_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>period=CURRENT;taxSeat=TAX-TEAM;netSupplies=0;executionConnector=gstn.payment;executionStep=tcs-deposit;verifyApproval=false;reconcileRequired=true;executionPayloadFields=period,tcsAmount</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="gt_supplies" name="Net taxable supplies by seller GSTIN" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>erp.netSupplies</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>month</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>net</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="gt_rate" name="TCS rate (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-ecom-tcs-rate</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <serviceTask id="gt_compute" name="TCS amount" operaton:expression="${execution.setVariable('tcsAmount', netSupplies * tcsRatePct / 100)}"></serviceTask>
    <serviceTask id="gt_review_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>gt_review</operaton:string></operaton:field><operaton:field name="spec"><operaton:string>7D</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="gt_review" name="Review TCS by seller (deposit by the 10th)" operaton:candidateGroups="${taxSeat}" operaton:formKey="sangam:sec-ecom-gst-tcs/review" operaton:dueDate="${gt_reviewDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="gt_review_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>gt_review</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>taxSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="gt_review_warnEnd" name="Warned"></endEvent>
    <serviceTask id="gt_review_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>gt_review</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>taxSeat</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="gt_review_breachGw" name="Deemed?" default="sec_ecom_gst_tcs_f6"></exclusiveGateway>
    <exclusiveGateway id="gt_review_done" name=""></exclusiveGateway>
    <callActivity id="gt_deposit" name="Deposit TCS (core execution)" calledElement="sangam-core-execution" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <serviceTask id="gt_gstr8" name="File GSTR-8" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>gstn.gstr8</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>file</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>period,tcsAmount</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>gstr8</operaton:string></operaton:field><operaton:field name="step"><operaton:string>gstr8</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="gt_fileGw" name="Filed?" default="sec_ecom_gst_tcs_f18"></exclusiveGateway>
    <endEvent id="gt_end" name="Filed"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="gt_review_warn" name="SLA warning (75%)" attachedToRef="gt_review" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${gt_reviewWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="gt_review_breach" name="SLA breached" attachedToRef="gt_review" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${gt_reviewDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="sec_ecom_gst_tcs_f1" sourceRef="gt_review_warn" targetRef="gt_review_warnNotify"/>
    <sequenceFlow id="sec_ecom_gst_tcs_f2" sourceRef="gt_review_warnNotify" targetRef="gt_review_warnEnd"/>
    <sequenceFlow id="sec_ecom_gst_tcs_f3" sourceRef="gt_review_breach" targetRef="gt_review_breachAct"/>
    <sequenceFlow id="sec_ecom_gst_tcs_f4" sourceRef="gt_review_breachAct" targetRef="gt_review_breachGw"/>
    <sequenceFlow id="sec_ecom_gst_tcs_f5" name="deemed" sourceRef="gt_review_breachGw" targetRef="gt_review_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ecom_gst_tcs_f6" name="escalated" sourceRef="gt_review_breachGw" targetRef="gt_review_slaPlan"/>
    <sequenceFlow id="sec_ecom_gst_tcs_f7" sourceRef="gt_review_slaPlan" targetRef="gt_review"/>
    <sequenceFlow id="sec_ecom_gst_tcs_f8" sourceRef="gt_review" targetRef="gt_review_done"/>
    <sequenceFlow id="sec_ecom_gst_tcs_f9" sourceRef="gt_timer" targetRef="gt_defaults"/>
    <sequenceFlow id="sec_ecom_gst_tcs_f10" sourceRef="gt_defaults" targetRef="gt_supplies"/>
    <sequenceFlow id="sec_ecom_gst_tcs_f11" sourceRef="gt_supplies" targetRef="gt_rate"/>
    <sequenceFlow id="sec_ecom_gst_tcs_f12" sourceRef="gt_rate" targetRef="gt_compute"/>
    <sequenceFlow id="sec_ecom_gst_tcs_f13" sourceRef="gt_compute" targetRef="gt_review_slaPlan"/>
    <sequenceFlow id="sec_ecom_gst_tcs_f14" sourceRef="gt_review_done" targetRef="gt_deposit"/>
    <sequenceFlow id="sec_ecom_gst_tcs_f15" sourceRef="gt_deposit" targetRef="gt_gstr8"/>
    <sequenceFlow id="sec_ecom_gst_tcs_f16" sourceRef="gt_gstr8" targetRef="gt_fileGw"/>
    <sequenceFlow id="sec_ecom_gst_tcs_f17" name="error: correct" sourceRef="gt_fileGw" targetRef="gt_review_slaPlan"><conditionExpression xsi:type="tFormalExpression">${gstr8Status == 'FAILED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ecom_gst_tcs_f18" name="filed" sourceRef="gt_fileGw" targetRef="gt_end"/>
  </process>
  <bpmndi:BPMNDiagram id="sec_ecom_gst_tcs_diagram">
