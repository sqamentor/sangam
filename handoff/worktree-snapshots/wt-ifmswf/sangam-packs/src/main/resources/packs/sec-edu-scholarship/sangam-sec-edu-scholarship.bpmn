    <sequenceFlow id="sec_edu_scholarship_f13" name="RETURNED" sourceRef="sc_sanGw" targetRef="sc_l1"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'RETURNED'}</conditionExpression></sequenceFlow>
