<!-- UP-13 Return and refund. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_up13_returns" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_returnReceived" name="sangam.returnReceived"/>
  <process id="sangam-up13-returns" name="UP-13 Return and refund" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>universal.up13-returns-refunds</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>orderId,returnQty,refundAmount</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="u13_start" name="Return requested" operaton:initiator="initiator" operaton:formKey="sangam:up13-returns-refunds/request"></startEvent>
    <serviceTask id="u13_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>category=GENERAL;inspectorSeat=RETURNS-DESK;executionConnector=payment.refund;executionStep=refund;verifyApproval=false;reconcileRequired=false;executionPayloadFields=orderId,refundDue</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="u13_policy" name="Return policy (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>up13-policy</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <exclusiveGateway id="u13_gw" name="Eligible?" default="up13_returns_f5"></exclusiveGateway>
    <endEvent id="u13_endIneligible" name="Not eligible"></endEvent>
    <serviceTask id="u13_pickup" name="Arrange pickup" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>shipping.pickup</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>pickup</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>orderId</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>pickup</operaton:string></operaton:field><operaton:field name="step"><operaton:string>pickup</operaton:string></operaton:field></extensionElements></serviceTask>
    <intermediateCatchEvent id="u13_received" name="Goods received back"><messageEventDefinition messageRef="msg_sangam_returnReceived"/></intermediateCatchEvent>
    <userTask id="u13_inspect" name="Inspect returned goods" operaton:candidateGroups="${inspectorSeat}" operaton:formKey="sangam:up13-returns-refunds/inspect"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>returnDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="u13_ig" name="" default="up13_returns_f10"></exclusiveGateway>
    <serviceTask id="u13_calc" name="Refund on accepted quantity" operaton:expression="${execution.setVariable('refundDue', refundAmount * acceptedQty / returnQty * (1 - restockingFeePct / 100))}"></serviceTask>
    <endEvent id="u13_endRejected" name="Return rejected"></endEvent>
    <callActivity id="u13_refund" name="Refund once (core execution)" calledElement="sangam-core-execution" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="u13_end" name="Refunded"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <sequenceFlow id="up13_returns_f1" sourceRef="u13_start" targetRef="u13_defaults"/>
    <sequenceFlow id="up13_returns_f2" sourceRef="u13_defaults" targetRef="u13_policy"/>
    <sequenceFlow id="up13_returns_f3" sourceRef="u13_policy" targetRef="u13_gw"/>
    <sequenceFlow id="up13_returns_f4" name="no" sourceRef="u13_gw" targetRef="u13_endIneligible"><conditionExpression xsi:type="tFormalExpression">${!returnEligible}</conditionExpression></sequenceFlow>
    <sequenceFlow id="up13_returns_f5" name="yes" sourceRef="u13_gw" targetRef="u13_pickup"/>
    <sequenceFlow id="up13_returns_f6" sourceRef="u13_pickup" targetRef="u13_received"/>
    <sequenceFlow id="up13_returns_f7" sourceRef="u13_received" targetRef="u13_inspect"/>
    <sequenceFlow id="up13_returns_f8" sourceRef="u13_inspect" targetRef="u13_ig"/>
    <sequenceFlow id="up13_returns_f9" name="accept" sourceRef="u13_ig" targetRef="u13_calc"><conditionExpression xsi:type="tFormalExpression">${returnDecision == 'accept'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="up13_returns_f10" name="reject" sourceRef="u13_ig" targetRef="u13_endRejected"/>
    <sequenceFlow id="up13_returns_f11" sourceRef="u13_calc" targetRef="u13_refund"/>
    <sequenceFlow id="up13_returns_f12" sourceRef="u13_refund" targetRef="u13_end"/>
  </process>
