<!-- Motor claim. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_sec_ins_motor_claim" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_cancelCase" name="sangam.cancelCase"/>
  <message id="msg_sangam_ins_untracedReport" name="sangam.ins.untracedReport"/>
  <message id="msg_sangam_ins_vehicleRecovered" name="sangam.ins.vehicleRecovered"/>
  <message id="msg_sangam_withdrawCase" name="sangam.withdrawCase"/>
  <process id="sangam-sec-ins-motor-claim" name="Motor claim" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.ins.motor-claim</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>policyNo,vehicleRegNo,lossType,claimAmount</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="mc_start" name="Claim intimated (FNOL)" operaton:initiator="initiator" operaton:formKey="sangam:sec-ins-motor-claim/fnol"></startEvent>
    <serviceTask id="mc_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>vehicleRegNo=@policyNo;lossType=OWN_DAMAGE;claimAmount=@amount;coverActive=true;fraudScore=10;totalLoss=false;amount=@claimAmount;caseType=CLAIM;routingDecisionKey=sec-ins-claim-authority;powersDecisionKey=sec-ins-claim-powers;sanctionSla=7D;executionConnector=claims.pay;executionStep=pay-claim;reconcileRequired=true;executionPayloadFields=policyNo,amount,garageId;garageId=REIMBURSEMENT;outputTemplate=settlement-letter;appellateSeat=GRIEVANCE-CELL;handlerSeat=CLAIMS-HANDLER</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="mc_cover" name="Cover check" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>policy.coverCheck</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>check</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>policyNo,lossDate</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>cover</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="mc_coverGw" name="Policy in force?" default="sec_ins_motor_claim_f7"></exclusiveGateway>
    <serviceTask id="mc_rjCover_code" name="Reason: POLICY_NOT_IN_FORCE" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=POLICY_NOT_IN_FORCE</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="mc_rjCover_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="mc_rjCover_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="mc_fraud" name="Fraud score" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>fraud.score</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>score</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>policyNo,vehicleRegNo,claimAmount</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>fraud</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="mc_triage" name="Claim triage (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-ins-motor-triage</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <exclusiveGateway id="mc_typeGw" name="Loss type?" default="sec_ins_motor_claim_f16"></exclusiveGateway>
    <userTask id="mc_tp" name="Third-party claim: defend or settle before MACT" operaton:candidateGroups="TP-LEGAL" operaton:formKey="sangam:sec-ins-motor-claim/tp"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <endEvent id="mc_endTp" name="Handled before MACT"></endEvent>
    <eventBasedGateway id="mc_theftWait" name="Untraced report or recovery"></eventBasedGateway>
    <intermediateCatchEvent id="mc_untraced" name="Police untraced report"><messageEventDefinition messageRef="msg_sangam_ins_untracedReport"/></intermediateCatchEvent>
    <intermediateCatchEvent id="mc_recovered" name="Vehicle recovered"><messageEventDefinition messageRef="msg_sangam_ins_vehicleRecovered"/></intermediateCatchEvent>
    <userTask id="mc_subrogation" name="Collect RC transfer, keys and subrogation letter" operaton:candidateGroups="${handlerSeat}" operaton:formKey="sangam:sec-ins-motor-claim/subrogation"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="mc_survGw" name="Surveyor required?" default="sec_ins_motor_claim_f38"></exclusiveGateway>
    <serviceTask id="mc_appoint_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>mc_appoint</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${surveyorAppointSpec}</operaton:expression></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="mc_appoint" name="Appoint surveyor (24 hours)" operaton:candidateGroups="${handlerSeat}" operaton:formKey="sangam:sec-ins-motor-claim/appoint" operaton:dueDate="${mc_appointDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="mc_appoint_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>mc_appoint</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>handlerSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="mc_appoint_warnEnd" name="Warned"></endEvent>
    <serviceTask id="mc_appoint_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>mc_appoint</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>handlerSeat</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="mc_appoint_breachGw" name="Deemed?" default="sec_ins_motor_claim_f23"></exclusiveGateway>
    <exclusiveGateway id="mc_appoint_done" name=""></exclusiveGateway>
    <serviceTask id="mc_survey_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>mc_survey</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${surveyReportSpec}</operaton:expression></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="mc_survey" name="Survey report (15 days)" operaton:candidateGroups="${surveyorGroup}" operaton:formKey="sangam:sec-ins-motor-claim/survey" operaton:dueDate="${mc_surveyDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="mc_survey_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>mc_survey</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>surveyorGroup</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="mc_survey_warnEnd" name="Warned"></endEvent>
    <serviceTask id="mc_survey_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>mc_survey</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>surveyorGroup</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="mc_survey_breachGw" name="Deemed?" default="sec_ins_motor_claim_f32"></exclusiveGateway>
    <exclusiveGateway id="mc_survey_done" name=""></exclusiveGateway>
    <serviceTask id="mc_survSeat" name="Surveyor" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>surveyorGroup=@surveyorId</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="mc_siuGw" name="SIU referral?" default="sec_ins_motor_claim_f41"></exclusiveGateway>
    <userTask id="mc_siu" name="SIU investigation" operaton:candidateGroups="SIU" operaton:formKey="sangam:sec-ins-motor-claim/siu"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>siuDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <userTask id="mc_assess" name="Assess claim" operaton:candidateGroups="${handlerSeat}" operaton:formKey="sangam:sec-ins-motor-claim/assess"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>assessDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="mc_siuRes" name="" default="sec_ins_motor_claim_f45"></exclusiveGateway>
    <callActivity id="mc_rj_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="mc_rj_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <callActivity id="mc_sanction" name="Settlement sanction (core sanction, 7 days)" calledElement="sangam-core-sanction" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <exclusiveGateway id="mc_assGw" name="" default="sec_ins_motor_claim_f48"></exclusiveGateway>
    <callActivity id="mc_pay" name="Pay garage / insured (core execution)" calledElement="sangam-core-execution" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <exclusiveGateway id="mc_sanGw" name="sanctionOutcome?" default="sec_ins_motor_claim_f51"></exclusiveGateway>
    <serviceTask id="mc_salvage" name="Dispose salvage" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>salvage.auction</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>auction</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>vehicleRegNo</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>salvage</operaton:string></operaton:field><operaton:field name="step"><operaton:string>salvage</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="mc_close" name="Settlement letter and closure (core)" calledElement="sangam-core-closure" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <exclusiveGateway id="mc_salvOptGw" name="Total loss?" default="sec_ins_motor_claim_f54"></exclusiveGateway>
    <exclusiveGateway id="mc_salvOptMerge" name=""></exclusiveGateway>
    <serviceTask id="mc_payFailed" name="Payment failed" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>claim-payment-failed</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>inapp</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>initiatorSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="mc_payGw" name="executionOutcome?" default="sec_ins_motor_claim_f57"></exclusiveGateway>
    <endEvent id="mc_end" name="Settled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="mc_appoint_warn" name="SLA warning (75%)" attachedToRef="mc_appoint" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${mc_appointWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="mc_appoint_breach" name="SLA breached" attachedToRef="mc_appoint" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${mc_appointDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="mc_survey_warn" name="SLA warning (75%)" attachedToRef="mc_survey" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${mc_surveyWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="mc_survey_breach" name="SLA breached" attachedToRef="mc_survey" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${mc_surveyDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="sec_ins_motor_claim_f1" sourceRef="mc_start" targetRef="mc_defaults"/>
    <sequenceFlow id="sec_ins_motor_claim_f2" sourceRef="mc_defaults" targetRef="mc_cover"/>
    <sequenceFlow id="sec_ins_motor_claim_f3" sourceRef="mc_cover" targetRef="mc_coverGw"/>
    <sequenceFlow id="sec_ins_motor_claim_f4" sourceRef="mc_rjCover_reject" targetRef="mc_rjCover_endRejected"/>
    <sequenceFlow id="sec_ins_motor_claim_f5" sourceRef="mc_rjCover_code" targetRef="mc_rjCover_reject"/>
    <sequenceFlow id="sec_ins_motor_claim_f6" name="no" sourceRef="mc_coverGw" targetRef="mc_rjCover_code"><conditionExpression xsi:type="tFormalExpression">${!coverActive}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ins_motor_claim_f7" name="yes" sourceRef="mc_coverGw" targetRef="mc_fraud"/>
    <sequenceFlow id="sec_ins_motor_claim_f8" sourceRef="mc_fraud" targetRef="mc_triage"/>
    <sequenceFlow id="sec_ins_motor_claim_f9" sourceRef="mc_triage" targetRef="mc_typeGw"/>
    <sequenceFlow id="sec_ins_motor_claim_f10" name="third party" sourceRef="mc_typeGw" targetRef="mc_tp"><conditionExpression xsi:type="tFormalExpression">${lossType == 'THIRD_PARTY'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ins_motor_claim_f11" sourceRef="mc_tp" targetRef="mc_endTp"/>
    <sequenceFlow id="sec_ins_motor_claim_f12" name="theft" sourceRef="mc_typeGw" targetRef="mc_theftWait"><conditionExpression xsi:type="tFormalExpression">${lossType == 'THEFT'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ins_motor_claim_f13" sourceRef="mc_theftWait" targetRef="mc_untraced"/>
    <sequenceFlow id="sec_ins_motor_claim_f14" sourceRef="mc_theftWait" targetRef="mc_recovered"/>
    <sequenceFlow id="sec_ins_motor_claim_f15" sourceRef="mc_untraced" targetRef="mc_subrogation"/>
    <sequenceFlow id="sec_ins_motor_claim_f16" name="own damage" sourceRef="mc_typeGw" targetRef="mc_survGw"/>
    <sequenceFlow id="sec_ins_motor_claim_f17" sourceRef="mc_recovered" targetRef="mc_survGw"/>
    <sequenceFlow id="sec_ins_motor_claim_f18" sourceRef="mc_appoint_warn" targetRef="mc_appoint_warnNotify"/>
    <sequenceFlow id="sec_ins_motor_claim_f19" sourceRef="mc_appoint_warnNotify" targetRef="mc_appoint_warnEnd"/>
    <sequenceFlow id="sec_ins_motor_claim_f20" sourceRef="mc_appoint_breach" targetRef="mc_appoint_breachAct"/>
    <sequenceFlow id="sec_ins_motor_claim_f21" sourceRef="mc_appoint_breachAct" targetRef="mc_appoint_breachGw"/>
    <sequenceFlow id="sec_ins_motor_claim_f22" name="deemed" sourceRef="mc_appoint_breachGw" targetRef="mc_appoint_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ins_motor_claim_f23" name="escalated" sourceRef="mc_appoint_breachGw" targetRef="mc_appoint_slaPlan"/>
    <sequenceFlow id="sec_ins_motor_claim_f24" sourceRef="mc_appoint_slaPlan" targetRef="mc_appoint"/>
    <sequenceFlow id="sec_ins_motor_claim_f25" sourceRef="mc_appoint" targetRef="mc_appoint_done"/>
    <sequenceFlow id="sec_ins_motor_claim_f26" name="yes" sourceRef="mc_survGw" targetRef="mc_appoint_slaPlan"><conditionExpression xsi:type="tFormalExpression">${surveyorRequired}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ins_motor_claim_f27" sourceRef="mc_survey_warn" targetRef="mc_survey_warnNotify"/>
    <sequenceFlow id="sec_ins_motor_claim_f28" sourceRef="mc_survey_warnNotify" targetRef="mc_survey_warnEnd"/>
    <sequenceFlow id="sec_ins_motor_claim_f29" sourceRef="mc_survey_breach" targetRef="mc_survey_breachAct"/>
    <sequenceFlow id="sec_ins_motor_claim_f30" sourceRef="mc_survey_breachAct" targetRef="mc_survey_breachGw"/>
    <sequenceFlow id="sec_ins_motor_claim_f31" name="deemed" sourceRef="mc_survey_breachGw" targetRef="mc_survey_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ins_motor_claim_f32" name="escalated" sourceRef="mc_survey_breachGw" targetRef="mc_survey_slaPlan"/>
    <sequenceFlow id="sec_ins_motor_claim_f33" sourceRef="mc_survey_slaPlan" targetRef="mc_survey"/>
    <sequenceFlow id="sec_ins_motor_claim_f34" sourceRef="mc_survey" targetRef="mc_survey_done"/>
    <sequenceFlow id="sec_ins_motor_claim_f35" sourceRef="mc_appoint_done" targetRef="mc_survSeat"/>
    <sequenceFlow id="sec_ins_motor_claim_f36" sourceRef="mc_survSeat" targetRef="mc_survey_slaPlan"/>
    <sequenceFlow id="sec_ins_motor_claim_f37" sourceRef="mc_survey_done" targetRef="mc_siuGw"/>
    <sequenceFlow id="sec_ins_motor_claim_f38" name="below the surveyor threshold: desk assessment" sourceRef="mc_survGw" targetRef="mc_siuGw"/>
    <sequenceFlow id="sec_ins_motor_claim_f39" sourceRef="mc_subrogation" targetRef="mc_siuGw"/>
    <sequenceFlow id="sec_ins_motor_claim_f40" name="yes" sourceRef="mc_siuGw" targetRef="mc_siu"><conditionExpression xsi:type="tFormalExpression">${siuReferral}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ins_motor_claim_f41" name="no" sourceRef="mc_siuGw" targetRef="mc_assess"/>
    <sequenceFlow id="sec_ins_motor_claim_f42" sourceRef="mc_siu" targetRef="mc_siuRes"/>
    <sequenceFlow id="sec_ins_motor_claim_f43" name="genuine" sourceRef="mc_siuRes" targetRef="mc_assess"><conditionExpression xsi:type="tFormalExpression">${siuDecision == 'genuine'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ins_motor_claim_f44" sourceRef="mc_rj_reject" targetRef="mc_rj_endRejected"/>
    <sequenceFlow id="sec_ins_motor_claim_f45" name="fraud" sourceRef="mc_siuRes" targetRef="mc_rj_reject"/>
    <sequenceFlow id="sec_ins_motor_claim_f46" sourceRef="mc_assess" targetRef="mc_assGw"/>
    <sequenceFlow id="sec_ins_motor_claim_f47" name="approve" sourceRef="mc_assGw" targetRef="mc_sanction"><conditionExpression xsi:type="tFormalExpression">${assessDecision == 'approve'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ins_motor_claim_f48" name="reject" sourceRef="mc_assGw" targetRef="mc_rj_reject"/>
    <sequenceFlow id="sec_ins_motor_claim_f49" name="SANCTIONED" sourceRef="mc_sanGw" targetRef="mc_pay"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ins_motor_claim_f50" name="RETURNED" sourceRef="mc_sanGw" targetRef="mc_assess"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'RETURNED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ins_motor_claim_f51" name="otherwise" sourceRef="mc_sanGw" targetRef="mc_rj_reject"/>
    <sequenceFlow id="sec_ins_motor_claim_f52" sourceRef="mc_sanction" targetRef="mc_sanGw"/>
    <sequenceFlow id="sec_ins_motor_claim_f53" name="yes" sourceRef="mc_salvOptGw" targetRef="mc_salvage"><conditionExpression xsi:type="tFormalExpression">${totalLoss}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ins_motor_claim_f54" name="no" sourceRef="mc_salvOptGw" targetRef="mc_salvOptMerge"/>
    <sequenceFlow id="sec_ins_motor_claim_f55" sourceRef="mc_salvage" targetRef="mc_salvOptMerge"/>
    <sequenceFlow id="sec_ins_motor_claim_f56" name="DONE" sourceRef="mc_payGw" targetRef="mc_salvOptGw"><conditionExpression xsi:type="tFormalExpression">${executionOutcome == 'DONE'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ins_motor_claim_f57" name="otherwise" sourceRef="mc_payGw" targetRef="mc_payFailed"/>
    <sequenceFlow id="sec_ins_motor_claim_f58" sourceRef="mc_pay" targetRef="mc_payGw"/>
