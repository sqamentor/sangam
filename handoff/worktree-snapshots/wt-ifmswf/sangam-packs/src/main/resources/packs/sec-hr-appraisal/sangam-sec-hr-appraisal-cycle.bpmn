      <bpmndi:BPMNEdge id="sec_hr_appraisal_cycle_f5_di" bpmnElement="sec_hr_appraisal_cycle_f5"><di:waypoint x="895" y="95"/><di:waypoint x="895" y="128"/><di:waypoint x="730" y="128"/><di:waypoint x="730" y="110"/></bpmndi:BPMNEdge>
