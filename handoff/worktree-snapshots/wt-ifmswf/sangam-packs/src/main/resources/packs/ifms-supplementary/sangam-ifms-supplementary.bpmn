<!-- Supplementary demand. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_ifms_supplementary" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_cancelCase" name="sangam.cancelCase"/>
  <message id="msg_sangam_withdrawCase" name="sangam.withdrawCase"/>
  <process id="sangam-ifms-supplementary" name="Supplementary demand" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.ifms.supplementary</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>headOfAccount,amount,supplementaryKind</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="sd_start" name="Proposal" operaton:initiator="initiator" operaton:formKey="sangam:ifms-supplementary/proposal"></startEvent>
    <serviceTask id="sd_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>amount=0;supplementaryKind=CASH;newServiceFlag=false;faSeat=FA-1;ledgerId=BUDGET;caseType=SUPPLEMENTARY;routingDecisionKey=ifms-supplementary-authority;powersDecisionKey=ifms-supplementary-powers;scrutinySeat=PRAO-1;referToTenant=finance;referralQuestion=Supplementary demand;executionConnector=ledger.adjust;executionStep=adjust;reconcileRequired=false;outputTemplate=supplementary-order;appealAllowed=false</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="sd_newService" name="New service / instrument (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>ifms-new-service</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <serviceTask id="sd_fa_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>sd_fa</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="sd_fa" name="FA examination" operaton:candidateGroups="${faSeat}" operaton:formKey="sangam:ifms-supplementary/fa" operaton:dueDate="${sd_faDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>faDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="sd_fa_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>sd_fa</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>faSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="sd_fa_warnEnd" name="Warned"></endEvent>
    <serviceTask id="sd_fa_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>sd_fa</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>faSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>faDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="sd_fa_breachGw" name="Deemed?" default="ifms_supplementary_f6"></exclusiveGateway>
    <exclusiveGateway id="sd_fa_done" name=""></exclusiveGateway>
    <exclusiveGateway id="sd_cfGw" name="Urgent: Contingency Fund advance?" default="ifms_supplementary_f17"></exclusiveGateway>
    <serviceTask id="sd_cf" name="Contingency Fund advance requested (recoup by supplementary)" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>cf-advance-requested</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>inapp</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>faSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="sd_dea" name="Budget division batch (core referral)" calledElement="sangam-core-referral" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <callActivity id="sd_sanction" name="Approval (core)" calledElement="sangam-core-sanction" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <callActivity id="sd_post" name="Ledger ADJUST (core execution)" calledElement="sangam-core-execution" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <callActivity id="sd_close" name="Closure (core)" calledElement="sangam-core-closure" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <callActivity id="sd_rj_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="sd_rj_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <exclusiveGateway id="sd_faGw" name="" default="ifms_supplementary_f15"></exclusiveGateway>
    <exclusiveGateway id="sd_refGw" name="" default="ifms_supplementary_f21"></exclusiveGateway>
    <exclusiveGateway id="sd_sanGw" name="sanctionOutcome?" default="ifms_supplementary_f23"></exclusiveGateway>
    <exclusiveGateway id="sd_exGw" name="executionOutcome?" default="ifms_supplementary_f26"></exclusiveGateway>
    <endEvent id="sd_end" name="Closed"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="sd_fa_warn" name="SLA warning (75%)" attachedToRef="sd_fa" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${sd_faWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="sd_fa_breach" name="SLA breached" attachedToRef="sd_fa" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${sd_faDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="ifms_supplementary_f1" sourceRef="sd_fa_warn" targetRef="sd_fa_warnNotify"/>
    <sequenceFlow id="ifms_supplementary_f2" sourceRef="sd_fa_warnNotify" targetRef="sd_fa_warnEnd"/>
    <sequenceFlow id="ifms_supplementary_f3" sourceRef="sd_fa_breach" targetRef="sd_fa_breachAct"/>
    <sequenceFlow id="ifms_supplementary_f4" sourceRef="sd_fa_breachAct" targetRef="sd_fa_breachGw"/>
    <sequenceFlow id="ifms_supplementary_f5" name="deemed" sourceRef="sd_fa_breachGw" targetRef="sd_fa_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_supplementary_f6" name="escalated" sourceRef="sd_fa_breachGw" targetRef="sd_fa_slaPlan"/>
    <sequenceFlow id="ifms_supplementary_f7" sourceRef="sd_fa_slaPlan" targetRef="sd_fa"/>
    <sequenceFlow id="ifms_supplementary_f8" sourceRef="sd_fa" targetRef="sd_fa_done"/>
    <sequenceFlow id="ifms_supplementary_f9" sourceRef="sd_rj_reject" targetRef="sd_rj_endRejected"/>
    <sequenceFlow id="ifms_supplementary_f10" sourceRef="sd_start" targetRef="sd_defaults"/>
    <sequenceFlow id="ifms_supplementary_f11" sourceRef="sd_defaults" targetRef="sd_newService"/>
    <sequenceFlow id="ifms_supplementary_f12" sourceRef="sd_newService" targetRef="sd_fa_slaPlan"/>
    <sequenceFlow id="ifms_supplementary_f13" sourceRef="sd_fa_done" targetRef="sd_faGw"/>
    <sequenceFlow id="ifms_supplementary_f14" name="not concurred" sourceRef="sd_faGw" targetRef="sd_rj_reject"><conditionExpression xsi:type="tFormalExpression">${faDecision == 'faNotConcur'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_supplementary_f15" name="concurred" sourceRef="sd_faGw" targetRef="sd_cfGw"/>
    <sequenceFlow id="ifms_supplementary_f16" name="urgent" sourceRef="sd_cfGw" targetRef="sd_cf"><conditionExpression xsi:type="tFormalExpression">${newServiceRoute == 'CONTINGENCY_FUND'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_supplementary_f17" name="batch" sourceRef="sd_cfGw" targetRef="sd_dea"/>
    <sequenceFlow id="ifms_supplementary_f18" sourceRef="sd_cf" targetRef="sd_dea"/>
    <sequenceFlow id="ifms_supplementary_f19" sourceRef="sd_dea" targetRef="sd_refGw"/>
    <sequenceFlow id="ifms_supplementary_f20" name="included" sourceRef="sd_refGw" targetRef="sd_sanction"><conditionExpression xsi:type="tFormalExpression">${referralDecision == 'faConcur'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_supplementary_f21" name="not included" sourceRef="sd_refGw" targetRef="sd_rj_reject"/>
    <sequenceFlow id="ifms_supplementary_f22" name="SANCTIONED" sourceRef="sd_sanGw" targetRef="sd_post"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_supplementary_f23" name="otherwise" sourceRef="sd_sanGw" targetRef="sd_rj_reject"/>
    <sequenceFlow id="ifms_supplementary_f24" sourceRef="sd_sanction" targetRef="sd_sanGw"/>
    <sequenceFlow id="ifms_supplementary_f25" name="DONE" sourceRef="sd_exGw" targetRef="sd_close"><conditionExpression xsi:type="tFormalExpression">${executionOutcome == 'DONE'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_supplementary_f26" name="otherwise" sourceRef="sd_exGw" targetRef="sd_rj_reject"/>
    <sequenceFlow id="ifms_supplementary_f27" sourceRef="sd_post" targetRef="sd_exGw"/>
    <sequenceFlow id="ifms_supplementary_f28" sourceRef="sd_close" targetRef="sd_end"/>
    <subProcess id="sd_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="sd_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="sd_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="sd_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="sd_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="ifms_supplementary_f29" sourceRef="sd_withdrawStart" targetRef="sd_withdrawKind"/>
      <sequenceFlow id="ifms_supplementary_f30" sourceRef="sd_withdrawKind" targetRef="sd_withdrawCall"/>
      <sequenceFlow id="ifms_supplementary_f31" sourceRef="sd_withdrawCall" targetRef="sd_withdrawEnd"/>
    </subProcess>
    <subProcess id="sd_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="sd_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="sd_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="sd_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="sd_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="ifms_supplementary_f32" sourceRef="sd_cancelStart" targetRef="sd_cancelKind"/>
      <sequenceFlow id="ifms_supplementary_f33" sourceRef="sd_cancelKind" targetRef="sd_cancelCall"/>
      <sequenceFlow id="ifms_supplementary_f34" sourceRef="sd_cancelCall" targetRef="sd_cancelEnd"/>
    </subProcess>
  </process>
