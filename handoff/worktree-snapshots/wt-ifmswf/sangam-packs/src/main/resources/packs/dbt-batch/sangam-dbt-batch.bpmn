<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- DBT batch round. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_dbt_batch" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <process id="sangam-dbt-batch" name="DBT batch round" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <documentation>Parent of the GP-09 pattern: no multi-instance.</documentation>
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.dbt.batch</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>schemeId,period,batchTotal</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="db_start" name="Batch created" operaton:initiator="initiator" operaton:formKey="sangam:dbt-batch/batch"></startEvent>
    <serviceTask id="db_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>caseType=GRANT;batchTotal=0;period=current;routingDecisionKey=p3-sanction-authority;amount=0;retryReasons=ACCOUNT_INVALID,ACCOUNT_CLOSED,AADHAAR_NOT_SEEDED,NAME_MISMATCH;dbtCellSeat=DBT-CELL</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="db_load" name="Load sanctioned beneficiary list" operaton:class="org.sangam.packs.core.BatchDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>LOAD</operaton:string></operaton:field><operaton:field name="connector"><operaton:string>dbt.beneficiaryList</operaton:string></operaton:field><operaton:field name="sampleSize"><operaton:string>5</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="db_sanction" name="Batch sanction (core)" calledElement="sangam-core-sanction" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <serviceTask id="db_open" name="Open round" operaton:class="org.sangam.packs.core.BatchDelegate"><extensionElements><operaton:field name="op"><operaton:string>OPEN</operaton:string></operaton:field><operaton:field name="itemsVar"><operaton:string>items</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="db_fanOut" name="Start one instance per item (chunk)" operaton:class="org.sangam.packs.core.BatchDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>FAN_OUT</operaton:string></operaton:field><operaton:field name="itemsVar"><operaton:string>items</operaton:string></operaton:field><operaton:field name="childProcessKey"><operaton:string>sangam-dbt-beneficiary-payment</operaton:string></operaton:field><operaton:field name="chunkSize"><operaton:string>200</operaton:string></operaton:field><operaton:field name="inherit"><operaton:string>schemeId,period,approvedPayloadHash</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="db_fanGw" name="All started?" default="dbt_batch_f7"></exclusiveGateway>
    <intermediateCatchEvent id="db_poll" name="Poll aggregate"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">PT5M</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <serviceTask id="db_aggregate" name="Aggregate outcomes" operaton:class="org.sangam.packs.core.BatchDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>AGGREGATE</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="db_doneGw" name="Round complete?" default="dbt_batch_f14"></exclusiveGateway>
    <exclusiveGateway id="db_sanGw" name="Sanctioned?" default="dbt_batch_f13"></exclusiveGateway>
    <endEvent id="db_endNotSanctioned" name="Not sanctioned"></endEvent>
    <exclusiveGateway id="db_failGw" name="Failures?" default="dbt_batch_f22"></exclusiveGateway>
    <userTask id="db_review" name="Review failed records by reason" operaton:candidateGroups="${dbtCellSeat}" operaton:formKey="sangam:dbt-batch/review-failures"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>roundDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="db_nextRound" name="Next round: only the failures" operaton:class="org.sangam.packs.core.BatchDelegate"><extensionElements><operaton:field name="op"><operaton:string>NEXT_ROUND</operaton:string></operaton:field><operaton:field name="retryReasons"><operaton:expression>${retryReasons}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="db_roundGw" name="" default="dbt_batch_f21"></exclusiveGateway>
    <exclusiveGateway id="db_retryGw" name="Anything to resend?" default="dbt_batch_f20"></exclusiveGateway>
    <serviceTask id="db_report" name="Batch report" operaton:class="org.sangam.packs.core.DocumentDelegate"><extensionElements><operaton:field name="template"><operaton:string>dbt-batch-report</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="db_end" name="Batch closed"></endEvent>
    <sequenceFlow id="dbt_batch_f1" sourceRef="db_start" targetRef="db_defaults"/>
    <sequenceFlow id="dbt_batch_f2" sourceRef="db_defaults" targetRef="db_load"/>
    <sequenceFlow id="dbt_batch_f3" sourceRef="db_load" targetRef="db_sanction"/>
    <sequenceFlow id="dbt_batch_f4" sourceRef="db_open" targetRef="db_fanOut"/>
    <sequenceFlow id="dbt_batch_f5" sourceRef="db_fanOut" targetRef="db_fanGw"/>
    <sequenceFlow id="dbt_batch_f6" name="next chunk" sourceRef="db_fanGw" targetRef="db_fanOut"><conditionExpression xsi:type="tFormalExpression">${!fanOutDone}</conditionExpression></sequenceFlow>
    <sequenceFlow id="dbt_batch_f7" name="all started" sourceRef="db_fanGw" targetRef="db_poll"/>
    <sequenceFlow id="dbt_batch_f8" sourceRef="db_poll" targetRef="db_aggregate"/>
    <sequenceFlow id="dbt_batch_f9" sourceRef="db_aggregate" targetRef="db_doneGw"/>
    <sequenceFlow id="dbt_batch_f10" name="not yet" sourceRef="db_doneGw" targetRef="db_poll"><conditionExpression xsi:type="tFormalExpression">${!batchComplete}</conditionExpression></sequenceFlow>
    <sequenceFlow id="dbt_batch_f11" sourceRef="db_sanction" targetRef="db_sanGw"/>
    <sequenceFlow id="dbt_batch_f12" name="sanctioned" sourceRef="db_sanGw" targetRef="db_open"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="dbt_batch_f13" name="not sanctioned" sourceRef="db_sanGw" targetRef="db_endNotSanctioned"/>
    <sequenceFlow id="dbt_batch_f14" name="complete" sourceRef="db_doneGw" targetRef="db_failGw"/>
    <sequenceFlow id="dbt_batch_f15" name="GP-49" sourceRef="db_failGw" targetRef="db_review"><conditionExpression xsi:type="tFormalExpression">${batchFailed &gt; 0}</conditionExpression></sequenceFlow>
    <sequenceFlow id="dbt_batch_f16" sourceRef="db_review" targetRef="db_roundGw"/>
    <sequenceFlow id="dbt_batch_f17" name="resend failures" sourceRef="db_roundGw" targetRef="db_nextRound"><conditionExpression xsi:type="tFormalExpression">${roundDecision == 'resubmit'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="dbt_batch_f18" sourceRef="db_nextRound" targetRef="db_retryGw"/>
    <sequenceFlow id="dbt_batch_f19" name="resend" sourceRef="db_retryGw" targetRef="db_fanOut"><conditionExpression xsi:type="tFormalExpression">${retryCount &gt; 0}</conditionExpression></sequenceFlow>
    <sequenceFlow id="dbt_batch_f20" name="nothing retryable" sourceRef="db_retryGw" targetRef="db_report"/>
    <sequenceFlow id="dbt_batch_f21" name="close" sourceRef="db_roundGw" targetRef="db_report"/>
    <sequenceFlow id="dbt_batch_f22" name="all paid" sourceRef="db_failGw" targetRef="db_report"/>
    <sequenceFlow id="dbt_batch_f23" sourceRef="db_report" targetRef="db_end"/>
  </process>
  <bpmndi:BPMNDiagram id="dbt_batch_diagram">
    <bpmndi:BPMNPlane id="dbt_batch_plane" bpmnElement="sangam-dbt-batch">
      <bpmndi:BPMNShape id="db_start_di" bpmnElement="db_start"><dc:Bounds x="52" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="db_defaults_di" bpmnElement="db_defaults"><dc:Bounds x="185" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="db_load_di" bpmnElement="db_load"><dc:Bounds x="350" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="db_sanction_di" bpmnElement="db_sanction"><dc:Bounds x="515" y="30" width="100" height="80"/></bpmndi:BPMNShape>
