      <bpmndi:BPMNShape id="db_fanOut_di" bpmnElement="db_fanOut"><dc:Bounds x="1010" y="155" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="db_fanGw_di" bpmnElement="db_fanGw"><dc:Bounds x="1200" y="170" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="db_poll_di" bpmnElement="db_poll"><dc:Bounds x="1372" y="177" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="db_aggregate_di" bpmnElement="db_aggregate"><dc:Bounds x="1505" y="155" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="db_doneGw_di" bpmnElement="db_doneGw"><dc:Bounds x="1695" y="170" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="db_sanGw_di" bpmnElement="db_sanGw"><dc:Bounds x="705" y="45" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="db_endNotSanctioned_di" bpmnElement="db_endNotSanctioned"><dc:Bounds x="877" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="db_failGw_di" bpmnElement="db_failGw"><dc:Bounds x="1860" y="170" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="db_review_di" bpmnElement="db_review"><dc:Bounds x="2000" y="155" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="db_nextRound_di" bpmnElement="db_nextRound"><dc:Bounds x="2330" y="155" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="db_roundGw_di" bpmnElement="db_roundGw"><dc:Bounds x="2190" y="170" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="db_retryGw_di" bpmnElement="db_retryGw"><dc:Bounds x="2520" y="170" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="db_report_di" bpmnElement="db_report"><dc:Bounds x="2660" y="155" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="db_end_di" bpmnElement="db_end"><dc:Bounds x="2857" y="177" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="dbt_batch_f1_di" bpmnElement="dbt_batch_f1"><di:waypoint x="88" y="70"/><di:waypoint x="185" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="dbt_batch_f2_di" bpmnElement="dbt_batch_f2"><di:waypoint x="285" y="70"/><di:waypoint x="350" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="dbt_batch_f3_di" bpmnElement="dbt_batch_f3"><di:waypoint x="450" y="70"/><di:waypoint x="515" y="70"/></bpmndi:BPMNEdge>
