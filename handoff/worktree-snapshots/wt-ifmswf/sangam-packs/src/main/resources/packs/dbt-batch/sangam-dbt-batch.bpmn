      <bpmndi:BPMNEdge id="dbt_batch_f12_di" bpmnElement="dbt_batch_f12"><di:waypoint x="755" y="70"/><di:waypoint x="800" y="70"/><di:waypoint x="800" y="195"/><di:waypoint x="845" y="195"/></bpmndi:BPMNEdge>
