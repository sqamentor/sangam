  <process id="sangam-up18-capa" name="UP-18 CAPA" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>universal.up18-capa</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>description,rootCause,capaActions</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="u18_start" name="Non-conformance" operaton:initiator="initiator" operaton:formKey="sangam:up18-capa/nc"></startEvent>
    <serviceTask id="u18_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>effectivenessDelay=P30D;qaSeat=QA-LEAD;caseType=CAPA;amount=0;routingDecisionKey=up18-approver;rootCause=;capaActions=;appealAllowed=false</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="u18_investigate" name="Investigate root cause" operaton:candidateGroups="${qaSeat}" operaton:formKey="sangam:up18-capa/investigate"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <callActivity id="u18_approve" name="Approve CAPA (core sanction)" calledElement="sangam-core-sanction" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <userTask id="u18_implement" name="Implement actions" operaton:candidateGroups="${qaSeat}" operaton:formKey="sangam:up18-capa/implement"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="u18_sanGw" name="sanctionOutcome?" default="up18_capa_f5"></exclusiveGateway>
    <intermediateCatchEvent id="u18_wait" name="Effectiveness period"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">${effectivenessDelay}</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <userTask id="u18_check" name="Effectiveness check" operaton:candidateGroups="QA-HEAD" operaton:formKey="sangam:up18-capa/effectiveness"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>effectiveDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="u18_gw" name="" default="up18_capa_f11"></exclusiveGateway>
    <serviceTask id="u18_sign" name="E-signature on closure" operaton:class="org.sangam.packs.core.SignatureDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="op"><operaton:string>REQUEST</operaton:string></operaton:field><operaton:field name="purpose"><operaton:string>capa-closure</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="u18_end" name="Closed"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <sequenceFlow id="up18_capa_f1" sourceRef="u18_start" targetRef="u18_defaults"/>
    <sequenceFlow id="up18_capa_f2" sourceRef="u18_defaults" targetRef="u18_investigate"/>
    <sequenceFlow id="up18_capa_f3" sourceRef="u18_investigate" targetRef="u18_approve"/>
    <sequenceFlow id="up18_capa_f4" name="SANCTIONED" sourceRef="u18_sanGw" targetRef="u18_implement"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="up18_capa_f5" name="otherwise" sourceRef="u18_sanGw" targetRef="u18_investigate"/>
    <sequenceFlow id="up18_capa_f6" sourceRef="u18_approve" targetRef="u18_sanGw"/>
    <sequenceFlow id="up18_capa_f7" sourceRef="u18_implement" targetRef="u18_wait"/>
    <sequenceFlow id="up18_capa_f8" sourceRef="u18_wait" targetRef="u18_check"/>
    <sequenceFlow id="up18_capa_f9" sourceRef="u18_check" targetRef="u18_gw"/>
    <sequenceFlow id="up18_capa_f10" name="recurrence: investigate again" sourceRef="u18_gw" targetRef="u18_investigate"><conditionExpression xsi:type="tFormalExpression">${effectiveDecision == 'no'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="up18_capa_f11" name="effective" sourceRef="u18_gw" targetRef="u18_sign"/>
    <sequenceFlow id="up18_capa_f12" sourceRef="u18_sign" targetRef="u18_end"/>
  </process>
