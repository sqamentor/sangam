  <process id="sangam-ifms-advance" name="Employee advance" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.ifms.loans-advances</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>advanceKind,amount,instalments</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="av_start" name="Application" operaton:initiator="initiator" operaton:formKey="sangam:ifms-loans-advances/application"></startEvent>
    <serviceTask id="av_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>amount=0;instalments=1;advanceKind=COMPUTER;basicPay=0;billType=HBA;caseType=ADVANCE;routingDecisionKey=ifms-advance-authority;powersDecisionKey=ifms-advance-powers;scrutinySeat=DDO-1;appealAllowed=false;outputTemplate=advance-sanction;ledgerId=RECOVERY</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="av_rules" name="Advance limits (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>ifms-advance-limits</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <callActivity id="av_sanction" name="Sanction (core)" calledElement="sangam-core-sanction" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <callActivity id="av_rj_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="av_rj_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <callActivity id="av_bill" name="Advance bill" calledElement="sangam-ifms-bill" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <serviceTask id="av_demand" name="Recovery schedule (RECEIVABLE demand)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>ledger.allocate</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>allocate</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>ledgerId,amount,instalments</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>dem</operaton:string></operaton:field><operaton:field name="step"><operaton:string>demand</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="av_okGw" name="" default="ifms_advance_f8"></exclusiveGateway>
