  <message id="msg_sangam_hcx_enhancement" name="sangam.hcx.enhancement"/>
  <message id="msg_sangam_hcx_queryReply" name="sangam.hcx.queryReply"/>
  <message id="msg_sangam_withdrawCase" name="sangam.withdrawCase"/>
  <process id="sangam-sec-ins-health-claim" name="Health claim" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.ins.health-claim</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>policyNo,patientName,hospitalId,estimatedCost</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="hc_start" name="Pre-authorisation / claim request" operaton:initiator="initiator" operaton:formKey="sangam:sec-ins-health-claim/request"></startEvent>
    <serviceTask id="hc_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>patientName=@policyNo;hospitalId=NETWORK-HOSP-1;admissionType=EMERGENCY;estimatedCost=@amount;coverActive=true;networkHospital=true;tpaSeat=TPA-DOCTOR;executionConnector=hcx.settle;executionStep=settle;verifyApproval=false;reconcileRequired=false;executionPayloadFields=policyNo,hospitalId,approvedAmount;approvedAmount=@estimatedCost;appellateSeat=CLAIMS-REVIEW-COMMITTEE</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="hc_tat" name="Health claim timelines (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-ins-health-tat</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <serviceTask id="hc_cover" name="Cover and NHCX eligibility" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>hcx.eligibility</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>eligibility</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>policyNo,hospitalId</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>cover</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="hc_coverGw" name="Covered?" default="sec_ins_health_claim_f8"></exclusiveGateway>
    <serviceTask id="hc_rjCover_code" name="Reason: NOT_COVERED" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=NOT_COVERED</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="hc_rjCover_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="hc_rjCover_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <exclusiveGateway id="hc_netGw" name="Cashless at a network hospital?" default="sec_ins_health_claim_f48"></exclusiveGateway>
    <serviceTask id="hc_preauth_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>hc_preauth</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${preauthSpec}</operaton:expression></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="hc_preauth" name="Cashless pre-authorisation (1 hour)" operaton:candidateGroups="${tpaSeat}" operaton:formKey="sangam:sec-ins-health-claim/preauth" operaton:dueDate="${hc_preauthDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>preauthDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="hc_preauth_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>hc_preauth</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>tpaSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="hc_preauth_warnEnd" name="Warned"></endEvent>
    <serviceTask id="hc_preauth_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>hc_preauth</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>tpaSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>preauthDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="hc_preauth_breachGw" name="Deemed?" default="sec_ins_health_claim_f14"></exclusiveGateway>
    <exclusiveGateway id="hc_preauth_done" name=""></exclusiveGateway>
    <exclusiveGateway id="hc_preGw" name="" default="sec_ins_health_claim_f24"></exclusiveGateway>
    <serviceTask id="hc_query" name="Query to the hospital" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>hcx.preauthReply</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>query</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>policyNo,hospitalId</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>hq</operaton:string></operaton:field><operaton:field name="step"><operaton:string>query</operaton:string></operaton:field></extensionElements></serviceTask>
    <intermediateCatchEvent id="hc_queryReply" name="Hospital replies"><messageEventDefinition messageRef="msg_sangam_hcx_queryReply"/></intermediateCatchEvent>
    <callActivity id="hc_rj_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="hc_rj_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="hc_reply" name="Authorisation to the hospital" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>hcx.preauthReply</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>policyNo,hospitalId,approvedAmount</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>auth</operaton:string></operaton:field><operaton:field name="step"><operaton:string>authorise</operaton:string></operaton:field></extensionElements></serviceTask>
    <eventBasedGateway id="hc_stay" name="Enhancement or discharge"></eventBasedGateway>
    <intermediateCatchEvent id="hc_enh" name="Enhancement request"><messageEventDefinition messageRef="msg_sangam_hcx_enhancement"/></intermediateCatchEvent>
    <intermediateCatchEvent id="hc_dis" name="Discharge request"><messageEventDefinition messageRef="msg_sangam_hcx_dischargeRequest"/></intermediateCatchEvent>
    <serviceTask id="hc_enhance_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>hc_enhance</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${preauthSpec}</operaton:expression></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="hc_enhance" name="Enhancement (1 hour)" operaton:candidateGroups="${tpaSeat}" operaton:formKey="sangam:sec-ins-health-claim/enhance" operaton:dueDate="${hc_enhanceDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="hc_enhance_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>hc_enhance</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>tpaSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="hc_enhance_warnEnd" name="Warned"></endEvent>
    <serviceTask id="hc_enhance_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>hc_enhance</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>tpaSeat</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="hc_enhance_breachGw" name="Deemed?" default="sec_ins_health_claim_f33"></exclusiveGateway>
    <exclusiveGateway id="hc_enhance_done" name=""></exclusiveGateway>
    <serviceTask id="hc_discharge_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>hc_discharge</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${dischargeSpec}</operaton:expression></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="hc_discharge" name="Final discharge authorisation (3 hours)" operaton:candidateGroups="${tpaSeat}" operaton:formKey="sangam:sec-ins-health-claim/discharge" operaton:dueDate="${hc_dischargeDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="hc_discharge_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>hc_discharge</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>tpaSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="hc_discharge_warnEnd" name="Warned"></endEvent>
    <serviceTask id="hc_discharge_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>hc_discharge</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>tpaSeat</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="hc_discharge_breachGw" name="Deemed?" default="sec_ins_health_claim_f43"></exclusiveGateway>
    <exclusiveGateway id="hc_discharge_done" name=""></exclusiveGateway>
    <callActivity id="hc_settle" name="Settle with the hospital (core execution)" calledElement="sangam-core-execution" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <serviceTask id="hc_insGroup" name="Insured group" operaton:expression="${execution.setVariable('insuredGroup', 'external:'.concat(policyNo))}"></serviceTask>
    <serviceTask id="hc_docs_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>hc_docs</operaton:string></operaton:field><operaton:field name="spec"><operaton:string>30D</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="hc_docs" name="Submit claim documents" operaton:candidateGroups="${insuredGroup}" operaton:formKey="sangam:sec-ins-health-claim/documents" operaton:dueDate="${hc_docsDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="hc_docs_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>hc_docs</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>insuredGroup</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="hc_docs_warnEnd" name="Warned"></endEvent>
    <serviceTask id="hc_docs_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>hc_docs</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>insuredGroup</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field><operaton:field name="maxEscalations"><operaton:string>0</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="hc_docs_breachGw" name="Deemed?" default="sec_ins_health_claim_f54"></exclusiveGateway>
    <exclusiveGateway id="hc_docs_done" name=""></exclusiveGateway>
    <serviceTask id="hc_assess_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>hc_assess</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${reimbursementSpec}</operaton:expression></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="hc_assess" name="Assess reimbursement claim" operaton:candidateGroups="${tpaSeat}" operaton:formKey="sangam:sec-ins-health-claim/assess" operaton:dueDate="${hc_assessDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>reimbDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="hc_assess_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>hc_assess</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>tpaSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="hc_assess_warnEnd" name="Warned"></endEvent>
    <serviceTask id="hc_assess_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>hc_assess</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>tpaSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>reimbDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="hc_assess_breachGw" name="Deemed?" default="sec_ins_health_claim_f63"></exclusiveGateway>
    <exclusiveGateway id="hc_assess_done" name=""></exclusiveGateway>
    <exclusiveGateway id="hc_reimbGw" name="" default="sec_ins_health_claim_f69"></exclusiveGateway>
    <serviceTask id="hc_payFailed" name="Settlement failed" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>claim-payment-failed</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>inapp</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>initiatorSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="hc_end" name="Settled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <exclusiveGateway id="hc_payGw" name="executionOutcome?" default="sec_ins_health_claim_f71"></exclusiveGateway>
    <endEvent id="hc_endPayFailed" name="Settlement failed (reconciliation)"></endEvent>
    <boundaryEvent id="hc_preauth_warn" name="SLA warning (75%)" attachedToRef="hc_preauth" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${hc_preauthWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="hc_preauth_breach" name="SLA breached" attachedToRef="hc_preauth" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${hc_preauthDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="hc_enhance_warn" name="SLA warning (75%)" attachedToRef="hc_enhance" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${hc_enhanceWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="hc_enhance_breach" name="SLA breached" attachedToRef="hc_enhance" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${hc_enhanceDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="hc_discharge_warn" name="SLA warning (75%)" attachedToRef="hc_discharge" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${hc_dischargeWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="hc_discharge_breach" name="SLA breached" attachedToRef="hc_discharge" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${hc_dischargeDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="hc_docs_warn" name="SLA warning (75%)" attachedToRef="hc_docs" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${hc_docsWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="hc_docs_breach" name="SLA breached" attachedToRef="hc_docs" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${hc_docsDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="hc_assess_warn" name="SLA warning (75%)" attachedToRef="hc_assess" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${hc_assessWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="hc_assess_breach" name="SLA breached" attachedToRef="hc_assess" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${hc_assessDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="sec_ins_health_claim_f1" sourceRef="hc_start" targetRef="hc_defaults"/>
    <sequenceFlow id="sec_ins_health_claim_f2" sourceRef="hc_defaults" targetRef="hc_tat"/>
    <sequenceFlow id="sec_ins_health_claim_f3" sourceRef="hc_tat" targetRef="hc_cover"/>
    <sequenceFlow id="sec_ins_health_claim_f4" sourceRef="hc_cover" targetRef="hc_coverGw"/>
    <sequenceFlow id="sec_ins_health_claim_f5" sourceRef="hc_rjCover_reject" targetRef="hc_rjCover_endRejected"/>
    <sequenceFlow id="sec_ins_health_claim_f6" sourceRef="hc_rjCover_code" targetRef="hc_rjCover_reject"/>
    <sequenceFlow id="sec_ins_health_claim_f7" name="no" sourceRef="hc_coverGw" targetRef="hc_rjCover_code"><conditionExpression xsi:type="tFormalExpression">${!coverActive}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ins_health_claim_f8" name="yes" sourceRef="hc_coverGw" targetRef="hc_netGw"/>
    <sequenceFlow id="sec_ins_health_claim_f9" sourceRef="hc_preauth_warn" targetRef="hc_preauth_warnNotify"/>
    <sequenceFlow id="sec_ins_health_claim_f10" sourceRef="hc_preauth_warnNotify" targetRef="hc_preauth_warnEnd"/>
    <sequenceFlow id="sec_ins_health_claim_f11" sourceRef="hc_preauth_breach" targetRef="hc_preauth_breachAct"/>
    <sequenceFlow id="sec_ins_health_claim_f12" sourceRef="hc_preauth_breachAct" targetRef="hc_preauth_breachGw"/>
    <sequenceFlow id="sec_ins_health_claim_f13" name="deemed" sourceRef="hc_preauth_breachGw" targetRef="hc_preauth_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ins_health_claim_f14" name="escalated" sourceRef="hc_preauth_breachGw" targetRef="hc_preauth_slaPlan"/>
    <sequenceFlow id="sec_ins_health_claim_f15" sourceRef="hc_preauth_slaPlan" targetRef="hc_preauth"/>
    <sequenceFlow id="sec_ins_health_claim_f16" sourceRef="hc_preauth" targetRef="hc_preauth_done"/>
