<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- Recruitment application. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_recruitment_application" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_cancelCase" name="sangam.cancelCase"/>
  <message id="msg_sangam_recruit_admitCards" name="sangam.recruit.admitCards"/>
  <message id="msg_sangam_recruit_applicationsClosed" name="sangam.recruit.applicationsClosed"/>
  <message id="msg_sangam_recruit_offerAccepted" name="sangam.recruit.offerAccepted"/>
  <message id="msg_sangam_recruit_offerDeclined" name="sangam.recruit.offerDeclined"/>
  <message id="msg_sangam_recruit_result" name="sangam.recruit.result"/>
  <message id="msg_sangam_recruit_scores" name="sangam.recruit.scores"/>
  <message id="msg_sangam_withdrawCase" name="sangam.withdrawCase"/>
  <process id="sangam-recruitment-application" name="Recruitment application" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.recruitment</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>applicantName,dob,socialCategory,qualification</operaton:string></operaton:field></operaton:executionListener><operaton:executionListener event="start" class="org.sangam.packs.core.BatchJoinListener"><operaton:field name="batchVar"><operaton:string>campaignId</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="ra_start" name="Application" operaton:initiator="initiator" operaton:formKey="sangam:recruitment/application"></startEvent>
    <serviceTask id="ra_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>pwd=false;fee=0;category=@socialCategory;score=0;dvSeat=DV-BOARD;joiningWindow=P30D;waitlistValidity=P365D</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="ra_fee" name="Fee and exemptions (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>recruit-fee</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <exclusiveGateway id="ra_feeGw" name="Fee payable?" default="recruitment_application_f6"></exclusiveGateway>
    <serviceTask id="ra_payCfg" name="Fee step" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>executionConnector=paygov.fee;executionStep=fee;verifyApproval=false;reconcileRequired=false;executionPayloadFields=fee,applicantRef,campaignId</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="ra_pay" name="Fee (core execution)" calledElement="sangam-core-execution" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <intermediateCatchEvent id="ra_closed" name="Applications closed"><messageEventDefinition messageRef="msg_sangam_recruit_applicationsClosed"/></intermediateCatchEvent>
    <endEvent id="ra_endUnpaid" name="Fee not paid"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>FEE_NOT_PAID</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <exclusiveGateway id="ra_payGw" name="executionOutcome?" default="recruitment_application_f8"></exclusiveGateway>
    <businessRuleTask id="ra_eligibility" name="Eligibility (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>recruit-eligibility</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <exclusiveGateway id="ra_eligGw" name="Eligible?" default="recruitment_application_f14"></exclusiveGateway>
    <serviceTask id="ra_ineligible" name="Tell candidate: not eligible" operaton:class="org.sangam.packs.core.NotifyDelegate"><extensionElements><operaton:field name="template"><operaton:string>recruit-ineligible</operaton:string></operaton:field><operaton:field name="channel"><operaton:string>sms,email</operaton:string></operaton:field><operaton:field name="recipientVar"><operaton:string>applicantRef</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="ra_endIneligible" name="Ineligible"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>INELIGIBLE</operaton:string></operaton:field><operaton:field name="roundVar"><operaton:string>scoreRound</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <intermediateCatchEvent id="ra_admitMsg" name="Admit cards"><messageEventDefinition messageRef="msg_sangam_recruit_admitCards"/></intermediateCatchEvent>
    <serviceTask id="ra_admitCard" name="Admit card (bulk, GP-27)" operaton:type="external" operaton:topic="sangam.docs.bulk"></serviceTask>
    <intermediateCatchEvent id="ra_scoreMsg" name="Scores available"><messageEventDefinition messageRef="msg_sangam_recruit_scores"/></intermediateCatchEvent>
    <serviceTask id="ra_score" name="Fetch score for this key version" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>exam.score</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>score</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>query</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>campaignId,scoreRound</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>exam</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ra_scoreSet" name="Score" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>score=@examScore</operaton:string></operaton:field></extensionElements></serviceTask>
    <intermediateThrowEvent id="ra_scored" name="Score recorded"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SCORED</operaton:string></operaton:field><operaton:field name="dataVars"><operaton:string>score,category,dob,pwd</operaton:string></operaton:field><operaton:field name="roundVar"><operaton:string>scoreRound</operaton:string></operaton:field></operaton:executionListener></extensionElements></intermediateThrowEvent>
    <eventBasedGateway id="ra_awaitResult" name="Recompute or result"></eventBasedGateway>
    <intermediateCatchEvent id="ra_rescore" name="Scores recomputed"><messageEventDefinition messageRef="msg_sangam_recruit_scores"/></intermediateCatchEvent>
    <intermediateCatchEvent id="ra_result" name="Result"><messageEventDefinition messageRef="msg_sangam_recruit_result"/></intermediateCatchEvent>
    <exclusiveGateway id="ra_selGw" name="Selected?" default="recruitment_application_f34"></exclusiveGateway>
    <serviceTask id="ra_dv_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>ra_dv</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>10WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="ra_dv" name="Document verification" operaton:candidateGroups="${dvSeat}" operaton:formKey="sangam:recruitment/dv" operaton:dueDate="${ra_dvDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>dvVerdict</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="ra_dv_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>ra_dv</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>dvSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="ra_dv_warnEnd" name="Warned"></endEvent>
    <serviceTask id="ra_dv_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>ra_dv</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>dvSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>dvVerdict</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="ra_dv_breachGw" name="Deemed?" default="recruitment_application_f30"></exclusiveGateway>
    <exclusiveGateway id="ra_dv_done" name=""></exclusiveGateway>
    <eventBasedGateway id="ra_waitlisted" name="Waitlisted"></eventBasedGateway>
    <intermediateCatchEvent id="ra_promoted" name="Promoted from waitlist"><messageEventDefinition messageRef="msg_sangam_recruit_result"/></intermediateCatchEvent>
    <intermediateCatchEvent id="ra_waitExpiry" name="Panel expires"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">${waitlistValidity}</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <endEvent id="ra_endNotSelected" name="Not selected"></endEvent>
    <exclusiveGateway id="ra_dvGw" name="" default="recruitment_application_f41"></exclusiveGateway>
    <serviceTask id="ra_offer" name="Offer letter (bulk)" operaton:type="external" operaton:topic="sangam.docs.bulk"></serviceTask>
    <serviceTask id="ra_vacate" name="Tell campaign: post vacated" operaton:class="org.sangam.packs.core.CorrelationDelegate"><extensionElements><operaton:field name="messageName"><operaton:string>sangam.recruit.vacated</operaton:string></operaton:field><operaton:field name="targetBusinessKey"><operaton:expression>${campaignId}</operaton:expression></operaton:field><operaton:field name="variables"><operaton:string>itemKey:vacatedKey</operaton:string></operaton:field><operaton:field name="optional"><operaton:string>true</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="ra_endVacated" name="Vacated"></endEvent>
    <eventBasedGateway id="ra_joinWait" name="Accept offer?"></eventBasedGateway>
    <intermediateCatchEvent id="ra_accepted" name="Offer accepted"><messageEventDefinition messageRef="msg_sangam_recruit_offerAccepted"/></intermediateCatchEvent>
    <intermediateCatchEvent id="ra_declined" name="Offer declined"><messageEventDefinition messageRef="msg_sangam_recruit_offerDeclined"/></intermediateCatchEvent>
    <intermediateCatchEvent id="ra_joinLapse" name="Did not join"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">${joiningWindow}</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <serviceTask id="ra_appointment" name="Appointment order" operaton:class="org.sangam.packs.core.DocumentDelegate"><extensionElements><operaton:field name="template"><operaton:string>appointment-order</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="ra_endAppointed" name="Appointed"></endEvent>
    <boundaryEvent id="ra_dv_warn" name="SLA warning (75%)" attachedToRef="ra_dv" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${ra_dvWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="ra_dv_breach" name="SLA breached" attachedToRef="ra_dv" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${ra_dvDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="recruitment_application_f1" sourceRef="ra_start" targetRef="ra_defaults"/>
    <sequenceFlow id="recruitment_application_f2" sourceRef="ra_defaults" targetRef="ra_fee"/>
    <sequenceFlow id="recruitment_application_f3" sourceRef="ra_fee" targetRef="ra_feeGw"/>
    <sequenceFlow id="recruitment_application_f4" name="pay" sourceRef="ra_feeGw" targetRef="ra_payCfg"><conditionExpression xsi:type="tFormalExpression">${fee &gt; 0}</conditionExpression></sequenceFlow>
    <sequenceFlow id="recruitment_application_f5" sourceRef="ra_payCfg" targetRef="ra_pay"/>
    <sequenceFlow id="recruitment_application_f6" name="exempt" sourceRef="ra_feeGw" targetRef="ra_closed"/>
    <sequenceFlow id="recruitment_application_f7" name="DONE" sourceRef="ra_payGw" targetRef="ra_closed"><conditionExpression xsi:type="tFormalExpression">${executionOutcome == 'DONE'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="recruitment_application_f8" name="otherwise" sourceRef="ra_payGw" targetRef="ra_endUnpaid"/>
    <sequenceFlow id="recruitment_application_f9" sourceRef="ra_pay" targetRef="ra_payGw"/>
    <sequenceFlow id="recruitment_application_f10" sourceRef="ra_closed" targetRef="ra_eligibility"/>
    <sequenceFlow id="recruitment_application_f11" sourceRef="ra_eligibility" targetRef="ra_eligGw"/>
    <sequenceFlow id="recruitment_application_f12" name="no" sourceRef="ra_eligGw" targetRef="ra_ineligible"><conditionExpression xsi:type="tFormalExpression">${!eligible}</conditionExpression></sequenceFlow>
    <sequenceFlow id="recruitment_application_f13" sourceRef="ra_ineligible" targetRef="ra_endIneligible"/>
    <sequenceFlow id="recruitment_application_f14" name="yes" sourceRef="ra_eligGw" targetRef="ra_admitMsg"/>
    <sequenceFlow id="recruitment_application_f15" sourceRef="ra_admitMsg" targetRef="ra_admitCard"/>
    <sequenceFlow id="recruitment_application_f16" sourceRef="ra_admitCard" targetRef="ra_scoreMsg"/>
    <sequenceFlow id="recruitment_application_f17" sourceRef="ra_scoreMsg" targetRef="ra_score"/>
    <sequenceFlow id="recruitment_application_f18" sourceRef="ra_score" targetRef="ra_scoreSet"/>
    <sequenceFlow id="recruitment_application_f19" sourceRef="ra_scoreSet" targetRef="ra_scored"/>
    <sequenceFlow id="recruitment_application_f20" sourceRef="ra_scored" targetRef="ra_awaitResult"/>
    <sequenceFlow id="recruitment_application_f21" sourceRef="ra_awaitResult" targetRef="ra_rescore"/>
    <sequenceFlow id="recruitment_application_f22" sourceRef="ra_awaitResult" targetRef="ra_result"/>
    <sequenceFlow id="recruitment_application_f23" sourceRef="ra_rescore" targetRef="ra_score"/>
    <sequenceFlow id="recruitment_application_f24" sourceRef="ra_result" targetRef="ra_selGw"/>
    <sequenceFlow id="recruitment_application_f25" sourceRef="ra_dv_warn" targetRef="ra_dv_warnNotify"/>
    <sequenceFlow id="recruitment_application_f26" sourceRef="ra_dv_warnNotify" targetRef="ra_dv_warnEnd"/>
    <sequenceFlow id="recruitment_application_f27" sourceRef="ra_dv_breach" targetRef="ra_dv_breachAct"/>
    <sequenceFlow id="recruitment_application_f28" sourceRef="ra_dv_breachAct" targetRef="ra_dv_breachGw"/>
    <sequenceFlow id="recruitment_application_f29" name="deemed" sourceRef="ra_dv_breachGw" targetRef="ra_dv_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="recruitment_application_f30" name="escalated" sourceRef="ra_dv_breachGw" targetRef="ra_dv_slaPlan"/>
    <sequenceFlow id="recruitment_application_f31" sourceRef="ra_dv_slaPlan" targetRef="ra_dv"/>
    <sequenceFlow id="recruitment_application_f32" sourceRef="ra_dv" targetRef="ra_dv_done"/>
    <sequenceFlow id="recruitment_application_f33" name="selected" sourceRef="ra_selGw" targetRef="ra_dv_slaPlan"><conditionExpression xsi:type="tFormalExpression">${selected}</conditionExpression></sequenceFlow>
    <sequenceFlow id="recruitment_application_f34" name="waitlisted / not selected" sourceRef="ra_selGw" targetRef="ra_waitlisted"/>
    <sequenceFlow id="recruitment_application_f35" sourceRef="ra_waitlisted" targetRef="ra_promoted"/>
    <sequenceFlow id="recruitment_application_f36" sourceRef="ra_waitlisted" targetRef="ra_waitExpiry"/>
    <sequenceFlow id="recruitment_application_f37" sourceRef="ra_promoted" targetRef="ra_dv_slaPlan"/>
    <sequenceFlow id="recruitment_application_f38" sourceRef="ra_waitExpiry" targetRef="ra_endNotSelected"/>
    <sequenceFlow id="recruitment_application_f39" sourceRef="ra_dv_done" targetRef="ra_dvGw"/>
    <sequenceFlow id="recruitment_application_f40" name="verified" sourceRef="ra_dvGw" targetRef="ra_offer"><conditionExpression xsi:type="tFormalExpression">${dvVerdict == 'verified'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="recruitment_application_f41" name="DV failed" sourceRef="ra_dvGw" targetRef="ra_vacate"/>
    <sequenceFlow id="recruitment_application_f42" sourceRef="ra_vacate" targetRef="ra_endVacated"/>
    <sequenceFlow id="recruitment_application_f43" sourceRef="ra_offer" targetRef="ra_joinWait"/>
    <sequenceFlow id="recruitment_application_f44" sourceRef="ra_joinWait" targetRef="ra_accepted"/>
    <sequenceFlow id="recruitment_application_f45" sourceRef="ra_joinWait" targetRef="ra_declined"/>
    <sequenceFlow id="recruitment_application_f46" sourceRef="ra_joinWait" targetRef="ra_joinLapse"/>
    <sequenceFlow id="recruitment_application_f47" sourceRef="ra_declined" targetRef="ra_vacate"/>
    <sequenceFlow id="recruitment_application_f48" sourceRef="ra_joinLapse" targetRef="ra_vacate"/>
    <sequenceFlow id="recruitment_application_f49" sourceRef="ra_accepted" targetRef="ra_appointment"/>
    <sequenceFlow id="recruitment_application_f50" sourceRef="ra_appointment" targetRef="ra_endAppointed"/>
    <subProcess id="ra_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="ra_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="ra_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="ra_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="ra_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="recruitment_application_f51" sourceRef="ra_withdrawStart" targetRef="ra_withdrawKind"/>
      <sequenceFlow id="recruitment_application_f52" sourceRef="ra_withdrawKind" targetRef="ra_withdrawCall"/>
      <sequenceFlow id="recruitment_application_f53" sourceRef="ra_withdrawCall" targetRef="ra_withdrawEnd"/>
    </subProcess>
    <subProcess id="ra_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="ra_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="ra_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="ra_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="ra_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="recruitment_application_f54" sourceRef="ra_cancelStart" targetRef="ra_cancelKind"/>
      <sequenceFlow id="recruitment_application_f55" sourceRef="ra_cancelKind" targetRef="ra_cancelCall"/>
      <sequenceFlow id="recruitment_application_f56" sourceRef="ra_cancelCall" targetRef="ra_cancelEnd"/>
    </subProcess>
  </process>
  <bpmndi:BPMNDiagram id="recruitment_application_diagram">
    <bpmndi:BPMNPlane id="recruitment_application_plane" bpmnElement="sangam-recruitment-application">
      <bpmndi:BPMNShape id="ra_start_di" bpmnElement="ra_start"><dc:Bounds x="52" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ra_defaults_di" bpmnElement="ra_defaults"><dc:Bounds x="185" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ra_fee_di" bpmnElement="ra_fee"><dc:Bounds x="350" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ra_feeGw_di" bpmnElement="ra_feeGw"><dc:Bounds x="540" y="45" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ra_payCfg_di" bpmnElement="ra_payCfg"><dc:Bounds x="680" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ra_pay_di" bpmnElement="ra_pay"><dc:Bounds x="845" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ra_closed_di" bpmnElement="ra_closed"><dc:Bounds x="1207" y="177" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ra_endUnpaid_di" bpmnElement="ra_endUnpaid"><dc:Bounds x="1207" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ra_payGw_di" bpmnElement="ra_payGw"><dc:Bounds x="1035" y="45" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ra_eligibility_di" bpmnElement="ra_eligibility"><dc:Bounds x="1340" y="155" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ra_eligGw_di" bpmnElement="ra_eligGw"><dc:Bounds x="1530" y="170" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ra_ineligible_di" bpmnElement="ra_ineligible"><dc:Bounds x="1670" y="280" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ra_endIneligible_di" bpmnElement="ra_endIneligible"><dc:Bounds x="1867" y="302" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ra_admitMsg_di" bpmnElement="ra_admitMsg"><dc:Bounds x="1702" y="177" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ra_admitCard_di" bpmnElement="ra_admitCard"><dc:Bounds x="1835" y="155" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ra_scoreMsg_di" bpmnElement="ra_scoreMsg"><dc:Bounds x="2032" y="177" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ra_score_di" bpmnElement="ra_score"><dc:Bounds x="2165" y="155" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ra_scoreSet_di" bpmnElement="ra_scoreSet"><dc:Bounds x="2330" y="155" width="100" height="80"/></bpmndi:BPMNShape>
