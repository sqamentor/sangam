      <bpmndi:BPMNShape id="lt_end_di" bpmnElement="lt_end"><dc:Bounds x="3352" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lt_assess_warn_di" bpmnElement="lt_assess_warn"><dc:Bounds x="853" y="92" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lt_assess_breach_di" bpmnElement="lt_assess_breach"><dc:Bounds x="883" y="92" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lt_lateWarn_di" bpmnElement="lt_lateWarn"><dc:Bounds x="2008" y="92" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lt_withdraw_di" bpmnElement="lt_withdraw" isExpanded="true"><dc:Bounds x="30" y="285" width="623" height="150"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lt_withdrawStart_di" bpmnElement="lt_withdrawStart"><dc:Bounds x="92" y="347" width="36" height="36"/></bpmndi:BPMNShape>
