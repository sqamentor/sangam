  <message id="msg_sangam_cancelCase" name="sangam.cancelCase"/>
  <message id="msg_sangam_ushealth_baBreach" name="sangam.ushealth.baBreach"/>
  <message id="msg_sangam_ushealth_baTerminate" name="sangam.ushealth.baTerminate"/>
  <message id="msg_sangam_withdrawCase" name="sangam.withdrawCase"/>
  <process id="sangam-sec-ushealth-baa" name="Business associate agreement" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.ushealth.baa</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>baName,phiScope</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="ba_start" name="Business associate proposed" operaton:initiator="initiator" operaton:formKey="sangam:sec-ushealth-baa/propose"></startEvent>
    <serviceTask id="ba_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>baName=@supplierName;baaTerms=false;privacySeat=PRIVACY-OFFICE;securitySeat=SECURITY-OFFICE;counselSeat=COUNSEL</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="ba_cfg" name="BAA review policy (DMN)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>sec-ushealth-baa-config</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <userTask id="ba_security" name="Security assessment of the business associate" operaton:candidateGroups="${securitySeat}" operaton:formKey="sangam:sec-ushealth-baa/security"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <userTask id="ba_terms" name="Check the required BAA terms and flow-down" operaton:candidateGroups="${privacySeat}" operaton:formKey="sangam:sec-ushealth-baa/terms"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="ba_termsGw" name="Terms complete?" default="sec_ushealth_baa_f7"></exclusiveGateway>
    <userTask id="ba_approve" name="Legal approval of the BAA" operaton:candidateGroups="${counselSeat}" operaton:formKey="sangam:sec-ushealth-baa/approve"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"><operaton:field name="steps"><operaton:string>ba_terms</operaton:string></operaton:field></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>baaDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="ba_apGw" name="" default="sec_ushealth_baa_f10"></exclusiveGateway>
    <endEvent id="ba_endRejected" name="Not engaged"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="ba_sign" name="Sign the BAA (e-signature)" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>esign.baa</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>sign</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>baName,phiScope</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>sign</operaton:string></operaton:field><operaton:field name="step"><operaton:string>sign</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="ba_reviewClock" name="Due date: baaReview" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BEFORE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>baaReview</operaton:string></operaton:field><operaton:field name="dateVar"><operaton:string>baaTermEnd</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${reviewLead}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <eventBasedGateway id="ba_life" name="Review due, breach report or termination"></eventBasedGateway>
    <intermediateCatchEvent id="ba_reviewDue" name="Periodic review due"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${baaReviewDueAt}</timeDate></timerEventDefinition></intermediateCatchEvent>
    <intermediateCatchEvent id="ba_breach" name="Breach reported by the associate"><messageEventDefinition messageRef="msg_sangam_ushealth_baBreach"/></intermediateCatchEvent>
    <intermediateCatchEvent id="ba_terminate" name="Termination ordered"><messageEventDefinition messageRef="msg_sangam_ushealth_baTerminate"/></intermediateCatchEvent>
    <userTask id="ba_review" name="Periodic review: renew or terminate" operaton:candidateGroups="${privacySeat}" operaton:formKey="sangam:sec-ushealth-baa/review"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>reviewDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="ba_reviewGw" name="" default="sec_ushealth_baa_f23"></exclusiveGateway>
    <serviceTask id="ba_startBreach" name="Open breach notification" operaton:class="org.sangam.packs.core.LinkedInstanceDelegate"><extensionElements><operaton:field name="processKey"><operaton:string>sangam-sec-ushealth-breach</operaton:string></operaton:field><operaton:field name="linkType"><operaton:string>RELATED</operaton:string></operaton:field><operaton:field name="businessKeySuffix"><operaton:string>/breach</operaton:string></operaton:field><operaton:field name="inherit"><operaton:string>incidentSummary,phiTypes</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="ba_cure" name="Material breach: cure or terminate" operaton:candidateGroups="${counselSeat}" operaton:formKey="sangam:sec-ushealth-baa/cure"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>cureDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="ba_cureGw" name="" default="sec_ushealth_baa_f24"></exclusiveGateway>
    <userTask id="ba_dispose" name="Return or destroy PHI and keep the certificate (6 years)" operaton:candidateGroups="${privacySeat}" operaton:formKey="sangam:sec-ushealth-baa/dispose"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="ba_termJoin" name=""></exclusiveGateway>
    <endEvent id="ba_end" name="BAA terminated and PHI disposed"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>TERMINATED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <sequenceFlow id="sec_ushealth_baa_f1" sourceRef="ba_start" targetRef="ba_defaults"/>
    <sequenceFlow id="sec_ushealth_baa_f2" sourceRef="ba_defaults" targetRef="ba_cfg"/>
    <sequenceFlow id="sec_ushealth_baa_f3" sourceRef="ba_cfg" targetRef="ba_security"/>
    <sequenceFlow id="sec_ushealth_baa_f4" sourceRef="ba_security" targetRef="ba_terms"/>
    <sequenceFlow id="sec_ushealth_baa_f5" sourceRef="ba_terms" targetRef="ba_termsGw"/>
    <sequenceFlow id="sec_ushealth_baa_f6" name="missing terms" sourceRef="ba_termsGw" targetRef="ba_terms"><conditionExpression xsi:type="tFormalExpression">${!baaTerms}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ushealth_baa_f7" name="complete" sourceRef="ba_termsGw" targetRef="ba_approve"/>
    <sequenceFlow id="sec_ushealth_baa_f8" sourceRef="ba_approve" targetRef="ba_apGw"/>
    <sequenceFlow id="sec_ushealth_baa_f9" name="rejected" sourceRef="ba_apGw" targetRef="ba_endRejected"><conditionExpression xsi:type="tFormalExpression">${baaDecision == 'reject'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ushealth_baa_f10" name="approved" sourceRef="ba_apGw" targetRef="ba_sign"/>
    <sequenceFlow id="sec_ushealth_baa_f11" sourceRef="ba_sign" targetRef="ba_reviewClock"/>
    <sequenceFlow id="sec_ushealth_baa_f12" sourceRef="ba_reviewClock" targetRef="ba_life"/>
    <sequenceFlow id="sec_ushealth_baa_f13" sourceRef="ba_life" targetRef="ba_reviewDue"/>
    <sequenceFlow id="sec_ushealth_baa_f14" sourceRef="ba_life" targetRef="ba_breach"/>
    <sequenceFlow id="sec_ushealth_baa_f15" sourceRef="ba_life" targetRef="ba_terminate"/>
    <sequenceFlow id="sec_ushealth_baa_f16" sourceRef="ba_reviewDue" targetRef="ba_review"/>
    <sequenceFlow id="sec_ushealth_baa_f17" sourceRef="ba_review" targetRef="ba_reviewGw"/>
    <sequenceFlow id="sec_ushealth_baa_f18" name="renew" sourceRef="ba_reviewGw" targetRef="ba_reviewClock"><conditionExpression xsi:type="tFormalExpression">${reviewDecision == 'renew'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ushealth_baa_f19" sourceRef="ba_breach" targetRef="ba_startBreach"/>
    <sequenceFlow id="sec_ushealth_baa_f20" sourceRef="ba_startBreach" targetRef="ba_cure"/>
    <sequenceFlow id="sec_ushealth_baa_f21" sourceRef="ba_cure" targetRef="ba_cureGw"/>
    <sequenceFlow id="sec_ushealth_baa_f22" name="cured" sourceRef="ba_cureGw" targetRef="ba_life"><conditionExpression xsi:type="tFormalExpression">${cureDecision == 'cured'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_ushealth_baa_f23" name="terminate" sourceRef="ba_reviewGw" targetRef="ba_termJoin"/>
    <sequenceFlow id="sec_ushealth_baa_f24" name="terminate" sourceRef="ba_cureGw" targetRef="ba_termJoin"/>
    <sequenceFlow id="sec_ushealth_baa_f25" sourceRef="ba_terminate" targetRef="ba_termJoin"/>
    <sequenceFlow id="sec_ushealth_baa_f26" sourceRef="ba_termJoin" targetRef="ba_dispose"/>
    <sequenceFlow id="sec_ushealth_baa_f27" sourceRef="ba_dispose" targetRef="ba_end"/>
    <subProcess id="ba_withdraw" name="Withdrawn by initiator" triggeredByEvent="true">
      <startEvent id="ba_withdrawStart" name="Withdrawal requested" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_withdrawCase"/></startEvent>
      <serviceTask id="ba_withdrawKind" name="Kind: withdrawal" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=WITHDRAWN</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="ba_withdrawCall" name="Withdraw (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="ba_withdrawEnd" name="Withdrawn"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>WITHDRAWN</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="sec_ushealth_baa_f28" sourceRef="ba_withdrawStart" targetRef="ba_withdrawKind"/>
      <sequenceFlow id="sec_ushealth_baa_f29" sourceRef="ba_withdrawKind" targetRef="ba_withdrawCall"/>
      <sequenceFlow id="sec_ushealth_baa_f30" sourceRef="ba_withdrawCall" targetRef="ba_withdrawEnd"/>
    </subProcess>
    <subProcess id="ba_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="ba_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="ba_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="ba_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
      <endEvent id="ba_cancelEnd" name="Cancelled"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>CANCELLED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
      <sequenceFlow id="sec_ushealth_baa_f31" sourceRef="ba_cancelStart" targetRef="ba_cancelKind"/>
      <sequenceFlow id="sec_ushealth_baa_f32" sourceRef="ba_cancelKind" targetRef="ba_cancelCall"/>
      <sequenceFlow id="sec_ushealth_baa_f33" sourceRef="ba_cancelCall" targetRef="ba_cancelEnd"/>
    </subProcess>
  </process>
