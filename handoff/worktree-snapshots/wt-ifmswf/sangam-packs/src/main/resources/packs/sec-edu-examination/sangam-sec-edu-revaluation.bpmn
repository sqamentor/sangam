<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- Revaluation request. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_sec_edu_revaluation" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <process id="sangam-sec-edu-revaluation" name="Revaluation request" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.edu.examination</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>applicantName,examName,subject</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="rv_start" name="Revaluation requested" operaton:initiator="initiator" operaton:formKey="sangam:sec-edu-examination/revaluation"></startEvent>
    <serviceTask id="rv_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>examName=X;executionConnector=pg.collect;executionStep=reval-fee;verifyApproval=false;reconcileRequired=false;executionPayloadFields=applicantName,subject</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="rv_fee" name="Collect fee (core execution)" calledElement="sangam-core-execution" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <serviceTask id="rv_eval_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>rv_eval</operaton:string></operaton:field><operaton:field name="spec"><operaton:string>15D</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="rv_eval" name="Re-evaluate by a different evaluator" operaton:candidateGroups="${revaluatorSeat}" operaton:formKey="sangam:sec-edu-examination/re-evaluate" operaton:dueDate="${rv_evalDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.SodGuardListener"><operaton:field name="steps"><operaton:string>ex_evaluate</operaton:string></operaton:field></operaton:taskListener><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="rv_eval_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>rv_eval</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>revaluatorSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="rv_eval_warnEnd" name="Warned"></endEvent>
    <serviceTask id="rv_eval_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>rv_eval</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>revaluatorSeat</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="rv_eval_breachGw" name="Deemed?" default="sec_edu_revaluation_f6"></exclusiveGateway>
    <exclusiveGateway id="rv_eval_done" name=""></exclusiveGateway>
    <serviceTask id="rv_seat" name="Evaluator" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>revaluatorSeat=EVALUATOR-2</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="rv_publish" name="Publish the revised result" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>exam.publish</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>revise</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>applicantName,subject</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>rpub</operaton:string></operaton:field><operaton:field name="step"><operaton:string>revised</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="rv_end" name="Revaluation done"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="rv_eval_warn" name="SLA warning (75%)" attachedToRef="rv_eval" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${rv_evalWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="rv_eval_breach" name="SLA breached" attachedToRef="rv_eval" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${rv_evalDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="sec_edu_revaluation_f1" sourceRef="rv_eval_warn" targetRef="rv_eval_warnNotify"/>
    <sequenceFlow id="sec_edu_revaluation_f2" sourceRef="rv_eval_warnNotify" targetRef="rv_eval_warnEnd"/>
    <sequenceFlow id="sec_edu_revaluation_f3" sourceRef="rv_eval_breach" targetRef="rv_eval_breachAct"/>
    <sequenceFlow id="sec_edu_revaluation_f4" sourceRef="rv_eval_breachAct" targetRef="rv_eval_breachGw"/>
    <sequenceFlow id="sec_edu_revaluation_f5" name="deemed" sourceRef="rv_eval_breachGw" targetRef="rv_eval_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="sec_edu_revaluation_f6" name="escalated" sourceRef="rv_eval_breachGw" targetRef="rv_eval_slaPlan"/>
    <sequenceFlow id="sec_edu_revaluation_f7" sourceRef="rv_eval_slaPlan" targetRef="rv_eval"/>
    <sequenceFlow id="sec_edu_revaluation_f8" sourceRef="rv_eval" targetRef="rv_eval_done"/>
    <sequenceFlow id="sec_edu_revaluation_f9" sourceRef="rv_start" targetRef="rv_defaults"/>
    <sequenceFlow id="sec_edu_revaluation_f10" sourceRef="rv_defaults" targetRef="rv_fee"/>
    <sequenceFlow id="sec_edu_revaluation_f11" sourceRef="rv_fee" targetRef="rv_seat"/>
    <sequenceFlow id="sec_edu_revaluation_f12" sourceRef="rv_seat" targetRef="rv_eval_slaPlan"/>
    <sequenceFlow id="sec_edu_revaluation_f13" sourceRef="rv_eval_done" targetRef="rv_publish"/>
    <sequenceFlow id="sec_edu_revaluation_f14" sourceRef="rv_publish" targetRef="rv_end"/>
  </process>
