    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.ifms.gia-uc</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>grantee,amount,releasePercent</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="gr_start" name="Release proposed" operaton:initiator="initiator" operaton:formKey="sangam:ifms-gia-uc/release"></startEvent>
    <serviceTask id="gr_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>amount=0;releasePercent=0;recurringGrant=false;ucStatus=SUBMITTED;unspentBalance=0;granteeType=INSTITUTION;faSeat=FA-1;billType=GIA;caseType=GIA;routingDecisionKey=ifms-gia-authority;powersDecisionKey=ifms-gia-powers;scrutinySeat=PRAO-1;outputTemplate=grant-sanction;appealAllowed=false</operaton:string></operaton:field></extensionElements></serviceTask>
    <businessRuleTask id="gr_rules" name="Release rules (GFR 230(7), 238)" operaton:class="org.sangam.packs.core.DecisionDelegate"><extensionElements><operaton:field name="decisionKey"><operaton:string>ifms-gia-release</operaton:string></operaton:field></extensionElements></businessRuleTask>
    <exclusiveGateway id="gr_okGw" name="Release allowed?" default="ifms_gia_release_f15"></exclusiveGateway>
    <serviceTask id="gr_rjRule_code" name="Reason: GIA_RULE" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>rejectionReasonCodes=GIA_RULE</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="gr_rjRule_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="gr_rjRule_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <serviceTask id="gr_fa_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>gr_fa</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="gr_fa" name="FA concurrence" operaton:candidateGroups="${faSeat}" operaton:formKey="sangam:ifms-gia-uc/fa" operaton:dueDate="${gr_faDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>faDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="gr_fa_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>gr_fa</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>faSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="gr_fa_warnEnd" name="Warned"></endEvent>
    <serviceTask id="gr_fa_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>gr_fa</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>faSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>faDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
