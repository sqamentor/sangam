    <sequenceFlow id="ifms_gia_release_f17" sourceRef="gr_rj_reject" targetRef="gr_rj_endRejected"/>
    <sequenceFlow id="ifms_gia_release_f18" name="concur" sourceRef="gr_faGw" targetRef="gr_sanction"><conditionExpression xsi:type="tFormalExpression">${faDecision == 'faConcur'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_gia_release_f19" name="not concurred" sourceRef="gr_faGw" targetRef="gr_rj_reject"/>
    <sequenceFlow id="ifms_gia_release_f20" name="SANCTIONED" sourceRef="gr_sanGw" targetRef="gr_bill"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_gia_release_f21" name="otherwise" sourceRef="gr_sanGw" targetRef="gr_rj_reject"/>
    <sequenceFlow id="ifms_gia_release_f22" sourceRef="gr_sanction" targetRef="gr_sanGw"/>
    <sequenceFlow id="ifms_gia_release_f23" sourceRef="gr_bill" targetRef="gr_uc"/>
    <sequenceFlow id="ifms_gia_release_f24" sourceRef="gr_uc" targetRef="gr_end"/>
