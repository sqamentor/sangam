      <sequenceFlow id="ifms_gia_release_f28" sourceRef="gr_cancelStart" targetRef="gr_cancelKind"/>
      <sequenceFlow id="ifms_gia_release_f29" sourceRef="gr_cancelKind" targetRef="gr_cancelCall"/>
      <sequenceFlow id="ifms_gia_release_f30" sourceRef="gr_cancelCall" targetRef="gr_cancelEnd"/>
    </subProcess>
