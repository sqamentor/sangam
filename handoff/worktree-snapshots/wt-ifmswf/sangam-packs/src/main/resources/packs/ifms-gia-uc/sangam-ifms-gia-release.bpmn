      <sequenceFlow id="ifms_gia_release_f25" sourceRef="gr_withdrawStart" targetRef="gr_withdrawKind"/>
      <sequenceFlow id="ifms_gia_release_f26" sourceRef="gr_withdrawKind" targetRef="gr_withdrawCall"/>
      <sequenceFlow id="ifms_gia_release_f27" sourceRef="gr_withdrawCall" targetRef="gr_withdrawEnd"/>
    </subProcess>
    <subProcess id="gr_cancel" name="Authorised cancellation" triggeredByEvent="true">
      <startEvent id="gr_cancelStart" name="Cancellation ordered" isInterrupting="true"><messageEventDefinition messageRef="msg_sangam_cancelCase"/></startEvent>
      <serviceTask id="gr_cancelKind" name="Kind: cancellation" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>cancelKind=CANCELLED</operaton:string></operaton:field></extensionElements></serviceTask>
      <callActivity id="gr_cancelCall" name="Cancel (core)" calledElement="sangam-core-cancellation" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
