    <sequenceFlow id="ifms_gia_release_f11" name="deemed" sourceRef="gr_fa_breachGw" targetRef="gr_fa_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_gia_release_f12" name="escalated" sourceRef="gr_fa_breachGw" targetRef="gr_fa_slaPlan"/>
    <sequenceFlow id="ifms_gia_release_f13" sourceRef="gr_fa_slaPlan" targetRef="gr_fa"/>
