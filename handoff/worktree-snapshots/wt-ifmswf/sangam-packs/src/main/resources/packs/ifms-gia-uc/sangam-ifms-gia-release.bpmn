    <boundaryEvent id="gr_fa_breach" name="SLA breached" attachedToRef="gr_fa" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${gr_faDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="ifms_gia_release_f1" sourceRef="gr_start" targetRef="gr_defaults"/>
