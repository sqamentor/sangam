<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- Asset / vehicle lifecycle. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_asset_lifecycle" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_assetLost" name="sangam.assetLost"/>
  <message id="msg_sangam_auctionResult" name="sangam.auctionResult"/>
  <process id="sangam-asset-lifecycle" name="Asset / vehicle lifecycle" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.assets</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>assetId,assetValue</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="as_start" name="Asset acquired" operaton:initiator="initiator" operaton:formKey="sangam:assets/register"></startEvent>
    <serviceTask id="as_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>maintenanceCycle=P180D;assetOfficerSeat=ASSET-OFFICER;surveyBoard=BOARD-1,BOARD-2,BOARD-3;caseType=CONDEMNATION;amount=@assetValue;routingDecisionKey=assets-condemnation-authority;auctionWindow=P60D;appealAllowed=false</operaton:string></operaton:field></extensionElements></serviceTask>
    <serviceTask id="as_register" name="Enter in register" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>assets.register</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>register</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>assetId,assetValue,category</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>register</operaton:string></operaton:field><operaton:field name="step"><operaton:string>register</operaton:string></operaton:field></extensionElements></serviceTask>
    <intermediateCatchEvent id="as_cycle" name="Maintenance due"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">${maintenanceCycle}</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <userTask id="as_maintain" name="Periodic maintenance / fitness" operaton:candidateGroups="${assetOfficerSeat}" operaton:formKey="sangam:assets/maintenance"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>conditionDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <exclusiveGateway id="as_gw" name="Fit?" default="asset_lifecycle_f7"></exclusiveGateway>
    <serviceTask id="as_board" name="Survey board" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="values"><operaton:string>committeeSeats=@surveyBoard;quorumRule=ALL</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="as_survey" name="Survey / condemnation board (core committee)" calledElement="sangam-core-committee" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <exclusiveGateway id="as_boardGw" name="Board agrees?" default="asset_lifecycle_f11"></exclusiveGateway>
    <callActivity id="as_sanction" name="Condemnation sanction (core)" calledElement="sangam-core-sanction" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <serviceTask id="as_list" name="List on e-auction" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>eauction.list</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>list</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>assetId,reservePrice</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>auction</operaton:string></operaton:field><operaton:field name="step"><operaton:string>auction</operaton:string></operaton:field></extensionElements></serviceTask>
    <callActivity id="as_rj_reject" name="Rejection with reasons (core)" calledElement="sangam-core-rejection" operaton:calledElementBinding="versionTag" operaton:calledElementVersionTag="1.0.0"><extensionElements><operaton:in businessKey="#{execution.processBusinessKey}"/><operaton:in variables="all"/><operaton:out variables="all"/></extensionElements></callActivity>
    <endEvent id="as_rj_endRejected" name="Rejected"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field><operaton:field name="reasonVar"><operaton:string>rejectionReasonCodes</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <exclusiveGateway id="as_sanGw" name="sanctionOutcome?" default="asset_lifecycle_f14"></exclusiveGateway>
    <serviceTask id="as_auctionWindow" name="Auction window" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>DEADLINE</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>auction</operaton:string></operaton:field><operaton:field name="spec"><operaton:expression>${auctionWindow}</operaton:expression></operaton:field></extensionElements></serviceTask>
    <eventBasedGateway id="as_wait" name="Sold?"></eventBasedGateway>
    <intermediateCatchEvent id="as_sold" name="Auction result"><messageEventDefinition messageRef="msg_sangam_auctionResult"/></intermediateCatchEvent>
    <intermediateCatchEvent id="as_unsold" name="No bid"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${auctionDueAt}</timeDate></timerEventDefinition></intermediateCatchEvent>
    <userTask id="as_relist" name="No bid: revise reserve price and relist" operaton:candidateGroups="${assetOfficerSeat}" operaton:formKey="sangam:assets/relist"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="as_remove" name="Remove from register" operaton:class="org.sangam.packs.core.ConnectorCallDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="connector"><operaton:string>assets.remove</operaton:string></operaton:field><operaton:field name="operation"><operaton:string>remove</operaton:string></operaton:field><operaton:field name="mode"><operaton:string>submit</operaton:string></operaton:field><operaton:field name="inputs"><operaton:string>assetId</operaton:string></operaton:field><operaton:field name="resultPrefix"><operaton:string>remove</operaton:string></operaton:field><operaton:field name="step"><operaton:string>remove</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="as_end" name="Disposed"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <sequenceFlow id="asset_lifecycle_f1" sourceRef="as_start" targetRef="as_defaults"/>
    <sequenceFlow id="asset_lifecycle_f2" sourceRef="as_defaults" targetRef="as_register"/>
    <sequenceFlow id="asset_lifecycle_f3" sourceRef="as_register" targetRef="as_cycle"/>
    <sequenceFlow id="asset_lifecycle_f4" sourceRef="as_cycle" targetRef="as_maintain"/>
    <sequenceFlow id="asset_lifecycle_f5" sourceRef="as_maintain" targetRef="as_gw"/>
    <sequenceFlow id="asset_lifecycle_f6" name="fit" sourceRef="as_gw" targetRef="as_cycle"><conditionExpression xsi:type="tFormalExpression">${conditionDecision == 'fit'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="asset_lifecycle_f7" name="condemn" sourceRef="as_gw" targetRef="as_board"/>
    <sequenceFlow id="asset_lifecycle_f8" sourceRef="as_board" targetRef="as_survey"/>
    <sequenceFlow id="asset_lifecycle_f9" sourceRef="as_survey" targetRef="as_boardGw"/>
    <sequenceFlow id="asset_lifecycle_f10" name="keep in use" sourceRef="as_boardGw" targetRef="as_cycle"><conditionExpression xsi:type="tFormalExpression">${!committeeApproved}</conditionExpression></sequenceFlow>
    <sequenceFlow id="asset_lifecycle_f11" name="condemn" sourceRef="as_boardGw" targetRef="as_sanction"/>
    <sequenceFlow id="asset_lifecycle_f12" sourceRef="as_rj_reject" targetRef="as_rj_endRejected"/>
    <sequenceFlow id="asset_lifecycle_f13" name="SANCTIONED" sourceRef="as_sanGw" targetRef="as_list"><conditionExpression xsi:type="tFormalExpression">${sanctionOutcome == 'SANCTIONED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="asset_lifecycle_f14" name="otherwise" sourceRef="as_sanGw" targetRef="as_rj_reject"/>
    <sequenceFlow id="asset_lifecycle_f15" sourceRef="as_sanction" targetRef="as_sanGw"/>
    <sequenceFlow id="asset_lifecycle_f16" sourceRef="as_list" targetRef="as_auctionWindow"/>
    <sequenceFlow id="asset_lifecycle_f17" sourceRef="as_auctionWindow" targetRef="as_wait"/>
    <sequenceFlow id="asset_lifecycle_f18" sourceRef="as_wait" targetRef="as_sold"/>
    <sequenceFlow id="asset_lifecycle_f19" sourceRef="as_wait" targetRef="as_unsold"/>
    <sequenceFlow id="asset_lifecycle_f20" sourceRef="as_unsold" targetRef="as_relist"/>
    <sequenceFlow id="asset_lifecycle_f21" sourceRef="as_relist" targetRef="as_list"/>
    <sequenceFlow id="asset_lifecycle_f22" sourceRef="as_sold" targetRef="as_remove"/>
    <sequenceFlow id="asset_lifecycle_f23" sourceRef="as_remove" targetRef="as_end"/>
    <subProcess id="as_loss" name="Loss / accident report" triggeredByEvent="true">
      <startEvent id="as_lossStart" name="Loss reported" isInterrupting="false"><messageEventDefinition messageRef="msg_sangam_assetLost"/></startEvent>
      <userTask id="as_lossReport" name="Report loss or accident" operaton:candidateGroups="${assetOfficerSeat}" operaton:formKey="sangam:assets/loss"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"></operaton:taskListener></extensionElements></userTask>
      <endEvent id="as_lossEnd" name="Reported"></endEvent>
      <sequenceFlow id="asset_lifecycle_f24" sourceRef="as_lossStart" targetRef="as_lossReport"/>
      <sequenceFlow id="asset_lifecycle_f25" sourceRef="as_lossReport" targetRef="as_lossEnd"/>
    </subProcess>
  </process>
  <bpmndi:BPMNDiagram id="asset_lifecycle_diagram">
    <bpmndi:BPMNPlane id="asset_lifecycle_plane" bpmnElement="sangam-asset-lifecycle">
      <bpmndi:BPMNShape id="as_start_di" bpmnElement="as_start"><dc:Bounds x="52" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="as_defaults_di" bpmnElement="as_defaults"><dc:Bounds x="185" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="as_register_di" bpmnElement="as_register"><dc:Bounds x="350" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="as_cycle_di" bpmnElement="as_cycle"><dc:Bounds x="547" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="as_maintain_di" bpmnElement="as_maintain"><dc:Bounds x="680" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="as_gw_di" bpmnElement="as_gw"><dc:Bounds x="870" y="45" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="as_board_di" bpmnElement="as_board"><dc:Bounds x="1010" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="as_survey_di" bpmnElement="as_survey"><dc:Bounds x="1175" y="30" width="100" height="80"/></bpmndi:BPMNShape>
