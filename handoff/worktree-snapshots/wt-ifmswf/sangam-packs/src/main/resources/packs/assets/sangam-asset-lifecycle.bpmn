      <bpmndi:BPMNShape id="as_list_di" bpmnElement="as_list"><dc:Bounds x="1835" y="155" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="as_rj_reject_di" bpmnElement="as_rj_reject"><dc:Bounds x="1835" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="as_rj_endRejected_di" bpmnElement="as_rj_endRejected"><dc:Bounds x="2032" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="as_sanGw_di" bpmnElement="as_sanGw"><dc:Bounds x="1695" y="45" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="as_auctionWindow_di" bpmnElement="as_auctionWindow"><dc:Bounds x="2000" y="155" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="as_wait_di" bpmnElement="as_wait"><dc:Bounds x="2190" y="170" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="as_sold_di" bpmnElement="as_sold"><dc:Bounds x="2362" y="302" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="as_unsold_di" bpmnElement="as_unsold"><dc:Bounds x="2362" y="177" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="as_relist_di" bpmnElement="as_relist"><dc:Bounds x="2495" y="155" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="as_remove_di" bpmnElement="as_remove"><dc:Bounds x="2495" y="280" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="as_end_di" bpmnElement="as_end"><dc:Bounds x="2692" y="302" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="as_loss_di" bpmnElement="as_loss" isExpanded="true"><dc:Bounds x="30" y="410" width="458" height="150"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="as_lossStart_di" bpmnElement="as_lossStart"><dc:Bounds x="92" y="472" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="as_lossReport_di" bpmnElement="as_lossReport"><dc:Bounds x="225" y="450" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="as_lossEnd_di" bpmnElement="as_lossEnd"><dc:Bounds x="422" y="472" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="asset_lifecycle_f1_di" bpmnElement="asset_lifecycle_f1"><di:waypoint x="88" y="70"/><di:waypoint x="185" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="asset_lifecycle_f2_di" bpmnElement="asset_lifecycle_f2"><di:waypoint x="285" y="70"/><di:waypoint x="350" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="asset_lifecycle_f3_di" bpmnElement="asset_lifecycle_f3"><di:waypoint x="450" y="70"/><di:waypoint x="547" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="asset_lifecycle_f4_di" bpmnElement="asset_lifecycle_f4"><di:waypoint x="583" y="70"/><di:waypoint x="680" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="asset_lifecycle_f5_di" bpmnElement="asset_lifecycle_f5"><di:waypoint x="780" y="70"/><di:waypoint x="870" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="asset_lifecycle_f6_di" bpmnElement="asset_lifecycle_f6"><di:waypoint x="895" y="95"/><di:waypoint x="895" y="120"/><di:waypoint x="565" y="120"/><di:waypoint x="565" y="88"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="asset_lifecycle_f7_di" bpmnElement="asset_lifecycle_f7"><di:waypoint x="920" y="70"/><di:waypoint x="1010" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="asset_lifecycle_f8_di" bpmnElement="asset_lifecycle_f8"><di:waypoint x="1110" y="70"/><di:waypoint x="1175" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="asset_lifecycle_f9_di" bpmnElement="asset_lifecycle_f9"><di:waypoint x="1275" y="70"/><di:waypoint x="1365" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="asset_lifecycle_f10_di" bpmnElement="asset_lifecycle_f10"><di:waypoint x="1390" y="95"/><di:waypoint x="1390" y="120"/><di:waypoint x="565" y="120"/><di:waypoint x="565" y="88"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="asset_lifecycle_f11_di" bpmnElement="asset_lifecycle_f11"><di:waypoint x="1415" y="70"/><di:waypoint x="1505" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="asset_lifecycle_f12_di" bpmnElement="asset_lifecycle_f12"><di:waypoint x="1935" y="70"/><di:waypoint x="2032" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="asset_lifecycle_f13_di" bpmnElement="asset_lifecycle_f13"><di:waypoint x="1745" y="70"/><di:waypoint x="1790" y="70"/><di:waypoint x="1790" y="195"/><di:waypoint x="1835" y="195"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="asset_lifecycle_f14_di" bpmnElement="asset_lifecycle_f14"><di:waypoint x="1745" y="70"/><di:waypoint x="1835" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="asset_lifecycle_f15_di" bpmnElement="asset_lifecycle_f15"><di:waypoint x="1605" y="70"/><di:waypoint x="1695" y="70"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="asset_lifecycle_f16_di" bpmnElement="asset_lifecycle_f16"><di:waypoint x="1935" y="195"/><di:waypoint x="2000" y="195"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="asset_lifecycle_f17_di" bpmnElement="asset_lifecycle_f17"><di:waypoint x="2100" y="195"/><di:waypoint x="2190" y="195"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="asset_lifecycle_f18_di" bpmnElement="asset_lifecycle_f18"><di:waypoint x="2240" y="195"/><di:waypoint x="2301" y="195"/><di:waypoint x="2301" y="320"/><di:waypoint x="2362" y="320"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="asset_lifecycle_f19_di" bpmnElement="asset_lifecycle_f19"><di:waypoint x="2240" y="195"/><di:waypoint x="2362" y="195"/></bpmndi:BPMNEdge>
