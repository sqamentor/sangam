    <sequenceFlow id="ifms_pao_chain_f21" sourceRef="pc_aao_warnNotify" targetRef="pc_aao_warnEnd"/>
    <sequenceFlow id="ifms_pao_chain_f22" sourceRef="pc_aao_breach" targetRef="pc_aao_breachAct"/>
    <sequenceFlow id="ifms_pao_chain_f23" sourceRef="pc_aao_breachAct" targetRef="pc_aao_breachGw"/>
    <sequenceFlow id="ifms_pao_chain_f24" name="deemed" sourceRef="pc_aao_breachGw" targetRef="pc_aao_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_pao_chain_f25" name="escalated" sourceRef="pc_aao_breachGw" targetRef="pc_aao_slaPlan"/>
    <sequenceFlow id="ifms_pao_chain_f26" sourceRef="pc_aao_slaPlan" targetRef="pc_aao"/>
