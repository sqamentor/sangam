    <sequenceFlow id="ifms_pao_chain_f28" sourceRef="pc_pao_warn" targetRef="pc_pao_warnNotify"/>
    <sequenceFlow id="ifms_pao_chain_f29" sourceRef="pc_pao_warnNotify" targetRef="pc_pao_warnEnd"/>
    <sequenceFlow id="ifms_pao_chain_f30" sourceRef="pc_pao_breach" targetRef="pc_pao_breachAct"/>
    <sequenceFlow id="ifms_pao_chain_f31" sourceRef="pc_pao_breachAct" targetRef="pc_pao_breachGw"/>
    <sequenceFlow id="ifms_pao_chain_f32" name="deemed" sourceRef="pc_pao_breachGw" targetRef="pc_pao_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_pao_chain_f33" name="escalated" sourceRef="pc_pao_breachGw" targetRef="pc_pao_slaPlan"/>
