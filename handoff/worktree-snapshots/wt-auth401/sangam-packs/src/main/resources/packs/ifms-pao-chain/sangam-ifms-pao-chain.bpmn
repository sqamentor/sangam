    <sequenceFlow id="ifms_pao_chain_f8" name="deemed" sourceRef="pc_distribute_breachGw" targetRef="pc_distribute_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_pao_chain_f9" name="escalated" sourceRef="pc_distribute_breachGw" targetRef="pc_distribute_slaPlan"/>
