    <sequenceFlow id="ifms_pao_chain_f41" name="object" sourceRef="pc_paoGw" targetRef="pc_memo"><conditionExpression xsi:type="tFormalExpression">${paoDecision == 'object'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_pao_chain_f42" name="return (PAO only)" sourceRef="pc_paoGw" targetRef="pc_returned"><conditionExpression xsi:type="tFormalExpression">${paoDecision == 'returnBill'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_pao_chain_f43" sourceRef="pc_memo" targetRef="pc_objected"/>
    <sequenceFlow id="ifms_pao_chain_f44" name="pass" sourceRef="pc_paoGw" targetRef="pc_sigGw"/>
