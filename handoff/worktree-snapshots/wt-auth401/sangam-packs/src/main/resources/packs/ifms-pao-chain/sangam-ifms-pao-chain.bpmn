    <boundaryEvent id="pc_second_breach" name="SLA breached" attachedToRef="pc_second" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${pc_secondDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="ifms_pao_chain_f1" sourceRef="pc_start" targetRef="pc_defaults"/>
