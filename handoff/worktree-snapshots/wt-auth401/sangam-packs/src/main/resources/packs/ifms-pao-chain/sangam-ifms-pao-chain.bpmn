    <sequenceFlow id="ifms_pao_chain_f16" name="deemed" sourceRef="pc_dealing_breachGw" targetRef="pc_dealing_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_pao_chain_f17" name="escalated" sourceRef="pc_dealing_breachGw" targetRef="pc_dealing_slaPlan"/>
