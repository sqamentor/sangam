    <boundaryEvent id="pc_distribute_breach" name="SLA breached" attachedToRef="pc_distribute" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${pc_distributeDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="pc_dealing_warn" name="SLA warning (75%)" attachedToRef="pc_dealing" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${pc_dealingWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
