<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.sangam</groupId>
    <artifactId>sangam-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>sangam-ops</artifactId>
  <name>Sangam operations: migrators, usage metrics, global search, outlier analysis, index, variables, secrets, sequences, retention</name>

  <dependencies>
    <dependency>
      <groupId>org.sangam</groupId>
      <artifactId>sangam-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.sangam</groupId>
      <artifactId>sangam-integration</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <!-- Global task listeners attach through the parse listener. Apache-2.0. Provided by sangam-engine at runtime. -->
    <dependency>
      <groupId>org.operaton.bpm</groupId>
      <artifactId>operaton-engine</artifactId>
      <optional>true</optional>
    </dependency>
    <!-- Tests only: the production visibility binding (PolicyCompiler) for the A-13 deny test. -->
    <dependency>
      <groupId>org.sangam</groupId>
      <artifactId>sangam-security</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Tests only: the PostgreSQL integration test (*IT, failsafe, profile sangam-db-it) applies the product
         Liquibase changelog of sangam-persistence to a PostgreSQL 17 container. -->
    <dependency>
      <groupId>org.sangam</groupId>
      <artifactId>sangam-persistence</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <!-- Database integration tests: -Dsangam.db=postgres runs BulkIngestPostgresIT (Docker needed). -->
    <profile>
      <id>sangam-db-it</id>
      <activation>
        <property>
          <name>sangam.db</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <sangam.db>${sangam.db}</sangam.db>
                <api.version>1.44</api.version>
              </systemPropertyVariables>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
