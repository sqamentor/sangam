<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_up10_priority" name="Incident priority matrix" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="up10-priority" name="Incident priority matrix" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="up10-priority_t" hitPolicy="FIRST">
      <input id="up10-priority_i0" label="Priority"><inputExpression id="up10-priority_ie0" typeRef="string"><text>priority</text></inputExpression></input>
      <output id="up10-priority_o0" label="Resolver group" name="resolverGroup" typeRef="string"/>
      <output id="up10-priority_o1" label="SLA" name="slaSpec" typeRef="string"/>
      <output id="up10-priority_o2" label="Major" name="majorIncident" typeRef="boolean"/>
      <rule id="up10-priority_r0">
        <inputEntry id="up10-priority_r0_i0"><text>"P1"</text></inputEntry>
        <outputEntry id="up10-priority_r0_o0"><text>"L2-SUPPORT"</text></outputEntry>
        <outputEntry id="up10-priority_r0_o1"><text>"PT1H"</text></outputEntry>
        <outputEntry id="up10-priority_r0_o2"><text>true</text></outputEntry>
      </rule>
      <rule id="up10-priority_r1">
        <inputEntry id="up10-priority_r1_i0"><text>"P2"</text></inputEntry>
        <outputEntry id="up10-priority_r1_o0"><text>"L2-SUPPORT"</text></outputEntry>
        <outputEntry id="up10-priority_r1_o1"><text>"4WH"</text></outputEntry>
        <outputEntry id="up10-priority_r1_o2"><text>false</text></outputEntry>
      </rule>
      <rule id="up10-priority_r2">
        <inputEntry id="up10-priority_r2_i0"><text>-</text></inputEntry>
        <outputEntry id="up10-priority_r2_o0"><text>"L1-SUPPORT"</text></outputEntry>
        <outputEntry id="up10-priority_r2_o1"><text>"2WD"</text></outputEntry>
        <outputEntry id="up10-priority_r2_o2"><text>false</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
