<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_sec_ins_health_tat" name="Health claim timelines (IRDAI Master Circular on Health Insurance 2024)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="sec-ins-health-tat" name="Health claim timelines (IRDAI Master Circular on Health Insurance 2024)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="sec-ins-health-tat_t" hitPolicy="FIRST">
      <input id="sec-ins-health-tat_i0" label="Admission type"><inputExpression id="sec-ins-health-tat_ie0" typeRef="string"><text>admissionType</text></inputExpression></input>
      <output id="sec-ins-health-tat_o0" label="Cashless decision within" name="preauthSpec" typeRef="string"/>
      <output id="sec-ins-health-tat_o1" label="Discharge authorisation within" name="dischargeSpec" typeRef="string"/>
      <output id="sec-ins-health-tat_o2" label="Reimbursement decision within" name="reimbursementSpec" typeRef="string"/>
      <rule id="sec-ins-health-tat_r0"><description>1 hour / 3 hours (primary); reimbursement 15 days (SYNTHETIC, within the 30-day limit)</description>
        <inputEntry id="sec-ins-health-tat_r0_i0"><text>-</text></inputEntry>
        <outputEntry id="sec-ins-health-tat_r0_o0"><text>"1H"</text></outputEntry>
        <outputEntry id="sec-ins-health-tat_r0_o1"><text>"3H"</text></outputEntry>
        <outputEntry id="sec-ins-health-tat_r0_o2"><text>"15D"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
