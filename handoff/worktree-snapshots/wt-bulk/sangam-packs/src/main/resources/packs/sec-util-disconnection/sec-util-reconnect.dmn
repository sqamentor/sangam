<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_sec_util_reconnect" name="Reconnection standard (SERC SoP; verify)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="sec-util-reconnect" name="Reconnection standard (SERC SoP; verify)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="sec-util-reconnect_t" hitPolicy="FIRST">
      <input id="sec-util-reconnect_i0" label="Area"><inputExpression id="sec-util-reconnect_ie0" typeRef="string"><text>areaType</text></inputExpression></input>
      <output id="sec-util-reconnect_o0" label="Reconnect within" name="reconnectSpec" typeRef="string"/>
      <rule id="sec-util-reconnect_r0">
        <inputEntry id="sec-util-reconnect_r0_i0"><text>"METRO"</text></inputEntry>
        <outputEntry id="sec-util-reconnect_r0_o0"><text>"6H"</text></outputEntry>
      </rule>
      <rule id="sec-util-reconnect_r1">
        <inputEntry id="sec-util-reconnect_r1_i0"><text>"MUNICIPAL"</text></inputEntry>
        <outputEntry id="sec-util-reconnect_r1_o0"><text>"12H"</text></outputEntry>
      </rule>
      <rule id="sec-util-reconnect_r2"><description>rural</description>
        <inputEntry id="sec-util-reconnect_r2_i0"><text>-</text></inputEntry>
        <outputEntry id="sec-util-reconnect_r2_o0"><text>"24H"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
