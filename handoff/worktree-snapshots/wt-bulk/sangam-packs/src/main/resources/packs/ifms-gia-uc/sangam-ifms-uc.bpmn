<!-- Utilisation certificate. Generated layout; edit freely in the Sangam modeller. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" xmlns:sangam="http://sangam.org/schema/1.0/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_ifms_uc" targetNamespace="http://sangam.org/packs" exporter="sangam-packs" exporterVersion="1.0.0">
  <message id="msg_sangam_ifms_ucSubmitted" name="sangam.ifms.ucSubmitted"/>
  <process id="sangam-ifms-uc" name="Utilisation certificate" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>gov.ifms.gia-uc</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.0</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>grantee,amount</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="uc_start" name="UC due"></startEvent>
    <serviceTask id="uc_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>ucDue=P365D;granteeSeat=HOO-1;programmeSeat=FA-1;ucForm=GFR-12A</operaton:string></operaton:field></extensionElements></serviceTask>
    <intermediateCatchEvent id="uc_received" name="UC submitted by the grantee"><messageEventDefinition messageRef="msg_sangam_ifms_ucSubmitted"/></intermediateCatchEvent>
    <intermediateCatchEvent id="uc_overdue" name="UC overdue (12 months after the year)"><timerEventDefinition><timeDuration xsi:type="tFormalExpression">P365D</timeDuration></timerEventDefinition></intermediateCatchEvent>
    <eventBasedGateway id="uc_wait" name=""></eventBasedGateway>
    <serviceTask id="uc_review_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>uc_review</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>10WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="uc_review" name="Review UC" operaton:candidateGroups="${programmeSeat}" operaton:formKey="sangam:ifms-gia-uc/uc-review" operaton:dueDate="${uc_reviewDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>ucDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="uc_review_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>uc_review</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>programmeSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="uc_review_warnEnd" name="Warned"></endEvent>
    <serviceTask id="uc_review_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>uc_review</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>programmeSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>ucDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="uc_review_breachGw" name="Deemed?" default="ifms_uc_f10"></exclusiveGateway>
    <exclusiveGateway id="uc_review_done" name=""></exclusiveGateway>
    <serviceTask id="uc_default_slaPlan" name="Start SLA clock" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>PLAN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>uc_default</operaton:string></operaton:field><operaton:field name="defaultSpec"><operaton:string>5WD</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="uc_default" name="UC not received: remind or blacklist" operaton:candidateGroups="${programmeSeat}" operaton:formKey="sangam:ifms-gia-uc/uc-default" operaton:dueDate="${uc_defaultDueAt}"><extensionElements><operaton:taskListener event="complete" class="org.sangam.packs.core.ActorRecorderListener"><operaton:field name="decisionVar"><operaton:string>defaultDecision</operaton:string></operaton:field></operaton:taskListener></extensionElements></userTask>
    <serviceTask id="uc_default_warnNotify" name="SLA warning" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>WARN</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>uc_default</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>programmeSeat</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="uc_default_warnEnd" name="Warned"></endEvent>
    <serviceTask id="uc_default_breachAct" name="Escalate or deem" operaton:class="org.sangam.packs.core.SlaDelegate"><extensionElements><operaton:field name="op"><operaton:string>BREACH</operaton:string></operaton:field><operaton:field name="clock"><operaton:string>uc_default</operaton:string></operaton:field><operaton:field name="onBreach"><operaton:string>ESCALATE</operaton:string></operaton:field><operaton:field name="seatVar"><operaton:string>programmeSeat</operaton:string></operaton:field><operaton:field name="decisionVar"><operaton:string>defaultDecision</operaton:string></operaton:field><operaton:field name="approveValue"><operaton:string>approve</operaton:string></operaton:field><operaton:field name="refuseValue"><operaton:string>reject</operaton:string></operaton:field></extensionElements></serviceTask>
    <exclusiveGateway id="uc_default_breachGw" name="Deemed?" default="ifms_uc_f19"></exclusiveGateway>
    <exclusiveGateway id="uc_default_done" name=""></exclusiveGateway>
    <exclusiveGateway id="uc_defGw" name="" default="ifms_uc_f25"></exclusiveGateway>
    <endEvent id="uc_blacklisted" name="Grantee blacklisted"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>REJECTED</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <exclusiveGateway id="uc_accGw" name="" default="ifms_uc_f28"></exclusiveGateway>
    <endEvent id="uc_end" name="UC accepted"><extensionElements><operaton:executionListener event="end" class="org.sangam.packs.core.BatchItemOutcomeListener"><operaton:field name="outcome"><operaton:string>SUCCESS</operaton:string></operaton:field></operaton:executionListener></extensionElements></endEvent>
    <boundaryEvent id="uc_review_warn" name="SLA warning (75%)" attachedToRef="uc_review" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${uc_reviewWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="uc_review_breach" name="SLA breached" attachedToRef="uc_review" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${uc_reviewDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="uc_default_warn" name="SLA warning (75%)" attachedToRef="uc_default" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${uc_defaultWarnAt}</timeDate></timerEventDefinition></boundaryEvent>
    <boundaryEvent id="uc_default_breach" name="SLA breached" attachedToRef="uc_default" cancelActivity="true"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${uc_defaultDueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <sequenceFlow id="ifms_uc_f1" sourceRef="uc_start" targetRef="uc_defaults"/>
    <sequenceFlow id="ifms_uc_f2" sourceRef="uc_defaults" targetRef="uc_wait"/>
    <sequenceFlow id="ifms_uc_f3" sourceRef="uc_wait" targetRef="uc_received"/>
    <sequenceFlow id="ifms_uc_f4" sourceRef="uc_wait" targetRef="uc_overdue"/>
    <sequenceFlow id="ifms_uc_f5" sourceRef="uc_review_warn" targetRef="uc_review_warnNotify"/>
    <sequenceFlow id="ifms_uc_f6" sourceRef="uc_review_warnNotify" targetRef="uc_review_warnEnd"/>
    <sequenceFlow id="ifms_uc_f7" sourceRef="uc_review_breach" targetRef="uc_review_breachAct"/>
    <sequenceFlow id="ifms_uc_f8" sourceRef="uc_review_breachAct" targetRef="uc_review_breachGw"/>
    <sequenceFlow id="ifms_uc_f9" name="deemed" sourceRef="uc_review_breachGw" targetRef="uc_review_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_uc_f10" name="escalated" sourceRef="uc_review_breachGw" targetRef="uc_review_slaPlan"/>
    <sequenceFlow id="ifms_uc_f11" sourceRef="uc_review_slaPlan" targetRef="uc_review"/>
    <sequenceFlow id="ifms_uc_f12" sourceRef="uc_review" targetRef="uc_review_done"/>
    <sequenceFlow id="ifms_uc_f13" sourceRef="uc_received" targetRef="uc_review_slaPlan"/>
    <sequenceFlow id="ifms_uc_f14" sourceRef="uc_default_warn" targetRef="uc_default_warnNotify"/>
    <sequenceFlow id="ifms_uc_f15" sourceRef="uc_default_warnNotify" targetRef="uc_default_warnEnd"/>
    <sequenceFlow id="ifms_uc_f16" sourceRef="uc_default_breach" targetRef="uc_default_breachAct"/>
    <sequenceFlow id="ifms_uc_f17" sourceRef="uc_default_breachAct" targetRef="uc_default_breachGw"/>
    <sequenceFlow id="ifms_uc_f18" name="deemed" sourceRef="uc_default_breachGw" targetRef="uc_default_done"><conditionExpression xsi:type="tFormalExpression">${slaAction == 'DEEMED'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_uc_f19" name="escalated" sourceRef="uc_default_breachGw" targetRef="uc_default_slaPlan"/>
    <sequenceFlow id="ifms_uc_f20" sourceRef="uc_default_slaPlan" targetRef="uc_default"/>
    <sequenceFlow id="ifms_uc_f21" sourceRef="uc_default" targetRef="uc_default_done"/>
    <sequenceFlow id="ifms_uc_f22" sourceRef="uc_overdue" targetRef="uc_default_slaPlan"/>
    <sequenceFlow id="ifms_uc_f23" sourceRef="uc_default_done" targetRef="uc_defGw"/>
    <sequenceFlow id="ifms_uc_f24" name="remind" sourceRef="uc_defGw" targetRef="uc_wait"><conditionExpression xsi:type="tFormalExpression">${defaultDecision == 'remind'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_uc_f25" name="blacklist" sourceRef="uc_defGw" targetRef="uc_blacklisted"/>
    <sequenceFlow id="ifms_uc_f26" sourceRef="uc_review_done" targetRef="uc_accGw"/>
    <sequenceFlow id="ifms_uc_f27" name="accepted" sourceRef="uc_accGw" targetRef="uc_end"><conditionExpression xsi:type="tFormalExpression">${ucDecision == 'accepted'}</conditionExpression></sequenceFlow>
    <sequenceFlow id="ifms_uc_f28" name="further action" sourceRef="uc_accGw" targetRef="uc_wait"/>
  </process>
