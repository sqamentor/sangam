<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_sec_ushealth_discharge_clocks" name="Discharge notice timeframes (42 CFR 405.1205, 489.20(y); tenant overridable)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <!-- US-HLT-125…131. -->
  <decision id="sec-ushealth-discharge-clocks" name="Discharge notice timeframes (42 CFR 405.1205, 489.20(y); tenant overridable)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="sec-ushealth-discharge-clocks_t" hitPolicy="FIRST">
      <input id="sec-ushealth-discharge-clocks_i0" label="Medicare beneficiary"><inputExpression id="sec-ushealth-discharge-clocks_ie0" typeRef="boolean"><text>medicareBeneficiary</text></inputExpression></input>
      <output id="sec-ushealth-discharge-clocks_o0" label="IM within" name="imAdmissionSpec" typeRef="string"/>
      <output id="sec-ushealth-discharge-clocks_o1" label="MOON within" name="moonSpec" typeRef="string"/>
      <output id="sec-ushealth-discharge-clocks_o2" label="Screen within (SYNTHETIC policy)" name="screenSpec" typeRef="string"/>
      <rule id="sec-ushealth-discharge-clocks_r0"><description>IM 2 calendar days; MOON 36 hours</description>
        <inputEntry id="sec-ushealth-discharge-clocks_r0_i0"><text>-</text></inputEntry>
        <outputEntry id="sec-ushealth-discharge-clocks_r0_o0"><text>"2D"</text></outputEntry>
        <outputEntry id="sec-ushealth-discharge-clocks_r0_o1"><text>"36H"</text></outputEntry>
        <outputEntry id="sec-ushealth-discharge-clocks_r0_o2"><text>"24H"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
