<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_ifms_formulation_authority" name="Competent authority" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <decision id="ifms-formulation-authority" name="Competent authority" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="ifms-formulation-authority_t" hitPolicy="FIRST">
      <input id="ifms-formulation-authority_i0" label="Amount (INR)"><inputExpression id="ifms-formulation-authority_ie0" typeRef="number"><text>amount</text></inputExpression></input>
      <output id="ifms-formulation-authority_o0" label="Competent role" name="competentRole" typeRef="string"/>
      <rule id="ifms-formulation-authority_r0"><description>Secretary approves the department estimates</description>
        <inputEntry id="ifms-formulation-authority_r0_i0"><text>-</text></inputEntry>
        <outputEntry id="ifms-formulation-authority_r0_o0"><text>"CAA"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
