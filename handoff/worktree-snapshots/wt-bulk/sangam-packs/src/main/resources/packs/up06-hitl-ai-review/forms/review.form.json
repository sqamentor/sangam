  "decision": {
    "variable": "reviewDecision",
    "required": true,
    "options": [
      {
        "value": "approve",
        "label": {
          "en": "Approve / sanction",
          "hi": "अनुमोदित / स्वीकृत करें"
        }
      },
      {
        "value": "edit",
        "label": {
          "en": "Edit and approve",
          "hi": "संपादित कर अनुमोदित करें"
        }
      },
      {
        "value": "reject",
        "label": {
          "en": "Reject",
          "hi": "अस्वीकार करें"
        }
      }
    ]
  }
