      "hi": "प्रकरण का विवरण"
    }
  },
  "fields": [
    {
      "id": "confidence",
      "type": "readonly",
      "required": false,
      "label": {
        "en": "Extraction confidence",
        "hi": "निष्कर्षण विश्वास स्तर"
      }
    },
    {
      "id": "extractedFields",
      "type": "json",
      "required": false,
      "label": {
        "en": "Extracted fields (JSON)",
        "hi": "निकाले गए फ़ील्ड"
      }
    },
    {
      "id": "correctedFields",
      "type": "json",
      "required": false,
      "label": {
        "en": "Corrected fields (JSON)",
        "hi": "सुधारे गए फ़ील्ड"
      }
    },
    {
      "id": "remarks",
      "type": "text",
      "required": false,
      "label": {
        "en": "Remarks",
        "hi": "टिप्पणी"
      }
    }
