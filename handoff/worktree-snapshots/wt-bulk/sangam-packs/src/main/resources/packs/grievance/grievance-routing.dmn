<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_grievance_routing" name="Grievance routing and resolution time" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <!-- CPGRAMS reform (2024) targets 21 days; synthetic roles. -->
  <decision id="grievance-routing" name="Grievance routing and resolution time" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <decisionTable id="grievance-routing_t" hitPolicy="FIRST">
      <input id="grievance-routing_i0" label="Category"><inputExpression id="grievance-routing_ie0" typeRef="string"><text>category</text></inputExpression></input>
      <output id="grievance-routing_o0" label="Grievance officer role" name="groRole" typeRef="string"/>
      <output id="grievance-routing_o1" label="Resolution time" name="resolutionSla" typeRef="string"/>
      <rule id="grievance-routing_r0">
        <inputEntry id="grievance-routing_r0_i0"><text>"PENSION"</text></inputEntry>
        <outputEntry id="grievance-routing_r0_o0"><text>"GRO-PENSION"</text></outputEntry>
        <outputEntry id="grievance-routing_r0_o1"><text>"21D"</text></outputEntry>
      </rule>
      <rule id="grievance-routing_r1">
        <inputEntry id="grievance-routing_r1_i0"><text>"SERVICE"</text></inputEntry>
        <outputEntry id="grievance-routing_r1_o0"><text>"GRO"</text></outputEntry>
        <outputEntry id="grievance-routing_r1_o1"><text>"21D"</text></outputEntry>
      </rule>
      <rule id="grievance-routing_r2"><description>vigilance</description>
        <inputEntry id="grievance-routing_r2_i0"><text>"CORRUPTION"</text></inputEntry>
        <outputEntry id="grievance-routing_r2_o0"><text>"CVO"</text></outputEntry>
        <outputEntry id="grievance-routing_r2_o1"><text>"30D"</text></outputEntry>
      </rule>
      <rule id="grievance-routing_r3">
        <inputEntry id="grievance-routing_r3_i0"><text>-</text></inputEntry>
        <outputEntry id="grievance-routing_r3_o0"><text>"GRO"</text></outputEntry>
        <outputEntry id="grievance-routing_r3_o1"><text>"21D"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
