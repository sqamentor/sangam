{
  "id": "sec.ushealth.breach",
  "version": "1.0.0",
  "name": {
    "en": "HIPAA breach notification",
    "es": "Notificación de violaciones de HIPAA"
  },
  "domain": "Healthcare (USA)",
  "description": "Incident logged with the date of discovery, four-factor risk assessment (breach presumed unless low probability is documented), law-enforcement delay, notices to individuals within 60 days of discovery (substitute notice when contacts are out of date), media notice when more than 500 residents of a state are affected, HHS notice with the individual notices for 500 or more, or in the annual log within 60 days after the calendar year end for fewer; business-associate reports; documentation kept 6 years. All limits in DMN (state laws override).",
