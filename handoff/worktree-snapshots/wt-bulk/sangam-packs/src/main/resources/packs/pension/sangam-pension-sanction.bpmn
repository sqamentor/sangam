      <bpmndi:BPMNShape id="ps_objGw_di" bpmnElement="ps_objGw"><dc:Bounds x="3015" y="45" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ps_objVersion_di" bpmnElement="ps_objVersion"><dc:Bounds x="3155" y="155" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ps_wd_kind_di" bpmnElement="ps_wd_kind"><dc:Bounds x="3155" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ps_wd_call_di" bpmnElement="ps_wd_call"><dc:Bounds x="3320" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ps_wd_end_di" bpmnElement="ps_wd_end"><dc:Bounds x="3517" y="52" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ps_roll_di" bpmnElement="ps_roll"><dc:Bounds x="2990" y="155" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ps_close_di" bpmnElement="ps_close"><dc:Bounds x="3155" y="280" width="100" height="80"/></bpmndi:BPMNShape>
