      <bpmndi:BPMNShape id="ps_ag_di" bpmnElement="ps_ag"><dc:Bounds x="2495" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ps_sanGw_di" bpmnElement="ps_sanGw"><dc:Bounds x="2355" y="45" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ps_objection_di" bpmnElement="ps_objection"><dc:Bounds x="2825" y="30" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ps_ppo_di" bpmnElement="ps_ppo"><dc:Bounds x="2825" y="155" width="100" height="80"/></bpmndi:BPMNShape>
