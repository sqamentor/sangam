<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<!-- Sangam compliance pack (jurisdiction-neutral). Timelines arrive as process variables computed from the jurisdiction pack. No diagram layout yet. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:operaton="http://operaton.org/schema/1.0/bpmn" id="defs_sangam_dsr_accounting" targetNamespace="http://sangam.org/packs/compliance" exporter="sangam-compliance" exporterVersion="0.2.0">
  <process id="sangam-dsr-accounting" name="Accounting of disclosures" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.0">
    <documentation>Accounting right (US-HIPAA 45 CFR 164.528: 60 days, one 30-day extension, six-year look-back, TPO excluded). Optional extension before the due date.</documentation>
    <startEvent id="start" name="Request received"/>
    <serviceTask id="s_start" name="Mark in progress" operaton:class="org.sangam.compliance.bpmn.ComplianceStepDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="step"><operaton:string>rights.start</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="u_review" name="Review accounting (extend if needed)" operaton:candidateGroups="PRIVACY-OFFICER" operaton:formKey="sangam:compliance/accounting-review"></userTask>
    <boundaryEvent id="t_due" name="Due date" attachedToRef="u_review" cancelActivity="false"><timerEventDefinition><timeDate xsi:type="tFormalExpression">${dueAt}</timeDate></timerEventDefinition></boundaryEvent>
    <exclusiveGateway id="g_ext" name="Extension?" default="f_go"/>
    <serviceTask id="s_extend" name="Extend once with written notice" operaton:class="org.sangam.compliance.bpmn.ComplianceStepDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="step"><operaton:string>rights.extend</operaton:string></operaton:field></extensionElements></serviceTask>
    <userTask id="u_review2" name="Complete accounting" operaton:candidateGroups="PRIVACY-OFFICER" operaton:formKey="sangam:compliance/accounting-review"></userTask>
    <serviceTask id="s_acc" name="Build and send accounting" operaton:class="org.sangam.compliance.bpmn.ComplianceStepDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="step"><operaton:string>rights.accounting</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="end" name="Provided"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="s_start"/>
    <sequenceFlow id="f2" sourceRef="s_start" targetRef="u_review"/>
    <sequenceFlow id="f3" sourceRef="u_review" targetRef="g_ext"/>
    <sequenceFlow id="f_x" sourceRef="g_ext" targetRef="s_extend"><conditionExpression xsi:type="tFormalExpression">${extensionNeeded == true}</conditionExpression></sequenceFlow>
    <sequenceFlow id="f_x2" sourceRef="s_extend" targetRef="u_review2"/>
    <sequenceFlow id="f_x3" sourceRef="u_review2" targetRef="s_acc"/>
    <sequenceFlow id="f_go" sourceRef="g_ext" targetRef="s_acc"/>
    <sequenceFlow id="f4" sourceRef="s_acc" targetRef="end"/>
    <serviceTask id="esc" name="Escalate overdue request" operaton:class="org.sangam.compliance.bpmn.ComplianceStepDelegate" operaton:asyncBefore="true"><extensionElements><operaton:field name="step"><operaton:string>rights.escalate</operaton:string></operaton:field></extensionElements></serviceTask>
    <endEvent id="end_esc" name="Escalated"/>
    <sequenceFlow id="f_esc1" sourceRef="t_due" targetRef="esc"/>
    <sequenceFlow id="f_esc2" sourceRef="esc" targetRef="end_esc"/>
  </process>
</definitions>