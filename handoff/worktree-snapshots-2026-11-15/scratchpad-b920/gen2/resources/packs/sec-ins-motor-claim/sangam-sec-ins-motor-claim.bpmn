  <process id="sangam-sec-ins-motor-claim" name="Motor claim" isExecutable="true" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.1">
    <extensionElements><operaton:executionListener event="start" class="org.sangam.packs.core.PackStartListener"><operaton:field name="packId"><operaton:string>sec.ins.motor-claim</operaton:string></operaton:field><operaton:field name="packVersion"><operaton:string>1.0.1</operaton:string></operaton:field><operaton:field name="materialFields"><operaton:string>policyNo,vehicleRegNo,lossType,claimAmount</operaton:string></operaton:field></operaton:executionListener></extensionElements>
    <startEvent id="mc_start" name="Claim intimated (FNOL)" operaton:initiator="initiator" operaton:formKey="sangam:sec-ins-motor-claim/fnol"></startEvent>
    <serviceTask id="mc_defaults" name="Configuration" operaton:class="org.sangam.packs.core.SetVariablesDelegate"><extensionElements><operaton:field name="defaults"><operaton:string>vehicleRegNo=@policyNo;lossType=OWN_DAMAGE;claimAmount=@amount;fraudScore=10;totalLoss=false;amount=@claimAmount;caseType=CLAIM;routingDecisionKey=sec-ins-claim-authority;powersDecisionKey=sec-ins-claim-powers;sanctionSla=7D;executionConnector=claims.pay;executionStep=pay-claim;reconcileRequired=true;executionPayloadFields=policyNo,amount,garageId;garageId=REIMBURSEMENT;outputTemplate=settlement-letter;appellateSeat=GRIEVANCE-CELL;handlerSeat=CLAIMS-HANDLER</operaton:string></operaton:field></extensionElements></serviceTask>
