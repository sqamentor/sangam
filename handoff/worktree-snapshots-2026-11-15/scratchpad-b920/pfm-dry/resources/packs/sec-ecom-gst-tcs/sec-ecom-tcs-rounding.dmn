      <output id="sec-ecom-tcs-rounding_o4" label="Rounding unit (minor units)" name="quantumMinor" typeRef="number"/>
      <output id="sec-ecom-tcs-rounding_o5" label="Negative amounts" name="negatives" typeRef="string"/>
      <output id="sec-ecom-tcs-rounding_o6" label="Instalment that takes the remainder" name="residual" typeRef="string"/>
      <output id="sec-ecom-tcs-rounding_o7" label="Applied to" name="application" typeRef="string"/>
      <output id="sec-ecom-tcs-rounding_o8" label="Stage" name="stage" typeRef="string"/>
      <output id="sec-ecom-tcs-rounding_o9" label="Jurisdiction" name="jurisdiction" typeRef="string"/>
      <output id="sec-ecom-tcs-rounding_o10" label="Scheme" name="scheme" typeRef="string"/>
      <output id="sec-ecom-tcs-rounding_o11" label="Purpose" name="purpose" typeRef="string"/>
      <output id="sec-ecom-tcs-rounding_o12" label="Source" name="source" typeRef="string"/>
      <output id="sec-ecom-tcs-rounding_o13" label="Provision" name="provision" typeRef="string"/>
      <output id="sec-ecom-tcs-rounding_o14" label="Effective from" name="effectiveFrom" typeRef="string"/>
      <output id="sec-ecom-tcs-rounding_o15" label="Effective to" name="effectiveTo" typeRef="string"/>
      <rule id="sec-ecom-tcs-rounding_r0"><description>SYNTHETIC_DEMO demo-1</description>
        <inputEntry id="sec-ecom-tcs-rounding_r0_i0"><text>[date("1900-01-01")..date("9999-12-31")]</text></inputEntry>
        <outputEntry id="sec-ecom-tcs-rounding_r0_o0"><text>"sec-ecom-tcs-rounding"</text></outputEntry>
        <outputEntry id="sec-ecom-tcs-rounding_r0_o1"><text>"demo-1"</text></outputEntry>
        <outputEntry id="sec-ecom-tcs-rounding_r0_o2"><text>"SYNTHETIC_DEMO"</text></outputEntry>
        <outputEntry id="sec-ecom-tcs-rounding_r0_o3"><text>"HALF_UP"</text></outputEntry>
        <outputEntry id="sec-ecom-tcs-rounding_r0_o4"><text>100</text></outputEntry>
        <outputEntry id="sec-ecom-tcs-rounding_r0_o5"><text>"REFUSE"</text></outputEntry>
        <outputEntry id="sec-ecom-tcs-rounding_r0_o6"><text>""</text></outputEntry>
        <outputEntry id="sec-ecom-tcs-rounding_r0_o7"><text>"TOTAL"</text></outputEntry>
        <outputEntry id="sec-ecom-tcs-rounding_r0_o8"><text>"per seller per month, single total (no CGST / SGST / IGST split)"</text></outputEntry>
        <outputEntry id="sec-ecom-tcs-rounding_r0_o9"><text>"any (demonstration)"</text></outputEntry>
        <outputEntry id="sec-ecom-tcs-rounding_r0_o10"><text>"demonstration"</text></outputEntry>
        <outputEntry id="sec-ecom-tcs-rounding_r0_o11"><text>"tax collected at source by the operator on net taxable supplies"</text></outputEntry>
        <outputEntry id="sec-ecom-tcs-rounding_r0_o12"><text>"none found (SYNTHETIC_DEMO: not a statutory or contractual rule; deploy the confirmed policy as a tenant override)"</text></outputEntry>
        <outputEntry id="sec-ecom-tcs-rounding_r0_o13"><text>"CGST Act 2017 s.170 rounds a sum payable to the nearest rupee (50 paise or more up); the stage at which it applies to TCS (per seller and per tax head) was not verified"</text></outputEntry>
        <outputEntry id="sec-ecom-tcs-rounding_r0_o14"><text>"1900-01-01"</text></outputEntry>
        <outputEntry id="sec-ecom-tcs-rounding_r0_o15"><text>"9999-12-31"</text></outputEntry>
      </rule>
    </decisionTable>
