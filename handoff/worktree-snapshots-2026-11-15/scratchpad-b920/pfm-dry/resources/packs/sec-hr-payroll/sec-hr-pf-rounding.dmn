<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:operaton="http://operaton.org/schema/1.0/dmn" id="defs_sec_hr_pf_rounding" name="PF contribution rounding (EPF Scheme) (decision 139 rounding policy)" namespace="http://sangam.org/packs">
  <!-- SPDX-License-Identifier: Apache-2.0 -->
  <!-- Decision 139 rounding policy, generated from tools/packgen/rounding.py -->
  <decision id="sec-hr-pf-rounding" name="PF contribution rounding (EPF Scheme) (decision 139 rounding policy)" operaton:historyTimeToLive="3650" operaton:versionTag="1.0.1">
    <decisionTable id="sec-hr-pf-rounding_t" hitPolicy="UNIQUE">
      <input id="sec-hr-pf-rounding_i0" label="As of"><inputExpression id="sec-hr-pf-rounding_ie0" typeRef="date"><text>date(asOfDate)</text></inputExpression></input>
      <output id="sec-hr-pf-rounding_o0" label="Policy" name="policyId" typeRef="string"/>
      <output id="sec-hr-pf-rounding_o1" label="Policy version" name="policyVersion" typeRef="string"/>
      <output id="sec-hr-pf-rounding_o2" label="Status (VERIFIED / SYNTHETIC_DEMO)" name="status" typeRef="string"/>
      <output id="sec-hr-pf-rounding_o3" label="Rounding mode" name="mode" typeRef="string"/>
      <output id="sec-hr-pf-rounding_o4" label="Rounding unit (minor units)" name="quantumMinor" typeRef="number"/>
      <output id="sec-hr-pf-rounding_o5" label="Negative amounts" name="negatives" typeRef="string"/>
      <output id="sec-hr-pf-rounding_o6" label="Instalment that takes the remainder" name="residual" typeRef="string"/>
      <output id="sec-hr-pf-rounding_o7" label="Applied to" name="application" typeRef="string"/>
      <output id="sec-hr-pf-rounding_o8" label="Stage" name="stage" typeRef="string"/>
      <output id="sec-hr-pf-rounding_o9" label="Jurisdiction" name="jurisdiction" typeRef="string"/>
      <output id="sec-hr-pf-rounding_o10" label="Scheme" name="scheme" typeRef="string"/>
      <output id="sec-hr-pf-rounding_o11" label="Purpose" name="purpose" typeRef="string"/>
      <output id="sec-hr-pf-rounding_o12" label="Source" name="source" typeRef="string"/>
      <output id="sec-hr-pf-rounding_o13" label="Provision" name="provision" typeRef="string"/>
      <output id="sec-hr-pf-rounding_o14" label="Effective from" name="effectiveFrom" typeRef="string"/>
      <output id="sec-hr-pf-rounding_o15" label="Effective to" name="effectiveTo" typeRef="string"/>
      <rule id="sec-hr-pf-rounding_r0"><description>VERIFIED epf-2026-18-5</description>
        <inputEntry id="sec-hr-pf-rounding_r0_i0"><text>[date("2026-06-29")..date("9999-12-31")]</text></inputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o0"><text>"sec-hr-pf-rounding"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o1"><text>"epf-2026-18-5"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o2"><text>"VERIFIED"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o3"><text>"HALF_UP"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o4"><text>100</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o5"><text>"REFUSE"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o6"><text>""</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o7"><text>"each contribution (employee share, employer share) separately"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o8"><text>"per employee per wage period"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o9"><text>"IN"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o10"><text>"EPF Scheme 2026"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o11"><text>"provident fund contribution"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o12"><text>"Employees' Provident Fund Scheme, 2026, G.S.R. 525(E) of 29 June 2026 (supersedes the 1952 Scheme), paragraph 18(5) as reproduced from the Gazette notification"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o13"><text>"para 18(5): each contribution to the nearest rupee, fifty paise or more counted as the next higher rupee"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o14"><text>"2026-06-29"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r0_o15"><text>"9999-12-31"</text></outputEntry>
      </rule>
      <rule id="sec-hr-pf-rounding_r1"><description>SYNTHETIC_DEMO demo-1</description>
        <inputEntry id="sec-hr-pf-rounding_r1_i0"><text>[date("1900-01-01")..date("2026-06-28")]</text></inputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o0"><text>"sec-hr-pf-rounding"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o1"><text>"demo-1"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o2"><text>"SYNTHETIC_DEMO"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o3"><text>"HALF_UP"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o4"><text>100</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o5"><text>"REFUSE"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o6"><text>""</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o7"><text>"each contribution separately"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o8"><text>"per employee per wage period"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o9"><text>"IN"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o10"><text>"EPF Scheme 1952 (period before 29 June 2026)"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o11"><text>"provident fund contribution"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o12"><text>"none found (SYNTHETIC_DEMO: not a statutory or contractual rule; deploy the confirmed policy as a tenant override)"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o13"><text>"the 1952 Scheme provision was not verified"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o14"><text>"1900-01-01"</text></outputEntry>
        <outputEntry id="sec-hr-pf-rounding_r1_o15"><text>"2026-06-28"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
