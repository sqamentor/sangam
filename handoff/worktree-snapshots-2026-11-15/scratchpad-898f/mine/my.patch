+                Jdbc.update(c, "UPDATE PORT_BATCH SET state = ?, failed_items = failed_items - ?, completed_at = NULL, updated_at = "
+                        + dialect.now() + " WHERE id = ?", b.state() == State.PAUSED ? State.PAUSED.name() : State.RUNNING.name(), n, batchId);
             }
